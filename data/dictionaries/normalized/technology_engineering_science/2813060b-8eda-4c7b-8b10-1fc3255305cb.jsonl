{"entry_id": "2348bc62-c13c-4d95-b0b0-dd0e2e53be6c", "sense_id": "2348bc62-c13c-4d95-b0b0-dd0e2e53be6c:0", "term": "اتفاقية قياس المصنع", "definition": "وثيقةٌ تنظيميةٌ تحدد إجراءات إعداد أجهزة القياس وضبطها ومعايرتها داخل موقع التصنيع، وتبين أساليب التحقق من دقة قراءاتها وسلامة توصيلها، وتوثق نتائج الاختبارات توثيقًا منهجيًا لضمان مطابقة الأداء للمواصفات المعتمدة قبل التسليم.", "english_term": null, "dictionary_id": "2813060b-8eda-4c7b-8b10-1fc3255305cb", "dictionary_name": "معجم مصطلحات الخطوط الحديدية", "domain": "معجم مصطلحات الخطوط الحديدية", "source_url": "https://siwar.ksaa.gov.sa/public-dict-information/2813060b-8eda-4c7b-8b10-1fc3255305cb", "source_metadata": {"platform": "SIWAR", "dictionary_url": "https://siwar.ksaa.gov.sa/public-dict-information/2813060b-8eda-4c7b-8b10-1fc3255305cb", "entry_api_url": "https://siwar.ksaa.gov.sa/api/v2/search/2348bc62-c13c-4d95-b0b0-dd0e2e53be6c/get-public-entry", "browse_index_record": {"word": "اتفاقية قياس المصنع", "languageCode": "ar", "lexicalEntryId": "2348bc62-c13c-4d95-b0b0-dd0e2e53be6c", "belongsTo": "lemma"}}, "part_of_speech": null, "morphology": {"lemmaType": "MWE", "root": null, "pattern": " ", "autoGeneratedRoot": null, "wordForms": []}, "raw_entry_id": "6ab201c9329445db8842f7f7", "raw_lexicon_name": "معجم مصطلحات الخطوط الحديدية"}

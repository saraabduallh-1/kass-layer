{"entry_id": "1ce75a7a-8a5e-4a6c-8373-798c2315dce3", "sense_id": "1ce75a7a-8a5e-4a6c-8373-798c2315dce3:0", "term": "اتصال صوت تشغيلي", "definition": "نظام اتصال صوتي مخصص لأغراض التشغيل في منظومة السكك الحديدية، يستخدم لتبادل التعليمات والمعلومات بين العاملين، مثل قائدي القطارات ومراقبي الحركة؛ بما يضمن سلامة التشغيل وتنسيق حركة القطارات.", "english_term": null, "dictionary_id": "2813060b-8eda-4c7b-8b10-1fc3255305cb", "dictionary_name": "معجم مصطلحات الخطوط الحديدية", "domain": "معجم مصطلحات الخطوط الحديدية", "source_url": "https://siwar.ksaa.gov.sa/public-dict-information/2813060b-8eda-4c7b-8b10-1fc3255305cb", "source_metadata": {"platform": "SIWAR", "dictionary_url": "https://siwar.ksaa.gov.sa/public-dict-information/2813060b-8eda-4c7b-8b10-1fc3255305cb", "entry_api_url": "https://siwar.ksaa.gov.sa/api/v2/search/1ce75a7a-8a5e-4a6c-8373-798c2315dce3/get-public-entry", "browse_index_record": {"word": "اتصال صوت تشغيلي", "languageCode": "ar", "lexicalEntryId": "1ce75a7a-8a5e-4a6c-8373-798c2315dce3", "belongsTo": "lemma"}}, "part_of_speech": null, "morphology": {"lemmaType": "MWE", "root": null, "pattern": " ", "autoGeneratedRoot": null, "wordForms": []}, "raw_entry_id": "6ab201c9329445db8842f8a4", "raw_lexicon_name": "معجم مصطلحات الخطوط الحديدية"}
{"entry_id": "4d1bc609-761d-4f70-b30a-bfc142effbdf", "sense_id": "4d1bc609-761d-4f70-b30a-bfc142effbdf:0", "term": "اتفاقية استخدام المحطة", "definition": "اتفاقية بين مشغل ومشغل آخر مرخص لهما بإحدى خدمات نقل الركاب أو نقل البضائع أو بكلتيهما أو بأي خدمة أخرى مرخصة من الهيئة العامة للنقل، يَسمح - بناء عليها - المشغل الأول للمشغل الآخر باستخدام المحطة التي يشغلها لغرض تقديم خدمات محددة من قبل المشغل الآخر سواء بمقابل أو دون مقابل.", "english_term": null, "dictionary_id": "2813060b-8eda-4c7b-8b10-1fc3255305cb", "dictionary_name": "معجم مصطلحات الخطوط الحديدية", "domain": "معجم مصطلحات الخطوط الحديدية", "source_url": "https://siwar.ksaa.gov.sa/public-dict-information/2813060b-8eda-4c7b-8b10-1fc3255305cb", "source_metadata": {"platform": "SIWAR", "dictionary_url": "https://siwar.ksaa.gov.sa/public-dict-information/2813060b-8eda-4c7b-8b10-1fc3255305cb", "entry_api_url": "https://siwar.ksaa.gov.sa/api/v2/search/4d1bc609-761d-4f70-b30a-bfc142effbdf/get-public-entry", "browse_index_record": {"word": "اتفاقية استخدام المحطة", "languageCode": "ar", "lexicalEntryId": "4d1bc609-761d-4f70-b30a-bfc142effbdf", "belongsTo": "lemma"}}, "part_of_speech": null, "morphology": {"lemmaType": "MWE", "root": null, "pattern": " ", "autoGeneratedRoot": null, "wordForms": []}, "raw_entry_id": "6ab201c9329445db8842f729", "raw_lexicon_name": "معجم مصطلحات الخطوط الحديدية"}

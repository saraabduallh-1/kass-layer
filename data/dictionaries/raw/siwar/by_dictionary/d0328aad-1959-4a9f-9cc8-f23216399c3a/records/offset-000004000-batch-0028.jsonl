{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/17605107-a85f-4251-93db-2e830e360061/get-public-entry"},"browse_index_record":{"lexicalEntryId":"17605107-a85f-4251-93db-2e830e360061","word":"نَظَرِيَّةُ الأُنْمُوذَجِ الأَصْلِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9add","lexicalEntryId":"17605107-a85f-4251-93db-2e830e360061","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ الأُنْمُوذَجِ الأَصْلِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ في الدّلالة وعلمِ اللغةِ النفسي، تَرى أن كثيرًا من آراء الناسِ وتَصَوُّراتِهم الذِّهنيةِ عن غيرهم من الناس والأشياءِ ما هي إلا صُوَرٌ ونَماذِجُ انطِباعِيَّة، وأنهم يَصِفون الناسَ والأشياءَ قِياسًا على النَّماذِج الأصليَّةِ المنطَبِعَةِ في أذهانهم. فكلمةُ: (طَيْر) مَحدودَةٌ في أذهان بعضِ الناسِ بطَيرٍ صَغيرٍ يَطيرُ بجناحَيه ولا تَشمل ما لا يَطير من الطُّيُور، كالنَّعامَة مثلا؛ والأثاثُ يَعني لدى بعضِ الشُّعوبِ الفُرُشَ فقط، أو أثاثَ المطبَخِ فقط؛ والفَوَاكِهُ تَعني لدى شُعوبٍ أخرى التُّفَّاحَ فقط. تَسعى نظريةُ الأنموذَجِ الأصلِ إلى الوُصول إلى المفاهيم الكُلِّيَّةِ لدى الناس، وطَريقَةِ تكوينِها، وعلاقَتِها بالتَّواصُل اللغوي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية الأنموذج الأصل ","nonDiacriticsLemma":"نظرية الأنموذج الأصل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ الأُنْمُوذَجِ الأَصْلِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fe4921a7-e153-4b5c-987f-6fc34cf8de63/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fe4921a7-e153-4b5c-987f-6fc34cf8de63","word":"فِعْلٌ بَدِيلٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9ade","lexicalEntryId":"fe4921a7-e153-4b5c-987f-6fc34cf8de63","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فِعْلٌ بَدِيلٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فعلٌ بَديلٌ يجوز أن يَحلَّ مَحلَّ فعلٍ آخَرَ ويَسُدَّ مَسَدَّه. فإذا قال المتَكَلِّمُ: (لَن أفعَلَ) رَدًّا على من قال له: (اذهَبْ) فإن: (أَفعَل) هنا تَعني: (أذهَب) أي: (لَن أذهَبَ)، ومثلُه الفعلُ: do في الجملة الإنجليزيةِ حين يَقول شَخصٌ ما: I like coffee، فيقول الآخَرُ: So do I، أي وكذلك أنا. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فعل بديل ","nonDiacriticsLemma":"فعل بديل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فِعْلٌ بَدِيلٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

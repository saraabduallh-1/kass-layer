{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a0ecd86e-05dd-4de0-a289-c3eec34fb334/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a0ecd86e-05dd-4de0-a289-c3eec34fb334","word":"الرُّتْبَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9ad9","lexicalEntryId":"a0ecd86e-05dd-4de0-a289-c3eec34fb334","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الرُّتْبَةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ في النحو النِّظاميِّ استَعمَله مايكل هاليداي Michael Halliday، يَعني به مَنِزلَةَ الوحدَةِ اللغويةِ بالنسبة إلى غيرها من الوحدات؛ ابتداءً من الأدنى lower level، أي من فُونيمٍ إلى مُورفيمٍ فكلمةٍ فعبارةٍ فجُملةٍ بَسيطةٍ ثم جُملةٍ مُرَكَّبَة، أو من الأعلى high level. فكلُّ وحدةٍ كُبرى تَحوِي الوحداتِ التي هي أدنى منها رُتبَةً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ إحصائيٌّ في البحث العلميّ، يُشير إلى مَوقِع رَقمٍ أو مُشاهَدَةٍ ما أو شخصٍ ما بالنسبة إلى الآخَرِين في المجموعَة نفسِها، وذلك بالنظر إلى مِيزَةٍ ما، كالحَجمِ أو النَّوعِ أو الوَزنِ أو الأهميَّة. يُعَبَّر عن هذا الموقِعِ عادةً بعَدَدٍ أو رَقمٍ فيُعطَى الأعلى مثلًا مَرتَبَةَ: (1)، ويُعطَى الذي يَليه مَرتَبَةَ: (2)، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"الرتبة ","nonDiacriticsLemma":"الرتبة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الرُّتْبَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b7e9b75c-3693-4e69-83fa-e17e3962bd6e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b7e9b75c-3693-4e69-83fa-e17e3962bd6e","word":"التَّمْيِيزُ بينَ الإنْتَاجِ والمُعَالَجَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9ada","lexicalEntryId":"b7e9b75c-3693-4e69-83fa-e17e3962bd6e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّمْيِيزُ بينَ الإنْتَاجِ والمُعَالَجَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في البَحث في تَعليم اللغةِ وتعلُّمِها واكتِسابِها، يُمَيَّز فيه بين الأنشِطةِ الاتَّصاليَّةِ أو المخرَجاتِ اللغويةِ products والعَمَليَّاتِ والمراحِلِ التي تَتِمُّ لإنتاج هذه المخرَجاتِ processes. فالكتابةُ بجميع أنواعِها ناتِجٌ أو مُخرَجٌ لُغويٌّ، لكن هذا النَّاتِجَ مَرَّ بعمليّات ومَراحلَ قبل أن تَظهر مُخرَجاتُه؛ كالتَّخطيط، وجمعِ المعلومات، وكتابةِ الملحوظات، والكتابةِ الأوَّليَّة، والمراجَعَة، والتَّحرير. ويُميِّز حَقلُ تَعليمِ اللغاتِ بين هذين النَّوعَين لكنه يَهتَمُّ بهما مَعًا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التمييز بين الإنتاج والمعالجة ","nonDiacriticsLemma":"التمييز بين الإنتاج والمعالجة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّمْيِيزُ بينَ الإنْتَاجِ والمُعَالَجَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,
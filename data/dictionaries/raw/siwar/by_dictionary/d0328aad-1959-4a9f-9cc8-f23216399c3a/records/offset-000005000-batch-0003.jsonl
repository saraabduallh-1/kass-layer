{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ba071ca7-d7b5-4a50-97da-6b3dd3b2bbcc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ba071ca7-d7b5-4a50-97da-6b3dd3b2bbcc","word":"اِرْتِجَاعٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c60","lexicalEntryId":"ba071ca7-d7b5-4a50-97da-6b3dd3b2bbcc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اِرْتِجَاعٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ فرنسيٌّ في الترجَمة الشَّفهية، يُشير إلى حالَةٍ يُتَرجِمُ فيها المترجِمُ من لغَته الأمِّ إلى لغةٍ أخرى فيُواجِه صُعوباتٍ تُضاف إلى الصُّعوبات التي يواجِهُها حين يُترجِم إلى لغته الأمِّ. ولِفَهمه العَميقِ بلُغَته الأمِّ وأسرارِها البلاغيَّةِ التَّعبيريةِ، من أخيِلَةٍ وأفكارٍ واستعاراتٍ واستعمالاتٍ مجازِيَّة، يَشعُر أنه غيرُ قادِرٍ على نَقل النَّصِّ الأصليِّ إلى اللغة الهدَف، وأنّ ترجَمَتَه لن تَفِيَ بالغرَض، وعليه حينئذٍ أن يُدرِك أن مهمّةَ المترجِمِ نَقلُ الأفكار بطريقَةٍ مَفهومة، وأن الكمالَ أمرٌ مُحال.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"ارتجاع ","nonDiacriticsLemma":"ارتجاع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اِرْتِجَاعٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

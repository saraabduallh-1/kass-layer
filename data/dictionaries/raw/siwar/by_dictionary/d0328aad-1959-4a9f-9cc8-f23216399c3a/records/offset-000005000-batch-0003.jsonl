{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cf94d3b4-90c2-4a35-b1e0-2b45dd181490/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cf94d3b4-90c2-4a35-b1e0-2b45dd181490","word":"مَسْلَكُ النُّمُوِّ اللُّغَوِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c49","lexicalEntryId":"cf94d3b4-90c2-4a35-b1e0-2b45dd181490","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَسْلَكُ النُّمُوِّ اللُّغَوِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مُصطلحٌ لُغويٌّ تَطبيقِيٌّ استَعمَله رود إليس Rod Ellis، ويَعني به أنَّ متعلِّمَ اللغةِ الثانيةِ يَمُرُّ بعَدَدٍ من مَراحِل النُّمُوِّ اللغويِّ في اللغة الهَدَفِ حتى يَصِل إلى اكتِساب مورفيماتِها وصِيَغِها وقواعدِها. ويمرّ المتعلِّمُ بهذه المراحِلِ وفقَ تَدَرُّجٍ مُنتَظمٍ ومستَقِلٍّ عما يُقدَّم له في الموادِّ التعليميَّة. فَرَّق إليس بين هذا النُّمُوِّ وما سمّاه مُعَدَّلَ النُّمُوِّ rate of acquisition الذي قد يُؤثِّر فيه التَّعليمُ فيَزيد من سُرعَته، لكنه لا يُغَيِّر في مَساره.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مسلك النمو اللغوي ","nonDiacriticsLemma":"مسلك النمو اللغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَسْلَكُ النُّمُوِّ اللُّغَوِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0c99216c-cfee-4f85-83a2-71b271d4de3b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0c99216c-cfee-4f85-83a2-71b271d4de3b","word":"شَكْلُ الانْتِشَارِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c4a","lexicalEntryId":"0c99216c-cfee-4f85-83a2-71b271d4de3b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"شَكْلُ الانْتِشَارِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"بَيَانُ التَّشَتُّتِ، وهو شَكلٌ أو رَسمٌ بَيَانيٌّ يُبَيِّن تَوزيعَ دَرَجاتِ مُتَغَيِّرَيْن لنَفس الأفرادِ لتَوضيح نَوعِ العَلاقَةِ بين هذيْن الُمتَغَيِّرَيْن في البحث العلميِّ، ويُسمّى أيضا: scattergram, scatterplot. يتكوَّن الشَّكلُ من محوَرَيْن، أحَدُهما: أُفُقِيٌّ تُوَزَّع عليه دَرَجاتُ أحَدِ المتَغَيِّرَيْن، والآخَرُ رأسِيٌّ تُوَزَّع عليه دَرَجاتُ المتَغَيِّرِ الآخَر. كانت الدَّرَجاتُ تُوضَع يَدَوِيًّا على مُرَبَّعات الرَّسمِ البَيَانِيِّ لإظهار الشَّكلِ النِّهائيِّ للتَّشَتُّت، أما الآنَ فتُظهِرُ الأنظِمةُ الإحصائيَّةُ الحاسُوبيَّةُ التَّشَتُّتَ بطَريقَةٍ آلِيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"شكل الانتشار ","nonDiacriticsLemma":"شكل الانتشار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"شَكْلُ الانْتِشَارِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

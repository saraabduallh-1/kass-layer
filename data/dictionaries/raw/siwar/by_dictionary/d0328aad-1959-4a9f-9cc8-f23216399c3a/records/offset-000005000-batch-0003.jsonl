{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4913f083-24d5-4d60-82d7-649bcff04488/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4913f083-24d5-4d60-82d7-649bcff04488","word":"بِنْيَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c5d","lexicalEntryId":"4913f083-24d5-4d60-82d7-649bcff04488","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بِنْيَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"سِلسِلَةٌ من العناصِر أو الوحداتِ اللغويةِ التي يرتَبِط بعضُها ببعض بعلاقاتٍ معيَّنة، ويَكتَسب كلُّ عنصُرٍ معناه من عَلاقَته بالعناصِر الأخرى في التركيب؛ كالبِناء الصرفيِّ للكلمة، والتركيبِ النحويِّ للجُملة. والتركيبُ في العربية هو ما تألَّف من كلمَتَيْن فأكثَرَ؛ سواء أكانت فائدَتُه تامَّةً كالجُملة، أم غيرَ تامَّةٍ كالمركَّب غيرِ الإسنادِي. فالعبارةُ الاسميّةُ مثلا تركيبٌ مكوَّنٌ من أداةٍ واسِمَةٍ وصِفَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]},{"definition":"مجموعةٌ من العناصِر اللغويةِ في أحَد مستوياتِ التحليلِ اللغويِّ، ولاسيَّما النحو؛ كالأصوات التي تؤلِّف المورفيمات، والمورفيماتِ التي تؤلِّف الكلمات، والكلماتِ التي تؤلِّف الجُمَل.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَصفٌ للتركيبِ من حيث مُستوى التحليلِ اللغوي، ولاسيَّما في التَّميِيز بين البِنيَةِ السَّطحيّةِ والبِنيَةِ العَميقَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"بنية ","nonDiacriticsLemma":"بنية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بِنْيَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

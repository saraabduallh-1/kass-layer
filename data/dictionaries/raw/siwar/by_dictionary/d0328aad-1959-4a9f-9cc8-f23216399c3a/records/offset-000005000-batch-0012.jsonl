{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/80675cd8-3bc2-4756-a399-697042f245c8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"80675cd8-3bc2-4756-a399-697042f245c8","word":"الذَّاكِرَةُ قَصِيرَةُ المَدَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d45","lexicalEntryId":"80675cd8-3bc2-4756-a399-697042f245c8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الذَّاكِرَةُ قَصِيرَةُ المَدَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":" أحَدُ نَوعَيْ الذَّاكِرَةِ memory، وهي التي تَستَقبِل المعلومات وتَحفَظها في مُدَّة قصيرَةٍ مَحدودَة، تُقَدَّر بما لا يَزيد على سَبع كلِمات، وهي المدَّةُ الكافيةُ لتَحليلها وتَرجمتِها وفَهمِها. فإذا فُهِمَت المعلوماتُ ثَبَتَت وانتَقَلَت إلى الذَّاكِرَة طَويلَةِ المدَى long-term memory، وفقدتْ مكانها في الذَّاكرَة قَصيرَةِ المدَى لعَدَم الحاجَةِ إليها. وكلا النَّوعَين مُهِمٌّ للتعلُّم والتواصُلِ اللغوي، بما في ذلك تعلُّمُ اللغاتِ الأجنبيةِ والتواصُلُ بها. راجع:  @(memory) و  @(long-term memory) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الذاكرة قصيرة المدى ","nonDiacriticsLemma":"الذاكرة قصيرة المدى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الذَّاكِرَةُ قَصِيرَةُ المَدَى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

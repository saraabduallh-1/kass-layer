{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d9973b8f-749f-46f9-8fef-ec7a5f5e7b9b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d9973b8f-749f-46f9-8fef-ec7a5f5e7b9b","word":"مَفْهُومٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ccc","lexicalEntryId":"d9973b8f-749f-46f9-8fef-ec7a5f5e7b9b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَفْهُومٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الفِكرةُ العامَّةُ أو الصورَةُ الذِّهنِيةُ التي ترتَبِط بالكلمة أو بالرَّمز في ذِهن الفَرد. والمفاهيمُ مَعانٍ مجرَّدَةٌ تُثيرها العناصِرُ اللغويةُ من كلماتٍ وعباراتٍ وجُمَل. ويعتَقِد اللغويون أن جميعَ اللغاتِ قادِرَةٌ على التَّعبير عن المفاهيم، وأن الاختلافَ يَكمُن في صُوَر التَّعبيرِ وأساليبِه كمًّا وكَيفًا. وتكوينُ المفاهيمِ مرتَبِطٌ باكتساب اللغة، كما أن استِعمالَ المفاهيمِ لتَكوين قَضِيَّةٍ ما أساسٌ للتفكيرِ والتواصُلِ بين الناس. راجع:  @(concept formation) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"مفهوم ","nonDiacriticsLemma":"مفهوم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَفْهُومٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

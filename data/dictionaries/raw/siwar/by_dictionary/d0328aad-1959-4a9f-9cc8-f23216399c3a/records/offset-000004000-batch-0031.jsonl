{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/273cb105-f8b0-4808-9f66-726a7168219f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"273cb105-f8b0-4808-9f66-726a7168219f","word":"صَفَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9b1c","lexicalEntryId":"273cb105-f8b0-4808-9f66-726a7168219f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَفَوِيَّةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مَوقِفٌ أو اتِّجاهٌ لغويٌّ متَشَدِّدٌ يَنتَهِجُه باحثٌ أو جَماعةٌ أو سُلطَة، يَتَمَثَّل في رَفض ما يُظَنُّ أنه غيرُ صائب، ورَفضِ أساليبِ المجَدِّدين ومذاهبِهم في التَّطوُّر اللغويِّ وتَأثيرِ اللغاتِ بعضها في بعض، ومُحارَبةِ كلَّ ما يَدخُل اللغةَ من كلماتٍ أو عباراتٍ أو أساليبَ أجنَبِيَّة. هذا الموقِفُ مَبنيٌّ على أن اللغةَ يُمكن أن تَعيش وتَحيا صافِيَةً نَقِيَّةً دونَ التَّأثُّرِ والاقتِراضِ من لغةٍ أو لغاتٍ أخرى، وهو أمر ترفضه النظريات اللغويةِ الحديثة؛ لأن التَّطوُّرَ اللغويَّ حَتْمِيَّةٌ لُغوية، لكنه يَختَلِف من لغةٍ إلى أخرى في نَوع التَّطَوِّرِ ومُستوياتِه ودَرَجاتِه. ويُطلَق عليه أيضا مصطلحُ النَّقاءِ اللغويِّ أو الصَّفَوِية اللغوية linguistic purism.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"A","root":null,"wordForms":[],"relatedSenses":[],"search":"صفوية ","nonDiacriticsLemma":"صفوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَفَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar"
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fa581cd2-90c6-440d-9d9b-e426aab262a5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fa581cd2-90c6-440d-9d9b-e426aab262a5","word":"أخْطَاءٌ خَفِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9cdd","lexicalEntryId":"fa581cd2-90c6-440d-9d9b-e426aab262a5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أخْطَاءٌ خَفِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تَحليل الأخطاء، استَعمَله بعضُ الباحثين في الثمانينيات من القرن العشرين، لمعرفة مَدى فاعِليَّةِ تَصويبِ الأخطاءِ في تَعلُّم اللغةِ الثانيةِ، وكانوا يشيرون به إلى نَوعٍ من الأخطاء التي لا يَتَنَبَّه إليها متعلِّمُ اللغةِ ولا يُنَبَّه إليها، في مُقابِل الأخطاءِ الظاهرَةِ public errors التي يُدرِكها مُتعلِّمُ اللغةِ حين يَقَع فيها أو حَين يُنَبَّه إليها أو يُصَوَّب خَطؤه فيها، ويطلق عليها أحيانًا covert errors.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أخطاء خفية ","nonDiacriticsLemma":"أخطاء خفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أخْطَاءٌ خَفِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/603a67ab-6411-47e3-ab0e-72cae33e5467/get-public-entry"},"browse_index_record":{"lexicalEntryId":"603a67ab-6411-47e3-ab0e-72cae33e5467","word":"قَوَاعِدُ الاخْتِيَارِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9cde","lexicalEntryId":"603a67ab-6411-47e3-ab0e-72cae33e5467","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَوَاعِدُ الاخْتِيَارِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في النحو التَّوليديِّ، استَعمَله تشومسكي في الخمسينيات من القرن العشرين، ويَقصد به قواعدَ استِخدامِ الوحداتِ اللغويةِ في التركيب من حيث عَلاقَتُها النَّظمِيَّةُ بالوحدات المجاوِرَةِ وصِحَّةُ هذه العَلاقَةِ في البِنيَة العَميقَة. هذا المصطلحُ شَبيهٌ بمصطلَح: تَقيِيد الاختِيار  selection(al) restriction أو أنّ الثانيَ فَرعٌ من الأوَّل أو مثالٌ له. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قواعد الاختيار ","nonDiacriticsLemma":"قواعد الاختيار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَوَاعِدُ الاخْتِيَارِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5ea4c59d-c79b-4916-b3a5-dda7e3a3e9e9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5ea4c59d-c79b-4916-b3a5-dda7e3a3e9e9","word":"مُرَاقَبَةٌ ذَاتِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9cdf","lexicalEntryId":"5ea4c59d-c79b-4916-b3a5-dda7e3a3e9e9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُرَاقَبَةٌ ذَاتِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مُلاحَظَةُ المتعلِّمِ نفسَه، وتَسجيلُه معلوماتٍ عن سُلوكه؛ للحُصول على فَهمٍ صَحيحٍ عن مَدَى قُدرَتِه على ضَبط سُلوكه. وفي بَرامِج إعدادِ المعلِّمين، يُدَرَّس المعلّمون أساليبَ المراقَبَةِ الذَّاتِيَّةِ بوَصفها أحَدَ الجَوَانِبِ المهِمَّةِ في تَطوِير مِهنَةِ التَّدريس؛ كحِفظ سِجِلٍّ للخِبرات الذَّاتِيَّة، وكتابَةِ التَّقاريرِ الذَّاتِيَّة، وتَسجِيلِ بعضِ الدُّروسِ على شَرَائط فِيديو أو في بَرَامِج عَرضٍ حاسُوبِيّةٍ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"إستراتيجِيَّةٌ من إستراتيجِيّات تعلُّمِ اللغاتِ الأجنبية، تَعني تَأكُّدَ الطالبِ من أدائه لمهِمَّةٍ تَعلِيمِيَّةٍ في أثناء تَعلُّمِه اللغةَ الهَدَف، ضِمنَ الإستراتيجِياتِ فَوقَ المعرِفِيَّة meta-cognitive strategies ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُطلَق على المرحَلة الرابعةِ من مَراحِل الكلامِ، بحسَب تَصنيفِ بعضِ اللغويين النَّفسِيِّين، تلك المراحِل التي تَبدأ بالتَّصَوُّر conceptualization، فالتَّشكِيلِ formation، فالنُّطقِ articulation، ثم الملاحَظَةِ أو المراقَبَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مراقبة ذاتية ","nonDiacriticsLemma":"مراقبة ذاتية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُرَاقَبَةٌ ذَاتِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

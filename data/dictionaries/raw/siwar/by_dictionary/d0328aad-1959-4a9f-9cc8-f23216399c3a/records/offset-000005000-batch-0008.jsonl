{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/60ea6aa3-26c8-4385-8e28-c4260dc26e2c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"60ea6aa3-26c8-4385-8e28-c4260dc26e2c","word":"سِمَةٌ دَلالِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9cd6","lexicalEntryId":"60ea6aa3-26c8-4385-8e28-c4260dc26e2c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سِمَةٌ دَلالِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَعلَمٌ دلاليٌّ، وهو وَصفٌ يُطلَق على أحد مكوّنات المعنى الأساسِ للكلمة، مثل: كائن حيّ، بشر،  ذكر، بالغ (لتدلّ على الرجل). ومعاني الكلماتِ يُمكن وَصفُها بعَدَد من السِّمات أو المعالِمِ الدَّلالِيَّة. وفي مجال التَّصنيفِ في حُقُولٍ دلاليَّة، قد يكون للكلمة أكثَرُ من سِمَة، بعضُها أساسٌ وبعضُها ثانويٌّ؛ فتُصنَّف حينئذٍ في حَقلٍ دلاليٍّ بموجب سِمَةٍ دلاليّةٍ معيَّنة، وتُصنَّف في حَقلٍ دلاليٍّ آخَرَ بموجب سِمَةٍ دلاليّةٍ أخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"سمة دلالية ","nonDiacriticsLemma":"سمة دلالية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سِمَةٌ دَلالِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

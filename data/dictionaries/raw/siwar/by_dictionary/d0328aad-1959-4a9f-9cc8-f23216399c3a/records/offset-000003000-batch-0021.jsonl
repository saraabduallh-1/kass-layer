{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/df18e94e-1999-43cd-801d-1b7f19bb8cf9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"df18e94e-1999-43cd-801d-1b7f19bb8cf9","word":"لُغَةُ الأَكْثَرِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9633","lexicalEntryId":"df18e94e-1999-43cd-801d-1b7f19bb8cf9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةُ الأَكْثَرِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ التي تَنطِقُ بها الغالِبيةُ العُظمى من الناس في بلَدٍ ما؛ كالعربية في الأقطار العربية، والإنجليزيةِ في الولايات المتحدةِ الأمريكيةِ وبريطانيا. تُقابِلها لغةُ الأقَليَّةِ minority language؛ كالإسبانية والإيطاليةِ في أمريكا، والعربيةِ في بريطانيا وفرنسا، والتركية في ألمانيا. يميِّز اللغويون بين أغلَبيةٍ عدَدِيَّةٍ numerical majority وأغلبيةٍ سياسيةٍ political majority؛ فالثانيةُ ليسَت أغلبيةً حقيقية، ولكنها تملك قوَّةً سياسيةً واقتصاديةً تفرِض لُغَتَها كلُغةِ أغلَبِيَّةٍ، مثل الإنجليزيةِ والأفريكانيةِ في دولة جنوبِ أفريقيا في عَهد الفَصلِ العنصُري.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة الأكثرية ","nonDiacriticsLemma":"لغة الأكثرية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةُ الأَكْثَرِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

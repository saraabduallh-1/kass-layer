{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/04512a8b-fb60-4758-8922-f598296107cb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"04512a8b-fb60-4758-8922-f598296107cb","word":"تَدْرِيسٌ مُتَبَادَلٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b5f","lexicalEntryId":"04512a8b-fb60-4758-8922-f598296107cb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيسٌ مُتَبَادَلٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"شَكلٌ من أشكال التَّدريسِ الجَماعِيِّ، يَتَقاسم فيه المعلِّمُ وطلابُه مَسؤولِيَّةَ التَّدريسِ والقِيادَةِ في مناقَشَة نَصٍّ قرائيٍّ. في أثناء هذه المناقَشَةِ، يَنخَرِط المعلِّمُ والطلابُ في أربع إستِراتيجياتٍ لفَهم القراءةِ هي: طَرحُ الأسئلة، وتَوضيحُ نقاطِ الارتِباك، وتَوَقُّعُ المضمونِ التالي، وتَلخيصُ مادَّةِ القراءة. وفي تعليم اللغات، يمكن تَطبيقُ هذا الشَّكلِ من التَّدريسِ في المستَوَى المتقدِّمِ أو في نِهايَة المستَوَى المتَوَسِّط.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريس متبادل ","nonDiacriticsLemma":"تدريس متبادل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيسٌ مُتَبَادَلٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

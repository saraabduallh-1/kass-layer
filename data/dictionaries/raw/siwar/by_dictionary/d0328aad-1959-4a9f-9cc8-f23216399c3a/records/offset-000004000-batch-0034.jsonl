{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/19372269-9d0b-48b8-a677-410b02063eb9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"19372269-9d0b-48b8-a677-410b02063eb9","word":"مُخطَّطاتُ رِيد وكِيلُوغ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b74","lexicalEntryId":"19372269-9d0b-48b8-a677-410b02063eb9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُخطَّطاتُ رِيد وكِيلُوغ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أشكالٌ تتكوَّن من خُطوطٍ أُفُقيَّةٍ وعمُوديةٍ ومائلَةٍ وأسْهُمٍ لتَمثيل أبنِيَة الجُمَل؛ بهدَف توضيحِ العلاقاتِ النحويةِ بين كلماتِ الجُملة، وتَيسيرِ تَعليمِها، وهي شَبِيهَةٌ بالخرائط الذِّهنِيَّةِ المطبَّقَةِ الآنَ في تدريس عَدَدٍ من العُلوم والمعارفِ بما فيها تعليمُ القواعد. سُميَت هذه الأشكالُ بهذا الاسمِ نسبةً إلى كلٍّ من: A. Reed و: B. Kellogg اللّذَين اشتُهِرا بتَطوِيرها في عام 1877م، على الرَّغم من أن أوَّلَ من اقتَرَحَها هو كلارك Clark في عام 1863م. استُخدِمَت هذه المخَططات في تعليم الإنجليزيةِ في المدارس الأمريكيةِ منذُ ذلك التاريخِ حتى الستينياتِ من القرن العشرين. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مخططات ريد وكيلوغ ","nonDiacriticsLemma":"مخططات ريد وكيلوغ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُخطَّطاتُ رِيد وكِيلُوغ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/93669da7-4a91-4cf8-8f65-08d9aeab8676/get-public-entry"},"browse_index_record":{"lexicalEntryId":"93669da7-4a91-4cf8-8f65-08d9aeab8676","word":"تَعْزِيزٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b94","lexicalEntryId":"93669da7-4a91-4cf8-8f65-08d9aeab8676","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْزِيزٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" أحَدُ عَناصِرِ التَّعلُّمِ في النظرية السُّلوكيةِ لدى سكِينَر Skinner، وتَعني تَعزيزَ المعلِّمِ للاستِجابَة التي تَصدُر من المتعلِّم نَتيجَةَ المثير. والتَعزيزُ نَوعان: تَعزيزٌ إيجابِيٌّ positive reinforcement يَعقُب الاستِجابَةَ الصَّحيحَةَ بهَدَف تَثبيتِها في ذِهن المتعلِّم، وتَعزيزٌ سَلِبيٌّ negative reinforcement يَعقُب الاستِجابَةَ الخاطِئةَ لمسْحِها من ذِهنه. ولم يَعُدْ اللغويون التَّطبيقِيُّون يَهتَمُّون بهذه العناصِر بعد أن قَلَّ الاعتِمادُ على النظرية السُّلوكيةِ وتطبيقاتها في تَعليم اللغات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"تعزيز ","nonDiacriticsLemma":"تعزيز","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْزِيزٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fd8a7034-6283-4271-b822-46f19074dafd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fd8a7034-6283-4271-b822-46f19074dafd","word":"مُعَامِلُ المَقْرُوئِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b95","lexicalEntryId":"fd8a7034-6283-4271-b822-46f19074dafd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعَامِلُ المَقْرُوئِيَّةِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مُعامِلٌ أو مِقياسٌ يُستَعمَل لتَحديد دَرَجَةِ سُهُولَةِ مادَّةٍ قِرائيَّةٍ أو صُعُوبتِها؛ لمعرِفة ما إذا كان النَّصُّ مُناسِبًا للطلاب المقرَّرِ عليهم ذلك النصّ أو أنه أدنى أو أعلى من مُستواهم. ويُستَعمَل في تحديده بعضُ المُعادَلاتِ الرِّياضيَّةِ التي تَقيس عَوَامِلَ مُتَعَدِّدَةً؛ كمُتَوَسِّط طُولِ الجُملة، ومُتَوَسِّطِ طُولِ الكلمة، وعَلاقَةِ ذلك بعُمر المتعلِّمِ ومُستَوَاه، ونحوِ ذلك. ومن أشهَر أساليبِ قِياسِ مَقروئيةِ النَّصِّ اختبارُ التَّتِمَّةِ cloze test، ومُنحَنياتُ فراي للمَقروئية Fry Readability Graph، وصيغَةُ دِيل وتْشول Dell & Chall، وطريقَةُ بُورمُوث Bormuth.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معامل المقروئية ","nonDiacriticsLemma":"معامل المقروئية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعَامِلُ المَقْرُوئِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot"
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6687c8b6-7986-454e-bd7f-45f0831bf908/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6687c8b6-7986-454e-bd7f-45f0831bf908","word":"كَلِمَةٌ صَوْتِيَّةٌ وَظِيفِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99c7","lexicalEntryId":"6687c8b6-7986-454e-bd7f-45f0831bf908","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمَةٌ صَوْتِيَّةٌ وَظِيفِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على الكلمة بوَصفها وحدةً فونيميةً؛ حين تُعرَف حُدودُها، وتُحَدَّد بما يَفصِلها عمّا قبلَها وما بعدَها بحُدودٍ صَوتيةٍ وفقَ طريقةِ التَّلفُّظِ بها، تَميِيزًا لها من الكلمة الكتابيةِ orthographical word، وعن الكلمة النحويةِ grammatical word. فلَفظُ: I've في الجُملة الإنجليزيةِ: I've done it، مُكوَّنٌ نحويًّا من كلمَتَين، لكنهما كلمةٌ مفرَدةٌ من الناحية الصوتيةِ الوَظيفيةِ (الفُونولُوجيةِ).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمة صوتية وظيفية ","nonDiacriticsLemma":"كلمة صوتية وظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمَةٌ صَوْتِيَّةٌ وَظِيفِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

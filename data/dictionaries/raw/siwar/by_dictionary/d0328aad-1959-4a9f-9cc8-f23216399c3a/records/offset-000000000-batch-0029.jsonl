{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/46539e57-a2da-4ae3-b7fb-99bfbf46d092/get-public-entry"},"browse_index_record":{"lexicalEntryId":"46539e57-a2da-4ae3-b7fb-99bfbf46d092","word":"تَصْنِيفٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b14","lexicalEntryId":"46539e57-a2da-4ae3-b7fb-99bfbf46d092","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَصْنِيفٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"أسلوبٌ في التدريس، يُقَسَّم فيه الطلابُ إلى مجموعاتٍ لمساعَدَتهم على التعلُّم بالطريقَة التي تُناسِب كلَّ واحدٍ منهم. ويختَلِف نَمَطُ التَّصنيفِ وعَدَدُ الطلابِ في كل مجموعَةٍ بحسَب النشاطِ التعليميِّ، بيدَ أن أبرَزَ هذه التصنيفاتِ: تَصنيفُ جميعِ طلابِ الفَصلِ في مجموعَةٍ واحدة، وتَصنيفُهم في مجموعاتٍ صغيرةٍ تربو على خمسة طلاب، وتَصنيفُهم في مجموعاتٍ أصغَرَ تَقِلُّ عن الخمسَة. ولوُجود الفُروقِ الفَرديةِ بين الطلاب، يُصنَّف كلُّ طالبٍ في المجموعة التي تُناسبُه، وتَسمَح له بقَدرٍ كافٍ من المشارَكةِ والتفاعُلِ المثمِر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات","اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ بِنْيَويٌّ، يُقصَد به تَصنيفُ العناصِرِ أو المجموعاتِ اللغويةِ المتَشابِهَةِ في أبوابٍ مفَصَّلَة؛ كتَصنيف الأصواتِ إلى فونيمات، وتَصنيفِ المورفاتِ إلى مورفيمات، وتَصنيفِ الصِّيَغِ إلى أصناف، وكذلك الكلمات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تصنيف ","nonDiacriticsLemma":"تصنيف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَصْنِيفٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

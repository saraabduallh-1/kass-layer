{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9dc594fa-7a95-4e66-b6ee-cc129f96f7ef/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9dc594fa-7a95-4e66-b6ee-cc129f96f7ef","word":"خَلِيَّةٌ عَصَبِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9782","lexicalEntryId":"9dc594fa-7a95-4e66-b6ee-cc129f96f7ef","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"خَلِيَّةٌ عَصَبِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَفهومٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُشير إلى الوحدة الأوَّليةِ التي يتكوَّن منها الجهازُ العَصَبيُّ، وهي الأساسُ في السلوك العصبيِّ كلِّه، بما في ذلك السمعُ والنطقُ واللغةُ عامّةً. ووَظيفتُها نَقلُ المعلوماتِ إلى مراكِز الدِّماغِ عبرَ وَصلاتٍ وتفَرُّعاتٍ عَصَبِيةٍ، استِجابةً لمثيرٍ خارِجيٍّ. وقد ظهَرَت دراساتٌ تربويةٌ استفادَت من نتائج الدراساتِ في تَشريح الدِّماغِ ووَصفِ أنشِطَتِه في أثناء التعلُّمِ والتفكير. بيدَ أن عِلاجَ أمراضِ النُّطق ومُشكلاتِ الكلام، وحَقلَ تعليمِ اللغاتِ الأمِّ والثانيةِ والأجنَبيةِ، هما أكثَرُ الحُقولِ التعليميةِ استفادةً من نتائج تلك الدراسات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"خلية عصبية ","nonDiacriticsLemma":"خلية عصبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"خَلِيَّةٌ عَصَبِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7d80e5ed-9af8-4a93-abcd-46c6937529e0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7d80e5ed-9af8-4a93-abcd-46c6937529e0","word":"النَّظَرِيَّةُ العَصَبِيَّةُ العَضَلِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9795","lexicalEntryId":"7d80e5ed-9af8-4a93-abcd-46c6937529e0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّظَرِيَّةُ العَصَبِيَّةُ العَضَلِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغوية صَوتيةٌ عَصَبيةٌ، طرَحَها العالمُ الفرنسيُّ راؤول حاسون Raoul Husson في الخمسينيات من القرن العشرين، يرَى فيها أن الجَهرَ لا يحدُث نتيجةَ ديناميَّةِ الهواء، ولا بسَبَب مُرُونةِ الوَتَرَين الصوتيَّينِ والعَضَلاتِ المرتَبِطَةِ بهما، ولكنه يحدُث بسَبَب تعاقُبِ النَّبَضاتِ العَصَبيَّةِ الدِّماغيَّةِ التي تنتُج عنها انقِباضاتٌ في الوَتَرَين الصَّوتِيَّين. أي إن الجَهرَ يحدُث نتيجَةَ الأوامِرِ الوارِدَةِ إلى الوَتَرَين من الدِّماغ وحَسب، وأن تأثيرَ الهواءِ فيهما سَلبيٌّ. لكن هذه النظريةَ لم تَثبُت صلاحيَّتُها، وانتَقَدها كثيرٌ من العُلماء، مستَدلِّين بالاكتِشافات التي ظهَرَت فيما بعد نتيجَةَ تطوُّرِ الوَسائل ِالمعمَليةِ التجريبيَّة. وقد نَقَضَت هذه النظريةَ النظريةُ السائدَةُ لدى عامَّةِ الدارسين، وهي نظريةُ المرونَةِ العضَليَّةِ وديناميَّةِ الهواءِ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظرية العصبية العضلية ","nonDiacriticsLemma":"النظرية العصبية العضلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّظَرِيَّةُ العَصَبِيَّةُ العَضَلِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

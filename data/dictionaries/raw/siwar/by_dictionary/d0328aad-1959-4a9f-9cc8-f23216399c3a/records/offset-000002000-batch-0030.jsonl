{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a8e052af-7ab7-407a-81ca-5a7951693885/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a8e052af-7ab7-407a-81ca-5a7951693885","word":"اكْتِسَابُ اللُّغَةِ بالتَّعَلُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9323","lexicalEntryId":"a8e052af-7ab7-407a-81ca-5a7951693885","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اكْتِسَابُ اللُّغَةِ بالتَّعَلُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُقصَد به اكتسابُ المرءِ اللغةَ الثانيةَ نتيجةَ تعَلُّمٍ مَقصودٍ ومُنَظَّم، بطريقَةٍ مباشرَةٍ كتعليم المهاراتِ اللغويةِ بالموادِّ التعليمية، أو بطريقَةٍ غيرِ مباشرَةٍ كتَنظيم الصَّفِّ وتهيئتِه على شَكلٍ يُشبِه البيئةَ اللغويةَ في الحياة العامَّة. ويُقابِل هذه الحالَةَ حالَةُ اكتسابِ اللغةِ اكتسابًا طبعيًّا natural acquisition، وذلك بالتَّلَقِّي المباشِرِ من الناطقين باللغة الهَدَفِ في بيئةٍ طبيعيةٍ، سواء أكان المتَلَقِّي صغيرا أم كبيرا، وسواء أكانت اللغةُ المكتَسَبَةُ لغةً أمًّا أم لغةً ثانيةً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اكتساب اللغة بالتعلم ","nonDiacriticsLemma":"اكتساب اللغة بالتعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اكْتِسَابُ اللُّغَةِ بالتَّعَلُّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

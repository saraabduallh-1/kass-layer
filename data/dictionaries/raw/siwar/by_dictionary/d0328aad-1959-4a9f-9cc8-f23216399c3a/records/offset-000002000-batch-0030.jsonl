{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/93024de4-e28d-45d9-bca5-0370acc98957/get-public-entry"},"browse_index_record":{"lexicalEntryId":"93024de4-e28d-45d9-bca5-0370acc98957","word":"تَنْسِيقُ المَعْلُومَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9316","lexicalEntryId":"93024de4-e28d-45d9-bca5-0370acc98957","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَنْسِيقُ المَعْلُومَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إحدى طرائقِ تَجهيزِ المعلوماتِ بشَكلٍ يُسَهِّل استِرجاعَها ويُسَهِّل المعالَجةَ الآليَّةَ للنُّصوص المكتوبَةِ باللغة الطبيعية. يَتِمُّ ذلك باستخراج المعلوماتِ من جُمَل النَّصِّ وسَردِها في جدوَل مَعلوماتِيٍّ خاصٍّ، وتُوضَع المعلوماتُ المستَخرَجةُ من كلِّ جُملةٍ على سَطرٍ مُستَقلٍّ فيه. يُمثِّل الجدوَلُ في النهايَة ما يوجَد في النَّصِّ من أنماطٍ تركيبيةٍ ولَفظِيةٍ منتَظِمةٍ مما يُستَعمَل عادةً في المجال المتخَصِّصِ الجاري تَنسيقُ مَعلوماتِه، مع التركيز على استخراج البِنيَةِ الدَّلاليةِ على مستوى الجُملة بكامِلها أو على مستوى عدَّةِ جُمَلٍ لا على مستوى المكوِّناتِ الدَّاخِليةِ للجُملة الواحدة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تنسيق المعلومات ","nonDiacriticsLemma":"تنسيق المعلومات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَنْسِيقُ المَعْلُومَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b4615e0-b0b5-4a16-92f8-3babffd9c054/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b4615e0-b0b5-4a16-92f8-3babffd9c054","word":"صُعُوبَةٌ مُتَأصِّلَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9317","lexicalEntryId":"9b4615e0-b0b5-4a16-92f8-3babffd9c054","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صُعُوبَةٌ مُتَأصِّلَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"صُعوبةٌ لغويةٌ ليس مَصدَرُها المتعلِّمُ أو المعلِّمُ أو الموادُّ التعليميةُ أو تأثيرُ اللغةِ الأمِّ، وإنما هي صُعوبةٌ متأصِّلةٌ في اللغة الهَدَفِ. لكنّ كثيرا من اللغويين التطبيقيِّين يُنكِرون وُجودَ صُعوبةٍ متأصِّلَةٍ في اللغة الهَدَفِ ذاتِها، بل يَرَون أن الصُّعوبةَ تحدُث لأسبابٍ متعدِّدَة، منها اللغةُ الأمُّ، والمسافةُ الاجتماعيةُ بين ثقافَة اللغةِ الأمِّ وثقافَةِ اللغةِ الهَدَفِ، ونوعُ الدَّوافعِ والميولِ والاتجاهاتِ ودرَجاتُها لدى المتعلِّم، وطريقةُ عَرضِ محتوى اللغةِ الهَدَفِ، وأساليبُ تدريسِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صعوبة متأصلة ","nonDiacriticsLemma":"صعوبة متأصلة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صُعُوبَةٌ مُتَأصِّلَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/19ab9556-4655-4aa2-9dac-56342bd6dfd7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"19ab9556-4655-4aa2-9dac-56342bd6dfd7","word":"ابْتِدَاعٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9318","lexicalEntryId":"19ab9556-4655-4aa2-9dac-56342bd6dfd7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ابْتِدَاعٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"أحَدُ أسبابِ تَغَيُّرِ المعنى، وهو من الأسباب الواعِيَةِ أو المقصودَةِ لتَغَيُّر المعنى في اللغة، ويُسمى أيضا: creativity. يقوم بهذا الأمرِ صِنفان من الناس: أحَدُهما الموهوبون من أصحاب المهارَةِ في الكلام، كالشُّعراء والأُدَباءِ والمتَمَيِّزين من الكُتَّاب؛ والآخَرُ المجامِعُ اللغويةُ والهيئاتُ العِلميةُ حين تحتاج إلى استِعمال لَفظٍ ما للتَّعبير عن فِكرَةٍ أو مَفهُومٍ معيَّن، فتُعطي الكلمةَ معنى جديدا يَبدأ أوَّلَ الأمرِ اصطِلاحيًّا، ثم يخرُج إلى دائرَة المجتَمَعِ فيَغزو اللغةَ المشتَرَكةَ كذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"ابتداع ","nonDiacriticsLemma":"ابتداع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ابْتِدَاعٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5938634f-e9e0-469a-a83d-fca74d6c888f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5938634f-e9e0-469a-a83d-fca74d6c888f","word":"مُجَدِّدٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9319","lexicalEntryId":"5938634f-e9e0-469a-a83d-fca74d6c888f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُجَدِّدٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُطلَق على الشَّخص الذي يَبتَدِع كلمةً جديدةً أو عبارَةً في لغَته؛ فتَشيع وتُصبِح ضِمنَ هذه اللغةَ. تُشير نتائجُ بعضِ الدّراساتِ اللغويةِ الاجتماعيةِ إلى أن من يَقوم بهذه المهمّةِ بنَجاحٍ غالِبا ما يكون خارِجَ المجموعَةِ الضَّيِّقَةِ في مجتَمَعِه، ويختَلِط بمجموعات لغَويَّةٍ وثقافيةٍ أخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"AS","root":null,"wordForms":[],"relatedSenses":[],"search":"مجدد ","nonDiacriticsLemma":"مجدد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُجَدِّدٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b281a775-7cce-4c04-a36a-8ba8f9a7f4e7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b281a775-7cce-4c04-a36a-8ba8f9a7f4e7","word":"تَقْلِيدٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b931b","lexicalEntryId":"b281a775-7cce-4c04-a36a-8ba8f9a7f4e7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَقْلِيدٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"نَشاطٌ أو أسلوبٌ في تعليم اللغات؛ منبَثِقٌ من النظرية السُّلوكية، ومُطبَّقٌ في الطريقة السَّمعيةِ الشَّفَهيةِ. يُكَرِّر فيه الطالبُ الأنماطَ اللغويةَ التي يَسمَعها ويَحفَظها، حتى تتحَوَّل إلى قوالِبَ راسِخَةٍ في ذِهنه؛ ليَستَعمِلها في المواقِف المشابِهةِ لها، أو يَقيس عليها. لكن المعرِفيِّين الفِطريِّين انتَقدوا هذا الأسلوبَ؛ لعَدَم جَدْواه، ولضَعفِ الثِّقَةِ في النظرية التي اعتَمَد عليها، والطريقةِ التي طُبِّق بها، واستَبدلوا به تَطبيقاتِ النظريةِ المعرفيةِ الفِطريةِ، والبِناءَ الإبداعِيَّ للُّغة creative construction","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تقليد ","nonDiacriticsLemma":"تقليد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَقْلِيدٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

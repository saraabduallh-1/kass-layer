{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b54175d6-a397-413f-b06a-3ef1606bf97e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b54175d6-a397-413f-b06a-3ef1606bf97e","word":"مُعَامِلُ صُعُوبَةِ العُنْصُرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9325","lexicalEntryId":"b54175d6-a397-413f-b06a-3ef1606bf97e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعَامِلُ صُعُوبَةِ العُنْصُرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ المقايِيسِ الإحصائيَّةِ لقياس درَجةِ صُعُوبةِ السؤالِ في اختبارات اللغة، أي المؤشِّرُ الذي يكون دليلا على صُعُوبة العنصُرِ أو البَندِ في الاختبار. وهو حسابُ النِّسبةِ المئويَّةِ لعَدَدِ الطلابِ المفحُوصين الذين أجابوا عن السؤال إجابةً صحيحةً من مجموع العَدَدِ الكُلِّيِّ للطلاب؛ فكلَّما انخَفَضَت هذه النسبةُ ارتَفَعَت صُعُوبةُ البَند. ويُسمّى هذا المعامِلُ أيضا: item difficulty، كما يُسمّى: difficulty index. راجع:  @(item difficulty) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معامل صعوبة العنصر ","nonDiacriticsLemma":"معامل صعوبة العنصر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعَامِلُ صُعُوبَةِ العُنْصُرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

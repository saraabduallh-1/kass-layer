{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6bb1de7d-c2d7-46f7-b02c-340f4e7f8087/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6bb1de7d-c2d7-46f7-b02c-340f4e7f8087","word":"انْتِقَالٌ طَبِيعِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b987f","lexicalEntryId":"6bb1de7d-c2d7-46f7-b02c-340f4e7f8087","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"انْتِقَالٌ طَبِيعِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصْفٌ للحالَة الطَّبيعيةِ التي يكتَسِب بها الناسُ في مجتَمَعٍ ما لغَتَهم الأمَّ من أسلافهم، وكذلك حالاتُ الأطفالِ الذين يكتَسِبون لغَتَهم الأمَّ من البيئة التي يعيشون فيها منذُ وِلادَتِهم. خِلافا للانتِقال غَيرِ الطَّبيعيِّ للُّغة الأمِّ abnormal transmission حيث تَفرِض جَماعَةٌ مَرجِعِيَّةٌ لغَتَها بالقُوَّة على مجموعَاتٍ من الناس، بحيث يَصعُب على المجموعات المحافَظَةُ على لغات والدِيهم أو أسلافِهم، ولا يُمَكَّنون - في الوَقت نفسِه - من اكتساب اللغةِ المفروضَةِ عليهم اكتسابًا طبيعيًّا. راجع:  @(abnormal transmission) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"انتقال طبيعي ","nonDiacriticsLemma":"انتقال طبيعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"انْتِقَالٌ طَبِيعِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a62f7223-731c-4924-a8a9-a9293439e84c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a62f7223-731c-4924-a8a9-a9293439e84c","word":"مَجْمُوعَةٌ مِعْيَارِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9880","lexicalEntryId":"a62f7223-731c-4924-a8a9-a9293439e84c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَجْمُوعَةٌ مِعْيَارِيَّةٌ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ في اختبارات اللغةِ، يُطلَق على مجموعةٍ كبيرةٍ من الطلاب يَتمّ اختِيارُها لاحتِساب الأداءِ القِياسيِّ على اختبارٍ مُقنَّن. فتُعطَى هذه المجموعةُ المِعيارِيةُ الاختبارَ أوّلا بهَدَف بناءِ معايِيرَ للتصحيح، ثم يُعطَى الاختبارُ في وَقتٍ لاحِقٍ لمجموعةٍ صغيرة، فتُفَسَّر نتائجُه وتُقارَن في ضوء نتائجِ المجموعةِ المعيارِية. وبناء على نتائجِ المجموعَتَين، يُصَنَّف أداءُ كلِّ طالبٍ على أنه متوسِّطٌ أو فوقَ المتوسِّطِ أو دونَه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مجموعة معيارية ","nonDiacriticsLemma":"مجموعة معيارية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَجْمُوعَةٌ مِعْيَارِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

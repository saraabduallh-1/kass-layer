{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fdce7063-8eb1-4451-80f7-6b4c7fedfc5b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fdce7063-8eb1-4451-80f7-6b4c7fedfc5b","word":"تَحْدِيثٌ مُعْجَمِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9562","lexicalEntryId":"fdce7063-8eb1-4451-80f7-6b4c7fedfc5b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْدِيثٌ مُعْجَمِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في السياسة اللغويةِ والتَّخطيط، يُقصَد به الجُهودُ التي تَبذُلها الهيئاتُ اللغويةُ الرّسميةُ والمجامِعُ اللغويةُ من تحديثٍ لمفرَدات اللغةِ ومُصطَلَحاتِها ودلالاتِها في بلَدٍ ما؛ لتُوَاكِب النُّمُوَّ المعرِفيَّ والتقدُّمَ التّقنيَّ، أو لتُحَقِّق أهدافا سياسيّةً أو اجتماعيّةً أو ثقافيّةً أو دِينِيّة. من أمثلة ذلك ما حَدَث في السُّوَيْد لتَحديث اللغةِ السُّوَيْدِية حين أُنشِئ مرَكَزٌ للمصطَلَحات الفَنِّيَّة؛ لتَنسيق المحدَثِ منها، وتوحيدِ بنائه، ونَشرِه، وتَعميمِ استِعمالِه. ومن أمثِلَته أيضا ما حدَث للُّغَتَين التركيّةِ والعِبرِيّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحديث معجمي ","nonDiacriticsLemma":"تحديث معجمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْدِيثٌ مُعْجَمِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eb4180db-5d24-4c98-8873-ade56bb7ff78/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eb4180db-5d24-4c98-8873-ade56bb7ff78","word":"المَنْهَجُ المُعْجَمِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9563","lexicalEntryId":"eb4180db-5d24-4c98-8873-ade56bb7ff78","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَنْهَجُ المُعْجَمِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغوي تطبيقيٌّ تعليميٌّ، يُشير إلى أحَدِ المناهِجِ أو الأساليبِ التي تحكُم إعدادَ المقرَّراتِ والموادِّ التعليميةِ في تعليم اللغات، ينطَلِق من المفرَداتِ المعجَميةِ أساسا لاختيار المحتوَى وتَنظيمِه وتقديمِه، ويُسمّى أيضا: lexical-based syllabus. أما المناهجُ الأخرى فهي المنهجُ النحويُّ أو التركيبيُّ، والمنهجُ الوَظيفيُّ، ومنهجُ المهمَّةِ، والمنهجُ التواصُليُّ، ومنهجُ المحتوى. ويختَلِف المنهجُ المعجَميُّ هذا عن المذهبِ المعجَميِّ في تعليم اللغة lexical approach؛ فالأوّلُ يَعتَمِد على المفرَدات أساسًا لاختيار المحتوى وتَنظيمِه، أما الثاني فيَعتَمِد على العبارات الاصطلاحيةِ والمتصاحِباتِ اللفظيةِ collocations أساسا للموادِّ اللغوية، ولا يُعَوِّل كثيرا على الكلمات المفرَدَة. راجع:  @(Lexical Approach) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المنهج المعجمي ","nonDiacriticsLemma":"المنهج المعجمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَنْهَجُ المُعْجَمِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/acc71bd9-6408-44ab-b205-dec1f03964ab/get-public-entry"},"browse_index_record":{"lexicalEntryId":"acc71bd9-6408-44ab-b205-dec1f03964ab","word":"عِلْمُ المُفْرَدَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9564","lexicalEntryId":"acc71bd9-6408-44ab-b205-dec1f03964ab","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ المُفْرَدَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرعٌ من علم اللغةِ وعلمِ الدَّلالةِ تحديدًا، يُعنَى بدراسة مفرَداتِ اللغةِ من حيث اشتِقاقُها ودَلالاتُها ومُرادِفاتُها وتعَدُّدُ معانيها، ويُعنَى بتغَيِّر صِيَغِها وتطَوُّرِ دِلالاتِها عبرَ الزَّمن. والمشتَغِل بهذا العلمِ يُسمّى لغويًّا أي مُشتَغِلاً بمتن اللغةِ lexicologist. وعلمُ المعجَمِ أساسٌ تَعتَمِد عليه صِناعَةُ المعجَم، أي إن صُنّاعَ المعاجِمِ يَعتَمِدون على ما يقدِّمه علماءُ المفرَداتِ والدَّلالة. راجع:  @(lexicographer) و  @(lexicologist) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم المفردات ","nonDiacriticsLemma":"علم المفردات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ المُفْرَدَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

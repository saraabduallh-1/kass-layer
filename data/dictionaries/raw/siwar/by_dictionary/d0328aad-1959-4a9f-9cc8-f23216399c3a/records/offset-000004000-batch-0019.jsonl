{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fb4e2eb5-5618-4470-a83b-154f8c4970e7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fb4e2eb5-5618-4470-a83b-154f8c4970e7","word":"مَا بَعْدَ البِنْيَوِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99f0","lexicalEntryId":"fb4e2eb5-5618-4470-a83b-154f8c4970e7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَا بَعْدَ البِنْيَوِيَّةِ","lemmaType":"MslCom","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُطلَق على المرحَلة الارتداديةِ التالِيَةِ لمرحَلَة البِنيَويَّة في جميع فروعِ الدراساتِ اللغويةِ والأدَبيةِ والفِكرِية، التي اختَلفَت في نظرَتها لطبيعَة اللغة، ومَنهَج دراسَتِها، وأهدافِها؛ بما في ذلك الكلّياتُ اللغوية، والقواعدُ الكلّية، وبعضُ المذاهِبِ في النَّقْد الأدَبيِّ والاجتِماعيّ، وذلك في نهايَة الستينياتِ وبدايَةِ السبعينياتِ من القَرن العشرين، خاصّةً في فرنسا والولاياتِ المتحدَةِ الأمريكية. يتَلخَّص المصطلحُ في هَدم بعضِ المبادِئِ الأساسيةِ للبِنيَوِية؛ كالقَول بأن العَلاقَةَ بين الدّالِّ والمدلولِ غيرُ ثابِتَة، وأن الوحدَةَ النَّصِّيّةَ وَهمٌ، والسُّخرِيةِ من تَناقُضات المنطِقِ والمعنى الملازِمِ في الأعمال ذاتِها وتَفكيكِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ما بعد البنيوية ","nonDiacriticsLemma":"ما بعد البنيوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَا بَعْدَ البِنْيَوِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

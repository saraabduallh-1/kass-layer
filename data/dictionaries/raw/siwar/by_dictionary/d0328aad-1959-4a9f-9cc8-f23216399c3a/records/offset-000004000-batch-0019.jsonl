{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/02deee06-ec64-4158-8f8f-3df736d43fb6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"02deee06-ec64-4158-8f8f-3df736d43fb6","word":"مَرْحَلَةُ المِرَانِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99f2","lexicalEntryId":"02deee06-ec64-4158-8f8f-3df736d43fb6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَرْحَلَةُ المِرَانِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المرحلةُ الثانيةُ من مراحِل التَّدريسِ وفقا لبعض طرائقِ تَدريسِ اللغات. وهي المرحَلةُ التي يَتَدَرَّب فيها الطُّلابُ، أفرادا أو مجموعاتٍ، على استِعمال العناصِرِ اللغويةِ الجديدةِ في الدَّرسِ من كلماتٍ وعباراتٍ وتَراكيب، وينتَقِل فيها الطالبُ تَدريجيًّا من التَّدريب الموَجَّهِ إلى التَّدريب الحُرِّ. تُسمَّى أيضا مَرحَلَةَ التَّكرار repletion stage، وتَسبِقها مَرحَلَةُ العَرْضِ أو التَّقديمِ presentation stage، وتَليها مَرحَلَةُ الإنتاجِ production stage أو التَّدريبِ الحُرِّ free practice. راجع:  @(stage) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مرحلة المران ","nonDiacriticsLemma":"مرحلة المران","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَرْحَلَةُ المِرَانِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9ce1a829-259c-4828-a2b5-179eaef3fabf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9ce1a829-259c-4828-a2b5-179eaef3fabf","word":"مَدرَسَةُ برَاغ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99f3","lexicalEntryId":"9ce1a829-259c-4828-a2b5-179eaef3fabf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَدرَسَةُ برَاغ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مدرسةٌ لُغويةٌ بِنيَويَّةٌ، أسَّسَها مجموعةٌ من اللغويين في تشيكوسلوفاكيا عام 1926م، على رأسهم ماثِسيوس Vilem Mathesius، ورومان ياكوبسون Roman Jakobson ونيكولاي تروبتسكوي Nikolay Trubetskoy. اتَّفَقَت هذه المدرسةُ في الأُصول النظريةِ مع مدرسة جنيف Geneva school التي أسَّسَها فردينان دي سوسير  Ferdinand de Saussure، مع تَميُّزٍ في دِقَّة التحليل، والاهتِمامِ بالجانب الوَظيفيِّ للغة، والتَّفريقِ بين علمِ الأصواتِ (العامِّ) Phonetics والفونولوجيا Phonology، والعلاقةِ بين الأصوات والصِّيَغِ النَّحويةِ، بالإضافة إلى التَّوَسُّعِ في بعض المفاهيمِ البِنيَويَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مدرسة براغ ","nonDiacriticsLemma":"مدرسة براغ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَدرَسَةُ برَاغ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

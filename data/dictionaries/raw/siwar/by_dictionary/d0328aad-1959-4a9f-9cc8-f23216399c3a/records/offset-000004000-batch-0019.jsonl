{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b30c5281-8a41-455b-b222-093ce5424b39/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b30c5281-8a41-455b-b222-093ce5424b39","word":"تَعَدُّدُ المَرَاكِزِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99eb","lexicalEntryId":"b30c5281-8a41-455b-b222-093ce5424b39","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعَدُّدُ المَرَاكِزِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ استَعمَله بعضُ الباحثين في علم اللغةِ الاجتماعيِّ، للتَّعبير عن تعَدُّد مراكِزِ اللغةِ أو تَمَركُزِها، أي كَون اللغةِ لها أكثَرُ من مركَزٍ أو تَمرْكُز، كلُّ مَركَزٍ مستَقِلٌّ عن الآخَر؛ سواء تمثَّل في تعَدُّد المراكِزِ في المدُن داخِلَ الدولةِ الواحدةِ، أو في تعَدُّد المراكِزِ في دولٍ مختَلِفة. مثالُ ذلك اللغةُ الإنجليزيةُ التي تَتَمَركَز في كلٍّ من بريطانيا والولاياتِ المتحدةِ وكندا وأستراليا ونيوزيلندا، وكذلك اللغةُ البرتغاليةُ التي تَتَمَركَز في كلٍّ من البرتغال والبرازيل، والإسبانيةُ التي تتَمَركَز في إسبانيا وبعضِ دولِ أمريكا اللاتينيةِ، كالأرجَنتين. يُقابِل ذلك وحدَةُ المَكَزِ أو وحدَةُ التَّمَرْكُزِ monocentric.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعدد المراكز ","nonDiacriticsLemma":"تعدد المراكز","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعَدُّدُ المَرَاكِزِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0fc39e43-3bdf-41ca-ad17-d4da2e6492bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0fc39e43-3bdf-41ca-ad17-d4da2e6492bf","word":"حِسَابُ الشُّيُوعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90db","lexicalEntryId":"0fc39e43-3bdf-41ca-ad17-d4da2e6492bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حِسَابُ الشُّيُوعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قائمةٌ بالعناصِر اللغويةِ الشائعةِ في لغةٍ ما، من مورفيماتٍ وكلماتٍ وعبارات؛ استِنادا إلى دراسة إحصائيةٍ لعيِّناتٍ لغويةٍ مختارَةٍ من نصوصٍ أو مُدوَّناتٍ لغوية، عامَّةٍ، أو متَخصِّصةٍ. وتُعَدُّ قوائمُ الشُّيوعِ للاستفادة منها في التحليل، وإعدادِ الموادِّ التعليمية، ولاسيَّما في برامج تعليمِ اللغاتِ الأجنبية؛ فتُقَدَّم العناصِرُ الأعلى شُيوعا على الشائعة، وتقَدَّم الشائعةُ على غير الشائعة، دونَ إغفالٍ للجوانب الوَظيفيةِ والتخَصُّصِيةِ لبعض العناصِرِ اللغوية. راجع:  @(frequency list) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حساب الشيوع ","nonDiacriticsLemma":"حساب الشيوع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حِسَابُ الشُّيُوعِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8e441258-6e95-415a-bdab-54028ab5cc6a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8e441258-6e95-415a-bdab-54028ab5cc6a","word":"تَمْرِينُ تَعْدِيلِ الصِّيغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90d7","lexicalEntryId":"8e441258-6e95-415a-bdab-54028ab5cc6a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَمْرِينُ تَعْدِيلِ الصِّيغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تعليميٌّ، يُشير إلى تمرين لغويٍّ يتطلَّب من المتعلِّم تَعديلَ صِيغَةِ كلمةٍ معيَّنَةٍ حتى تُصبِح صحيحةً ضِمنَ الجُملَةِ والسِّياقِ الذي ورَدَت فيه؛ كأن يُطلَب منه تحويلُ المضارعِ إلى ماضٍ، أو تحويلُ الفعلِ المبنيِّ للمَعلوم إلى فعلٍ مبنيٍّ للمَجهول، أو العَكس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تمرين تعديل الصيغة ","nonDiacriticsLemma":"تمرين تعديل الصيغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَمْرِينُ تَعْدِيلِ الصِّيغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/be7f2997-175d-478c-9fac-f4aea673a865/get-public-entry"},"browse_index_record":{"lexicalEntryId":"be7f2997-175d-478c-9fac-f4aea673a865","word":"تَحَجُّرٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90d8","lexicalEntryId":"be7f2997-175d-478c-9fac-f4aea673a865","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحَجُّرٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلَحٌ لغويٌّ تطبيقيٌّ، يُشير إلى سِمةٍ من سِمات اللغةِ المرحَلية لمتعلِّمي اللغاتِ الأجنَبية، ويُقصَد به توَقُّفُ نُمُوِّ لغةِ المتعلِّمِ في مرحَلةٍ من مراحِل تعلُّمِه اللغةَ الهَدَفَ؛ تَوَقُّفًا جُزئيًّا أو كُلِّيًّا، مؤقَّتًا أو نِهائيًّا. فقد يحدُث التحَجُّرُ في نُطق المتعلِّم لأصواتٍ أو استعمالِه لصِيَغٍ أو تراكيبَ معيَّنَةٍ في مرحَلةٍ من المراحِل. وقد يَشمَل جميعَ جوانبِ اللغةِ ومستوياتِها من أصواتٍ وصرفٍ ونحوٍ ومفرداتٍ ودلالاتٍ ومفاهيمَ ثقافيةٍ واستعمالاتٍ تَداوُليَّة. وكلا النوعَين يحدُث مؤقَّتًا ثم يَزول فيما بعد، وقد يَبقى مدَى الحياة، خاصةً إذا توَقَّف المتعلِّمُ عن دراسة اللغةِ وتَنمِيَتِها. ويحدُث التحجُّرُ لأسبابٍ كثيرة، من أهمها: تلَقِّي المتعلِّمِ اللغةَ الهَدَفَ من غير الناطقين بها في المراحِل المبكِّرَةِ من تعلُّمه، وتوَقُّفُه عن التعلُّم قبلَ اكتِمالِ لغتِه، وشُعورُه بعَدَم الحاجَةِ إلى تَنمِيَتها، وضَعفُ التواصُل بها مع الناطقين بها. وثمةَ أساليبُ لمنع حُدوثِ التحجُّرِ قبلَ وُقُوعِه، وعِلاجِه بعدَ وُقُوعِه؛ كتَصويب الأخطاء، والتَّنبيهِ للقواعد. والتحجُّرُ لا يقتَصر على الأخطاء، وإنما يشمل تحجُّرَ الأنماطِ الصحيحةِ وعدم نموِّها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلَحٌ تركيبيٌّ معجَميٌّ، يُطلَق على تراكيبَ وكلماتٍ في لغةٍ ما لم تَعُد تُستَعمَل في تلك اللغة؛ مثل الجُملِ الإنجليزيةِ: So be it, long live the Queen and Least said, soonest mended، ومثلُ العبارَتَين الإنجليزيتَين: goody-goody, hocus-pocus. وتُسمّى كلمةً متحجِّرَةً: fossilized word، وصِيغَةً متحجِّرَةً: fossilized form.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحجر لغوي ","nonDiacriticsLemma":"تحجر لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحَجُّرٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9a960090-a015-41af-a3e6-2cbec14d1c54/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9a960090-a015-41af-a3e6-2cbec14d1c54","word":"سِمَاتٌ سَرِيعَةُ الزَّوَالِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90d9","lexicalEntryId":"9a960090-a015-41af-a3e6-2cbec14d1c54","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سِمَاتٌ سَرِيعَةُ الزَّوَالِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلِقُه بعضُ اللغويين على بعض الوحداتِ والعناصِرِ اللغوية، التي يتطلَّب اكتِسابُها عنايَةً خاصةً، ومُدخَلاتٍ لغويةً كافيَة. وغالبًا ما يتعلَّمها الطالبُ ثم تَزول من ذاكِرَته بسُرعة، ولا تُكتَسَب - في الغالب - إلا في مرحَلةٍ متأخِّرَةٍ من تعلُّم اللغةِ الهَدَف. ومن أمثِلَتها في الإنجليزية: مورفيماتُ الجَمعِ في الأسماء، ومورفيمُ المفرَدِ الغائب S، وبعضُ موفيماتِ الزَّمنِ في الأفعال. وتُقابِلها السِّماتُ المرِنَةُ resilient features.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"سمات سريعة الزوال ","nonDiacriticsLemma":"سمات سريعة الزوال","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سِمَاتٌ سَرِيعَةُ الزَّوَالِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/750a150a-19a5-4de1-9a26-64f2843fa5fd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"750a150a-19a5-4de1-9a26-64f2843fa5fd","word":"نَظَرِيَّةُ الخِطَابِ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e32","lexicalEntryId":"750a150a-19a5-4de1-9a26-64f2843fa5fd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ الخِطَابِ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ في اكتساب اللغةِ الثانية، تَنطلِق من تفسير النظريةِ الوَظيفيةِ لاكتساب اللغةِ الأمِّ، وترى أن الطفلَ يكتَسِب لغَتَه باستِعمالها في وَظائفَ تواصُليةٍ حقيقية. ترى إيفلين هاتش Evelyn Hatch، صاحبةُ نظريةِ الخِطابِ هذه، أن متعلِّمَ اللغةِ الثانيةِ يَكتَسبها بالتواصُل الحَقيقيِّ بها، وتزداد دوافِعُه كلّما أنجَز عمَلا أو تحقَّق له هدَفٌ أو رَغبَة. وترى هاتش أيضا أن اكتسابَ اللغةِ الثانيةِ يعتَمِد على الخِطاب أو الحديثِ الذي يتواصَل به متعلِّمُ اللغةِ الهدَفِ مع الناطقين بها، وذلك حين يكَيِّفون حديثَهم مع مستواه اللغوي؛ فيكون حديثهم حينئذٍ شائعا ومتدرِّجا بدرَجةٍ تُشبِه المدخلَ اللغويَّ الذي يتلقّاه الطفلُ الناطقُ باللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية الخطاب  ","nonDiacriticsLemma":"نظرية الخطاب ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ الخِطَابِ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/da69ddb9-3f0d-4359-abfa-61a1638c6d21/get-public-entry"},"browse_index_record":{"lexicalEntryId":"da69ddb9-3f0d-4359-abfa-61a1638c6d21","word":"تَمْيُّزٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e33","lexicalEntryId":"da69ddb9-3f0d-4359-abfa-61a1638c6d21","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَمْيُّزٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تَمَيُّزُ الوحداتِ اللغويةِ بعضِها عن بعض في أثناء الكلامِ أو الاستماعِ أو القراءةِ أو الكتابة. وهذه صفةٌ من صفات اللغةِ البشَرِية، حيث يُفَرَّق بين صوتٍ وآخَر، ومورفيمٍ وآخَر، وكلمةٍ وأخرى، وجُملةٍ وأخرى. بيدَ أن درَجاتِ التَّميِيز في الاستماع تختَلِف بحسب درَجَةِ إتقانِ المستَمِعِ للغة الهَدَف؛ فالناطِقُ بها يُميِّز بين وَحداتِها بدرَجَةٍ كامِلةٍ أو شِبهِ كامِلَة، في حين تختَلِط بعضُ هذه الوحداتِ لدى متعلِّمِ اللغةِ حين يَستَمِع إلى كلامٍ متواصِل. أما الذي لا يعرِف اللغةَ، فلا يميِّز بين أصواتِها وكلماتِها وعباراتِها، وقد يُشاركه في ذلك المتعلِّمُ المبتَدِئ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تميز ","nonDiacriticsLemma":"تميز","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَمْيُّزٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b80daf25-320d-476e-a266-6f8cc0335571/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b80daf25-320d-476e-a266-6f8cc0335571","word":"تَحْلِيلُ الخِطَابِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e44","lexicalEntryId":"b80daf25-320d-476e-a266-6f8cc0335571","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ الخِطَابِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَحليلُ أبنيةِ خِطابٍ مَنطوقٍ أو مَكتوبٍ يتجاوَز طولُه الجُملةَ الواحدةَ، مع تحليل الجُملَةِ ومُكوِّناتِها أيضا، ومعرِفة أَثَرِ اختيارِ الكلماتِ والأدواتِ والضمائرِ والأزمِنَةِ في هذه الأبنِية. يَدرُس هذا المنهجُ العلاقةَ الجامِعةَ بين جُمَلِه المختَلِفة، كما يَدرُس أسلوبَ المتحدِّثِ في التقديم للموضوع، وتَغيِيرِ الأسلوب، والالتِفاتِ، ونحوِ ذلك. ويُعتَقَد أن زاليغ هارِيس Zellig Harris هو أولُ من طبَّق هذا المنهَجَ في الدراسات اللغويةِ الحديثةِ وذلك في الخمسينيات من القرن العشرين. وقد أصبَح تحليلُ الخِطابِ مُهمًّا في قاعات تعليمِ اللغات؛ لتَحديد جَدوَى طريقَةِ التدريس، والعَلاقةِ بين المعلِّمِ والمتعلِّم، وأثَرِ ذلك في اكتساب اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل الخطاب ","nonDiacriticsLemma":"تحليل الخطاب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ الخِطَابِ"}],"lemmaLanguage":{"code":"ar","lab
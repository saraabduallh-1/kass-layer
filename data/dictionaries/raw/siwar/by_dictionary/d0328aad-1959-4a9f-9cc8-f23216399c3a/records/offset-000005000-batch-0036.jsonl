{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8c141e17-ae67-413f-9737-c04f8d32ee0e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8c141e17-ae67-413f-9737-c04f8d32ee0e","word":"تَعلِيمُ العَرَبِيَّةِ لُغَةً أَجنَبِيَّةً","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fa8","lexicalEntryId":"8c141e17-ae67-413f-9737-c04f8d32ee0e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعلِيمُ العَرَبِيَّةِ لُغَةً أَجنَبِيَّةً","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَعليم اللغةِ العربيةِ خارجَ مَواطِنِ الناطقين بها، وقد يَشمل تَعليمَها لغةً ثانيةً في مَوَاطِنها. لكنّ بعضَ اللغويِّين لا يرى استِعمالَ هذا المصطلَحِ في تعليم العربيةِ للناطِقين بغيرها من المسلمين باعتبار أنها لغةٌ لجميع المسلمين، أي إنها ليسَت أجنبيةً بالنسبة إليهم. أما المصطلَحُ المختَصَرُ TAFL، فقد شاع استِعمالُه في أقسام الدراساتِ الشَّرقيةِ، وأقسامِ دراساتِ الشَّرقِ الأوسَط، وأقسامِ اللغةِ العربية، ولاسيَّما في الجامعات الغربية، ليشمَل تعليمَ العربيةِ لغةً أجنَبيةً ولغةً ثانية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم العربية لغة أجنبية ","nonDiacriticsLemma":"تعليم العربية لغة أجنبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعلِيمُ العَرَبِيَّةِ لُغَةً أَجنَبِيَّةً"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

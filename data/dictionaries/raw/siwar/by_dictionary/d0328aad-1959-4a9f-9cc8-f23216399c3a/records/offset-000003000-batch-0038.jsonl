{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f94433ad-c4bb-49d4-85c3-9f20694b5ee6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f94433ad-c4bb-49d4-85c3-9f20694b5ee6","word":"تَهْجِينٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97cf","lexicalEntryId":"f94433ad-c4bb-49d4-85c3-9f20694b5ee6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَهْجِينٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُطلَق على العَمَلية التي تَنشَأ بسبَبها اللغةُ الهَجِينُ pidgin language، المتمثِّلةُ في اختِلاط مجموعاتٍ من الناس ناطِقَةٍ بلغاتٍ مختَلِفةٍ مُضطرَّةٍ إلى التَّخاطُب بلغةٍ ليسَت لغةً أمًّا لأيِّ مجموعةٍ منهم. ويُطلَق أيضا على الأسبابِ التي تُساعِد في حدوثها، والمراحِلِ التي تَمُر بها، سواء أكان التَّهجينُ في اللغة ذاتِها أم في اللغة المرحَليةِ لمتعلِّم اللغةِ الثانيةِ أو الأجنبية. pidgin (language) (1).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُشير إلى تَوَقُّف لغةِ متعلِّم اللغةِ الثانيةِ أو الأجنبيةِ في مستوى مُتَدَنٍّ تَوَقُّفًا مَرحَليًّا أو نهائيًّا؛ بحيث يَستَعمِل لغةً هَجِينًا قليلةَ المفرداتِ، بسيطةَ التراكيب، خاليةً من الأدوات والكلماتِ الوَظيفية. يَحدُث هذا التهجينُ حين يَكتَفي متعلِّمُ اللغةِ الثانيةِ بالحَدِّ الأدنى من الكِفايَة اللغويةِ التي تُمكِّنه من التَّواصُل المبدَئيِّ باللغة الهَدَفِ لقضاء حاجاتِه الضَّرورية. يُشَبِّه بعضُ اللغويين هذا التهجينَ بالتَّحَجُّر اللغويِّ fossilization، ويرى آخَرون أنه التَّحَجُّر نفسُه، أو أنه نَتيجَةٌ للتَّحَجُّر. راجع:  @(fossilization) و  @(pidginization hypothesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"تهجين ","nonDiacriticsLemma":"تهجين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَهْجِينٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fc1025cc-6d7d-42ab-a6f4-ca7bba903d34/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fc1025cc-6d7d-42ab-a6f4-ca7bba903d34","word":"مَسَارٌ طَبِيعِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97d0","lexicalEntryId":"fc1025cc-6d7d-42ab-a6f4-ca7bba903d34","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَسَارٌ طَبِيعِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ استَخدَمه اللغويُّ التطبيقيُّ رود إليس Rod Ellis، يَعني به المسارَ اللغويَّ الطبيعيَّ الذي يَسير عليه متعلِّمُ اللغةِ الثانيةِ في اكتساب مورفيماتِ اللغةِ وصيغِها وأنماطِها وتراكيبِها؛ ويفرّق إليس بين أمرَين، هما: المسارُ route، ودرَجةُ السُّرعَةِ rate. ويَعني بالأول المسارَ الطبيعيَّ في اكتساب اللغة، ويَعني بالثاني المدَّةَ اللازِمَةَ لاكتساب كلِّ مورفيمٍ أو نَمَطٍ أو تركيب فيها. ويرى إليس أن التدريسَ المنهَجيَّ للغة instructed language لا يُغيِّر من المسارِ الطبيعيِّ لاكتساب اللغة، لكنه قد يَزيد سُرعَةَ الاكتسابِ لمورفيمٍ أو مورفيماتٍ في مرحَلةٍ أو مراحِلَ معيَّنة، بحسب عُمرِ المتعلِّمِ، ونَوعِ الموادِّ التعليميةِ التي يتلقَّاها وكمِّيَّتِها. ويرى أيضا أن متعلمي اللغةِ الثانيةِ قد يختَلِفون في سُرعَة اكتسابِها، لكن لا تختَلِف مَساراتُهم في ذلك، ولا يَتقَدَّم بعضُ هذه المساراتِ على بعض.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مسار طبيعي ","nonDiacriticsLemma":"مسار طبيعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَسَارٌ طَبِيعِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/314a5576-ff34-4046-934d-bab881b9ace3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"314a5576-ff34-4046-934d-bab881b9ace3","word":"اتِّجَاهٌ سَلْبِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97d1","lexicalEntryId":"314a5576-ff34-4046-934d-bab881b9ace3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اتِّجَاهٌ سَلْبِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الموقِفُ أو الاتجاهُ السَّلبيُّ الذي يكون لدى متعلِّمِ اللغةِ الثانيةِ منها أو من ثقافتها أو من الناطقين بها. هذا الموقِفُ غالبا ما يؤثِّر سَلبا في اكتسابه اللغةَ نفسَها؛ لأن الموقِفَ السَّلبيَّ من اللغة يؤدِّي إلى عَزْل المتعلِّمِ عن أهل اللغة؛ فيُقَلِّل من تواصُله معهم، ويحُدُّ من المدخَلات والمخرَجات اللغوية؛ فتتَقَوَّى الحَوَاجِزُ الاجتماعيةُ والنفسيةُ بينه وبين اللغةِ نفسِها، وقد يؤدِّي ذلك كلُّه إلى تحَجُّر لغةِ المتعلِّم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اتجاه سلبي ","nonDiacriticsLemma":"اتجاه سلبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اتِّجَاهٌ سَلْبِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7f5dd5b2-1fe8-48d1-bd31-4d35e2606d4f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7f5dd5b2-1fe8-48d1-bd31-4d35e2606d4f","word":"مُرونَة عَصَبِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97d3","lexicalEntryId":"7f5dd5b2-1fe8-48d1-bd31-4d35e2606d4f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُرونَة عَصَبِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُشير إلى سِمَةٍ لأعصاب الدِّماغِ في مرحَلة الطفولة، خاصةً الأعصابَ المسؤولةَ عن الوَظائف اللغوية، إذ تُمَكِّن هذه اللُّيُونَةُ الطفلَ من اكتساب مختَلِفِ المهاراتِ التي من أهمها المهاراتُ اللغويةُ. يُرجِع بعضُ الباحثين صُعوبةَ اكتسابِ المرءِ اللغةَ الثانيةَ بعد سِنِّ الطفولةِ بشَكلٍ طبيعيٍّ إلى فَقْد تلك الأعصابِ لهذه اللُّيُونةِ تدريجيًّا ثم تَصَلُّبِها، وهو ما يُعرَف بالتفسير البيولوجيِّ لاكتساب اللغة. لكنّ باحثين آخرِين لا يؤمنون بالتفسيرِ البيولوجيِّ لهذه الظاهرَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مرونة عصبية ","nonDiacriticsLemma":"مرونة عصبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُرونَة عَصَبِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

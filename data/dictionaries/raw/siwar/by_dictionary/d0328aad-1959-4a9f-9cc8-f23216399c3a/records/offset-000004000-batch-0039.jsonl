{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/17a91800-c422-48a7-a367-fd1f5ef5d44e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"17a91800-c422-48a7-a367-fd1f5ef5d44e","word":"تَمْثِيلُ الأَدْوَارِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9be1","lexicalEntryId":"17a91800-c422-48a7-a367-fd1f5ef5d44e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَمْثِيلُ الأَدْوَارِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَوعٌ من الأنشِطَة الصَّفِّيَّةِ التي يُمارِسها الطلابُ في حُجرَة الدَّرسِ بطَريقةٍ درامِيَّة؛ كأن يَقوم أحَدُ الطلابِ بدَور بائعٍ، وآخَرُ بدَور مُحاسِبٍ، وثالثٌ بدَور زَبونٍ أو مُشتَرٍ، ويَتَحَدَّث كلُّ واحِدٍ منهم بالأسلوب المناسِبِ لدَوره. ولَعِبُ الأدوارِ من الأنشِطَة والإجراءاتِ التي شاع استِعمالُها حديثا في فُصول تَعليمِ اللغات؛ لأنها تَكسِر حاجِزَ الخَوفِ لدى الطلابِ من استِعمال اللغةِ الهَدَف، وتُشَجِّعهم على الكلام الذي يَقود إلى الطَّلاقَة اللغوية، وتُمثِّل لهم بِيئةَ اللغةِ الهَدَفِ في قاعَة الدَّرس، بصُورَةٍ طَبيعِيّةٍ أو شِبهِ طَبيعِيّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تمثيل الأدوار ","nonDiacriticsLemma":"تمثيل الأدوار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَمْثِيلُ الأَدْوَارِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

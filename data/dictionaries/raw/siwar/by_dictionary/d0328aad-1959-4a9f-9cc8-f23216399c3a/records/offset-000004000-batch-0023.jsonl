{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/24492a73-27d0-4a0e-b435-842db9920fb0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"24492a73-27d0-4a0e-b435-842db9920fb0","word":"افْتِرَاضٌ مُسْبَقٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a5f","lexicalEntryId":"24492a73-27d0-4a0e-b435-842db9920fb0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"افْتِرَاضٌ مُسْبَقٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"افتِراضُ المتكلِّمِ أو الكاتِبِ افتِراضًا مُسبَقًا بأن المتَلَقِّيَ يَعلَم ما يَقصدُه في كلامه أو كِتابَتِه. فقَولُ محمدٍ لزيدٍ مثلا: ما رأيُك في دَعوَة إبراهيمَ للعَشاء؟ ثم رَدُّ زيدٍ بقوله: فِكرَةٌ جيَّدةٌ ويُمكِن أن يَصطَحِب معه عَليًّا، يَتضَمَّن افتِراضًا مُسبَقًا لدى المتَخاطِبَيْن، محمد وزيد، بأن إبراهيمَ لديه سيّارة، وأنه قَريبٌ من منزِل عليٍّ الذي ليس لدَيه سيّارة. ويَغلِب على لغة الأطفالِ الافتِراضُ المسبَقُ بأن السّامِعَ يُدرِك ما يَعتَقِدونه ولو لم يكن هذا الافتراضُ صحيحًا أو واقعًا؛ فيتَضَمَّن كلامُهم إشاراتٍ إلى أسماء أشخاصٍ وأماكنَ وأشياءٍ ربما لا يَعرِفها السّامِعُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"افتراض مسبق ","nonDiacriticsLemma":"افتراض مسبق","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"افْتِرَاضٌ مُسْبَقٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9034786f-1461-479b-b540-793f376ae425/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9034786f-1461-479b-b540-793f376ae425","word":"مَرْحَلَةُ ما قَبْلَ التَّدْرِيسِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a60","lexicalEntryId":"9034786f-1461-479b-b540-793f376ae425","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَرْحَلَةُ ما قَبْلَ التَّدْرِيسِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَرحَلَةُ الاستِعدادِ والتَّهيِئةِ للدَّرس، وهي مَرحَلَةُ اختِيارِ المعلِّمِ العَناصِرَ اللغويةَ الجَديدةَ أو الصَّعبةَ التي سوف تُواجِه الطُّلابَ في النَّشاط القادِمِ في أثناء الدَّرس، وتَدريسُ هذه العناصِرِ للطلاب قَبلَ مُمارَسَتِهم إيّاها في هذا النَّشاط. مثالُ ذلك تَدريسُهُم المفرَداتِ الصَّعبةَ التي سوف تَرِد في تدريبات فَهمِ المسموعِ قَبل مُمارسَتِهم هذا التَّدريب، أو شَرحُ بعضِ الكلماتِ والمفاهيمِ الجديدةِ في النَّص المقروءِ قبلَ قراءتِه، أو رَبطُ معلوماتِهم السابقَةِ بالمعلومات الجديدةِ في النَّص.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مرحلة ما قبل التدريس ","nonDiacriticsLemma":"مرحلة ما قبل التدريس","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَرْحَلَةُ ما قَبْلَ التَّدْرِيسِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

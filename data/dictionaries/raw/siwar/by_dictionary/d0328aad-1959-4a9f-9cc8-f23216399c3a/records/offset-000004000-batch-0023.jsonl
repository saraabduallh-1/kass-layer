{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fba1d8dc-e668-4161-a6d4-44998b3d9d57/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fba1d8dc-e668-4161-a6d4-44998b3d9d57","word":"أَثَرُ الأَسْبَقِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a4b","lexicalEntryId":"fba1d8dc-e668-4161-a6d4-44998b3d9d57","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَثَرُ الأَسْبَقِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُشير إلى ظاهرَةٍ في فَهم الكلامِ والاحتِفاظِ بمفرَداته، تتلخَّص في أن المرءَ حين يَسمَع كلامًا فإنه يتذَكَّر منه الكلماتِ التي في أوَّله، لكن ما يتذكَّره من الكلمات التي في آخِر الكلامِ تزيد على ما يتذكَّره من الكلمات التي في أوَّله، وتُسمّى هذه الظاهرَةُ أثَرَ الحَداثَةِ recency effect؛ لأن الأخيرَةَ تَقبَع داخِلَ الذاكرَةِ قصيرَةِ الأمَد. وتُشير نتائجُ الدراساتِ في هذه الظاهرَةِ أنه لو عُرِضَت قائمَةُ الكلماتِ على المرء بمعدَّلٍ أبطأ فإن عَدَدَ الكلماتِ التي في أوَّل القائمَةِ تتزايَد، في حين يتَناقَص عَدَدُ الكلماتِ التي في آخِرها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أثر الأسبقية ","nonDiacriticsLemma":"أثر الأسبقية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَثَرُ الأَسْبَقِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9c2d1a3b-9904-4338-affd-35cd5c0b709a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9c2d1a3b-9904-4338-affd-35cd5c0b709a","word":"ضَمِيرٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a4c","lexicalEntryId":"9c2d1a3b-9904-4338-affd-35cd5c0b709a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ضَمِيرٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"لَفظٌ يَسُدُّ مَسَدَّ الاسمِ أو العبارَةِ الاسمية، أو هو نَوعٌ من أنواع الاسم، وتَدُلُّ صِيغَتُه على العَدَد (الإفراد والتثنية والجمع) أو الجِنسِ (التذكير والتأنيث) أو الشَّخصِ (المتكلم والمخاطَب والغائب) أو الحالَةِ الإعرابية، أو الاتِّصالِ والانفِصال، وقد تَدُل الصِّيغَةُ على أكثَر من واحدٍ من ذلك. يختَلِف اللغويون في تَصنيف الضَّمائر كما تختَلِف فيه اللغاتُ أيضا؛ فالضَّمائرُ في النحو العربيِّ تُعدُّ نوعًا من أنواع الاسم، وفي علم اللغةِ الحديثِ، وفي بعض اللغاتِ أيضا، تُعَدُّ صِنفًا من أصناف الكلامِ مستَقِلًّا بذاته، وتَدخُل فيها أسماءُ الإشارة، وقد تَدخُل فيها الأسماءُ الموصُولَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"ضمير ","nonDiacriticsLemma":"ضمير","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ضَمِيرٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d5b5380e-a8d2-4448-9add-96de469ca08e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d5b5380e-a8d2-4448-9add-96de469ca08e","word":"اخْتِبَارٌ بَعْدِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a4d","lexicalEntryId":"d5b5380e-a8d2-4448-9add-96de469ca08e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِبَارٌ بَعْدِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلٌح في البحث العلميِّ، يُشير إلى أيِّ اختبارٍ يُعطَى للطالب (المفحُوصِ) بعد مُرورِه بعمَليَّة التعلُّمِ أو المعالَجَةِ treatment، في مُقابِل الاختبارِ القَبْليِّ pre-test الذي يُعطَى للطالب قبلَ عمَليَّةِ التعلُّمِ أو المعالَجَة. ولكلٍّ من الاختبارَيْن وَظائفُ وأهدافٌ محدَّدَةٌ، وغالبا ما يُجمَع بين النَّوعَين، ويَفصل بينهما التعلُّمُ أو المعالَجَةُ، وذلك في قِياس أثَرِ التعلُّم لأهدافٍ تعليميَّةٍ أو بَحثيَّة؛ كتَجريب طريقَةٍ في التَّدريس، أو نَشاطٍ من أنشِطَتها، أو إجراءٍ من إجراءاتها.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار بعدي ","nonDiacriticsLemma":"اختبار بعدي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِبَارٌ بَعْدِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0b085b08-d657-41a0-8650-194e9e0255a6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0b085b08-d657-41a0-8650-194e9e0255a6","word":"فَشَلٌ تَدَاوُلِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a4e","lexicalEntryId":"0b085b08-d657-41a0-8650-194e9e0255a6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَشَلٌ تَدَاوُلِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلَحٌ لغويٌّ تطبيقيٌّ استَعمَلته جيني توماس Jenny Thomas، إشارةً إلى عدَم فهمِ المخاطَب مَقصودَ المتكلِّمِ فَهمًا حقيقيًّا، ولاسيَّما حين يكون المخاطَبُ من متعلِّمي اللغة، وعدَمِ قدرَةِ المتعلِّمِ على إيصال رسالَتِه تداوُليًّا. تُميِّز توماس بين نوعَين من الفَشَل التداوُلي: أحدُهما فَشَلٌ لغويٌّ تداوُليٌّ pragma/pragmatic linguistic failure ناتِجٌ عن نَقصٍ في الكِفايَة اللغويةِ البنائيَّة؛ والآخَرُ فَشَلٌ تداوُليٌّ اجتماعيٌّ social-pragmatic failure ناتِجٌ عن نقصٍ في الكفايَة الاجتماعيةِ التي لا تُكتَسَب بالتعلُّم وحدَه. وترى توماس أن متعلِّمَ اللغةِ الثانيةِ قد يُتقِن قواعدَها وقوانينَها البنائيّةَ الظاهرَة، لكنه لا يُدرِك بعضَ الكلامِ في سياقٍ أو مقامٍ ما عندما يَستَنِد هذا الإدراكُ إلى مفاهيمَ ثقافية تداوُلية، وحينئذٍ لا تُفيده كِفايَتُه النحويةُ ولا كِفايتُه المعجَمية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فشل تداولي ","nonDiacriticsLemma":"فشل تداولي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.
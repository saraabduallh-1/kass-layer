{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ea45342f-7144-4329-b77a-6e35d73ec1bd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ea45342f-7144-4329-b77a-6e35d73ec1bd","word":"أبنِيَةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9548","lexicalEntryId":"ea45342f-7144-4329-b77a-6e35d73ec1bd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أبنِيَةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الأبنية مجموعةٌ من العناصِر اللغويةِ التي تَربطها علاقاتٌ عُضوية. والتركيب اللغويُّ يَشمَل الجُملةَ وغيرَ الجُملةِ؛ فيكون جُملةً مفيدةً، نحوَ: بابُ الغُرفةِ مَفتوحٌ، ويكون عبارةً غيرَ مُفيدةٍ، نحوَ: بابُ الغُرفةِ. ويُطلَق التركيبُ أيضا على أيِّ وحدةٍ لغويةٍ يمكن تحليلُها إلى وحداتٍ أصغَر. مثلُ المورفيمِ الذي يمكن تحليلُه إلى فونيمات، والكلمةِ التي يمكن تحليلُها إلى مورفيمات، والعبارةِ التي يمكن تحليلُها إلى كلمات، والجُملةِ التي يمكن تحليلُها إلى عبارات. راجع:  @(structure) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أبنية لغوية ","nonDiacriticsLemma":"أبنية لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أبنِيَةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

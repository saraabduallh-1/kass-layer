{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/644859d7-609d-4c11-90dc-45cfc54d4109/get-public-entry"},"browse_index_record":{"lexicalEntryId":"644859d7-609d-4c11-90dc-45cfc54d4109","word":"صَفْحَةٌ إلِكْترُونِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba171","lexicalEntryId":"644859d7-609d-4c11-90dc-45cfc54d4109","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَفْحَةٌ إلِكْترُونِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وثيقةٌ رَقميّةٌ تتألَّف من مجموعَةٍ من النُّصوص والبياناتِ والصَّوتِ والفِيديو والوَصلات. والصفحَةُ الإلكترونيةُ قد تكون وَثيقةً عامَّةً يمكن الوُلوجُ إليها عبرَ شَبَكةِ الاتصالاتِ العالَمِية، أو وَثيقةً نصفَ خاصَّةٍ يمكن الوُلوجُ إليها عَبرَ الإنتَرنِت، أو شَبَكةً خاصَّةً على آلَةٍ محلِّيَّة. ويمكن لمعلِّم اللغةِ أن يَصنَع لنفسه صفحةً إلكترونيةً حولَ موضوعٍ معيَّن، ويَضعها على شَبَكة الاتصالاتِ العالَمية، وهذا يَسمَح لطلابه وطلابٍ آخَرِين بالوُلوج إليها عبرَ حاسِباتِهم الشَّخصِيَّة. كما يُمكِنه تَخزينُ الصفحَةِ الإلكترونيةِ كمَلَفٍّ مَحَلِّيٍّ في حاسوبه الصَّفِّيِّ، يَستطع طلابُه وحدهم الوُلوجَ إليها في أثناء وُجودِهم في حجرَة الدرس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صفحة إلكترونية ","nonDiacriticsLemma":"صفحة إلكترونية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَفْحَةٌ إلِكْترُونِيَّةٌ"}],"lemmaLa
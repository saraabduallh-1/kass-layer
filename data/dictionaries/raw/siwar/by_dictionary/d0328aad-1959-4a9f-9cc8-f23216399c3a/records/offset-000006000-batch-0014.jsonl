{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/04a2a81a-e65c-40dd-a667-66cffbbf275e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"04a2a81a-e65c-40dd-a667-66cffbbf275e","word":"حَالَةُ المُنَادَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba179","lexicalEntryId":"04a2a81a-e65c-40dd-a667-66cffbbf275e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَالَةُ المُنَادَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عبارةٌ اسميَّةٌ تَقَع في الجُملة بصورةٍ اختيارِيّةٍ في بعض اللغات، كالإنجليزية مثلا، وتتضَمَّن اسمَ المنادى، مثلُ: Mrs. Johnson في جُملة: That is pretty dress, Mrs. Johnson، أو الإشارَةَ إليه، مثلُ: dear في جُملة: Really dear, do you think so?.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"حالةٌ إعرابيّةٌ للأسماء والضمائرِ تدُل في بعض اللغاتِ على أن الكلمةَ يُراد بها النِّداء. وليس في العربية حالَةٌ خاصَّةٌ بالنِّداء إلا في كلماتٍ بعَينها، مثل: (أبَتَاه) و(عَمّاه) و(اللَّهمَّ)، لكن يُمَيَّز المنادى فيها - كما في كثيرٍ من اللغات - بتَنغيمٍ خاصٍّ، وباقتِرانه بأداةِ النِّداءِ (يا) أحيانا، وبمَوقِعِه أحيانا أخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حالة المنادى ","nonDiacriticsLemma":"حالة المنادى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"
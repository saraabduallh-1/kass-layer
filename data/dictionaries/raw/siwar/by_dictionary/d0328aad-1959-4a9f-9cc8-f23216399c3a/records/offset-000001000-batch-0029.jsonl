{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/af625161-699a-4ffb-9981-27cb1ec666f0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"af625161-699a-4ffb-9981-27cb1ec666f0","word":"الكَلامُ المُبَكِّرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f19","lexicalEntryId":"af625161-699a-4ffb-9981-27cb1ec666f0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الكَلامُ المُبَكِّرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الكلامُ الذي يُنتِجه متعلِّمُ اللغةِ الأجنَبيةِ في مرحَلةٍ مبكرةٍ من التعلُّم قبل مَوعِده، أي قبلَ أن يكون مستِعِدًّا له. ويُعتَقَد أن محاوَلةَ المتعلِّمِ الكلامَ باللغة الهَدَف، أو حَملَه على ذلك، في هذه المرحَلةِ يضرُّ بلغته في المستقبل؛ فيَقَع في أخطاء كثيرة، وقد يَقبَلها منه المستَمِعون أو المخاطَبون، فلا يرى حينئذٍ ضَرورَةً لتَصويبها أو تَعديلِها، وربما تُصبِح جزءًا من لغته. ويرى بعضُ اللغويين أن الكلامَ المبكرَ من أهم أسبابِ التَّحَجُّرِ اللغويِّ fossilization.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الكلام المبكر ","nonDiacriticsLemma":"الكلام المبكر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الكَلامُ المُبَكِّرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

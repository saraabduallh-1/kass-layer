{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/73e2644d-cc29-4749-a2dc-43e33da915d5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"73e2644d-cc29-4749-a2dc-43e33da915d5","word":"مَسْرَحِيَّةٌ (دراما)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f1e","lexicalEntryId":"73e2644d-cc29-4749-a2dc-43e33da915d5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَسْرَحِيَّةٌ (دراما)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إجراءٌ أو نشاطٌ يُطَبَّق في بعض طرائقِ تعليمِ اللغاتِ الأجنبية؛ لأغراض تعليميةِ مختَلِفة، منها: تعليمُ الأصوات، والتدريبُ على الأنماط اللغويةِ في المواقِف المختَلِفة، وكَسرُ الحَواجِزِ النفسيةِ نحوَ الكلامِ باللغة الهَدَف، وتَقويةُ الحَوافِزِ لدى المتعلِّم، وإيصالُ المفاهيمِ الثقافيةِ والمعاني التَّجريديةِ للمتعلِّمين. ويمكن تَطبيقُه في عَدَدٍ من الطرائق في المستويات المبتدئةِ والمتوسِّطَةِ والمتقدِّمَة؛ فالاستجابةُ الجسَديةُ الكامِلةُ TPR تُطبِّقُه في المستوى المبتدئ، والطريقةُ التواصليةُ تُطَبِّقُه في المستويَين المتوسِّطِ والمتقدِّم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مسرحية (دراما) ","nonDiacriticsLemma":"مسرحية (دراما)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَسْرَحِيَّةٌ (دراما)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

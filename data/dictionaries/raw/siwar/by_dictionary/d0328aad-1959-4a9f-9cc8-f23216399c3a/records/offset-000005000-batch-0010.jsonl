{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f1d56ac8-aeb7-4072-808d-b2b7c5ac1d0b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f1d56ac8-aeb7-4072-808d-b2b7c5ac1d0b","word":"التَّصْحِيحُ الانْتِقَائيُّ للأَخْطَاءِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d13","lexicalEntryId":"f1d56ac8-aeb7-4072-808d-b2b7c5ac1d0b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّصْحِيحُ الانْتِقَائيُّ للأَخْطَاءِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغات، يَعني أن يَختار المعلِّمُ بعضَ الأخطاءِ في كلام الطالبِ أو في كتابَته ويُصحِّحَها اعتِمادًا على مَعايِيرَ تَعليميَّةٍ أو عِلميَّة. ففي مُستَوًى معيَّنٍ يُركِّز المعلِّمُ على الأخطاء التي تُحدث تَغيِيرًا في المعنى، أو تُعيق فَهمَه، أو تكون مُهمَّةً لوقوعها ضِمنَ ما يَكتَسِبه في هذه المرحَلَةِ في العادَة، ويَغضُّ الطَّرفَ عن الأخطاء التي تكون أنماطُها وتراكيبُها في مرحَلَةٍ لاحِقة، أو التي لا تُؤثِّر في فَهم المعنى، أو غير ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التصحيح الانتقائي للأخطاء ","nonDiacriticsLemma":"التصحيح الانتقائي للأخطاء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّصْحِيحُ الانْتِقَائيُّ للأَخْطَاءِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

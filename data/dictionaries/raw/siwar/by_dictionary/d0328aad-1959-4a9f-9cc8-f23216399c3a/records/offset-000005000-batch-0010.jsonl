{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/33fb7ac6-e16d-4077-a158-3381c6123868/get-public-entry"},"browse_index_record":{"lexicalEntryId":"33fb7ac6-e16d-4077-a158-3381c6123868","word":"لُغَةٌ عِلْمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d11","lexicalEntryId":"33fb7ac6-e16d-4077-a158-3381c6123868","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ عِلْمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ الخاصَّةُ بمصطَلَحات عِلمٍ من العُلوم؛ كلُغَة الطِّب، ولغَةِ الفِيزياء، ولغَةِ الرياضيات، ولغَةِ الفُقهاء، ولغةِ الأدَباء، ونحوِ ذلك، وهو استِعمالٌ مَجازِيّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَصفٌ يُطلَق على اللغة أو اللغاتِ التي تَكون لغةَ التَّدريسِ في الجامعات، وتُكتَب بها البُحوث والدراساتُ العِلمِيَّة، كالعربيةِ والإنجليزيةِ والألمانيةِ والفَرنسيةِ واليابانية، خلافًا لكَثيرٍ من اللغات التي تَقتَصِر على التَّوَاصُل الشَّفَهيِّ وبعضِ الكتاباتِ غيرِ العِلمِيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة علمية ","nonDiacriticsLemma":"لغة علمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ عِلْمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/978d5082-1d61-4f83-8316-2ffd3fda298f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"978d5082-1d61-4f83-8316-2ffd3fda298f","word":"النَّحْوُ الدَّلالِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d05","lexicalEntryId":"978d5082-1d61-4f83-8316-2ffd3fda298f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوُ الدَّلالِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، يُطلَق على نظامٍ من القواعد استُخدِم في وَضع كثيرٍ من بَرامِج مُعالَجَةِ اللغة الطبيعية، ويَتَمَثَّل في تَضمِين المعلوماتِ والقُيُودِ الدَّلالِيَّةِ في قواعد التركيبِ العِبارِي، وتَطبيقِ هذه القُيُودِ على مُستَوَى التركيبِ النحويِّ السَّطحِيِّ للجُملة. فبدَلا من التَّعبير عن قواعد التركيبِ العِبارِيِّ بالأنواع النحويَّةِ كالاسم والفِعلِ والمفعولِ به، تُستخَدَم أنواعٌ دَلالِيَّةٌ في صِياغَة القاعدةِ الدَّلالِيَّة. ولأن الأنواعَ الدَّلاليةَ غيرُ محدودَةٍ، فإن نِظامَ القواعدِ الدَّلاليةِ يُستَخدَم فقط في مُعالَجَة عيِّناتٍ من اللغة لا اللغة بكامِلِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النحو الدلالي ","nonDiacriticsLemma":"النحو الدلالي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّحْوُ الدَّلالِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e6554559-0018-4475-bc3e-d60c41fd709c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e6554559-0018-4475-bc3e-d60c41fd709c","word":"تَوَاصُّلٌ جُزْئِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d06","lexicalEntryId":"e6554559-0018-4475-bc3e-d60c41fd709c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوَاصُّلٌ جُزْئِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، استعمَله إينار هاوغين Einar Haugen، لوَصف طريقَةِ التواصُلِ بين مُواطِني الدّولِ الإسكِندنافيةِ الناطِقين بلغاتٍ متقارِبَةٍ أو متَشابِهةٍ في جوانِب ومختَلِفةٍ في جوانبَ أخرى. فالدّانماركيةُ والنّرويجيةُ تَشتَرِكان في كثيرٍ من المفرَدات المعجَمية، والنّرويجيةُ والسّوَيدِيةُ متَقارِبتَان في نُطق الأصوات، في حين تختَلِف الدانماركيةُ في النّطق عن كلٍّ من السّويدِية والنّرويجية. فالتُّشابُهُ في جوانب والاختِلافُ في جوانب أخرى يمنَح المتحَدِّثين بهذه اللّغاتِ فُرَصًا لتَعويض الاختِلافِ في جانبٍ بالتَّشابُه أو التَّقارُبِ في جوانب أخرى؛ فيتَحَدّث كلُّ فَريقٍ بلغَته الأمِّ مع الفَريق الآخَر، ويختار كلماتٍ مشتَرَكةً، مع وُضوحٍ في النَّطق، وبُطءٍ في الكلام، وتَبسِيطٍ في التراكيب. ولهذه الحالَةِ الإسكندنافيةِ حالاتٌ مُشَابِهَةٌ في باكستان وأفغانستانَ والهِندِ وغيرِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تواصل جزئي ","nonDiacriticsLemma":"تواصل جزئي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d7b4d386-2b1f-49ce-86e5-a2f3fbfa64ad/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d7b4d386-2b1f-49ce-86e5-a2f3fbfa64ad","word":"عِلْمُ الرُّمُوزِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d0e","lexicalEntryId":"d7b4d386-2b1f-49ce-86e5-a2f3fbfa64ad","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ الرُّمُوزِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمُ الإشاراتِ والعَلامات، وهو الدِّراسةُ العِلميةُ للإشاراتِ والرُّموز اللغويةِ وغيرِ اللغويةِ بوَصفها أدواتِ تَواصُل. فهو علمٌ يَدرُس خَصائصَ الأنظِمَةِ الرَّمزِيَّةِ الطَّبيعيةِ والاصطِناعِيةِ من النواحي اللغويةِ والفَلسَفيةِ والاجتِماعيةِ والنَّفسِية، ولاسيما النظامُ الرَّمزيُّ المستَعمَلُ للتَّوَاصُل البَشَرِيّ. يُقسَّم هذا العلمُ إلى ثلاثَة أقسام هي: علمُ الدّلالة، وعلمُ الرُّموزِ التَّوَاصُليّ، وعلمُ الرُّموزِ العَلاقِيّ. يوَضُمّ علمُ الرُّموزِ كثيرًا من فروع علمِ اللغة، ولاسيَّما الدّلالةُ والنحوُ والأسلوب، وهو أعَمُّ من علم الدّلالَة؛ لأن الأخيرَ يَهتَمُّ بالرُّموز اللغوية، أما الأولُ فيَهتَمُّ بالعلامات والرُّموزِ سواء أكانت لغويةً أم غيرَ لغوية. ويَرَى بعضُ اللغويين أن علمَ اللغةِ -بجميع فُروعِه - فَرعٌ من علم الرُّموز، بالنظَر إلى أن اللغةَ التي يَدرُسها هذا العلمُ نظامٌ رَمزِيٌّ أو نَوعٌ من الرُّموز. راجع:  @(semiotic systems) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم الرموز ","nonDiacriticsLemma":"علم الرموز","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ الرُّمُوزِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5a83425b-ba73-43fe-aadb-f58eecea62e9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5a83425b-ba73-43fe-aadb-f58eecea62e9","word":"احْتِرَامُ الذَّاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d09","lexicalEntryId":"5a83425b-ba73-43fe-aadb-f58eecea62e9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"احْتِرَامُ الذَّاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ثِقَةُ المرءِ بذاتِه واحتِرامُه لها واعتِزازُه بها، وهو عامِلٌ نَفسيٌّ ومفتاحُ النَّجاحِ لكلِّ الناس، ولاسيَّما الأطفال؛ لأنه حافِزٌ للتعلُّم واكتِسابِ الخِبرَة. وهو مُهمٌّ أيضا لمتعلِّم اللغاتِ الثانية والأجنبية، لكنه قد يَضرُّ به حين يَزيد على حَدِّه؛ فيَمنَع المتعلِّمَ حينَئذٍ من فَهم ثَقافَةِ اللغةِ الهَدَفِ، ومن ثم يُعِيق اكتِسابَه اللغةَ نفسَها. يرى بعضُ الباحثين أن احتِرامَ الذَّاتِ أو تَقديرَ الذَّاتِ قد يَدفَع المرءَ إلى تعلُّم لغةٍ أجنبيّةٍ وإتقانِها بهدَف الانتماءِ إليها والتفاعُلِ مع مجتَمَعها، ويَقوَى هذا الدافعُ لدى المرءِ حين لا يَنجَح في الحُصول على احتِرام ذاتِه وتَقديرِها بدرَجَةٍ كافيَة داخِلَ الجَماعَةِ التي يَنتَمي إليها. راجع:  @(self-confidence) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"احترام الذات ","nonDiacriticsLemma":"احترام الذات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"احْتِرَامُ الذَّات
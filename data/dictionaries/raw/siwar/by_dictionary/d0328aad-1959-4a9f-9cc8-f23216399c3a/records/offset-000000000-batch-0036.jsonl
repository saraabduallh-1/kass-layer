{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5b67f90e-e492-4e1b-9379-4e12e9fc420c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5b67f90e-e492-4e1b-9379-4e12e9fc420c","word":"اخْتِبَارٌ تَوَاصُلِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8bda","lexicalEntryId":"5b67f90e-e492-4e1b-9379-4e12e9fc420c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِبَارٌ تَوَاصُلِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الاختبارُ اللغويُّ الذي يَقيس الكِفايَةَ التواصُليةَ لدى الشخصِ المُختَبَر أو المفحوص، وتستَعمَل في بنوده تراكيبُ تواصُليةٌ تمثِّل وَظائفَ لغويةً في مواقِفَ تواصُليةٍ حقيقية. فتُختار موادُّ هذا الاختبارِ من مَواقِفَ حقيقيةٍ تَرِد في الحياة الاجتماعيةِ اليَوميةِ للناطقين باللغة الهَدَف. مثالُ ذلك أن تُسَجَّل الإعلاناتُ عن رحلات الطائراتِ في المطارات، والإعلاناتُ التجاريةُ في الأسواق ووَسائلِ الإعلام، والمحادَثات الجَماعيةُ والجانبيةُ في المناسَبات العامَّةِ والأفراح، ثم تُضَمَّن في اختبار فَهمِ المسموع، أو أن تُؤخَذ نُصوصُ القراءةِ من الصُّحف والمجلاتِ والكتُبِ العامَّةِ وتُضَمَّن في اختبار فَهمِ المقروء. وقد يَهدف الاختبارُ إلى الكَشف عن قُدرات المفحوصِ التواصُليةِ في الكلام التَّبادُلِي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار تواصلي ","nonDiacriticsLemma":"اختبار تواصلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِبَارٌ تَوَاصُلِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/31f5749b-c55f-4d7e-a44c-ab09080d59d4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"31f5749b-c55f-4d7e-a44c-ab09080d59d4","word":"حَجْمُ الصَّفِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8bc4","lexicalEntryId":"31f5749b-c55f-4d7e-a44c-ab09080d59d4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَجْمُ الصَّفِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مؤشِّرٌ عَدَدِيٌ، يُشيرُ إلى عَدَد الطلابِ في الفَصل الواحد، وهو من أهم المؤشِّراتِ الدَّالَّةِ على نَوعِية التعليم؛ فكلَّما قَلَّ عَدَدُ الطلابِ زادَت استِفادَتُهم مما يُقَدَّم لهم فيه، والعَكسُ بالعَكس. بَيدَ أن هذه الفائدَةَ تتأكَّد في فُصول تعليمِ اللغاتِ الأجنَبية، وقد تَنعَدِم الفائدَةُ حين يَزيد عَدَدُ الطلابِ عن الحَدِّ الأقصَى، حيث يَصعُب التفاعُلُ الصَّفِّيُّ أو ينعَدِم، ولا تُتاح للطلاب فُرَصٌ للكلام، ولا للتَّغذِيَة الرّاجِعَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حجم الصف ","nonDiacriticsLemma":"حجم الصف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حَجْمُ الصَّفِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

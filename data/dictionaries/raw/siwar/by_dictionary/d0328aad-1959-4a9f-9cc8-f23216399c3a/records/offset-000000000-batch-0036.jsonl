{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b1f4f1a-34c3-4401-a578-9d0055772951/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b1f4f1a-34c3-4401-a578-9d0055772951","word":"جُمْلَةٌ مَشْطُورَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8bdc","lexicalEntryId":"9b1f4f1a-34c3-4401-a578-9d0055772951","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جُمْلَةٌ مَشْطُورَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جُملةٌ مَفصولَةٌ ذاتُ جُزأين يحوِي كلٌّ منهما فعلا، ويؤكِّد كلٌّ منهما معنى أو مَعلومَةً مستَقلَّةً. ففي الإنجليزية، تبدأ هذه الجُملةُ بالضمير: it، إضافةً إلى الفعل المساعِدِ: be، تَليها المعلومَةُ المرادُ تأكِيدُها. فجُملَةُ: Sami is driving a new car، يمكن تقسيمُها إلى جزأين، أحدُهما:  It's Sami who is driving a new car، والآخَرُ:  It's a new car that Sami is  driving. وثمَّةَ جُملةٌ شِبهُ متَصَدِّعَةٍ أو مشطورة pseudo-cleft sentence، وهي التي تتصَدَّرها: wh-clause، مثلُ: A new house is what I want, What I want is a new house.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جملة مشطورة ","nonDiacriticsLemma":"جملة مشطورة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جُمْلَةٌ مَشْطُورَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3f20930b-af21-48fe-aee7-0349217df236/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3f20930b-af21-48fe-aee7-0349217df236","word":"تَرْمِيزٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8bc7","lexicalEntryId":"3f20930b-af21-48fe-aee7-0349217df236","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْمِيزٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الأسلوبُ أو الطريقةُ التي يَتَم بها تَمثيلُ القواعدِ والمفرَداتِ المعجَميةِ أو تَرميزُها في لغةٍ ما. فالعربيةُ مثلًا تَرمز للتَّميِيز بين المذكَّرِ والمؤنَّثِ من البَشَر برَمزٍ مُعجَمي، أو وحدَةٍ معجَمية، لكلٍّ منهما بكلمَتَي: (رَجُل) و(امرأة)، ومثلُها الإنجليزيةُ التي تُميِّز بينهما بكلمَتَي: man و woman، في حين لا تَملِك الإنجليزيةُ للعصفور sparrow، مثلا، سوى رَمزٍ واحد، أو وحدةٍ معجَميةٍ واحدة، لكلٍّ من المذكَّر والمؤنَّث. والاختِلافُ بين اللغاتِ في هذا التَّرمِيزِ اختِلافٌ لغويٌّ اجتماعي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"ترميز ","nonDiacriticsLemma":"ترميز","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرْمِيزٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

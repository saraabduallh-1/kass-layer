{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/46069f53-c148-4888-9b29-c48b9635cd02/get-public-entry"},"browse_index_record":{"lexicalEntryId":"46069f53-c148-4888-9b29-c48b9635cd02","word":"تَكْيِيفٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b88a8","lexicalEntryId":"46069f53-c148-4888-9b29-c48b9635cd02","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَكْيِيفٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ تعليميٌّ، يُشير إلى أسلوبٍ من أساليبِ اختِيارِ الموادِّ التعليميةِ في برامج تعليمِ اللغاتِ الأجنبية، ويُقصَد به اختيارُ المعلِّمِ أو مؤلِّفِ الكتابِ مجموعةً من النُّصوص المعَدَّة أصلا للناطقين باللغة الهَدَف، ثم تَعديلُها وتَكيِيفُها لتُناسِب مُتعلِّمِيها من الناطقين بغيرها، وتحقِّق أهدافَهم من تعلُّمِها. ثمةَ أساليبُ أخرى في إعداد التعليميةِ واختِيارِ المحتوَى وتَنظيمِه؛ كصناعة الموادِّ التعليميةِ صناعةً جديدةً، واستِعمالِ موادَّ تعليميةٍ حقيقيةٍ أصيلَةٍ غيرِ مَصنوعَةٍ authentic materials لكنها مناسبةٌ للطلاب، ولكلٍّ من هذه الأساليبِ مزايا وعُيُوب. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تكييف ","nonDiacriticsLemma":"تكييف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَكْيِيفٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7f755f14-0d83-443f-a9eb-af8850fa5e43/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7f755f14-0d83-443f-a9eb-af8850fa5e43","word":"تَكْيِيفُ الكُتُبِ الدِّرَاسِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b88a9","lexicalEntryId":"7f755f14-0d83-443f-a9eb-af8850fa5e43","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَكْيِيفُ الكُتُبِ الدِّرَاسِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في إعداد الموادِّ التعليمية، يُقصَد به أن يَبحَث معلِّمو اللغةِ عن كُتُبٍ دراسية، تجاريةٍ أو مَطبوعةٍ - في الأصل - لبرامِج أخرى، فيُكيِّفون محتوَياتِها؛ لتكون مناسِبةً لطلابهم، ومحقِّقَةً لأهداف برنامجِهم. ويتِمُّ ذلك بأساليب شتى، منها: تَعديلُ المحتوى، والإضافةُ إليه، والحَذفُ منه، وإعادَةُ تَنظيمِه، وتَعديلُ المهمّاتِ التدريسيةِ فيه أو تَوسيعُها. وغالبا ما يُلجأ إلى ذلك حين لا يتوفر للبرنامج كتُبٌ أو موادُّ تعليميةٌ خاصَّةٌ به، ولا يَستطيع المعلِّمون إعدادَ موادَّ تعليميةٍ جديدة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تكييف الكتب الدراسية ","nonDiacriticsLemma":"تكييف الكتب الدراسية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَكْيِيفُ الكُتُبِ الدِّرَاسِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

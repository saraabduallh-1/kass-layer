{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/60002798-0433-4a20-8d1c-737352451525/get-public-entry"},"browse_index_record":{"lexicalEntryId":"60002798-0433-4a20-8d1c-737352451525","word":"الإنجلِيزِيَّةُ لُغَةً أجنَبِيَّةً","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ed0","lexicalEntryId":"60002798-0433-4a20-8d1c-737352451525","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنجلِيزِيَّةُ لُغَةً أجنَبِيَّةً","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ الإنجليزيةُ بوَصفها لغةً أجنَبيةً لمتعلِّميها، بتعليمها للناطقين بغيرها خارِجَ مَواطِنِها، أي بوَصفها مقرَّرا منفَصِلا وليسَت لغةً للتدريس أو التواصُلِ اليَومِيِّ العامِّ. ويَنطَبِق هذا الوَصفُ على تدريس الإنجليزيةِ أو استعمالِها في أيِّ بلدٍ غيرِ بريطانيا والولايات المتحدة الأمريكية وكندا وأستراليا ونيوزيلندا. وقد يُستَعمَل هذا المصطلَحُ مُرادِفا للمصطلَح: ESL الذي يَعنِي الإنجليزيةَ لغةً ثانيةً، أو يَعنِي تدريسَها للناطقين بغيرها مهما كانت علاقَتُهم باللغة ومكانُ تَلَقِّيهم إياها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية لغة أجنبية ","nonDiacriticsLemma":"الإنجليزية لغة أجنبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنجلِيزِيَّةُ لُغَةً أجنَبِيَّةً"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

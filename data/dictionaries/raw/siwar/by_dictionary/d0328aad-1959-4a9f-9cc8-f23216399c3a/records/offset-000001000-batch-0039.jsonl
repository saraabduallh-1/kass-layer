{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2c94faab-c676-4b95-9ed1-f365727983bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2c94faab-c676-4b95-9ed1-f365727983bf","word":"قِيَاسٌ خَاطِئٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9020","lexicalEntryId":"2c94faab-c676-4b95-9ed1-f365727983bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قِيَاسٌ خَاطِئٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قِياسُ كلمةٍ على كلمةٍ أخرى، أو قِياسُ نَمَطٍ أو تركيبٍ على آخَر، قِياسا غيرَ صَحيح أو غيرَ مُطابِقٍ للقاعدة، ومنه المبالَغةُ في تَعميم القاعدةِ overgeneralization، ويحدُث ذلك حين يتعلَّم المرءُ قاعدةً ما ثم يُطبِّقُها في مَوضِعٍ لا تَنطَبِق عليه تلك القاعدةُ. ويحدُث هذا في اكتساب اللغاتِ الأمِّ والثانيةِ والأجنبية. مثالُ ذلك جَمعُ الطفلِ: (جَمَل) على (جَمَلات) في العربية، واستعمالُ الصِّيغةِ: goed بدَلا من went قياساً على walked الإنجليزيةِ. راجع:  @(overgeneralization) و  @(over-extension) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قياس خاطئ ","nonDiacriticsLemma":"قياس خاطئ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قِيَاسٌ خَاطِئٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dfec7807-a94d-4e75-b067-856dd71d5509/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dfec7807-a94d-4e75-b067-856dd71d5509","word":"الإنْجْلِيزِيَّةُ لُغَةً مُشْتَرَكَةً","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9009","lexicalEntryId":"dfec7807-a94d-4e75-b067-856dd71d5509","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنْجْلِيزِيَّةُ لُغَةً مُشْتَرَكَةً","lemmaType":"MWE","pattern":" ","senses":[{"definition":"استعمالُ اللغةِ الإنجليزيةِ في التواصُل بين ناطِقِين بلُغاتِ أمٍّ مختَلِفةٍ وثقافاتٍ متَبايِنَة، دونَ تقيُّدٍ بالمعايِير اللغويةِ والثقافيةِ التي يَتَّبِعها الناطِقون بها. فالوَظيفَةُ التواصُليةُ في هذه اللغة مقدَّمةٌ على الصِّحَّة اللغوية، وربما استَعمَل المتخاطِبون مَفاهيمَ ثقافيةً غيرَ المفاهيمِ الإنجليزية، أو تحوَّلوا إلى لغات أمّ أو لغاتٍ وَسيطَةٍ حين يتعَثَّر فَهمُ الرِّسالَةِ أو أجزاء منها، وهي بهذه السِّمَةِ الوَظيفيةِ تختَلِف عن الإنجليزية لغةً أجنَبيةً أو ثانيةً في درَجات التَّبسِيط، واستِعمالِ الأدواتِ الوَظيفيَّة، وترتيبِ عناصِرِ الجُملة، ونحوِ ذلك. وغالبا ما يكون التواصُلُ بها خارِجَ مَواطِنِها، وبعيدا عن الناطقين بها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية لغة مشتركة ","nonDiacriticsLemma":"الإنجليزية لغة مشتركة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنْجْلِيزِيَّةُ لُغَةً مُشْتَرَكَةً"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7ec6fa4a-443b-4822-bee3-7bfd3283594c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7ec6fa4a-443b-4822-bee3-7bfd3283594c","word":"الإنجلِيزِيةُ لُغَةً عَالَمِيَّةً","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b900a","lexicalEntryId":"7ec6fa4a-443b-4822-bee3-7bfd3283594c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنجلِيزِيةُ لُغَةً عَالَمِيَّةً","lemmaType":"MWE","pattern":" ","senses":[{"definition":"استِعمالُ اللغةِ الإنجليزيةِ لغةً للتواصُل بين شُعوبِ العالَمِ المختَلِفةِ استعمالا لا يَلتَزِم بأساليب الناطقين بها التِزاما دقيقا في جميع الأحوالِ. فعندما يُناقِش رَجُلُ أعمالٍ يابانيٌّ رَجُلَ أعمالٍ برازيليًّا لإتمام صَفقَةٍ تجاريةٍ مثلا، لا يَلزَم أن يتحدَّث الطَّرَفان بالإنجليزية البريطانيةِ أو بالإنجليزية الأمريكية، وإنما يتحدَّث كلٌّ منهما بلُغةٍ إنجليزيةٍ تَظهَر فيها لكنَتُه الإقليميةُ أو تَغلب عليها طَبيعةُ العَمَلِ التجاري، وتؤدِّي الوَظيفةَ المطلوبَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية لغة عالمية ","nonDiacriticsLemma":"الإنجليزية لغة عالمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنجلِيزِيةُ لُغَةً عَالَمِيَّةً"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b0b6227f-4de8-4d08-8b08-55b408a4e7a4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b0b6227f-4de8-4d08-8b08-55b408a4e7a4","word":"بَرْنَامَجُ الإنجلِيزِيَّةِ لُغَةً ثَانِيَةً","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b900b","lexicalEntryId":"b0b6227f-4de8-4d08-8b08-55b408a4e7a4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بَرْنَامَجُ الإنجلِيزِيَّةِ لُغَةً ثَانِيَةً","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على أيِّ برنامجٍ تعليميٍّ مُعَدٍّ لتعليم الإنجليزيةِ لغةً ثانيةً للناطقين بغيرها في البلدان الناطِقَةِ بالإنجليزية. ويُقدَّم هذا البرنامجُ للمُهاجرين والطلابِ الأجانبِ في المدارس والجامعاتِ وكُلِّيَّاتِ المجتَمَعِ ومراكزِ التعليمِ المستَمِرِّ، خاصةً في بريطانيا وأمريكا وكندا وأستراليا، ومنه معاهدُ تعليمِ الإنجليزيةِ الموجودةُ في معظَم الجامعاتِ الأمريكيةِ والبريطانيةِ والأسترالية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"برنامج الإنجليزية لغة ثانية ","nonDiacriticsLemma":"برنامج الإنجليزية لغة ثانية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بَرْنَامَجُ الإنجلِيزِيَّةِ لُغَةً ثَانِيَةً"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/556880a2-35ad-4cda-be87-dfa43ce10e47/get-public-entry"},"browse_index_record":{"lexicalEntryId":"556880a2-35ad-4cda-be87-dfa43ce10e47","word":"اسْتِلْزَامٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b900c","lexicalEntryId":"556880a2-35ad-4cda-be87-dfa43ce10e47","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْتِلْزَامٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ مَنطِقيٌّ استُعمِل في التحليل الدّلالي، يُشير إلى عَلاقَةِ تَلازُمٍ دلاليٍّ بين جُملَتَين أو أكثَرَ بمَعزِلٍ عن أيِّ سياق، أي كَون صِدقِ قَولٍ ما يَتبَع صِدقَ قَولٍ آخَرَ من الناحية المنطِقِية. فمَعرِفتُنا لجُملةٍ ما أنها صَحيحةٌ تدُلنا على صِحَّة الجُملةِ التاليةِ لها، أي إن صحَّةَ الجُملةِ الثانيةِ نتيجةٌ لصِحَّة الأولى. فإذا كانت الجُملة: (سوفَ أشتِري حِصانا) صحيحةً فهذا يَستَلزِم أن تكون جُملةُ: (سوفَ أشتَري حيوانا) صحيحةً أيضا. فالجُملةُ الأولى مستَلزِمَةٌ للثانية، والثانيةُ لازِمَةٌ للأولى. وقد يكون الاستِلزامُ عَكسِيًّا؛ فجُملَةُ: رأيتُ محمدا يَجري في الساعة السابعةِ صباحا، تَستلزِم أن جُملَةَ: رأيتُ محمدا نائما في الساعة السابعةِ صباحا، غيرُ صَحيحَة. وهذا الاستِتباعُ مَعنَوِيٌّ دلاليٌّ لا يعتَمِد على السِّياق.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"استلزام ","nonDiacriticsLemma":"استلزام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْتِلْزَامٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c290bd40-b11e-4411-9674-f7bc39f36d3d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c290bd40-b11e-4411-9674-f7bc39f36d3d","word":"قِرَاءةٌ مُوَسَّعَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9014","lexicalEntryId":"c290bd40-b11e-4411-9674-f7bc39f36d3d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قِرَاءةٌ مُوَسَّعَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ نوعَيْ القراءةِ وفقَ بعضِ تصنيفاتِ هذه المهارَة، حيث تُصنَّف إلى نوعَيْن: قراءةٌ مُوَسَّعة، وقراءةٌ مُكثَّفة intensive reading. فالقراءةُ الموَسَّعةُ هي التي يُوَجَّه الطلابُ إلى مُمارَسَتها خارجَ المنهَجِ المدرسي، وتكون نُصوصُها طويلةً نسبيًّا، لكنها سهلةُ التراكيب، مَألوفةُ المفرَدات، يَستطيع الطالبُ فَهمَها من غير حاجةٍ إلى معلٍّمٍ أو مُعجَم. وغالبا ما تكون في مستوى الطالبِ أو أدنَى منه قليلا، خلافا للقراءة المكثَّفَةِ التي تكون أعلى قليلا من مستواه، وتُقدَّم فيها مفرَداتٌ وتراكيبُ مَقصودةٌ. وللقراءة الموسَّعَةِ أهدافٌ منها: غَرسُ حُبِّ القراءة لدى الطالب، وتَدريبُه على مهاراتها؛ كالسرعَة في القراءة، والفَهمِ العامِّ، وتَخمين معاني الكلماتِ الجديدةِ من السياق، ونحوِ ذلك. راجع:  @(intensive reading) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قراءة موسعة ","nonDiacriticsLemma":"قراءة موسعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قِرَاءةٌ مُوَسَّعَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

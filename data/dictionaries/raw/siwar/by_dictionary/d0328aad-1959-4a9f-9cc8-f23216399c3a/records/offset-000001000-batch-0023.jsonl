{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e09882d5-7cd9-4a9e-b15e-b0051c844696/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e09882d5-7cd9-4a9e-b15e-b0051c844696","word":"(المَدْرَسَةُ) التَّوْزِيعِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e7b","lexicalEntryId":"e09882d5-7cd9-4a9e-b15e-b0051c844696","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"(المَدْرَسَةُ) التَّوْزِيعِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهجٌ في التحليل اللغوي، عُرِفَت به مدرسةُ بلومفيلد الأمريكية، يهتَم بدراسة الشكلِ الظاهِرِ للعناصِرِ اللغوية، كالفونيمات والمورفيماتِ والمقاطِعِ والكلمات، ورَصْدِ العناصِرِ الصغيرةِ في العناصِر الأكَبَرِ منها؛ كرَصْد الفونيماتِ في المقاطِع، ورَصْدِ المقاطِعِ في الكلمات، ورَصْدِ الكلماتِ في الجُمل. ويهتَم أيضا برَصْد تَوزيعِ هذه العناصِرِ داخِلَ البِنيَةِ اللغويةِ في المواقِع التي تحتلُّها في الكلام. وهذا المنهجُ هو أساسُ فكرَةِ المورفيمِ الذي هو أصغَرُ وحدةٍ لغويةٍ تحمِل معنى أو تؤدي وَظيفةً نحوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"(المدرسة) التوزيعية ","nonDiacriticsLemma":"(المدرسة) التوزيعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"(المَدْرَسَةُ) التَّوْزِيعِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8e7c5a15-3220-42fb-be55-fa5a2e199cbb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8e7c5a15-3220-42fb-be55-fa5a2e199cbb","word":"عِلْمُ اللُّغَةِ النَّفْسِيُّ النَّمَائِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e7c","lexicalEntryId":"8e7c5a15-3220-42fb-be55-fa5a2e199cbb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ النَّفْسِيُّ النَّمَائِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمُ النموِّ اللغويِّ النفسيِّ، أو علمُ نَفسِ النُّمُوِّ اللغويِّ، وهو فَرعٌ من علم اللغةِ النَّفسيِّ، يُطلَق على دراسةِ مراحِلِ النُّمُوِّ اللغويِّ لدَى الأطفال، ويَهتَم بوَصف النُّمُوِّ المرحَليِّ للأصوات والصِّيَغِ والتراكيبِ والمفاهيمِ في لغة الطفل. لكن هذا المصطلَحَ لم يَعُد شائعَ الاستعمالِ في المجالات اللغويةِ بعد تَطَوُّرِ الدراساتِ اللغويةِ النفسية، ولاسيَّما الدراساتُ في اكتساب اللغة، وتَداخُلِها مع دراسات علمِ نَفسِ النُّمُوِّ. ومن الباحثين من يَعدُّه قَسِيما لعلم اللغةِ النفسيِّ التَّجريبيِّ experimental psycholinguistics. راجع:  @(developmental psychology) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة النفسي النمائي ","nonDiacriticsLemma":"علم اللغة النفسي النمائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ النَّفْسِيُّ النَّمَائِيُّ"}],
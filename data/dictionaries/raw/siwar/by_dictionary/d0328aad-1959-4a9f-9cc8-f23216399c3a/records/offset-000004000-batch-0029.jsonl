{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a234ef35-8241-4b0f-8076-0c05591f507b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a234ef35-8241-4b0f-8076-0c05591f507b","word":"المَذهَبُ النَّوْعِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9aea","lexicalEntryId":"a234ef35-8241-4b0f-8076-0c05591f507b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَذهَبُ النَّوْعِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ أو مَدخَلٌ لدراسة اللغةِ في بيئتها الاجتِماعية. شاع هذا المذهبُ في علم الاجتِماعِ في أوائل القرن العشرين، ثم استَعارَه اللغويون الاجتِماعيون في الثمانينيّات من القرن العشرين لوَصف اللغاتِ وتَحليلِها. يُرَكِّز هذا المذهبُ على دراسة كلامِ عَدَدٍ قَليلٍ من الناطقين باللغة الهَدَفِ أو بنصُوصٍ معيَّنَةٍ منها، ويَعتَمِد على الملاحَظَة الميدانيَّة، وتَحليلِ النُّصوصِ، والمقابَلاتِ الشَّفَهِيَّةِ مع الناطقين باللغة، وتَسجِيلِ كلامِهم ثم تَحويلِه إلى نُصوص مَكتُوبة. يُقابِل هذا المذهبَ أو المدخَلَ المذهَبُ أو المدخَلُ الكَمِّيُّ quantitative approach، على الرّغم من أن المعلوماتِ اللغويَّةَ النَّوعيَّةَ قد تُحَوَّل إلى معلومات لغويَّةٍ كمِّيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المذهب النوعي ","nonDiacriticsLemma":"المذهب النوعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَذهَبُ النَّوْعِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f3ac9b3d-7b5a-46e5-a023-b07283ce37c9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f3ac9b3d-7b5a-46e5-a023-b07283ce37c9","word":"بَحْثٌ شِبْهُ تَجْرِيبِيٍّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9aeb","lexicalEntryId":"f3ac9b3d-7b5a-46e5-a023-b07283ce37c9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بَحْثٌ شِبْهُ تَجْرِيبِيٍّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوعٌ من البحوث لا يستَطيع الباحثُ فيه تَناوُلَ المتغيِّرِ المستَقِلِّ أو السيطرَةَ عليه، ولكنه يستَطيع أن يحَدِّد كيفَ يَقيس المتغيِّرَ التابِعَ. من أمثِلَة ذلك في اللغويات التطبيقيةِ الدراساتُ التي تتَناوَل تَأثيرَ أساليبِ التدريسِ في اكتساب اللغةِ الثانيةِ أو عناصِرَ من عناصِرها أو مستوًى من مستوَياتها. ومن أمثِلَته أيضا الدراساتُ لتي تتناول أثَرَ الاتجاهاتِ والميُولِ في تعلُّم اللغةِ الأجنَبية. في هذا النوع من البحوث لا يَصِل الباحِثُ إلى نتائج تخَوِّله الرَّبطَ المباشِرَ بين السبَب والنتيجَة؛ لتدَخُّل عوامِلَ خارِجيّة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"بحث شبه تجريبي ","nonDiacriticsLemma":"بحث شبه تجريبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بَحْثٌ شِبْهُ تَجْرِيبِيٍّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/93d79927-db82-477c-afdf-4f81ce0e9e70/get-public-entry"},"browse_index_record":{"lexicalEntryId":"93d79927-db82-477c-afdf-4f81ce0e9e70","word":"مُعَدَّلُ الاكْتِسَابِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9aec","lexicalEntryId":"93d79927-db82-477c-afdf-4f81ce0e9e70","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعَدَّلُ الاكْتِسَابِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ في اكتِساب اللغة، استَعمَلَه رود إليس Rod Ellis للتَّميِيز بينه وبين ما أَطلَق عليه: طَريقَ الاكتِسابِ أو مَرحَلَةَ الاكتِسابِ route of acquisition. فالثاني يُشير إلى انتِقال متعلِّم اللغةِ من مَرحَلَةٍ إلى أخرى في اكتِساب مُورفيمٍ أو نَمَطٍ أو تَركيب، أما الأول فيُشير إلى المدَّة أو الزَّمَن الذي تَتَطَلَّبه كلُّ مَرحَلَةٍ أو كلُّ مُورفيم أو نمِطٍ أو تركيب. فالمتعلِّمون يَمُرُّون بجميع مَراحِلِ اكتِساب اللغةِ ومورفيماتِها وفقَ تَرتيبٍ متَدَرِّجٍ ومُتَشابه؛ فلا تَسبِق مَرحَلَةٌ مَرحَلَةً أخرى، لكنهم يَتَفاوَتون في السُّرعة أو الزَّمن الذي تَتَطَلَّبه كلُّ مَرحَلَة. فالمراهِقون لا يَتَوَقَّفون طَويلا في المراحِل الأولى من تَعلُّم اللغةِ الثانية، أما الأطفالُ فيُمضُون فيها وَقتا أطوَلَ مما يُمضيه المراهِقون، والذين يَعرِفون قَواعِدَ اللغةِ الهَدَفِ أسرَعُ في التعلُّم ممن لا يَعرِفون هذه القواعد. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معدل الاكتساب ","nonDiacriticsLemma":"معدل الاكتساب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعَدَّلُ الاكْتِسَابِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

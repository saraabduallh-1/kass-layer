{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/79184708-3dcf-414e-b467-b0dbef4ea8bb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"79184708-3dcf-414e-b467-b0dbef4ea8bb","word":"عَلامَاتُ التَّرْقِيمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9ae0","lexicalEntryId":"79184708-3dcf-414e-b467-b0dbef4ea8bb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَلامَاتُ التَّرْقِيمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَضعُ العَلاماتِ اللازِمةِ للكِتابة داخِلَ الجُملةِ وفي نهايَتها، لمساعَدَة القارئِ في فَهم المعنى؛ كالنُّقطة، والنُّقطتَين، والفاصِلَة، والفاصِلَةِ المنقوطَة، وعلامَةِ الاستِفهام، وعلامَةِ التَّعَجُّب. وعَلاماتُ الترقيمِ مُهمَّةٌ في تعليم اللغاتِ الأجنبية، لاسيَّما في تَعليم الكِتابة، وتزداد هذه الأهميةُ حين تَختَلِف علاماتُ التَّرقيمِ أو وَظائفُها عمّا اعتاد عليه المتعلِّمُ في لغته الأمِّ أو في لُغةٍ أخرى قد أتقَنَها من قَبْل.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علامات الترقيم ","nonDiacriticsLemma":"علامات الترقيم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَلامَاتُ التَّرْقِيمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/61814e30-8238-43e4-9810-3bc925dbc144/get-public-entry"},"browse_index_record":{"lexicalEntryId":"61814e30-8238-43e4-9810-3bc925dbc144","word":"عَمًى كِتَابِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9ae1","lexicalEntryId":"61814e30-8238-43e4-9810-3bc925dbc144","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَمًى كِتَابِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يَعني فَقْدَ الإنسانِ القُدرَةَ على الكتابةِ فَقْدًا كامِلًا مع احتِفاظه بالقدرة على القراءة. يَغلب أن يحدُث هذا العَمَى حين يُصاب الإنسانُ الأيمنُ (الذي يَستَعمِل يَدَه اليُمنى) بجَلطَةٍ في الجانِب الأيسَر من الدِّماغ، فيَبقَى قادِرًا على قراءة الجُمَلِ القَصيرَة، لكنه لا يَستَطيع كتابَتَها إذا أُملِيَت عليه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عمى كتابي ","nonDiacriticsLemma":"عمى كتابي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَمًى كِتَابِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

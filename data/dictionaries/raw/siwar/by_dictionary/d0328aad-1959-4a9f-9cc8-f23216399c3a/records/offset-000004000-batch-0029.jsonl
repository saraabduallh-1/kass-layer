{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f4316e8e-0f45-48db-9531-3f80eed2713e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f4316e8e-0f45-48db-9531-3f80eed2713e","word":"الإجَابَةُ الآلِيَّةُ عَن الأسْئلَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9ae4","lexicalEntryId":"f4316e8e-0f45-48db-9531-3f80eed2713e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإجَابَةُ الآلِيَّةُ عَن الأسْئلَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ تَطبيقاتِ الحاسُوبِ باللغة الطبيعيَّة، وهو استِعمالُ بَرَامِجَ خاصَّةٍ للرَّدِّ على أسئلة مُستَعمِلي الحاسُوبِ في مَجالاتٍ مُعيَّنة. تُستَخدَم في هذه البرامجِ طرائقُ إعرابِ اللغاتِ الطبيعيةِ وإنتاجِها آلِيًّا. كما تُستَعمَل أساليبُ مُختَلفةٌ للتَّحليل الدّلاليِّ والمنطِقيِّ للكلام للتَّمَكُّن من فَهمه والرَّدِّ عليه، وقد يُوجِّه النظامُ الحاسوبيُّ أسئلةً للمستَعمِل؛ لإزالَة ما قد يكون في أسئلته من لَبْسٍ أو غُمُوض.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإجابة الآلية عن الأسئلة ","nonDiacriticsLemma":"الإجابة الآلية عن الأسئلة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإجَابَةُ الآلِيَّةُ عَن الأسْئلَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

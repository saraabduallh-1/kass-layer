{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/93dd3614-fcb9-4a56-a10c-c33c840492b2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"93dd3614-fcb9-4a56-a10c-c33c840492b2","word":"تَحْشِيَةٌ تَطْرِيزِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9ae8","lexicalEntryId":"93dd3614-fcb9-4a56-a10c-c33c840492b2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْشِيَةٌ تَطْرِيزِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في لسانيّات المدوَّناتِ، يُشير إلى نوعٍ من أنواعٍ التَّحشِيَةِ اللغويةِ annotation، يُسمّى أيضًا: prosodic transcription، حيث يؤشَّر فيه على مواضِع النَّبْرِ والتَّنغيمِ والوقفَةِ في نُصوص المدوَّنةِ المكتوبَةِ، باستِخدام رُموزٍ خاصَّةٍ تمثِّل هذه الأنواعَ التَّطريزِيَّةَ كما هي في الكلام المنطوق. والتَّحشيَةُ التَّطريزِيَّةُ هذه يَصعُب إجراؤها آلِيًّا، بل تتطلَّب عمَلًا يَدَويًّا ولغويِّين متخصِّصين في علم الأصواتِ باللغة الهدَف. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحشية تطريزية ","nonDiacriticsLemma":"تحشية تطريزية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْشِيَةٌ تَطْرِيزِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5c0764cd-d68d-48c8-ad68-95907981e23f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5c0764cd-d68d-48c8-ad68-95907981e23f","word":"لُغَةٌ ثَالِثَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ff1","lexicalEntryId":"5c0764cd-d68d-48c8-ad68-95907981e23f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ ثَالِثَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أيُّ لغةٍ يتعلَّمها المرءُ بعد تعلُّمِه لُغتَه الأجنبيةَ الأولى؛ كأن يتعلَّم العربيُّ اللغةَ الألمانيةَ بعد أن يتعلَّم اللغةَ الإنجليزية، أو يتعلَّم اليابانيُّ اللغةَ العربيةَ بعد أن يتعلَّم اللغةَ الفرنسية. يرى بعضُ اللغويين التطبيقيين أن تعلُّمَ لغةٍ ثالثةٍ يختَلِف عن تعلُّم لغةٍ أجنبيةٍ للمرَّة الأولى؛ إذ إن المتعلِّمَ قد مَرَّ بتجربةٍ سابقَةٍ في تعلُّم اللغات؛ فاكتَسَب مهاراتٍ لغويةً أساسية، يَسهل تطبيقُها في تعلُّم اللغةِ الثالثة، واجتِنابِ الأخطاءِ المنهَجيةِ والسلوكيةِ التي وقع فيها في أثناء تعلُّمِه لغَتَه الأجنبيةَ الأولى، إضافةً إلى القواعد الكُليَّةِ غيرِ الموسومَةِ التي ربما لم تكن في لغته الأمِّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة ثالثة ","nonDiacriticsLemma":"لغة ثالثة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ ثَالِثَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1cdb964d-14d3-402d-a37e-0c1a75867d43/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1cdb964d-14d3-402d-a37e-0c1a75867d43","word":"نَظَرِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fe5","lexicalEntryId":"1cdb964d-14d3-402d-a37e-0c1a75867d43","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"أسلوبٌ أو طريقةٌ في الفَهم والنَّقدِ وتَكوينِ الآراءِ تمهيدًا لصِياغَة القوانين وتَعميمِها، يظهَر في مَقولَةٍ أو صِيغَةٍ لمبدأ عامٍّ، ويُبنَى على رأيٍ معيَّن، ويؤيَّد بمعلوماتٍ تُوضِّح حَقائقَ معيَّنة، أو تفَسِّر ظاهرةً من الظواهر أو حادِثَةً من الحوادث. وفي حَقل تعليمِ اللغات، تُعَدُّ النظريةُ أحَدَ المفاهيمِ الرَّئيسةِ ذاتِ العَلاقةِ بطرائق تدريسِ اللغات، وهي: النظريةُ theory، والمدخَلُ أو المذهَبُ approach، والطريقةُ method، والإجراءُ أو الأسلوبُ technique","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مَفهومٌ عامٌّ في العُلوم والآدابِ، يُشير إلى المبادئ والقَوانينِ العامَّةِ في دراسَة الظواهِرِ والأشخاص، في مُقابِل التَّطبيقِ والممارَسَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية ","nonDiacriticsLemma":"نظرية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/edef1575-8b94-4223-aa80-56e50f384278/get-public-entry"},"browse_index_record":{"lexicalEntryId":"edef1575-8b94-4223-aa80-56e50f384278","word":"فَرْضِيَّةُ العَتَبَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fe6","lexicalEntryId":"edef1575-8b94-4223-aa80-56e50f384278","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرْضِيَّةُ العَتَبَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضِيَّةٌ في اكتساب اللغةِ الثانيةِ اقتَرَحَها جيمس كامنز  James Cummins تَعني أن متعلِّمَ اللغةِ الثانيةِ لن يَستَفيد من تَعَلُّم الموادِّ والمقرَّراتِ التعليمةِ باللغة الهَدَفِ ما لم يَصِل إلى الحَدِّ الأدنَى في الكِفايَة في اللغة الهَدَف، ويجاوَز مستَوَى العَتَبَةِ. يَربط كامنز هذه الفَرضِية بفَرضيةٍ أخرى، هي: developmental interdependent hypothesis، يرى بموجبها أن نُمُوَّ الكفايَةِ في اللغة الثانيةِ يَعتَمِد على مستَوَى الكِفايةِ التي وَصَل إليها الطفلُ في لغته الأمِّ حين بدأ تَعَرُّضُه المكثَّفُ للُّغَة الثانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية العتبة ","nonDiacriticsLemma":"فرضية العتبة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرْضِيَّةُ العَتَبَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/491ad5f7-c7e7-41eb-8f3a-23f8ce251959/get-public-entry"},"browse_index_record":{"lexicalEntryId":"491ad5f7-c7e7-41eb-8f3a-23f8ce251959","word":"الوَقْتُ المُخَصَّصُ للْمُهِمَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fe7","lexicalEntryId":"491ad5f7-c7e7-41eb-8f3a-23f8ce251959","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الوَقْتُ المُخَصَّصُ للْمُهِمَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغات، يُطلَق على الوَقت أو الزمنِ المخَصَّصِ لمهمَّة تعليميةٍ يُنجِزها الطلابُ في حصَّة الدَّرس، وهو مؤشِّرٌ على مَدَى تقدُّمِ الطلابِ في التعلُّم. يميِّز الباحثون بين عَدَدٍ من الطرُق التي يُستَعمَل فيها هذا الوَقتُ في الدرس، منها: الوَقتُ الذي يُخَصِّصه المعلِّمُ لطلابه في الدَّرس، وهو ما بين: (30-35) دقيقةً للتدريس في الحصَّة التي مدَّتُها خمسون دقيقة؛ وزَمَنُ المهمَّة، وهو الوقتُ الذي يُمضيه الطلابُ في المهمَّة؛ وزَمَنُ التعلِّمِ الأكاديميِّ، وهو الزَّمنُ المثاليُّ الأكاديميُّ الذي يُمضيه الطلابُ لإنجاز المهمَّةِ بعد طَرحِ الوَقتِ الضّائع. يختَلِف الوَقتُ المخصَّصُ للمُهمَّة التعليميةِ من دَرسٍ لآخَر، وبحسَب مَهارَةِ المعلِّم، وجِدِّيَّةِ الطلابِ؛ فقد يَصِل مَدَى الاستفادةِ من الوقت المخصَّصِ إلى: 90% وقد يَنخَفِض إلى: 30% منه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الوقت المخصص للمهمة ","nonDiacriticsLemma":"الوقت المخصص للمهمة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الوَقْتُ المُخَصَّصُ للْمُهِمَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6972d1ad-796e-46d1-b6a3-58abd5f24766/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6972d1ad-796e-46d1-b6a3-58abd5f24766","word":"كَلِمةٌ فِعليّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fe8","lexicalEntryId":"6972d1ad-796e-46d1-b6a3-58abd5f24766","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمةٌ فِعليّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي أيُّ عنصُرٍ لغويٍّ فعليٍّ يُصنَّف ضِمنَ ضَربٍ لغويٍّ ما، أي وحدة لغوية؛ كالكلمة الوارِدَةِ في النَّصِّ أو المدوَّنةِ بأيِّ صورةٍ من صُوَرها التَّصريفيةِ: (كتَبوا، يكتبون، نكتُب، كتبا ... وقلم، قلمان، أقلام...). وكذلك الصوتُ اللغويُّ الذي هو أُنموذَجٌ ضَربُه الفُونِيم؛ فالكلمة الإنجليزية: fluffy تحوي ثلاثة نماذج للصوت: F، وأنموذجًا واحدًا لكلٍّ من الحُروف الثلاثةِ الأخرى: L و: U و: Y. والكلمة الفعلية بهذا المفهومِ يُقابِلها النوعُ type.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمة فعلية ","nonDiacriticsLemma":"كلمة فعلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمةٌ فِعليّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/22e8ca27-16ee-4ea8-a3c0-7b25e38fe6ca/get-public-entry"},"browse_index_record":{"lexicalEntryId":"22e8ca27-16ee-4ea8-a3c0-7b25e38fe6ca","word":"تَحَمُّلُ الغُمُوضِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fe9","lexicalEntryId":"22e8ca27-16ee-4ea8-a3c0-7b25e38fe6ca","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحَمُّلُ الغُمُوضِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سِمَةٌ شخصيةٌ يتَمتَّع بها بعضُ الناس، وتُلاحَظ في سُلوك الناجِحِين في اكتساب اللغات الأجنبية. تؤكِّد بعضُ الدراساتِ في إستراتيجيات تعلُّمِ اللغةِ أن من يتَمتَّع بدرَجَة عاليَةٍ من تحَمُّل الغُمُوضِ قادِرٌ على مُسايَرَة جوانبَ مختَلِفةٍ من اللغة الهَدَفِ وتَخَطِّي صُعُوباتِها، وعَدَمِ الوُقوفِ عند جُزئياتِها، ما يقوده إلى فَهم المسموعِ وفَهمِ المقروءِ بسُرعَةٍ ودرجةٍ عاليَة. لكن العلاقةَ بين تَحَمُّل الغُمُوضِ والنجاحِ في تعلُّم اللغاتِ غيرُ واضِحةٍ في كثيرٍ من البحوث والدراسات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحمل الغموض ","nonDiacriticsLemma":"تحمل الغموض","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحَمُّلُ الغُمُوضِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c802616b-e51e-42f0-8c14-88ca2df9b731/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c802616b-e51e-42f0-8c14-88ca2df9b731","word":"فُونِيمٌ نَغْمِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fea","lexicalEntryId":"c802616b-e51e-42f0-8c14-88ca2df9b731","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فُونِيمٌ نَغْمِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وحدةٌ نَغمِيةٌ مميِّزةٌ تُستَخدم في اللغات النَّغمِيَّةِ للتَّميِيز بين معاني الصِّيَغِ والكلمات. تَحوِي أيُّ لغةٍ نَغمِيَّةٍ عائلةً من النَّغمات، ويُسمى أعضاءُ العائلةِ فيها ألوتوناتٍ allotones. والوحدةُ النغميةُ في اللغات النَّغمِيةِ تُشبه الفونيمَ، وتُعامَل مُعامَلَته في اللغات غيرِ النَّغمِية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فونيم نغمي ","nonDiacriticsLemma":"فونيم نغمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فُونِيمٌ نَغْمِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b843bd1a-0e74-4b3f-ad05-394b587be6c6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b843bd1a-0e74-4b3f-ad05-394b587be6c6","word":"العَمَلِيَّاتُ التَّنَازُلِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9feb","lexicalEntryId":"b843bd1a-0e74-4b3f-ad05-394b587be6c6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"العَمَلِيَّاتُ التَّنَازُلِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم اللغةِ النفسيِّ وعلمِ النَّفسِ المعرِفي، يُشير إلى أحَد الأساليبِ الثلاثةِ في مُعالَجَة الإنسانِ للمَعلومات اللغويةِ وفَهمِها، ولاسيَّما فَهمُ المقروء، وتسمى أيضا: context-driven models. تَبدأ هذه العمَلياتُ من المستَوى الأعلى وهو المعنَى، وتَنتَهي بالمستَوى الأدنَى وهو المعلوماتُ التَّفصيليةُ في النَّص من حُروفٍ وكلماتٍ وعباراتٍ وجُمَل، وتتطَلَّب استِحضارَ المرءِ لمعلوماته السّابِقَةِ عن الموضوع، ورَبطَها به، والاستِعانَةَ بها على تحليل محتَوَياتِ النَّص وتَفسيرِها وفَهمِها، مع الاستعانة بالمعلومات الصوتيةِ والنحويةِ والكتابيةِ وعلاماتِ التَّرقيمِ في النَّص. أما الأسلوبُ الثاني فهو اللُّجوءُ إلى العَمَليات الجُزئيةِ أو الحَرفيةِ التَّصاعُدِيّةِ bottom-up process، التي تَبدأ بالمستَوى الأدنَى وتَنتَهي بالمستَوى الأعلَى، أي تَكوِين المعنى من النَّص فقط، وتُسمّى أيضا: stimulus-driven models. يرى بعضُ الباحثين أن الأسلوبَ الأوّلَ أفضلُ من الثاني في فَهم المعنى، في حين يُفضِّل آخَرون أسلوبا ثالثا، هو الأسلوبُ التَّفاعُلِيُّ interactive process الذي يجمَع بين الأسلوبَين. راجع:  @(theories of reading) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"العمليات التنازلية ","nonDiacriticsLemma":"العمليات التنازلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"العَمَلِيَّاتُ التَّنَازُلِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

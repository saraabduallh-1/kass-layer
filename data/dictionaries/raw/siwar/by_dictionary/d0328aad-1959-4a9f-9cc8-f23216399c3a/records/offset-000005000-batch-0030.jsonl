{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c73f42f9-411d-4d86-911a-03aaef10e5d3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c73f42f9-411d-4d86-911a-03aaef10e5d3","word":"عَادَاتٌ دِرَاسِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f07","lexicalEntryId":"c73f42f9-411d-4d86-911a-03aaef10e5d3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَادَاتٌ دِرَاسِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عاداتُ التعلُّمِ التي تَطَبَّعَ بها المتعلِّمُ في مراحِل دراستِه في التعليم العامِّ أو الجامعيِّ فأثَّرَت في طريقَة تعلُّمِه للُّغة الثانيةِ أو الأجنبيةِ. هذه العاداتُ قد تكون جيِّدةً فتُعينه على تعلِّم اللغةِ الهَدَفِ واكتسابِها بسُرعةٍ وإتقان، وقد تكون سيِّئةً فتُعِيقه عن تَعلُّمها أو تُطيل مدَّةَ التعلُّم. وفي العقدَيْن الأخيرَيْن من القرن العشرين، سَعَى الباحثون في تعليم اللغاتِ الأجنبيّةِ إلى رَصد العاداتِ الدراسيةِ للمتفوّقين أو الناجِحين في تعلُّم اللغاتِ الأجنبيّة، والعاداتِ الدراسيةِ لغير الناجحين فيها، وسَمّوها إستراتيجياتِ تعلُّم اللغاتِ language learning strategies بُغيَةَ تدريبِ متعلِّمي اللغاتِ على إستراتيجيات الناجحين، وإبعادِهم - قدرَ الإمكان - عن إستراتيجيات غيرِ الناجحين، مهما كانت الخَلفيّاتُ السابقَةُ لكلتا المجموعَتَين، خاصةً في مجالَيْ فَهمِ المقروءِ واكتسابِ المفرَداتِ المعجَمية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عادات دراسية ","nonDiacriticsLemma":"عادات دراسية","metaData":{"longitude":null,"latitude":null,"p
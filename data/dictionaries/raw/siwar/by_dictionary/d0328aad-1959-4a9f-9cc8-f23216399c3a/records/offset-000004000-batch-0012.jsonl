{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/11e1707b-8aaa-4de3-9507-ee27eb76817e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"11e1707b-8aaa-4de3-9507-ee27eb76817e","word":"الجِهَازُ العَصَبِيُّ الطَّرَفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9946","lexicalEntryId":"11e1707b-8aaa-4de3-9507-ee27eb76817e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الجِهَازُ العَصَبِيُّ الطَّرَفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعةُ الأعصابِ والعُقَدِ العَصَبيةِ الموصِّلةِ بين الجهازِ العَصَبيِّ المركزيِّ وسائرِ أعضاءِ الجسم، ويُسمّى أيضا بالجهاز العَصَبيِّ المحيطيِّ أو السَّطحِيِّ أو الثانوِيّ. العَلاقَةُ بين هذا الجهازِ والجهازِ العَصَبيِّ المركزيِّ شبيهَةٌ بالعلاقَة بين وحدَةِ المعالَجَةِ المركزيةِ CPU والوحداتِ الطَّرَفيةِ في الحاسوب. فالوحدةُ المركزيةُ تُعالج البياناتِ الوارِدَةَ وتخزنها، في حين تُمثِّل الوحداتُ الطَّرَفيةُ النوافِذَ التي يمكن من خلالها إدخالُ البياناتِ وإخراجُها. فالجهازُ العَصَبيُّ المركزيُّ يُمثِّل المراكزَ التي تقوم بتَحويل الإثاراتِ الخارجيةِ وترجمَتها إلى معانٍ ودلالاتٍ، في حين يُمثِّل الجهازُ العَصَبيُّ الطَّرَفيُّ النوافِذَ التي تدخُل إليها المعلوماتُ وتخرُج منها الأوامِرُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الجهاز العصبي الطرفي ","nonDiacriticsLemma":"الجهاز العصبي الطرفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.00
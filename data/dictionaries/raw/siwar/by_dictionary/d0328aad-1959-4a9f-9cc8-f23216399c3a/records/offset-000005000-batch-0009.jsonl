{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e7939bc0-2847-4884-b36a-6bbe23d024bb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e7939bc0-2847-4884-b36a-6bbe23d024bb","word":"إحْيَاءُ الدَّلالَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ce3","lexicalEntryId":"e7939bc0-2847-4884-b36a-6bbe23d024bb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إحْيَاءُ الدَّلالَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ دلاليٌّ، يُستَعمَل أيضا في السياسة اللغوية، ويُسمّى أيضا: resemanticization. ويَعني أن يُعاد استِعمالُ دلالَةٍ معيَّنةٍ للَفظٍ ما بعد سُقُوطِ تلك الدّلالةِ أو هَجرِها في مدَّةٍ سابقَةٍ. عُرِف هذا الإحياءُ في اللغة العربيةِ حين بُعِث النبيُّ محمدٌ صلى الله عليه وسلم بالإسلام ونَزَل عليه القرآنُ؛ فأحيا كثيرًا من دلالات المفردات العربية، ثم شاعَ هذا الإحياءُ مرَّةً أخرى في العربية في عَصرِنا الحاضِر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إحياء الدلالة ","nonDiacriticsLemma":"إحياء الدلالة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إحْيَاءُ الدَّلالَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7ba5575c-4b6d-4c02-90f3-525deb551ecf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7ba5575c-4b6d-4c02-90f3-525deb551ecf","word":"عِلْمُ السِّيمَا","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ce4","lexicalEntryId":"7ba5575c-4b6d-4c02-90f3-525deb551ecf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ السِّيمَا","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمُ الإشاراتِ والعَلامات، وهو الدِّراسةُ العِلميةُ للإشاراتِ والرُّموز اللغويةِ وغيرِ اللغويةِ بوَصفها أدواتِ تَواصُل. فهو علمٌ يَدرُس خَصائصَ الأنظِمَةِ الرَّمزِيَّةِ الطَّبيعيةِ والاصطِناعِيةِ من النواحي اللغويةِ والفَلسَفيةِ والاجتِماعيةِ والنَّفسِية، ولاسيما النظامُ الرَّمزيُّ المستَعمَلُ للتَّوَاصُل البَشَرِيّ. يُقسَّم هذا العلمُ إلى ثلاثَة أقسام هي: علمُ الدّلالة، وعلمُ الرُّموزِ التَّوَاصُليّ، وعلمُ الرُّموزِ العَلاقِيّ. يوَضُمّ علمُ الرُّموزِ كثيرًا من فروع علمِ اللغة، ولاسيَّما الدّلالةُ والنحوُ والأسلوب، وهو أعَمُّ من علم الدّلالَة؛ لأن الأخيرَ يَهتَمُّ بالرُّموز اللغوية، أما الأولُ فيَهتَمُّ بالعلامات والرُّموزِ سواء أكانت لغويةً أم غيرَ لغوية. ويَرَى بعضُ اللغويين أن علمَ اللغةِ -بجميع فُروعِه - فَرعٌ من علم الرُّموز، بالنظَر إلى أن اللغةَ التي يَدرُسها هذا العلمُ نظامٌ رَمزِيٌّ أو نَوعٌ من الرُّموز. راجع:  @(semiotic systems) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم السيما ","nonDiacriticsLemma":"علم السيما","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ السِّيمَا"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

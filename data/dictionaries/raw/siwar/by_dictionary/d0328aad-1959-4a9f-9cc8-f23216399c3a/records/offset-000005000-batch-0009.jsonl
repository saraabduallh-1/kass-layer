{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a9e1c63a-3ea1-412a-8921-2f53a8ba18b1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a9e1c63a-3ea1-412a-8921-2f53a8ba18b1","word":"لُغَةٌ ثَانِيَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9cf2","lexicalEntryId":"a9e1c63a-3ea1-412a-8921-2f53a8ba18b1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ ثَانِيَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ التي يَتَلقّاها الأجنَبيُّ من الناطقين بها في بلَدها الأصليِّ، بعد أن يَكتَسِب لغتَه الأمَّ first language؛ كالناطِق بالعربية، الذي يَتَعلَّم اللغةَ الإنجليزيّةَ في بريطانيا أو الولاياتِ المتحدةِ الأمريكية أو أستراليا، وكالناطِق بالإنجليزية، الذي يَتَعلَّم اللغةَ العربيةَ في المملكة العربيةِ السعوديةِ أو في مصرَ أو سوريا أو العراق أو اليمن.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"أيُّ لغةٍ يَتَعلَّمها الإنسانُ بعد لُغتِه الأمِّ، سواء تَعَلَّمها في بيئتها أو خارِج بيئتِها، وحِينئذٍ تَتَّفِق مع اللغة الأجنبِيَّةِ foreign language، غير أن التَّفريقَ بينهما مُهمٌّ من حيث الاكتسابُ، وطَريقَةُ التعلُّمِ والتعليم، ونوعُ الموادِّ التعليمية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَصفٌ سياسيٌّ يُطلَق على اللغة شِبهِ الرَّسمِيَّةِ في بلدٍ ما؛ كاللغة الفَرنسيةِ في بعض الدُّولِ الإفريقية، واللغةِ الإنجليزيةِ في نَيجِيريا والهندِ وسَنغافورَة. وقريبٌ من هذا الوصفِ اللغةُ العربيةُ في بعض الأقطارِ ذاتِ العضويةِ في الجامعة العربية وليسَت العربيةُ في أيِّ مستوًى من مستوياتها لغَتَها الأمَّ أو الأولى أو الرَّسميةَ، مثلُ جيبوتي والصومالِ وجزُرِ القَمَر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة ثانية ","nonDiacriticsLemma":"لغة ثانية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ ثَانِيَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

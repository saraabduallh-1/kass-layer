{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/81f53b71-cf2a-4765-b560-653a2453d0c8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"81f53b71-cf2a-4765-b560-653a2453d0c8","word":"تَحْلِيلُ الجُمْلَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ce6","lexicalEntryId":"81f53b71-cf2a-4765-b560-653a2453d0c8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ الجُمْلَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ، يَعني تَقسيمَ الجُملَةِ إلى مُكوِّناتها؛ لفَهم مَعناها، أو لدِراسَتِها دراسَةً لغويّةً، أو لإخضاعها لتَطبيقاتٍ تَعليمِيَّةٍ أو حاسُوبِيَّة. والجُملةُ هي أكبَرُ الوحداتِ اللغويةِ والأساسُ الذي اعتَمَدَت عليه معظَمُ الدراساتِ اللغويةِ قَديمًا وحَديثًا، بيدَ أن التحليلَ اللغويَّ في العُقُود الأخيرةِ بدأ يتخَطَّى مستوى الجُملةِ إلى مستوى الفقرَةِ والحَديث، حين أصبَحَ تحليلُ الخِطابِ جُزءًا مُهمًّا من علم اللغة، وتطَوَّرَت اللغوياتُ النَّصِّيَّةُ بوَصفها فَرعًا من فُروع علمِ اللغة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل الجملة ","nonDiacriticsLemma":"تحليل الجملة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ الجُمْلَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9f073bff-c0d1-4a1a-bc32-6ba7efdcdbb7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9f073bff-c0d1-4a1a-bc32-6ba7efdcdbb7","word":"نَبْرٌ ثَانَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ce7","lexicalEntryId":"9f073bff-c0d1-4a1a-bc32-6ba7efdcdbb7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَبْرٌ ثَانَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النَّبرُ الثاني من حيث القُوَّةُ بحسب التَّصنيفِ البِنيَويِّ للنَّبر في الإنجليزية، وعلامَتُه: /^/؛ كالنَّبر الواقِعِ على الكلمَة الأولى في تركيب white house للإشارة إلى أي بيت أبيض اللون. ويقع النبر الأوليّ على الاسم الموصوف. وهو يَلي النَّبرَ الأوَّليَّ primary stress في المرتَبَة. راجع:  @(stress) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نبر ثانوي ","nonDiacriticsLemma":"نبر ثانوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَبْرٌ ثَانَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/de2b684c-c191-423b-83ba-0ecf861c108f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"de2b684c-c191-423b-83ba-0ecf861c108f","word":"كَلِمَةُ أَمَانٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ce8","lexicalEntryId":"de2b684c-c191-423b-83ba-0ecf861c108f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمَةُ أَمَانٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغاتِ الأجنَبية، استَعمَله كوران Curan في الستينيات من القرن العشرين، لتَيسير اكتسابِ الكلماتِ الجديدةِ في اللغة الهدَف، وذلك برَبط المادَّةِ الواقِعَةِ في الذَّاكرَة قَصيرَةِ الأمَدِ بمادَّةٍ مخزونَةٍ في الذَّاكرة طويلَةِ الأمَد، وهو نوعٌ ممّا يُعرَف في علم اللغةِ النفسيِّ بالوَسائط mediations. ويمثّل لذلك في تعليم الإسبانيةِ لغةً أجنبيةً للناطقين بالإنجليزية، مثلا، برَبط معنى البياضِ بكلَمة: blanco الإسبانية، فحينئذٍ تُستَخدَم الكلمةُ الإنجليزيةُ: blank القريبةُ منها للتوصُّل إلى هذا الرِّباط؛ لأن كلمةَ: blank الإنجليزيةَ تَعني صَفحَةً فارِغَةً، وغالبا ما تكون هذه الصَّفحَةُ الفارِغَةُ بيضاءَ. وعلى الرّغم من أن هذه الفكرَةَ نابِعَةٌ من منطِقٍ نفسيٍّ، فإن المذاهبَ اللغويةَ التطبيقيةَ الحديثةَ لا تؤمن بهذا الأسلوبِ منهَجًا في تعليم اللغات؛ لما في ذلك من تكلُّف في التوصُّل إلى هذا الرِّباط، الذي يُبعِد تعلُّمَ اللغةِ عن الطبيعيةِ والفِطرِيَّة، وقد يعُوق اكتِسابَها اكتسابًا حقيقيًّا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمة أمان ","nonDiacriticsLemma":"كلمة أمان","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمَةُ أَمَانٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b0fb5f7f-a60a-4b2f-bca4-2c30a15382e6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b0fb5f7f-a60a-4b2f-bca4-2c30a15382e6","word":"التَّحْلِيلُ الدَّلالِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9cea","lexicalEntryId":"b0fb5f7f-a60a-4b2f-bca4-2c30a15382e6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّحْلِيلُ الدَّلالِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"العلمُ الذي يُعنَى بدراسة العلاقاتِ بين معاني الكلماتِ المختَلِفةِ في لغةٍ ما، وإظهارِ العلاقةِ بين تلك المعاني في التركيب. والتحليلُ الدَّلاليُّ هو الهدَفُ من تحليل الجُملة، حيث يتِمّ تجريدُ البِنيَةِ المنطِقيّةِ والعلاقاتِ المنطِقيّةِ في التركيب النحويِّ للجُملَة بعد التحليلِ التركيبيِّ، ثم اعتِمادُ التعريف المعجَميّ لمعاني الكلماتِ لترجَمة هذه البِنيَةِ المنطِقيّةِ إلى صِيَغٍ منطِقيّةٍ يمكن إجراءُ عمَليّاتِ الاستِنتاجِ المنطِقِيِّ عليها وتحليلُها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في اللِّسانيّات الحاسُوبيّةِ والترجَمَةِ الآلِيّة، يُشير إلى مهمَّة المحَلِّلِّ الدَّلاليِّ الآليِّ من حيث استِرجاعُ المفهوم، واستعادةُ عَلاقات التَّعدِيَة التي تكمُن في بِنيَة الجُملَةِ التركيبيّة، أي اشتِقاقُ المحتَوَى من البِنيَة التركيبِية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التحليل الدلالي ","nonDiacriticsLemma":"التحليل الدلالي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّحْلِيلُ الدَّلالِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fe14ba81-1fae-42f9-b5ab-95df377bdfa8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fe14ba81-1fae-42f9-b5ab-95df377bdfa8","word":"اِخْتِبَارُ التَّمْيِيزِ الدَّلالِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ceb","lexicalEntryId":"fe14ba81-1fae-42f9-b5ab-95df377bdfa8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اِخْتِبَارُ التَّمْيِيزِ الدَّلالِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اختِبارٌ يُستَعمَل في علم الدَّلالَةِ، وعلمِ اللغةِ النفسيِّ، وفي دراسَة الاتِّجاهاتِ نحوَ اللغة، تُقاس به اتِّجاهاتُ الناسِ أو شُعورُهم نحوَ كلماتٍ مُعَيَّنَة، باستِعمال أداةِ قِياسٍ مكوَّنَةٍ من زَوجٍ من الصِّفات ذاتِ الدَّلالاتِ المتَضادَّة، مثلُ: (جيِّد/رَدِيء) و(قَوِيّ/ضَعِيف) و(خَشِن/ناعِم) و(إيجابِيّ/سَلبِيّ) وهكذا، ثم تُعرَض على مَجموعَةٍ من الناس ليُصَنِّفوها في دَرَجاتٍ مختَلِفةٍ من حيث القوَّةُ والضَّعف. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار التمييز الدلالي ","nonDiacriticsLemma":"اختبار التمييز الدلالي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اِخْتِبَارُ التَّمْيِيزِ الدَّلالِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

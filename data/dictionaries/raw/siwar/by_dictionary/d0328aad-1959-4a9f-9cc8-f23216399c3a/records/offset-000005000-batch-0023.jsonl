{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/73db4a5b-1e1d-45d3-b701-1e26cff0130b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"73db4a5b-1e1d-45d3-b701-1e26cff0130b","word":"تَوْزِيعٌ زَمَنِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e5b","lexicalEntryId":"73db4a5b-1e1d-45d3-b701-1e26cff0130b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوْزِيعٌ زَمَنِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، استَعمله بعضُ الباحثين في تعليم اللغاتِ لتأكيد أن متعلِّمَ اللغةِ الثانيةِ أو الأجنبيّةِ يَكتَسِب المفرَداتِ التي يتعرَّض لها حين تَرِد موزَّعَةً في مناسباتٍ متفاوِتَةٍ وسياقاتٍ مختَلِفةٍ بطريقَةٍ أفضَلَ من أن يتعرَّض لها مرَّاتٍ متتاليَةً، وإن كانت مرَّاتُ التعرُّضِ للمفرَدات ذاتِها متَساوِيَةً في كلتا الحالَتَيْن. يُعلَّل ذلك بأن الخِبرَةَ المتوزِّعَةَ أفضَلُ من الخِبرَة المتَكَتِّلَة، وأن الطريقَةَ المقَسَّطَةَ تَسمَح للعَقل أن يخزِن أنواعًا من المفاتيح والمُشعِراتِ لهذه الكلمات، بدَلًا من خَزن نُسَخٍ متعدِّدَةٍ من الصورَة الأساسيّة، إضافَةً إلى أن تعرُّضَ المتعلِّمِ للكلِمَة في أوقاتٍ مختَلِفَة يمنَحه مَزيدًا من دلالات الكلمة بحسَب السِّياقِ اللغويِّ والمقامِ الاجتماعيّ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"توزيع زمني ","nonDiacriticsLemma":"توزيع زمني","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"
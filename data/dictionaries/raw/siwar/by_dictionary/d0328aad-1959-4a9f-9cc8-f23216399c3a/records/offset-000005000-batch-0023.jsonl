{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7e01b291-3301-4e28-ab21-195d0ed32d2c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7e01b291-3301-4e28-ab21-195d0ed32d2c","word":"ثَبَاتُ التَّجْزِئةِ النِّصْفِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e56","lexicalEntryId":"7e01b291-3301-4e28-ab21-195d0ed32d2c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ثَبَاتُ التَّجْزِئةِ النِّصْفِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قِياسٌ للثَّبات الداخِلِيِّ للاختِبار بطريقَةِ التَّجزئةِ النِّصفِيَّةِ أو التَّنصيفِ الانشِطارِيّ، بشَطر الاختِبارِ إلى نِصفَيْن: أحَدُهما من الأسئلة الفَردِيَّة، والآخَرُ من الأسئلة الزَّوجِيَّة، ثم تُوضَع لكلِّ نِصفٍ دَرَجَتُه الخاصَّةُ به، ثم يُحسَب مُعامِلُ الارتِباطِ بين دَرَجَتَيْ النِّصفَيْن لجَميع أفرادِ العيِّنَة، وذلك لقِياس مُعامِل الثَّباتِ الدَّاخِلِيِّ للاختِبار، ثم يُحوَّل مُعامِلُ الثَّباتِ الدَّاخِلِيِّ إلى مُعامِل الثَّباتِ الزَّمَنِيِّ بواسِطة مُعادَلَةٍ خاصَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ثبات التجزئة النصفية ","nonDiacriticsLemma":"ثبات التجزئة النصفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ثَبَاتُ التَّجْزِئةِ النِّصْفِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dbdecd1c-1468-447c-b87e-4a8315b3f609/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dbdecd1c-1468-447c-b87e-4a8315b3f609","word":"أخْطَاءٌ كَلامِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e5c","lexicalEntryId":"dbdecd1c-1468-447c-b87e-4a8315b3f609","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أخْطَاءٌ كَلامِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الأخطاءُ التي يَقَع فيها المتكلِّمون في أثناء الكلام، وذلك في نُطق الأصواتِ واستعمالِ الكلماتِ وتركيبِ الجُمَل؛ كالأخطاء الاستِباقيَّةِ anticipation errors، والأخطاءِ الاستِمرارِيَّةِ  perseveration errors، والأخطاءِ التَّبادُليَّةِ reversal errors. هذه الأخطاءُ يَقَع فيها الناطقون باللغة وغيرُهم من الناطقين بلغاتٍ أخرى، وتُدرَس دراسةً لغويّةً نَفسيّة لمعرفة كَيفِيَّةِ حِفظِ الوحداتِ اللغويةِ في الذَّاكرَة طَويلةِ الأَمَد، وكَيفيَّةِ استِدعائها في أثناء الكلام. راجع:  @(anticipation error) و  @(perseveration error) و  @(reversal error) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أخطاء كلامية ","nonDiacriticsLemma":"أخطاء كلامية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أخْطَاءٌ كَلامِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

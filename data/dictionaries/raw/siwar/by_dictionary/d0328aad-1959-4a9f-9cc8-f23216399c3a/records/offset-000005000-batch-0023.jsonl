{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4ee2cbc2-409c-4c9a-9be2-d27616a19edc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4ee2cbc2-409c-4c9a-9be2-d27616a19edc","word":"تَحْلِيلُ النَّصِّ المَصْدَرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e51","lexicalEntryId":"4ee2cbc2-409c-4c9a-9be2-d27616a19edc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ النَّصِّ المَصْدَرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في الترجَمة الآليَّة، يُشير إلى مرحلَةٍ تَسبِق الترجَمةَ، تُقَيَّمُ خلالها خَصائصُ النَّصِّ المصدَر؛ لتَحديد الخطواتِ اللازِمِ اتباعُها، وتُحدَّدُ أدواتُ الترجَمةِ الواجِبُ توفيرُها لتَحقيق أكبَرِ قَدرٍ ممكنٍ من الإنجاز. وقد يَتِمّ في هذه المرحلَةِ أيضًا تحديدُ المصطلَحاتِ والصِّيَغِ والتراكيبِ ورَصدُ تَكرارِها، وتحليلُ معانيها بحسب السِّياقِ الذي تَرِد فيه، وقد يتطلَّب الأمرُ توسيمَ النُّصوصِ أو المدوَّناتِ اللغويّةِ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل النص المصدر ","nonDiacriticsLemma":"تحليل النص المصدر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ النَّصِّ المَصْدَرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

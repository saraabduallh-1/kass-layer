{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5a55803a-962f-480a-a92e-dd71c72e8c2a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5a55803a-962f-480a-a92e-dd71c72e8c2a","word":"مَعْرِفَةٌ إجْرَائيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a10","lexicalEntryId":"5a55803a-962f-480a-a92e-dd71c72e8c2a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَعْرِفَةٌ إجْرَائيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ نَوعَيْ المعرِفة، وهي القُدرةُ الإجرائيةُ العَمَليةُ على عَمَل شيءٍ ما أو استِعمالِ شيءٍ ما؛ كأن يُثبِت متعلِّمُ اللغةِ قُدرَتَه على استِعمال تركيبٍ لُغويٍّ ما استِعمالًا صَحيحًا بالكلام أو بالكتابة. يُقابِل هذا النوعَ من المعرفةِ المعرفةُ التَّصريحيَّةُ أو اللَّفظيَّةُ declarative knowledge التي تَعني المعرفةَ النَّظريَّةَ الواعِيَةَ بشيءٍ ما، كوَصف القاعدةِ النَّحويةِ لتَركيبٍ لغويٍّ وَصفًا نَظريًّا، أو الإجابةِ الصَّحيحةِ عن سُؤالٍ عنها. راجع:  @(declarative knowledge) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في إستراتيجيّات استِعمالِ اللغة، يُشير إلى مَعرِفة متعلِّمِ اللغةِ الثانيةِ بأنواعٍ مختَلِفةٍ من الإستراتيجياتِ الفَعَّالةِ التي يمكن تَوظيفُها في التَّواصُل باللغة الهَدَف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معرفة إجرائية ","nonDiacriticsLemma":"معرفة إجرائية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَعْرِفَةٌ إجْرَائيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9cc9eb8c-986c-4ca3-96b5-b724ed102323/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9cc9eb8c-986c-4ca3-96b5-b724ed102323","word":"ما بَعدَ البْلُومْفِيلْدِيِّينَ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a11","lexicalEntryId":"9cc9eb8c-986c-4ca3-96b5-b724ed102323","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ما بَعدَ البْلُومْفِيلْدِيِّينَ","lemmaType":"MslCom","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على مدرسة هَيْمَنَت على الدراسات اللغويةِ النظريةِ في الولاياتِ المتحدةِ الأمريكيةِ في الخمسينيات والستينياتِ من القرن العشرين، ضمّت عَدَدًا من اللغويين أمثالَ زيليغ هارِيس Zellig Harris وهُوكت Hockett وتَراجر Trager. طَوَّرَت هذه المدرسةُ بعضَ الآراءِ الحادَّة للغويِّ الأمريكيِّ ليونارد بلومفيلد Leonard Bloomfield، خاصةً ما يتعلَّق منها بالشَّكل والمعنى وأساليبِ التَّحليل. تأثَّر تشومسكي - في أول أمرِه - بهذه المدرسةِ وفَلسَفَتِها من طريق أستاذِه هاريس، لكنه استقَلَّ عنها وظَهَر بآرائه ونظرياتِه التي هاجَم فيها نظريةَ بلومفيلد وما بُني عليها من نظرياتٍ وآراء وتطبيقات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ما بعد البلومفيلديين ","nonDiacriticsLemma":"ما بعد البلومفيلديين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ما بَعدَ البْلُومْفِيلْدِيِّينَ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d5acdc06-0f5d-418b-bf12-0a5719fdae89/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d5acdc06-0f5d-418b-bf12-0a5719fdae89","word":"مُجَتَمَعَاتُ مَا بَعْدَ الاِسْتِقْلالِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a12","lexicalEntryId":"d5acdc06-0f5d-418b-bf12-0a5719fdae89","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُجَتَمَعَاتُ مَا بَعْدَ الاِسْتِقْلالِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في السياسَة اللغويةِ والتَّخطيطِ اللغويِّ، يُشير إلى حالات المجتَمَعاتِ والدُّوَل التي نالَت استِقلالَها بعد الحَربِ العالَميةِ الثانية، وما تَلا هذا الاستِقلالِ من مُشكِلاتٍ لغويةٍ اجتِماعية، ونِزاعاتٍ في اتخاذ قَراراتٍ بشَأن تحديدِ اللُّغاتِ الرَّسميةِ والثانيةِ والأجنَبية، واختِيارِ الحُروفِ للُّغة أو اللغاتِ الرَّسمية، ونحوِ ذلك. وهذا الاختلافُ نتيجةٌ طبيعيةٌ لما بعد الاستِقلالِ في الدوَل ذاتِ التَّعَدُّدِ اللغوِيِّ والعِرْقي؛ لأن المحتَلِّين غالبا ما يَفرِضون لغتَهم بالقوَّة على الشعوب التي يحتلُّونها، وحين تَستَعيد الشُّعوبُ حرّيَّتَها يَسعى كلُّ شعبٍ منهم إلى استِعادَة لغَتِه.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مجتمعات ما بعد الاستقلال ","nonDiacriticsLemma":"مجتمعات ما بعد الاستقلال","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُجَتَمَعَاتُ مَا بَعْدَ الاِسْ
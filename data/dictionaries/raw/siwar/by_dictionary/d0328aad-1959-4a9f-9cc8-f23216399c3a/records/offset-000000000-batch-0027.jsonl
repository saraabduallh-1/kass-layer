{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/09e9e965-5d43-4af3-9ecd-327e019ef469/get-public-entry"},"browse_index_record":{"lexicalEntryId":"09e9e965-5d43-4af3-9ecd-327e019ef469","word":"مُنَاغَاةٌ مِعْيَارِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ae8","lexicalEntryId":"09e9e965-5d43-4af3-9ecd-327e019ef469","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُنَاغَاةٌ مِعْيَارِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اكتِساب اللغةِ الأمِّ، يُشير إلى المرحَلَة الثانيةِ من مَراحِل المناغاةِ babbling عند الأطفال، تتَمَثَّل في تَكرار الطفلِ مقاطِعَ صَوتيةً في الشهر الثامِنِ تقريبا، وهي مؤشِّرٌ على أنه بدأ يكتَسِب السِّماتِ الممَيِّزةَ للُغَته الأمِّ. فالطفلُ العربيُّ مثلا يَبدأ في اكتساب الصوامتِ والصوائت، والطفلُ الصينيُّ يَبدأ في اكتِساب النَّغَماتِ tones. ويُفرِّق بعضُ اللغويين النَّفسيِّين بين هذه المرحَلةِ والمرحَلةِ السابقَةِ لها، وهي المناغاةُ الهامشية غيرُ الأساسيةِ marginal babbling.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مناغاة معيارية ","nonDiacriticsLemma":"مناغاة معيارية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُنَاغَاةٌ مِعْيَارِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/addcb491-e2b3-4f0e-9661-dd4c815433e2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"addcb491-e2b3-4f0e-9661-dd4c815433e2","word":"صِيغَةٌ مِعْيَارِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ae9","lexicalEntryId":"addcb491-e2b3-4f0e-9661-dd4c815433e2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صِيغَةٌ مِعْيَارِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الصِّيغةُ الأساسُ لمجموعَةٍ من البدائل الصرفية، مثل: –s في الإنجليزية التي تمثِّل الصِّيغَةَ المِعيارِيةَ للجَمع في الإنجليزية، في مقابِل الصِّيَغِ البَديلَةِ غيرِ المِعيارِيةِ التي تؤدِّي هذه الوَظيفةَ، وهي: –z, -es, en","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"صِيغَةٌ مِعياريةٌ تُقاس بها الصِّيَغُ الأخرى من حيث صِحَّتُها أو عَدَمُ صِحَّتِها، أو من حيث اتِّساقُها مع القياس أو مُنافاتُها له؛ كزيادَة الحركةِ لالتِقاء الساكِنَيْن، وغيابِ علامَةِ التأنيثِ في المذَكَّر في العربية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"الصِّيغَةُ المختارَةُ لتَمثِيل العُنصُرِ اللغويِّ (كلمةٌ أو جُملة)، في المعاجِم أو في القواعد إذا كان للعُنصُر أكثَرُ من صِيغَة، كالمادة الثلاثيةِ للكلمة في المعاجِم العربيةِ التي تمثِّل الفعلَ الثُلاثيَّ، وحالَةِ الرَّفعِ في اللاتِينِية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صيغة معيارية ","nonDiacriticsLemma":"صيغة معيارية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صِيغَةٌ مِعْيَارِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

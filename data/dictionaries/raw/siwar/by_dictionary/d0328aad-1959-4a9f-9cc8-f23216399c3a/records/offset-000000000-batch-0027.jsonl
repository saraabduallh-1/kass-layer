{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7a394aef-1e8c-48f2-b989-95835dfff106/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7a394aef-1e8c-48f2-b989-95835dfff106","word":"جَمْعُ التَّكْسِيرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8af0","lexicalEntryId":"7a394aef-1e8c-48f2-b989-95835dfff106","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جَمْعُ التَّكْسِيرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"صِيغَةُ جَمعٍ تُصاغ بتَغيِير الاسمِ المفرَدِ من الداخِل، مثل: (رَجُل ورِجال) و(جَمَل وجِمال) و(مدرَسَة ومدارِس) في العربية، ويُقابِله الجَمعُ السالم. وجَمعُ التكسيرِ خاصٌّ ببَعض اللغاتِ السّامِيّة، لاسيَّما اللغاتُ السّاميّةُ الجنوبيةُ، كالعربية والحَبَشية. وفي مجال اكتساب اللغة، يلاحَظ أن جُموعَ التكسيرِ في العربية غالِبا ما تُكتَسَب قبلَ الجُموعِ السالِمَة؛ لشُيُوع استعمالِها، وقِلَّةِ عدَدِها قِياسا بالجُموع السالِمَة؛ لأنها تُكتَسَب اكتِسابَ المفرَداتِ، لا اكتِسابَ الصِّيَغِ والتراكيب، وهذا ما يُفسِّر أخطاءَ الطلابِ في الجُمُوع السالِمَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جمع التكسير ","nonDiacriticsLemma":"جمع التكسير","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جَمْعُ التَّكْسِيرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4f4ce8c5-551e-4ec8-9918-0083d6febde2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4f4ce8c5-551e-4ec8-9918-0083d6febde2","word":"مُحَدِّدٌ دَلالِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8af6","lexicalEntryId":"4f4ce8c5-551e-4ec8-9918-0083d6febde2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُحَدِّدٌ دَلالِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ  دَلالِيٌّ استَعمَلَه جيرولد كاتز Jerrold Katz وجيري فودر Jerry Fodor في نَظَرِيَّتِهما حول تحديد دَلالاتِ الكلمات. وقد مَيَّزا فيها بين ثلاثةِ أنواعٍ من العَناصِر أو المكوِّنات، وهي: المحدِّدُ النَّحويُّ grammatical marker الذي اعتَبَراه عُنُصرًا غيرَ أساس، والمحدِّدُ الدَّلاليُّ وهو عُنصُرٌ يمكن أن يوجَد في أماكن أخرَى من المعجَم لأنه عُنصُرٌ عامٌّ يَشتَرك بين لَكسِيماتٍ تَنتَمي إلى حُقُول معجَميَّةٍ مختَلِفة، والممَيِّزُ distinguisher وهو عُنصُرٌ خاصٌّ بمعنى معيَّن، يَقَع في آخِر السِلسِلَة، ولا يوجَد في أماكِن أخرَى من المعجَم إلّا في حالَة التَّرادُف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"محدد دلالي ","nonDiacriticsLemma":"محدد دلالي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُحَدِّدٌ دَلالِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e87f4e64-2f46-4d0e-930e-cb285f99f6af/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e87f4e64-2f46-4d0e-930e-cb285f99f6af","word":"لُغَةٌ مَحْدَودَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b908e","lexicalEntryId":"e87f4e64-2f46-4d0e-930e-cb285f99f6af","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مَحْدَودَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ يُمكِن حَصرُ جميعِ ألفاظِها وتراكيبِها وقواعدِها بسُهولة، سواء أكانت لغةً اصطِناعيةً artificial language كلُغات البرمَجَةِ الحاسوبية مثلاً، أم لغةً طبيعيةً في مجالٍ محدَّدٍ، مثلُ لغاتِ المراسِمِ الدّبلوماسية، ولغةِ الملاحَةِ الجَوِّية، ونحوِ ذلك. وجميعُ اللغاتِ البَشَريةِ الطبيعيةِ لا تُعَدُّ لغاتٍ محدودَةً حين تُستَعمَل في مَواقِف ومقاماتٍ طبيعية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة محدودة ","nonDiacriticsLemma":"لغة محدودة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مَحْدَودَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/79f9d811-38c1-4dbf-8b53-5e30d08c274b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"79f9d811-38c1-4dbf-8b53-5e30d08c274b","word":"اكْتِسَابُ اللُّغَةِ الأُمِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b908f","lexicalEntryId":"79f9d811-38c1-4dbf-8b53-5e30d08c274b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اكْتِسَابُ اللُّغَةِ الأُمِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يَعني عَمَليَّةَ اكتسابِ الطفلِ لغتَه الأمَّ اكتسابًا طبعيًّا بتَلَقِّي المدخَلاتِ اللغويةِ من والِدَيْه أو مُرَبِّيه أو أقرانِه أو غيرِهم من المحيطين به في بيئته. ولهذه العَمَليَّةِ سِماتٌ وخصائصُ ومَراحِل، تَمَثَّلَت في نظرياتٍ لغويةٍ نفسية عُرِفَت بنَظريات اكتسابِ اللغةِ language acquisition theories، بيدَ أن أبرَزَها النظريةُ الفِطرِيَّةُ التي تزَعَّمَها تشومسكي، وبنى أُسُسَها على نظرية القواعدِ الكُلِّيَّةِ universal grammar التي أكَّد فيها أن اللغةَ فِطرَةٌ خاصةٌ بالإنسان، وأن الطفلَ يَكتَسِب لغتَه الأمَّ من المدخَلات اللغويّةِ دونَ حاجَةٍ إلى تعلُّم مُنَظَّم، ويتوَصَّل إلى قواعدها وقوانينِها بطريقَةٍ إبداعِيَّةٍ نتيجةَ تَلَقِّي المدخَلاتِ اللغويَّةِ بشَكلٍ طَبعيّ، ثم فَرضِ الفُروضِ حولَها، وتجريبِ هذه الفُروضِ تجريبًا مَعرِفيًّا فِطريًّا. ويرى تشومسكي أيضا أن هذه العَمَليةَ بخصائصها ومَراحِلِها متَشابِهَةٌ لدى جميعِ الأطفالِ مهما اختَلَفت لغاتُهم، وتبايَنَت ثقافاتُهم، وتنوّعَت مجتمعاتُهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اكتساب اللغة الأم ","nonDiacriticsLemma":"اكتساب اللغة الأم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اكْتِسَابُ اللُّغَةِ الأُمِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

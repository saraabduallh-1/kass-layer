{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5d7623c0-9e7c-4263-9840-09a7159263b9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5d7623c0-9e7c-4263-9840-09a7159263b9","word":"حَرَكَاتُ العَيْنِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b909a","lexicalEntryId":"5d7623c0-9e7c-4263-9840-09a7159263b9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَرَكَاتُ العَيْنِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم النفس القرائيِّ، يُشير إلى ما تَقوم به العَينُ أو العينان من حَرَكات في أثناء القراءةِ حين يَنتَقِل النَّظَرُ من نُقطَةٍ إلى أخرى في النَّصِّ المقروء، وتؤثّر هذه الحَرَكاتُ في سُرعَة القراءةِ وفي الفَهم أيضا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نفسيٌّ اجتماعيٌّ، غالبا ما يُستَعمَل في دراسة دِينامِيَّةِ الجماعةِ group dynamics، ويُشير إلى نوعٍ من سُلوك الأفرادِ في مجتَمَعٍ ما في أثناء المحادَثة، حيث تتحرَّك العينان بدرَجاتٍ محدَّدَةٍ في أثناء التناوُبِ في الكلامِ turn-taking، وفقا لعادات المجتَمَعِ وطبيعةِ الفَرد؛ فتتَّجِه مرَّةً إلى المخاطَب أو إلى جُزء من أجزاء جِسمِه كالوجه مثلا، وتتَّجِه مرَّةً أخرى إلى الأعلى، ومرَّةَ ثالثةً إلى الأسفِل، وقد تتَّجِه إلى اليَمين أو إلى الشّمال.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حركات العين ","nonDiacriticsLemma":"حركات العين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حَرَكَاتُ العَيْنِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/facb17c7-1a2d-4bc6-ad23-eee5378bf4cf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"facb17c7-1a2d-4bc6-ad23-eee5378bf4cf","word":"الامْتِدَادُ البَصَرِيُّ (في القِرَاءَةِ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b909b","lexicalEntryId":"facb17c7-1a2d-4bc6-ad23-eee5378bf4cf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الامْتِدَادُ البَصَرِيُّ (في القِرَاءَةِ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَدَى العَينِ، وهو المسافَةُ القرائيةُ التي تُغَطِّيها العَينُ في آنٍ واحدٍ في أثناء القراءة. والمسافَةُ القرائيةُ هي النَّصُّ المكتوبُ الذي يَنظُر إليه القارِئُ نظرةً مُفرَدةً أو دَفعةً واحدةً، حتى كأنه قِطعةٌ متَّصِلةٌ. ويُقَدَّر هذا المدَى في اللغة الإنجليزيةِ بمسافَةِ ما بين سبعةِ أحرُفٍ إلى عشرة أحرُف. راجع:  @(reading speed) و  @(visual/vision span) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الامتداد البصري (في القراءة) ","nonDiacriticsLemma":"الامتداد البصري (في القراءة)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الامْتِدَادُ البَصَرِيُّ (في القِرَاءَةِ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

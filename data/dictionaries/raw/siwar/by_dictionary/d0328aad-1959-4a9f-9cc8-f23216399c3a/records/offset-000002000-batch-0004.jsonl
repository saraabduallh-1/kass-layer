{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c58acd1b-b247-4f55-b0cb-231fb67f61ac/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c58acd1b-b247-4f55-b0cb-231fb67f61ac","word":"التَّرْكِيزُ علَى الشَّكْلِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9086","lexicalEntryId":"c58acd1b-b247-4f55-b0cb-231fb67f61ac","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّرْكِيزُ علَى الشَّكْلِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغات، يُقصَد به شَرحُ القاعِدَةِ النحويةِ أو الصّرفيةِ التي تحكُم النَّمَطَ أو الصِّيغَة، بطريقَةٍ عَرَضيةٍ غَيرِ مَقصودَة، وذلك حين يتطلَّب الموقِفُ شَرحَها. ويُمَيَّز بينَ هذا النَّوعِ من التّركيز بصيغَةِ المفرَدِ form، والتَّركيزِ بصيغَة الجَمْعِ focus on forms، الذي يَعني التَّركيزَ المقصودَ على الأشكال من صِيَغٍ وتراكيبَ، والشَّرحَ الصَّريحَ للقواعِد، المعروفَ برَفع الوَعْيِ أو التَّنبيهَ للقاعِدَة consciousness raising.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التركيز على الشكل ","nonDiacriticsLemma":"التركيز على الشكل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّرْكِيزُ علَى الشَّكْلِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/04a62594-1a5d-4fa4-b7c7-dc4ba1e905fe/get-public-entry"},"browse_index_record":{"lexicalEntryId":"04a62594-1a5d-4fa4-b7c7-dc4ba1e905fe","word":"تَصْنِيفٌ شَعْبِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9087","lexicalEntryId":"04a62594-1a5d-4fa4-b7c7-dc4ba1e905fe","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَصْنِيفٌ شَعْبِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَصنِيفُ الأشياءِ أو الوحداتِ المعجَميةِ الدّالَّةِ على الأشياء في مجتَمَعٍ ما بناءً على تَصَوُّرات شَعبِيةٍ مَورُوثَة، قد يختَلِف عن التَّصنيف العلميِّ لهذه الأشياء. فالطَّماطمُ مثلا يُصنَّف عِلميًّا ضِمنَ الفواكه، لكن كلمةَ: tomato في المفهوم الإنجليزيِّ لا يُصنَّف مَدلولُها ضِمنَ الفاكهةِ fruit وإنما يُصنَّف ضِمنَ الخضرواتِ vegetables. ومثلُ ذلك التَّمرُ الذي يُنظَر إليه في كثيرٍ من الأقطار العربيةِ على أنه طَعامٌ لا فاكِهة؛ لأن أغلب العربِ يَعَدُّونه غِذاءً رئيسًا، وبهذه الصِّفَةِ لا يمكن أن يكون فاكهةً في نظرهم. ومثلُ ذلك تأنيثُ بعضِ الأسماءِ وهي مذكَّرَةٌ، أو العَكس، بناءً على تَصَوُّر الناسِ للشيء من حيث التذكيرُ والتأنيثُ، وهو على خلاف ذلك في الحقيقة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تصنيف شعبي ","nonDiacriticsLemma":"تصنيف شعبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَصْنِيفٌ شَعْبِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0567c992-892a-4c15-9612-5eda095c60f1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0567c992-892a-4c15-9612-5eda095c60f1","word":"مُحَاكَاةُ كَلامِ الأَجْنَبِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9088","lexicalEntryId":"0567c992-892a-4c15-9612-5eda095c60f1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُحَاكَاةُ كَلامِ الأَجْنَبِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ في الكلام، يحاكِي فيه الناطِقُ باللغةِ الهَدَفِ لغةَ الأجنَبيِّ ضَعيفِ الكِفايَةِ فيها حين يتحَدَّث معه، فيَنزِل إلى مستواه، ويتكلَّم بلغَته المكَسَّرَة. ولهذا الأسلوبِ خصائصُ، منها: رَفعُ الصوت، والكلامُ ببُطء، مع مبالَغَةٍ في إظهار الأصواتِ من مخارِجها، واستعمالُ كلماتٍ شائعَةٍ، وتراكيبَ بسيطَةٍ خاليةٍ من كثير من الأدوات والكلماتِ الوَظيفية، واستعمالُ أفعالٍ بسيطةٍ ذاتِ أزمِنَةٍ مُوَحَّدة، وتَكرارُ الكلماتِ الرئيسةِ التي تمثِّل موضوعَ الحديث، ووَضعُها في صُدورِ الجُمَلِ حتى لو لم يَسمَح التركيبُ الصحيحُ بذلك. ويَلجأ الناطقون باللغة إلى هذا الأسلوب؛ تعاطُفا مع الأجانب، واعتقادا منهم بأنه الأسلوبُ الأيسَرُ للتفاهُم معهم، لكنه مُضِرٌّ بلُغَة المتعلِّمِ المرحَليةِ على المدَى البعيد، وقد يؤدِّي إلى تحَجُّر لغتِه في هذا المستوى، أو تحوُّلِها إلى لغةٍ هَجِين يَصعُب تَعديلُها فيما بعدُ، كما أنه مُضِرٌّ باللغة ذاتِها، ولاسيَّما حين يَشيع هذا الاستعمالُ بين الناطقين باللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"محاكاة كلام الأجنبي ","nonDiacriticsLemma":"محاكاة كلام الأجنبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُحَاكَاةُ كَلامِ الأَجْنَبِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0b371c53-4435-456b-8cf0-24e3d71ad816/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0b371c53-4435-456b-8cf0-24e3d71ad816","word":"لُغَةٌ أجْنَبِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9089","lexicalEntryId":"0b371c53-4435-456b-8cf0-24e3d71ad816","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ أجْنَبِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ سياسيٌّ، يُطلَق على أيِّ لغةٍ غيرِ اللغةِ الأمِّ لأهل البلَد، وتُستَعمَل مع الناطقين بغير لغتِهم في التواصُل بنوعَيه الشَّفَهيِّ والمكتوب؛ كالإنجليزية في المملكة العربيةِ السعوديةِ ومصرَ والعراق، والفرنسيةِ في سوريا، والعربيةِ في باكستان.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يُطلَق على اللغة التي يتَعلَّمها الإنسانُ في غير بيئتِها الأصلية، بعد اكتسابِ لغتِه الأمِّ؛ كتعلُّم العربيِّ الإنجليزيةَ في الأقطار العربية، وتعلُّمِ الأمريكيِّ العربيةَ في بلده أو في فرنسا أو في اليابان. وتُقابَل هذه اللغةُ عادَةً باللغة الثانيةِ second language التي يتعلَّمها الإنسانُ في بيئتها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يُشير إلى وَصفٍ شاملٍ لكلِّ لغةٍ يتعلَّمها الإنسانُ بعد لغتِه الأمِّ، سواء تعلَّمها في بيئتها أو خارِجَ بيئتِها، وحينئذٍ لا يُفَرَّق بين هذا المصطلَحِ foreign language ومصطلَحِ اللغةِ الثانية second language.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة أجنبية ","nonDiacriticsLemma":"لغة أجنبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ أجْنَبِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

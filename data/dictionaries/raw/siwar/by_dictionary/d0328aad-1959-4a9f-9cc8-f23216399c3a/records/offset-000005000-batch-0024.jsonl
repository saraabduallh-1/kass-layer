{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/77f0b943-67b3-45a4-a613-b1ba7cd3acd6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"77f0b943-67b3-45a4-a613-b1ba7cd3acd6","word":"عُظَيْمُ الرِّكَابِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e6b","lexicalEntryId":"77f0b943-67b3-45a4-a613-b1ba7cd3acd6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عُظَيْمُ الرِّكَابِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُطلَق على عَظمِ الرِّكابِ أو الرِّكابِ، وهو أحَدُ العُظَيْماتِ الثلاثةِ في الأذُن الوُسطى التي تَشمل المِطرَقَةَ والسِّندانَ والرِّكاب، وتَملأ هذه العُظيماتُ الفَراغَ الواقِعَ بين الغِشاءِ الطَّبليِّ والقَوقَعَة. عُظَيمُ الركابِ هذا هو آخِرُها مما يَلي الأذُنَ الداخليةَ حيث يتَّصِل بالنافذَة البَيضَوِيةِ الغِشائيةِ التي تَقود إلى الأذُن الداخِلية. ووَظيفَةُ هذه العُظَيماتِ نَقلُ الموجاتِ الصَّوتيةِ الوارِدَةِ من الخارِج عَبرَ الممَرِّ السَّمعِيِّ وتَحويرُها في شَكل اهتزازاتٍ تُحدِث تَموُّجاتٍ في سائل القَوقَعَةِ؛ لتُناسِب هذه الاهتزازاتُ والتمَوُّجاتُ الأجهِزَةَ الدَّاخليةَ التي تَستَقبِلها وتُرسِلها إلى الأجهزَة والمراكِزِ السَّمعيةِ التي تَليها في هيئة نَبضاتٍ كَهربائية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عظيم الركاب ","nonDiacriticsLemma":"عظيم الركاب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عُظَيْمُ الرِّكَابِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bf717a4c-9b6b-4b92-95dd-3c0432f5edca/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bf717a4c-9b6b-4b92-95dd-3c0432f5edca","word":"سَاقٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e6c","lexicalEntryId":"bf717a4c-9b6b-4b92-95dd-3c0432f5edca","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سَاقٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"جُزءٌ من كلمةٍ يُضاف إليه مورفيمٌ أو مَجموعةٌ من المورفيمات تَقبَل الزيادة، وتَتَمَثَّل في الماضي من الأفعال والمفرَد من الأسماء في العربية. يختَلف الجِذعُ أو السَّاقُ عن الجِذْر root؛ فكلِمَةُ: (الجالِسُون) جَذعُها: (جالِسٌ) وكلمة (يجلسون) جِذعُها: (جَلَسَ)، لكن جِذْرَ الكلمَتَين واحدٌ هو مادَّةُ: (ج ل س ). والكلمةُ الإنجليزيةُ: harmful جِذعٌ لأنها تَقبَل السابقةَ: un، فيُقال: unharmful، لكنها ليسَت جِذرا بل الجِذْر هو: harm. ويكون الجِذعُ: بَسيطا أي مكوَّنا من جِذرٍ فقط، مثلُ: work و: harmful، ويكون جِذرا مع زائدة مثلُ: works، وقد يكون من جِذرَيْن أو أكثَرَ، مثلُ: workshop. وقد يُستَعمَل لفظُ جِذع أو ساق بمعنى جِذر أو العَكس، وذلك حين يكون الجِذعُ أو الساقُ بسيطا مُكَوَّناً من جِذرٍ واحِدٍ، أي يكون مورفيما (وحدة صرفيّة) واحدا  فقط.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"ساق ","nonDiacriticsLemma":"ساق","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سَاقٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

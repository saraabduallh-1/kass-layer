{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/33164d0b-f077-4c23-809a-f617cc26fd3f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"33164d0b-f077-4c23-809a-f617cc26fd3f","word":"تَنْضِيدٌ طَبَقِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e77","lexicalEntryId":"33164d0b-f077-4c23-809a-f617cc26fd3f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَنْضِيدٌ طَبَقِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُقصَد به التَّنضيدُ الاجتماعيُّ، أو التَّصنيفُ الطَّبَقِيُّ للُّغة stratification of language، وهو الترتيبُ الهرَميُّ للطَّبَقات الاجتماعيّةِ داخلَ مجتَمَعٍ ما. وتختَلِف مَعايِيرُ هذا التَّصنيفِ من مجتَمَعٍ لآخَر، وما يَترَتَّب على ذلك من تَفاوُتٍ لغويٍّ اجتماعيٍّ طَبَقِيٍّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تنضيد طبقي ","nonDiacriticsLemma":"تنضيد طبقي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَنْضِيدٌ طَبَقِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bd546316-63a6-4180-a175-cb90f878cc62/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bd546316-63a6-4180-a175-cb90f878cc62","word":"نَحْوٌ طَبَقِيٌّ تَنْضِيدِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e78","lexicalEntryId":"bd546316-63a6-4180-a175-cb90f878cc62","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَحْوٌ طَبَقِيٌّ تَنْضِيدِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَظريةٌ في التَّحليل اللغوي، وَضَعَها اللغويُّ الأمريكيُّ سِدْني لامب Sydney. M. Lamb  عامَ 1962م، لتَوضيح العلاقاتِ العَميقَةِ بين مُكوِّناتِ الجُملةِ، التي لم تَتَمَكَّن نظرياتُ المكوِّناتِ المباشرَةِ من التَّعبير عنها. تُقسِّم هذه النظريةُ اللغةَ إلى ستِّ طَبَقاتٍ مترابِطَة، لكلٍّ منها نظامٌ خاصٌّ يَتمُّ التَّحليلُ على أساسه. أدنى هذه الطَّبقاتِ الطَّبقةُ دونَ الفونِيمِية، فالطَّبقةُ الفونِيمِية، فالطَّبقةُ المورفيمية، ثم الطَّبقةُ اللَّكسِيمِية، فالطَّبقةُ السِّيمِيمِية، فالفَوقُ سِيمِيمِية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نحو طبقي تنضيدي ","nonDiacriticsLemma":"نحو طبقي تنضيدي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَحْوٌ طَبَقِيٌّ تَنْضِيدِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f717cf72-49be-45da-9e0b-2e17ac1fc1f6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f717cf72-49be-45da-9e0b-2e17ac1fc1f6","word":"سَكْتَةٌ دِمَاغِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e79","lexicalEntryId":"f717cf72-49be-45da-9e0b-2e17ac1fc1f6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سَكْتَةٌ دِمَاغِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الجَلْطَةُ الدِّماغيّةُ، وهي مرَضٌ يحدُث نتيجةَ انسِدادٍ أو تَمَزُّقٍ في العُروق المؤدِّيَةِ إلى الدِّماغ؛ فيَحدُث نَقصٌ أو تَوَقُّفٌ لجَرَيان الدَّمِ إليه أو إلى أحَد أجزائه؛ ما يحرم أنسِجَتَه من الأوكسيجين الضَّروريِ والموادِّ الحيَويّةِ التي يحتاجها. نتيجةً لذلك، تتأثَّر أنشِطَةُ الإنسانِ وحَركاتُه فَجأةً، بَيدَ أن أبرَزَها تأثُّرُ الوَظائفِ اللغوية، خاصةً حين تكون الإصابةُ في الجانبِ الأيسَرِ من الدِّماغ، وحينئذٍ يَفقِد المريضُ القُدرةَ على الكلام، أو القدرَةَ على الفَهم، أو أيّ نَوعٍ من الاضطرابات اللغوية، تلك الاضطِراباتُ التي يجمَعها مصطلحٌ عامٌّ يُعرَف بالحُبسَة aphasia","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"سكتة دماغية ","nonDiacriticsLemma":"سكتة دماغية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سَكْتَةٌ دِمَاغِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d5a7215f-332c-422d-ba02-0c1a0fa0b1fa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d5a7215f-332c-422d-ba02-0c1a0fa0b1fa","word":"اسْمٌ قَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e7a","lexicalEntryId":"d5a7215f-332c-422d-ba02-0c1a0fa0b1fa","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْمٌ قَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في نحو اللغاتِ الجِرمانية خاصةً، يُطلَق على الاسم الذي تَتغيَّر صوائتُه الداخليةُ عند تَصريفِه، مثلُ:foot, goose, child، التي تُجمَع على: feet, geese, children على التوالي، خلافا للاسم الذي يُجمَع بإضافَة لواحِقَ، مثل: book, car, tree، التي تجمَع على: books, cars, trees، على التوالي. وهو شَبيهٌ بجَمع التَّكسيرِ في العربية. راجع:  @(strong verb) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اسم قوي ","nonDiacriticsLemma":"اسم قوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْمٌ قَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

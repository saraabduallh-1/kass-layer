{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/50b8550c-d1fc-48f8-a356-9de96b63bcdc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"50b8550c-d1fc-48f8-a356-9de96b63bcdc","word":"عِلْمُ اللُّغَةِ الإحْصَائِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e75","lexicalEntryId":"50b8550c-d1fc-48f8-a356-9de96b63bcdc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ الإحْصَائِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللسانياتُ الإحصائية، وهي فَرعٌ من علم اللغة، تَقَع ضِمنَ علمِ اللغةِ الرياضيِّ mathematical linguistics، وتُعنى باستِخدام الأساليبِ الإحصائيةِ في دراسَة اللغة؛ لتَحديد السِّماتِ اللغويةِ الممَيِّزَةِ لمتحدِّثٍ أو كاتِب، أو لدراسةِ الأساليب، أو للوُصول إلى قوانينَ لغويةٍ عامَّة. يَهتم هذا العلمُ - في الغالب - بتَحليل تَكرارِ عناصِرَ لغويةٍ معيَّنة، وتَوزيعِ الوحداتِ اللغويةِ في النصوص، ومَعرفةِ نسبةِ اقتِرانِ عناصِرَ لغويةٍ بعناصِرَ أخرى، واستُعين به في لسانيّات المدوّنات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة الإحصائي ","nonDiacriticsLemma":"علم اللغة الإحصائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ الإحْصَائِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

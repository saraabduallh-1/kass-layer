{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9feec12f-20dd-41e1-8453-68adfca04231/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9feec12f-20dd-41e1-8453-68adfca04231","word":"الوَصْفُ التَّرْكِيبِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e6e","lexicalEntryId":"9feec12f-20dd-41e1-8453-68adfca04231","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الوَصْفُ التَّرْكِيبِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في النحو التحويليِّ، يَعني تَمثيلَ البِنيَةِ العَميقَةِ للجُملة، أي تمثيلَ مكوِّناتِ الجُملةِ بسِلسِلِةٍ من الرُّموز المقرونَةِ بأرقامٍ تبيِّن تَرتيبَها في التركيب قبلَ إجراء التَّحويل. فهو التَّحليلُ النِّهائيُّ لمكوِّنات الجُملةِ بالرَّسم الشَّجَرِيِّ أو بالتَقوِيس، الذي يُوَضِّح كُلًّا من البِناء التَّجريدِيِّ أو البِنيَةِ العَميقَةِ للجُملة، والتَّغَيُّراتِ التي تحدُث فيها بتَطبِيق قواعدِ التَّحويل. أمّا البِنيَةُ السَّطحيةُ، فيُمثِّلها التَّغييرُ التركيبيُّ structural change الذي يُبَيِّن ترتيبَ المكوِّناتِ الناتِجَ بعد التحويلِ، ويَصِف التركيبَ النحويَّ الذي سيكون مُدخَلا يَنطَبق عليه القانونُ التحويليُّ أو مُخرَجُ القانون.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الوصف التركيبي ","nonDiacriticsLemma":"الوصف التركيبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الوَصْفُ التَّرْكِيبِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0546c6c5-d834-4fa8-b9b0-34cffba4980d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0546c6c5-d834-4fa8-b9b0-34cffba4980d","word":"النَّحْوُ البِنْيَوِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e6f","lexicalEntryId":"0546c6c5-d834-4fa8-b9b0-34cffba4980d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوُ البِنْيَوِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ للقواعد التي تَلتَزِم بالنظرية البِنيَوِيَّة في وَصف تراكيبِ اللغة، أي تنطَلِق من علم اللغةِ البِنيَويِّ Structural Linguistics. وكان لهذه القواعدِ أهميةٌ في تعليم اللغاتِ الأجنبية، حيث تُحَلَّل قواعدُ اللغةِ الهَدَفِ إلى أنماطٍ لغويةٍ language patterns، وتُقارَن بالأنماط المقابِلَةِ لها في لغة المتعلِّمين الأمِّ، ثم يُرَكَّز في بناء المنهَجِ وإعدادِ الموادِّ التعليميةِ وأساليبِ التدريسِ على ما تَختَلِف فيه اللُّغَتان، وذلك حين كان المذهبُ السَّمعيُّ الشَّفَهِيُّ، المنبَثِقُ من المبادئ البِنيَوِيةِ السُّلوكية، هو المهَيمِن على برامِج تعليمِ اللغاتِ الأجنَبية. راجع:  @(Structuralism) و  @(Structural linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النحو البنيوي ","nonDiacriticsLemma":"النحو البنيوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّحْوُ البِنْيَوِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/47921863-521a-424c-b526-e192b5c20bde/get-public-entry"},"browse_index_record":{"lexicalEntryId":"47921863-521a-424c-b526-e192b5c20bde","word":"تَأْتَأَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e70","lexicalEntryId":"47921863-521a-424c-b526-e192b5c20bde","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَأْتَأَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُطلَق على عَيْبٍ في النُّطق يُعيق الطَّلاقَةَ اللغوية وانسِيابَ الكلام، ويحدُث لأسبابٍ نَفسيّةٍ في الغالب. ويَظهَر في التَّرَدُّد في النُّطق واضطِرابِ الكلام؛ فيُرَدِّد المصابُ به صَوتًا أو مَقطَعًا، أو يَمُدُّ الصوتَ أو المقطعَ مَدًّا زائدًا عن العادَة، مع صُعُوبَةٍ في تجاوُز هذا المقطَعِ إلى المقطَع الذي يليه. ويَظهَر أيضا في عَدَم قُدرَةِ المرءِ على مُواصَلَة الكلامِ، فيَقِف عند كلِّ كلمة. وله في العربية أسماءٌ مختَلِفة، منها: التَّهْتَهَة، والهَتْهَتَة، والفَأْفَأة، والرُّتَّة، واللَّجْلَجَة، إضافةً إلى التَّلَعثُم والتَّأْتَأْة، وقد يَرِد بمعنى التَّمْتَمَةِ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"تأتأة ","nonDiacriticsLemma":"تأتأة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَأْتَأَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/06919ab8-e9ef-437d-867e-14634bdb51eb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"06919ab8-e9ef-437d-867e-14634bdb51eb","word":"تَدْرِيبٌ ذُو مَعْنًى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9637","lexicalEntryId":"06919ab8-e9ef-437d-867e-14634bdb51eb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيبٌ ذُو مَعْنًى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ أنواعِ التدريباتِ اللغويةِ في تعليم اللغاتِ الأجنبية، وهو التدريبُ الذي يَفهَمه الطالبُ، ويَستَجيب له بأنشِطَةٍ تَعكِس هذا الفَهمَ. وهو أنواعٌ، منها: الرَّبطُ، ومَلءُ الفَراغات، وتدريبُ الاتصالِ communicative drill الذي يَتطلَّب من الطالب أن يُنتِج جُمَلًا من عنده. يُقابِلُه التدريبُ الآلِيُّ mechanical drill الذي يَتطلَّب استِجابَةً آليَّةً يُسَيطِر عليها المعلِّمُ سَيطرَةً تامَّة. راجع:  @(drill) و  @(mechanical drill) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريب ذو معنى ","nonDiacriticsLemma":"تدريب ذو معنى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيبٌ ذُو مَعْنًى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/60c49db0-88b7-43b0-b86f-c307764a4a43/get-public-entry"},"browse_index_record":{"lexicalEntryId":"60c49db0-88b7-43b0-b86f-c307764a4a43","word":"تَعَلُّمٌ ذُو مَعْنًى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9638","lexicalEntryId":"60c49db0-88b7-43b0-b86f-c307764a4a43","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعَلُّمٌ ذُو مَعْنًى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التعلُّمُ المفيدُ الذي يَفهَمه المتعلِّمُ فَهمًا حقيقيًّا حتى يكون جُزءًا من نظامه المعرِفي. ويُفَرِّق عالمُ النفسِ التربوي ديفيد أوزوبل David Ausubel بين التعلُّمِ ذي المعنى هذا والتعلُّمِ الحَرفيِّ rote learning، وغيرِه من أنواع التعلُّمِ التي لا تتكامَل مع خَلفية المتعلِّمِ ومعلوماتِه السابقة. ولهذا التعلُّمِ أهميةٌ في اكتساب اللغةِ، بيدَ أن له أهميَّةً خاصةً في صُفوف تعليمِ اللغات الثانيةِ والأجنبيةِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعلم ذو معنى ","nonDiacriticsLemma":"تعلم ذو معنى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعَلُّمٌ ذُو مَعْنًى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fd4acf00-fae7-4972-9ce0-5564365be7e8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fd4acf00-fae7-4972-9ce0-5564365be7e8","word":"نَظَرِيَّةُ المَوْسُومِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9643","lexicalEntryId":"fd4acf00-fae7-4972-9ce0-5564365be7e8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ المَوْسُومِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إحدى نظرياتِ القواعدِ الكُلِّيَّة، تقوم على تَصنيف قواعدِ اللغةِ إلى مجموعَتَين: قواعدُ غيرُ موسومَةٍ unmarked rules، وقواعدُ موسومَةٌ marked rules. فالمجموعةُ الأولى هي القواعدُ الأساسيةُ البسيطةُ الشائعةُ في معظَم لغاتِ العالَم، أما المجموعةُ الثانيةُ فهي القواعدُ الشَّاذَّةُ المعقَّدةُ النادِرُ وجودُها في اللغات. ويَعتَقِد تشومسكي وغيرُه من أتباع المذاهبِ المعرفيةِ الفِطريةِ أن المجموعةَ الأولى تُكتَسَب قبلَ المجموعَةِ الثانية، وأن الطفلَ يَكتَشِف المجموعَةَ الأولى فيَكتَسِبها بالفِطرَة، من غير حاجَةٍ إلى تعلُّمٍ ولا دَليلٍ يُثبِت له وجودَها في لغَته، خلافا للمجموعَة الثانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَسْم، وهو وُجودُ علامةٍ أو عَدَمُ وُجودِها للتَّميِيز بين صيغَتَين لغويَّتَين. فالمؤنثُ المنتهي بعلامَة تأنيثٍ في العربية مَوسومٌ في مقابِل المذكَّرِ منه غيرِ الموسوم، والمثنى والجَمعُ المنتَهيان بعلامَةٍ كلاهما مَوسومٌ في مُقابل المفرَدِ غيرِ الموسوم. ويرى النحويون أن غيابَ العلامةِ عن المذكَّر أو المفرَدِ هو وَسْمٌ أيضا. راجع:  @(marked ) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية الموسومية ","nonDiacriticsLemma":"نظرية الموسومية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ المَوْسُومِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d778cdfa-4b15-4abb-91d4-73438a2a8f08/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d778cdfa-4b15-4abb-91d4-73438a2a8f08","word":"الجُمْلَةُ الأَصْلُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9644","lexicalEntryId":"d778cdfa-4b15-4abb-91d4-73438a2a8f08","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الجُمْلَةُ الأَصْلُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جُملةٌ حاضِنَةٌ، أو جُملةٌ رئيسةٌ، تُضَمَّن فيها جُملةٌ أخرى كالجملة الموصولَة، وتُسمّى الجُملةُ الأخرى (المضَمَّنَةُ) جُملةً مَحضونةً constituent sentence.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الجملة الأصل ","nonDiacriticsLemma":"الجملة الأصل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الجُمْلَةُ الأَصْلُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/668abdaf-37e6-455a-a54f-3df0cf2deef4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"668abdaf-37e6-455a-a54f-3df0cf2deef4","word":"الذَّاكِرَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9645","lexicalEntryId":"668abdaf-37e6-455a-a54f-3df0cf2deef4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الذَّاكِرَةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"القُدرةُ الذِّهنيةُ على حِفظ المعلوماتِ وتَنظيمِها واستِظهارِها؛ لمدَّةٍ قَصيرَةٍ أو طَويلَة، ومساعَدَةِ المرءِ على الاستِجابَة للظروف الحاليَّةِ في ضَوء التَّجاربِ السابقَة. وهي نوعان رئيسان، كلاهما مُهمٌّ في اكتِساب اللغاتِ وتعلُّمِها، يضاف إليهما الذاكرَة الحسِّيَّةُ sensory memory التي لا تقوم بالمعالَجَة المعرِفيةِ للمَعلومات وإنما تَترُكها للذَّاكرَة قَصيرَةِ الأَمَد، وكذلك الذاكرَةُ العامِلَةُ working memory التي تحتَفِظ بكميَّةٍ من المعلومات تكون جاهزَةً لاستِعمال المعلوماتِ طوالَ الوَقتِ ومُعالجتِها حين وُصولها، والتي تُعَدُّ جُزءًا من الذاكرَة قصيرَةِ الأمَدِ أو مُرادِفَةً لها. فالأولى من النَّوعَين الرئيسَين هي الذاكرَةُ قصيرَةُ الأمَدِ short-term memory، التي تُعرف أيضا بالذاكرة الأوَّليَّةِ primary memory، وهي الذاكرَةُ التي تستَقبِل المعلوماتِ، وتحفَظُها مدَّةً قَصيرةً في أثناء تحليلِها وتفسيرِها، فإذا فُهِمَت المعلومَةُ انتَقَلت منها إلى الذاكرَة طويلَةِ الأمَدِ بواسِطَة الذاكرَةِ العامِلَة. أما الثانيةُ فهي الذاكرَةُ طويلةُ الأمَدِ long-term memory، وهي الذاكرَةُ التي تستَقِرُّ فيها المعلوماتُ بعد انتِقالها من الذاكرَة قَصيرَةِ الأمَد، بشَكلٍ غالبا ما يختَلِف عن الشَّكل الذي استُقبِلَت به، خاصةً بعد مُرورِ وَقتٍ طويلٍ من استِقبالها. يُضاف إلى تقسيماتِ الذاكرَة هذه تَقسيماتٌ أخرى؛ كالذاكرَة الإجرائيةِ procedural memory أو الضِّمنِيَّةِ implicit memory في مُقابِل الذاكرَةِ التَّصريحيَّةِ أو التَّقريرِيَّةِ declarative memory المعروفةِ أيضا بالذاكرَة الافتِراضِيَّةِ propositional memory. وعلى الرّغم من كثرَة الدراساتِ حولَ الذاكرَةِ وأنشِطَتِها ومهمّاتِها، فإن مُعالَجةَ المعلوماتِ وتخزينَها عمَلياتٌ  شديدةُ التَّعقيد، وما يزال كثيرٌ من العوامِل يَقِف في طريق البحثِ العلميِّ الهادِفِ إلى تحديد مَوضِعِ الذاكرَة ومكانِ كلِّ جُزءٍ أو نشاطٍ منها. ومن أبرَز هذه العوامِلِ طبيعةُ تركيبِ الدِّماغ وتَعقيدُه الشديد، وكثرَةُ أعصابِه، وتعدُّدُ مناطِقِه التي لم يُكتَشَف بعضُها حتى الآن. ويَبدو أن كثيرا من المعلومات والجوانبِ الخَفِيَّةِ من اكتساب اللغاتِ يَرتَبِط بهذا التَّعقيد. راجع:  @(long-term memory) و  @(working memory) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"الذاكرة ","nonDiacriticsLemma":"الذاكرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الذَّاكِرَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

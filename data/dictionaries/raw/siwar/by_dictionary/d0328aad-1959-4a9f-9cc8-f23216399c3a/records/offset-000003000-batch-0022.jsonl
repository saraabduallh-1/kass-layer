{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c5868ec8-4b0a-4605-9c5f-d15005a9096c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c5868ec8-4b0a-4605-9c5f-d15005a9096c","word":"مُفْرَدَاتُ تَرَفٍ زَائِدَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b963d","lexicalEntryId":"c5868ec8-4b0a-4605-9c5f-d15005a9096c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُفْرَدَاتُ تَرَفٍ زَائِدَةٌ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ في طرائق تدريسِ اللغات، استَعمَله كايلب گاتِينيو Caleb Gattegno، صاحِبُ الطريقةِ الصامِتَةِ The Silent Way في تعليم اللغاتِ الأجنبية، ويَعني به الكلماتِ التي تُستَخدَم لتَوصيل الأفكارِ الأكثَرِ تخصُّصًا كالآراء السياسيةِ والفَلسَفية. يَقارِن گاتِينيو هذه المفرَداتِ الزائدةِ بفِئَتَين من المفرَدات، إحداهما المفرَداتُ شِبهُ الزائدة، وهي المفرَداتُ شائعةُ الاستعمالِ في الحياة اليوميةِ لثقافة اللغةِ الهدَفِ؛ كمُفرَدات الأطعِمَةِ والملابسِ والسفرِ والحياةِ الأُسَرِية، والأخرى المفرَداتُ ذاتُ الصِّبغَةِ الوَظيفيةِ العاليَةِ المتعَدِّدَةِ الاستِعمال، التي ربما لا يوجَد لها مُقابِل مباشِرٌ من كلماتٍ في لغة المتعلِّمِ الأمِّ، وهي - في نظره - مفرَداتٌ وَظيفيةٌ تقدِّم مفتاحا لفَهم روحِ اللغة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مفردات ترف زائدة ","nonDiacriticsLemma":"مفردات ترف زائدة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُفْرَدَاتُ تَرَفٍ زَائِدَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c3d8cd68-1c5c-4313-89c2-6f24053b0bfd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c3d8cd68-1c5c-4313-89c2-6f24053b0bfd","word":"عِلْمُ اللُّغَةِ المُوَسَّعُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b963e","lexicalEntryId":"c3d8cd68-1c5c-4313-89c2-6f24053b0bfd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ المُوَسَّعُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مفهومٌ واسعٌ لعلم اللغةِ، يَعني دراسةَ اللغةِ دراسةً لا تقتَصِر على الناحية اللغويةِ النظرية، ولا على دراسة النِّظامِ اللغويِّ التركيبيِّ للُّغة، كما أنها لا تقتَصِر على لغةٍ معيَّنة، وإنما تَشمَل الدراسةَ اللغويةَ وكلَّ ما له علاقةٌ بها من النواحي الاجتماعيةِ والنفسيةِ والعَصَبيةِ والفسيولوجيةِ والحاسوبيةِ والتَّطبيقيةِ والتعليمية. هذا هو المفهومُ الحقيقيُّ الشاملُ لعلم اللغةِ؛ لأن هذا العلمَ لم يَعُد مَقصورا على دراسة اللغةِ دراسةً بِنيَويةً شَكلية، تلك الدراسةُ التي كانت سائدةً حتى نهايَة الخمسينياتِ من القرن العشرين، بل تَعدَّى ذلك إلى دراسة الجوانبِ المعرفيةِ الفِطريةِ للغة، بما في ذلك دراسةُ اكتسابِ اللغةِ وتعلُّمِها وتعليمِها، سواء أكانت لغةً أمًّا أم لغةً ثانيةً أو أجنبية، وكذلك دراسةُ اللغةِ دراسةً لغويةً حاسوبية. ويدخل ضِمنَ علمِ اللغةِ الموسَّعِ هذا علمُ اللغةِ التطبيقي، وعلمُ اللغةِ النفسي، وعلمُ اللغةِ العصَبي، وعلمُ اللغةِ الاجتماعي، وعلمُ اللغةِ العِرقِي ethno-linguistics، وعلمُ اللغةِ الأسلوبيُّ أو اللسانياتُ الأسلوبيةُ stylistics/stylo-linguistics، وتحليلُ الخِطاب. يقابِل هذا العلمَ علمُ اللغةِ المضَيَّقُ micro-linguistics، وهو العلمُ الذي تَقتَصر الدراسةُ فيه على بِنيَة اللغةِ وأنظمتِها الصوتيةِ والصرفيةِ والنحويةِ والدَّلالية، دون التَّطرُّقِ للأبعاد والجوانبِ النفسيةِ والاجتماعيةِ والعِرقِيةِ والأدبيةِ والأُسلوبيةِ والتِّقَنِيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَصفٌ يُطلِقه بعضُ اللغويِّين على الدراسَة اللغويةِ التي تعتَمِد على وَسائلَ أُخرَى غير لغوية؛ كالبَحث الإحصائيِّ، والبحثِ الحاسوبيِّ، والبحثِ في المدوَّناتِ اللغوية، ونحوِ ذلك. راجع:  @(micro-linguistics) و  @(macro-sociolinguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة الموسع ","nonDiacriticsLemma":"علم اللغة الموسع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ المُوَسَّعُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8e746fb4-2f95-4089-baaf-a3b745826f9e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8e746fb4-2f95-4089-baaf-a3b745826f9e","word":"تَعْلِيمٌ ثُنَائِيٌّ إبْقَائِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b963f","lexicalEntryId":"8e746fb4-2f95-4089-baaf-a3b745826f9e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْلِيمٌ ثُنَائِيٌّ إبْقَائِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَمَطٌ من التعليمِ الثُّنائيِّ اللغة، يَبدأ بتدريس الطفلِ بلغَته الأمِّ وحدَها، ثم يُحِلُّ محلَّها اللغةَ الهَدَفَ على نحوٍ تدريجيٍّ في بعض المقرَّرات، مع الإبقاء على اللغة الأمِّ لغةً للتدريس في مقرَّرات أخرى. هذا النَّمَطُ مُطبَّقٌ في بعض المدارسِ العالَمية، ومدارسِ الجالياتِ الأجنَبيةِ في بلَدٍ ناطِقٍ بغير لغاتِها، حيث يحتاج طلابُها إلى المحافَظَة على لغاتهم الأمِّ أو اللغاتِ الرَّسميةِ لبلادهم، أو اللغاتِ التي تُدرس بها العلوم. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم ثنائي إبقائي ","nonDiacriticsLemma":"تعليم ثنائي إبقائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْلِيمٌ ثُنَائِيٌّ إبْقَائِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

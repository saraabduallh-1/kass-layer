{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a4739898-e0d6-419e-a002-69467747672a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a4739898-e0d6-419e-a002-69467747672a","word":"اخْتِبارُ-ت المُقَارَنُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9635","lexicalEntryId":"a4739898-e0d6-419e-a002-69467747672a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِبارُ-ت المُقَارَنُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اختِبارٌ إحصائيٌّ يُستَخدَم لمقارَنة مجموعَتَين من الدَّرجات في موضوعٍ واحد. ويمكن استِخدامُ اختِبارِ (ت) لتَحديد ما إذا كانت درَجاتُ المشارِكين في الدراسة تختَلِف في ظِلِّ أوضاعٍ مختَلِفة. وفي تعليم اللغاتِ، يمكن استِخدامُ هذا الاختِبار، على سبيل المثال، لتَحديد ما إذا كان متعلِّمو اللغةِ الثانيةِ، الذين يَقرؤون قراءاتٍ مُوسَّعَةً خارِجَ المنهَجِ المقرَّرِ، أسَرَعَ في اكتِساب قواعدِ اللغةِ الهَدَفِ من الذي يَقتَصرون على الموادِّ التعليميةِ المقرَّرَةِ عليهم في المنهَج.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار-ت المقارن ","nonDiacriticsLemma":"اختبار-ت المقارن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِبارُ-ت المُقَارَنُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

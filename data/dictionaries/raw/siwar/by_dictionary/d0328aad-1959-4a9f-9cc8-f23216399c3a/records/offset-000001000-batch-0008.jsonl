{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/de3e4ff2-628d-44ad-81a1-633f45bae028/get-public-entry"},"browse_index_record":{"lexicalEntryId":"de3e4ff2-628d-44ad-81a1-633f45bae028","word":"اخْتِبَارٌ مَحَكِّيُّ المَرْجِع","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d02","lexicalEntryId":"de3e4ff2-628d-44ad-81a1-633f45bae028","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِبَارٌ مَحَكِّيُّ المَرْجِع","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اختبارٌ مَرجِعيُّ المحَكِّ، أو مَحَكِّيُّ المَرجِعِ، وهو الاختبارُ الذي يَقيس أداءَ الطالبِ وتُحَدَّد درَجَةُ نجاحِه فيه وفقَ مِعيارٍ ثابِتٍ من غير مقارَنةٍ بأداء زملائه أو باختبارٍ آخَر. وإذا رَسَب في هذا الاختبارِ عدَدٌ كبيرٌ من الطلاب فلا يُعاد النظَرُ في درَجةِ النجاح، وإنما يُعاد النظرُ في طريقَة التدريس، أو في أداء المعلِّم، أو في محتَوَى المقرَّرِ والمادَّةِ التعليمية، أو في الأهداف التعليمية. وهذا الاختبارُ هو الشائعُ في العالَم العربيّ، ومنه اختباراتُ التَّحصيلِ الشائعَةُ في التعليم العامّ. ويُقابِله الاختبارُ مِعيارِيُّ المرجِع norm referenced test. راجع:  @(criterion-referenced validity) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار محكي المرجع ","nonDiacriticsLemma":"اختبار محكي المرجع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِبَارٌ مَحَكِّيُّ المَرْجِع"}],"lemmaLanguage":{"
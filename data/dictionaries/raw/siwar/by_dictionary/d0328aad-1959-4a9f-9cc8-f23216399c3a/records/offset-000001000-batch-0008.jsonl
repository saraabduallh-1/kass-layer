{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/58353f52-e60a-4494-846f-3b5718951510/get-public-entry"},"browse_index_record":{"lexicalEntryId":"58353f52-e60a-4494-846f-3b5718951510","word":"تَعَاكُسُ وَظَائِفِ الدِّمَاغِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d06","lexicalEntryId":"58353f52-e60a-4494-846f-3b5718951510","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعَاكُسُ وَظَائِفِ الدِّمَاغِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مُصطلَحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُشير إلى التَّعاكُس الوَظيفِيِّ للدِّماغ، أي تعاكُس وَظائفِ الدِّماغ، وهو تحَكُّمُ نصفِ الدِّماغِ في الجانب المُعاكِسِ له من الجسم. فالنِّصفُ الأيسَرُ من الدِّماغ يتحَكُّم في حرَكَة الجانبِ الأيمَن من الجسم، والنِّصفُ الأيمَنُ من الدِّماغ يتحَكَّم في حَرَكات الجانبِ الأيسَرِ من الجسم. وهذا التَّعاكُسُ مرتَبِطٌ بتَقسيم وَظائفِ اللغةِ في قِشرَة الدِّماغ. وكان الناسُ منذ زمن بعيدٍ يستَدِلُّون على الشَّلَل الذي يحدُث في جانبٍ من الجسم على ما يحدُث في النِّصف المقابِل له في الدِّماغ، ثم أثبَتَت الدراساتُ التَّشريحيةُ صحَّةَ هذا الاستِدلال. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعاكس وظائف الدماغ ","nonDiacriticsLemma":"تعاكس وظائف الدماغ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعَاكُسُ وَظَائِفِ الدِّمَاغِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGe
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a2ed571a-0b34-44ca-ad06-917c0e46b1a6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a2ed571a-0b34-44ca-ad06-917c0e46b1a6","word":"اسْمُ غَيرِ الحَيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92f6","lexicalEntryId":"a2ed571a-0b34-44ca-ad06-917c0e46b1a6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْمُ غَيرِ الحَيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اسمٌ يدُلُّ على غيرِ حَيٍّ، أي يدُلُّ على نباتٍ أو جَماد، مثلُ: (قَلَم) و(ماء) و(تُراب) و(سيارَة)، خلافا لما يدُلُّ من الأسماء على مخلوقٍ حَيٍّ من إنسانٍ أو حيوانٍ أو طيرٍ أو سَمكٍ. وهذا التصنيفُ مُهمٌّ لأنه يحدِّد الأفعالَ والنُّعوتَ والضمائرَ التي يمكن أن تَرِد مع الاسم؛ فبعضُ الأفعالِ لا تصِحُّ إلا مع الأحياء، وبعضُ النعوتِ والضمائرِ خاصٌّ بالحَيِّ، وبعضُها خاصٌّ بالجَماد، مثلُ: elderly vs. antique، و who vs. which في الإنجليزية، وبعضُها مُشتَرَكٌ مثلُ: old. ولا يُقال في العربية: حَدَّثَتْني السيارةُ، إلا مجازًا؛ كأن يُقال: حدَّثَني الكِتابُ، وتحدَّثَت الصُّحُفُ، ونحو ذلك. راجع:  @(animate noun) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اسم غير الحي ","nonDiacriticsLemma":"اسم غير الحي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْمُ غَيرِ الحَيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2c6e2422-91b8-4e0d-abf9-78962013b536/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2c6e2422-91b8-4e0d-abf9-78962013b536","word":"التَّطْبِيقُ النَّاقِصُ للقَوَاعِدِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92f7","lexicalEntryId":"2c6e2422-91b8-4e0d-abf9-78962013b536","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّطْبِيقُ النَّاقِصُ للقَوَاعِدِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تحليلِ الأخطاءِ واللغةِ المرحَلية لمتعلِّمي اللغاتِ الأجنبية، يُشير إلى سبَبٍ من أسباب وقوعِ متعلِّمِ اللغةِ الأجنبيةِ في الخَطأ؛ حين يتعلَّم قاعِدةً ما في اللغة الهَدَفِ، ثم يُطبِّقُها تَطبيقا ناقِصا؛ كأن يَستَعمِل متعلِّمُ العربيةِ - مثلاً - جَمْعَ الكثرَةِ مكانَ جَمعِ القِلَّة، أو يَستَعمل الياءَ والنونَ لجَمع المذكرِ السالمِ في حالات الرَّفعِ والنَّصبِ والجَرِّ. وغالبا ما يحدُث هذا النوعُ من الخَطأ عندما يُضطرُّ المتعلِّمُ إلى استعمال اللغةِ الهَدَفِ في وَقتٍ مبكِّرٍ قبلَ أن يُتقِنها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التطبيق الناقص للقواعد ","nonDiacriticsLemma":"التطبيق الناقص للقواعد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّطْبِيقُ النَّاقِصُ للقَوَاعِدِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

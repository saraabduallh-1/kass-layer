{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bdb04922-e582-437f-a7cf-4f6f1643d800/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bdb04922-e582-437f-a7cf-4f6f1643d800","word":"عِلْمُ الأَصْوَاتِ السَّمْعِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89b1","lexicalEntryId":"bdb04922-e582-437f-a7cf-4f6f1643d800","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ الأَصْوَاتِ السَّمْعِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرعٌ من علم الأصواتِ يَهتَمّ بدراسة الإدراكِ السَّمعيِّ لأصوات الكلامِ بعد وُصُولِها إلى أذُن السامعِ وانتِقالِها عبرَ الأعصابِ السَّمعيةِ إلى مراكِز السَّمعِ، ثم إلى مراكِز الإدراكِ اللغويِّ في الدِّماغ. وهذا العلمُ أحدَثُ فَرعٍ في علم الأصوات، غير أنه أقَلُّها عِنايَةً من لدُن اللغويين البِنيَويِّين، لاسيَّما العربُ منهم؛ لاعتقادهم أن البحثَ فيه يَقَع خارِجَ نِطاقِ الدراسةِ اللغوية، وأنه يتطلَّب أدواتٍ لا تَتَوفر للُّغوي. وقد أصبَح الآنَ جُزءاً مُهمًّا من علوم اللغةِ بعد أن اهتَمّ اللغويون بدراسة اللغةِ دراسةً لغويةً نفسيةً معرفيةً عَصَبيةً، بَدَلا من الاقتِصار على دراسة جَوانِبِها النظريةِ الشَّكلية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم الأصوات السمعي ","nonDiacriticsLemma":"علم الأصوات السمعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ الأَصْوَاتِ السَّمْعِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/835c7fe6-34d1-439d-87d9-3b4b0576e71d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"835c7fe6-34d1-439d-87d9-3b4b0576e71d","word":"المَدْخَلُ السَّمْعِيُّ الشَّفَهِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89b2","lexicalEntryId":"835c7fe6-34d1-439d-87d9-3b4b0576e71d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَدْخَلُ السَّمْعِيُّ الشَّفَهِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَدخَلٌ أو مَذهبٌ في تدريس اللغاتِ الأجنبيةِ يركِّز على مَهارَتَيْ الاستِماعِ والكلام، ويتدَرَّج منهما إلى القراءة والكتابة، ويَهتَمُّ بتكوين العاداتِ اللغويةِ بتَكثِيف الاستِماعِ إلى القوالِب والأنماطِ الموجَّهَةِ تَوجِيها نحويا، كما يهتَم بالتدريبات الشَّكليةِ خاصَّةً تدريباتِ الأنماط. وقد انطَلَق هذا المذهبُ من مبادئ النظريتَين السُّلوكيةِ والبِنيَوِية، وانبَثَقَت منه بعضُ طرائقِ التدريسِ، أبرَزُها الطريقةُ السَّمعيةُ الشَّفَهية. راجع:  @(Audio-lingual Method) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المدخل السمعي الشفهي ","nonDiacriticsLemma":"المدخل السمعي الشفهي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَدْخَلُ السَّمْعِيُّ الشَّفَهِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b85640d-04f9-4021-b4b6-75cb2fe96bf9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b85640d-04f9-4021-b4b6-75cb2fe96bf9","word":"النَّحْوُ التَّطْبِيقِيُّ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89b3","lexicalEntryId":"9b85640d-04f9-4021-b4b6-75cb2fe96bf9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوُ التَّطْبِيقِيُّ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يَستَعمله بعضُ اللغويين التطبيقيين للإشارة إلى تعليم قواعدِ اللغةِ الهَدَفِ بطريقةٍ تَطبيقيةٍ بعيدةٍ عن التَّنظير، مع الاقتِصار على تدريس ما يَشِيع استعمالُه من هذه القواعد واستِبعاد ما عدا ذلك. والمصطلحُ بهذا المعنى قَريبٌ من مصطلَح النحوِ الوَظيفِيِّ functional grammar بالمعنى التطبيقيِّ التعليميِّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"نظريةٌ لغويةٌّ وَضَعها وطوَّرها اللغويُّ الأرمني الأمريكي سيباستيان شوميان Sebastian Shaumyan في اللغويات التوليديةِ في السبعينيات من القرن العشرين، آمِلا تَعميمَها على اللغات. تتألَّف النظريةُ من تشَكُّل قواعدِ الحالَة، حيث يتمُّ رَبطُ الأبنِيَةِ الدّلاليةِ العَميقَةِ بالأبنِية النحويةِ السَّطحيةِ من خلال تَطبيقِ العوامِلِ أو عناصِرِ التركيب.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النحو التطبيقي  ","nonDiacriticsLemma":"النحو التطبيقي ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1
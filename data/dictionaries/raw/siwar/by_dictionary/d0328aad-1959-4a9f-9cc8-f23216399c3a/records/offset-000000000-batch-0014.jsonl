{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/31422f72-b679-458d-9550-8d9203f042bd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"31422f72-b679-458d-9550-8d9203f042bd","word":"العُظَيْماتُ السَّمْعِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89b0","lexicalEntryId":"31422f72-b679-458d-9550-8d9203f042bd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"العُظَيْماتُ السَّمْعِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُشير إلى سِلسِلَةٍ من ثلاثة عُظَيماتٍ، أو عِظامٍ دَقيقةٍ، مترابِطَةٍ ومعَلَّقَةٍ في تجويف الأذُنِ الوُسطى، هي: عُظَيمُ المِطرَقَة، وعُظَيمُ السِّندان، وعُظَيمُ الرِّكاب، على التوالي. وهذه العُظَيْماتُ تَملأ فراغَ الأذُنِ الوُسطى الواقِعَ بين غِشاء الطَّبلَةِ وقَوْقَعَةِ الأذُنِ الداخلية، ووَظيفَتُها نَقلُ المَوجاتِ الصوتيةِ الوارِدَةِ من الخارِج عَبرَ الممَرِّ السَّمعيِّ وتَحويرُها تَكبيرا أو تَفخيما في شَكل اهتِزازات؛ لتُناسِب الأجهزةَ في الأذُن الداخليةِ التي تَستَقبِلها وتُرسِلها عَبرَ الأعصابِ السَّمعيَّةِ إلى المراكزِ السَّمعيةِ في الدِّماغ. راجع:  @(auditory nerve) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"العظيمات السمعية ","nonDiacriticsLemma":"العظيمات السمعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"العُظَيْماتُ السَّمْعِيَّةُ"}],"lemmaLanguage":{"code":"ar","
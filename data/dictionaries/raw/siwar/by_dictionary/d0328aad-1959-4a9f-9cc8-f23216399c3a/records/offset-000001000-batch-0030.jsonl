{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2bf02233-f9fd-49fd-9eb3-094a85d6787c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2bf02233-f9fd-49fd-9eb3-094a85d6787c","word":"لُغِةُ السُّودِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f2b","lexicalEntryId":"2bf02233-f9fd-49fd-9eb3-094a85d6787c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغِةُ السُّودِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اسمٌ أطلِق على الإنجليزية العامِّيَّةِ للأمريكيِّين الأفارِقَةِ في الولايات المتحدَةِ الأمريكيةِ (AAVE) في التِّسعينيّات من القَرن العِشرين، وهو مَنحُوتٌ من كلمَتَي: ebony و: phonics. بَرَز هذا الاسمُ أولَ الأمرِ في مجلِس التَّعليمِ في أوكلاند Oakland School Board بولايَة كاليفورنيا وسُجِّل رَسميًّا في نظامها التعليمي، لكن المجلسَ نفسَه سُرعان ما طلَب إلغاءَه؛ نتيجَةَ سُخرِيَةِ وَسائلِ الإعلامِ منه، وسُخرِيةِ كثيرٍ من الأمريكيِّين الأفارِقَةِ أيضًا، مع أن آخَرين تمسَّكوا به ومارَسوه في تواصُلِهم في بيئاتٍ تختَلِط فيها لغةُ السُّودِ مع الإنجليزية الأمريكيةِ المعيارِيَّة. راجع:  @(African American Vernacular English (AAVE)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة السود ","nonDiacriticsLemma":"لغة السود","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغِةُ السُّودِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedR
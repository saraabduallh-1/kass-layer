{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/21038a08-761d-4d34-9925-8959e29e5ec2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"21038a08-761d-4d34-9925-8959e29e5ec2","word":"إعْدَادُ المُعلِّمِينَ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f92","lexicalEntryId":"21038a08-761d-4d34-9925-8959e29e5ec2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إعْدَادُ المُعلِّمِينَ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تأهيلُ معلِّمي اللغاتِ الأجنَبيةِ وإعدادُهم إعدادًا لغويًّا وتربويًّا ومِهْنيًّا. غالبا ما يَتمُّ ذلك في دَوراتٍ أو برامِجَ تُقدَّم على هَيئة دبلوماتٍ مكثَّفَة، وبرامِجَ للماجستير أو الدكتوراه في علم اللغةِ التطبيقي، مع التركيز على طرائق التدريس، ومناهِجِ البَحثِ في تعليم اللغةِ وتعلُّمِها واكتِسابِها، وإعدادِ المناهِجِ والموادِّ التعليمية، وتَقنِياتِ تعليمِ اللغات، واختباراتِ اللغة، وقد يتضَمَّن البرنامجُ تدريبًا مَيدانيًّا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إعداد المعلمين ","nonDiacriticsLemma":"إعداد المعلمين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إعْدَادُ المُعلِّمِينَ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3461bf08-67a0-4caa-8d33-bfcd732063c6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3461bf08-67a0-4caa-8d33-bfcd732063c6","word":"عُسْرٌ القِراءةِ السَّطْحِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f93","lexicalEntryId":"3461bf08-67a0-4caa-8d33-bfcd732063c6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عُسْرٌ القِراءةِ السَّطْحِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُشير إلى أحَد نَوعَيْ عُسْرِ القراءةِ أو حُبسَةِ القراءة، الناتجَةِ عن إصابةِ منطقَةِ القراءةِ في الدِّماغ، وفقًا لتَقسيم هذا العُسْرِ بحسَب أنماطِ الأخطاءِ في القراءة، الذي يُقسِّمه إلى عُسرٍ قرائيٍّ سَطحِيٍّ، وعُسرٍ قرائيٍّ عَميقٍ deep alexia. ويحتَفِظ المصابُ بهذا العُسرِ السَّطحيِّ بالقُدرَة على التبوِيب الصوتيِّ للكلمات، لكنه لا يَستَطيع تميِيزَ المعنى الكُلِّيِّ للكلمة. فالمصابُ به يستَطيع نُطقَ الكلماتِ الزائفَةِ pseudoword، مثل كلمَتَيْ: (سَعْرَبَ) و(بَصْعَرَ)، ويجد صُعوبَةً في نُطق الكلماتِ الشّاذَّةِ والنادِرَة، ويُخطِئ في نُطق الكلماتِ المتَشابِهَةِ صَوتيًّا. راجع:  @(deep alexia) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عسر القراءة السطحي ","nonDiacriticsLemma":"عسر القراءة السطحي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عُسْرٌ القِراءةِ السَّطْحِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8dfdb70e-e9b7-4f37-a742-26b2426d9f21/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8dfdb70e-e9b7-4f37-a742-26b2426d9f21","word":"حُبْسَةٌ قِرائيَّةٌ سَطْحِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f94","lexicalEntryId":"8dfdb70e-e9b7-4f37-a742-26b2426d9f21","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حُبْسَةٌ قِرائيَّةٌ سَطْحِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُشير إلى ضَعفٍ في قُدرَة المرءِ على تَمييز الكلمةِ المكتوبَةِ من حيث كونُها كُتلَةً واحدة، ومحاوَلتِه معرفةَ العَلاقةِ بين حُروفها المكتوبَةِ وأصواتِها ليَتمَكَّن من نُطقها، وهذا مما يؤثِّر في فَهمه لمعناها الصحيح. وهي نَمَط من أنماط الحبسةِ القرائيةِ السَّطحية، وتختَلِف قليلًا عن عُسر القراءةِ المعروفِ بـ: alexia أو surface alexia، بأن الأخير ناتجٌ عن مشكلاتٍ في النُّمُو، خِلافًا للأولى التي غالبا ما تَنتُج عن إصابةٍ في الدِّماغ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حبسة قرائية سطحية ","nonDiacriticsLemma":"حبسة قرائية سطحية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حُبْسَةٌ قِرائيَّةٌ سَطْحِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c4ea5dad-5bad-4aea-bb09-3835ffa1c893/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c4ea5dad-5bad-4aea-bb09-3835ffa1c893","word":"طَرَائقُ مُمَرْكَزَةٌ حَوْلَ المُعَلِّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f8a","lexicalEntryId":"c4ea5dad-5bad-4aea-bb09-3835ffa1c893","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"طَرَائقُ مُمَرْكَزَةٌ حَوْلَ المُعَلِّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على أيِّ طريقَةٍ من طرائق تدريسِ اللغات تَنظُر إلى المعلِّم على أنه حَجَرُ الزَّاويةِ في العمَلية التعليمية، وتعتَمِد عليه اعتِمادًا كُلِّيًّا أو شِبهَ كُلِّيٍّ داخِلَ قاعةِ الدرس، مثلُ الطريقةِ السَّمعيةِ الشَّفهيةِ التي تتطلَّب من المعلِّم مهاراتٍ عاليَةً وتُلقِي عليه عِبئًا ثقيلًا، ولا تُتيح للمتعلِّم حرِّيةَ التعلُّمِ أو اختيارَ أسلوبِ التعلُّمِ الذي يناسبه، ومنها أيضا طريقةُ القواعدِ والترجَمة. خلافا لبعض الطرائقِ التي لا تعتَمِد على المعلِّم بقدر ما تعتَمِد على سَلامَة الموادِّ التعليميةِ ومناسَبَتِها للمتعلِّم، وتُتيح له فُرصًا كثيرةً للمشارَكة والاختِيار، فتقود إلى النُّمِوِّ اللغويِّ المرحَليِّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"طرائق ممركزة حول المعلم ","nonDiacriticsLemma":"طرائق ممركزة حول المعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"طَرَائق
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ef9a4357-fe1a-494c-ac22-c1bf7d8bb20a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ef9a4357-fe1a-494c-ac22-c1bf7d8bb20a","word":"تَعَلُّمٌ بالتَّجْرِبَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f8f","lexicalEntryId":"ef9a4357-fe1a-494c-ac22-c1bf7d8bb20a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعَلُّمٌ بالتَّجْرِبَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ من أساليب التعلِّم التي يُفضِّلها أو يَسلُكها متعلِّمو اللغاتِ الأجنبية، تتمثَّل في بناء المتعلِّمِ نماذِجَ وأساليبَ خاصَّةً به يُجرِّبها ويُمارِسها بطريقَته الخاصَّة، بحيث تتَّفِق مع طبيعته وقُدراتِه. أظهَرَت نتائجُ الدراساتِ المسحيةِ في هذا المجالِ أن لمتعلِّمي اللغاتِ أساليبَ أخرى، منها: الأسلوبُ البَصَرِيُّ visual learning، والأسلوبُ السَّمعِيُّ auditory learning، وأن اختيارَ المتعلِّمِ أسلوبا دونَ غيرِه يَرتَبِط بخلفيَّته الثقافيةِ والاجتِماعية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعلم بالتجربة ","nonDiacriticsLemma":"تعلم بالتجربة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعَلُّمٌ بالتَّجْرِبَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

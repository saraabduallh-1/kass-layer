{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ca074961-6ffb-4d77-9c84-477aa7b49780/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ca074961-6ffb-4d77-9c84-477aa7b49780","word":"تَعْلِيمٌ ثُنَائِيُّ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a44","lexicalEntryId":"ca074961-6ffb-4d77-9c84-477aa7b49780","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْلِيمٌ ثُنَائِيُّ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على أيِّ نظامٍ تعليميٍّ يُعطِي لغَتَين أهميةً مُتَساوِيةً في جميع البرامجِ التعليميةِ الرَّسميةِ والمقرَّراتِ الدراسيةِ في بَلَدٍ أو مؤسَّسَةٍ تعليمية؛ لتَسَاوِي اللغَتَين في القِيمَة الاجتِماعيةِ أو في الأهمية العِلمِية. وقد يُطلَق الوَصفُ على أيِّ درَجَةٍ من استِعمال اللغةِ الثانيةِ أو الأجنبيةِ في تدريس المقرَّراتِ الأكاديميةِ في المدارس، إذ تختَلِف البرامجُ ثُنائيةُ اللغةِ في نوع اللغةِ الثانيةِ ودرَجَةِ أهميَّتِها في التعليم من حيث تدريسُها في جميع المقرَّرات، أو في بعضها، وما إذا كانت لغةً رَسميةً أو لغةً ثانيةً أو أجنبية. راجع:  @(bilingual teaching) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم ثنائي اللغة ","nonDiacriticsLemma":"تعليم ثنائي اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْلِيمٌ ثُنَائِيُّ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGe
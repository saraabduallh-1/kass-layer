{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/977788d0-ed42-4751-a3cd-3b421b80e0ea/get-public-entry"},"browse_index_record":{"lexicalEntryId":"977788d0-ed42-4751-a3cd-3b421b80e0ea","word":"تَأثِيرُ مَغْطَسِ الحَمَّامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a49","lexicalEntryId":"977788d0-ed42-4751-a3cd-3b421b80e0ea","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَأثِيرُ مَغْطَسِ الحَمَّامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُشير إلى استراتيجيةٍ يَلجأ إليها المرءُ حين يُحاوِل تذكُّرَ كلمةٍ قد حَفِظَها في ذاكِرته، وهي على طَرَف لسانِه tip-of-the tongue، لكنه لا يستَطيع نُطقَها في الحال. وتُشير بعضُ الدراساتِ اللغويةِ النفسيةِ إلى أنه يَسهُل على المرء حينئذٍ تذكُّرُ بدايَةِ الكلمةِ ونِهايَتِها، كالسَّوابِق واللَّوَاحِق، في حين يَصعُب عليه تذَكُّرُ منتَصَفِها أو أصلِها، وأن تذَكُّرَ الجُزءِ الأولِ منها يُساعِده في البحث عنها في المعجَم أو في قوائم المفرَدات، فإذا وَصَل إلى الكلمات المشابِهَةِ لها في السَّوابِق استَعان حينئذٍ باللَّوَاحِق ليَقتَرِب منها ومن ثَم يَصِل إليها. وعبارَةُ: (تَأثِيرُ مَغطَسِ الحَمَّام) مُستَعارَةٌ من وَضع الإنسانِ جِسمَه في مَغطَس الحمّامِ حيث يَظهَر الجُزءان العُلوي والسُّفلي من جِسمه في حين يَبقى الجُزءُ الأوسَطُ منه مَغمُورا في الماء.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تأثير مغطس الحمام ","nonDiacriticsLemma":"تأثير مغطس الحمام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَأثِيرُ مَغْطَسِ الحَمَّامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f293a63e-51e3-466f-ab66-354388c1a9bd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f293a63e-51e3-466f-ab66-354388c1a9bd","word":"السُّلُوكِيُّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a4a","lexicalEntryId":"f293a63e-51e3-466f-ab66-354388c1a9bd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"السُّلُوكِيُّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على المدرسة السُّلوكيةِ Behavioral School ونَظرياتِها ومَذاهبِها في علم النفس، التي تُعنَى بدراسة السُّلوكِ الظاهِرِ للإنسان، الذي لا يختَلِف - في نَظَر أصحابِها - عن سُلوك الحيوان؛ إذ يمكن ملاحَظَتُه ورَصدُه، وإخضاعُه لقَوَانين المثِيرِ والاستِجابَةِ والتَّعزيز. وتَرَى هذه المدرسةُ أن التعلُّمَ لا يختَلِف عن اكتساب السُّلوكِ الآلِيِّ كالسِّباحَة ولعِبِ الكُرَةِ وقيادَةِ السيارة، وأن تعلُّمَ اللغةِ يَتِمُّ بهذه الآلِيَّةِ الشَّكلِية؛ إذ يعتَمِد على التقليد والتَّكرارِ والتعزيز. وقد طُبِّق هذا المبدأُ السُّلوكِيُّ في الطريقة السَّمعيةِ الشَّفَهيةِ لتعليم اللغاتِ الأجنبيةِ، التي تعتَمِد على الحِوارات المحفوظَةِ والتدريباتِ على القوالِب والأنماطِ اللغوية. راجع:  @(Behaviorist/Behavioral Theory) و  @(behavioral psychology) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"السلوكية ","nonDiacriticsLemma":"السلوكية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:0
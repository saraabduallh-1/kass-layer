{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3ef887a1-c636-4a7e-824b-fdbc63b4b437/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3ef887a1-c636-4a7e-824b-fdbc63b4b437","word":"اسْتِقْلالِيَّةُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a3f","lexicalEntryId":"3ef887a1-c636-4a7e-824b-fdbc63b4b437","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْتِقْلالِيَّةُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَظرَةٌ إلى اللغة الإنسانية، يمثِّلها الاتِّجاهُ المعرفيُّ الفِطرِيُّ الذي يتزعَّمه تشومسكي، إضافةً  إلى آخَرِين من أصحاب النظرةِ البَيُولُوجِيةِ للغة، ترى أن اللغةَ مَلَكَةٌ وقُدرَةٌ مستَقِلَّةٌ عن الملَكات والقُدراتِ الإدراكيةِ العامَّةِ لدى الإنسان، وأنها فِطرَةٌ مَغروسَةٌ فيه منذ وِلادَتِه. ويَستَدِل أصحابُ هذه النظرةِ على صِحَّتها بأن الطفلَ يَكتَسِب لغتَه الأمَّ من بيئته في مراحِل محدَّدَة، تَنتَهي في نهاية السنةِ الرابعةِ من عُمُره، دونَ حاجةٍ إلى تَعليمٍ أو تَدريبٍ أو تَصويبٍ للأخطاء، في حين يحتاج هذا الطفلُ إلى عَدَد من السِّنين، مع التعليم والتَّوجِيهِ والتَّدريب، ليتعلَّم ما يجب عليه فِعلُه وما يجب عليه تَركُه من سُلوك وعُلومٍ ومعارِف. يُقابِل هذه النظرةَ النظرةُ السُّلوكيةُ، مؤيَّدَةً بآراء آخَرِين كآراء جان بِياجِيه وغيرِه، التي ترى أن اللغةَ سُلوكٌ يكتَسِبه الطفلُ بالتَّدريب والمرانِ كما يكتَسِب العاداتِ السلوكيةَ الأخرى، ويحتاج إلى تعلُّمها كما يتعلَّم العلومَ والمعارفَ الأخرى، أي إنه يَعتَمِد على قُدراته العَقليةِ العامَّةِ في اكتساب اللغة، كما يَعتَمِد على هذه القُدراتِ في تعلِّم العُلومِ والمعارفِ والمهاراتِ البَدنِيَّة. والرأيُ الأوَّلُ هو السّائدُ لدى الغالِبيةِ العُظمى من اللغويين النَّفسِيِّين في المرحلة الرّاهِنة؛ لقوُّة أدلَّتِه العلميةِ والمنطِقية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"استقلالية اللغة ","nonDiacriticsLemma":"استقلالية اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْتِقْلالِيَّةُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dcca3ea0-19df-49b1-af27-421eeb08da9d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dcca3ea0-19df-49b1-af27-421eeb08da9d","word":"مُتَاحِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a40","lexicalEntryId":"dcca3ea0-19df-49b1-af27-421eeb08da9d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُتَاحِيَّةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وَصفٌ للكلمات المتاحَةِ للإنسان، التي تتَبادَر إلى ذِهنه أوّلا عندما يُطلَب منه الحديثُ في موضوعٍ ما. فعندما يُطلَب منه الحديثُ عن الشِّعر - مثلا - يَستَحضِر كلماتِ المدحِ والهجاءِ والغَزَلِ والوَصف، وعندما يُطلَب منه الحديثُ عن جِسمه يستَحضِر كلماتٍ مثل: (رِجْل) و(يَد) و(وَجه) و(عَيْن) و(أذُن) و(أنْف). والكلماتُ المتاحَةُ ليسَت شائعةً بالضرورَة، ولكنها مُهمّةٌ في تعليم اللغةِ كأهمية الكلماتِ الشائعة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"متاحية ","nonDiacriticsLemma":"متاحية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُتَاحِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ed48e429-8a68-4ade-bf07-b417eceb335e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ed48e429-8a68-4ade-bf07-b417eceb335e","word":"أُسْلُوبُ التَّحَاشِي","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a41","lexicalEntryId":"ed48e429-8a68-4ade-bf07-b417eceb335e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُسْلُوبُ التَّحَاشِي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُسمّى أيضاً لغةَ التَّحاشِي، يُشير إلى أسلوبٍ في الكلام يجب استعمالُه في بعض المجتَمَعاتِ حين يكون الحَديثُ في حَضرَة شخصٍ ما، أو الحديثُ عنه، محظورا بوَجهٍ عامٍّ، أو محظورا في أمورٍ معيَّنة. وهذا الأسلوبُ متَّبَعٌ في بعض اللغاتِ الأستراليةِ، حيث يجب تحاشِي عَدَدٍ كبيرٍ من الكلمات أو الاستِعاضة عنها بكلماتٍ أخرى، وذلك بحُضور بعضِ الأقارب، لاسيَّما أمُّ الزوجِ أو أمُّ الزوجَة؛ لأنهما ممن يتَحَاشَى الناسُ الحديثَ إليهما أو الحديثَ عنهما في أمورٍ قد تُسيء للعلاقَة بين الزوجَين، حتى إنَّ هذا الأسلوبَ يُسمّى لغةَ أمِّ الزوجِ أو لغةَ أمِّ الزوجةِ. راجع:  @(mother –in-law language) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أسلوب التحاشي ","nonDiacriticsLemma":"أسلوب التحاشي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُسْلُوبُ التَّحَاشِي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGenera
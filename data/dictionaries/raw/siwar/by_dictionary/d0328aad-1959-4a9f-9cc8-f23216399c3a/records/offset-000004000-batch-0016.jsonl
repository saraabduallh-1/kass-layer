{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/91b764d1-5070-46de-a110-65394dbcd625/get-public-entry"},"browse_index_record":{"lexicalEntryId":"91b764d1-5070-46de-a110-65394dbcd625","word":"فِقْهُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9999","lexicalEntryId":"91b764d1-5070-46de-a110-65394dbcd625","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فِقْهُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ يُطلَق على الدراسة التاريخيةِ للُّغَة، بما في ذلك الدراساتُ المقارَنَةُ للُّغات ودراسةُ النُّصوصِ الأدبيةِ والتاريخِ الثقافيِّ لمجتَمَعٍ ما، وقد يُطلَق على المرحَلة السابِقَةِ لعلم اللغةِ الحديثِ في أواخِر القرنِ التاسع عشرَ الميلادي. وكان بعضُ اللغويين يستَعمِلونه مُرادفًا لعلم اللغةِ linguistics لكنه لم يَعُد الآنَ مستَعمَلًا بهذا المفهوم. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ تقليديٌّ، يُطلَق على دراسَة النُّقُوشِ والكتاباتِ القديمةِ وفَكِّ رُموزِها وشَرحِها ومُقارَنَتِها ودراسةِ المخطوطاتِ القديمةِ وتَحقيقِها. لهذا يَرفضُ بعضُ اللغويين ترجَمةَ هذا المصطلَحِ إلى (فقه اللغة)، ويُصرّون على استعمال المصطلَحِ الأجنَبيِّ (فيلولوجيا)؛ مُعلِّلين ذلك بأن فقهَ اللغةِ في التُّراث العربيِّ هو علمُ اللغةِ بالمفهوم الحديث، وأن الفيلولوجيا لا تمثِّل إلا جانبًا واحدًا منه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فقه اللغة ","nonDiacriticsLemma":"فقه اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فِقْهُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cf9a86c5-ab9a-476e-be4f-5a0d313278d4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cf9a86c5-ab9a-476e-be4f-5a0d313278d4","word":"عِلْمُ وَظائِفِ الأَصْوَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b999a","lexicalEntryId":"cf9a86c5-ab9a-476e-be4f-5a0d313278d4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ وَظائِفِ الأَصْوَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرعٌ من علم اللغةِ، وأحَدُ الفَرعَيْن الرئيسَيْن للدراسات اللغويةِ الصَّوتيةِ، يُسمّى أيضا علمَ الأصواتِ الوَظيفي. يُعنَى بدراسة النظامِ الصوتيِّ للُغَةٍ معيَّنة، وبيانِ وَظائفِ الأصواتِ في التَّفرِقَة بين الوحدات اللغويةِ الأخرى كالكلمات، وذلك بتَصنيف الأصواتِ إلى وحداتٍ تَقابُليَّةٍ، كالفونيمات والمعالِمِ المميّزَة. يَرتَبِط هذا العلمُ، بعلمٍ آخَرَ شَقيقٍ له هو الفوناتيك phonetics، لما بينهما من عُمومٍ وخُصوصٍ، ولاسيَّما حين يَرِدان في سياقٍ واحد؛ إذ يصبح الثاني، حين يُقابَل بالأول، ذا مَدلولٍ ضيِّقٍ نِسبيًّا؛ فيُقصَد به دراسةُ الأصواتِ في اللغات عامّةً من حيث كَونُها أحداثًا مَنطوقةً بالفعل لها تأثيرٌ سَمعيٌّ دونَ النَظر في قِيَم هذه الأصواتِ ووَظائفِها أو معانيها في اللغة المعيَّنة، أي إنه يُعنَى بالمادة الصَّوتيةِ لا بالقوانين الصَّوتية. تختَلِف المدارسُ اللغويةُ الحديثةُ في ذلك؛ فمنها التي تُحَدِّد لَفظَ: phonology بدراسة العَمَليةِ الميكانيكيَّةِ للنُّطق، وتستَعمِل لفظَ: phonetics للدّلالة على ذلك الفَرعِ من علم اللغةِ التاريخيِّ باعتباره جُزءًا أساسيًّا من علم اللغة، خلافا لما تراه مدرسةُ براغ. وترى بعضُ المدارسِ عدَمَ التفريقِ بينهما خاصةً حين يَرِدان في سياقَين مختَلِفَين. في حين استَعمَل بعضُ اللغويين مصطلَحا آخَرَ للخُروج من هذا اللَّبْسِ هو: phonemics","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم وظائف الأصوات ","nonDiacriticsLemma":"علم وظائف الأصوات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ وَظائِفِ الأَصْوَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

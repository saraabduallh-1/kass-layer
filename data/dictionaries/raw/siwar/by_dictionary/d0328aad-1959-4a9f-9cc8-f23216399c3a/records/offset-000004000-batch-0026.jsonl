{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9261b858-b5ba-49ec-9707-cdc28b7b1dd2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9261b858-b5ba-49ec-9707-cdc28b7b1dd2","word":"تَعْلِيمٌ مُبَرْمَجٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a93","lexicalEntryId":"9261b858-b5ba-49ec-9707-cdc28b7b1dd2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْلِيمٌ مُبَرْمَجٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَنهَجٌ أو أسلوبٌ في التعليم، بما في ذلك تعليمُ اللغاتِ الأجنبيةِ، كانت مَوَادُّه تُقَدَّم للطلاب في كتُبٍ مُبَرمَجَة، ثم أصبَحَت تُقَدَّم في برامج حاسُوبية. وفي كلتا الحالَتَين تُعَدُّ موادُّ التَّعليم المبرمَج وتُصَمَّم دروسُه ثم تقَدَّم عناصِرُه في تَدَرُّج وتَسَلسُلٍ وتَتَابُع، ثم يَتَلقَّاها المتعلمون بطريقَةٍ مُبرمَجَةٍ برمَجَةً تِلقائيَّةً تَمنَح المتعلِّمَ فُرصَةً للتعلُّم الذّاتيِّ والسَّير في المقرَّر بحسب قدراتِه، ويَتَلقَّى في أثناء ذلك تَعزيزًا - إيجابيًّا أو سلبيًّا - كلَّما أجاب عن أسئلة الدَّرس أو التَّدريب، ولا ينتَقِل الطالبُ من وحدةٍ إلى وحدةٍ أخرى حتى يُتقِن الأولى. هذا الأسلوبُ الخَطِّيُّ المستَقيمُ linear program أحدُ نَوعَيْ التَّعليمِ المبرمَج، ويُقابِله النوعُ الآخَرُ وهو البرنامجُ المتفرِّعُ أو التَّفريعيُّ branching program، الذي يُقَدَّم فيه للطالب الضَّعيفِ مَوادّ تَعليميَّةٌ إضافيةٌ فَرعِيَّةٌ تُكمل ما يَنقُصه عن زملائه حتى إذا قَرُب من مستواهم عاد إلى البرنامَج الأصليّ. وقد يُجمَع بين النوعَيْن في منهَجٍ واحد. راجع:  @(linear program) و  @(branching program) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم مبرمج ","nonDiacriticsLemma":"تعليم مبرمج","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْلِيمٌ مُبَرْمَجٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e675e0ee-1246-473c-ad59-0d42313542f6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e675e0ee-1246-473c-ad59-0d42313542f6","word":"لُغَةُ البَرْمَجَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a94","lexicalEntryId":"e675e0ee-1246-473c-ad59-0d42313542f6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةُ البَرْمَجَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعةٌ مَحدودَةٌ مُتَكامِلَةٌ من الرُّموز والمفرَداتِ والتراكيبِ والقواعدِ، تُكتَب بها البرامِجُ لتَشغيل الحاسوبِ لأغراضٍ مختَلِفة. ففي نُظُم مُعالَجَةِ اللغةِ الطبيعيةِ، تُكتَب قواعدُ اللغةِ الهَدَفِ (الطبيعيةِ) بلغةٍ من لُغات البَرمَجَةِ التي تكون هي لغةَ التَّنفيذِ لبرنامَجِ تلك اللغةِ على الحاسوب. ولغةُ البَرمَجَةِ التي يَفهَمها الحاسوبُ مُباشرَةً هي اللغةُ الآليَّةُ machine code اللازِمَةُ لتَشغيل الجِهازِ ومُكوِّناتِه، وهذا يَتَطلَّب تَرجمةَ أيِّ لغةِ بَرمَجَةٍ أخرى إلى هذه اللغةِ بواسِطة بَرنامَجِ تَرجمةٍ مُتَخَصِّصٍ. راجع:  @(program) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة البرمجة ","nonDiacriticsLemma":"لغة البرمجة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةُ البَرْمَجَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

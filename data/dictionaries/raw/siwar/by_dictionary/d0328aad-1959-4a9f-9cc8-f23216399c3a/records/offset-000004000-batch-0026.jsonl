{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d6bae1ff-f402-4d2c-9e11-f97aad5b4840/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d6bae1ff-f402-4d2c-9e11-f97aad5b4840","word":"قَضِيَّةٌ إخْبَارِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a96","lexicalEntryId":"d6bae1ff-f402-4d2c-9e11-f97aad5b4840","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَضِيَّةٌ إخْبَارِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ فَلسَفيٌّ لغويٌّ دلاليٌّ، يُطلق على المعنى الأساسِ الذي تُعبِّر عنه الجُملةُ، ويمثِّل أحَدَ القسمَيْن الرئيسَيْن للجُملة في تركيبها العَميقِ بحسَب نحوِ الحالات، يؤدِّي فيه الفعلُ الوَظيفةَ الأساسَ بحيث تَرتَبِط به سائرُ المكوِّناتِ في اكتِساب دلالتِها. والقَضيةُ أو الجُملةُ الإخباريةُ مكوَّنة من: الحُجَّة argument، والخَبَرِprediction ، وقد تتألَّف الجُملةُ من أكثَر من قَضِيَّة. وفي نظرية الحَدَثِ الكَلاميِّ، يُمَيَّز بين معنى الجُملةِ الإخبارِيِّ propositional meaning وقُوَّتِه الحقيقيةِ في الاستِعمال. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قضية إخبارية ","nonDiacriticsLemma":"قضية إخبارية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَضِيَّةٌ إخْبَارِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8f6c68fa-433b-4e9c-9469-84ba99eea27d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8f6c68fa-433b-4e9c-9469-84ba99eea27d","word":"الكَرَاهِيَةُ اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b957f","lexicalEntryId":"8f6c68fa-433b-4e9c-9469-84ba99eea27d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الكَرَاهِيَةُ اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يَسَتعمِله بعضُ الباحثين في علم اللغةِ الاجتماعي، يُسمّى أيضا الرُّهابَ اللغويَّ، إشارَةً إلى نوعٍ من الكَراهِيَة للغريب من الناحية اللغوية؛ أي كراهِيَةِ بعضِ الناسِ للكلمات المستَحدَثَةِ في لغتهم، أو الدَّخيلَةِ عليها من لغاتٍ أخرى. شاعَت هذه الظاهرَةُ في بعض الدولِ الأوروبية، لاسيَّما في بريطانيا؛ نتيجةَ تدَفُّقِ الكلماتِ الأجنبيةِ من لغةٍ إلى أخرى؛ بسبَب الحروب، واختلافِ مَوازِين القُوى بين الدولِ الأوروبية، بل ظهَر لدى بعضِ الكُتَّابِ البريطانيِّين كُرْهٌ أو خَوفٌ من غَزو الكلماتِ والعباراتِ الإنجليزيةِ الأمريكيةِ للإنجليزية البريطانية، لاسيَّما الكلماتُ والعباراتُ التِّقنية؛ نتيجةَ التَّفَوُّقِ التِّقنيِّ للولايات المتحدةِ الأمريكية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الكراهية اللغوية ","nonDiacriticsLemma":"الكراهية اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الكَرَاهِيَةُ اللُّغَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0b1bc5a9-dd81-4813-8afe-cdf517668cf3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0b1bc5a9-dd81-4813-8afe-cdf517668cf3","word":"فَهْمُ المَسْمُوعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9580","lexicalEntryId":"0b1bc5a9-dd81-4813-8afe-cdf517668cf3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَهْمُ المَسْمُوعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عَمَليةُ فَهمِ الكلامِ المسموع، وهي إحدى المهاراتِ اللغويةِ الأربَعِ التي يجب أن يُلِمَّ بها متعلِّمُ اللغة، وهي فَهمُ المسموع، والمحادثةُ، والقراءةُ، والكتابة. تَهتَمُّ بعضُ طرائقِ التدريسِ بهذه المهارةِ اهتمامًا خاصًّا، كالطريقة السَّمعيةِ الشَّفَهيةِ التي تُرَكِّز عليها خاصةً في المراحِل الأولى من تعلُّم اللغة، لاسيَّما في نُطق الأصوات؛ لاعتقاد أصحابِها أن ذلك يَبني عاداتٍ لغويةً سَليمَة، ويُمَهِّد للكِفايَة اللغوية. أما طرائقُ التدريسِ الحديثةِ، فتَنظُر إلى فَهم المسموعِ نظرةً مختَلِفة؛ إذ تُرَكِّز على الجوانب المعرِفيةِ التواصُلية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فهم المسموع ","nonDiacriticsLemma":"فهم المسموع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَهْمُ المَسْمُوعِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c0413b94-f435-4310-9c46-7db3533bf353/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c0413b94-f435-4310-9c46-7db3533bf353","word":"لُغَةٌ دِينِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9581","lexicalEntryId":"c0413b94-f435-4310-9c46-7db3533bf353","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ دِينِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةُ العِبادَةِ والطُّقوسِ الدِّينِيَّةِ لجَماعَةٍ أو طائفَةٍ دِينِيَّة، تُستَعمَل في أثناء تَأديَةِ العباداتِ والطُّقوسِ الدِّينِيَّةِ، وغالبا ما تَقتَصِر على قراءة النُّصوصِ المقدَّسَةِ والأدعيَةِ الخاصَّة بالمناسَبات الدَّينية، دونَ أن تكون لُغةً للعِلم والتواصلِ في الحياة العامَّة، مثلُ السّريانِيَّةِ والسّومَرِيَّةِ واللاتِينِيَّةِ والقِبطِيَّةِ ولُغَةِ بالي في إندونيسيا، وليسَت بالضرورَة لغةً أمًّا أو لغةً أولى لأحَدٍ من أتباعها. وتُسمّى أيضا اللغةَ الطَّقْسِيَّة. راجع:  @(liturgical language) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة دينية ","nonDiacriticsLemma":"لغة دينية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ دِينِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

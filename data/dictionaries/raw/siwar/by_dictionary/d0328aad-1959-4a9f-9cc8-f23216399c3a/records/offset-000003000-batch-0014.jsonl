{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/00fbd795-fe15-4b74-881f-3bbe44112526/get-public-entry"},"browse_index_record":{"lexicalEntryId":"00fbd795-fe15-4b74-881f-3bbe44112526","word":"صَوْتٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b957d","lexicalEntryId":"00fbd795-fe15-4b74-881f-3bbe44112526","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَوْتٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الصوتُ الذي يُكَوِّن مع غيره من الأصوات كلماتٍ وجُملًا تُستَعمَل في تَوصيل الرِّسالةِ الكلامية. ويُفَرَّق بين هذا الصوتِ والصوتِ غيرِ اللغويِّ، وهو الذي يَحدُث من اهتِزاز أيِّ جِسمٍ ويَسير في مَوجاتٍ صوتية. والصوتُ البَشَرِيُّ اللغويُّ تَستَقبِله مناطِقُ اللغةِ في الدِّماغ، أما الصوتُ غيرُ البَشريِّ أو غيرُ اللغويِّ فتستَقبِله مناطقُ أخرى في الدِّماغ غيرُ لغوية، يَقَع مُعظَمُها في الجانب الأيمَنِ منه. ويدخُل ضِمنَ الأصواتِ غيرِ اللغويةِ أيُّ صَوتٍ بلُغَةٍ لا يَفهَمها السّامِعُ أو لا يتحدَّثها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صوت لغوي ","nonDiacriticsLemma":"صوت لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَوْتٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

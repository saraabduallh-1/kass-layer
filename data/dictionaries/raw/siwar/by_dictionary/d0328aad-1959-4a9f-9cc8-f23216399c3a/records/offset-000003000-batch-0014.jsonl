{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/54791c50-2ea2-466a-b7b5-f6c818a29fd4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"54791c50-2ea2-466a-b7b5-f6c818a29fd4","word":"الإثْنُوغْرَافيَا اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9578","lexicalEntryId":"54791c50-2ea2-466a-b7b5-f6c818a29fd4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإثْنُوغْرَافيَا اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَمَطٌ من الدراسات اللغويةِ الاجتِماعيةِ واللغويةِ التَّطبيقية، يَنطِلق من أن اللغةَ تؤثِّر في مجتَمَعها كما أن المجتَمعَ يؤثِّر في لغته، وأن دراسةَ اللغةِ في مجتَمَعها تقدِّم صورةً للحياة الاجتماعيةِ والثقافيةِ في هذا المجتَمَع، كما أن دراسةَ المجتَمَع تقدِّم صورةً طبيعيةً عن لغته. طُبِّقَت بعضُ نتائجِ دراساتِ الإثنوغرافيا اللغوية في ميادين مختَلِفة، منها: التعليمُ، والتفاعُلُ الصَّفِّيِّ classroom interaction، وتعليمُ اللغات، ونحوُ ذلك، كما أن نتائجَ الدراساتِ في هذه الميادينِ قد أَثْرَت الإثنوغرافيا اللغوية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإثنوغرافيا اللغوية ","nonDiacriticsLemma":"الإثنوغرافيا اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإثْنُوغْرَافيَا اللُّغَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7e9db918-f21f-4c6f-b058-43167c4e3611/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7e9db918-f21f-4c6f-b058-43167c4e3611","word":"الجُغْرَافِيَا اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9579","lexicalEntryId":"7e9db918-f21f-4c6f-b058-43167c4e3611","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الجُغْرَافِيَا اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من فروع علمِ اللغة، يُسمّى أيضا جُغرافيةَ اللَّهَجات، ويُعنَى بدراسةِ اللغاتِ الإقليميةِ أو اللَّهَجاتِ الإقليميةِ للُغةٍ ما، وتوزيعِها الجُغرافيِّ، وتحديدِ الفُروقِ بينها في الجوانب الصوتيةِ والصرفيةِ والنحويةِ والدّلالية. يُفَرِّق بعضُ اللغويين بين هذا العلمِ وبين علمِ اللغةِ الجُغرافيِّ geo-linguistics، بالنَّظَر إلى أن الأوّلَ لا علاقةَ له بتَوزيع اللغاتِ في العالَم، خلافًا لما يدُلُّ عليه المصطلَحُ الثاني.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الجغرافيا اللغوية ","nonDiacriticsLemma":"الجغرافيا اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الجُغْرَافِيَا اللُّغَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

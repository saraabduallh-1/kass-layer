{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/61d8d840-187d-4f47-9def-4bafe89c4ac7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"61d8d840-187d-4f47-9def-4bafe89c4ac7","word":"الوحْداتُ الإِشَارِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8db5","lexicalEntryId":"61d8d840-187d-4f47-9def-4bafe89c4ac7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الوحْداتُ الإِشَارِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعَةُ الكلماتِ والتَّعبيراتِ التي يَعتَمِد فَهمُ معناها على السِّياق الذي تَرِد فيه، ولا تُفهَم بمعزل عنه، والإشارِياتُ مفرَدُها إشارَةٌ deixis أو كلمةٌ إشارِيَّةٌ deictic word. والإشارِياتُ أحد الجوانبِ التي يَقوم عليها البحثُ التّدواليُّ، وهي أنواعٌ، أهمُّها: الإشارياتُ الشَّخصيةُ، والإشارياتُ الزَّمانيةُ، والإشارياتُ المكانيةُ، والإشارياتُ الاجتِماعيةُ، والإشارياتُ الخِطابية. راجع:  @(deictic (word)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الوحدات الإشارية ","nonDiacriticsLemma":"الوحدات الإشارية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الوحْداتُ الإِشَارِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/384acbcc-3bb1-4e9d-b2a0-9483f34553d8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"384acbcc-3bb1-4e9d-b2a0-9483f34553d8","word":"النَّظَرِيَّةُ الدَّلالِيَّةُ الإِشَارِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8db6","lexicalEntryId":"384acbcc-3bb1-4e9d-b2a0-9483f34553d8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّظَرِيَّةُ الدَّلالِيَّةُ الإِشَارِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ دلاليةٌ طوَّرَها أُوجْدن ورِيتشاردز C. K. Ogden and I. A. Richards,، في كتابهما The Meaning of Meaning، مَيَّزا فيها بين ثلاثةِ عناصِرَ مختَلِفةِ للمعنى، هي: الفِكرَةُ والمرجِعُ والمدلول، وبَيَّنا أنه لا توجَد علاقةٌ مباشرةٌ بين الكلمةِ بوَصفها رَمزا والشيءِ الخارِجيِّ الذي تُعبِّر عنه. والكلمةُ عندهما تَحوِي جُزأين هما: صِيغَةٌ مرتَبِطةٌ بوَظيفَتها الرَّمزية، ومحتَوًى مرتَبِطٌ بالفكرَة أو المرجِع. وتُسمى هذه النظريةُ أيضا بالنظرية المرجِعِيَّةِ referential theory.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظرية الدلالية الإشارية ","nonDiacriticsLemma":"النظرية الدلالية الإشارية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّظَرِيَّةُ الدَّلالِيَّةُ الإِشَارِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/38bd3c61-a8c7-4d47-892d-61c21ee9e8c2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"38bd3c61-a8c7-4d47-892d-61c21ee9e8c2","word":"مُتَغَيِّرٌ مُتَعَلِّقٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8db7","lexicalEntryId":"38bd3c61-a8c7-4d47-892d-61c21ee9e8c2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُتَغَيِّرٌ مُتَعَلِّقٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في البحث العلميِّ، يُشير إلى المتَغَيِّر غيرِ المستَقِلِّ الذي يتَأثَّر بسبَب متَغَيِّرٍ واحدٍ أو أكثَرَ من المتغيِّرات المستَقِلَّةِ independent variables في الدراسة العلمية. فإذا أراد الباحثُ في تعليم اللغاتِ، مثلا، معرِفةَ تَأثيرِ الاتِّجاهاتِ والميُول في الكِفايَة اللغويةِ لدى المتعلِّمِ فإن الكِفايَةَ اللغويةَ حينئذٍ هي المتغيِّرُ التابِعُ، أما الاتِّجاهاتُ والميُولُ فهي المتغيِّراتُ المستَقِلَّةُ. وفي الدراسات الإنسانيةِ، يَصعُب التأكُّدُ من أن العلاقةَ بين المتغيِّر التابِعِ والمتغيِّرِ المستَقِلِّ علاقةُ تَأثُّرٍ وتَأثِيرٍ. أما في الدراسات التجريبيةِ، فقد يكون المتغيّرُ المستَقِلُّ مؤثِّرا في المتغيِّر التابِعِ أو مؤشِّرا لتَوَقُّع ما يحدُث فيه. راجع:  @(independent variable) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"متغير متعلق ","nonDiacriticsLemma":"متغير متعلق","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails"
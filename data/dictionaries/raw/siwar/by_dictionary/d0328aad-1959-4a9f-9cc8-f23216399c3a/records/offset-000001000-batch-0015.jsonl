{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a9082d4e-b968-428d-826b-0c2ee9a2647c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a9082d4e-b968-428d-826b-0c2ee9a2647c","word":"صَدْمَةٌ ثَقَافِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8dc5","lexicalEntryId":"a9082d4e-b968-428d-826b-0c2ee9a2647c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَدْمَةٌ ثَقَافِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مرحَلةٌ من مراحِل تعلُّمِ اللغةِ الثانيةِ في بيئتها، يُصاب فيها المتعلِّمُ بصَدمَةٍ ثقافيةٍ تَعقُب مرحَلةَ الانبِهارِ الثقافيِّ، وتَسبِق مرحَلةَ الإفاقَةِ من الصَّدمَة. وتَحدُث الصَّدمَةُ الثقافيةُ عندما يَفقِد المتعلِّمُ ذاتَه ووِجهَتَه في مجتَمَعِ اللغةِ الهَدَف، ويَشعُر بالقَلَق والخَوف، ونحوِ ذلك من العوامِل النفسيةِ والاجتماعية التي تَحدُث بسبب الفُروقِ الاجتِماعيةِ والفَواصِلِ بين ثقافَةِ المتعلِّمِ وبيئةِ اللغةِ الهَدَف. وقد تحدُث الصَّدمةُ الثقافيةُ بطريقةٍ عَكسِية، وذلك حين يَعود المتعلِّمُ بعد مدَّةٍ طَويلَةٍ من بلَدٍ متقدِّمٍ في جميع مجالاتِ الحياةِ إلى بلده الأصليِّ المتخَلِّف، فيَصعُب عليه التَّكيُّفُ مرَّةً أخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صدمة ثقافية ","nonDiacriticsLemma":"صدمة ثقافية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَدْمَةٌ ثَقَافِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

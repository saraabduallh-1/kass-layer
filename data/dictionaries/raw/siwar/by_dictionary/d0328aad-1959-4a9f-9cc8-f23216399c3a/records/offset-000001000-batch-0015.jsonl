{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/94bfa596-200a-4987-a22f-f8d7d80c9d20/get-public-entry"},"browse_index_record":{"lexicalEntryId":"94bfa596-200a-4987-a22f-f8d7d80c9d20","word":"التَّقارُبُ اللَّهَجِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8dbe","lexicalEntryId":"94bfa596-200a-4987-a22f-f8d7d80c9d20","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّقارُبُ اللَّهَجِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتِماعِيٌّ، يُسمى أيضا التَّجمُّعَ اللَّهَجِيَّ، وهو توَجُّهُ اللَّهَجاتِ الجُغرافيةِ للُّغة الواحدةِ نحوَ التَّقارُبِ أو التوَحُّد؛ نتيجةَ عوامِلِ جَذبٍ مركَزية، تتمثَّل في مركَز الحُكمِ، أو سُهُولَةِ وَسائلِ الاتصالِ والانتِقالِ، أو انتِشارِ التعليمِ، أو تَنامِي الشُّعورِ القَوميِّ، أو قوَّةِ التقاليدِ. ويُقابِل ذلك الانقِسامُ اللَّهَجِيُّ dialectalization، وهو تَوَجُّهُ اللغةِ نحوَ الانقِسام إلى لَهَجات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التقارب اللهجي ","nonDiacriticsLemma":"التقارب اللهجي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّقارُبُ اللَّهَجِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

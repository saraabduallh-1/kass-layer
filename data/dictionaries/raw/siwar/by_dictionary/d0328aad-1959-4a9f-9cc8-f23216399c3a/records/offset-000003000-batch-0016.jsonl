{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8446cc0b-3012-486a-abb7-994c4d43ddb1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8446cc0b-3012-486a-abb7-994c4d43ddb1","word":"مُسَاوَاةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95a2","lexicalEntryId":"8446cc0b-3012-486a-abb7-994c4d43ddb1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُسَاوَاةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَساوِي اللغاتِ في نَظَر اللغويِّ؛ فلا تتَمَيَّزُ لغةٌ أو مجموعةٌ من اللغات عن غيرها من حيث الرُّقِيُّ أو القُدرَةُ التَّعبيرِيةُ. هذه المساواةُ هي أحد الأسسِ التي اعتَمَد عليها علمُ اللغةِ الحديثِ منذ نَشأتِه في نهايَة القرنِ التاسعَ عشر، خاصةً لدى البِنيوِيّين الوَصفيّين. لكنّ الواقِعَ يُثبِت تفاوُتَ اللغاتِ بسبَب تفاوُتِ الناطقين بها والثقافَةِ التي تَحمِلها كلُّ لغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مساواة لغوية ","nonDiacriticsLemma":"مساواة لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُسَاوَاةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/52b1ddce-d0b2-4833-929f-c9139dbd51bd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"52b1ddce-d0b2-4833-929f-c9139dbd51bd","word":"أَسَاطِيرُ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95a3","lexicalEntryId":"52b1ddce-d0b2-4833-929f-c9139dbd51bd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَسَاطِيرُ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعةٌ من الآراءِ والتَّصوُّراتِ الخاطِئةِ عن اللغات، يتَناقَلُها الناسُ في أزمِنَةٍ وأمكِنَةٍ مختَلِفَة، لا تَسندها أدِلَّةٌ عِلميةٌ أو تاريخية؛ كالقَول بأن هناك لغاتٍ أسمى من لغاتٍ أخرى، وكالقَول بأن لغاتِ الشُّعوبِ البدائيةِ لا تُسعِف الناطقين بها في التَّعبير عما يريدونه، أو أن لغاتٍ أقدَرُ من لغاتٍ أخرى على التَّعبير، أو نحوِ ذلك. صَحيحٌ أن اللغةَ قد ترقَى وتَسود لُغاتٍ أخرى، وقد تَفوقها في التَّعبير، لكن ذلك ليس نتيجَةَ طبيعَتِها التركيبية، ولكن بسبَب ما تحمِله من ثقافةٍ وفِكرٍ وأدَب، وما يتمتَّع الناطقون بها من تفَوُّقٍ عِلميٍّ أو سياسيٍّ أو اقتِصاديّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أساطير لغوية ","nonDiacriticsLemma":"أساطير لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَسَاطِيرُ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/00a86514-dab8-45a3-beff-2c86168d9031/get-public-entry"},"browse_index_record":{"lexicalEntryId":"00a86514-dab8-45a3-beff-2c86168d9031","word":"عِلْمُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95a4","lexicalEntryId":"00a86514-dab8-45a3-beff-2c86168d9031","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"العلمُ الذي يُعنَى بدراسةُ اللغةِ الإنسانيةِ دراسةً علميةً موضوعيةً تَعتَمِد على الوَصف والتحليل، وتَشمَل جميعَ جوانبِ اللغة، الصوتيةِ والصرفيةِ والنحويةِ والدّلاليةِ والأسلوبيةِ والتَّداوِليةِ والثقافيةِ، والبحثَ في أساليبِ اكتسابِها واستعمالِها، وطرائقِ تعلُّمِها وتعليمِها. تُرجِم هذا المصطلحُ في العربية إلى مصطلحاتٍ منها: اللسانياتُ، والألسُنِيَّةُ، واللغوياتُ، وعلمُ اللغة. يُقسَّم علمُ اللغةِ إلى فرعَين رئيسَين، هما: علمُ اللغةِ العامِّ general linguistics، أو علمُ اللغةِ النظَرِيُّ theoretical linguistics، وعلمُ اللغةِ التطبيقيُّ applied linguistics. ولكلِّ فَرعٍ منهما أفرُعٌ كثيرة، وقد يَتداخَل بعضُ هذه الأفرُعِ مع بعض، ويَصعُب الفَصلُ بينها، أي يَصعُب الفَصلُ بين الأفرُعِ التابعَةِ لما هو نَظَرِيٌّ عامٌّ أو تطبيقيٌّ، خاصةً علمَ اللغةِ الاجتماعيِّ، وعلمَ اللغةِ النفسيِّ، وعلمِ صناعَةِ المعجَمِ. ومصطلحُ علمِ اللغةِ أو اللغوياتُ أو اللِّسانيّاتُ غالبا ما يُطلَق على الدراسات اللغويةِ الحديثةِ التي ظهَرَت في أوروبا في نهايَة القرنِ التاسع عشر وبدايَةِ القرنِ العشرين، وسَلَكَت منهَجا يختَلِف عن المناهج التقليديةِ السائدةِ في أوروبا في تلك الحِقْبَة. وقد تعَدَّدَت مدارِسُه ومناهِجُه في النظَر إلى طبيعة اللغةِ، وإلى أساليب دراستِها، وتأثَّرَت تلك المدارسُ والمناهجُ بعلومٍ أخرى؛ كعلم النفسِ، وعلمِ الاجتماعِ، وعلمِ الإنسانِ (الأنثروبولوجيا)، وعلمِ المعلوماتِ، والرياضياتِ وعلومِ الحاسِبِ وغيرِها. راجع:  @(theoretical linguistics) و  @(general linguistics) و  @(applied linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة ","nonDiacriticsLemma":"علم اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/caffc3ab-eefb-425b-9af2-46b3c363bf2d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"caffc3ab-eefb-425b-9af2-46b3c363bf2d","word":"قِرَاءَةُ الشَّفَتيْن","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95a5","lexicalEntryId":"caffc3ab-eefb-425b-9af2-46b3c363bf2d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قِرَاءَةُ الشَّفَتيْن","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلَحٌ في لغَة الإشارَةِ للصُّمِّ، يُشير إلى إحدى طرائقِ التواصُلِ بين فئةِ الصُّمِّ وغيرِهم ممن يتواصَلون معهم بلُغَة الإشارَة من مُعلِّمين ومُتَرجِمين. وتَعني مُراقَبةَ الأصَمِّ لحرَكات الشَّفتيْن ومخارِجِ الأصواتِ من فَمِ المتكلِّمِ وأسنانِه وحَلْقِه وعَضَلاتِ وَجهِه؛ لفَهم الكلامِ المنطوق. وقد يَستَعمِلها غيرُ الأصَمِّ لمتابَعَة برنامجٍ تِلفازيٍّ يخفَى فيه صَوتُ المتحدِّث.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قراءة الشفتين ","nonDiacriticsLemma":"قراءة الشفتين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قِرَاءَةُ الشَّفَتيْن"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

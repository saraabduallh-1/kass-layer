{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/53c6dc74-1533-41f7-9631-878dc4c5c732/get-public-entry"},"browse_index_record":{"lexicalEntryId":"53c6dc74-1533-41f7-9631-878dc4c5c732","word":"مُعَامِلُ مَعْرِفَةِ القِرَاءَةِ والكِتَابَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95a7","lexicalEntryId":"53c6dc74-1533-41f7-9631-878dc4c5c732","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعَامِلُ مَعْرِفَةِ القِرَاءَةِ والكِتَابَةِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ إحصائيٌّ يُستَخدَم في دراسات علم اللغةِ الاجتِماعيِّ وعلمِ اللغةِ الجُغرافي، ويُشير إلى أداةٍ إحصائية تُستَخدَم لتَوضيح مجالاتِ اللغةِ المكتوبة، وتُستَخدَم بالنسبة إلى كلِّ لغةٍ على حِدَة، على أساسٍ مئويٍّ يُبَيِّن نسبةَ المتكَلِّمينَ باللغة الذين يعرِفون القراءةَ والكتابَة، الذين يُمكِنهم الاتصال بالصِّيغَةِ المكتوبَة. راجع:  @(literacy) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معامل معرفة القراءة والكتابة ","nonDiacriticsLemma":"معامل معرفة القراءة والكتابة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعَامِلُ مَعْرِفَةِ القِرَاءَةِ والكِتَابَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a9046f41-3e23-4193-9f43-088031478ddd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a9046f41-3e23-4193-9f43-088031478ddd","word":"فَجْوَةٌ مُعْجَمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95a8","lexicalEntryId":"a9046f41-3e23-4193-9f43-088031478ddd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَجْوَةٌ مُعْجَمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عَدَمُ وُجودِ كلمةٍ مُفردَةٍ محدَّدَةٍ في لغةٍ ما للدّلالة على شيءٍ معيَّن؛ فيُضطَرُّ أهلُ اللغة إلى استعمال عبارَةٍ أو جُملةٍ لوَصف هذا الشيءِ أو التَّعبيرِ عنه. مثالُ ذلك عَدَمُ وُجودِ اسمٍ في الإنجليزية يَشمَل البقَرَةَ cow والثَّوْرَ bull، خِلافا لكلمةِ: horse التي تَشمَل الحِصانَ stallion والفَرَسَ mare. وقد تكون الفَجوَةُ في لغةٍ ما، لكن لا يَشعُر بها الناطقون بتلك اللغة؛ كعَدَم التَّفريقِ بين عَمٍّ وعَمَّةٍ وبين خَالٍ وخَالَةٍ في الإنجليزية، وعَدَمِ وُجودِ ضَمائرَ في الإنجليزية كما هي في لغاتٍ أخرى كالعربية. وتُمَثِّل هذه الفَجوَةُ مُشكلاتٍ لمتعلِّمي اللغاتِ الأجنبيةِ حين يُفاجَؤون بكلماتٍ في اللغة الهَدَفِ لا مُقابِل لها في لغَتهم الأمِّ؛ فيَصعُب عليهم حينئذٍ تَصوُّرُ معناها، أو لا يجدون في اللغة الهَدَفِ مفرَدةً مقابِلةً لمفرَدَةٍ شائعةِ الاستعمالِ في لغَتهم الأمّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فجوة معجمية ","nonDiacriticsLemma":"فجوة معجمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَجْوَةٌ مُعْجَمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/28a521d8-6f39-4236-8d00-167ee17897f8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"28a521d8-6f39-4236-8d00-167ee17897f8","word":"تَعْجِيمٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95a9","lexicalEntryId":"28a521d8-6f39-4236-8d00-167ee17897f8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْجِيمٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"التَّعبيرُ عن المعنى أو المعاني باستعمال مفرَدَةٍ أو مفرَداتٍ معجَميةٍ معيَّنة، بإحدى الوَسائلِ اللغويةِ المعروفة، كالاشتِقاقِ والنَّحتِ والاقتِراضِ والدَّمجِ أو التركيبِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"التَّفريقُ أو التَّميِيزُ بين شيئَين تميِيزًا وَظيفيًّا باستعمال كلمَتَين مختَلفِتَين. والمفرَداتُ التي يُميَّز فيها بين أسماءِ الحيواناتِ وأسماءِ لحومِها تُسمّى مُعجَّمَةً lexicalized. فاسمُ الخِنزيرِ في الإنجليزية: pig، أما لَحمُه فهو: pork، واسمُ الغَزالِ فيها: deer، أما لَحمُه فهو: venison ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"تحويلُ الكلمةِ الوَظيفيةِ إلى كلمةٍ مُعجَمية، وذلك حين تتَضاءل القِيمَةُ أو الوَظيفةُ النحويةُ للعنصُر النحويِّ تدريجيًّا حتى يتحَوَّل إلى عنصُرٍ معجَميٍّ أو شَبيهٍ بعنصُر معجَمي. ويُسمى هذا أيضا بنَقصُ النحويةِ degrammaticalization، ويُقابِله الانتِحاءُ أو القَعْوَدَة. راجع:  @(grammaticalization) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"تعجيم ","nonDiacriticsLemma":"تعجيم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْجِيمٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

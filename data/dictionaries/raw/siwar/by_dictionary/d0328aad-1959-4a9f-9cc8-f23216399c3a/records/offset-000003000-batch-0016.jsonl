{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5b048137-d548-435d-9d50-aa09b7ebc045/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5b048137-d548-435d-9d50-aa09b7ebc045","word":"مجْمَعٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95a0","lexicalEntryId":"5b048137-d548-435d-9d50-aa09b7ebc045","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مجْمَعٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعَةٌ من علماء اللغةِ يجتَمِعون اجتماعاتٍ دَورِيةً مُنتَظِمةً؛ لبحث مسائلَ لغويةٍ مختَلِفة، والتوصُّلِ إلى قراراتٍ أو تَوصِياتٍ بشأنها. وقد يَشتَرِك معهم علماءُ من تخصُّصات غيرِ لغويةٍ مرتَبِطةٍ بعُلوم اللغة، خاصةً حين يَرتَبِط الأمرُ بالترجَمة ووَضعِ المصطَلَحاتِ في العُلوم المختَلِفة. ومن أمثِلَتها الحَلقةُ اللغويةُ في كوبِنهاجِن Linguistic Circle of Copenhagen Cercle) (Linguistique de Copenhagen التي قادها لويس هيالمسليف Louis Hjelmslev (1899-1965م)، وحَلقةُ براغ اللغوية Linguistic Circle of Prague أو مدرسةُ براغ Prague School، التي كان من أبرَز مؤسسيها رومان ياكبسون Roman Jakobson. وقد يَشمَل المصطلحُ أيضا جميعَ المدارسِ والمذاهبِ اللغويةِ عبرَ العُصورِ، والمجامِعَ اللغويةَ العربيةَ المعاصرةَ كالتي في مِصرَ وسوريا والأردن والعراق، وإن كانت المجامِعُ العربيةُ مَعنيّةً باللغة العربيةِ فقط. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مجمع لغوي ","nonDiacriticsLemma":"مجمع لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مجْمَعٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

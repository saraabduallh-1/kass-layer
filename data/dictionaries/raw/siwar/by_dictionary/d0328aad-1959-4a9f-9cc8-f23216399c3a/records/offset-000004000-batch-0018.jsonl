{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6eb0aae7-202c-4c73-8f86-18d2583f1e94/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6eb0aae7-202c-4c73-8f86-18d2583f1e94","word":"مُرُونَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99d4","lexicalEntryId":"6eb0aae7-202c-4c73-8f86-18d2583f1e94","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُرُونَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُقصَد به لُيُونةُ أنسِجَةِ الدِّماغِ لُيُونةً تُكسِبها القُدرَةَ على اكتساب اللغةِ الأمِّ واللغاتِ الثانيةِ والأجنَبية. يرى بعضُ اللغويين النَّفسيِّين أن هذه اللُّيُونةَ تَقتَصِر على مرحَلة الطُّفُولةِ مع اختِلافٍ في تحديد نِهايتِها، ثم تبدأ أنسِجةُ الدِّماغِ في التَّصَلُّب حتى تَتَوَقَّف في مرحَلةٍ عُمريةٍ مُعيَّنة؛ فيَصعُب حينئذٍ اكتسابُ اللغاتِ اكتسابًا طبيعيًّا. غير أن لغويِّين آخَرِين لا يؤيِّدون هذا الرأيَ، ولا يَعتَمِدون عليه في تفسيرهم لاكتساب اللغةِ الثانية، بل يَرَون أن اكتسابَها تؤثِّر فيه عوامِلُ متعَدِّدةٌ، وأنّ عُمرَ المتعلِّمِ يُؤثِّر في هذا الاكتساب تأثيرًا غيرَ مُباشِر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"مرونة ","nonDiacriticsLemma":"مرونة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُرُونَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v
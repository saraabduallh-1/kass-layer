{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b426e8be-7597-4c1d-ba00-cc65ee953bbc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b426e8be-7597-4c1d-ba00-cc65ee953bbc","word":"لُغَةٌ مَرْكَزِيَّةٌ جَامِعَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99d5","lexicalEntryId":"b426e8be-7597-4c1d-ba00-cc65ee953bbc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مَرْكَزِيَّةٌ جَامِعَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ لأيِّ لغَةٍ رَسميةٍ لعَدَدٍ من الدوَل، يُعتَمَد عليها في وَضع المعاجِمَ والقواعدِ لهذه اللغةِ، وإن تنوَّعَت استِعمالاتُها في كل دولَة. فالعربيةُ مثلا لغةٌ مركَزيّةٌ جامِعَةٌ في الأقطار العربيةِ في كلٍّ من الشَرق الأوسَطِ وشمالِ أفريقيا، والإنجليزيةُ لغةٌ مركَزيةٌ جامِعَةٌ في بريطانيا والولاياتِ المتحدَةِ الأمريكية وأستراليا، والألمانيةُ لغةٌ مركَزيةٌ جامِعَةٌ في ألمانيا والنّمسا وسويسرا، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة مركزية جامعة ","nonDiacriticsLemma":"لغة مركزية جامعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مَرْكَزِيَّةٌ جَامِعَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

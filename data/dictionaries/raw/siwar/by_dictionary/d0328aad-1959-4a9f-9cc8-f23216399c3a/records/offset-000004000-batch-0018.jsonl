{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/79f28b11-5927-46b9-92a0-6557ce54140d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"79f28b11-5927-46b9-92a0-6557ce54140d","word":"فِعْلُ التَّعْبِيرَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99df","lexicalEntryId":"79f28b11-5927-46b9-92a0-6557ce54140d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فِعْلُ التَّعْبِيرَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فِعلٌ شِبهُ جُمَلِيٍّ، يُسمّى أيضا الفعلَ التَّعبيرَة، ويُطلَق على أيِّ تركيبٍ مكوَّنِ من كلمَتَين أو أكثَرَ، ويُعامَل مُعامَلةَ الفعلِ أو يَقوم بوَظيفَته النحوية؛ كأن يكون مكوَّنًا من فعلَين، أو فعلٍ وأداةٍ ظَرفية، أو فعلٍ وحَرفِ جَرٍّ. يُميَّز عادةً بين ثلاثة أنماطٍ من هذا التركيب: أفعالٌ شِبهُ جُمَلِيَّة phrasal verbs، وأفعالٌ جارِّيّة prepositional verbs، وأفعالٌ جارِّيّة أي متعدية بحروف جرّ phrasal-prepositional verbs. ومن أمثِلَته في الإنجليزية: take up في جُملة: I'll take up your offer: وقريبٌ منه في العربية: أَخَذَ عليه كذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فعل التعبيرة ","nonDiacriticsLemma":"فعل التعبيرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فِعْلُ التَّعْبِيرَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2a294c15-4989-493e-b312-59e905a7cc87/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2a294c15-4989-493e-b312-59e905a7cc87","word":"تَأْصِيلٌ شَعْبيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99e0","lexicalEntryId":"2a294c15-4989-493e-b312-59e905a7cc87","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَأْصِيلٌ شَعْبيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَغييرُ صِيغةِ كلمةٍ غيرِ مَألوفةٍ إلى صِيغةٍ مَألوفة، أو لِتُشابِه صِيغةً مَألوفة، وهذا الأمرُ قد يؤدِّي إلى الحُكم بأنها مُشتقَّةٌ من كلمةٍ لا علاقةَ لها باشتِقاقها في الأصل، مثلُ: spit and image التي تحوَّلَت إلى spitting image، ويسمّى أيضا: folk etymology. ومن ذلك ما يَشيع لدى بعضِ العربِ من أن كلماتٍ في لغاتٍ أخرى أصلُها عربي؛ كقولهم إن اسمَ: (شكسبير) مأخوذٌ من العبارَة العربية: (شيخ زبير). وقد يُصادِف متعلِّمُ اللغةِ كلماتٍ من هذا النوعِ في اللغة الهَدَفِ مُشابِهةً لكلماتٍ في لغته الأمِّ؛ فيَنطِقها وفقَ نُطقِ لغتِه الأمِّ، أو يَتوَهَّم أن معناهما في اللغَتَين واحدٌ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تأصيل شعبي ","nonDiacriticsLemma":"تأصيل شعبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَأْصِيلٌ شَعْبيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

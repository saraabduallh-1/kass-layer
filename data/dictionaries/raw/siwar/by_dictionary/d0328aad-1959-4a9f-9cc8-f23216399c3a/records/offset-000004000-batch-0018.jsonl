{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b59b2e16-03f9-49ff-b1bd-0a714c2f9cc8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b59b2e16-03f9-49ff-b1bd-0a714c2f9cc8","word":"عِلْمُ الفُونِيمَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99dd","lexicalEntryId":"b59b2e16-03f9-49ff-b1bd-0a714c2f9cc8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ الفُونِيمَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من علم اللغة، يُعنَى بتحليل فونيماتِ اللغةِ تحليلًا تَزامُنيًّا دون النَّظَرِ إلى تَطوُّرها التاريخي. وهو أحَدُ نَوعَيْ دراسةِ الأصواتِ اللغويةِ وتحليلِها، في مقابِل علمِ الأصواتِ العامِّ phonetics، وفقَ تَصنيفِ البِنيَويِّين الأمريكيين لهذا العلمِ، الذين استَبدَلوا بالفونولوجيا phonology مصطلحَ الفُونيمِ phoneme؛ لارتِباط الأولِ بمعنى قديمٍ ثابِتٍ في أذهان الناسِ، وهو إطلاقُه على الدراسات التاريخيةِ للأصوات. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم الفونيمات ","nonDiacriticsLemma":"علم الفونيمات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ الفُونِيمَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

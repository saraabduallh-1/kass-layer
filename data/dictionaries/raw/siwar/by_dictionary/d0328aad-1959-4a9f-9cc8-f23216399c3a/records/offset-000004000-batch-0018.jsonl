{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ca9e0de3-005c-42fe-83a7-c3af5e46fe38/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ca9e0de3-005c-42fe-83a7-c3af5e46fe38","word":"فِسْيُولُوجِيَّةُ السَّمْعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b99c9","lexicalEntryId":"ca9e0de3-005c-42fe-83a7-c3af5e46fe38","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فِسْيُولُوجِيَّةُ السَّمْعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ الميادينِ التي يَبحثها علمُ الأصواتِ السَّمعِيِّ أو يَستَفيد منها، وتُعَدُّ فرعا من فروع الدراساتِ اللغويةِ النفسيةِ العصَبية. وفسيُولوجيةُ السَّمعِ تُعنَى بدراسة عَمَليةِ السَّمعِ والإدراكِ السَّمعِيِّ، وهي العَمَلياتُ والمراحِلُ والمناطِقُ التي يَتِمّ بها استقبالُ الصوتِ ومُعالَجَتُه في أجزاء الأذُنِ ثم انتِقالُه إلى مَراكِز السَّمعِ وإدراكِ الكلامِ وفَهمِه في الدِّماغ، إضافةً إلى الدراسة الفِسيولوجيةِ للأعضاء والأجهِزَةِ السَّمعيةِ التي تقوم بهذه الوَظائف. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فسيولوجية السمع ","nonDiacriticsLemma":"فسيولوجية السمع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فِسْيُولُوجِيَّةُ السَّمْعِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f608fa1c-b2aa-4e48-8a76-5b9535b6ddfc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f608fa1c-b2aa-4e48-8a76-5b9535b6ddfc","word":"الأُذُنُ الوُسْطَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9706","lexicalEntryId":"f608fa1c-b2aa-4e48-8a76-5b9535b6ddfc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الأُذُنُ الوُسْطَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ الأجزاءِ الثلاثةِ الرئيسةِ للأذُن، إضافةً إلى الأذُن الخارِجيةِ والأذُنِ الداخلية. وهي الجزءُ الواقِعُ بين الغِشاء الطَّبليِّ وبدايةِ أجزاءِ الأذنِ الداخلية، وتتكوَّن من ثلاث عُظَيماتٍ سَمعِيةٍ مُتَسَلسِلَةٍ ومُتَرابِطَة، هي: المِطرَقةُ والسِّندانُ والرِّكاب. وَظيفَتُها الأساسيةُ نَقلُ الموجاتِ الصوتيةِ من الأذُن الخارجيةِ إلى الأذُن الداخلية، بعد تَحويرِها وتحويلِها من مَوجاتٍ إلى إشاراتٍ تُناسِب السَّائلَ الموجودَ في الأذُن الداخلية. ولها وَظائفُ إضافية، منها: إضعافُ الأصواتِ الصَّاخِبة، والمحافَظةُ على ضَغط الهواءِ الواقِعِ على جانِبَي الطَّبلة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الأذن الوسطى ","nonDiacriticsLemma":"الأذن الوسطى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الأُذُنُ الوُسْطَى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

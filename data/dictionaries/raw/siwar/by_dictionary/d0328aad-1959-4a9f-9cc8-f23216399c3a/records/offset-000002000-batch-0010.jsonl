{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/395af48a-d9b1-4558-869d-e8c5889e767f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"395af48a-d9b1-4558-869d-e8c5889e767f","word":"تَكْرَارٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b912b","lexicalEntryId":"395af48a-d9b1-4558-869d-e8c5889e767f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَكْرَارٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يَشيع استِعمالُه في المعالجة الآليَّةِ للنُّصوص وفي لسانيّات المدوَّنات، ويُقصَد به درَجةُ شُيوعِ العنصُرِ اللغويِّ (صوت أو مورفيم أو كلمة أو تركيب) في نَصٍّ ما أو مدَوَّنةٍ لغويةٍ، أي عَدَدُ مرّاتِ وُرُودِه. وتختَلِف درَجاتُ شُيوعِ العنصُرِ اللغويِّ في النُّصوص المسموعة عنها في النُّصوص المكتوبة، وغالبا ما تكون الكلماتُ الوَظيفيةُ أكثَرَ شُيوعا من كلمات المحتوى. ويُسمّى هذا أيضا تَكرارَ الحُدوثِ frequency of occurrence.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تكرار ","nonDiacriticsLemma":"تكرار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَكْرَارٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

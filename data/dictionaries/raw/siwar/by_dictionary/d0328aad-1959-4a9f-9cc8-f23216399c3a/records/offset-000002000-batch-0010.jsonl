{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/794c3b82-852f-4be0-b746-985e8b992950/get-public-entry"},"browse_index_record":{"lexicalEntryId":"794c3b82-852f-4be0-b746-985e8b992950","word":"فِعْلٌ تَامٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b912d","lexicalEntryId":"794c3b82-852f-4be0-b746-985e8b992950","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فِعْلٌ تَامٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فعلٌ يَقتَرِن به فعلٌ مساعِدٌ ليوَضِّحَ هيئتَه أو صِيغَتَه أو زمنَه، وله معنى معجَميٌّ واضِحٌ، ويتَمَيَّز عن الفعل المساعدِ بصِيَغٍ خاصَّة، وبتأدِيَتِه وَظيفةَ الفعلِ الحقيقيِّ في الجُملة. مثلُ: (جَلَسَ) و(كَتَبَ) و(يَذهَبُ) و(اكتُبْ)، ومثل: read, give, eat.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فعل تام ","nonDiacriticsLemma":"فعل تام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فِعْلٌ تَامٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d7fa567e-0262-41fb-8646-6f0b218cea72/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d7fa567e-0262-41fb-8646-6f0b218cea72","word":"المَذْهَبُ الوَظِيفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b912e","lexicalEntryId":"d7fa567e-0262-41fb-8646-6f0b218cea72","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَذْهَبُ الوَظِيفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ في تعليم اللغاتِ الثانيةِ والأجنبية، تُبْنَى على أساسه المناهِجُ والمقرَّراتُ الدراسيَّةُ والموادُّ التعليمية. يَنطَلِق هذا المذهبُ من المبدأ الذي يرى أن إيصالَ المعنى هو الغايَةُ الأساسيةُ للغة، وأن الجوانبَ الأخرى من اللغة، من أصواتٍ ومفرَداتٍ وتراكيب، وسائلُ لتَحقيق هذه الغايَة. وبناء على ذلك، فإن تعليمَ اللغةِ يجب أن يَنطَلِق من الوَظائف التواصُليةِ للغة؛ كالاستفهام، والطَلَب، والنَّهي، والاستِفسار، والاستِئذان، والتَّحية، والوَداع، ونحوِ ذلك، بدَلا من الانطِلاق من الجوانب الشَّكليةِ من مُفرَداتٍ معجَميةٍ وتراكيبَ نحوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المذهب الوظيفي ","nonDiacriticsLemma":"المذهب الوظيفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَذْهَبُ الوَظِيفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/58989e79-241f-457e-b807-0c0db1cc7f5d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"58989e79-241f-457e-b807-0c0db1cc7f5d","word":"وَحْدَةٌ وَظِيفِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b912f","lexicalEntryId":"58989e79-241f-457e-b807-0c0db1cc7f5d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَحْدَةٌ وَظِيفِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يُستَعمَل أحيانا في تَصنيف الكلمة، حيث تُصَنَّف إلى: كلماتٍ معجَميةٍ أو مورفيماتٍ حُرَّة، ومورفيماتٍ مقيَّدَةٍ وَظائفُها نحويَّةٌ في الغالب. فالوَحدةُ الوَظيفيةٌ هنا تَشمَل المورفيماتِ والأدواتِ الوَظيفيةَ التي ليسَت معجَميةً، بما فيها الكلماتُ الوَظيفيةُ المقابِلةُ لكَلِمات المحتوى. ولهذه الوَحدةِ أسماءٌ مختَلِفةٌ، منها: الكلمةُ الوَظيفيةُ function word/form word، والكلمةُ النحويةُ grammatical word، ، والكلمةُ الفارِغَةُ أو الوظيفيةُ empty word، وجَميعُها تُقابِل الكلمةَ المعجَميةَ lexical word، التي تحمِل المحتوى الدّلاليَّ الرَّئيس. راجع:  @(function(al) word) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وحدة وظيفية ","nonDiacriticsLemma":"وحدة وظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَحْدَةٌ وَظِيفِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b038f127-5cc7-48ba-81a3-a4a2daad49e3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b038f127-5cc7-48ba-81a3-a4a2daad49e3","word":"جُمْلَةٌ خَادِعَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9130","lexicalEntryId":"b038f127-5cc7-48ba-81a3-a4a2daad49e3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جُمْلَةٌ خَادِعَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جُملةٌ بدايَتُها صحيحةٌ تجذِب القارئَ، وحين يَصِل إلى مَوضِعٍ معيَّنٍ فيها يُصادِفه خَطأٌ نحويٌّ أو خَطاٌ منطِقيٌّ، فيَصعُب عليه فَهمُ الجُملةِ، ويَضطرُّ حينئذٍ إلى الارتِداد وقراءةِ الجُملةِ مرةً بعد أخرى وتَتَبُّعِ تَركيبِها ومحاوَلَةِ استِخلاصِ معناها. سمِّيَت بهذا الاسمِ الذي يَعنِي حَرفيًّا: جُملَةُ مَمَرّات الحَدِيقَة، تَشبيها لها بدَرْبٍ جَميلٍ في حديقَةٍ لا يُرى إلا بِدايَتُه لكنه غيرُ مَضمونِ العَواقِب، وحين يَفقِد المرءُ طريقَه في الحديقَة يَعود إلى أقرَب نقطَةٍ أو مَمَرٍّ يعرِفه. مثالُ ذلك الجُملَةُ الإنجليزيةُ: The horse raced past the barn fell. ففي هذه الجملة قد يظن القارئ أن الفعل race تعني أن الحصان \"سابَق\" ولكن القراءة الثانية والصحيحة تدل على أن شخصًا ما \"أسرع بالحصان\". وتُسمّى أيضا: garden pathing.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جملة خادعة ","nonDiacriticsLemma":"جملة خادعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":nu
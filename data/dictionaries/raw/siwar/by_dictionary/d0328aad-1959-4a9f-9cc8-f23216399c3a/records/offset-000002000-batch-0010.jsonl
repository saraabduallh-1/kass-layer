{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f9c7eeca-0a36-4ec8-9d2f-9fb5426cc642/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f9c7eeca-0a36-4ec8-9d2f-9fb5426cc642","word":"النَّحْوُ الوَظِيفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9121","lexicalEntryId":"f9c7eeca-0a36-4ec8-9d2f-9fb5426cc642","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوُ الوَظِيفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَذهبٌ أو منهجٌ نحويٌّ حديثٌ، تَرجِع أصولُه إلى الاتِّجاه الوظيفيِّ الذي اشتُهِرَت به المدرسةُ اللغويةُ المعروفةُ بمدرسة براغ  Prague School. مرَّ هذا المذهبُ بعدَّة مراحِل، ووُصِف بأوصافٍ متَشابِهَةٍ أحيانا ومختَلِفةٍ أحيانا أخرى. فقد عُرِف النحوُ الوَظيفيُّ عند هاليداي Halliday ضِمنَ النحوِ النظاميِّ systemic، وعَرَّفَه بأنه القواعدُ الطبيعيةُ التي يمكن شرحُها من خلال الاستعمالِ اللغوي. بيدَ أن النحوَ الوَظيفيَّ اشتُهِر في أواخِر السبعينياتِ من القرن العشرين على يَد سايمون ديك Simon C. Dik وأتباعِه، بشَكلٍ يختَلِف عن المفهوم الذي قدَّمَه هاليداي على الرَّغم من اعتِمادهما على المبادئ الوَظيفيةِ نفسها التي لدى مدرسةِ براغ. اعتَمَد هذا المذهبُ عند ديك على النَّظرَة التَّداوُليةِ pragmatic view للُّغة التي هي تواصُلٌ أو تفاعُلٌ اجتماعيٌّ، بدَلا من النَّظرَة الوَصفيةِ الشَّكليةِ التي قدَّمَها الاتجاهُ البنيويُّ خاصَّةً عند بلومفيلد، والنَّظرَةِ النحويةِ التجريديةِ التي قدَّمها النحوُ التوليديُّ التحويليُّ. ركَّز هذا المذهبُ على القواعد التي تَحكُم التفاعُلَ بوَصفه نشاطا مُساعِدا، والقواعدِ النحويةِ والدَّلاليةِ والصوتيةِ التي تَحكُم العباراتِ والجُملَ بوَصفها أدواتٍ ووَسائلَ لهذا النَّشاط. في هذا المذهب يُنظَر إلى المسنَد أو الخَبَرِ predicate على أنه العنصُرُ الأساسُ في الإسنادِ أو الإخبارِ predication، حيث يَقَع ضِمنَ المعجَمِ lexicon في إطار الَخبَر، ويخصَّص له عَدَدٌ من المطابَقات التي يتَطَلَّبها. ويَهتَم هذا المنهجُ بتَحديد سِماتِ علاقَةِ أجزاءِ الجُملة بعضِها ببعض، ويَصِف تركيبَ الجُملةِ في شَكلِ بِنيَةٍ صُورِيَّة تتكوَّن من نَمَطٍ معيَّنٍ من الخصائص والوَظائفِ والمفرَداتِ اللغويةِ والتراكيبِ المكوّنة لأجزاء الجُملة. وفيه تُحَلَّل الجُملةُ من حيث البنيةُ التركيبية، ووصفُ الخصائص، والمضمونُ المعجَمي، والبنيةُ الدّلالية، والبنيةُ الكتابية. راجع:  @(functional linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النحو الوظيفي ","nonDiacriticsLemma":"النحو الوظيفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّحْوُ الوَظِيفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8b18c876-7ba4-42c6-981c-fd6365f160ea/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8b18c876-7ba4-42c6-981c-fd6365f160ea","word":"القَوَاعِدُ الوَظِيفِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9122","lexicalEntryId":"8b18c876-7ba4-42c6-981c-fd6365f160ea","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"القَوَاعِدُ الوَظِيفِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يُطلَق على مجموع القواعدِ التطبيقيةِ للُّغة الهَدَف، أو القواعدِ التعليميةِ pedagogical grammar، وهي القواعدُ التي يحتاجها متعلِّمُ اللغةِ ويَظهَر أثرُها في فَهم اللغةِ واستعمالِها. فمن القواعد الوَظيفيةِ التي يحتاجها متعلِّمُ اللغةِ العربيةِ: الفاعلُ، والمفعولُ به، والحالُ، والنَّعتُ، وتعدِّي الفِعلِ ولزومُه، خلافا للقواعد غيرِ الوَظيفية؛ كإعرابِ الجُمل، ومسائلِ التَّنازُعِ والاشتغالِ، والحذفِ والتَّقديرِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"القواعد الوظيفية ","nonDiacriticsLemma":"القواعد الوظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"القَوَاعِدُ الوَظِيفِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/58b516c7-c6c2-4644-81e6-21ee8234a644/get-public-entry"},"browse_index_record":{"lexicalEntryId":"58b516c7-c6c2-4644-81e6-21ee8234a644","word":"النَّمَاذِجُ الوَظِيفِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9123","lexicalEntryId":"58b516c7-c6c2-4644-81e6-21ee8234a644","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّمَاذِجُ الوَظِيفِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَماذِجُ أو آراءٌ وَظيفيةٌ تُفَسِّر اكتسابَ اللغةِ الثانية، وتَنطَلِق من مذاهبَ أو نظرياتٍ لغويةٍ نفسيةٍ أو اجتماعية؛ فتَرَى أنّ تعلُّمَ اللغةِ الهَدَفَ يتضمَّن بناءَ شَبَكاتِ رَبْطٍ بين الشَّكلِ والوَظيفة. فالمتعلِّمُ عليه أن يَكتَشِف الصِّيَغَ اللغويةَ التي تؤدِّي المعانيَ التي يُراد تَوصيلُها إليه في اللغة الهَدَف. فهذه النماذِجُ تؤكِّد أن المتعلِّمين يُمكِنُهم بناءُ علاقاتٍ خاصة بين الصِّيَغ؛ انطِلاقًا من المبدأ الذي يرَى أن المتعلِّمَ يَستَعمِل الصِّيَغَ لتَأدِيَة وَظائفَ معيَّنة، بدَلًا من التَّعبير عن تلك الوَظائف بصِيَغٍ أخرى. وتؤكِّد النَّماذجُ الوظيفيةُ هذه على وَظيفَة التواصُلِ وأهميَّتِه في اكتساب اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النماذج الوظيفية ","nonDiacriticsLemma":"النماذج الوظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّمَاذِجُ الوَظِيفِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f93cdcf1-a043-4117-b527-f40d08fa5f1b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f93cdcf1-a043-4117-b527-f40d08fa5f1b","word":"المُقَرَّرُ الوَظِيفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9124","lexicalEntryId":"f93cdcf1-a043-4117-b527-f40d08fa5f1b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المُقَرَّرُ الوَظِيفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهجٌ أو مَذهبٌ في تعليم اللغات، يعتَمِد على الوَظائف التواصُليةِ التي تؤدِّيها اللغةُ وتكون أساسا لبناء المنهَجِ أو المقَرَّر، وإعدادِ الدُّروسِ وتَنظيمِها وطريقةِ تَقديمِها، قبلَ الانتِقالِ إلى المفرَدات والصِّيَغِ والتراكيب. وفي هذا المنهَجِ تُحَدَّد الوَظائفُ اللغويةُ التي يحتاجُها الطلابُ في الدرس أوّلا، من تَعَرُّف أو وَصفٍ أو دَعوةٍ أو اعتِذارٍ أو رَفضٍ، ثم تُحَدَّد الكلماتُ المناسِبةُ لها، ثم تُنَظَّم في صِيَغٍ وتراكيبَ لتأديَة هذه الوَظائفِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المقرر الوظيفي ","nonDiacriticsLemma":"المقرر الوظيفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المُقَرَّرُ الوَظِيفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/48ab6acf-c76b-49f8-baa9-a6c68c356a31/get-public-entry"},"browse_index_record":{"lexicalEntryId":"48ab6acf-c76b-49f8-baa9-a6c68c356a31","word":"كَلِمَةٌ وَظِيفِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9125","lexicalEntryId":"48ab6acf-c76b-49f8-baa9-a6c68c356a31","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمَةٌ وَظِيفِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللَّفظُ الذي لا يدُلُّ على معنى بذاته، بل يَفتَقِر إلى كلمةٍ معجَمية؛ كحُروف الجَرِّ، وحُروفِ العَطف، وأدواتِ الاستفهام والنَّفي، وأدوات التعريفِ والتنكيرِ، والأفعالِ المساعدةِ، ونحوِ ذلك. وسُمِّيَت وَظيفيةً لأن وَظيفَتَها في الكلام التَّعبيرُ عن العلاقات النحويةِ والرَّبطُ بين عناصِرِ الجُملة. وهي محدودةُ العَدَدِ في أيِّ لغةٍ من اللغات. ويُقابِلها كلماتُ المحتوَى content words أو الكلماتُ المعجَميةُ، وهي ما عدا الكلماتِ الوَظيفيةَ من الكلمات المعجَميةِ التي تدُلّ على معنى بذاتها، كالأسماء والصفاتِ والأفعال، سواء دَلَّت على مَعانٍ مَحسوسَةٍ أو مَعانٍ تجريدِيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمة وظيفية ","nonDiacriticsLemma":"كلمة وظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمَةٌ وَظِيفِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0ab65fdb-7b63-4560-8330-0fb321f385f1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0ab65fdb-7b63-4560-8330-0fb321f385f1","word":"الأَمْرِيكِيَّةُ العَامَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9126","lexicalEntryId":"0ab65fdb-7b63-4560-8330-0fb321f385f1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الأَمْرِيكِيَّةُ العَامَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللَّهجةُ الإنجليزيةُ المستَعمَلةُ في عُموم الولاياتِ المتحدةِ الأمريكيةِ وفي معظَم أنحاءِ كندا. وهي لَهجَةٌ لا تقتَصِر على مجموعَةٍ معيَّنةٍ ولا منطقةٍ أو مناطِقَ محدَّدَة، وإنما هي لهجَةٌ شائعةٌ في وسَط الولاياتِ المتحدةِ الأمريكيةِ وغَربِها؛ لهذا تُسمّى اللَّهجَةَ الأمريكيةَ الغربيةَ الوُسطى Midwestern American، وهي اللغةُ الشائعَةُ في وَسائل الإعلامِ الأمريكيةِ، وغالبًا ما تختَفِي فيها اللَّهَجاتُ الخاصَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الأمريكية العامة ","nonDiacriticsLemma":"الأمريكية العامة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الأَمْرِيكِيَّةُ العَامَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

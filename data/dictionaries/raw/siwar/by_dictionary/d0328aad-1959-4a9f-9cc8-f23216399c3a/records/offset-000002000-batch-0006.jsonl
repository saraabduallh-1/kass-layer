{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2f82a6a4-2147-4e73-9359-43ee3c62a039/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2f82a6a4-2147-4e73-9359-43ee3c62a039","word":"صِيغَةٌ حُرَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90ce","lexicalEntryId":"2f82a6a4-2147-4e73-9359-43ee3c62a039","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صِيغَةٌ حُرَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عنصُرٌ لغويٌّ يمكن أن يَرِد وحدَه، كالكلمات المعجَمية، مثلُ: (رَجُل) و(محمد) و(فاطِمة) و(جَلَس) ...، في مُقابِل الصِّيغَةِ المقيَّدَة، كالمورفيم المقَيَّدِ مثلًا، وبعضِ الأدوَاتِ الوَظيفيةِ، كحُروفِ الجَرِّ والعَطفِ ونحوِها. راجع:  @(morpheme) و  @(free morpheme) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صيغة حرة ","nonDiacriticsLemma":"صيغة حرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صِيغَةٌ حُرَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eab50124-e57a-435e-9f4a-cf11db8a193c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eab50124-e57a-435e-9f4a-cf11db8a193c","word":"نَبْرٌ حُرٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90cf","lexicalEntryId":"eab50124-e57a-435e-9f4a-cf11db8a193c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَبْرٌ حُرٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النَّبرُ المتَغيِّرُ الذي لا يَقَع دائما على مقطَعٍ محَدَّدٍ في جميع الكلماتِ في لغةٍ مُعيَّنة، وإنما يتَغيَّر مَوضِعُه بين كلمةٍ وأخرى في اللغة بحسَب تصريفِ الكلمةِ أو نوعِها، خلافا للنَّبر الثابِتِ fixed stress. فالكلمةُ الإنجليزيةُ مثلا يَقَع النَّبرُ الأوَّليُّ فيها على المقطَع الأولِ، مثل كلمة: interval، وعلى الثاني في كلمة: interrogate، وعلى الثالث في كلمة: interference. وفي بعض اللغات، كالعربية والألمانيةِ مثلا، يكون للنَّبر فيها حُرِّيَّةٌ أكثَر، خاصةً حين يكون غيرَ وَظيفِيٍّ. وحُرِّيَّةُ النَّبرِ ودرَجةُ هذه الحُرِّيَّةِ مما يُسبِّب مشكلاتٍ لدى متعلِّمي اللغةِ الهَدَفِ الناطقين بلُغةٍ يختَلِف نظامُها النَّبرِيُّ عن نظام اللغةِ الهَدَف، ولاسيَّما حين يكون هذا الاختلافُ سببا في تغيُّر المعنى أو الوَظيفَةِ النحوية. راجع:  @(fixed accent/stress) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نبر حر ","nonDiacriticsLemma":"نبر حر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَبْرٌ حُرٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

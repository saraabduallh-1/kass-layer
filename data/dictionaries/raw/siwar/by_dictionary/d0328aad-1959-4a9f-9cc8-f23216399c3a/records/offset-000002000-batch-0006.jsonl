{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3a0f5102-8cbb-4d0a-a5e5-80ae85ea1bd1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3a0f5102-8cbb-4d0a-a5e5-80ae85ea1bd1","word":"اللِّسَانِيَّاتُ الفِيرْثِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90be","lexicalEntryId":"3a0f5102-8cbb-4d0a-a5e5-80ae85ea1bd1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللِّسَانِيَّاتُ الفِيرْثِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمُ اللغةِ الفِيرثِيُّ، وهو اسمٌ أو وَصفٌ يُطلَق على منهَج اللغويِّ البريطانيِّ جون روبرت فيرث John Rupert Firth (1890-1960م) في دراسة اللغة، ويُسمّى أيضا علمَ اللغةِ البريطانيَّ أو اللسانياتِ البريطانيةَ British Linguistics. وهو منهَجٌ يتَمَيَّز بالبحث عن أكثَر من منهَجٍ في التحليل ودراسةِ الأنماطِ اللغويةِ كافَّة، كما يهتَم بسِياق الحال، وتأكيدِ أن الكلمةَ تتَحَدَّد دلالَتُها بالسِّياق، ولا معنى لها خارِجَه. تطوَّر هذا المنهَجُ على يَد أتباعِ فيرث، أمثال مايكل هاليداي Michael Halliday، فسُمِّي بالنحو النِّظامِيِّ Systemic Functional Theory، الذي يتضَمَّن ثلاثةَ جوانبَ أساسيةٍ، هي: الشَّكلُ الذي يَشمل قواعدَ النحوِ والمفرَدات، والمادَّةُ التي تَعني الجانبَ الصوتيَّ والكتابةَ، والسِّياقُ وهو العلاقاتُ بين الشَّكلِ والمواقِفِ أو علم الدّلالة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللسانيات الفيرثية ","nonDiacriticsLemma":"اللسانيات الفيرثية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللِّسَانِيَّاتُ الفِيرْثِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

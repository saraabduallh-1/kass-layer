{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e10ad440-0452-465f-829e-b339f7384db4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e10ad440-0452-465f-829e-b339f7384db4","word":"فَرْضِيَّةُ المُصَفِّي الوِجْدَانِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8960","lexicalEntryId":"e10ad440-0452-465f-829e-b339f7384db4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرْضِيَّةُ المُصَفِّي الوِجْدَانِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، اقترَحه كلٌّ من هيدي دولي Dulay  Heidi C ومارينا بورت Marina K. Burt، وأصبح من الفَرضِياتِ الخَمسِ التي تقوم عليها فرضيّة أو أنموذَجُ المراقِبِ Monitor Hypothesis/Model، أو نظريةُ المراقِبِ Monitor Theory، لستيفِن كراشِن Steven Krashen، في تفسير اكتسابِ اللغةِ الثانية. والمصَفِّي الوِجدانِيُّ جِهازٌ نَفسيٌّ وَهمِيٌّ، يُقصَد به خُضوعُ المُدخَلِ اللغويِّ للحالَة النَّفسيةِ لدى المتعلِّم، كالتَّوَتُّر، والدَّافِعِيَّةِ إلى التعلِّم، ومستوى الثِّقَةِ بالنفس، والاتِّجاهاتِ والميُولِ نحوَ اللغةِ الهدَفِ وثقافتِها. فهذه العوامِلُ تتحكَّم في اتِّساع هذا المصفِّي وانقِباضِه أو انغِلاقِه في أثناء تلَقِّي المُدخَلِ اللغويِّ. ولكي يَنفَتح هذا الجهازُ ويَسمَح بمرور المُدخَلِ اللغويِّ بسُهولة؛ يَنبَغي تخفيفُ التَّوَتُّرِ لدى المتعلِّم، وتقديمُ مُدخَلٍ لغويٍّ مَفهوم، يكون في مستوى المتعلِّمِ أو يَزيد عليه قليلا، وذا عَلاقةٍ بالموضوع والسِّياقِ اللغوي، وغيرَ مَبنيٍّ على القواعد المفروضَة. راجع:  @(Monitor Hypothesis/Model) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية المصفي الوجداني ","nonDiacriticsLemma":"فرضية المصفي الوجداني","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرْضِيَّةُ المُصَفِّي الوِجْدَانِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/98137096-5772-4eb6-96f4-db49cbe67b41/get-public-entry"},"browse_index_record":{"lexicalEntryId":"98137096-5772-4eb6-96f4-db49cbe67b41","word":"لُغَةٌ لَصْقِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8961","lexicalEntryId":"98137096-5772-4eb6-96f4-db49cbe67b41","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ لَصْقِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ التي تعتَمِد على الإلصاق agglutination في بناء كلماتِها والعلاقاتِ التركيبيةِ بينها، وتُعرَف اللَّوَاصِقُ فيها من السَّوابِق واللَّوَاحِق، فتُضاف إلى الجِذر، وتُغيِّر معنى الكلمةِ أو وَظيفتَها. والإلصاقُ أو اللَّصقُ أحَدُ السِّماتِ التي تميِّز بعضَ اللغاتِ من بعضها؛ فتُصنَّف على أساسها إلى لغاتٍ لَصقِيَّةٍ كالتركية واليابانيةِ والسَّواحيليةِ والفِنلَنديةِ والهَنغارِية، وتُقابِلها اللغاتُ التَّحلِيلِيةُ أو التَّصريفيةُ، واللغاتُ العازِلَة. لكن لا توجد حُدودٌ واضِحةٌ تميِّز اللغاتِ اللَّصقيةَ من اللغاتِ التَّصريفيةِ واللغاتِ العازِلَةِ، وربما تجتَمِع هذه السِّماتُ أو بعضُها في لغةٍ واحدة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة لصقية ","nonDiacriticsLemma":"لغة لصقية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ لَصْقِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

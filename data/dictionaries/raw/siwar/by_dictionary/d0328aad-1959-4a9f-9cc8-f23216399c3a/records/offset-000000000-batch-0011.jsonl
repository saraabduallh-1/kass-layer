{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c46409ad-4f62-4847-a72b-798eff4ff53b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c46409ad-4f62-4847-a72b-798eff4ff53b","word":"حُبْسَةُ نِسْيانِ الأَسْمَاءِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b895d","lexicalEntryId":"c46409ad-4f62-4847-a72b-798eff4ff53b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حُبْسَةُ نِسْيانِ الأَسْمَاءِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُشير إلى أحَدِ أنواعِ الحُبسَةِ أو إلى درَجةٍ من درَجاتها، تَحدُث نتيجةَ إصابةِ المرءِ في دِماغه؛ فيكون غيرَ قادِرٍ على تَسمية الأشياءِ التي يَعرِفها من قبلُ وتَقَع في مجال إدراكِه، على الرّغم من قُدرَته على الكلام من غير أخطاء نحوية. تَظهَر أعراضُ هذه الحُبسَةِ في صُعوبة نُطقِ المصابِ الأشياءَ التي يَتطلَّبها سِياقُ الحديث؛ فيَلوذ حينئذٍ بالصَّمت، أو يَصِف الشيءَ بشيء من صِفاته أو وَظائفِه. وكثيرٌ من المصابين بهذه الحُبسَةِ لا يُدرِكون أنهم مصابون بها؛ لأنها تُصيبهم بطريقَةٍ تدريجية، وربما تكون مقدِّمةً للخَرَف أو مرضِ ألزهايمر Alzheimer's disease، بيدَ أن المصابَ بها لا يُخطِئ في بناء التراكيب.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حبسة نسيان الأسماء ","nonDiacriticsLemma":"حبسة نسيان الأسماء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حُبْسَةُ نِسْيانِ الأَسْمَاءِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3e2a53ff-97cd-486c-96af-d565c604cb9e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3e2a53ff-97cd-486c-96af-d565c604cb9e","word":"عِلْمُ الإنْسَانِ (الأنْثروبولُوجيَا)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b895e","lexicalEntryId":"3e2a53ff-97cd-486c-96af-d565c604cb9e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ الإنْسَانِ (الأنْثروبولُوجيَا)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمُ دراسةِ الإنسانِ بوَجهٍ عامٍّ، ويُقسَّم إلى إناسَةٍ طبيعيةٍ تُعنَى بدراسة الإنسانِ في مَظهَره البيولوجيِّ، وإناسَةٍ اجتماعيةٍ وثقافيةٍ تُعنَى بلغته وثقافَتِه وعاداتِه. يتفَرَع من هذا العلمِ عُلومٌ متخَصِّصَةٌ في دراسة الإنسان؛ كالأنثروبولوجيا الاجتماعية والأنثروبولوجيا الثّقافية، والأنثروبولوجيا الاجتماعيةِ الوَظيفية، والأنثروبولوجيا التّركيبِيّة، والأنثروبولوجيا الفيزيقِيّة. وعلى الرّغم من تعَدُّد مناهِجِ البَحثِ في هذا العِلمِ، فإنه يَقوم على عِلم الإثْنُوغرافِيَّةِ أو الإناسَةِ الوَصفِيَّة، المعروفةِ بالإثنوغرافيا ethnography، خاصةً عند فرانز بواز Franz Boas في أواخِر القرنِ التاسِع عشَر، وبرونيسلاف مالينوفسكيBronislaw Malinowski  في أوائل القرنِ العشرين. وهو أحَدُ العُلومِ المرتَبطةِ بعلم اللغةِ الحديثِ، والرّافِدَةِ له منذ عَهد ليونارد بلومفيلد وإدوارد سابير في منتصف القرنِ العشرين؛ لأن الباحثَ في هذا العلمِ يَغوص في لغة المجتَمَعِ الذي يَدرُسه بوَصف اللغةِ أهمَّ مكوِّناتِ المجتَمَع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"re
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5b93eed6-10c8-4308-861e-24a5332a7f4d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5b93eed6-10c8-4308-861e-24a5332a7f4d","word":"أُنْمُوذَجُ أَنْدِرْسُون وبِيرْسُون","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8951","lexicalEntryId":"5b93eed6-10c8-4308-861e-24a5332a7f4d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ أَنْدِرْسُون وبِيرْسُون","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم النفسِ القرائيِّ، يُشير إلى أحَد النَّماذِجِ التَّفاعُليةِ في القراءة interactive models، اقتَرَحَه رِيتشارد أندِرسون Richard Anderson وديفيد بِيرسون David Pearson وقَدَّماه مثالا على كَيفيَّة تَوظيفِ مختَلِفِ المعلوماتِ السابقةِ لدى القارئِ في فَهم النَّصِّ المقروء. وقد اهتَمَّ هذا الأنموذَجُ بنظرية التَّخطيطِ والرَّبطِ للقراءة Schema Theory of Reading، وهي مجموعةُ الأساليبِ التَّنظِيمِيةِ التي يَقوم بها القارئُ لفَهم النَّصِّ الذي يَقرَؤه، كاستِحضار المعلوماتِ ذاتِ العلاقَةِ بالموضوع، ورَبطِها بالنَّص المقروء، واستِنباطِ المعنى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج أندرسون وبيرسون ","nonDiacriticsLemma":"أنموذج أندرسون وبيرسون","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ أَنْدِرْسُون وبِيرْسُون"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGene
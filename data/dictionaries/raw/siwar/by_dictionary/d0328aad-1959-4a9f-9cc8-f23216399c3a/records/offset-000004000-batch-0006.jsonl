{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/412dfb2b-8e8a-4840-9196-0de5312acf55/get-public-entry"},"browse_index_record":{"lexicalEntryId":"412dfb2b-8e8a-4840-9196-0de5312acf55","word":"ذِرْوَةُ المَقْطَعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b989b","lexicalEntryId":"412dfb2b-8e8a-4840-9196-0de5312acf55","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ذِرْوَةُ المَقْطَعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم الأصوات، يُشير إلى ذِروَة المقطَعِ أو قِمَّتِه، وهي جَوهَرُه أو جُزؤه البارِزُ ويجب أن تكون صوتًا مَقطَعِيًّا، وهي أحَدُ الأجزاءِ الثلاثةِ للمَقطَع الصوتي، أمّا الجُزءان الآخَران فهما: البادئةُ onset التي تَسبِق الذِّروَةَ أو القِمَّةَ، والخاتِمَةُ coda التي تَلحَقها. هذا في ضَوء النظرَةِ إلي المقطَع من زاوِيَةٍ إنتاجيةٍ أو نُطقِية، خِلافا للنظرَة الفِسيولوجيةِ للمَقطَع التي تُقَسِّمه إلى ثلاث درَجاتٍ من التوَتُّر في العَضَلات الخاصَّةِ بعَمَلية إنتاجِ الصوت، وهي: توَتُّرٌ متَصاعِدٌ growing tension، ونقطَةُ الذِّروَةِ في التوَتُّر، والتوتُّرُ المتَناقِصُ decreasing tension.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ذروة المقطع ","nonDiacriticsLemma":"ذروة المقطع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ذِرْوَةُ المَقْطَعِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

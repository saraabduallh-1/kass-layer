{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8aa47a08-17d2-414c-8b5d-abdd0c3f67c6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8aa47a08-17d2-414c-8b5d-abdd0c3f67c6","word":"مُنَاظِرَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ff1","lexicalEntryId":"8aa47a08-17d2-414c-8b5d-abdd0c3f67c6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُنَاظِرَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ معجَميٌّ دلاليٌّ، يَعني أن كلمةً في لغةٍ ما تُناظِر كلمةً أخرى في لغةٍ أخرى من حيث المعنى، مثلُ كلمةِ: (باب) في العربية التي تُناظِر كلمةَ: door في الإنجليزية. وقد تَتَناظَر الكلمَتان في المعنى العامِّ وتختَلِفان في المعنى الحَقيقِيِّ من حيث العُمومُ والخُصوصُ، والمعاني الجانِبِيةُ، والمفاهيمُ الثقافية؛ وقد تتَناظَران في جانبٍ وتختَلِفان في جانبٍ أو جوانِبَ أخرى، وهذه هي المناظَرَةُ الجُزئيَّةُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"مناظرة ","nonDiacriticsLemma":"مناظرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُنَاظِرَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/edb50c47-336e-4482-8ca5-ed85bb58c1bc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"edb50c47-336e-4482-8ca5-ed85bb58c1bc","word":"تَحْلِيلُ الأَخْطَاءِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ff2","lexicalEntryId":"edb50c47-336e-4482-8ca5-ed85bb58c1bc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ الأَخْطَاءِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهجٌ لغويٌّ تطبيقيٌّ يُعنَى بدراسة الأخطاءِ اللغويةِ لمتعلِّمي اللغاتِ الأجنَبية، وتَصنيفِها ووَصفِها وتحليلِها وتفسيرِها، بهَدَف تحسين العَمَليةِ التعليمية، ويُطبَّق أحيانا في اللغات الأمِّ. وهو أحَدُ ميادينِ علمِ اللغةِ التطبيقي؛ عُرِف منذ منتَصَفِ القرنِ العشرين، وارتَبَط - في بدايته - بالتحليلِ التَّقَابُلِيِّ contrastive analysis، ثم استَقَلَّ عنه بعد أن تطوَّرَت بعضُ مناهِجِه، وأصبَحَت جُزءًا من مناهِج البَحثِ في اللغة المرحَلية. وتُظهِر دراساتُ تحليلِ الأخطاءِ أن المتعلِّمَ يَقَع في هذه الأخطاءِ لأسبابٍ مختَلِفة؛ كالجَهل بالقاعِدَة أو بقُيُودها، والمبالَغَةِ في تَطبيق القاعِدَة، والتَّبسيط، والتَّعمِيم، وتَدَخُّل اللغةِ الأمِّ في اللغة الهَدَف، وانتِقالِ أثَرِ التَّدريب. ونتيجةً لتطَوُّر المناهِجِ المعرِفيةِ الفِطرِيةِ في اكتساب اللغة، لم يَعُد تحليلُ الأخطاءِ هَدَفا بذاته، أو وَسيلَةً لتَحسين العَمَليةِ التعليميةِ وحَسب، بل أصبَح منهَجا للبحث في عَدَدٍ من الظواهِر اللغويةِ في اللغة المرحَليِة ودراساتِ النُّمُوِّ اللغوي. ويمكن استخدامُ تحليلِ الأخطاءِ في دراسة النُّمُوِّ اللغويِّ لدى الناطقين باللغةِ بجانِبَيها المنطوقِ والمكتوب. وفي السنوات الأخيرَةِ، أصبَح هذا المنهَجُ ضِمنَ تَطبيقاتِ مُدوّناتِ المتعلِّمين learner corpus، الذي هو أحَدُ أنواعِ المدوّناتِ اللغوية، الذي لا يقتَصِر على تحليل الأخطاءِ، وإنما يتعَدَّى ذلك إلى رَصْد النُّمُوّ اللغويِّ المرحَلِيِّ لدى متعلِّمي اللغة. راجع:  @(corpus) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل الأخطاء ","nonDiacriticsLemma":"تحليل الأخطاء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ الأَخْطَاءِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5d36441d-47ef-4e61-af19-069c7d9982fe/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5d36441d-47ef-4e61-af19-069c7d9982fe","word":"تَصْنِيفُ الأَخْطَاءِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ff3","lexicalEntryId":"5d36441d-47ef-4e61-af19-069c7d9982fe","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَصْنِيفُ الأَخْطَاءِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مرحَلةٌ من مراحِل دراسةِ الأخطاءِ أو تَحليلِ الأخطاءِ التي يَقَع فيها متعلِّمو اللغة الثانية، وهي مرحَلةٌ تَلِي مرحَلةَ جَمعِ الأخطاء. وتَصنيفُ الأخطاءِ أنواعٌ: منها ما هو بحسَب نَوعِ الخَطأِ، كأن تُصنَّف إلى صوتية وصرفيةٍ ونحويةٍ ودلالية؛ ومنها ما هو بحسَب أسبابِها، كأن تُصنَّف إلى الجَهل بالقاعدة، وتَعميمِ القاعدة، والتَّطبيقِ الناقِصِ للقاعدة، والتبسيط؛ ومنها ما هو بحسَب كَونِها أخطاءً تَطوُّرِيَّةً داخِلَ اللغةِ الهَدَف، أو أخطاءَ تدَخُّلِ اللغةِ الأمِّ في اللغة الهَدَف؛ ومنها ما هو بحسَب درَجَةِ شُيوعِ الخَطأ. وقد يكون التَّصنيفُ بحسَب اللغاتِ الأمِّ للمتعلِّمين الذين تُجرَى عليهم الدراسةُ. ويُطلَق على تَصنيف الأخطاءِ أيضا error taxonomy.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تصنيف الأخطاء ","nonDiacriticsLemma":"تصنيف الأخطاء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَصْنِيفُ الأَخْطَاءِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

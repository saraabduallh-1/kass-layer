{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4e5eabf8-460a-48ac-b6f7-39cce0c5f814/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4e5eabf8-460a-48ac-b6f7-39cce0c5f814","word":"لُطْفُ التَّعْبِيرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9000","lexicalEntryId":"4e5eabf8-460a-48ac-b6f7-39cce0c5f814","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُطْفُ التَّعْبِيرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التَّلَطُّفُ في التَّعبير، وهو استعمالُ كلمةٍ أو عبارَةٍ لَطيفةٍ بدلا من كلمةٍ أو عبارَةٍ محظورَةٍ أو غيرِ لائقةٍ اجتماعيا؛ كاستعمال عبارَةِ: (انتَقَل إلى رحمة الله)، بدلا من: (ماتَ)، وعبارَةِ: (قَضاء الحاجَة)، بدلا من: (غائط)، علما بأن الأخيرَةَ كانت في الأصل لَفظَ تَلَطُّفٍ، إذ كانت تَعني المنخَفضَ من الأرض. ومنه استعمالُ عبارَةِ: pass away في الإنجليزية بدلا من: die، وكلمةِ: indisposed بدلا من: sick. ويُطلَق على اللَّفظ المتروكِ، أو المحظورِ استعمالُه، أو المستَبدَلِ به اللَّفظُ اللَّطِيفُ، مصطلحُ: taboo.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لطف التعبير ","nonDiacriticsLemma":"لطف التعبير","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُطْفُ التَّعْبِيرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

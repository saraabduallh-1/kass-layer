{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7072b3d2-7eac-48dc-bb78-824498838961/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7072b3d2-7eac-48dc-bb78-824498838961","word":"الفَاعِلُ المُضْمَرُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9844","lexicalEntryId":"7072b3d2-7eac-48dc-bb78-824498838961","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الفَاعِلُ المُضْمَرُ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"الفاعِلُ الفارِغُ الذي لا يُذكَر بارِزًا في مواضِعَ معيَّنَةٍ في بعض اللغاتِ كالعربية والإسبانيةِ والإيطالية، التي تُسمى لذلك لُغاتٍ ذاتَ فاعلٍ فارِغٍ null-subject languages، خلافا لبعض اللغات كالإنجليزية والفرنسية، حيث يجب إظهارُ الفاعِل؛ ولهذا تُسمّى لغاتٍ ذاتَ فاعِلٍ غيرِ فارِغ non-null subject languages. والاختِلافُ بين اللغاتِ في حَذف الفاعِلِ وإظهارِه موضوعٌ مهمٌّ في اكتساب اللغة، حيث يُعَدُّ حَذفُ الفاعِلِ، أو حذفُ الضميرِ الفاعلِ، مخالِفا للقواعد الكُلِّيَّةِ في نَظَر اللغويين المعرِفيين، ومن ثَمَّ فإن اكتِسابَ الجُملةِ مَذكورَةِ الفاعِلِ أيسَرُ من اكتساب الجُملَةِ التي حُذِف فاعِلُها، ويتَرتَّب على ذلك - في نظرهم - أن انتِقالَ متعلِّم اللغةِ الثانيةِ من النَّمَط الثاني إلى الأوّل أصعَبُ من انتِقاله من الأوّل إلى الثاني. راجع:  @(pro-drop language) و  @(pro-drop parameter) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الفاعل المضمر ","nonDiacriticsLemma":"الفاعل المضمر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/108eb266-e20b-4f54-8fa1-24bf81088a44/get-public-entry"},"browse_index_record":{"lexicalEntryId":"108eb266-e20b-4f54-8fa1-24bf81088a44","word":"ثَقافَةٌ شَفَهِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9840","lexicalEntryId":"108eb266-e20b-4f54-8fa1-24bf81088a44","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ثَقافَةٌ شَفَهِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الثقافةُ والمفاهيمُ الثقافيةُ التي يتوارَثُها الناسُ في مجتَمَعٍ ما، ويَتَدَاولونها تَداوُلًا شَفَهيًّا غيرَ مَكتوب، ومنها الأدبُ الشفهيُّ. تَنتَشِر الثقافاتُ الشفهيةُ في البيئات الأمِّيَّة، وفي المجتَمَعات التي لا تَعتَمِد على الكتابة، أو التي لغاتُها غيرُ مَكتوبَة. قد تكون الثقافةُ شَفَهيةً في جانبٍ واحدٍ من جوانِبها، كالقصَّة أو الرِّواية مثلا، في حين تَبقى الجوانبُ الأخرى مَكتوبةً، أو تكون الثقافةُ شَفَهِيةً في مرحَلةٍ أو مراحِلَ زمنيَّةٍ محدَّدَة، أو في مستوًى من مستويات اللغةِ، كالثقافة الشَّعبيةِ في العامِّيَّاتِ العربيةِ المحكِيَّة. راجع:  @(oral literature) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ثقافة شفهية ","nonDiacriticsLemma":"ثقافة شفهية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ثَقافَةٌ شَفَهِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

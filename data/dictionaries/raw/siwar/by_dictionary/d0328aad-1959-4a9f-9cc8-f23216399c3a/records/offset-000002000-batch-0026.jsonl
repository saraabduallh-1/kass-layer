{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7b50e07b-1f2d-4b5b-aed9-3a34b7a886bd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7b50e07b-1f2d-4b5b-aed9-3a34b7a886bd","word":"كَلامٌ غَيرُ رَسْمِيٍّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92be","lexicalEntryId":"7b50e07b-1f2d-4b5b-aed9-3a34b7a886bd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلامٌ غَيرُ رَسْمِيٍّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوعٌ من الكلام المستَعمَلِ في الحياة اليَوميةِ العادِية، لا يلتزم بالأساليب الرَّسمِية؛ كالكلام الذي يجرِي بين الأصدِقاء، أو بين أفرادِ العائلَة. وهذا النوعُ من الكلام معروفٌ لدى الناطقين باللغة، لكن يَصعُب على الأجنبَيِّ تَميِيزُه من الكلام الرَّسميِّ؛ لارتِباطه بالثقافة المحلِّيَّة، وبطبيعةِ المقامِ الاجتماعيِّ الذي يُقال فيه، وببعض الأساليبِ التَّداوُلية. ويُسمّى أحيانا الكلامَ العامِّيَّ؛ لأن الغالبَ فيه الاستعمالُ العامِّيُّ الدّارج. راجع:  @(colloquial speech) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلام غير رسمي ","nonDiacriticsLemma":"كلام غير رسمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلامٌ غَيرُ رَسْمِيٍّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/59de0639-cc03-4490-a07b-b41231e46dfa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"59de0639-cc03-4490-a07b-b41231e46dfa","word":"مُخْبِرٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92bf","lexicalEntryId":"59de0639-cc03-4490-a07b-b41231e46dfa","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُخْبِرٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُطلَق على الرَّاوي، وهو الشخصُ الذي يقدِّم للباحث اللغويِّ معلوماتٍ للدراسة والتحليلِ عن اللغةِ المدروسَة. وتُجمَع المعلوماتُ من المخبِر بطَرح أسئلةٍ عليه، وتَسجيلِ كلامِه، أو تَدوينِه على شَكل ملحوظات. استُعمِل هذا المصطلحُ في الدراسات اللغويةِ الوَصفيةِ التي كانت تُجرَى في النصف الأوّل من القرن العشرين، حين كان اللغويون الوَصفيون يَعتَمِدون على المخبِر الناطقِ باللغةِ المدروسة، أو الرّاويَةِ، في تَقعيد اللغاتِ غيرِ المكتوبةِ في أفريقيا وأمريكا الجنوبيةِ وشَرقِ آسيا. وقد دُرِسَت بعضُ اللَّهَجاتِ العربيةِ وقُعِّدت في ضَوء هذا المعيار.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ سَردِيٌّ، يُطلَق على من يَبُثُّ معلوماتٍ من غير وَعي، أو من يُستَشهَد بكلامه، فيُصبح كلامُه الخاصُّ وَسيطا يخدِم مستوًى أعلى منه، ويكون أساسًا لما يَبنيه شَخصٌ آخَر، وهو بهذا المعنى السَّردِيّ يختَلف عن كل من الرَّواي والمؤلِّف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"AS","root":null,"wordForms":[],"relatedSenses":[],"searc
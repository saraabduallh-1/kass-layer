{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1bdec6b1-55f0-4527-9f9e-c2b99c64d2af/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1bdec6b1-55f0-4527-9f9e-c2b99c64d2af","word":"الفَرْضِيَّةُ الفِطْرِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92b5","lexicalEntryId":"1bdec6b1-55f0-4527-9f9e-c2b99c64d2af","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الفَرْضِيَّةُ الفِطْرِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضيةٌ أو نظريةٌ في اكتساب اللغة، تزَعَّمَها تشومسكي وأتباعُه؛ ترى أن اللغةَ فِطرَةٌ إنسانيةٌ؛ أي إن الطفلَ يولَد ولدَيه قُدرَةٌ فِطريةٌ على اكتساب اللغة، من غير حاجَةٍ إلى تعليمٍ أو توجيهٍ أو تَصويب. هذه القُدرَةُ متَشابِهةٌ عند جميعِ الأطفالِ على اختلاف بيئاتِهم اللغويةِ والاجتماعيةِ والثقافيةِ، وتخضَع للكلِّيَّات اللغويةِ أو القواعدِ الكُلِّيةِ التي توجَد في جميع اللغاتِ البشَرية. راجع:  @(linguistic universals) و  @(Universal Grammar (UG)) و  @(logical problem of language acquisition) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الفرضية الفطرية ","nonDiacriticsLemma":"الفرضية الفطرية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الفَرْضِيَّةُ الفِطْرِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/79e8db71-93b0-495c-87b7-43f9c44937e9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"79e8db71-93b0-495c-87b7-43f9c44937e9","word":"التَّعْلِيمُ في أثَنَاءِ الخِدْمَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92b6","lexicalEntryId":"79e8db71-93b0-495c-87b7-43f9c44937e9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّعْلِيمُ في أثَنَاءِ الخِدْمَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التعليمُ الذي يتلَقّاه المعلِّمُ في أثناء عَمَلِه في التدريس، ويُعَدّ جُزءا من تأهيله ورَفعِ كِفايَتِه المِهنِية. كأن يتَلَقَّى معلِّمُ اللغةِ دَورَةً في اختِبارات اللغة، أو دَورَةً في تعلُّم اللغةِ بمساعَدَة الحاسوب CALL، أو يأخُذَ مقرَّراتٍ جامِعيةً في مناهِج البحثِ في اكتساب اللغة. ويُقابِله التعليمُ قبلَ الخِدمَةِ pre-service education، وهو ما يتَلَقّاه الطالبُ المعلِّمُ في الجامِعة من عُلومٍ ومعارِفَ وتدريباتٍ قبلَ التِحاقِه بمهنَة التدريس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التعليم في أثناء الخدمة ","nonDiacriticsLemma":"التعليم في أثناء الخدمة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّعْلِيمُ في أثَنَاءِ الخِدْمَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e6eaaad9-3383-4629-8506-a33a28aa0653/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e6eaaad9-3383-4629-8506-a33a28aa0653","word":"فُرُوقٌ فَرْدِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92b2","lexicalEntryId":"e6eaaad9-3383-4629-8506-a33a28aa0653","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فُرُوقٌ فَرْدِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الفُروقُ التي تكون بين المتعلِّمين، ولاسيَّما بين متعلِّمي اللغةِ الثانيةِ أو الأجنبيةِ في الجوانبِ الشَّخصيةِ، والعَقليةِ المعرِفيةِ، والثقافيةِ، والاجتماعيةِ، وفي الخَلفياتِ اللغويةِ، وغيرِها مما يُعتَقَد أنه أحَدُ الأسبابِ في اختلاف المتعلِّمين وتفاوُتِهم في النجاح أو الفَشَلِ في تعلُّم اللغةِ الهَدَفِ واكتسابِها. ومن أهمِّ الفُروقِ الفَرديةِ بين متعلِّمي اللغاتِ الأجنبيةِ اختلافُهم في: السِّنِّ، والذَّكاءِ، والذاكرَةِ، والاستِعدادِ اللغويِّ، والاتِّجاهاتِ والميُولِ نحوَ اللغةِ الهَدَفِ، وطَبيعةِ اللغةِ الأمِّ، والثنائيةِ اللغويةِ، ومستوى التعليمِ، والتَّنشِئةِ الاجتماعية، وتحمُّلِ الغُموض.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فروق فردية ","nonDiacriticsLemma":"فروق فردية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فُرُوقٌ فَرْدِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":
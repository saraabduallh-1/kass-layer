{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ed01c219-5d3d-4ed5-affc-9366173e3bb4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ed01c219-5d3d-4ed5-affc-9366173e3bb4","word":"تَجْرِيدٌ مِثَالِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b920f","lexicalEntryId":"ed01c219-5d3d-4ed5-affc-9366173e3bb4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَجْرِيدٌ مِثَالِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ يُشير إلى سُلوكٍ يَنتَهِجه اللغويُّ حين يتَجاهَل جوانبَ الاختِلافِ في الموادِّ اللغويةِ الخَامِ التي يَجمَعها من الناطقين باللغة المدروسَة؛ بهدَف الوُصولِ إلى تحليلٍ يمكن تَعميمُ نتائجِه قدرَ الإمكان. وقد طُبِّق هذا المنهَجُ في اللغويات التوليديةِ تحديدا، حيث يَعنِي استِخلاصَ الخصائصِ والسِّماتِ اللغويةِ النموذجيةِ التي تُشَكِّل النظامَ اللغويَّ النظريَّ للغةٍ مُعيَّنةٍ اعتِمادًا على الكِفايَة اللغويةِ المشتَرَكةِ لدى الناطقين بها، مجرَّدَةً من العوامِل الخارجيةِ التي تؤدِّي إلى تعَدُّد صُوَرِ الأداءِ أو الاستِعمالِ الفِعليِّ الذي قد تَشوبُه أخطاءٌ أو هفواتٌ أو زَلّاتُ لسان، أو يكون متَأثِّرا بمقامٍ معيَّن.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تجريد مثالي ","nonDiacriticsLemma":"تجريد مثالي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَجْرِيدٌ مِثَالِيٌّ"}],"lemmaLanguage":{"code":"ar","label":
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8744ecbb-c0e0-4224-9ae9-fcd4e545e8ee/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8744ecbb-c0e0-4224-9ae9-fcd4e545e8ee","word":"تَصْنِيفٌ أُفُقِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9203","lexicalEntryId":"8744ecbb-c0e0-4224-9ae9-fcd4e545e8ee","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَصْنِيفٌ أُفُقِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَصنيفُ اللَّهَجاتِ في اللغة الواحدةِ تَصنيفا أفُقيًّا جغرافيًّا؛ كتَصنيف لَهَجاتِ اللغةِ العربيةِ المعاصِرةِ إلى سعوديةٍ وعِراقيةٍ ومِصريةٍ وسوريّةٍ وفلسطينيةٍ وجزائريّةٍ ومَغرِبيّة، أو تَصنيفِ اللَّهجاتِ في السعودية إلى لهجاتِ نجدٍ والحجازِ والمنطقةِ الشرقيةِ وعَسير وجازان. يُقابِل هذا التَّصنيفَ التَّصنيفُ الرأسِيُّ الذي يُقَسِّم اللغةَ الواحدةَ إلى لهجاتٍ طَبَقِيَّة، مثلُ لغةِ الأطِباء، ولغةِ المهندسين، ولغةِ العُمَّال، ولغةِ المزارِعين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تصنيف أفقي ","nonDiacriticsLemma":"تصنيف أفقي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَصْنِيفٌ أُفُقِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bf67774d-d947-4827-8437-38d34c92ef2c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bf67774d-d947-4827-8437-38d34c92ef2c","word":"كِفَايَةٌ ثُنَائِيَّةٌ مِثَالِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9204","lexicalEntryId":"bf67774d-d947-4827-8437-38d34c92ef2c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كِفَايَةٌ ثُنَائِيَّةٌ مِثَالِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في التَّرجَمة، يُشير إلى شَرطٍ أو وَصفٍ من مُواصَفات المتَرجِم، وهي أن يملِك كِفايَةً تامَّةً في اللغَتَين الأصلِ والهدَف. استُمِدَّ هذا الوَصفُ من نظَريَّة تشومسكي في الكِفايَة المثَاليَّةِ لدَى الفَردِ بلُغَته الأمِّ، على الرُّغم من اختِلاف الحالَتَين، بالنَّظَر إلى أن تشومسكي مَيَّز بين هذه الكِفايَةِ والأدَاءِ الذي لا يمثُّل - في نظَره - هذه الكِفايَةَ في جميع الحالاتِ والمواقِفِ، وهذا ما لا يُقبَل في التّرجَمَة في كثيرٍ من الحالات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كفاية ثنائية مثالية ","nonDiacriticsLemma":"كفاية ثنائية مثالية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كِفَايَةٌ ثُنَائِيَّةٌ مِثَالِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8bd86adb-33aa-45b3-a866-23fc3e2b85af/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8bd86adb-33aa-45b3-a866-23fc3e2b85af","word":"رَمْزٌ فِكْرِيٌّ تَصَوُّرِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9205","lexicalEntryId":"8bd86adb-33aa-45b3-a866-23fc3e2b85af","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رَمْزٌ فِكْرِيٌّ تَصَوُّرِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"رَسمٌ دلاليٌّ أو رَمزٌ كتابيٌّ يُشير إلى فِكرَةٍ أو يدُلُّ عليها، ويُمَثِّل كلمةً أو رسالةً يُعَبِّر عنها بالصُّورة، ويَستَخدِم نظاما للكتابة في بعض اللغات؛ كالكتابة الصينيةِ، والكتابةِ الهيروغليفيةِ المصرية، مقارَنةً بالكتابة الأبجديةِ أو الألِفبائيةِ. مثالُ ذلك رَسمُ صُورةِ الشَّمسِ تُشرِق فَوقَ شَجَرةٍ للدّلالة على الشَّرق في اللغة الصينية. ويختَلِف هذا الرَّمزُ التَّصوِيريِّ المعبِّرُ عن الفِكرَة قليلا عن الرَّمز التصويريِّ المعبِّرِ عن الشيء المحسوسِ المرئيِّ، مثل رَسمِ صُورَةِ الفَرَس للدّلالة على الفَرَس في اللغة الصينيةِ أيضا، وهذا يُسمّى pictoram. راجع:  @(ideographic writing) و  @(alphabetic writing/notation) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"رمز فكري تصوري ","nonDiacriticsLemma":"رمز فكري تصوري","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رَمْزٌ فِكْرِيٌّ تَصَوُّرِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

"city":null},"lammaDetails":[{"form":"تَعْبِيرٌ اصْطِلاحِيٌّ مَسْكُوكٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

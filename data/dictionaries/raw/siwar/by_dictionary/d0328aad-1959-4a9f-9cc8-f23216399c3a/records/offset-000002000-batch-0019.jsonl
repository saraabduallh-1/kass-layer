{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/58228775-d950-4324-a8ba-fa1bc3988fba/get-public-entry"},"browse_index_record":{"lexicalEntryId":"58228775-d950-4324-a8ba-fa1bc3988fba","word":"تَمَاثُلٌ كِتَابِيٌّ فُونِيمِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91fc","lexicalEntryId":"58228775-d950-4324-a8ba-fa1bc3988fba","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَمَاثُلٌ كِتَابِيٌّ فُونِيمِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تماثُلُ الرُّموزِ الكتابيةِ لكلمةٍ ما مع رُموزها الفونيمية، ويَنطَبِق هذا التَّماثُل على كلمات اللغةِ العربيةِ باستثناء عَدَدٍ محدودٍ منها؛ كبعض أسماءِ الإشارَة، وبعضِ أسماءِ الأعلام، واللامِ الشَّمسية. ومن ذلك الكلمةُ الإنجليزيةُ: bet التي تُكتَب فونيميًّا: bet أيضا، خلافًا لكلماتٍ تختَلِف كتابتُها الفونيميةُ عن شَكلها في الكتابة العادِية، مثلُ كثيرٍ من كلمات اللغةِ الإنجليزية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تماثل كتابي فونيمي ","nonDiacriticsLemma":"تماثل كتابي فونيمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَمَاثُلٌ كِتَابِيٌّ فُونِيمِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/94ca7333-b311-4f8e-87b1-dfc9c9d69ac5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"94ca7333-b311-4f8e-87b1-dfc9c9d69ac5","word":"تَضَامٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91fd","lexicalEntryId":"94ca7333-b311-4f8e-87b1-dfc9c9d69ac5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَضَامٌّ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ في النحو الحديث، يُقصَد به تَضامُّ الكلماتِ في مجموعات مُترابِطة، أي العلاقة التي تربط عدَّةَ كلماتٍ متتابعَةٍ بعضها ببعض بشَكل تأليفيٍّ هرَمِيٍّ، يتكون من كلمةٍ أمٍّ، وكلماتٍ بناتٍ لها، لها متعَلّقاتٌ بها لا يمكن فَصلُها إلا بإنقاص معناها والإخلالِ بتركيبها. وتتألَّف الجُملةُ الكامِلةُ من عَدَدٍ من هذه المجموعات المتضامَّةِ بحيث يمكن تحديدُ أين تَنتَهي مجموعةٌ وأين تبدأ مجموعةٌ أخرى. ومن المجموعات: مجموعةُ الاسمِ التي تَضُمّ الاسمَ والأداةَ والنعتَ، ومجموعةُ الفعلِ التي تَضُمّ الفعلَ والحالَ والظرفَ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تضام ","nonDiacriticsLemma":"تضام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَضَامٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0f2cfa8f-fec4-44fb-a36a-300030590e08/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0f2cfa8f-fec4-44fb-a36a-300030590e08","word":"نَظَرِيَّةُ جونْسون","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93ef","lexicalEntryId":"0f2cfa8f-fec4-44fb-a36a-300030590e08","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ جونْسون","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويةٌّ نفسيةٌ عصَبيةٌ، تُفَسِّر حُدوثَ اللَّجْلَجَةِ أو التَّمْتَمَة stuttering لدى الطفلِ تفسيرًا سُلوكيًّا اجتماعيًّا. إذ يرى جونسون أن اللَّجْلَجَةَ تُصيب الطفلَ حين يكون لدى والِدَيْه خَوفٌ من حُدوثها لدَيه بالوِراثة؛ بسبَب حُدوثِها لأحَد والِدَيْه في صِغَره؛ فينعَكِس هذا الخَوفُ على سُلوك الوالِدَين مع الطفل. وقد يحدُث هذا مع الطالب حين يُركِّز المعلِّمُ على نُطقه ويَطلُب منه الدِّقَّةَ في النُّطق. وهذه النظريةُ مخالِفةٌ للرأي السائدِ من أن اللَّجْلَجَةَ تحدُث نتيجَةَ إصابةِ إحدى مناطِقِ اللغةِ في الدِّماغ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية جونسون ","nonDiacriticsLemma":"نظرية جونسون","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ جونْسون"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

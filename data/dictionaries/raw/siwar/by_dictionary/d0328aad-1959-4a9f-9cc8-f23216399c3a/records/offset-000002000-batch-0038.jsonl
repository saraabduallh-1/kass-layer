{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ef57e6d2-4880-47ab-bbfb-9f2fc778bf01/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ef57e6d2-4880-47ab-bbfb-9f2fc778bf01","word":"تَوَاصُلُ المَجْمُوعَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93de","lexicalEntryId":"ef57e6d2-4880-47ab-bbfb-9f2fc778bf01","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوَاصُلُ المَجْمُوعَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يَعنِي التواصُلَ بين مجموعاتٍ أو جَماعاتٍ من الناس أو بين شُعوبٍ مختَلِفةٍ لغويًّا أو اجتماعيًّا أو عِرقيًّا. وغالبا ما يَتمُّ التواصُلُ بين المجموعاتِ المختَلِفةِ بلُغةٍ مشتَرَكةٍ بينهم ليسَت لغةً أمًّا لمجموعةٍ منهم، وقد يكون التواصُل بلُغةٍ هَجِينٍ pidgin language أو لغةٍ مختلِطَةٍ mixed language. وهذا النوعُ من التواصُل مَوجودٌ في الهند، وإندونيسيا، ودوَلِ شَرقِ إفريقيا التي تتفاهَم باللغة السواحيلية، وفي المناطِق التي تكثُر فيها الجالياتُ الناطِقةُ بلغاتٍ مختَلِفةٍ، كدُوَل الخليجِ العربيِّ. راجع:  @(Lingua Franca) و  @(pidgin (language)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تواصل المجموعات ","nonDiacriticsLemma":"تواصل المجموعات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَوَاصُلُ المَجْمُوعَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0
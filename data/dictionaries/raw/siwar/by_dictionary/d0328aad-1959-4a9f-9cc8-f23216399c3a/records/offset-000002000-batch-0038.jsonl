{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6e105e3d-2247-4ac1-8784-643924a49f60/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6e105e3d-2247-4ac1-8784-643924a49f60","word":"فَاصِلٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93eb","lexicalEntryId":"6e105e3d-2247-4ac1-8784-643924a49f60","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَاصِلٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"خَطٌّ أو فاصِلٌ لغويٌّ أو لَهَجيٌّ، يُبَيِّن على الأطلَس اللغويِّ حُدودَ المنطقةِ التي يَظهَر فيها مَعْلَمٌ لغويٌّ ما؛ فيتَبيَّن فيه التوزيعُ الجغرافيُّ للمعالِم اللغويةِ التي تُميِّز اللغاتِ أو اللَّهَجاتِ داخِلَ اللغةِ الواحدة. وهو خَطٌّ يقوم على بياناتٍ إحصائية، لكنه غيرُ ثابِتٍ في الغالب. ويُقَسَّم هذا الخَطُّ - بالنظر إلى المعالِم - أقسامًا، منها: الخَطُّ الصوتيٌّ، والخَطُّ النَّغميُّ، والخَطُّ المورفيميُّ، والخَطُّ التركيبيُّ، والخَطُّ الدّلاليُّ، والخَطُّ اللغويُّ الثقافيُّ. ويُسمّى أحيانًا: isoglottic line، كما يُسمّى أيضا: isograph، على الرَّغم من صُعوبة تحديدِ هذا الخَطِّ بين لغَتَين أو لهجَتَين. ويُقصَد بهذا المصطلحِ أحيانا التَّماثُلُ اللغويّ، أي السِّمةُ اللغويةُ المشترَكةُ بين بعضِ متكلِّمي لغةٍ ما وإن اختَلَفت لهَجاتُهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فاصل لغوي ","nonDiacriticsLemma":"فاصل لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَاصِلٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/690e66ef-2e23-44ed-a710-c32dcda4c9e8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"690e66ef-2e23-44ed-a710-c32dcda4c9e8","word":"مَفْعُولٌ به مُبَاشِرٌ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e98","lexicalEntryId":"690e66ef-2e23-44ed-a710-c32dcda4c9e8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَفْعُولٌ به مُبَاشِرٌ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المفعولُ به الذي يَقَع عليه الفعلُ ويؤثِّر فيه تأثيرا مباشِرا أقوى من تَأثيره على المفعول به غيرِ المباشِر. فكلمةُ: (قَلَمًا) في جُملة: أعطيتُ محمدًا قَلَمًا، هي المفعولُ به المباشِر؛ لأنه هو الذي أُعطِي لمحمد، ومحمدٌ هو المفعولُ به غيرُ المباشِرِ لأنه المُعطَى أو المتسلِّم، وعبارةُ: the book هي المفعولُ به المباشِرُ في الجُملة الإنجليزيةِ: I gave Sami the book. وتَعْدِيَةُ المفعولِ به المباشِرِ بواسِطَة أفعالِ المَنْحِ والعَطاءِ dative verbs، مباشَرَةً أو بحَرف جَرٍّ، مما تختَلِف فيه اللغاتُ من حيث أصلُ التَّعدِيةِ المباشِرَة (بغير حَرفِ الجَر)، وإمكانُ التَّناوُبِ بينهما dative alternation، ونَوعُ القُيودِ على التَّعديةِ المباشِرَةِ وعلى التَّناوُب؛ فالعربيةُ تعتَمِد في ذلك على معنى الفِعل، في حين تعتَمِد الإنجليزيةُ على عَدَد المقاطِعِ الصوتيةِ للفِعل وعلى معناه أيضا. راجع:  @(indirect object) و  @(dative case) و  @(dative alternation) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مفعول به مباشر  ","nonDiacriticsLemma":"مفعول به مباشر ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَفْعُولٌ به مُبَاشِرٌ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

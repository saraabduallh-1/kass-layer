{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/28bfb8f7-93fd-4065-8944-2e00b160065a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"28bfb8f7-93fd-4065-8944-2e00b160065a","word":"تَحْلِيلُ الحِوَارِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e96","lexicalEntryId":"28bfb8f7-93fd-4065-8944-2e00b160065a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ الحِوَارِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، يَعنِي دراسةَ طبيعةِ الحِوارِ وتركيبِه بوَصفه عَمَليةَ تَبادُلِ رسائلَ بين شَخصَين أو بين الإنسانِ والحاسوب، وكيفية تَطبيقِ نتائجِ هذه الدراسةِ في مجالاتِ استعمالِ اللغةِ الطبيعيةِ في الحاسوب، مثلُ وَسائطِ التخاطُبِ بين الإنسانِ والحاسوب. ويتناوَل تحليلُ الحِوارِ تحليلَ الكلامِ من حيث أغراضُ المشاركين في المحادَثة وآراؤهم فيها، وتأثِيرُ الكلامِ في المستَمِع، ونحوُ ذلك من جوانب الاستعمالِ التَّداوُلي، ويَتناوَل أيضا دراسةَ خطَطِ المتكلِّمِ لتَحقيق غَرَضِه من كلِّ جُملَةٍ يقولها لتَحويل ذلك إلى برنامَج حاسوبيٍّ يتصرَّف فيه الحاسوبُ في الحِوار بطريقَةٍ اصطِناعِيةٍ ذَكية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل الحوار ","nonDiacriticsLemma":"تحليل الحوار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ الحِوَارِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v
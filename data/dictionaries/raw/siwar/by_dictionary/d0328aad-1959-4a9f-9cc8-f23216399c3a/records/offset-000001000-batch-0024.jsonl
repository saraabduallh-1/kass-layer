{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eb567091-b09e-4ffe-930c-7d3e27f130d5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eb567091-b09e-4ffe-930c-7d3e27f130d5","word":"تَوْزِيعٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ea6","lexicalEntryId":"eb567091-b09e-4ffe-930c-7d3e27f130d5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوْزِيعٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"السِّياقاتُ اللغويةُ التي يمكن أن يَرِد فيها عنصُرٌ لغويٌّ، وتَأثيرُ هذه السِّياقاتِ فيه، والسِّياقاتُ التي لا يمكن أن يَرِد فيها؛ سواء أكانت هذه العناصِرُ فونيماتٍ أم مقاطِعَ أم مورفيماتٍ أم كلمات. فالفونيمُ: /ng/ لا يَقَع في الإنجليزية في بدايَة الكلمة، وإنما يَقَع في نهايتها، نحو: sing، ولكنه يَقَع في هذا الموقِعِ في لغاتٍ أخرى كالكانْتُونِية في الصين. وفي العربية لا تَرِد السِّينُ مع الصَّاد، ولا يَدخُل حَرفُ الجَرِّ على الأفعال، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"توزيع ","nonDiacriticsLemma":"توزيع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَوْزِيعٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/29949bb4-9b8b-490f-a6d9-c5e6bfd04d0d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"29949bb4-9b8b-490f-a6d9-c5e6bfd04d0d","word":"عُسْرُ القِرَاءَةِ النَّمَائِيُّ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ea7","lexicalEntryId":"29949bb4-9b8b-490f-a6d9-c5e6bfd04d0d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عُسْرُ القِرَاءَةِ النَّمَائِيُّ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبِيٌّ، يُسمّى أيضا عمَى الكلمةِ الخِلقيَّ congenital word blindness أو عَجزَ القراءةِ النوعِيَّ specific reading disability، ويُعَد أكثرَ اضطراباتِ التواصُل شُيوعاً لدى طلابِ المدارس، بصَرف النَّظرِ عن مستويات الذَّكاء.   ويُعاني المصابُ به من صعوبَةٍ شديدةٍ في القراءة الجَهريةِ وفي رَبط الصوتِ والمعنى بالكلمات المكتوبَة، وكثيرا ما تَلتَبِس على المصاب الكلماتُ؛ فيَقلِب الأحرُفَ المتَشابِهَةَ في الشكل، وقد يُخطئ في لَفظ الفونيماتِ في القراءة الجَهرية، ويَظهَر لدَيه ضَعفٌ في النحو المكتوب، وخَلَلٌ في استيعاب القراءةِ، واضطِراباتٌ في الكتابة، وظُهُورُ أحرُفٍ مَعكوسَةٍ أو مُكرَّرَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عسر القراءة النمائي  ","nonDiacriticsLemma":"عسر القراءة النمائي ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عُسْرُ القِرَاءَةِ النَّمَائِيُّ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2452e1ec-e07e-4ca1-b1d8-725d8844607c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2452e1ec-e07e-4ca1-b1d8-725d8844607c","word":"خِلالَ لَهَجِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ea8","lexicalEntryId":"2452e1ec-e07e-4ca1-b1d8-725d8844607c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"خِلالَ لَهَجِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"بادئةٌ أو سابِقةٌ شائعةُ الاستِعمالِ في الدراسات اللغويةِ الاجتماعية، تُشير إلى ما له علاقةٌ باللَّهجَة dialect أو الدراساتِ اللَّهَجيةِ أو الازدِواجِ اللَّهَجِيِّ dialinguistics، أو العلاقةِ بين مستَوَيَين، أو الازدِواجِيَّةِ اللغوية. ومنه مصطلحاتُ التَّنوُّعِ اللغويِّ النوعيِّ diatype، واللَّهجَةُ dialect، والترابطُ اللَّهَجيُّ أو النظامُ المزدَوَجُ diasystem، والبَدَلُ اللَّهَجيُّ أو تَنوُّعاتُ نُطقِ الفونيمِ في لهجَتَين diaphone، وتَنوُّعاتُ المورفيمِ diamorph، ونحوِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"خلال لهجي ","nonDiacriticsLemma":"خلال لهجي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"خِلالَ لَهَجِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/35ab0e66-4ce6-456a-a11e-0421d06f36ec/get-public-entry"},"browse_index_record":{"lexicalEntryId":"35ab0e66-4ce6-456a-a11e-0421d06f36ec","word":"عِلْمُ اللَّهَجَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ea9","lexicalEntryId":"35ab0e66-4ce6-456a-a11e-0421d06f36ec","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللَّهَجَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمٌ يدرُس تَنوُّعَ الاستعمالِ اللغويِّ داخِلَ اللغةِ الواحدة؛ كدراسة اختِلافِ نُطقِ كلمةٍ ما في لَهَجاتٍ مختَلِفة، ودراسةِ تنوُّعِ الكلماتِ المستَعمَلةِ لمعنى واحد في عَدَدٍ من اللَّهَجات. وقد تحوَّل علمُ اللهجاتِ إلى ميدانٍ واسِعٍ نتيجَةَ نُمُوِّ الدراساتِ اللغويةِ الاجتماعية، وتَنَوَّعَت ميادينُه، بعد أن كان مَقصورا على دراسة اللَّهَجاتِ الجغرافية. ويُطلَق على العالِم المتخَصِّصِ في دراسة اللَّهَجاتِ، أو الخَبِيرِ في اللَّهَجات، عالِمَ اللَّهَجاتِ dialectologist.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللهجات ","nonDiacriticsLemma":"علم اللهجات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللَّهَجَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

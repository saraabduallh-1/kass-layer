{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/54004537-afa5-4c03-b87c-6398438e339c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"54004537-afa5-4c03-b87c-6398438e339c","word":"القِرَاءةُ عَبرَ المَنهَجِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b89","lexicalEntryId":"54004537-afa5-4c03-b87c-6398438e339c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"القِرَاءةُ عَبرَ المَنهَجِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَذهَبٌ في إعداد المنهَجِ والمقرَّراتِ الدِّراسيَّة، يُرَكِّز على القراءة في عُموم مُقرَّراتِ المنهجِ الدراسيّ، ولا يَقتَصِر على تَدريس القراءةِ مُقرَّرًا مُنفَصِلًا عن المقرَّرات الأخرى؛ فيُراعَى في إعداد الموادِّ التَّعليميَّةِ في جميع المقرَّراتِ ما يُراعَى في القراءة من مُواصَفاتٍ في بناء النُّصوص، وتَدريجِها، وطَريقةِ القراءة، ومُستَوَياتِ الفَهم، ومَقرُوئيَّةِ النَّصِّ. هذا المذهبُ يُيَسِّر فَهمَ اللغةِ وفَهمَ مُحتَوَى المقرَّرات في آنٍ واحد، خِلافًا للقراءة المبنِيَّةِ على مَنهَج الموادِّ المنفَصِلَة؛ وقد طُبِّق في تَعليم اللغةِ عَبْرَ المنهَجِ language across the curriculum، وفي تَعليم الكتابةِ عَبْرَ المنهَجِ writing across the curriculum.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"القراءة عبر المنهج ","nonDiacriticsLemma":"القراءة عبر المنهج","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"القِرَاءةُ عَبرَ المَنهَجِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

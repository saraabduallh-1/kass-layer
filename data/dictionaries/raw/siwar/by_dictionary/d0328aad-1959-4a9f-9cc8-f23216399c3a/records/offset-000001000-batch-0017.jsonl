{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4a0a7b87-fd3e-458d-ab86-deebf149533a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4a0a7b87-fd3e-458d-ab86-deebf149533a","word":"لُغَةٌ مَيتَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8df5","lexicalEntryId":"4a0a7b87-fd3e-458d-ab86-deebf149533a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مَيتَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ غيرُ مستَعمَلةٍ في الكلام أو في الكلام والكتابةِ في أيّ مجتَمَع، وإن كانت مستَعمَلةً في الطُّقُوس الدِّينِية، أو يَقرَؤها المتخصِّصون فيها فقط؛ كالسّريانية واللاتينية والسَّنسِكريتية، وعَدَدٌ كبيرٌ من اللغات الأوروبيةِ التي قَضَت عليها اللاتِينِيةُ إبّانَ عَصرِ الإمبراطوريةِ الرّومانية، وكذلك لغات السكّان الأصليِّين في أستراليا والأمريكَتَين، التي حَلَّت محلَّها اللغاتُ الإنجليزيةُ والإسبانيةُ والبُرتُغالية. واللغةُ الميتةُ تُقابِلها اللغةُ الحيَّةُ التي تُستَعمَل في الكلام والكتابةِ والتعليمِ والإعلام، مثلُ العربيةِ والإنجليزيةِ والفرنسيةِ والفارسيةِ واليابانيةِ والصينيةِ وغيرها. وقد يُطلَق الوَصفُ على اللغة التي ما زالَت مستَعمَلة، وربما يتحَدَّث بها الناسُ لغةً أمًّا، لكن ملامِحَها قد تغيَّرَت ولم يَبقَ من أصلها سوى الاسم، أو إنها تَحمِل أسماء جديدةً تَرجِع كلُّها إلى اللغة الأمِّ أو اللغةِ الأصلِ، كاللاتِينِية مثلا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة ميتة ","nonDiacriticsLemma":"لغة ميتة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مَيتَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

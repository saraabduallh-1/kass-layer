{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d7dc903e-65d0-4e9e-8c26-b94eb97f113a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d7dc903e-65d0-4e9e-8c26-b94eb97f113a","word":"لُغَةٌ ثَقَافِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8deb","lexicalEntryId":"d7dc903e-65d0-4e9e-8c26-b94eb97f113a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ ثَقَافِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصْفٌ للُّغَة التي تَبرُز وتَشتَهِر بسبَب ما تحمِله من قِيَمٍ ثقافية، وقد تُدرَس في بلادٍ غيرِ بلادِها لهذه القِيَم. مثالُ ذلك اللغةُ العربيةُ التي تَحمِل تاريخا عَريقا في الثقافة والأدَبِ والفَنِّ إضافةً إلى قِيَمها ومعانيها الإسلاميةِ المقدَّسة، والفارِسيةُ التي انتَشَرت في كثيرٍ من البلاد الإسلامية، خاصةً في القارَّة الهندية، بسبَب ما تَحمِله من ثقافةٍ وأدَب، وكذلك الفرنسيةُ ذاتُ الثقافةِ العامَّةِ التي انتَشرَت في معظَم أنحاءِ العالَمِ، إضافةً إلى كَونها لغةً دبلوماسية. يُقابِل ذلك انتِشارُ اللغةِ بسبب قوَّتِها السياسيةِ أو الإعلاميةِ أو العسكريةِ أو العِلمية، كالإنجليزية مثلا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة ثقافية ","nonDiacriticsLemma":"لغة ثقافية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ ثَقَافِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7ea480d6-5a95-4b96-89ff-10cf12ba9e40/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7ea480d6-5a95-4b96-89ff-10cf12ba9e40","word":"نَظَرِيَّةُ الحِرْمَانِ الثَّقَافِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de2","lexicalEntryId":"7ea480d6-5a95-4b96-89ff-10cf12ba9e40","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ الحِرْمَانِ الثَّقَافِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ تصِف حالةَ الأطفالِ المنتَمِين إلى طبَقَةٍ فقيرَةٍ أو محرومَةٍ في المجتَمَع، الذين تَنقُصهم الخِبراتُ والميزاتُ التي تتَمتَّع بها غالبِيةُ الأطفالِ في المدرسة؛ ما يؤدِّي إلى صُعوباتٍ في التعلُّم والسَّيرِ مع أقرانهم في المدرسة. فالطفلُ الذي لا يَملِك حاسوبا، ولا ألعابا تعليمية، ولا يَرَى مكتبةً في منزله، قد يتخَلَّف دراسيا عن زملائه الذين يتمتَّعون بهذه الأشياء. لكن هذه النظريةَ انتُقِدَت لعَجزها عن تفسير ضَعفِ كثيرٍ من الطلاب وهم غيرُ محرومين ثقافيا، وهذا ما يؤكِّد أن الحِرمانَ الثقافيَّ الحقيقيَّ هو ما له عَلاقَة باللغة في المنزل أو في البيئة أو الطَّبَقة الاجتماعية التي يَنتَمي إليها الطفلُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية الحرمان الثقافي ","nonDiacriticsLemma":"نظرية الحرمان الثقافي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ الحِرْمَانِ الثَّقَافِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c222c723-5d5d-4e01-8a5f-882b99a38a41/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c222c723-5d5d-4e01-8a5f-882b99a38a41","word":"مَسَافَةٌ ثَقَافِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de3","lexicalEntryId":"c222c723-5d5d-4e01-8a5f-882b99a38a41","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَسَافَةٌ ثَقَافِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المسافةُ أو المسافاتُ بين ثقافَتَين، وغالبا ما يُقصَد بهما في علم اللغةِ التطبيقيِّ ثقافةُ اللغةِ الأمِّ للمتعلِّم وثقافةُ اللغةِ الهَدَفِ التي يتعلَّمها. ويؤكِّد اللغويون التطبيقيون أنه كلَّما قَرُبَت المسافةُ بين الثقافَتَين سَهُل إدراكُ المفاهيمِ الثقافيةِ للمفرَدات، وكلما بَعُدَت هذه المسافةُ صَعُب هذا الإدراكُ. فالكلمةُ العربيةُ الإسلاميةُ (مَهْر) وهو الحقُّ المعروفُ الذي يَدفَعه الزوجُ للمرأة التي يَرغَب الزواجَ بها، يَصعُب فَهمُ معناها في الثقافات الغربية، لكن يَسهُل فهمُ هذا المعنى لدى الناطقين بغير العربيةِ في الثقافات التي يكثُر فيها المسلمون حتى بين غيرِ المسلمين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مسافة ثقافية ","nonDiacriticsLemma":"مسافة ثقافية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَسَافَةٌ ثَقَافِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cc99c5b6-9cbf-4951-9a79-bb1a816ed417/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cc99c5b6-9cbf-4951-9a79-bb1a816ed417","word":"نَقْلٌ ثَقَافِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de4","lexicalEntryId":"cc99c5b6-9cbf-4951-9a79-bb1a816ed417","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَقْلٌ ثَقَافِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَقلُ الثقافةِ من جِيلٍ إلى آخَر داخلَ المجتَمَعِ الذي تَنتَسِب إليه هذه الثقافة، بالتعلُّم المباشِرِ وغيرِ المباشِر. واللغةُ (المعيَّنةُ) هي الأداةُ أو الوَسيلَةُ الطبيعية الأولى التي تَقوم بهذه الوَظيفَة، ولاسيَّما الجوانبُ الفِكريةُ منها؛ لأن اللغةَ وعاءُ الثقافة، خلافا لما يُعتَقَد من أن الثقافةَ تُورَث أو تَنتَقِل بطريقَةٍ جِينِيَّةٍ أو عِرقِيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نقل ثقافي ","nonDiacriticsLemma":"نقل ثقافي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَقْلٌ ثَقَافِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5d206667-9e29-4495-8f97-6d1fddb98d9e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5d206667-9e29-4495-8f97-6d1fddb98d9e","word":"مَجْمُوعَةٌ دَوْرِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de5","lexicalEntryId":"5d206667-9e29-4495-8f97-6d1fddb98d9e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَجْمُوعَةٌ دَوْرِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَفهومٌ دلاليٌّ يدخُل ضِمنَ التَّنافُرِ الذي هو أحَدُ أنواعِ العلاقاتِ بين مفرَداتِ اللغة، مثلُ أيامِ الأسبوعِ والشُّهورِ وفُصُولِ السنة. فكلُّ عُضوٍ في المجموعَة مَوضوعٌ بين اثنَين: أحدُهما قَبلَه والآخَرُ بَعدَه، من غير دَرَجاتٍ ولا رُتَب، ولا بدايَةٍ ولا نِهايَة. فيَومُ السبتِ قبلَه يومُ الجُمُعةِ وبعدَه يومُ الأحَدِ، ويومُ الجُمُعةِ قبلَه يومُ الخَميسِ وبعدَه يومُ السَّبتِ، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مجموعة دورية ","nonDiacriticsLemma":"مجموعة دورية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَجْمُوعَةٌ دَوْرِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/db5b26e3-b159-49dc-b64c-0980d7d30717/get-public-entry"},"browse_index_record":{"lexicalEntryId":"db5b26e3-b159-49dc-b64c-0980d7d30717","word":"اضْمِحْلالٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de6","lexicalEntryId":"db5b26e3-b159-49dc-b64c-0980d7d30717","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اضْمِحْلالٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ صوتيٌّ، يُشير إلى اضمِحلال الصَّوتِ، وهو التَّغَيُّر الذي يَطرأ على الصوت في أثناء سَيرِه في الوَسط الناقِلِ له، فيَميل إلى الغِلظَة وسُرعَةِ الفَناء؛ بسبب خَلَلٍ في مصدَر الصوتِ أو في الوَسط الناقِلِ له؛ فينتُج عن ذلك تَصادُمُ المَوجاتِ الصوتيةِ وتَفَرُّقُها. واضمِحلالُ الصوتِ يُعِيق فَهمَ المسموعِ لدى متعلِّمِ اللغةِ الأجنبية، وقد يؤثِّر في نُمُوِّ لغتِه في المهارات الأخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"اضمحلال ","nonDiacriticsLemma":"اضمحلال","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اضْمِحْلالٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0feb31d1-b166-4b5e-9404-a6167363f0b8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0feb31d1-b166-4b5e-9404-a6167363f0b8","word":"تَصْرِيحٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de7","lexicalEntryId":"0feb31d1-b166-4b5e-9404-a6167363f0b8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَصْرِيحٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على الأنماط والتراكيبِ اللغويةِ التَّصرِيحيةِ أو الإخبارِية، في مقابِل تراكيبِ النَّفْيِ والاستفهامِ والتَّعَجُبِ والطَّلَب، وتُسمّى صِيَغُها بالصِّيَغ الإخبارِيَّة declarative mode. راجع:  @(declarative sentence) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تصريح ","nonDiacriticsLemma":"تصريح","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَصْرِيحٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8b997579-f1e8-4b1e-b0f4-4d62b2188c88/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8b997579-f1e8-4b1e-b0f4-4d62b2188c88","word":"فَرضِيَّةُ العَجْزِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de8","lexicalEntryId":"8b997579-f1e8-4b1e-b0f4-4d62b2188c88","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرضِيَّةُ العَجْزِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضيةٌ لغويةٌ اجتماعيةٌ تربويةٌ اشتُهِرَت في الستينيات من القرن العشرين، ترَى أن لغةَ الأطفالِ المنتَمِين إلى الطَّبقات الاجتِماعيةِ الدُّنيا في مجتَمَعٍ ما غيرُ قادِرَةٍ على التَّعبير عن المعاني والأفكارِ المعقَّدَةِ نتيجَةَ النَّقصِ في مفرَدات هذه اللغةِ وقواعدِها؛ مما يُسبِّب تأخُّرَهم في المدرسة عن أقرانهم من الطَّبَقة الوسطى. وقد فرَّق التربويُّ البريطانيُّ بازل بِيرنستين Basil Bernstein، صاحبُ هذه الفَرضية، بين أسلوبَين أو شفرَتَين مختَلِفَتَين من اللغة يمتَلِكهما الأفرادُ في أي مجتَمَع، إحداهما شَفرَةٌ مقيَّدَةٌ restricted code، ذاتُ مفرَداتٍ ودلالاتٍ وتراكيبَ محدودَةٍ تصلُح للتواصُل مع أفرادٍ من خَلفيَّةٍ وتجاربَ مماثِلَةٍ فقط وفي موضوعاتٍ محدودَة، والأخرى شَفرَةٌ مفصَّلَةٌ أو موَسَّعَةٌ elaborated code، ذاتُ مفرَداتٍ ودِلالاتٍ وتراكيبَ واسِعَةٍ، قادِرَةٌ على التعبير عن موضوعاتٍ معقَّدَةٍ ومع طَبَقات اجتماعيةٍ مختَلِفة. أكَّد بِيرنستين أن أطفالَ الطَّبَقةِ المتوسِّطَةِ يَملِكون الشَّفرَتَين كلتَيهما، في حين لا يملِك أطفالُ الطَّبَقةِ الدُّنيا إلا الشَّفرَةَ الأولى. لكن بعضَ اللغويِّين لا يؤمنون بهذه الفَرضيةِ وما يَترتَّب عليها من تفسير، ويَستَبدِلون بها فَرضيةَ الاختلافِ التي تَعني أن كلَّ طَبَقٍة اجتماعيةٍ قادَرَةٌ على التَّعبير عن المعاني والأفكارِ المعقَّدَةِ بالطريقة التي تُناسِبها، وهي فرضيةٌ ترَى أن الاختِلافَ يكمُن في الفُرَص لا في القُدرات. راجع:  @(difference hypothesis) و  @(verbal deficit hypothesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية العجز ","nonDiacriticsLemma":"فرضية العجز","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرضِيَّةُ العَجْزِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

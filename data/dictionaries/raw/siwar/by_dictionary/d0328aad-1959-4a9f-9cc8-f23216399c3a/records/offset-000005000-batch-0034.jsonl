{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8bdbe670-cf13-4ddb-8760-b9959ec76d55/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8bdbe670-cf13-4ddb-8760-b9959ec76d55","word":"تَدْرِيبُ المُعَلِّمِينَ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f6c","lexicalEntryId":"8bdbe670-cf13-4ddb-8760-b9959ec76d55","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيبُ المُعَلِّمِينَ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَدريبُ المعلِّمين على مِهنَة التدريس، سواء أكان التَّدريبُ قبلَ الخِدمةِ pre-service training أم في أثنائها in-service training. وتَدريبُ المعلِّمين غالبا ما يَسبِقه تأهيلٌ عِلميٌّ وتَخصٌّصٌ تربوَيٌّ مِهنيٌّ. يُميِّز بعضُ التربويّين بين تَدريبِ المعلِّمين هذا وتَطويرِ المعلِّمين، باعتِبار أن الهَدَفَ من الثاني رَفعُ مستَوَاهم أو تعريفُهم بما يَجِدُّ من نظرياتٍ ومذاهبَ وتطبيقاتٍ في تخصُّصاتهم. ويتطلب تَدريبُ معلِّمي اللغاتِ إعدادَهم لغويًّا وتربويًّا ومِهنِيًّا، إضافةً إلى إلمامهم باللغة التي يُعَدُّون لتدريسها. راجع:  @(teacher education) و  @(teacher preparation) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريب المعلمين ","nonDiacriticsLemma":"تدريب المعلمين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيبُ المُعَلِّمِينَ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/422d2ac3-933b-4c71-a5d9-612b3c9b83db/get-public-entry"},"browse_index_record":{"lexicalEntryId":"422d2ac3-933b-4c71-a5d9-612b3c9b83db","word":"وَسَائِلُ تَعْلِيمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f6d","lexicalEntryId":"422d2ac3-933b-4c71-a5d9-612b3c9b83db","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَسَائِلُ تَعْلِيمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الوَسائلُ والأدواتُ التي يستَعمِلها معلِّمُ اللغةِ لتَيسير عمَليةِ التعليمِ والتعلُّم، وهي كثيرة؛ منها السّبورةُ واللَّوحاتُ والخرائطُ والصُّوَرُ والمجَسَّماتُ وأدواتُ التَّسجيلِ المسموعِ والمَرئيّ. وقد أصبَحَت هذه الوسائلُ تَقلِيديَّةً، فاستُبدِل بالسّبورة التقليديةِ السّبورةُ الذَّكيةُ، كما حلّت محلَّها ومحلَّ غيرها من الوَسائل التَّعليميةِ التَّقليديةِ تَقنياتُ التعليمِ الحديثةُ التي تُقَدَّم في برامج حاسوبية، ويَستَطيع المعلِّم بواسطتها تَقديمَ جميعِ أنواعِ الوَسائلِ التقليديةِ وتَقنياتِ التعليمِ الحديثةِ في آنٍ واحد؛ لهذا استُبدِل بها مصطلَحُ: teaching technology","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وسائل تعليمية ","nonDiacriticsLemma":"وسائل تعليمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَسَائِلُ تَعْلِيمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c4440d34-4520-43fb-be13-c9b30729a219/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c4440d34-4520-43fb-be13-c9b30729a219","word":"إشْرَافٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f6e","lexicalEntryId":"c4440d34-4520-43fb-be13-c9b30729a219","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إشْرَافٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ تعليميٌّ، يَعني مُراقَبةَ الموَجِّهِ أو المشرفِ لأداءِ المعلِّمِ وتَوجيهَه وتقيِيمَه. يختَلِف المربُّون في وَظيفة المشرفِ أو الموَجِّه؛ فيَرَى فريقٌ منهم أن وَظيفتَه الأساسَ هي تَقييمُ أداءِ المعلِّم، والتأكُّدُ من التِزامه بالسُّلوك التعليميِّ المطلوب، وتَنبِيهُه إلى ما يُخالِف ذلك. ويرى فريقٌ آخَرُ أن وَظيفتَه هي تقديمُ النُّصحِ للمعلِّم والتوجيههُ وإرشادُه، ومساعدتُه في تَنمِية مَهاراتِه التَّدريسيةِ وحَلِّ مُشكلاتِه من خلال المناقَشَةِ والإقناعِ والمراقَبَةِ الذَّاتية. وهذا الرأيُ هو المطبَّقُ حاليًّا في معظم برامجِ التعليم، حيث حَلَّ الإشرافُ أو التوجيهُ والمشرف أو الموجِّهُ محلَّ التَّفتيشِ والمفَتِّش.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"إشراف ","nonDiacriticsLemma":"إشراف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إشْرَافٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

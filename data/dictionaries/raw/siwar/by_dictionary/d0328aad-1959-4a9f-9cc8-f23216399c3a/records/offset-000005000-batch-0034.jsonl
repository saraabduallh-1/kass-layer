{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4aa17744-5021-435a-bb58-0e20e7c2c9ea/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4aa17744-5021-435a-bb58-0e20e7c2c9ea","word":"كِتَابُ المُعَلِّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f78","lexicalEntryId":"4aa17744-5021-435a-bb58-0e20e7c2c9ea","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كِتَابُ المُعَلِّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"كتابٌ مَوَجَّهٌ للمعلِّم، يُسمى أحيانا مُرشِدَ المعلِّم، يُرشِده إلى كَيفيَّة التدريسِ في برنامَجٍ معيَّن، ولاسيّما في تدريس الكتابِ المقرَّر. وهو مُهمٌّ في برامجِ تعليمِ اللغاتِ الأجنبيةِ خاصة؛ إذ يتضَمَّن توجيهاتٍ للمعلِّم حول أساليب التدريس، وإجراءِ التدريبات، واستِعمالِ تَقنياتِ التعليم، وتَنفيذِ الأنشِطةِ اللغويةِ داخلَ الصَّفِّ وخارجَه، وأساليبِ التقييم، ونحوِ ذلك. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كتاب المعلم ","nonDiacriticsLemma":"كتاب المعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كِتَابُ المُعَلِّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/379e6800-0bc9-4a14-9ba1-4882684f5c46/get-public-entry"},"browse_index_record":{"lexicalEntryId":"379e6800-0bc9-4a14-9ba1-4882684f5c46","word":"كَلامُ المُعَلِّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f79","lexicalEntryId":"379e6800-0bc9-4a14-9ba1-4882684f5c46","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلامُ المُعَلِّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغات، يُشير إلى لغةِ المعلِّمِ في قاعَة الدَّرس، وما تتَميَّز به من سِماتٍ وخَصائص؛ كوُضوح النُّطق، وتَبسيطِ المفرَداتِ والتراكيبِ والمفاهيمِ الثقافية، والتَّكرارِ، وإعادَةِ الصِّياغةِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"الكلامُ الذي يوَجِّهُه المعلِّمُ إلى طلابه في الفَصل، سواء أكان إلى فَردٍ أو مَجموعة، ونِسبةُ هذا الكلامِ إلى كلام الطلابِ الموَجَّهِ إليهم أو إلى الطلاب الآخَرِين في الفصل. وفي تعليم اللغة، يُفَضَّل أن يَقِلَّ كلامُ المعلِّمِ عن كلام الطلاب؛ لأن ذلك يَزيد من طَلاقَة الطلابِ في اللغة الهَدَف، ويَكشِف عن المشكلات التي تَعتَرِضهم، بل إن أداءَ المعلِّمِ يُقاس بقُدرَته على ضَبط كلامِه وتَقليلِه، وإتاحتِه فُرَصَ الكلامِ لطلابه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلام المعلم ","nonDiacriticsLemma":"كلام المعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلامُ المُعَلِّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b3a0ef22-dae6-4054-872b-2399cff7d07f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b3a0ef22-dae6-4054-872b-2399cff7d07f","word":"تَغيُّرٌ كَامِلٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f7a","lexicalEntryId":"b3a0ef22-dae6-4054-872b-2399cff7d07f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَغيُّرٌ كَامِلٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في الأصوات يُشير إلى حالاتٍ تتغيَّر فيها ساقُ الكلمةِ أو جِذرُها تَغيُّرًا كاملًا حين تتحوَّل إلى صِيغَة أخرى حتى لا تكاد تَلمَح أيَّ عَلاقَةٍ بينهما. مثال ذلك: good في الإنجليزية حين تُصاغ منها: better، أو:  best، وكذلك الفعلُ المضارع: go حين يَتحوَّل إلى الماضي went. ومن ذلك بعضُ الأفعالِ العربيةِ التي يَرِد منها الماضي من جِذرٍ غيرِ جذرِ المضارِع، مثل: يَذَرُ، ويَدَعُ. يُقابِل ذلك التَّغيُّرُ الجُزئيُّ partial suppletion، حيث يتَغيَّر جُزءٌ من الجِذر أو الجِذع، وهو الكثيرُ الغالبُ في اللغات، مثلُ: thought المتَغيِّرة من: think، ومنه تصريفُ الأفعالِ في العربية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تغير كامل ","nonDiacriticsLemma":"تغير كامل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَغيُّرٌ كَامِلٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

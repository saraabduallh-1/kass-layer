{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3f665649-1fe1-4e96-8094-0551217007d6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3f665649-1fe1-4e96-8094-0551217007d6","word":"فَرْضِيَّةُ سَابِير-وُورْف","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c77","lexicalEntryId":"3f665649-1fe1-4e96-8094-0551217007d6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرْضِيَّةُ سَابِير-وُورْف","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضِيَّةٌ تُعرَف بالنِّسبِيَّة اللغويّةِ Linguistic Relativity، أو الحَتمِيَّةِ اللغويّةِ Linguistic Determinism، وقد تكون اعتمَدَت عليهما، وتسمّى أيضا Whorfian Hypothesis؛ تُرَكِّز على تَأثير اللغةِ في التَّفكير، وتَرَى أن لغةَ الفَردِ هي التي تُحَدِّد إدراكَه للعالَم الخارِجِيِّ، وتُنَظِّم هذا العالَمَ في ذِهنه، وتؤكِّد أن البناءَ المعرِفيَّ لدى الأفرادِ يَختَلف باختِلاف لغاتِهم. راجع:  @(relativity) و  @(Linguistic Relativism/Relativity) و  @(eco-linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية سابير-وورف ","nonDiacriticsLemma":"فرضية سابير-وورف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرْضِيَّةُ سَابِير-وُورْف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ade64ff8-36e8-42c7-b422-2f954c494da2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ade64ff8-36e8-42c7-b422-2f954c494da2","word":"نَحْوٌ عِلْمِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c78","lexicalEntryId":"ade64ff8-36e8-42c7-b422-2f954c494da2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَحْوٌ عِلْمِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَحوٌ يَهتَمُّ بوَصف اللغةِ وَصفًا عِلمِيًّا دونَ النَظَرِ إلى تَعليمها. يَنطَبِق هذا الوَصفُ على دراسة النحوِ في المناهج اللغويةِ النظَريةِ الحديثة، ويَنطَبِق أيضا على النحو العَرَبيِّ التُّراثيِّ غيرِ الموجَّه تَوجيهًا تَعليميًّا، أي إن النحوَ العلميَّ يكون مِعيارِيًّا كما يكون وَصفيًّا. ويُقابِله النحوُ التَّعليمِيُّ أو النحوُ التطبيقيُّ. راجع:  @(school grammar) و  @(pedagogic(al) grammar) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نحو علمي ","nonDiacriticsLemma":"نحو علمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَحْوٌ عِلْمِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/23b23268-4f52-4f8d-ac25-96cac8be235e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"23b23268-4f52-4f8d-ac25-96cac8be235e","word":"البَحْثُ في اكْتِسَاب اللُّغَةِ الثَانيَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c79","lexicalEntryId":"23b23268-4f52-4f8d-ac25-96cac8be235e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"البَحْثُ في اكْتِسَاب اللُّغَةِ الثَانيَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المنهَجُ العِلميُّ المنظَّمُ في البَحث في اكتساب اللغاتِ الثانيةِ وتعَلُّمِها؛ يقَع ضِمنَ البَحثِ في علم اللغةِ التَّطبيقيِّ، ويرتَبِط بالبَحث في علم اللغةِ النَّفسيِّ وعلمِ اللغةِ الاجتماعيِّ ولِسانيّاتِ المدَوَّنات، ويُعنَى برَصد مراحِلِ النُّمُوِّ اللغويِّ في اللغة المرحَليّة لدَى الكِبارِ والصِّغارِ، ودراسَةِ مُشكِلاتِ التعلُّمِ والتعليم. استُخدِمَت فيه مناهِجُ البَحثِ العلميِّ، بنوعَيْها الكمِّيِّ والكَيفِيِّ، في جمع المادّةِ العلميةِ وتحليلِها، بَيدَ أن المنهَجَ الكَيفيَّ هو الغالِبُ في رَصد النمُوِّ اللغويِّ المرحَليِّ خاصَّةً. تطوَّر البَحثُ فيه تطوُّرًا سريعًا؛ فاعتَمَد على البرامِج الحاسوبيّة، والمدوَّناتِ اللغويّة. تميَّزَت مناهِجُ البَحث في اكتساب اللغةِ الثانيةِ بتأثيرها المباشِرِ في تعليم اللغةِ الثانية، وفي السياسَة اللغويّةِ والتَّخطيطِ اللغويِّ. راجع:  @(applied linguistics research) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"البحث في اكتساب اللغة الثانية ","nonDiacriticsLemma":"البحث في اكتساب اللغة الثانية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"البَحْثُ في اكْتِسَاب اللُّغَةِ الثَانيَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

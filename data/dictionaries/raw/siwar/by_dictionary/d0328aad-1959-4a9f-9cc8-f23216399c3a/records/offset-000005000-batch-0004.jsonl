{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/37977db7-4b33-4fc5-b25c-30b97e487aed/get-public-entry"},"browse_index_record":{"lexicalEntryId":"37977db7-4b33-4fc5-b25c-30b97e487aed","word":"الطَرِيقَةُ السّلامِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c64","lexicalEntryId":"37977db7-4b33-4fc5-b25c-30b97e487aed","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطَرِيقَةُ السّلامِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في الترجَمة الشَّفهية، يُشير إلى إجراءٍ يَلجأ إليه المترجِمُ الشَّفَهيُّ الفَورِيُّ في أثناء عمَليةِ الترجَمة، يتَمثَّل في تقسيم الجُملَةِ الطويلَةِ، حتى قبل الانتهاء منها أحيانًا، إلى جُمَلٍ قصيرَة؛ لتَسهيل ترجَمَتِها، وتَيسير فَهمِها. فكثيرا ما يَستَخدِم المتكلِّمون في المؤتَمرات واللِّقاءاتِ جُمَلا مُركَّبَةً ومُعَقَّدَةً، فيَلجأ المترجِمُ إلى تقسيمها إلى عدَدٍ من الجُمَل القَصيرَةِ التامَّة، ثم يربط بعضَها ببعض. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الطريقة السلامية ","nonDiacriticsLemma":"الطريقة السلامية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطَرِيقَةُ السّلامِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/21dd6acd-7d61-420f-a5fb-0d080afc0222/get-public-entry"},"browse_index_record":{"lexicalEntryId":"21dd6acd-7d61-420f-a5fb-0d080afc0222","word":"مَقاييسُ التَّصْنِيفِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c65","lexicalEntryId":"21dd6acd-7d61-420f-a5fb-0d080afc0222","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَقاييسُ التَّصْنِيفِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الطريقَةُ التي تُصنَّف بها كِفاياتُ متعلِّمي اللغاتِ الثانيةِ والأجنَبية، ابتداءً من الصّفر أو ما قَبلَ المرحلَةِ المبتَدِئة، وانتهاءً بتحقُّق الكِفايَةِ اللغويةِ المطلوبَة. تُقَسَّم مراحِلُ تعلُّمِ اللغةِ الهدَفِ إلى مستَوياتٍ تختَلِف باختِلاف بيئةِ اللغة، وأعمارِ المتعلِّمين، وغالبًا ما تُقَسَّم إلى المستوى المبتدئِ، فالمستوى المتوسِّطِ، فالمستوى المتقدِّمِ. وقد تُقَسَّم إلى مستوياتٍ فَرعيّةٍ أكثَرَ تفصيلًا، كتقسيم الإطارِ الأوروبيِّ المرْجِعِيِّ للّغات، الذي وَضعَه المجلِسُ الأوروبيُّ، واعتَمدَه كثيرٌ من مراكِز تعليمِ اللغاتِ الأجنَبية. ولتصنيف الطلابِ في هذه المستوَياتِ، أو ترقيَتِهم من مستوًى إلى آخَر، يُلجَأ إلى اختبارات الكِفايَة أو اختبارات التحصيل. راجع:  @(Common European Framework of Reference for Languages (CEFR)) و  @(Council of Europe) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مقاييس التصنيف ","nonDiacriticsLemma":"مقاييس التصنيف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","period
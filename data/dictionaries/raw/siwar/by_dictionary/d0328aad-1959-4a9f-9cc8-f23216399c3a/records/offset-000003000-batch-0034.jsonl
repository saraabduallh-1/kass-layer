{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/18b3c204-4162-44eb-a47f-4615b200de52/get-public-entry"},"browse_index_record":{"lexicalEntryId":"18b3c204-4162-44eb-a47f-4615b200de52","word":"المَادَّةُ العُنْقُودِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9766","lexicalEntryId":"18b3c204-4162-44eb-a47f-4615b200de52","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَادَّةُ العُنْقُودِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ معجَمِيٌّ، شاعَ استِعمالُه في لسانيّات المدوّناتِ اللغوية، يُسمّى أيضا الكلمةَ أو العُنصُرَ المفتاحَ node، ويُقصد به الكلمةُ أو العِبارةُ في المتَصاحِبات اللَّفظِيَّة حين تكون قَيْدَ الدِّراسةِ في النَّص المصاحِبِ co-text، وهي الكلمةُ التي تكون هي الأصلَ لحِساب الكلماتِ السابِقَةِ لها واللاحِقَةِ، المسمّاةِ بمؤشِّرات التَّصاحُبِ والتي تمتَدّ من 1-15 كلمةً بحسب مدَى التَّصاحُبِ للكلِمَة أو المادّةِ العُنقُودِية. راجع:  @(collocation) و  @(collocational range) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المادة العنقودية ","nonDiacriticsLemma":"المادة العنقودية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَادَّةُ العُنْقُودِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

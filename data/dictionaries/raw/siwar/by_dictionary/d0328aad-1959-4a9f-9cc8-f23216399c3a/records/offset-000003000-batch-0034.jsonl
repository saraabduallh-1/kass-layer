{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/faafe2ed-e1a3-4fed-a01a-73546b66cba1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"faafe2ed-e1a3-4fed-a01a-73546b66cba1","word":"صِيغَةٌ مُوَطَّنَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b976d","lexicalEntryId":"faafe2ed-e1a3-4fed-a01a-73546b66cba1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صِيغَةٌ مُوَطَّنَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"صيغةٌ أو كلمةٌ مقتَرَضَةٌ من لغةٍ أخرى فأصبَحَت جُزءًا من اللغة المقتَرِضَةِ حتى إنه لا يُفَرَّق بينها وبين صِيَغتِها الأصلية، مثلُ كلمةِ: cheer في الإنجليزية، ومثلُ عَدَدٍ كبيرِ من الكلمات العربيةِ (المعرَّبَة) ذاتِ الأصولِ الفارِسية، والكلماتِ الفارِسيةِ ذاتِ الأصولِ العربية. خلافا للصِّيغ أو الكلماتِ التي تبقى فيها سِماتُ اللغةِ الأصليةِ أو سِماتٌ ليسَت من سِمات اللغةِ المقتَرِضَةِ، مثلُ كلمةِ: rouge في الإنجليزية التي ما زالت تَحمِل سِماتِ الكلمةِ الفرنسية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صيغة موطنة ","nonDiacriticsLemma":"صيغة موطنة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صِيغَةٌ مُوَطَّنَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

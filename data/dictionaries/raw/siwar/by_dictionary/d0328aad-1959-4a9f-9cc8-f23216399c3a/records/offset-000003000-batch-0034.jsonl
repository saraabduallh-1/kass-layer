{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0ac20c3d-5465-44d7-a20e-d836c40b02b9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0ac20c3d-5465-44d7-a20e-d836c40b02b9","word":"أُنْمُوذَجُ التَّهْجِينِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b976c","lexicalEntryId":"0ac20c3d-5465-44d7-a20e-d836c40b02b9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ التَّهْجِينِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ اقترَحَه روبرت أندرسون Robert Anderson لوَصف ما يَحدث في اللغة المرحَلية، ويَعني به ما يَحدُث لمتعلِّم اللغةِ الثانيةِ حين يُفسِّر بعضَ أنظمةِ اللغةِ الهَدَفِ في ضَوء ما يَعرِفه عن لغته الأمِّ وعن العالَم من حوله، وهو نوعٌ من التَّبسيط الذي قد يؤدِّي إلى تهجِين لغةِ المتعلِّمِ أو تحَجُّرِها. لهذا الأنموذَجِ شَطرٌ آخَرُ مُرتَبِط بالتهجين وهو عَمَليةٌ سمّاها أندرسون denativization، ويَعني بها تَكيُّفَ المتعلِّمِ مع العوامل الخارجية، حين يُكَيِّف نظامَ لغتِه المرحَليةِ لِتُوائم المُدخَلَ اللغويَّ. يؤكِّد أندرسون أنه لا تَناقُضَ بين العَمَليَّتَين، وأنهما قد تؤدِّيان إلى نتيجَةٍ واحدة، هي التَّهجِينُ أو التحَجُّرُ اللغويُّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج التهجين ","nonDiacriticsLemma":"أنموذج التهجين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ التَّهْجِينِ"}],"lemmaLanguage":{
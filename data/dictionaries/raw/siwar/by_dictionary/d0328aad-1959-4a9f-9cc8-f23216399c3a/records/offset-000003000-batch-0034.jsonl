{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ac59d2ed-8324-480e-8234-3af63d28c1c9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ac59d2ed-8324-480e-8234-3af63d28c1c9","word":"لُغَةٌ أصلِيّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b977e","lexicalEntryId":"ac59d2ed-8324-480e-8234-3af63d28c1c9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ أصلِيّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ الأولى التي يَكتَسِبها الطفلُ في مراحِل طُفولَتِه المبكّرَة، وغالبا ما تكون لغةَ عائلَتِه أو لغةَ بيئتِه التي يَعيش فيها، وتُسمّى أيضا اللغةَ الوَطنيةَ أو اللغةَ الأصليَّة، في مُقابِل اللغةِ الثانيةِ واللغةِ الأجنبيةِ. يُستَثنى من ذلك حالاتٌ خاصَّة؛ كأن يتزامَن اكتسابُ الطفلِ منذُ ولادتِه لغةً أخرى غيرَ لغةِ عائلتِه وبيئتِه، وتَحدث هذه الحالةُ لأيِّ طفلٍ يقضي معظَمَ وقتِه في حضانةٍ خارجَ المنزلِ أو مع عائلَةٍ غيرِ ناطِقَةٍ بلغتِه الأصلية، أو يكون أحَدُ والدَيْه ناطِقًا بلغةٍ والآخَرُ ناطقًا بلغةٍ أخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة أصلية ","nonDiacriticsLemma":"لغة أصلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ أصلِيّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

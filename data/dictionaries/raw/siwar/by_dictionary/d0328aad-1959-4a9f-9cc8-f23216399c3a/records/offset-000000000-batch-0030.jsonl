{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/387e5af1-b55c-4388-ae3a-10aaefc7c086/get-public-entry"},"browse_index_record":{"lexicalEntryId":"387e5af1-b55c-4388-ae3a-10aaefc7c086","word":"الجِهَازُ العَصَبِيُّ المَرْكَزِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b31","lexicalEntryId":"387e5af1-b55c-4388-ae3a-10aaefc7c086","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الجِهَازُ العَصَبِيُّ المَرْكَزِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الجِهازُ العَصَبِيُّ الذي يتحَكَّم في حَرَكات الجِسمِ والتَّفكيرِ والشُّعور، وهو مُكوَّنٌ من أجزاء، أهمُّها: الدِّماغُ بجميع أجزائه ومناطِقِه اللغويةِ وغيرِ اللغوية، والنُّخاعُ الشَّوكِيُّ. وهذا الجهازُ هو أحَدُ ثلاثَةِ أجهِزَةٍ عَصَبِيَّةٍ تتحَكَّم في جِسم الإنسان، وهي: الجِهازُ العَصَبِيُّ المحِيطِيُّ أو الطَّرَفيُّ (غيرُ المركَزِي)، والجِهازُ العَصَبِيُّ التِّلقائيُّ المستقِلُّ، إضافةً إلى الجِهاز العَصَبِيِّ المركَزِيِّ الذي هو أهمُّها، خاصة في حَقل الدراساتِ اللغويةِ النَّفسيةِ العَصَبِية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الجهاز العصبي المركزي ","nonDiacriticsLemma":"الجهاز العصبي المركزي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الجِهَازُ العَصَبِيُّ المَرْكَزِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/08e2b581-6211-4a1e-81c8-2b9a6cdab2fa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"08e2b581-6211-4a1e-81c8-2b9a6cdab2fa","word":"المُخَيْخُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b32","lexicalEntryId":"08e2b581-6211-4a1e-81c8-2b9a6cdab2fa","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المُخَيْخُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"أحَدُ أجزاءِ الجهازِ العصَبيِّ المركزيِّ، الذي يتكوَّن أيضا من الدِّماغ والنّخاعِ المستطيلِ وقنطرَةِ فارول والحَبلِ الشَّوكي. يَقَع المخيْخُ في أعلى النّخاع، ويتألَّف من نِصفَين تَصِل بينهما قنطرةُ فارول بواسطة مجموعَةٍ من الألياف العصَبية. وهو مسؤولٌ عن التَّنسيق الحَرَكيِّ والوُقوفِ والجُلوسِ وحِفظِ التوازُن.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NC","root":null,"wordForms":[],"relatedSenses":[],"search":"المخيخ ","nonDiacriticsLemma":"المخيخ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المُخَيْخُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8f7ded1e-c024-4c50-995e-f8794bf2d5d6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8f7ded1e-c024-4c50-995e-f8794bf2d5d6","word":"نَمَاذِجُ السَّلاسِلِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b33","lexicalEntryId":"8f7ded1e-c024-4c50-995e-f8794bf2d5d6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَمَاذِجُ السَّلاسِلِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نماذِجُ نحويةٌ تُفسِّر حُدوثَ الكلام، وتَفتَرِض أنه يحدُث على هيئة سِلسِلَةٍ من الكلمات، على أساس أن كلَّ كلمةٍ تحَدِّد الكلمةَ التي تَرِد بعدها مباشرَةً. من هذه النماذِجُ ما يُعرَف بأنموذَجِ أو عَمَليةِ ماركوف Marcov process الذي يَرتَبط بأنموذَجٍ نفسيٍّ سُلوكيٍّ مُوازٍ له، حيث يرى السلوكيون أن البنى التي تَكمُن في السلوك تتكوَّن من ارتِباطاتٍ بين المثيراتِ والاستجابات، وأن أسهَلَ طريقَةٍ لمعالَجَة الأحداثِ المتعاقِبَةِ هي الافتِراضُ بأن كلَّ استِجابَةٍ تُصبح مُثيرا للاستِجابَة التاليةِ لها مباشرةً. واستِنادا إلى هذا الأنموذَجِ اللغويِّ النفسيِّ السلوكيِّ، فإن كلَّ كلمةٍ تُعَدّ مُثيرا للكلمة التاليَةِ لها مباشرةً، وأن الكلمةَ الثانيةَ التي كانت استجابَةً للأولى هي أيضا مُثيرٌ للكلمة التاليَةِ لها، وهكذا. وقد اعتَرَض كثيرٌ من اللغويين وعلماءِ اللغة النفسيِّين على هذا الأنموذَجِ السلوكيِّ الشَّكليِّ؛ لأن واقِعَ الكلامِ يُناقِضه، وأن قواعدَ اللغاتِ تخالِفه؛ فالكلامُ قد يتضمَّن جُملا وعباراتٍ اعتراضيةً تَفصِل بين الكلماتِ التي يُفتَرَض تَسَلسُلها، كما أن في الكلام ضمائرَ تعود إلى مراجِعَ سابِقَة أو ذِهنِيَّة، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نماذج السلاسل ","nonDiacriticsLemma":"نماذج السلاسل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَمَاذِجُ السَّلاسِلِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

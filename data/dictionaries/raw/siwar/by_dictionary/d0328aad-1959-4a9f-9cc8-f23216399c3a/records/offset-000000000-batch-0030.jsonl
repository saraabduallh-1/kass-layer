{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/63c7d01d-75a2-4971-8d1d-0595d04662b1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"63c7d01d-75a2-4971-8d1d-0595d04662b1","word":"أُنْمُوذَجُ كَارْفَر","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b3a","lexicalEntryId":"63c7d01d-75a2-4971-8d1d-0595d04662b1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ كَارْفَر","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ للقراءة الحَرفِيةِ الجُزئيةِ التصاعدية bottom-up reading model، التي تعتَمِد على النَّصِّ اعتِمادا  كُلِّيًّا، وَضَعَه كارفَر R. Carver في عامَي 1977 و1978م على هَيئة نظريةٍ سمّاها: نظرية فَهمِ المقروءِ والمسموع، بوَصف هاتَين المهارَتَين عمَليةً واحدةً مترابطةً في ذِهن القارئ. ويَرَى كارفر أن السامِعَ يَفهَم الكلامَ فَهما حَرفيا ولو لم يتَّفِق مع قَصد المتكلِّم، وأن القارئَ يَقرأ النَّصَّ في ذِهنه قراءةً شِبهَ مسموعَةٍ فيَفهَم وِفقَ ما يَسمَع من كلامه كما لو كان يَسمَع من كلام غيرِه، وأن هذا النُّطقَ الداخليَّ للقراءة يُساعِده في الفَهم. راجع:  @(bottom-up models of reading) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج كارفر ","nonDiacriticsLemma":"أنموذج كارفر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ كَارْفَر"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}
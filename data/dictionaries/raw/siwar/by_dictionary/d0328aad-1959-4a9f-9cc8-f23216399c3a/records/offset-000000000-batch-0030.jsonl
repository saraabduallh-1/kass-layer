{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cabdca66-ec52-49c3-8eea-35b80cc61824/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cabdca66-ec52-49c3-8eea-35b80cc61824","word":"مَنْظُومَةُ الاخْتِيَارَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b42","lexicalEntryId":"cabdca66-ec52-49c3-8eea-35b80cc61824","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَنْظُومَةُ الاخْتِيَارَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في النحو النِّظاميِّ systemic grammar، يُشير إلى أحَد أنواعِ المنظوماتِ التي يتكوَّن منها نظامُ اللغة، وهي مجموعةُ اختياراتٍ محدودَةٍ تَخُصُّ صِنفا نحويا. فالاسمُ مثلا له منظومةُ اختياراتِ العَدَدِ (الإفرادُ والتَّثنيةُ والجَمع)، ومنظومةُ اختياراتِ النوعِ أو الجِنسِ (المذكَّرُ والمؤنث)، ومنظومةُ اختياراتِ الحالَةِ الإعرابيةِ (الرفعُ والنصبُ والجرّ).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"منظومة الاختيارات ","nonDiacriticsLemma":"منظومة الاختيارات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَنْظُومَةُ الاخْتِيَارَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f011c1a2-f0aa-4da6-8fde-e1d6c60dc4f9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f011c1a2-f0aa-4da6-8fde-e1d6c60dc4f9","word":"جَانِبِيَّةُ الدِّمَاغِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b43","lexicalEntryId":"f011c1a2-f0aa-4da6-8fde-e1d6c60dc4f9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جَانِبِيَّةُ الدِّمَاغِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يَعني التحكُّمَ الجانِبيَّ للدِّماغ في عَدَدٍ من الحَرَكات والوَظائفِ في جِسم الإنسانِ بطريقَة مُتَعاكِسَة. فالجانبُ الأيمَنُ من الدِّماغ يتحَكَّم في الجانب الأيسَرِ من الجِسم، والجانبُ الأيسَرُ من الدِّماغ يتحَكَّم في الجانِب الأيمَنِ من الجِسم، ويُسمّى هذا تَعاكُسَ الوَظائفِ lateralization of functions. وهذا التقسيمُ مرتَبِطٌ بتَقسيم وَظائفِ اللغةِ في نِصفَيْ الدِّماغ؛ فمُعظم مناطِقِ اللغةِ ووَظائفِها، لاسيَّما الوَظائفُ التحليلية، تَقَع في الجانب الأيَسَرِ من الدِّماغ، في حين تَقَع الوَظائفُ الأخرى - غيرُ التحليلية - في الجانب الأيمَنِ منه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جانبية الدماغ ","nonDiacriticsLemma":"جانبية الدماغ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جَانِبِيَّةُ الدِّمَاغِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9dbc81de-9af8-4a6e-b8e4-28f7b0afa1df/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9dbc81de-9af8-4a6e-b8e4-28f7b0afa1df","word":"النَّزْعَةُ المَرْكَزِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b44","lexicalEntryId":"9dbc81de-9af8-4a6e-b8e4-28f7b0afa1df","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّزْعَةُ المَرْكَزِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في الإحصاء والبحثِ العلميِّ، يُقصَد به مَيلُ بعضِ الظواهرِ إلى النُّزُوع أو الاقتِرابِ في قِيَمها إلى القِيمَة المتوسّطةِ أو القِيمَةِ المركَزِية: أي إنها قِيمَةٌ تَقَع في النُّقطَة المركزيةِ لتَجمُّع الدرَجات. وأهمُّ مَقايِيسِ النزعةِ المركزيةِ ثلاثةٌ هي: المتوسِّطُ الحِسابيُّ، والوَسِيطُ، والمِنوالُ، وهي شائعَةُ الاستِعمالِ في البحث في حقل تعليم اللغاتِ والاختباراتِ اللغوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النزعة المركزية ","nonDiacriticsLemma":"النزعة المركزية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّزْعَةُ المَرْكَزِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

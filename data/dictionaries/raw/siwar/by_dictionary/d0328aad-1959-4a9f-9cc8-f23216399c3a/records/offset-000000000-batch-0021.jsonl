{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1610b62a-6c3d-4150-b42a-55150c52ddf7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1610b62a-6c3d-4150-b42a-55150c52ddf7","word":"حُبْسَةُ ثُنائِيِّ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a4c","lexicalEntryId":"1610b62a-6c3d-4150-b42a-55150c52ddf7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حُبْسَةُ ثُنائِيِّ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُطلَق على أيِّ حُبسَةٍ لغويةٍ تُصِيب ثُنائيِّي اللغةِ حين يُعانون من إصابةٍ أو تلَفٍ في الجانب الأيسَرِ من الدِّماغ، خاصةً في منطقَتَيْ بروكا وفيرنيكه، وقد تكون الإصابَةُ في الجانب الأَيمَنِ منه. تظهَر لدى المصابين بهذه الحبسَةِ مشكلاتٌ وأنماطٌ مختَلِفةٌ من الحُبسَة في الكلام، تختَلِف عما يُصاب به أحاديُّو اللغة، وتُلحَظ لدَيهم أنماطٌ مختَلِفَةٌ من السُّلوك اللغويِّ بعد الشِّفاءِ من هذا المرض، وتشمل هذه الحبسة مُتَعَدِّدِي اللغاتِ أيضا multilingual aphasia. وتُفيد الدراساتُ اللغويةُ العَصَبِيَّةُ أن المصابَ بتَلَفٍ في الدِّماغ قد يُصاب بحُبسَة في لغَةٍ واحدةٍ أو في لغَتَين أو في اللغات كلِّها، وقد يُصاب بنَوعٍ من الحُبسَة في لغةٍ ونَوعٍ آخَرَ من الحُبسَة في اللغة أو اللغاتِ الأخرى. ويُشار إلى هذه الحبسَةِ في بعض المصادِرِ أحيانا بمصطَلَح: aphasia in bilinguals.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حبسة ثنائي اللغة ","nonDiacriticsLemma":"حبسة ثنائي اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حُبْسَةُ ثُنائِيِّ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/034bc2b5-5f1c-4e6e-8896-a5ac0fd7fbf1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"034bc2b5-5f1c-4e6e-8896-a5ac0fd7fbf1","word":"عَالَمُ المُكَعَّباتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a4d","lexicalEntryId":"034bc2b5-5f1c-4e6e-8896-a5ac0fd7fbf1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَالَمُ المُكَعَّباتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، يُشير إلى مجموعةٍ محدودَةِ العَدَدِ من كُتَلٍ مُكعَّبَةٍ وأسطوانيةٍ وهَرَمِيَّة مختَلِفةِ الأحجامِ والألوان، مَصفوفةٍ على سَطحٍ مُستَوٍ، ومُصَمَّمةٍ لتكون عالما مصغَّرا لبرنامَج الرُّوبوطِ الحاسوبيِّ SHRDLU. ويُستَخدَم عالَمُ المكعَّباتِ لإجراء تجاربَ الذكاءِ الاصطِناعيِّ ومعالَجَةِ اللغاتِ الطبيعية؛ لأنه يُمَكِّن المرءَ من محاكاةِ عالَمِ الواقِعِ بطريقَةٍ مبسَّطَةٍ بتَمثِيل الأشياءِ والعلاقاتِ بين الأشياءِ بعضِها ببعض، وكذلك العلاقات بين الأشياءِ وصِفاتِها، وتَمثِيل الأعمالِ التي يمكن إجراؤها عليها كتَحريكها أو تكوينِ تَشكيلاتٍ معيَّنةٍ منها أو وَضعِ شَيءٍ على آخَر أو أمامَه أو خَلفَه، باستعمال تراكيبَ لغويةٍ ودلاليةٍ وعَمَليةٍ صَريحَةٍ لا لَبْسَ فيها؛ لكي يَفهَم البرنامَجُ المطلوبَ منه، ويُنفِّذَ الأوامِرَ التي تُوَجَّه إليه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عالم المكعبات ","nonDiacriticsLemma":"عالم المكعبات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَالَمُ المُكَعَّباتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

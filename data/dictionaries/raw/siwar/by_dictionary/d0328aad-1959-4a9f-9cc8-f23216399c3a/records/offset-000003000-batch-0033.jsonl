{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ae03ad94-ce6c-471f-a334-8318206de204/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ae03ad94-ce6c-471f-a334-8318206de204","word":"السُّلُوكِيَّةُ الجَدِيدَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9762","lexicalEntryId":"ae03ad94-ce6c-471f-a334-8318206de204","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"السُّلُوكِيَّةُ الجَدِيدَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ نفسيةٌ تعليميةٌ، نشأت نتيجَةَ النَّقدِ الموجَّهِ إلى النظرية السلوكيةِ الأمِّ Behavioral Theory ؛ لتركيزِها على تأثير العوامِلِ البيئيةِ المحيطَةِ بالمتعلم، وحَصرِها عمَليةَ التعلُّمِ في المثير والاستِجابَةِ والتعزيز، وإهمالِها الجوانبَ المعرفيةَ الداخلية؛ ثم نتيجةَ الآراءِ المعرفيةِ وتأثيرِها في حُقول التعليم، بما في ذلك تعليمُ اللغات. وحين شَعر السلوكيون الجُدُد بآثار هذا النَّقد، بدَؤوا يأخذون ببعضِ الآراءِ والتطبيقاتِ السلوكية، ويعدّلون آراءَهم السابقَةِ، ويضيفون آراء وتطبيقاتٍ معرفية، كان أهمُّها الاهتِمامَ بالعوامِل المتوَسِّطَةِ بين المثيرِ والاستجابةِ؛ فكانت هذه التَّعديلاتُ هي السلوكيةَ الجديدةَ التي لم تَصمُد هي أيضا أمامَ نَقدِ المعرِفيِّين الفِطرِيِّين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"السلوكية الجديدة ","nonDiacriticsLemma":"السلوكية الجديدة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"السُّلُوكِيَّةُ الجَدِيدَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

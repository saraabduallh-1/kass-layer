{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/252ff512-29d3-4e27-825e-73cb2140b4a9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"252ff512-29d3-4e27-825e-73cb2140b4a9","word":"نَظَرِيَّةُ الوَظَائِفِ العَصَبِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9765","lexicalEntryId":"252ff512-29d3-4e27-825e-73cb2140b4a9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ الوَظَائِفِ العَصَبِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويةٌ نفسيةٌ عصَبيةٌ، تعتَمِد في تفسيرها لاكتساب اللغةِ الثانيةِ على نتائج الدراساتِ في اللِّسانيات العصَبية، وترى أن النُّمُوَّ اللغويَّ يعتَمِد على أنشِطَة وَظائفِ الجِهازِ العصَبيِّ عامَّةً، والجهازِ العصَبيِّ المركزيِّ، المتمثِّلِ في الدِّماغ، خاصَّةً. فهذه النظريةُ تفسِّر اكتِسابَ اللغةِ الثانيةِ في ضَوء التَّقسيمِ الجانِبيِّ للوَظائف اللغويةِ بين نصفَيْ الدِّماغ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية الوظائف العصبية ","nonDiacriticsLemma":"نظرية الوظائف العصبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ الوَظَائِفِ العَصَبِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e0e8e85b-4351-4ab9-8c2a-add8597894c2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e0e8e85b-4351-4ab9-8c2a-add8597894c2","word":"فَرْضِيَّةُ اخْتِلافِ المَوْسُومِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9609","lexicalEntryId":"e0e8e85b-4351-4ab9-8c2a-add8597894c2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرْضِيَّةُ اخْتِلافِ المَوْسُومِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضيةٌ طرَحَها فرِدْ إكْمان Fred  R. Eckman عام 1977م، معتَمِدا على نظرية الموسوميَّةِ أو نظريةِ الوَسمِ Markedness Theory في اكتساب اللغةِ الثانية. هذه الفَرضيةُ تُفسِّر سبَبَ نقلِ المتعلِّمِ بعضَ أنظمَةِ لغتِه الأمِّ وعَدَمِ نَقلِ بعضِها الآخر. فالمتعلِّمُ - وفقاً لهذا التفسير - يَنقُل الأنماطَ الأقلَّ موسوميةً في لغته الأمِّ إلى اللغة الهَدَف، ولا يَنقُل الأنماطَ الأقوى موسوميةً. راجع:  @(Markedness Theory) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية اختلاف الموسومية ","nonDiacriticsLemma":"فرضية اختلاف الموسومية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرْضِيَّةُ اخْتِلافِ المَوْسُومِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/40001a73-578d-4dc7-851e-c3c79b7e896c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"40001a73-578d-4dc7-851e-c3c79b7e896c","word":"العَيِّنَاتُ المُقارَنَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b960a","lexicalEntryId":"40001a73-578d-4dc7-851e-c3c79b7e896c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"العَيِّنَاتُ المُقارَنَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عَيِّناتٌ يَتمُّ بها مُقارَنَةُ مجموعَتَين أو أكثَرَ من الخاضِعين للبحث طِبقا لمتغيِّر واحدٍ أو أكثَرَ من المتغَيِّرات الملائمَة. وفي تعليم اللغاتِ تُستَعمَل هذه العيِّناتُ في المقارَنة بين تعليم اللغةِ للصِّغار وتعليمِها للكِبار، وفي المقارَنة بين تعليمِ اللغةِ لغةً ثانيةً وتعليمِها لغةً أجنَبيةً، وفي المقارَنة بين تعليمِها بطريقَة تدريسٍ تَقليدِيَّةٍ وأخرى حَديثَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"العينات المقارنة ","nonDiacriticsLemma":"العينات المقارنة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"العَيِّنَاتُ المُقارَنَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9e2dff46-8fca-445c-a5a5-d6d2163ec4c1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9e2dff46-8fca-445c-a5a5-d6d2163ec4c1","word":"لُغَةٌ وَسِيطَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b960b","lexicalEntryId":"9e2dff46-8fca-445c-a5a5-d6d2163ec4c1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ وَسِيطَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ التي يُتقِنها كلٌّ من معلِّم اللغةِ الهَدَفِ وطُلابِه، سواء أكانت لغةً أمًّا لهم أو لبعضِهم أم لم تكن كذلك. وهي وَسيلةٌ للترجَمة والتفاهُم بين المعلِّم وطلابِه، وبين الطلابِ أحيانا، في بعض المواقِفِ اللغويةِ التي تتطلَّبها في قاعَة الدَّرس. فالإنجليزيةُ مثلا يمكن أن تكون لغةً وَسيطةً لمتعلِّمي اللغةِ العربيةِ في أثيوبيا أو الهندِ أو ماليزيا مثلا، والأُرديةُ يمكن أن تكون لغةً وَسيطةً لمتعلِّمي الإنجليزيةِ في بعض مناطِقِ الهند، والسواحيليةُ يمكن أن تكون لغةً وَسيطةً لمتعلِّمي العربيةِ في دول شَرقِ أفريقيا. واستعمالُ اللغةِ الوَسيطة، كاستعمال اللغةِ الأمِّ، مَوضِعُ خلافٍ بين اللغويين التطبيقيِّين. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة وسيطة ","nonDiacriticsLemma":"لغة وسيطة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ وَسِيطَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f42cfed4-6c70-494a-a3c5-fa394cae9d74/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f42cfed4-6c70-494a-a3c5-fa394cae9d74","word":"النُّخَاعُ المُسْتَطِيلُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b960c","lexicalEntryId":"f42cfed4-6c70-494a-a3c5-fa394cae9d74","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النُّخَاعُ المُسْتَطِيلُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الجُزءُ الخَلفِيُّ من الدِّماغ المتَّصِلُ بالنخاع الشَّوكي، يحتَوي على مجموعاتٍ من الخلايا العَصَبيةِ وعلى عدَّةِ مراكزَ مُهمَّةٍ في التحكُّم بالأعصاب، ومسؤولٌ عن الحرَكات الحيَوِيةِ، ولاسيَّما التنفُّسُ الذي هو مادَّةُ الصوتِ اللغوي، ويتحكَّم المركزُ التنفُّسيُّ والمركزُ القَلبيُّ الوِعائيُّ بالتنفُّس وضَرَباتِ القَلبِ وأعضاءِ جهازِ السَّمعِ الجانِبي، وأهمُّ من ذلك أن مُستَقبِلاتِ الأذُنِ والذَّوقِ واللَّمسِ تُنَسَّق نَبَضاتُها فيه. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النخاع المستطيل ","nonDiacriticsLemma":"النخاع المستطيل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النُّخَاعُ المُسْتَطِيلُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b5371b0-633a-4a94-8682-5a01e711abfe/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b5371b0-633a-4a94-8682-5a01e711abfe","word":"التَأثِيرُ الرَّئيسُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9607","lexicalEntryId":"9b5371b0-633a-4a94-8682-5a01e711abfe","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَأثِيرُ الرَّئيسُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عُنصُرٌ إحصائيٌ، يُستَعمل في البَحث في أنواعِ المتغيِّرات في تعليم اللغات، لاسيَّما في تحديد العَلاقةِ بين المتغيِّراتِ النَّفسيةِ والاجتِماعيةِ واكتِسابِ اللغةِ الهَدَفِ، كالبحث في تحديد العَلاقةِ بين الكِفايَةِ في اللغةِ الهَدَفِ ونَوعِ الاتِّجاهاتِ والميُولِ نحوَ ثقافَتِها. والتَّأثيرُ الرَّئيسُ في تحليل التَّبايُنِ أو تحليلِ الانحِدارِ يَشتَمِل على عامِلَين أو أكثَرَ، ويكون لكلِّ عامِلٍ منهما تَأثيرٌ مختَلِف. فالتَّأثِيرُ الرَّئيسُ هو تَقديرٌ لتَأثِير المتغيِّرِ التجريبِيِّ أو المعالَجَةِ على المتغيِّر التابِعِ الذي يكون مختَلِفا عن تَأثير العوامِلِ الأخرى وعن تأثير التفاعُل. وفي التَّجربة العامِلِيَّةِ، يُعَدُّ التأثيرُ الرَّئيسُ للعامِل هو متوسِّطَ التَّغيِيرِ في أثناء الاستِجابَةِ التي يتمُّ توليدُها بتَغيِيرِ مستَوَياتِ العامِل.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التأثير الرئيس ","nonDiacriticsLemma":"التأثير الرئيس","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَأثِيرُ الرَّئيسُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

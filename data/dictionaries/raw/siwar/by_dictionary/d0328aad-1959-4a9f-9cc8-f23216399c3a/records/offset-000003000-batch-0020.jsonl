{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6c1baa1f-daf8-4768-805a-03b434a7caf9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6c1baa1f-daf8-4768-805a-03b434a7caf9","word":"عُظَيْمَةُ المِطْرَقَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9619","lexicalEntryId":"6c1baa1f-daf8-4768-805a-03b434a7caf9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عُظَيْمَةُ المِطْرَقَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُقصَد به إحدى العُظَيْماتِ السَّمعيةِ الثلاثِ في الأذُن الوُسطى، إضافةً إلى عُظَيْمَتَيْ السِّندانِ والرِّكاب، التي تملأ الفراغَ الواقعَ بين الغِشاء الطَّبليِّ وقَوقَعَةِ الأذُنِ الداخلية. وعُظَيْمَةُ المِطرَقةِ هي الأولى من الجِهَة الداخليةِ للطَّبلة؛ وهي مرتَكِزَةٌ على السَّطح الداخليِّ للطَّبلَة من طَرَفٍ، ومتَّصِلةٌ بعُظَيْمَة السِّندانِ من طرَفٍ آخَر. ووَظيفةُ هذه العُظَيْماتِ نَقلُ الموجاتِ الصوتيةِ الوارِدَةِ من الخارِج عَبرَ الممَرِّ السَّمعيِّ، وتحويرُها إلى اهتِزازاتٍ؛ لتُناسِب الأجهزةَ الداخليةَ التي تَستقبِلها، ثم تُرسِلها إلى الأجهزة والمراكزِ السَّمعيةِ التي تَليها في الأذُن الداخليّةِ، تمهيدا لإرسالها - عَبرَ العَصَبِ السَّمعيِّ - إلى مراكِزِ السَّمعِ واللغةِ في الدِّماغ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عظيمة المطرقة ","nonDiacriticsLemma":"عظيمة المطرقة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عُظَيْمَةُ المِطْرَقَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9dab4343-c177-4ab7-97e5-856a034cebe2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9dab4343-c177-4ab7-97e5-856a034cebe2","word":"دَافِعٌ مُنْخَفِضٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9617","lexicalEntryId":"9dab4343-c177-4ab7-97e5-856a034cebe2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دَافِعٌ مُنْخَفِضٌ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"وَصفٌ للدَّافِع الذي يكون لدى متعلِّمِ اللغةِ الثانيةِ أو الأجنبيةِ تجاهَ تعلُّمِها. وهو ضَعفٌ في الدَّافِع قد يكون أساسيًّا منذ بدايَةِ التعلُّمِ، وقد يكون طارئًا لأسبابٍ عارِضَة. وكلَّما ضَعُف هذا الدَّافِعُ قَلَّ تحصيلُ الطالبِ، ومن ثم ضَعُفَت كِفايَتُه في اللغة الهَدَف؛ لانخِفاض المُدخَلاتِ اللغويةِ الناتجةِ عن عَدَم رَغبَتِه في تلَقِّي اللغةِ أو التواصُلِ بها. يقابِل ذلك الدَّافِعُ المرتَفِعُ high motivation.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دافع منخفض ","nonDiacriticsLemma":"دافع منخفض","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دَافِعٌ مُنْخَفِضٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

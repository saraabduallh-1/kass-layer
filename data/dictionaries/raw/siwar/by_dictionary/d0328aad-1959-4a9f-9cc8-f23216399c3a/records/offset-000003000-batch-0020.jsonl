{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0bdffd7e-91e3-4180-85f9-1cfe96095d2f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0bdffd7e-91e3-4180-85f9-1cfe96095d2f","word":"عِلْمُ اللُّغَةِ الرِّيَاضِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b961b","lexicalEntryId":"0bdffd7e-91e3-4180-85f9-1cfe96095d2f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ الرِّيَاضِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من فروع علمِ اللغةِ، يَسعى إلى تَطبيق المناهجِ الرياضيةِ والإحصائيةِ في دراسة اللغةِ والنصوصِ اللغويةِ المنطوقَةِ والمكتوبة؛ كدراسة شُيوعِ الكلماتِ والعباراتِ والصِّيَغ والتراكيبِ في لغةٍ أو نَصٍّ ما، وقياسِ العُمرِ اللغويِّ. ومن فُروعه علمُ اللغةِ الجّبْريُّ، وعلمُ اللغةِ الحِسابيُّ أو الحاسوبيُّ، وعلمُ اللغةِ الكمِّيُّ، وعلمُ اللغةِ الإحصائيُّ، وعلمُ اللغةِ الأسلوبيُّ. وقد يُطلَق على هذه الفُروعِ أو على مُعظَمها مصطلَحُ: اللغوياتِ الحاسوبيةِ computational linguistics.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة الرياضي ","nonDiacriticsLemma":"علم اللغة الرياضي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ الرِّيَاضِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

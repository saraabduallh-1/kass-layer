{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/aae35574-8594-48b7-8c89-139f031f73ab/get-public-entry"},"browse_index_record":{"lexicalEntryId":"aae35574-8594-48b7-8c89-139f031f73ab","word":"كُرَّاسَةُ السِّجِلِّ اليَوْمِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9604","lexicalEntryId":"aae35574-8594-48b7-8c89-139f031f73ab","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كُرَّاسَةُ السِّجِلِّ اليَوْمِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سِجِلٌّ مدرسيٌّ يوميٌّ، تستَخدِمه المدرسةُ لتَسجيل الأحداثِ والوَقائعِ اليوميةِ التي تَظهَر داخلَ المدرسة. يُفيد هذا السِّجلُّ في تسجيل ما يطرأ على متعلِّم اللغةِ من نُموٍّ لغويٍّ، وما يَقَع فيه من أخطاء نُمُوٍّ مرحَلية، ورَصدِ التَّغيُّرِ المنتَظِمِ systematic variation وتميِيزِه عن التَّغيُّر غيرِ المنتَظِمِ non-systematic variation في لغته المرحَلية. وقد يكون السِّجِلُّ خاصًّا بالمعلِّم teacher log، أو بالطالب student log، لاسيّما حين يُطلَب من الأخير تَدوينُ مَعلوماتٍ عن البرنامَج أو الدَّورَةِ لأغراض التقويم. راجع:  @(learning log) و  @(student logs) و  @(journal) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كراسة السجل اليومي ","nonDiacriticsLemma":"كراسة السجل اليومي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كُرَّاسَةُ السِّجِلِّ اليَوْمِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/548b1cd8-eee5-4888-815d-967725336500/get-public-entry"},"browse_index_record":{"lexicalEntryId":"548b1cd8-eee5-4888-815d-967725336500","word":"مَدْرَسَةُ لَنْدَن","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9605","lexicalEntryId":"548b1cd8-eee5-4888-815d-967725336500","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَدْرَسَةُ لَنْدَن","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهجٌ في الدراسات اللغويةِ الحديثةِ اتَّبَعه عَدَدٌ من عُلماء اللغةِ في لندن، يمثِّل مدرسةً مستَقلَّةً ازدَهَرَت في الخمسينيات من القرن العشرين، وعُدَّت إحدى المدارسِ اللغويةِ الكبرى في العصر الحديث، إضافةً إلى مدرسة براغ، ومدرسةِ كوبنهاجن، والمدارسِ الأمريكيةِ بشِقَّيْها البِنيَوِيِّ والمعرِفيِّ الفِطرِيِّ أو التحويليِّ التوليديِّ. من أهم أقطابِ مدرسَةِ لندن دانيال جونز Daniel Jones، وجون فيرث John Firth، وكلاهما في جامعة لندن، وقد سبقهما اللغوي هنري سويت Henry Sweet. بيدَ أنّ أعمالَ فيرث اهتَمَّت بالأصوات الوَظيفية، وعلمِ الدَّلالة، واللِّسانياتِ الاجتماعية، ونشأت من خلالها نظرياتٌ نحوية، كالنحو النِّظاميِّ، والنحوِ النِّظاميِّ الوظيفيِّ، الذي طوَّرَه فيما بعد مايكل هاليداي Micheal Halliday، أبرَزُ أتباعِ فيرث. تتَلْمَذ على هذه المدرسة، وعلى يَديْ فيرث خاصّةً، روَّادُ الدراساتِ اللغويةِ العربيّة الحديثَة، من أبرَزهم: تمّام حسّان، وعبدُ الرجمن أيوب، ومحمودُ السّعران، وكمالُ بشر. يرَى بعضُ اللغويين أن هذه المدرسةَ لم تَلْق ما تستَحِقُّه من الاهتِمام، لأسبابٍ أهمُّها ظُهورُ مدرسَةِ تشومسكي في الخمسينيات من القرن العشرين، تلك المدرسةُ التي شَغَلَت اللغويين، وصرَفَتهم عن المدارس الأخرى، بما فيها مدرسةُ لندن.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مدرسة لندن ","nonDiacriticsLemma":"مدرسة لندن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَدْرَسَةُ لَنْدَن"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

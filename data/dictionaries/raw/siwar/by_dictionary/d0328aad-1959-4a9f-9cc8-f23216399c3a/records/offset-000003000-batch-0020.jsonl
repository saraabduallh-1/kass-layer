{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f9fc9850-a27e-4178-bc2f-d809c9bbae98/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f9fc9850-a27e-4178-bc2f-d809c9bbae98","word":"الطَّرِيقَةُ اليَدَويَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b960f","lexicalEntryId":"f9fc9850-a27e-4178-bc2f-d809c9bbae98","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطَّرِيقَةُ اليَدَويَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"طريقةٌ لتعليم الصُّمِّ لغةَ الإشارة، وهي أنواع، منها: لغةُ الإشارةِ الأمريكيةِ ASL، ولغةُ الإشارةِ البريطانيةِ BSL، ولغةُ الإشارةِ الفرنسية، ولغةُ الإشارةِ العربية، وسُمِّيَت باليَدوِيَّة من باب التَّغليب؛ لأن اليَدَ هي أبرَزُ أعضاءِ الجسمِ المستَخدَمَةِ في الإشارة، وأكثَرُها حرَكةً. ولغاتُ الإشارة مستَقلَّةٌ قواعدُها عن قواعد اللغةِ المنطوقَةِ في بيئتها؛ فلُغَةُ الإشارَةِ الأمريكيةِ ولغةُ الإشارةِ البريطانية مثلا لا تَعتَمِدان على قواعد اللغةِ الإنجليزية، ولغةُ الإشارةِ الفرنسيةِ لا تَعتَمِد على قواعد اللغةِ الفرنسية، وهكذا في لغاتِ الإشارة الأخرى، بما فيها لغة الإشارَةِ العربيةِ التي هي من أكثَر لغاتِ الإشارَةِ تَنَوُّعا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الطريقة اليدوية ","nonDiacriticsLemma":"الطريقة اليدوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطَّرِيقَةُ اليَدَويَّةُ"}],"lemmaLanguage":{
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d90909b7-ce00-4765-8ed5-65959d6681f5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d90909b7-ce00-4765-8ed5-65959d6681f5","word":"اللِّسَانِيَّاتُ الحَدِيثَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96e4","lexicalEntryId":"d90909b7-ce00-4765-8ed5-65959d6681f5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللِّسَانِيَّاتُ الحَدِيثَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اسمٌ يُطلَق على علم اللغةِ linguistics بنظَرياته ومدارِسِه ومناهِجِه الحديثة، الذي بدأ ظُهورُه في أواخِر القرنِ التاسع عشر وأوائلِ القرنِ العشرين على يَد اللغويِّ السويسريِّ فردينان دي سوسير Ferdinand De Saussure وأتباعِه. عُرِف بالمنهج الوَصفيِّ على اختلاف مدارِسِه، ومَرَّ بتطوُّرات ومراحِل، وتفَرَّع إلى مذاهبَ ومدارس، ثم تحَوَّل في نهايَة الخمسينياتِ من القرن العشرين، على يَد نوم تشومسكي وأتباعِه، إلى منهجٍ لغويٍّ نفسيٍّ مَعرِفيٍّ يَهتمُّ بدراسة اللغةِ ونُمُوِّها داخِلَ الإنسان، وما يَرتَبط بهذا النُّمُوِّ من عوامِل.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللسانيات الحديثة ","nonDiacriticsLemma":"اللسانيات الحديثة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللِّسَانِيَّاتُ الحَدِيثَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

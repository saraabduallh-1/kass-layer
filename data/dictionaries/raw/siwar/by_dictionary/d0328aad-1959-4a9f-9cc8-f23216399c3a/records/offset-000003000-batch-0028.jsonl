{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/76d77f8f-10b0-4aa2-bf37-b8fc9d6fbd9a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"76d77f8f-10b0-4aa2-bf37-b8fc9d6fbd9a","word":"نَمْذَجَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96d4","lexicalEntryId":"76d77f8f-10b0-4aa2-bf37-b8fc9d6fbd9a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَمْذَجَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"إجراءٌ من إجراءات الطريقةِ السَّمعيةِ الشَّفَهية، خاصةً في التدريبات، ويَعني تقديمَ المعلِّمِ أو مؤلِّفِ الكِتابِ للمتعلِّم أنموذَجًا صحيحًا لتَكراره، أو تقليدِه، أو يَستَعين به لصِياغَة جُملةٍ أو جُملًا جديدة. ويُستَعمل هذا المصطلحُ أيضا في اكتساب الطفلِ لغتَه الأمَّ لدى السُّلوكيين الذين يرَون أن الطفلَ يكتَسِب لغتَه بالتقليد والتَّكرارِ والقِياسِ والتوسِيع، وأن على الوالِدَين والمرَبِّين تقديمَ النَّماذجِ اللغويةِ المناسِبَة للطفل في كل مرحَلة. غير أن المعرِفيِّين الفِطرِيِّين لا يؤمنون بهذا الأسلوب، ولا يرَون له قيمةً ولا تأثيرًا في اكتساب اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"نمذجة ","nonDiacriticsLemma":"نمذجة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَمْذَجَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

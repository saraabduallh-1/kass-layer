{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/893144a0-9b0e-40ed-9195-2e8efde92086/get-public-entry"},"browse_index_record":{"lexicalEntryId":"893144a0-9b0e-40ed-9195-2e8efde92086","word":"عِلْمُ المُعْجَمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95ce","lexicalEntryId":"893144a0-9b0e-40ed-9195-2e8efde92086","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ المُعْجَمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرعٌ من علم اللغةِ وعلمِ الدَّلالةِ تحديدًا، يُعنَى بدراسة مفرَداتِ اللغةِ من حيث اشتِقاقُها ودَلالاتُها ومُرادِفاتُها وتعَدُّدُ معانيها، ويُعنَى بتغَيِّر صِيَغِها وتطَوُّرِ دِلالاتِها عبرَ الزَّمن. والمشتَغِل بهذا العلمِ يُسمّى لغويًّا أي مُشتَغِلاً بمتن اللغةِ lexicologist. وعلمُ المعجَمِ أساسٌ تَعتَمِد عليه صِناعَةُ المعجَم، أي إن صُنّاعَ المعاجِمِ يَعتَمِدون على ما يقدِّمه علماءُ المفرَداتِ والدَّلالة. راجع:  @(lexicographer) و  @(lexicologist) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم المعجم ","nonDiacriticsLemma":"علم المعجم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ المُعْجَمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

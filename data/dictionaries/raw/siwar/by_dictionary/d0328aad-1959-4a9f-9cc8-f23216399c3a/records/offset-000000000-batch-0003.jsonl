{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/77956d10-a772-4b32-914d-4f18a34b53e9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"77956d10-a772-4b32-914d-4f18a34b53e9","word":"تَّدَرُّجُ الاكْتِسَابِ (اللُّغَوِيِّ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8892","lexicalEntryId":"77956d10-a772-4b32-914d-4f18a34b53e9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَّدَرُّجُ الاكْتِسَابِ (اللُّغَوِيِّ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ من مذاهبِ اكتسابِ اللغةِ الأمِّ واكتسابِ اللغةِ الثانيةِ، مستَمَدٌّ من مبادئ النظريةِ المعرِفيةِ الفِطرِيةِ في اكتساب اللغة، يَرَى أصحابُه أن صِيَغَ اللغةِ وأنماطَها وتراكيبَها تُكتَسَب اكتسابا طبَعيا متدَرِّجا، يسير في مراحِلَ زمنيةٍ متتابِعَةٍ ومحدَّدَةٍ، لا يَسبِق بعضُها بعضاً، وأن التعليمَ لا يُغَيِّر مسارَ هذا التدرُّجِ الذي هو فِطرَةٌ مَركوزَةٌ في دِماغ الإنسانِ منذُ الوِلادة. وهذا المذهبُ مخالِفٌ لمذهب السُّلوكيين البِنيَويين الذين يَرَون أن اكتسابَ اللغةِ سُلوكٌ خارِجيٌّ تتحَكَّم فيه العوامِلُ المحيطةُ بالمتعلِّم، بما في ذلك الوالِدان والمرَبّون والأقرانُ والمعلِّمون والموادُّ التعليمية، ويختَلِف أيضاً عن التفسير المعرِفيِّ للنُّموِّ اللغويِّ لدى جان بياجيه. راجع:  @(Innateness/Innatist Hypothesis) و  @(Natural Order Hypothesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدرج الاكتساب (اللغوي) ","nonDiacriticsLemma":"تدرج الاكتساب (اللغوي)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَّدَرُّجُ الاكْتِسَابِ (اللُّغَوِيِّ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f467d451-8ab9-420b-823c-869717db2d2d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f467d451-8ab9-420b-823c-869717db2d2d","word":"كَلِمَاتٌ نَشِطَةٌ  ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8893","lexicalEntryId":"f467d451-8ab9-420b-823c-869717db2d2d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمَاتٌ نَشِطَةٌ  ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الكلماتُ الإنتاجِيةُ التي تُستَعمَل في الكلام والكتابة، في مُقابِل كلماتِ الفَهمِ الاستِقبالِيةِ السَّلبِيةِ. راجع:  @(active/passive language knowledge) و  @(productive/receptive language knowledge) \r\n    ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَصفٌ يُطلِقه بعضُ اللغويين على الكلمات التي يتذَكَّرها المرءُ جيِّدا معظَمَ وَقتِه، فلا تَغيب عن ذِهنه إلا في حالاتٍ نادِرَة، وتُسمّى مفرَداتِ المعجَمِ النَّشِط. تُقابِلها الكلماتُ الخامِلَةُ، وهي التي لا يتذكَّرها المرءُ إلا في حالاتٍ محدودَةٍ. وبهذا الوَصفِ فإن الكلماتِ النَّشِطَةُ قد تكون كلماتِ فَهمٍ واستِقبالٍ كما تكون كلماتٍ إنتاجيةً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمات نشطة   ","nonDiacriticsLemma":"كلمات نشطة  ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمَاتٌ نَشِطَ
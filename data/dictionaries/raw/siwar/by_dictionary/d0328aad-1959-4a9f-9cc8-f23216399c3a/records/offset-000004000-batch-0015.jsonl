{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e2c53945-2477-4515-a72a-df2e1d9ab897/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e2c53945-2477-4515-a72a-df2e1d9ab897","word":"تَرْطِينٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9981","lexicalEntryId":"e2c53945-2477-4515-a72a-df2e1d9ab897","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْطِينٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُطلَق على العَمَلية التي تَنشَأ بسبَبها اللغةُ الهَجِينُ pidgin language، المتمثِّلةُ في اختِلاط مجموعاتٍ من الناس ناطِقَةٍ بلغاتٍ مختَلِفةٍ مُضطرَّةٍ إلى التَّخاطُب بلغةٍ ليسَت لغةً أمًّا لأيِّ مجموعةٍ منهم. ويُطلَق أيضا على الأسبابِ التي تُساعِد في حدوثها، والمراحِلِ التي تَمُر بها، سواء أكان التَّهجينُ في اللغة ذاتِها أم في اللغة المرحَليةِ لمتعلِّم اللغةِ الثانيةِ أو الأجنبية. pidgin (language) (1).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُشير إلى تَوَقُّف لغةِ متعلِّم اللغةِ الثانيةِ أو الأجنبيةِ في مستوى مُتَدَنٍّ تَوَقُّفًا مَرحَليًّا أو نهائيًّا؛ بحيث يَستَعمِل لغةً هَجِينًا قليلةَ المفرداتِ، بسيطةَ التراكيب، خاليةً من الأدوات والكلماتِ الوَظيفية. يَحدُث هذا التهجينُ حين يَكتَفي متعلِّمُ اللغةِ الثانيةِ بالحَدِّ الأدنى من الكِفايَة اللغويةِ التي تُمكِّنه من التَّواصُل المبدَئيِّ باللغة الهَدَفِ لقضاء حاجاتِه الضَّرورية. يُشَبِّه بعضُ اللغويين هذا التهجينَ بالتَّحَجُّر اللغويِّ fossilization، ويرى آخَرون أنه التَّحَجُّر نفسُه، أو أنه نَتيجَةٌ للتَّحَجُّر. راجع:  @(fossilization) و  @(pidginization hypothesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"ترطين ","nonDiacriticsLemma":"ترطين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرْطِينٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6a1d8a31-fe0e-41cc-a2f5-26f57013c5a4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6a1d8a31-fe0e-41cc-a2f5-26f57013c5a4","word":"نَغْمٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9982","lexicalEntryId":"6a1d8a31-fe0e-41cc-a2f5-26f57013c5a4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَغْمٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"دَرَجَةُ الصَّوتِ أو طَبَقةُ الصَّوت، وهي الصِّفةُ التي تُمَيِّز بها الأذُنُ الأصواتَ من حيث الحِدَّةُ والغِلظَةُ التي تَتَوَقَّف على عَدَد الاهتِزازات أو الذَّبذَبات التي يُصدِرها الوَتَران الصَّوتيان في الثانية، وتُعرَف بالتَّرَدُّد. فإذا زادَ عَدَدُ الذَّبذَباتِ الصَّوتيةِ في الثانية كان الصوتُ حادًّا رَقيقًا، وإذا قَلَّ عَدَدُها كان الصوتُ غليظًا أو سَميكًا. عَدَدُ الذَّبذَباتِ الصَّوتيةِ لدى الإنسان مُرتَبِطٌ بثلاثة عوامِلَ، هي: سُمكُ الوَتَرَين الصَّوتيَين، وطولُهما، وتَوَتُّرُهما، وهذا هو سبَبُ حِدَّةُ صَوتِ المرأةِ والطفل؛ لقِصَر أوتارِهما الصَّوتية ودِقَّتِها، خلافًا لصَوتِ الرَّجلِ الذي يَتَّسِم بالغِلظَة؛ لطُول وَتَرَيْه الصَّوتيَّيْن وغِلظَتِهما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"نغم ","nonDiacriticsLemma":"نغم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَغْمٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"
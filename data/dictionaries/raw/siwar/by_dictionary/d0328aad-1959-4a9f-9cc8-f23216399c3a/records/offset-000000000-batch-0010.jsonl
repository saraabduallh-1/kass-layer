{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/808d7123-f558-47e0-844d-575d7ee83768/get-public-entry"},"browse_index_record":{"lexicalEntryId":"808d7123-f558-47e0-844d-575d7ee83768","word":"ذَكَاءٌ اصْطِنَاعِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8943","lexicalEntryId":"808d7123-f558-47e0-844d-575d7ee83768","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ذَكَاءٌ اصْطِنَاعِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمٌ يجمَع بين عُلومِ الحاسبِ وعلمِ النفسِ المعرفيِّ وعلمِ اللغةِ النفسيِّ وعلمِ اللغةِ العَصَبيّ، ويبحَث في ماهِيَّة الذَّكاءِ البَشَرِيّ، بما في ذلك دراسةُ اللغةِ من حيث استعمالُها في إطار نظريةٍ حِسابِيةٍ للذّكاء. ويَهدِف إلى تَحديدِ الأصولِ والآليّاتِ العامَّةِ التي تقوم عليها عَمَليّاتُ التَّفكير، ووَضعِ نَظرياتٍ عامَّةٍ لتَمثِيل المعرِفةِ وحَلِّ المشكِلات، ومن ثم تَطبيق هذه المعرفةِ باستِحداث آلاتٍ تَعمَل بذكاء. ومجالاتُه الرئيسَةُ هي: معالَجَةُ اللغةِ الطبيعيةِ natural language processing، والنُّظُمُ الآليَّةُ الخَبيرَةُ expert system، والفَهمُ الآليُّ للكلام speech understanding، وتَقنِيةُ الإنسانِ الآلِيِّ robotics. وعلى الرّغم من أن فكرَةَ الذَّكاءِ الاصطناعيِّ انطلَقَت من وَظائف العَقلِ البَشَريّ، أو هي محاكاةٌ له، فإن العلماءَ يحاولون الاستِفادةَ من مُعطَياته ونتائجِه في معالَجَة بعضِ جوانبِ النَّقصِ في العَقل البشريّ، بما في ذلك الجوانبُ اللغوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ذكاء اصطناعي ","nonDiacriticsLemma":"ذكاء اصطناعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ذَكَاءٌ اصْطِنَاعِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

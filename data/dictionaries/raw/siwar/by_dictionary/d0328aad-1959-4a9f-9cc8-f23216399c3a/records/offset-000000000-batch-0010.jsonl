{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fa5a6259-a727-4c59-8f63-189d19dbd984/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fa5a6259-a727-4c59-8f63-189d19dbd984","word":"عُسْرٌ قِرَائِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b894d","lexicalEntryId":"fa5a6259-a727-4c59-8f63-189d19dbd984","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عُسْرٌ قِرَائِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُطلَق على العَمَى القِرائيِّ أو العَجزِ القِرائيِّ، وهو فَقدُ الإنسانِ المتعلِّمِ القُدرَةَ على القراءة مع قُدرَته على الإبصار. وهو أحدُ آثارِ إصاباتِ الدِّماغ، خاصةً مركز القراءةِ فيه؛ لهذا يُستَخدم هذا المصطلَحُ للدَّلالة على العُسْر القرائيِّ المكتَسَب، تميِيزا له عن عُسْر القراءةِ المعروفِ بديسلِكْسْيا dyslexia، الذي يُطلَق على عَجزٍ كامِنٍ لدى المرءِ منذُ الوِلادة. وقد يُصاب الإنسانُ بالعُسر القرائيِّ هذا مع احتفاظه بالقُدرة على الكتابة، وهذا ما يُعرَف بالعَمَى القرائيِّ من غير عَمًى كتابيٍّ. راجع:  @(aphasia) و  @(alexia without agraphia) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عسر قرائي ","nonDiacriticsLemma":"عسر قرائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عُسْرٌ قِرَائِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/46202d90-39f8-4d54-9011-eed20afee79c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"46202d90-39f8-4d54-9011-eed20afee79c","word":"الخَوَارِزْمِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b894e","lexicalEntryId":"46202d90-39f8-4d54-9011-eed20afee79c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الخَوَارِزْمِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، نسبةً إلى عالِم الرِّياضياتِ العربيِّ أبي بكر الخوارِزمي، ويَعني تحديدَ طريقَةِ حَلِّ مشكلةٍ أو مسألةٍ آليًّا بخطوات مُتَسَلْسِلَةٍ ومحدودَةِ العَدَد، تنتَهي بحلِّ المشكلةِ أو بإثبات أنها غيرُ قابلةٍ للحَلِّ. وتُصاغ الخوارِزميةُ بلغةٍ من لغات البَرمَجَةِ الحاسوبيةِ في شَكل برنامَج لتكون مَفهومَةً للآلَة التي تحلُّ المشكلة. وتُستَعمَل الخوارِزمياتُ في النحو التوليديِّ، فيما يتعلَّق بالاشتِقاقات وإعادَةِ الكتابة، حيث تولِّد عددا غيرَ نهائيٍّ من البنى التركيبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"الخوارزمية ","nonDiacriticsLemma":"الخوارزمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الخَوَارِزْمِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/451b81a3-f787-432d-a529-066b27e258fd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"451b81a3-f787-432d-a529-066b27e258fd","word":"الأَلِفْبَائِيَّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b894f","lexicalEntryId":"451b81a3-f787-432d-a529-066b27e258fd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الأَلِفْبَائِيَّة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الرُّموزُ الكِتابيةُ، أو الحُروفُ الهِجائيةُ، التي تُكتَب بها اللغةُ التي تَتَّبِع النظامَ الألِفبائيَّ alphabetic system. ويختَلِف النظامُ الألفبائيُّ من لغةٍ إلى أخرى من حيث نوعُ الرُّموزِ وتَمثيلُها للأصوات؛ فالعربيةُ والفارسيةُ والأُرديةُ تَستَخدِم الألفبائيةَ العربيةَ، والإنجليزيةُ تَستَخدِم الألفبائيةَ الرومانيةَ، والرُّوسيةُ والأوكرانيةُ والبُلغاريةُ تَستَخدِم الألفبائيةَ السّيريليةَ Cyrillic، في حين تَستخَدِم لغاتٌ أخرى أنظِمةً كتابيةً مختَلِفةً كالصينية واليابانيةِ والكورية. واتِّفاقُ اللغةِ الهَدَفِ مع لغة المتعلِم الأمِّ في النظام الكتابيِّ قد يُيَسِّر عمَليةَ تَعلُّمِ اللغةِ الهَدَفِ في بداية الأمرِ، لكنه يُسبب كثيرا من المشكلات في الدّلالات اللغويةِ والمفاهيمِ الثقافيةِ، لاسيَّما حين تَكثُر النّظائرُ الخادِعَةُ في اللغَتَين deceptive cognates. راجع:  @(alphabetic writing/notation) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"الألفبائية ","nonDiacriticsLemma":"الألفبائية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الأَلِفْبَائِيَّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fe660aeb-ae3f-4796-9de8-a2527a6ee3ec/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fe660aeb-ae3f-4796-9de8-a2527a6ee3ec","word":"تَمْرِينُ المُزَاوَجَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b968a","lexicalEntryId":"fe660aeb-ae3f-4796-9de8-a2527a6ee3ec","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَمْرِينُ المُزَاوَجَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلح في طرائق تدريسِ اللغات، يُشير إلى تَمرينٍ أو تدريبٍ يَحوِي قائمَتَين مُتَعامِدَتَين من الكلمات أو العباراتِ أو الجُمَل، يتطلَّب أن يَختار الطالبُ وحدَةً لغويةً من القائمة الثانيةِ لتُناسِب وحدَةً من القائمةِ الأولى. ولتمارين المزاوجَةِ أساليب وأهدافٌ مختَلِفة؛ فقد تكون وحداتُ القائمةِ الأولى أسئلةً ووَحداتُ القائمةِ الثانيةِ إجاباتٍ عنها، أو تكون الأولى كلماتٍ والثانيةُ مُرادِفاتٍ لها، وقد تكون وَحداتُ القائمةِ الأولى كلماتٍ أو عباراتٍ من جُملةٍ والثانيةُ كلماتٍ أو عباراتٍ مُكمّلَةً للجُملة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تمرين المزاوجة ","nonDiacriticsLemma":"تمرين المزاوجة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَمْرِينُ المُزَاوَجَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4acff74a-657f-4757-9bc2-50bbbe85d272/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4acff74a-657f-4757-9bc2-50bbbe85d272","word":"طُلّابٌ أقَلِّيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b968e","lexicalEntryId":"4acff74a-657f-4757-9bc2-50bbbe85d272","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"طُلّابٌ أقَلِّيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعةٌ قليلةٌ من الطلاب لغتُهم الأمُّ غيرُ اللغةِ الأمِّ لمواطِنِي البلَدِ الذي يدرسون فيه. وهو مصطلحٌ غالبا ما يُطلَق على الطلاب الأجانبِ الناطقين بغير الإنجليزيةِ من الصغار الذين يلتَحِقون بالمدارس الأمريكيةِ والبريطانيةِ حيث الإنجليزيةُ هي لغةُ التدريسِ في المدارس والجامعات. ويَنطبِق هذا الوَصفُ على طلابٍ ناطِقين بلغةٍ غيرِ لغةِ التدريسِ ضِمنَ دولةٍ واحدة، كما هي الحالُ في مناطِق مختَلِفةٍ من كندا. ويَترتَّب على ذلك تخَلُّفُ هؤلاء عن أقرانهم أكاديميًّا، ما لم توضَع لهم برامِجُ تَقوِيَةٍ في لغة التدريس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"طلاب أقلية ","nonDiacriticsLemma":"طلاب أقلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"طُلّابٌ أقَلِّيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

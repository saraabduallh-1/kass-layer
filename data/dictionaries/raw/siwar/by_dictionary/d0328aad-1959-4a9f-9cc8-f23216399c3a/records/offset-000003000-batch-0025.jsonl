{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/557a226f-f879-45bb-b5a1-5e8d10c5aad4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"557a226f-f879-45bb-b5a1-5e8d10c5aad4","word":"نَحْوِيٌّ صَرْفِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9693","lexicalEntryId":"557a226f-f879-45bb-b5a1-5e8d10c5aad4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَحْوِيٌّ صَرْفِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تركيبيٌّ، يُشير إلى أصنافٍ أو عناصِرَ لغويةٍ يمكن وَصفُها بأنها صرفيةٌ ونحويةٌ في آنٍ واحد؛ تَنطَبِق عليها الخَصائصُ النحويةُ من جانبٍ، والخصائصُ الصرفيةُ من جانبٍ آخَر، فيُقال: كلمةٌ صرفيةٌ نحويةٌ morpho-syntactic word، وصِنفٌ نحويٌّ صرفيٌّ morpho-syntactic category، وخصائصُ نحويةٌ صرفيةٌ morpho-syntactic properties. فتَقسيم الاسمِ أو تَصريفُه أو تَميِيزُ أنواعِه من حيث العَدَدُ مثلا إلى مفرَدٍ ومثنى وجمعٍ، وما يتطلَّبه كلُّ صِنفٍ منها من إسنادٍ أو علامةٍ إعرابية ٍ- موضوعٌ نحويٌّ، لكن الزوائد التي تَلحَق كلَّ صِنفٍ، موضوعٌ صرفيٌّ، أي مورفيماتٌ صرفية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نحوي صرفي ","nonDiacriticsLemma":"نحوي صرفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَحْوِيٌّ صَرْفِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a7d861c7-445d-4599-92fb-9bd15b02d244/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a7d861c7-445d-4599-92fb-9bd15b02d244","word":"دَلالَةٌ إحْصَائيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e9c","lexicalEntryId":"a7d861c7-445d-4599-92fb-9bd15b02d244","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دَلالَةٌ إحْصَائيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ إحصائيٌّ لاختِبار الفرضيات الإحصائية، يُشير إلى القيمَة الإحصائيةِ التي لا يكون لعَوامِلِ الصُّدفَةِ فيها إلا أَثَرٌ محدود، بل إنها جاءت نتيجةَ عواملَ أخرى كما تُثبتُها الإجراءاتُ الإحصائية. تُشير درَجةُ هذه الدَلالةِ إلى أن النتائجَ التي تم الحصولُ عليها، أو النتائجَ الأكثَرَ تَطرُّفا، قد حدَثَت بالصُّدفَة في حالاتٍ أقَلَّ من: 5 بالمئة، وكلَّما صغرَت قيمَةُ الاحتِمالِ زادَ مَغزَى النتائج، أي قَلَّ احتِمالُ حُدوثِها بالصُّدفَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دلالة إحصائية ","nonDiacriticsLemma":"دلالة إحصائية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دَلالَةٌ إحْصَائيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/12137714-7cc0-4b46-891f-0b9a22e080bd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"12137714-7cc0-4b46-891f-0b9a22e080bd","word":"البِنْيَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e9d","lexicalEntryId":"12137714-7cc0-4b46-891f-0b9a22e080bd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"البِنْيَوِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وَصفٌ عامٌّ يُطلَق على أيِّ منهَجٍ لدراسَة السُّلوكِ الإنسانيِّ، بما في ذلك الدراساتُ اللغويّةُ والأدبيّةُ والنَّقديَّة، وفقَ منهَجٍ معيَّنٍ يقوم على تحليل كلِّ فَرعٍ من فُروعه أو مستَوًى من مستَوياته إلى مجموعَةٍ من الأبنية أو الأنظِمَةِ التي تتألَّف من عناصِرَ تكتَسِب معانيَها من علاقات بعضِها ببعض. بيدَ أن هذا المصطلَحَ حين يُستَعمَل في علم اللغةِ فإنه يَعني علمَ اللغةِ البِنيَوِيَّ أو النظريةَ البِنيَوِيَّةَ في علم اللغةِ، التي هيمَنَت على الدراسات اللغويةِ الحَديثةِ منذ نَشأتِها، وبَلَغَت ذِروَتَها في منتَصف القرنِ العشرين، خاصة لدى اللغويِّ الأمريكيِّ ليونارد بلومفيلد Leonard Bloomfield. راجع:  @(Structural linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"البنيوية ","nonDiacriticsLemma":"البنيوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"البِنْيَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عرب
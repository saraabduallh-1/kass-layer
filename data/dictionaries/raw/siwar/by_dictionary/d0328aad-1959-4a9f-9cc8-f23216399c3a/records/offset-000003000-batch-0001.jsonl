{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/72ff6e96-2d19-4d4f-862d-50906e314072/get-public-entry"},"browse_index_record":{"lexicalEntryId":"72ff6e96-2d19-4d4f-862d-50906e314072","word":"أُسْلُوبُ الكَلِمَةِ المِفْتَاحِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b942d","lexicalEntryId":"72ff6e96-2d19-4d4f-862d-50906e314072","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُسْلُوبُ الكَلِمَةِ المِفْتَاحِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إستراتيجيةٌ في تعلُّم اللغةِ الثانية، يَربط فيها المتعلِّمُ كلمةً في اللغة الهَدَفِ بكلمةٍ تُشبِهها من لغته الأمِّ في مقامٍ معيَّن؛ ليَسهُل عليه تذَكُّرُها. فالكلمةُ الإنجليزيةُ: door (باب)، يَربطُها المتعلِّمُ العربيُّ بالكلمة العربيةِ (دُور) جمع دار، ويتخَيَّل العلاقةَ بين (الباب) و(الدُّور)؛ فيتذَكَّر معنى الكلمةِ الإنجليزيةِ واستعمالَها كُلَّما ورَدَت في نَصٍّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أسلوب الكلمة المفتاح ","nonDiacriticsLemma":"أسلوب الكلمة المفتاح","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُسْلُوبُ الكَلِمَةِ المِفْتَاحِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e8476e04-ec24-43aa-8fe5-597326599e48/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e8476e04-ec24-43aa-8fe5-597326599e48","word":"دِرَاسَةُ الحَرَكَاتِ المُجَرَّدَةِ (عِلمُ الكِينِيمَاتِ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b942e","lexicalEntryId":"e8476e04-ec24-43aa-8fe5-597326599e48","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دِرَاسَةُ الحَرَكَاتِ المُجَرَّدَةِ (عِلمُ الكِينِيمَاتِ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمٌ يُعنَى بدراسة الحرَكاتِ الجِسميةِ المعبِّرةِ عن مَعانٍ لغوية، وهي الحرَكاتُ التي تُرافِق الكلامَ أو تؤدِّي معنًى دونَ كَلامٍ مُرافِق؛ كتَحريك الرأسِ إلى الأسفَل إشارَةً إلى القَبول، وهَزِّ الكَتِفَين للاستغراب، وحرَكاتِ اليَدَين للتحذير، والتأفُّفِ للغَضَب. وتختَلِف هذه الحرَكاتُ من لغةٍ لأخرى، ومن مجتَمَعٍ لآخَر، لكنّ بعضَها مشتَرَكٌ بين اللغاتِ والثقافات. ويُلحَق بذلك تَغيِيرُ المتكلِّمِ نَغمَةَ صَوتِه تَعبيرًا عن اتجاهٍ أو تأكيدًا لرَأي. راجع:  @(para-linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دراسة الحركات المجردة (علم الكينيمات) ","nonDiacriticsLemma":"دراسة الحركات المجردة (علم الكينيمات)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دِرَاسَةُ الحَرَكَاتِ المُجَرَّدَةِ (عِلمُ الكِينِيمَاتِ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8ea073af-abf1-4211-88e6-1d32abbd3922/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8ea073af-abf1-4211-88e6-1d32abbd3922","word":"لُغَةٌ مُشْتَرَكَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b942f","lexicalEntryId":"8ea073af-abf1-4211-88e6-1d32abbd3922","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مُشْتَرَكَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ تُستَعمَل لأغراضٍ تواصُليةٍ بين مجموعاتٍ من الناس متحَدِّثين بلُغاتٍ أمٍّ مختَلِفة، وهي مشتَقَّةٌ من عبارة لِسان مُشتَرَك Frankish tongue الإيطاليةِ التي تَصِف لغةَ التجارَةِ في مناطِق البَحرِ الأبيضِ المتوسِّطِ في العُصور الوُسطى بين الناسِ الذين لايَفهَم بعضُهم بعضا. أما اليومَ، فتُستَعمَل للتَّواصُل بين الشُّعوبِ المختَلِفَة. هذه اللغةُ قد تكون لغةَ اتصالٍ عالَمية؛ كالعربية في عُصُور الدولةِ العربية الإسلاميةِ، والإنجليزيةِ في العَصر الحاضِر، والآراميةِ في الشرق الأدنى القديم. وقد تكون لغةً أمًّا لإحدى المجموعاتِ اللغوية؛ كالعربية سابقا، والإنجليزيةِ في عصرنا الحاضرِ، ولغةِ الهاوسا في غَرب إفريقيا، أو ليسَت لغةً أمًّا لأيٍّ منها؛ كاللغة الهَجِينِ pidgin language، أو اللغةِ المولَّدَةِ من عدَّة لغاتٍ هَجَينٍ creole languages. وقد يكون عَدَدُ الناطقين بها قليلًا جدًّا قياسًا على متحَدِّثيها لغةً مشترَكة؛ كالسواحيلية في شَرق إفريقيا. وأصلُ المصطلحِ إيطاليٌّ نَشأ في منطقة البحرِ الأبيضِ المتوسِّطِ إبان الحروبِ الصليبيةِ في العُصور الوسطى، حين لجأ الغزاةُ الصليبيون والتجّارُ الناطِقون بعَدَدٍ من اللغات إلى استِعمال لغةٍ مشتَرَكة مُستَمَدَّة من الإيطالية، وممزوجَة بالفرنسية والإسبانيةِ واليونانيةِ والعربيةِ والتركيةِ؛ للتواصُل فيما بينهم في تلك المنطقة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة مشتركة ","nonDiacriticsLemma":"لغة مشتركة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مُشْتَرَكَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6eb38ef3-18ef-49fa-be8e-76057246dd66/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6eb38ef3-18ef-49fa-be8e-76057246dd66","word":"اللُّغَةُ والقُوَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9430","lexicalEntryId":"6eb38ef3-18ef-49fa-be8e-76057246dd66","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ والقُوَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُشير إلى العلاقة بين اللغةِ أو نَوعِ اللغةِ التي يَستَعمِلها الأفرادُ في مجتَمَعٍ ما، وقُدرَةِ هؤلاء الأفرادِ على الوُصول إلى مراكِز القوَّةِ والتَّأثِيرِ في هذا المجتَمَع. تتَّضِح هذه العلاقَةُ في الدوَل الناطِقَةِ بالإنجليزية حيث يتَمَتَّع أصحابُ الكِفايَةِ المِعيارِيَّةِ العالِيَةِ فيها من السَّيطرَة على السياسة والإعلامِ والمالِ والأعمالِ والمكانَةِ الاجتِماعية، خِلافا لمن لا يتَمَتَّع بهذه الكِفايَةِ من الأقَلِّيَّات الإثنِيةِ العِرقِية. يرى فريقٌ من الباحثين وَجهًا آخَرَ لهذه القوَّة؛ حين يُشيرون إلى أن القوَّة التي يتمَتَّع بها هؤلاء الأكفِيَاءُ في اللغة كانت سبَبا لهذه الكِفايَةِ اللغويةِ، وليسَت نتيجَة لها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة والقوة ","nonDiacriticsLemma":"اللغة والقوة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ والقُوَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f84cc547-3583-4284-accb-d4c13586aad7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f84cc547-3583-4284-accb-d4c13586aad7","word":"الاسْتِعْدَادُ لتَعَلُّمِ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9431","lexicalEntryId":"f84cc547-3583-4284-accb-d4c13586aad7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الاسْتِعْدَادُ لتَعَلُّمِ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"استِعدادٌ فِطريٌّ لدى بعضِ الأفرادِ لتعلُّم اللغاتِ الأجنَبية، يَعني قُدرَةَ الفَردِ على تعلُّم لغةٍ ثانيةٍ أو أجنبيةٍ في المدَّة المقرَّرةِ لتعلُّمِها في الغالب. ويُعَدُّ من الفُروق الفَرديةِ التي تُمَيِّز بعضَ المتعلِّمين من غيرهم، ويرى بعضُ اللغويين أنه يختَلِف عن القُدرات العامَّةِ التي تُساعِد الإنسانَ على اكتساب المهاراتِ الأكاديمية. ويُقاس هذا الاستعدادُ باستعمال اختباراتٍ خاصَّةٍ تُسمّى اختباراتِ الاستِعدادِ اللغويِّ. راجع:  @(language aptitude) و  @(language aptitude test) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الاستعداد لتعلم اللغة ","nonDiacriticsLemma":"الاستعداد لتعلم اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الاسْتِعْدَادُ لتَعَلُّمِ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

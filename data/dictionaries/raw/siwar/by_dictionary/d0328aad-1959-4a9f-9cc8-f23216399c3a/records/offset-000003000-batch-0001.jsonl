{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/19b8dac7-b3ea-4170-a2a8-010e0444e04b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"19b8dac7-b3ea-4170-a2a8-010e0444e04b","word":"اللُّغَةُ والقَانُونُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9437","lexicalEntryId":"19b8dac7-b3ea-4170-a2a8-010e0444e04b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ والقَانُونُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةُ القانونِ ومُصطلَحاتُها وعباراتُها ودَلالاتُها التي أضحَت مُهِمَّةً في المحاكَمات والمرافَعاتِ القانونية، وصِياغَةِ القَوانين والأنظِمَة، سواء أكانت مَكتوبَةً أم مسموعَة. وقد ظَهَرَت مناهِجُ في تحليل هذه اللغة؛ حيث يَعتَمِد الحُكمُ على نتائج هذا التحليلِ وترجمَتِه. تتَميَّز لغةُ القانونِ بدِقَّة الألفاظِ والعِباراتِ والأساليبِ والصِّيَغِ والتّراكيبِ؛ لأن التَّغيِيرَ في شيءٍ من ذلك قد يُغيِّر الحُكم؛ لهذا تَلجأ المستَعمَراتُ السابِقَةُ إلى كتابَة قوانِينِها بلُغَة المستَعمِر كالإنجليزية والفرنسية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة والقانون ","nonDiacriticsLemma":"اللغة والقانون","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ والقَانُونُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

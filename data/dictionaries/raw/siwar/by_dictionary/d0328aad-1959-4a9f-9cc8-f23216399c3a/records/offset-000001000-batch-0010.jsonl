{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c2dec23a-9793-4a18-aea1-f867822eafd6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c2dec23a-9793-4a18-aea1-f867822eafd6","word":"اسْتِلْزَامٌ حِوارِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d41","lexicalEntryId":"c2dec23a-9793-4a18-aea1-f867822eafd6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْتِلْزَامٌ حِوارِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"استِتباعٌ أو تضَمُّن تحَاوُرِيٌّ، وهو ما يَستَلزِمُه الكلامُ ويُفهَم منه ضِمنا، ولو لم يُصَرَّح به، ويُسمى أيضاً المفهومَ التَّحاوُرِيَّ أو التَّضميناتِ العُرفية. فإذا قال المعلِّمُ لأحَد طلابِه: (هل أكمَلتَ واجبَك المنزليَّ؟) فأجابه الطالبُ: (كنتُ مريضاً يا أستاذ)، فهذا يَعني أنه لم يُكمِله. وهذا استِتباعٌ حِوارِيٌّ أو مَفهومٌ دلاليٌّ يختَلِف عن الاستِتباعِ النحويِّ أو المفهومِ النحوي. والاسْتِتْباعُ التَّحاوُرِيُّ، أو الاستِلْزامُ الحِوارِي، أحَدُ أهمِّ جوانبِ الدراساتِ التَّداوُلية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"استلزام حواري ","nonDiacriticsLemma":"استلزام حواري","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْتِلْزَامٌ حِوارِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a6e39944-9249-413a-8821-323593c2d84f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a6e39944-9249-413a-8821-323593c2d84f","word":"شبيهُ المُوَلُّدِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d48","lexicalEntryId":"a6e39944-9249-413a-8821-323593c2d84f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"شبيهُ المُوَلُّدِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، أطلَقَه جون بلات John Platt على التَّنوُّع في استعمال اللغةِ الثانيةِ في بلَدٍ متعَدِّدِ اللغاتِ العِرقِيَّة، حيث تتحَوَّل فيه اللغةُ إلى لغةٍ شَبيهَةٍ باللغة الموَلَّدَةِ في بعض مراحِلِها. يمثِّل بلات لهذه الظاهِرَةِ بإنجليزية سنغافورة Singapore English، وهي لغةُ المحتَلِّ البريطانيِّ حين فرَضَها على الناطِقين باللغات الثلاثِ الرئيسَةِ في سنغافورة: لغةُ الملايو، واللغةُ الهندِية، واللغةُ الصِّينِيّة. وَصَف بلات هذه اللغةَ بخصوصِيَّتها في حَذف الرّابِطِ copula، وعدَمِ تَصريفِ بعضِ الأفعال، وتجاهُل المطابَقَةِ في الإسناد، ونحِو ذلك من السِّمات. راجع:  @(pidgin (language)) و  @(creole (language)) و  @(creole continuum) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"شبيه المولد ","nonDiacriticsLemma":"شبيه المولد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"شبيهُ المُوَلُّدِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/01761b08-ff3c-46fc-b48f-0a5160ad8178/get-public-entry"},"browse_index_record":{"lexicalEntryId":"01761b08-ff3c-46fc-b48f-0a5160ad8178","word":"فَرضِيَّةُ الفَتْرَةِ الحَرِجَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d49","lexicalEntryId":"01761b08-ff3c-46fc-b48f-0a5160ad8178","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرضِيَّةُ الفَتْرَةِ الحَرِجَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضيةٌ أو نظريةٌ في اكتساب اللغة، تَرجِع أصولُها إلى نظرية اللغويِّ الأمريكيِّ إريك لينيبرج Eric Lenneberg، وتَرى أن النُّمُوَّ اللغويَّ لدى الطفل يتوَقَّف في فترَةٍ عُمرِيةٍ معيَّنة؛ لأسبابٍ بيولوجِية عَصَبِية؛ لما يُعتَقَد من أن مناطِقَ اللغةِ في الدِّماغ تتصَلَّب بعد هذه الفترَة؛ فيَصعُب حينئذٍ اكتسابُ اللغةِ بشَكل طبيعي. لكن اختَلَف العُلماءُ فيها؛ فمنهم من حَدَّدَها في الثانية عشرةَ أو الثالثةَ عشرة، ومنهم من حدَّدَها في الخامسةَ عشرةَ أو السادسةَ عشرة. وما زالت هذه الفَرضِيةُ مَثارَ جَدَلٍ بين اللغويين خاصةً في اكتساب اللغةِ الثانية؛ لوُجود دلائلَ متناقِضَةٍ في حالات الأطفالِ والبالِغين. راجع:  @(bio-linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية الفترة الحرجة ","nonDiacriticsLemma":"فرضية الفترة الحرجة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرضِيَّةُ الفَتْرَةِ الحَرِجَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/34a0ce52-9719-431a-aa1c-9ae59414dcdc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"34a0ce52-9719-431a-aa1c-9ae59414dcdc","word":"وَحْدَةٌ صَرْفِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b972c","lexicalEntryId":"34a0ce52-9719-431a-aa1c-9ae59414dcdc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَحْدَةٌ صَرْفِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أصغَرُ وحدةٍ لغويةٍ تحمِل معنى أو وَظيفةً صرفيةً أو نحوية، ولا يمكن تقسيمُها إلى وحداتٍ أصغَر ذاتِ معنى. ويُعَدُّ المورفيمُ وحدةَ التحليلِ الصرفيِّ بدَلا من الكلمة التي يَصعُب تعريفُها تعريفًا محدَّدًا، لاسيَّما في الدراسات المقارَنَة؛ لاختلاف اللغاتِ في تعريفها، وبيانِ حُدودِها. والمورفيمُ يكون حُرًّا free morpheme مثلُ: (مُسلم) و(مؤمن) و(معلِّم)، ومُقيَّدًا bound morpheme كالياء والنونِ في (مسلمِين) و(مؤمِنين) و(معلِّمين)، ومثلُ ذلك كلمةُ: books الإنجليزيةُ المكوَّنةُ من مورفيمٍ حُرٍّ هو: book، ومورفيمٍ مقيَّدٍ هو: s. ويَظهَر المورفيمُ في شَكل عُنصُرٍ صوتيٍّ، وفي ترتيب العناصِرِ الصوتيةِ داخِلَ الصيغَةِ الصرفيةِ أو الكلمة، وفي مَوضِع الكلمةِ من الجُملة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وحدة صرفية ","nonDiacriticsLemma":"وحدة صرفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَحْدَةٌ صَرْفِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

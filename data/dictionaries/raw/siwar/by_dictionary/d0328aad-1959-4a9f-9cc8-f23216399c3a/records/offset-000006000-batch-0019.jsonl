{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/126eb092-dba0-4bbd-a06b-80eeaf33463c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"126eb092-dba0-4bbd-a06b-80eeaf33463c","word":"كِتَابَةٌ ذَاتِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba1e4","lexicalEntryId":"126eb092-dba0-4bbd-a06b-80eeaf33463c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كِتَابَةٌ ذَاتِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ في الكتابة لا يَهتَمُّ فيه الكاتِبُ بالقارئ حتى كأنه يَكتُب لنفسه، ويُسمّى أيضا: egocentric writing ؛ فلا يُمَهِّد الكاتِبُ لكتابَته بشيءٍ يجذِب القارِئَ إليها، ولا يَربط مَعلوماتِ النَّصِّ بخَلِفِية القارئ. هذا الأسلوبُ مُخالِفٌ للمَألوف من أن الكاتِبَ يَكتُب للقارِئ reader-based prose. والكتابةُ الذّاتِيَّةُ قد يَسلُكها بعضُ الكتَّابِ قبلَ إخراجِ النَّصِّ إلى القارئ، ثم يُحرِّرها ويُعدِّلها بما يناسِب خَلفيةَ القارِئ، وقد يُخرِجها بعضُهم على هيئتها الأولى. راجع:  @(egocentric writing) و  @(reader-based prose) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كتابة ذاتية ","nonDiacriticsLemma":"كتابة ذاتية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كِتَابَةٌ ذَاتِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

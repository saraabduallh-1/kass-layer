{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b7f1335e-5a77-4a81-8853-674f6828244c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b7f1335e-5a77-4a81-8853-674f6828244c","word":"تَرْتِيبُ الكَلِمَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba1fa","lexicalEntryId":"b7f1335e-5a77-4a81-8853-674f6828244c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْتِيبُ الكَلِمَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَظْمُ الكلامِ في النحو، وهو نَسَقُ الكلماتِ وتعاقُبُها في العبارة أو الجُملةِ أو التركيبِ وفقا لأصُول البِناءِ النحويِّ للجُملة في لغةٍ ما. يَعتَمِد كثيرٌ من اللغات على تَرتيب الكلماتِ في التعبير عن العلاقات النحويةِ في التركيب، ومن النادِر أن تخلوَ منه لغةٌ من اللغات. فمَوقِعُ الكلمةِ في الجُملة الإنجليزيةِ مثلا هو الذي يُحَدِّد وَظيفَتَها من حيث الفاعليةُ أو المفعولِيَّة. ففي الجُملَتَين: Ali saw Sami ، و: Sami saw Ali، لا يَتعيَّن الفاعلُ من المفعول به إلا بتَرتيب الكلمات. وبعضُ اللغاتِ لا يُشَكِّل ترتيبُ الكلماتِ فيها أهميةً كُبرى لتحديد وظائفِها؛ كالعربية الفصحى التي تعتَمِد وَظيفةُ الكلمةِ فيها على مَوقِعها من الإعراب الذي غالباً ما تُظهِرُه العلامَةُ الإعرابيةُ، إضافةً إلى عوامِل أخرى منها ترتيبُ الكلماتِ ولاسيَّما عند خَوفِ اللَّبس، وفي العبارات القَصيرَة؛ كالنَّعت والمنعوت، والمضافِ و المضافِ إليه، والضَّميرِ ومَرجِعِه، والموصولِ وعائدِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ترتيب الكلمات ","nonDiacriticsLemma":"ترتيب الكلمات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرْتِيبُ الكَلِمَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f699a1cf-134c-421b-a056-5ec7c189a512/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f699a1cf-134c-421b-a056-5ec7c189a512","word":"صَحِيفَةٌ كِتَابِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba1fb","lexicalEntryId":"f699a1cf-134c-421b-a056-5ec7c189a512","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَحِيفَةٌ كِتَابِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سِجِلٌّ كِتابِيٌّ يُدَوِّن فيه الطالبُ أفكارَه وتجاربَه ومَلحوظاتِه وانطِباعاتِه عن الكتابة داخلَ المدرسةِ وخارِجَها. هذا السِّجِلُ مُهمٌّ لمساعدة الطالبِ في اختِيار الموضوعاتِ المناسِبةِ للكتابة، ومُمارَسَةِ الكتابةِ الحُرَّة، وتَنمِيَةِ مَهاراتِها، والطَّلاقَةِ الكتابية، وقد يكون مقدّمةً أوَّلِيَّةً في التعبير الكتابيّ. ويُفيد هذا السِّجِلُّ في تَنمِيَة الحِوارِ بين الطالبِ والمعلِّم، كما أنه فُرصَةٌ لمعرِفة المعلِّمِ طُلابَه عن كَثَب. راجع:  @(learning log) و  @(reading log) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صحيفة كتابية ","nonDiacriticsLemma":"صحيفة كتابية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَحِيفَةٌ كِتَابِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

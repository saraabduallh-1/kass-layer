{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/13981a0c-cae5-434b-a70f-13b4ffe1a015/get-public-entry"},"browse_index_record":{"lexicalEntryId":"13981a0c-cae5-434b-a70f-13b4ffe1a015","word":"نِظامُ الكَلِمَاتِ الحُرِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9134","lexicalEntryId":"13981a0c-cae5-434b-a70f-13b4ffe1a015","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نِظامُ الكَلِمَاتِ الحُرِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النَّسَقُ الحُرُّ، وهو حُرِّيةُ ترتيبِ عناصِرِ الجُملةِ بحيث لا يُحدِث تغييرُ واحدٍ منها تغييرا في المعنى أو الوَظيفةِ النحوية، ولاسيَّما في اللغات التي تُعبِّر عن العلاقات النحويةِ في تراكيبها بالعلامة الإعرابيةِ، كالعربية مثلا. فجُملةُ: شاهَدَ محمدٌ خالدًا، هي نفسُها: شاهَدَ خالدًا محمدٌ، خلافا لنِظام الكلماتِ الثَّابِتِ، أو النَّسَق الثابِتِ، الذي تلتَزِم به بعضُ اللغاتِ في معظَم تراكيبِها، كالإنجليزية مثلا. راجع:  @(fixed word order) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظام الكلمات الحر ","nonDiacriticsLemma":"نظام الكلمات الحر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نِظامُ الكَلِمَاتِ الحُرِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

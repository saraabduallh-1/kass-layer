{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b9899629-0c4c-44dc-8cde-691e9a3d0a09/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b9899629-0c4c-44dc-8cde-691e9a3d0a09","word":"وَظِيفَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9142","lexicalEntryId":"b9899629-0c4c-44dc-8cde-691e9a3d0a09","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَظِيفَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُطلَق على الوَظيفَة النحويةِ التي تؤدِّيها الكلمةُ أو العبارةُ في التركيب؛ كوَظيفَة الفاعلِ، ووَظيفةِ المفعولِ به، ونحوِ ذلك. فكلمةُ: (المسلم) في جُملة: أدَّى المسلمُ ما يجب عليه، تؤدِّي وَظيفةَ الفاعِل، وعبارَةُ: my brother في جُملة: I met my brother yesterday تؤدِّي وَظيفةَ المفعولِ به.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يُطلَق على الغَرَض الذي يؤدِّيه اللَّفظُ أو الوَحدةُ اللغويةُ في الاستعمال. وتُصَنَّف اللغةُ لأغراضٍ تعليميةٍ إلى عدَّة وَظائف؛ كالطَّلَب، والاعتِذار، والشَّكوَى، والتَّحيَّات، والدَّعوَة، والرَّفض، والاستِفهام، والنَّفي، والتَّعَجُّب. والصِّيَغُ والتراكيبُ النحويةُ ليسَت محدِّداتٍ لوَظائف اللغة، ولكن الصِّيغَةَ أو التركيبَ قد يُستَعمَل في أكثَر من وَظيفة؛ فصِيغَةُ الأمرِ مثلا قد تؤدِّي وَظيفةَ الأمرِ أو الطَّلَبِ أو الاقتِراحِ أو الدَّعوَةِ.  والمذهبُ الوَظيفيُّ functional approach هو أحدُ المذاهبِ التي تُبنَى عليها المناهِجُ وتُنَظَّم على أساسٍ منه مفرَداتُ المقرَّرِ في تعليم اللغاتِ الأجنبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"وظيفة ","nonDiacriticsLemma":"وظيفة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَظِيفَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c5b70a4b-3cb0-4e08-b589-71777c06431e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c5b70a4b-3cb0-4e08-b589-71777c06431e","word":"نَحْوٌ وَظِيفِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9143","lexicalEntryId":"c5b70a4b-3cb0-4e08-b589-71777c06431e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَحْوٌ وَظِيفِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظرةٌ وَظيفيةٌ للنحو، تُصَنَّف بموجبها التراكيبُ النحويةُ بناء على وَظيفةِ كلِّ جزءٍ أو تركيبٍ في الجُملة؛ كتَصنيف الفاعِلِ والمفعول، مثلا، بأنهما جُزءان رئيسان أو مَركزِيّان في الجُملة. وفي ضَوء هذه النظرَةِ أيضا، تُصنَّف التراكيبُ النحويةُ بناء على ما يؤدِّيه كلُّ جُزءٍ في الجُملة من وَظيفةٍ تواصُلية. راجع:  @(Functional Grammar) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نحو وظيفي ","nonDiacriticsLemma":"نحو وظيفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَحْوٌ وَظِيفِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/17ecf9b2-1653-4c39-83ae-38d3ef71329b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"17ecf9b2-1653-4c39-83ae-38d3ef71329b","word":"النَّظَرِيَّةُ الوَظِيفِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9144","lexicalEntryId":"17ecf9b2-1653-4c39-83ae-38d3ef71329b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّظَرِيَّةُ الوَظِيفِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويةٌ تؤمِن بأن اللغةَ وَسيلةُ تفاهُمٍ تتأثَّر بثلاثة عناصِرَ، هي: المتكلِّمُ، والسامِعُ، وموضوعُ الحديث. وهي النظريةُ التي اعتَمَد عليها علمُ اللغةِ الوَظيفيُّ أو اللِّسانياتُ الوَظيفيةُ، ذلك العلمُ الذي يَدرُس اللغةَ بوَصفها أداةً للتواصُل الاجتماعي، لا نظاما تركيبيّا منعَزِلا، ويهتَمُّ بالوَسائل والأدواتِ التي يستَخدِمها الفَردُ في اكتساب اللغةِ والتواصُلِ بها مع الناس في المجتَمَع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"نظريةٌ في اكتساب اللغةِ الثانية، متعدِّدَةُ الأوجِهِ والجوانب، ومكوَّنةٌ من عددٍ من النظريات الفَرعيةِ والمذاهبِ والنَّماذِجِ التي تفسِّر اكتسابَ اللغةِ الثانية، وتركِّز على التَّمثيل المعرِفيِّ للُّغة في ذِهن المتعلِّم، واستِغلالِه هذه المعرفةَ في استعمال اللغةِ الهَدَف، والتواصُلِ بها في المجتَمَع، وتؤكِّد أن اللغةَ لا تتمتَّع بخصوصيّةٍ أو ميزَةٍ في الدِّماغ. من أهم النَّماذِجِ المنبَثِقَةِ عن هذه النظرية: أنموذَجُ التَّنافُسِ competition model الذي يفسِّر سُلوكَ متعلِّمِ اللغةِ كما يَظهَر في الأداء بدَلا من تفسير الكِفايَة، وأنموذَجُ التّأهيلِ nativization model الذي يفسِّر اكتسابَ اللغةِ الثانيةِ في ضَوء اكتسابِ اللغةِ الأم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظرية الوظيفية ","nonDiacriticsLemma":"النظرية الوظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّظَرِيَّةُ الوَظِيفِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

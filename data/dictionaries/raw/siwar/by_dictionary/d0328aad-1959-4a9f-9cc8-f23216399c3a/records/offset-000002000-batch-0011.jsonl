{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/aa3dac20-b224-42cc-bc14-eea5e578c911/get-public-entry"},"browse_index_record":{"lexicalEntryId":"aa3dac20-b224-42cc-bc14-eea5e578c911","word":"تَرْجَمَةٌ حُرَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9147","lexicalEntryId":"aa3dac20-b224-42cc-bc14-eea5e578c911","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْجَمَةٌ حُرَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الترجَمةُ من لغةٍ إلى أخرى بتصَرُّفٍ ومُراعاةٍ للقواعد النحويةِ والصرفيةِ والأسلوبيةِ للُّغَة الهَدَفِ (المتَرجَمِ إليها)، ومن غير تقَيُّدٍ حَرفِيٍّ بتراكيب نُصوصِ اللغةِ الأصلِ (المترجَمِ منها) وأساليبِها، حتى إن القارئَ لا يَشعُر بأن النَّصَّ مُترجَمٌ من لغةٍ أخرى، وغالبا ما تتَّسِم هذه الترجَمةُ بأن نَصَّ اللغةِ الهدَفِ أطوَلُ من النَّصِّ الأصْلِ. ويُقابِلها الترجَمةُ الحَرفيةُ literal translation ، أي ترجَمةُ كَلِمَةٍ بكَلِمَة word-for-word translation.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ترجمة حرة ","nonDiacriticsLemma":"ترجمة حرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرْجَمَةٌ حُرَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

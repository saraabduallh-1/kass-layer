{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3119aa5e-812c-49c0-8447-26330c6e63f9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3119aa5e-812c-49c0-8447-26330c6e63f9","word":"تَغْيِيرٌ وَظِيفِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b914a","lexicalEntryId":"3119aa5e-812c-49c0-8447-26330c6e63f9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَغْيِيرٌ وَظِيفِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ معجَميٌّ، يُشير إلى إحدى الطرقِ التي يَتِمُّ بها وَضعُ الكلماتِ الجَديدةِ في اللغة، وهي طريقةٌ تُنَمِّي المفرَداتِ في طريقَة استِعمالِها، ولا تَزيد في عَدَد الكلماتِ أو الرَّصيدِ اللغوي. فالكلمةُ مَوجودَةُ بالفعل في اللغة، ومستَعمَلةٌ في وَظيفَةٍ نحويةٍ معيَّنة، لكنها تَكتِسِب وَظيفةً من نوع آخَرَ من أنواعِ الكلامِ دونَ تَغيِير في الصِّيغة. فالكلمةُ الإنجليزيةُ: mail مثلا حين تُستَعمَل اسمًا تكون قابِلةً لإضافَة: S دلالةً على الجمع، وحين تُستَعمَل فعلا تكون قابِلةً لإضافَة: S أو: ed أو: ing؛ وتأخُذ شَكلا واحدا حين تُستَعمَل نَعتًا، كما في كلمةِ: mailbox. وتُستَعمَل هذه الطريقةُ بكثرَةٍ في بعض اللغاتِ، كالإنجليزية مثلا، وتُستَعمَل بقِلَّة في لغاتٍ أخرى تتَميَّز فيها أصنافُ الكَلمِ بالصِّيغَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تغيير وظيفي ","nonDiacriticsLemma":"تغيير وظيفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَغْيِيرٌ وَظِيفِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

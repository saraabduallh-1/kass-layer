{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/acfdf172-e3ff-43d4-bed3-dac59bee4847/get-public-entry"},"browse_index_record":{"lexicalEntryId":"acfdf172-e3ff-43d4-bed3-dac59bee4847","word":"لُغَةٌ وَالِدَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b98d9","lexicalEntryId":"acfdf172-e3ff-43d4-bed3-dac59bee4847","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ وَالِدَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةُ الأصلِ أو لغةُ المنشَأِ لِلُغةٍ أخرى، أو اللغةُ الأمُّ لِلُغةٍ ما أو لعَدَدٍ من اللغات، وهي اللغةُ التي تَفرَّعَت منها لغةٌ واحدةٌ أو عدَّةُ لغات، مثلُ اللاتينيةِ التي تَفرَّعَت منها الفرنسيةُ والإسبانيةُ والإيطاليةُ وغيرُها من اللغات الرومانسية، ومثلُ السَّاميَّةُ التي تَفرَّعَت منها العربيةُ والعبريةُ وغيرُهما، ومثلُ العربيةِ التي تفرَّعَت منها بعضُ السَّاميّاتِ في رأي من يَرى أنها أمُّ اللغاتِ السَّاميَّة أو السَّاميَّةُ الأمُّ. وقد يُطلَق المصطلحُ على لغة الوالِدَيْن (الأبِ أو الأمِّ) حين يَنشأ الطفلُ بينهما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة والدة ","nonDiacriticsLemma":"لغة والدة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ وَالِدَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

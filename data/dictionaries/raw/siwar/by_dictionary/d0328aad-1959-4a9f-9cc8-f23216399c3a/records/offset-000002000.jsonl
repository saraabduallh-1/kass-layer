{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b8167555-584f-4e13-b6cc-ec6a66ca32e2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b8167555-584f-4e13-b6cc-ec6a66ca32e2","word":"دَافِعٌ خَارِجِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9031","lexicalEntryId":"b8167555-584f-4e13-b6cc-ec6a66ca32e2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دَافِعٌ خَارِجِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"حافِزٌ ليس أصليًّا في سُلوك الفَردِ، ولا نابِعا من داخِله، وليس نَشاطا تَسوقُه الدَّافعِيةُ الذَّاتِيةُ لدى الفَرد، بل يَرتَبِط بالنشاط الذي يَهدِف إلى تحصيلٍ مادِّيٍّ. من ذلك تعلُّمُ المرءِ لغةً ثانيةً أو أجنبيةً؛ لا لرَغبَةٍ ذاتيةٍ في تعلُّمِها، ولكن للالتحاق بعَملٍ ما، أو للحُصول على مالٍ أو جاهٍ أو مَنصِبٍ أو غيرِ ذلك. ويُسمّى هذا الدَّافِعُ أيضا بالدَّافِع النَّفعِيِّ instrumental motivation، في مُقابِل الدَّافِعِ الاندِماجِيِّ أو التَّكامُلِيِّ integrative motivation. والدَّوَافِعُ بجميع أنواعِها من أهمِّ الفُرُوقِ الفَردِيةِ لدى متعلِّمي اللغاتِ الأجنَبِيةِ التي يُؤثِّر وُجُودُها أو عَدَمُ وجودِها، إيجابًا أو سَلبًا، في تعلُّم اللغةِ الهَدَفِ واكتسابِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دافع خارجي ","nonDiacriticsLemma":"دافع خارجي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دَافِعٌ خَارِجِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

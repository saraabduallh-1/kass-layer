{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dd0d11e6-6873-4df2-bff4-f92b0734df00/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dd0d11e6-6873-4df2-bff4-f92b0734df00","word":"المُتَرْجِمُ المُحَلَّفُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f2b","lexicalEntryId":"dd0d11e6-6873-4df2-bff4-f92b0734df00","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المُتَرْجِمُ المُحَلَّفُ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على المترجِم المحتَرِفِ المخَوَّلِ بترجَمة أنواعٍ من الوَثائق الرَّسمية؛ كالشّهادات العِلميّةِ والمهنِيةِ، وجوازاتِ السَّفر، ورُخَصِ القِيادَة، وغيرِ ذلك من الوَثائق التي يحتاجها أصحابُها في سَفَرهم خارِجَ بلدانِهم، ويُطالَبون بتَقديم ترجَمةٍ محتَوَى تلك الوَثائقِ إلى لغةِ البَلَدِ المضيف، أو إلى لغةٍ عالميّةٍ كالإنجليزية مثلا. تختَلِف أنظِمةُ الدولِ في متَطلَّبات ترجَمةِ هذه الوَثائق؛ فبَعضُها يَكتَفي بالترجَمة مع توقيعِ المتَرجِمِ في كلِّ صَفحَةٍ منها، وبعضُها يُضيف طلَبَ خَتمٍ خاصٍّ بالمترجِم ومكانَ الترجَمةِ وتاريخَها، وبعضُها يشتَرِط - إضافةً إلى ذلك كلِّه - إرفاقَ خِطابٍ من المترجِم يحوِي معلوماتٍ عنه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المترجم المحلف ","nonDiacriticsLemma":"المترجم المحلف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المُتَرْجِمُ المُحَلَّفُ"}],"lemmaLanguage":{"code":
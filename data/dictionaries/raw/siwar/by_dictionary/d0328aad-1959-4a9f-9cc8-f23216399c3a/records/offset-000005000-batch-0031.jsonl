{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/de80f4a0-c154-43f1-8dc9-037962fe05e0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"de80f4a0-c154-43f1-8dc9-037962fe05e0","word":"المَدْخَلُ التّوليفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f25","lexicalEntryId":"de80f4a0-c154-43f1-8dc9-037962fe05e0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَدْخَلُ التّوليفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مدخلٌ أو مَذهَبٌ في بناء المنهَجِ وإعدادِ الموادِّ التَّعليميةِ في برامج تعليمِ اللغات، يتضَمَّن مجموعةً من الإجراءات والأساليبِ التي تَنطَلِق من الخاصِّ إلى العامِّ؛ فتَبدأ بتَحليل اللغةِ إلى أجزائها الأساسيةِ من أفعالٍ وأسماءٍ وحُروف، ثم يُعَلَّم كُلُّ جُزءٍ منها للطلاب بطريقَةٍ منفَصِلةٍ عن غيره، ثم يُطلَب منهم أن يُعيدوا تَركيبَها. وأيُّ منهَجٍ يتضَمَّن قائمةً من الوَحَدات والعناصِرِ اللغويةِ المنظَّمَةِ وفقَ تَدرُّجِها في الصُّعُوبة يُعَدُّ منهَجًا تَركيبيًّا، وهو المنهَجُ السائدُ في طرائق التدريسِ التقليدية. ويُقابِل هذا المدخَلَ أو المذهبَ المدخَلُ أو المذهَبُ التَّحلِيليُّ analytic approach ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المدخل التوليفي ","nonDiacriticsLemma":"المدخل التوليفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَدْخَلُ التّوليفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"au
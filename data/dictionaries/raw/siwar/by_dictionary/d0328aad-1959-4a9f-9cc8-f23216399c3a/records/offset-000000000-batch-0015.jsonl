{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/df92576f-a0bb-44d2-a477-eb4013d3b41b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"df92576f-a0bb-44d2-a477-eb4013d3b41b","word":"نَفَسِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89be","lexicalEntryId":"df92576f-a0bb-44d2-a477-eb4013d3b41b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَفَسِيَّةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"نُطقُ الصوتِ نُطقا يَصحَبه نَفَسٌ مَسموعٌ يُشبه صوتَ الهاء، ويحدُث هذا من اقتِراب الوَترَين الصوتَيَّين، فتزداد كمِّيةُ الهواءِ الخارِجةُ من الفَم مع ضِيق مجرَى الهواء، كما في نُطق: p في كلمة: pin الإنجليزية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"AR","root":null,"wordForms":[],"relatedSenses":[],"search":"نفسية ","nonDiacriticsLemma":"نفسية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَفَسِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/027f711a-bf3a-44ef-bab4-22b952da41a2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"027f711a-bf3a-44ef-bab4-22b952da41a2","word":"مَقْصُورَةٌ سَمعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89bf","lexicalEntryId":"027f711a-bf3a-44ef-bab4-22b952da41a2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَقْصُورَةٌ سَمعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الحُجَيْرَةُ أو الكَبيِنةُ السَّمعيةُ المخصَّصَةُ لكل طالبٍ في مَعمَل اللغةِ language laboratory، وتَحوِي سَمّاعةً وجِهازاً مَربوطا بجهاز التحَكُّم الرئيسِ الذي يُديره المعلِّمُ أو مهندِسُ المعمَل. وتختَلِف محتوَياتُ المقصورَةِ بحسَب نوعِ المعمَلِ ومستوى تِقنِيتِه؛ فالمعامِلُ التقليديةُ تعتَمِد على أجهزة التسجيلِ السَّمعيةِ فقط، في حين تعتَمِد المعامِلُ الحديثةُ على البرامج الحاسوبيةِ التي تَشمل الموادَّ السَّمعيةَ والبَصَريةَ وتَرتِبط بشَبَكات الاتصالِ الحاسوبيةِ وقواعدِ المعلومات. راجع:  @(language laboratory/lab) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مقصورة سمعية ","nonDiacriticsLemma":"مقصورة سمعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَقْصُورَةٌ سَمعِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

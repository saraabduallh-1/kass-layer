{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/983eca09-2401-457b-a789-6a907d0257a4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"983eca09-2401-457b-a789-6a907d0257a4","word":"رَتَابَةُ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89c8","lexicalEntryId":"983eca09-2401-457b-a789-6a907d0257a4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رَتَابَةُ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصبيٌّ، يُعرَف أيضا باضطِرابات التَّصاوُت، وهو مرضٌ عصبيٌّ يُصيب المرءَ نتيجةَ إصابَةٍ في الجانب الأيمَن من دِماغه، فيَعجز عن إحداث تَبايُنٍ في نَبَرات صَوته، بما في ذلك النَّبراتُ والتَّنغيماتُ الوَظيفية. وحينئذٍ يَصعُب عليه نَقلُ الشُّعورِ العاطِفِيِّ المناسِب والمعلوماتِ التَّداولية إلى المستَمعين إلى كلامه، فلا يُميِّز من يَستَمِع إليه بين الأسئلةِ والعباراتِ التقريريةِ والتفسيريةِ وعباراتِ النَّفي. وثمةَ أنواعٌ من رتابَة الكلام، أهمُّها رَتابَةُ الكلامِ الحرَكيِّ motor aprosodia، ورَتابَةُ الكلامِ الحِسِّيِّ sensory aprosodia. وترتَبِط بهذه الرَّتابَةِ رَتابةٌ أخرى تُعرَف برَتابَة الاستيعابِ، ويُطلَق عليها رَتابَةَ الكلامِ العاطِفِيِّ affective aprosodia.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"رتابة الكلام ","nonDiacriticsLemma":"رتابة الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رَتَابَةُ الكَلامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e67e1eb2-e508-48da-b785-89e9687fcaf2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e67e1eb2-e508-48da-b785-89e9687fcaf2","word":"اللُّغَةُ العَربَيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89c9","lexicalEntryId":"e67e1eb2-e508-48da-b785-89e9687fcaf2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ العَربَيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُطلَق على اللغة العربيةِ ولو لم يُذكَر معه لفظُ اللغةِ language، وهو استِعمالٌ عربيٌّ تراثيٌّ أيضا. ويُطلَق المصطلحُ أيضا على ما يُنسَب إلى اللغة العربيةِ من ألفاظ وصِيَغٍ وتراكيبَ وسِماتٍ لغويةٍ أخرى. واللغةُ العربيةُ تَنتَمي إلى مجموعة اللغاتِ السَّاميّةِ الحاميّة، بل هي أهمُّ اللغاتِ السَّاميّة؛ لاحتفاظها بظواهِرَ وسِماتٍ لغويةٍ من السَّاميّة الأمِّ أكثَرَ مما احتَفَظَت به السَّاميّاتُ الأخرى، أو هي السَّاميّةُ الأمُّ كما يرى بعضُ اللغويين. ومن الناحية الجغرافيةِ تُعَدُّ العربيةُ لغةً أفروآسياوية Afro-Asiatic language؛ لأن الناطقين بها موَزَّعون بين قارَّتَيْ أفريقيا وآسيا، إضافةً إلى كَونها لغةً اشتِقاقيةً تَصريفِيةً، ولَصقِيةً أيضا. وهي لغةٌ أمٌّ ولغةٌ رسميةٌ لشعوب الأقطارِ العربيةِ التي يَربو عَدَدُ سكَّانِها على أربَعِ مئةِ مليون، إضافةً إلى الأقليّات العربيةِ المنتَشِرَةِ في العالم، وهي أيضاً لغةُ دِينٍ للمسلمين الذي يمثِّلون خُمسَ سُكّانِ العالم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة العربية ","nonDiacriticsLemma":"اللغة العربية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ العَربَيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

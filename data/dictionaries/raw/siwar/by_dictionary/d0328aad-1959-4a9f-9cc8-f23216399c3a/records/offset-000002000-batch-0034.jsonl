{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fa438dc7-6a0f-4f70-93b4-414b3194c03f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fa438dc7-6a0f-4f70-93b4-414b3194c03f","word":"أَنْمَاطُ التَّنْغِيمِ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b938b","lexicalEntryId":"fa438dc7-6a0f-4f70-93b4-414b3194c03f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَنْمَاطُ التَّنْغِيمِ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الأنماطُ الصوتيةُ في الكلام في لغةٍ ما، يُعَبَّر عنها عادةً باختلافاتٍ في درَجة الصوتِ وارتِفاعِه، وفي المقطَع الصوتيِّ وطُولِه، وفي إيقاع الكلام. وتُؤدِّي هذه الأنماطُ وَظائفَ دَلاليةً مختَلِفة؛ كتَحديد الفَرقِ بين الاستفهامِ والإخبارِ في قولك: (مُوافِق؟) و(مُوافِق)، أو بين الاستفهامِ والتعَجُّبِ في قولك: سافَرَ محمدٌ إلى الرياض؟ وسافَرَ محمدٌ إلى الرياض! وتختَلِف أنماطُ التنغيمِ ودرَجاتُه ووَظائفُه من لغةٍ لأخرى، ومن لهجَةٍ لأخرى داخِلَ اللغةِ الواحدة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنماط التنغيم  ","nonDiacriticsLemma":"أنماط التنغيم ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَنْمَاطُ التَّنْغِيمِ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/069c7352-49ac-4d16-beee-732bcee265bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"069c7352-49ac-4d16-beee-732bcee265bf","word":"مُثَاقَفَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b886c","lexicalEntryId":"069c7352-49ac-4d16-beee-732bcee265bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُثَاقَفَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" تَقبُّلُ المتعلِّمِ ثقافةَ اللغةِ الهَدَفِ ومفاهيمَها وقِيَمَها، والاندماجُ مع الناطقين بها، وتفاعُلُه معهم، خاصةً حين يكون المتعلِّمون أقَليَّةً في بيئة اللغةِ الهَدَف. وهذا مما يُسهِّل اكتسابَ اللغةِ في نظر أصحابِ نظريةِ التَّثاقُف، وعلى رأسهم جون شومان John Schumann الذي يرى أن اكتسابَ اللغةِ الثانيةِ جانبٌ واحدٌ من جوانب التَّطبُّعِ الثقافي الذي تتحكَّم فيه الفُروقُ الاجتماعيةُ والثقافيةُ بين متعلِّم اللغةِ الهدَفِ وثقافَتِها، تلك الفُروقُ التي قد تنشأ بسَبَب عواملَ نفسيةٍ. راجع:  @(Acculturation Theory) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"مثاقفة ","nonDiacriticsLemma":"مثاقفة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُثَاقَفَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

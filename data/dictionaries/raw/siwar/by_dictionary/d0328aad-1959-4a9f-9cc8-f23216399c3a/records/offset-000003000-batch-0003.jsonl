{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d0a54e02-84c0-46c7-9716-f29c754f9fb3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d0a54e02-84c0-46c7-9716-f29c754f9fb3","word":"تَشْفِيَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9468","lexicalEntryId":"d0a54e02-84c0-46c7-9716-f29c754f9fb3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَشْفِيَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تَدويرُ الشَّفَتَين في أثناء نُطقِ صوتٍ ما، حيث يكون التَّدويرُ أو التَّشفِيَةُ مخرَجًا ثانويًّا، كما يحدُث في نُطق الصوتِ الإنجليزيِّ: /r/ في كلمَتَيْ red, read. ومثلُ ذلك ما يحدُث في نُطقِ: /∫/ في كلمة: shoe، ونُطقِ: /k/ في كلمة: coop، وذلك بتأثير الصائتِ اللاحِقِ: /u/.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"تشفية ","nonDiacriticsLemma":"تشفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَشْفِيَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c0a9ec4a-5e99-4e18-9ea5-2c8f8fe6daa1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c0a9ec4a-5e99-4e18-9ea5-2c8f8fe6daa1","word":"الدِّقَّةُ اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9469","lexicalEntryId":"c0a9ec4a-5e99-4e18-9ea5-2c8f8fe6daa1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الدِّقَّةُ اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سُلوكٌ لغويٌّ يُقصَد به اهتِمامُ المعلِّمِ أو المتعلِّمِ بصِحَّة استعمالِ التركيبِ أو الجُملةِ من الناحيَة النحويةِ بشَكلٍ دَقيق. ويُفَرِّق المختَصون بتعليم اللغاتِ الأجنَبيةِ بين هذا المصطلَحِ ومصطلَحٍ آخَرَ أو سُلوكٍ لغويٍّ آخَرَ هو: الطَّلاقةُ اللغويةُ language fluency الذي يَعني اهتِمامَ المعلِّمِ أو المتعلِّمِ باستعمال اللغةِ بشَكلٍ عَفويٍّ أكثَرَ من اهتِمامه بصِحَّة هذا الاستعمالِ ودِقَّتِه. لوحِظ أن بعضَ المذاهِبِ اللغويةِ التَّطبيقيةِ وطرائقِ التدريس، كالطريقة السَّمعيةِ الشَّفَهية، تهتَم بالدِّقَّة اللغويةِ أكثَرَ من اهتِمامها بالطَّلاقَةِ اللغوية، في حين تهتَمّ طرائقُ أخرى، كالطريقَة الاتصاليةِ وتعليم اللغة بالمهمّات، بالطلاقَة اللغويةِ أكثَرَ من اهتِمامها بالدِّقَّةِ اللغوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الدقة اللغوية ","nonDiacriticsLemma":"الدقة اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الدِّقَّةُ اللُّغَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/18775b23-2a4f-4449-9240-d2013c8129f2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"18775b23-2a4f-4449-9240-d2013c8129f2","word":"مَسَافَةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b946a","lexicalEntryId":"18775b23-2a4f-4449-9240-d2013c8129f2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَسَافَةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"درَجَةُ التَّشابُهِ أو البُعدِ النِّسبيِّ بين لغَتَين. فقد تُشَابِه لغةٌ لغةً أخرى في جميع المستوَياتِ اللغويةِ من أصواتٍ وصرفٍ ونحوٍ ومعجَمٍ ودلالةٍ، فتكونان حينئذٍ متَقارِبَتَين، وقد تختَلِف لغتان في معظَم المستوَياتِ اللغوية، فتكونان متَباعِدَتَين. فالمسافَةُ بين الإنجليزيةِ والفرنسيةِ أبعَدُ من المسافَة بين الفرنسيةِ والإسبانيةِ مثلا، والمسافَةُ بين العربيةِ والسواحِيليةِ أقرَبُ من المسافَة بين العربيةِ والألمانية. يرى كثيرٌ من اللغويين، ولاسيَّما البِنيَويون السلوكيون منهم، أنه كُلَّما زادَت المسافَةُ بين اللغَتَين زادَت صُعوباتُ تعلُّمِ إحداهما على الناطِق بالأخرى. ولكن ثَمَّةَ مشكلات خاصة يُواجِهُها متعلِّمو اللغاتِ المشابِهَةِ للغاتهم الأمِّ، منها كثرَةُ النَّظائرِ الخادِعَةِ false cognates، وتحَجُّرُ الخَطأِ في الكلمات والعباراتِ والتراكيبِ المتشابِهَة في بعض الجوانبِ في اللغَتَين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مسافة لغوية ","nonDiacriticsLemma":"مسافة لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَسَافَةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/10f547d7-b4cb-4adb-9045-0862a719d9bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"10f547d7-b4cb-4adb-9045-0862a719d9bf","word":"تَعَلُّمُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b946b","lexicalEntryId":"10f547d7-b4cb-4adb-9045-0862a719d9bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعَلُّمُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَلَقِّي الفَردِ اللغةَ الأمَّ أو الثانيةَ، والنُّمُوُّ اللغويُّ الذي يحدُث نتيجةَ ذلك. ويُفَرِّق بعضُ اللغويين التطبيقيين، ولاسيَّما ستيفن كراشن Stephen Krashen، بين تعلُّم اللغةِ language learning واكتسابِ اللغةِ language acquisition؛ إذ يرى أن التعلُّمَ عمَليّةٌ واعِيَةٌ يتلَقَّى فيها المتعلِّمُ اللغةَ الهَدَفَ من موادَّ تعليميةٍ في مناهجَ ومقرَّراتٍ مُنظَّمَة، وأن الاكتسابَ عمَليةٌ تِلقائيَّةٌ تعتَمِد على المُدخَلات اللغويَّةِ والممارَسةِ الفِعليةِ للغة. والمؤيِّدون لمبدأ الفَصلِ هذا غالبا ما يَربطون التعلُّمَ باللغة الأجنَبيةِ foreign language، والاكتسابَ بكلٍّ من اللغةِ الأمِّ first language واللغةِ الثانيةِ second language.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعلم اللغة ","nonDiacriticsLemma":"تعلم اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعَلُّمُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

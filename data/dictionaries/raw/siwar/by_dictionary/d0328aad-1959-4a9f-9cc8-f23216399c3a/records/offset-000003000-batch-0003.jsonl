{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a5b282dd-babb-4c4d-a484-cd7bc5120920/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a5b282dd-babb-4c4d-a484-cd7bc5120920","word":"احْتِكَاكٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9463","lexicalEntryId":"a5b282dd-babb-4c4d-a484-cd7bc5120920","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"احْتِكَاكٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلح لغويٌّ اجتماعيٌّ، يُشير إلى أيِّ احتِكاكٍ أو تَماسٍّ يَقَع بين لغَتَين، يؤدِّي إلى تأثُّر إحداهما بالأخرى وتداخُلِهما أحيانا. وغالبا ما يحدُث هذا التأثُّرُ حين تتَجاوَر اللُّغَتان في دولةٍ واحدةٍ كحال بعضِ اللغاتِ في الهند ونيجيريا، أو تكونان في دولَتَين متَجاوِرَتَين مع تواصُل الناطقين بهما كالعربية والتركيةِ بين سوريا وتركيا، وفي عَدَدٍ من دوَل أفريقيا. وقد يحدُث الاحتِكاكُ اللغويُّ في الدوَل ذاتِ الجماعاتِ اللغويةِ أو العِرقِيةِ المهاجرَةِ من مناطِق مختَلِفة، كما في كندا وأمريكا وأستراليا. وتأثيرُ إحدى اللغَتَين في الأخرى يكون في الأصوات والتراكيبِ والمفرَداتِ الدَّلالةِ، وفي إستراتيجيات الاتصالِ أيضا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"احتكاك لغوي ","nonDiacriticsLemma":"احتكاك لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"احْتِكَاكٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e542b47d-3169-455c-b5cd-cae5c02522ae/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e542b47d-3169-455c-b5cd-cae5c02522ae","word":"دَوْرَاتٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9464","lexicalEntryId":"e542b47d-3169-455c-b5cd-cae5c02522ae","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دَوْرَاتٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"البرامِجُ التي تُقام لمجموعةٍ من متعلِّمي اللغةِ الأجنَبيةِ في فترَةٍ أو فتَراتٍ محدَّدَة، غالبا ما تكون قصيرَةَ المدَّة، وذاتَ أهدافٍ محدَّدَة. من ذلك مثلا الدَّوراتُ اللغويةُ التي تُقام لتعليم اللغاتِ للدُّعاة أو للدِّبلوماسيِّين أو لرِجال الأعمالِ أو للسُّيّاح أو لرِجال الأمنِ أو الاستخبارات. ويُفَضَّل في هذه الدَّورات استعمالُ طرائقِ تدريسٍ معَيَّنةٍ لكلِّ فئةٍ مُستَهدَفَة؛ كالاستجابَة الجَسَديةِ الكامِلَةِ TPR للسُّيّاح، وبعضِ تَطبيقاتِ المذهَبِ الاتصالِيِّ للدِّبلوماسيِّين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دورات لغوية ","nonDiacriticsLemma":"دورات لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دَوْرَاتٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fc3bae73-1384-4890-8026-4cd7e0167778/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fc3bae73-1384-4890-8026-4cd7e0167778","word":"إبْدَاعِيَّةُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9465","lexicalEntryId":"fc3bae73-1384-4890-8026-4cd7e0167778","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إبْدَاعِيَّةُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إحدى السِّماتِ البارِزةِ في اللغة الإنسانيةِ التي تُمَيِّزها عن غيرها من اللغات المصنوعَةِ وعن بعض أشكالِ الاتصالِ لدى المخلوقاتِ الأخرى. اهتَمَّ تشومسكي بهذه السِّمَة، وأبرَزَها في نظريته الفِطرِيةِ في اكتساب اللغة، ويَقصُد بها قُدرَةَ الإنسانِ الناطِقِ بلغةٍ معيَّنةٍ على فَهم عَدَدٍ غيرِ محدودٍ من العناصِر اللغويةِ في لغته، وإنتاجِها، والحُكمِ على ما يَسمَعه منها، ولو لم يَسمَعها من قبلُ أو يتدَرَّب على استعمالها، خلافا للتفسير البِنيَويِّ السُّلوكيِّ للُّغة الذي يرى أنها أنماطٌ وتراكيبُ شَكليةٌ، تُكتَسَب بطريقَةٍ آليَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إبداعية اللغة ","nonDiacriticsLemma":"إبداعية اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إبْدَاعِيَّةُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/00e492e2-b653-4dec-b4a7-21d7279c6810/get-public-entry"},"browse_index_record":{"lexicalEntryId":"00e492e2-b653-4dec-b4a7-21d7279c6810","word":"يَوْمِيَّاتٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9466","lexicalEntryId":"00e492e2-b653-4dec-b4a7-21d7279c6810","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"يَوْمِيَّاتٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ في جمع المادَّةِ اللغويةِ للبحث في التَّجارِب والخِبراتِ اللغويةِ ذات الصلة باللغةِ واستِعمالِها واكتِسابِها والتواصُلِ بها، سواءٌ أكانت لغةً أمًّا أم لغةً ثانيةً أم لغةً أجنبيةً. قد تكون هذه اليوميّاتُ مُعَدَّةً إعدادا مُسبقا في هيئة مذكِّراتٍ دَوَّنها المفحوصُ بنفسه أوّلًا بأوّل، وقد تُسَجَّل عند مُقابَلَةِ المفحوصِ مُقابَلَةً شَخصيّة يُقدِّم فيها للباحِث خِبراتِه وتجارِبَه ومُشكلاتِه، ونجاحَه أو فَشَلَه، ونحوَ ذلك. انتَهَج بعضُ اللغويِّين هذا الأسلوبَ في بدايَة القَرن العِشرين، في تَسجيل تجارِبِهم في تعلُّم لغاتٍ ثانيةٍ أو أجنَبية وتَعليمِها، ومَعلوماتِهم عن النُّمُوّ اللغويِّ لدى أطفالهم. راجع:  @(diary study) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"يوميات لغوية ","nonDiacriticsLemma":"يوميات لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"يَوْمِيَّاتٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4d533813-c047-4b79-b9e6-593d922a02f2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4d533813-c047-4b79-b9e6-593d922a02f2","word":"الوَلاءُ للُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b946d","lexicalEntryId":"4d533813-c047-4b79-b9e6-593d922a02f2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الوَلاءُ للُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يعني تَعَلُّقَ الجَماعَةِ اللغويةِ بلُغَتها، والتَّمسُّكَ بها خَوفا عليها من الاندِثار، خاصّةً حين تكون الجَماعةُ صغيرةً تعيش في مجتَمَعٍ كبيرٍ تُسَيطِر عليه لغةٌ أخرى؛ كحال بعضِ الأقلِّيَّاتِ في العالم العربيِّ، وبعضِ الجالياتِ في الولاياتِ المتحدةِ الأمريكية، أو حين تتَعَرَّض اللغةُ الوَطنيةُ إلى غَزوٍ عسكَريٍّ أو ثقافيٍّ يُهدِّدها ويُنذِر بزَوالها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الولاء للغة ","nonDiacriticsLemma":"الولاء للغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الوَلاءُ للُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

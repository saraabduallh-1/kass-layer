{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eb74245b-f557-4dbf-be7c-8b7712b9c1b6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eb74245b-f557-4dbf-be7c-8b7712b9c1b6","word":"اتِّجَاهٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9462","lexicalEntryId":"eb74245b-f557-4dbf-be7c-8b7712b9c1b6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اتِّجَاهٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يَعني نظرةَ الإنسانِ إلى لغته الأمِّ، أو إلى لغةٍ أخرى، أو إلى لغةٍ أجنَبيةٍ أو ثانيةٍ يتعلَّمها أو يُفَكِّر في تعلُّمها، سواء أكانت تلك النظرةُ إيجابيةً أم سَلبيةً. تَشمَل الاتجاهاتُ بنوعَيْها، الإيجابيةُ والسَّلبيةُ، جوانبَ لغويةً وثقافيةً واجتماعيةً؛ كأهميَّة اللغةِ أو عَدَمِ أهميَّتِها، وتقديرِ ثقافَتِها ومَكانَةِ الناطقين بها، والاعتِقادِ بسُهُولة تعلُّمِها أو صُعُوبتِه. والاتجاهاتُ نحوَ اللغةِ الهَدَفِ غالبا ما تؤثِّر في تعلُّمها سَلبًا أو إيجابًا، وتحديدُ هذه الاتجاهاتِ مُهمٌّ في التخطيط اللغويِّ، وبناءِ المناهِج، وإعدادِ الموادِّ التعليمية، وطرائقِ التدريسِ وإجراءاتِه. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اتجاه لغوي ","nonDiacriticsLemma":"اتجاه لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اتِّجَاهٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":nu
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4e4db841-512a-4f4d-9cdc-e46bd181d413/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4e4db841-512a-4f4d-9cdc-e46bd181d413","word":"تَحْلِيلُ النَّصِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fc1","lexicalEntryId":"4e4db841-512a-4f4d-9cdc-e46bd181d413","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ النَّصِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نَصِّيٍّ، يُطلَق على دراسة تركيبِ النصوصِ المكتوبَةِ دراسةً تُشبه دراسةَ تحليلِ الخِطابِ discourse analysis. وفي علم اللغةِ الحاسوبيِّ، يَعني المصطلحُ الإحصاءَ الآليَّ للخصائص العامَّةِ للنَّص؛ كطُول كلماتِه، ووُرُودِ ألفاظٍ معيَّنةٍ فيه، ونحوِ ذلك من الخصائص التي يمكن بواسطتها تَحديدُ لَهجَةِ النَّصِّ وأسلوبِه لأغراض عديدةٍ، منها: تحديدُ هُوِيَّةِ الكاتِب، ونِسبةُ النَّصِّ إلى مؤلِّفه. تُستَخدَم هذه الطريقةُ في تَطبيقات الحاسوبِ؛ كاستِرجاع المعلومات، وبرامجِ تجهيزِ النُّصوص، والنَّقدِ الآلِيِّ للنُّصوص.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل النص ","nonDiacriticsLemma":"تحليل النص","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ النَّصِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

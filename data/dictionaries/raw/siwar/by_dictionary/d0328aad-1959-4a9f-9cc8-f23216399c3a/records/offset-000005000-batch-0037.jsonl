{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e9c5aeb6-7014-4435-b92e-fb5bf0cbd0a8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e9c5aeb6-7014-4435-b92e-fb5bf0cbd0a8","word":"وَحْدَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fb3","lexicalEntryId":"e9c5aeb6-7014-4435-b92e-fb5bf0cbd0a8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَحْدَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ استَعمله ليُونارد بلومفيلد Leonard Bloomfield عام 1933م في كتابه Language؛ ليُعبِّر به عن أصغَر وحدةٍ أو صِيغَةٍ في القواعد تَحمِل معنًى. وهذه الوحدةُ قد تَشمَل سِمَةً نحويةً أو أكثَرَ taxeme، وللسِّمةِ أو التَّاكسِيم قُدرَةٌ على تَميِيز المعاني، لكنها لا تَحمِل مَعنى بذاتها. راجع:  @(taxeme) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"وحدة ","nonDiacriticsLemma":"وحدة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَحْدَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e86c889f-b14a-4bf5-a8d1-42136dcbb0d9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e86c889f-b14a-4bf5-a8d1-42136dcbb0d9","word":"القَالَبِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fb4","lexicalEntryId":"e86c889f-b14a-4bf5-a8d1-42136dcbb0d9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"القَالَبِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"منهَجُ القوالبِ أو الخاناتِ أو التاگميمية، وهو منهَجٌ لغويٌّ أنشأه اللغويُّ البِنيَويُّ الأمريكيُّ كينث بايك Kenneth L. Pike في الخمسينيات من القرن العشرين؛ لتَدريب اللغويين على التحليل اللغويِّ لأغراض التَّرجَمة، مع التركيز على ترجمة الإنجيل، التي كان يُشرِف عليها المعهدُ الصيفيُّ للغَويات، وتُسمى أيضا نظريةَ القَوَالِبِ Tagmemic Theory. يَعتَمِد هذا المنهَجُ على تَقسيم اللغةِ إلى ثلاثة أنظِمةٍ رَئيسة، هي: الأصواتُ والمفرَداتُ والقواعد، ولكلِّ نظامٍ مَجموعةٌ من المستَوَيات. فمُستَوَى القواعدِ مثلا يَشمل مستوياتٍ هي: المورفيمُ والكلمةُ والعبارةُ والجُمَيْلَةُ والجُملةُ والفقرَة، وفي كل مستوى منها وحداتٌ نحويةٌ صُغرى تُسمّى قوالبَ أو خاناتٍ أو مَواقِعَ. الجملةُ حسب هذا المنهجِ قالَبٌ يتكوَّن من مجموعةٍ من المواقِع، كالفاعل والمفعولِ به والمبتدأِ والخبر، ولكلِّ مَوقِعٍ مالِئةٌ كالكلمات والعباراتِ التي يُمكن أن تَقَع في هذا الموقِعِ والتي تُحَدّدها الوحدات النحوية. فالفاعلُ مَوقِعٌ يُملأ بالاسم الظاهِرِ أو بالضمير، والمبتدأُ مَوقِعٌ يُملأ بالاسم الظاهِرِ أو الضميرِ أو العبارةِ الاسميةِ أو المصدَرِ المؤوَّل، والخَبرُ مَوقِعٌ يُملأ بالاسم أو الصفةِ أو العبارةِ الفِعلِية. طُبِّق هذا المنهَجُ في إجراءات طرائقِ تدريسِ اللغاتِ الأجنبيةِ المعتَمِدةِ على المدخَل السُّلوكيِّ البِنيَوِيّ، ولاسيَّما الطريقةُ السمعيةُ الشَّفهية. راجع:  @(Summer Institute of Linguistics (SIL)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"A","root":null,"wordForms":[],"relatedSenses":[],"search":"القالبية ","nonDiacriticsLemma":"القالبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"القَالَبِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b50226ce-8dba-4693-86b5-45560ebaeb9c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b50226ce-8dba-4693-86b5-45560ebaeb9c","word":"مُعْجَمٌ نَاطِقٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fb5","lexicalEntryId":"b50226ce-8dba-4693-86b5-45560ebaeb9c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعْجَمٌ نَاطِقٌ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"معجَمٌ مَخزونٌ فيه مداخِلُ المعجَمِ وشُروحُها بطريقَةٍ حاسوبيةٍ، يَستَطيع المستِعملُ أن يَسمَع هذه الموادَّ مَنطوقَةً، وغالبا ما يُوجَّه لمتعلِّمي اللغةِ من غير الناطقين بها لتَدريبهم على النُّطق السَّليم. يكون هذا المعجَمُ أحاديَّ اللغةِ أو ثُنائيَّ اللغةِ أو متعدِّدَ اللغات، ويمكن أن يكون في شكل معجَمٍ جَيبِيٍّ صغير، وقد يكون برنامَجا في جهازٍ حاسوبيٍّ أو موقِعٍ إليكتروني. وقد يكون مُوَجَّها للأطفال الناطقين باللغة لأغراضٍ تعليمية، خاصةً حين تتعَدَّد اللَّهَجاتُ داخلَ اللغةِ الواحدةِ كالعربية مثلا. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معجم ناطق ","nonDiacriticsLemma":"معجم ناطق","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعْجَمٌ نَاطِقٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a0639e68-3495-4084-a84b-83177cc80531/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a0639e68-3495-4084-a84b-83177cc80531","word":"مُقَرَّرٌ مَبْنِيٌّ على المُهِمَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fb6","lexicalEntryId":"a0639e68-3495-4084-a84b-83177cc80531","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُقَرَّرٌ مَبْنِيٌّ على المُهِمَّةِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"أحَد الأساليبِ التي تُبنَى على أساسٍ منها المناهجُ والمقرَّراتُ في تعليم اللغة، ويُقصَد به المقرَّرُ أو المنهَجُ الذي تُبنَى مَوادُّه التعليميةُ على المهمّات tasks، بَدَلا من بنائها على القواعد أو المفرَدات أو المواقِفِ situations المصطَنَعَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مقرر مبني على المهمة ","nonDiacriticsLemma":"مقرر مبني على المهمة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُقَرَّرٌ مَبْنِيٌّ على المُهِمَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7a8095b3-f57e-424d-9075-b243fb7bafa5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7a8095b3-f57e-424d-9075-b243fb7bafa5","word":"تَأْهِيلُ المُعَلِّمِينَ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fb7","lexicalEntryId":"7a8095b3-f57e-424d-9075-b243fb7bafa5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَأْهِيلُ المُعَلِّمِينَ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"برنامجٌ لتدريب المعلِّمين وإعدادهم لمهنَة التعليم، بما في ذلك تعليمُ اللغاتِ الأجنبية، سواء أكان البرنامجُ قبلَ الخِدمةِ أم في أثنائها، ويشمل التأهيلُ الجوانبَ العلميةَ المهنيةَ والتدريبَ. غالبا ما يُفَرَّق بين نوعَين من الإعداد أو التَّدريب، أحدُهما: تَدريبُ المعلِّمين teacher training، والآخَرُ: تَطويرُ المعلِّمين teacher development. فالنوعُ الأولُ يُعنَى ببناء المهاراتِ الأساسِ للمعلِّمين الجُدد قبلَ الخِدمة؛ كالتَّحضير للدَّرس، وإدارةِ الصَّفِّ، وتدريسِ المهاراتِ اللغويةِ الأربع، وتقديمِ العناصرِ اللغويةِ الجديدة، وتَصويبِ الأخطاء، ونحوِ ذلك. والنوعُ الثاني يُعنَى بما بعد هذه المهاراتِ الأساس، ويركِّز على تَطوير مِهنةِ التدريسِ لدى المعلِّمِ في أثناء الخِدمة؛ كالتقييم الذَّاتي، وتَنويعِ الأساليبِ والأنشِطة، وإعدادِ الدراساتِ العلمية، وإعدادِ التصوُّرِ العامِّ للخطَط والمناهجِ والموادِّ التعليمية، وتقديمِ المقتَرَحاتِ المفيدةِ في تطوير عمَليةِ التعليم، واستِعمالِ تِقنياتِ التعليمِ الحديثة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":
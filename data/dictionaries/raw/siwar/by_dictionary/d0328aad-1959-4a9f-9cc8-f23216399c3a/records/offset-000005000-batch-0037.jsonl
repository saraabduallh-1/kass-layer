{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/626e3cf2-a9fc-41a4-a538-550adbeaf25c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"626e3cf2-a9fc-41a4-a538-550adbeaf25c","word":"عِلْمُ اللُّغَةِ النَّظَرِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fc7","lexicalEntryId":"626e3cf2-a9fc-41a4-a538-550adbeaf25c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ النَّظَرِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمٌ يُعنَى بالجوانب الوَصفِيَّةِ والتاريخيةِ والمقارَنَةِ لعِلم اللغة، ويَسعَى إلى تَطبِيق مناهِجِه على دراسة اللغاتِ جميعا بصَرف النظرِ عن تَصنيفاتها العائلِية. وأهمُّ فُروعِه: علمُ الأصوات (الفوناتيكا) phonetics، وعلمُ وَظائف الأصوات (الفونولوجيا) phonology، وعلمُ الصرف morphology، وعلمُ النحو أو علمُ التراكيبِ syntax، وعلمُ المفرَداتِ lexicology، وعلمُ الدَّلالةِ semantics، وجوانبُ من علم اللغةِ الاجتِماعيِّ وعلمِ اللغةِ النَّفسيّ. وهو أصلُ علمِ اللغةِ الحديثِ بجميع فُروعِه النظريةِ والتَّطبيِقية، بَيد أنه - بمفهومه الأول - يكاد يَنحَصِر في آراء المدرسةِ البِنيَوِيةِ الوَصفيةِ. ويُسمّى أحيانا علمَ اللغةِ العامّ general linguistics، بيدَ أن في الأخير إشارةً إلى أن الدراسةَ اللغويةَ هَدَفُها الوُصولُ إلى نظريةٍ عامَّةٍ للُّغة الإنسانية. ويُقابِله علمُ اللغةِ التَّطبيقيُّ applied linguistics . راجع:  @(general linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة النظري ","nonDiacriticsLemma":"علم اللغة النظري","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ النَّظَرِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

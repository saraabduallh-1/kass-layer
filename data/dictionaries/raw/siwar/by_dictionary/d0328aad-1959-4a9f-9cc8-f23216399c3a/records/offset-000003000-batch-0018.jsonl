{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eced749d-d41e-4a57-adf5-5dd00e9b2cab/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eced749d-d41e-4a57-adf5-5dd00e9b2cab","word":"السَّاحَةُ اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95da","lexicalEntryId":"eced749d-d41e-4a57-adf5-5dd00e9b2cab","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"السَّاحَةُ اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُقصَد به ساحَةُ السُّوقِ اللغويِّ، ويستَخدَم وَصفًا للاختِلافات في تَقيِيم التَّنَوُّعاتِ اللغويةِ واستِعمالاتِها، ورَبط الممارَساتِ والمفاهيمِ اللغويةِ الاجتماعيةِ بمدَى ارتِباطِها بمراكِز القُوَى والسُّلطَةِ السياسيةِ والاجتِماعية، أي إن الاستعمالاتِ اللغويةَ تتفاوَت أهمِّيَّتُها بحسب ارتِباطِها بمراكِز السُّلطَةِ السياسيةِ ومراكِزِ القُوَى في المجتَمَع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الساحة اللغوية ","nonDiacriticsLemma":"الساحة اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"السَّاحَةُ اللُّغَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0a209a50-2d6c-4700-9020-b40c0774172c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0a209a50-2d6c-4700-9020-b40c0774172c","word":"عِلْمُ النَّفسِ اللُّغَوِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95db","lexicalEntryId":"0a209a50-2d6c-4700-9020-b40c0774172c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ النَّفسِ اللُّغَوِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمُ نفسِ اللغةِ psychology of language، وهو فرعٌ من علم النفس، يُعنَى بدراسة تأثيرِ الجوانبِ اللغويةِ في سُلوك الإنسان، أي تأثيرِ الجوانبِ اللغويةِ في النفس البشَرية. ويُقابِله علمُ اللغةِ النفسيِّ psycholinguistics الذي هو فَرعٌ من علم اللغة، يُعنَى بالجوانب النفسيةِ ذاتِ العلاقةِ بالسُّلوك اللغوي، أي التي تُساعِد في فَهم السُّلوكِ اللغوي. ويرَى بعضُ الباحثين أن علمَ النفسِ اللغويِّ وعلمَ اللغةِ النفسيِّ مصطلَحان لعلمٍ واحدٍ؛ لاشتراكهما في كثيرٍ من المباحث والموضوعاتِ والمسائلِ ذاتِ العلاقةِ باللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم النفس اللغوي ","nonDiacriticsLemma":"علم النفس اللغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ النَّفسِ اللُّغَوِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fef9c4f7-f4f6-4533-aa07-8862cded828c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fef9c4f7-f4f6-4533-aa07-8862cded828c","word":"النِّسْبيَّةُ اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95dc","lexicalEntryId":"fef9c4f7-f4f6-4533-aa07-8862cded828c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النِّسْبيَّةُ اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ أو نظريةٌ لغويَّةٌ، بدأها العالِمُ الألمانيُّ هومبلت Humboldt في القرن التاسع عشر، وفرانز بواز، ثم أكمَلها اللغويان أدوارد سابير Edouard Sapir و بنجامين وُورف Benjamin Whorf في القرن العشرين، حتى سُمِّيَت فَرضيةَ سابير ووُورف Sapir-Whorf hypothsis، أو الفَرضيةِ الوُورفيّةِ Whorfian hypothesis، أو هي إحدى الرَّكيزَتَين اللَّتَين قامَت عليهما نظريةُ سابير ووُورف. ترَكِّز النظريةُ على تأثير اللغةِ في التَّفكير، وتُؤكِّد أن لغةَ المرءِ هي التي تُحَدِّد إدراكَه للعالَم الخارِجيِّ تحديداً  كُلِّيًّا أو جُزئيًّا، وتُنظِّم هذا الإدراكَ في ذِهنه. بناء على ذلك، فإن البناءَ المعرِفيَّ لدى الأفرادِ يختَلِف باختلاف لغاتِهم، أي إن الذين يتكَلَّمون لغاتٍ مختَلِفةً يَنظرون إلى العالَم بعيُونٍ مختَلِفة، وتفكيرٍ مختَلِف. بُني على هذه النظريةِ تَساؤلٌ حولَ إمكانِ دراسَةِ التَّطوُّرِ الثقافيِّ لمجتَمَعٍ ما انطلاقا من تَطَوِّر لغتِه. راجع:  @(relativity) و  @(Sapir-Whorf Hypothesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النسبية اللغوية 
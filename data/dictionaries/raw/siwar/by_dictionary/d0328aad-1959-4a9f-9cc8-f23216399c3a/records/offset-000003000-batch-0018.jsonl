{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/96566dd8-f323-4e7f-8bde-de52b5fb18c3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"96566dd8-f323-4e7f-8bde-de52b5fb18c3","word":"تَثَاقُفٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95d8","lexicalEntryId":"96566dd8-f323-4e7f-8bde-de52b5fb18c3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَثَاقُفٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ نفسيٌّ، يُسمّى أيضا المثاقَفَةَ اللغوية، ويَعني تَقبُّلَ متعلِّمِ اللغةِ الثانيةِ ثقافةَ الناطقين بها والتكَيُّفَ معها، ومن ثمّ اكتَسابها ضِمنَ اكتسابِ لغَتِها. يَتِمّ هذا التَّثاقُفُ بتَوفّر شروطٍ لغويةٍ اجتماعيةٍ نفسيةٍ حدَّدَتها نظريةُ التَّثَاقُفِ أو المثاقَفَةِ عند جون شومان Schumann John، صاحبِ نظريةِ التَّثاقُف acculturation theory. والتَّثَاقُفُ اللغويُّ عامِلٌ مهمٌّ في اكتساب المتعلمِّ اللغةَ الهَدَف، وفَقْدُ ذلك أو ضعفُه يحرِم المتعلِّمَ من اكتساب اللغةِ الهَدَفِ اكتسابًا طبيعيًّا في زَمَنٍ طبيعيٍّ. راجع:  @(Acculturation Theory) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تثاقف لغوي ","nonDiacriticsLemma":"تثاقف لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَثَاقُفٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5798c517-e407-473a-bbe2-26f00af31b51/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5798c517-e407-473a-bbe2-26f00af31b51","word":"مُورْفِيمٌ مُعْجَمِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95e0","lexicalEntryId":"5798c517-e407-473a-bbe2-26f00af31b51","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُورْفِيمٌ مُعْجَمِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مورفيمٌ يُستخدَم في بناء كلماتٍ جديدةٍ في اللغة، كاللَّواحق مثلُ: ability  في مثل: probability، ونحوِ ذلك مما يمكن دُخولُه على كلماتٍ جديدةٍ قِياسا على الكلماتِ الموجودَةِ في اللغة، ويكون له معنًى خاصٌّ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مورفيمٌ وَظيفَتُه الأوَّليَّةُ التعبيرُ عن المعنى، مثلُ: step في الكلمة الإنجليزيةِ: stepmother، في مُقابِل المورفيمِ النحويِّ الذي يُعبِّر عن الوَظيفة أو الوَظائفِ النحويةِ؛ كأدوات الرَّبط، وأدوَات التَّعريفِ والتَّنكير، ونحوِ ذلك. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَصف يُطلَق أحيانًا على أيِّ وحدةٍ لغويةٍ منفَصِلةٍ تمثِّلها الكلمةُ المستقلَّةُ المعنى، في مُقابِل الوحدةِ اللغويةِ الوَظيفيةِ أو النحويةِ المنفَصِلةِ، كحُروف الجَرِّ مثلا، وفي مُقابِل الوحدةِ اللغويةِ الزائدةِ، كحروف الزيادةِ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مورفيم معجمي ","nonDiacriticsLemma":"مورفيم معجمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُورْفِيمٌ مُعْجَمِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

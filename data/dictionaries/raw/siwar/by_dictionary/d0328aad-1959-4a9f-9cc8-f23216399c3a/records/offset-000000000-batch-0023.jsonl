{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5354e3b8-dfb0-4d0c-acb5-0007a6bcb110/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5354e3b8-dfb0-4d0c-acb5-0007a6bcb110","word":"إسْترَاتِيجِيَّةُ التَّحَاشِي","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a90","lexicalEntryId":"5354e3b8-dfb0-4d0c-acb5-0007a6bcb110","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إسْترَاتِيجِيَّةُ التَّحَاشِي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إستراتيجيةٌ يَلجأ إليها متعلِّمو اللغاتِ الأجنبية، وهي: تَفادِي المتعلِّمِ استعمالَ عناصِرَ لغويةٍ معيَّنة، من أصواتٍ وكلماتٍ وعباراتٍ وتراكيب، والاستعاضة عنها بعناصِرَ أخرى؛ إما لعَدَم التأكُّد من صحَّتها أو صحَّةِ استعمالِها في سِياقٍ معيَّن، أو مخافةَ الوُقوعِ في خَطأ. كأن يقول: That's my building. I live there، بدلاً من: That's my building where I live. ويَعتَقد بعضُ اللغويين أن هذه الاستراتيجيةَ تُخفِي كثيرا من سِمات اللغةِ المرحَلية، وأنها أخطاءٌ غيرُ ظاهرة، ويَصعُب تحليلُها كما تُحَلَّل الأخطاءُ اللغويةُ الظاهِرة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إستراتيجية التحاشي ","nonDiacriticsLemma":"إستراتيجية التحاشي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إسْترَاتِيجِيَّةُ التَّحَاشِي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3ae2c428-d242-4c0c-b017-34f6e4c612f1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3ae2c428-d242-4c0c-b017-34f6e4c612f1","word":"دِرَاسَةُ التَّصْنِيفِ النَّوْعِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0aa","lexicalEntryId":"3ae2c428-d242-4c0c-b017-34f6e4c612f1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دِرَاسَةُ التَّصْنِيفِ النَّوْعِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"دراسةُ النَّماذِجِ والأنواع، أي دراسةُ تَصنيفِ اللغاتِ على أساسٍ من نَوعها بالنَّظَر إلى التَّشابُه بينها في سِماتها البِنيَوِيَّةِ في الأصوات والصرفِ والنحوِ؛ كأن تُصنَّف إلى لغاتٍ نَغمِيَّةٍ أو تَحليلِيةٍ أو متصرِّفَةٍ أو عازِلَةٍ أو لَصقِيَّة، بدلا من النَّظَر إلى أصولها التاريخيةِ أو الإقلِيمِيةِ الجغرافية. واللغةُ الواحدةُ قد تَجمَع في سِماتها سِماتٍ من اللغات التَّحليليةِ والمتصرِّفةِ والعازِلَةِ واللَّصقِية، فتَتَشابه في كلٍّ من هذه السِّماتِ مع لغاتٍ أخرى لا تَربطها بها علاقةٌ تاريخيةٌ أو إقليمِيةٌ جُغرافية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دراسة التصنيف النوعي ","nonDiacriticsLemma":"دراسة التصنيف النوعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دِرَاسَةُ التَّصْنِيفِ النَّوْعِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

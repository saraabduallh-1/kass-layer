{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e664c545-ca13-42bc-b66f-85d242b76387/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e664c545-ca13-42bc-b66f-85d242b76387","word":"النَّحْوُ التَّقْلِيدِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba09d","lexicalEntryId":"e664c545-ca13-42bc-b66f-85d242b76387","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوُ التَّقْلِيدِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يُطلَق في الأصل على مناهِج النحوِ في اللغات الأوروبيةِ، القائمِ على أفكار أرِسطو عن طبيعة اللغةِ اليونانيةِ المتمثِّلَةِ في أعمال اليونانِ القُدماء، ثم أُطلِق على المدارس النحويةِ في اللغات الأوربيةِ، التي كانت سائدةً قبل ظُهورِ علمِ اللغةِ الحديث Modern linguistics على يد فردينان دي سوسير Ferdinand De Saussure في أواخِر القرنِ التاسع عشر. ثم أُطلِق على كلِّ نَحوٍ مِعيارِيٍّ غيرِ وَصفِيٍّ بما في ذلك النحوُ العربيُّ بالمفهوم المعياريِّ التعليمي. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النحو التقليدي ","nonDiacriticsLemma":"النحو التقليدي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّحْوُ التَّقْلِيدِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/11da1b9b-bc95-46ae-a75a-b00bcb61c24d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"11da1b9b-bc95-46ae-a75a-b00bcb61c24d","word":"نِسْبَةُ النوع إلى المثال الفِعليّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba09e","lexicalEntryId":"11da1b9b-bc95-46ae-a75a-b00bcb61c24d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نِسْبَةُ النوع إلى المثال الفِعليّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُشير إلى ظاهرَةٍ في الحديث الشَّفَهيِّ تتلخَّص في أن المرءَ حين  يَحِكي حِكايَةً قد أعدَّها وحَفِظَها وشَعر بانتِباه المستَمِعين إليها واهتِمامِهم بها، فإنه قد يخرُج عن النَّمَط الذي رسَمَه لنفسه فيَتصرَّف في كلامه، لكنه حين يُقاطَع أو يُعتَرَض على كلامه فإنه يُعود إلى النَّصِّ الأصليِّ ويَلتَزِم به. وبناءً على ذلك، تكون نسبةُ النَّمَطِيَّةِ هي النِّسبةَ بين العَدَدِ الكُلِّيِّ للكلمات الفعلية إلى العَدَد الكُلِّيِّ للكلمات المخَتلِفَة. وقد استُعمِلَت هذه النسبةُ مقياسا للطلاقَة fluency، فكُلَّما زادَت هذه النسبةُ زادَت الطلاقَةُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نسبة النوع إلى المثال الفعلي ","nonDiacriticsLemma":"نسبة النوع إلى المثال الفعلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نِسْبَةُ النوع إلى المثال الفِعليّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

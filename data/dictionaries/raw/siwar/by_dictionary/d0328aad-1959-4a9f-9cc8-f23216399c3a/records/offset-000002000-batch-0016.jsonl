{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6628bcd4-e8b0-4a42-8e43-0efc9864461a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6628bcd4-e8b0-4a42-8e43-0efc9864461a","word":"حَيَوِيَةُ المَجْمَوعَةِ (دِينامِيَّةُ المَجْمُوعَةِ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91b7","lexicalEntryId":"6628bcd4-e8b0-4a42-8e43-0efc9864461a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَيَوِيَةُ المَجْمَوعَةِ (دِينامِيَّةُ المَجْمُوعَةِ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يَرتَبِط بعَدَدٍ من العلوم؛ كعلم النفس، وعلمِ الاجتماع، وعلمِ الاتصالِ، والتربية، وهو أحَدُ أساليبِ التعلُّمِ التعاونيِّ، وكذلك في البرامِج التدريبيّة. ويُقصَد به التفاعُلُ الحيُّ الذي يَتِمّ بين جَماعةٍ من الناس، ويَدرُس سلوكَ الجَماعة، وتَأثيرَ عوامِلِ القيادَةِ والتفاعُلِ واتِّخاذِ القَرارِ على تكوين الجَماعة. ويُستفاد منه في تكوين المجموعاتِ الطلابيةِ وتَصنيفِها في الفُصول الدراسية، وبناءِ المهمَّاتِ الصَّفِّيَّة وإعدادِ الموادِّ التعليميةِ المناسِبة. وهذا الأسلوبُ مُفيدٌ لمتعلِّمي اللغاتِ الأجنَبية؛ إذ يَكسِر حاجِزَ الخَوف من استِعمال اللغةِ الهَدَف، ويُشَجِّع على التواصُل الحَقيقيِّ، ويُكسِب المتعلِّمَ مَزيدًا من المفرَدات المعجَميةِ والعباراتِ الجاهزةِ والتراكيبِ المسكوكَةِ، ويوضّح استعمالَها في سياقات ومقاماتٍ حقيقية، كما أنه يُدرِّب المتعلِّمين على فَهم ثقافَةِ الآخَرِين، وتَقديرِ اختِلافِ تلك الثقافاتِ عن ثقافتهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حيوية المجموعة (دينامية المجموعة) ","nonDiacriticsLemma":"حيوية المجموعة (دينامية المجموعة)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حَيَوِيَةُ المَجْمَوعَةِ (دِينامِيَّةُ المَجْمُوعَةِ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/817b0a2f-5a9a-45bd-89fd-252c246496d8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"817b0a2f-5a9a-45bd-89fd-252c246496d8","word":"تَصْحِيحُ التَّخْمِينِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91b8","lexicalEntryId":"817b0a2f-5a9a-45bd-89fd-252c246496d8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَصْحِيحُ التَّخْمِينِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اختبارات اللغة، يُشير إلى مِقدارٍ مُضافٍ أو مَنقوصٍ من عَدَدِ العناصِرِ ذاتِ الإجابةِ الصَّحيحةِ في الاختبار الموضوعيِّ، الغرَضُ منه جَعلُ درَجَةِ الطالبِ، التي يمكن أن يحصل عليها بالتَّخمين الأعمى blind guessing لعَدَدٍ من العناصِر، لا تزيد على درَجَةِ الطالبِ الذي لم يُجِب عن تلك العناصِر. وتُستَعمَل في ذلك مُعادَلاتٌ مُعيَّنةٌ تهدِف إلى الحَدِّ من مَيل المفحوصين إلى التَّخمين، وزيادَةِ دِقَّةِ الترتيبِ بينهم بناء على مَعرِفة حقيقية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تصحيح التخمين ","nonDiacriticsLemma":"تصحيح التخمين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَصْحِيحُ التَّخْمِينِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

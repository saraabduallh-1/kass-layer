{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/31c8a235-9e2b-4b09-ad66-85b2cfe170bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"31c8a235-9e2b-4b09-ad66-85b2cfe170bf","word":"أُنْمُوذَجُ گوف","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91b2","lexicalEntryId":"31c8a235-9e2b-4b09-ad66-85b2cfe170bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ گوف","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ في علم النِّفسِ القِرائيِّ، يُشير إلى أحَد نماذِجِ القراءةِ الجُزئيةِ الحَرفيةِ التي تَبدأ من الأدنَى إلى الأعلى bottom-up models. وَضَعَه فيليب گوف Philip Gough في السبعينيات من القرن العشرين، ووَصَف فيه العَمَلياتِ النفسيةَ الذِّهنِيةَ للقارئ منذ وُقوعِ عينَيه على النَّصِّ المكتوبِ حتى استِخلاصِ المعنى منه. يَعتَمِد هذا الأنموذَجُ على القراءةِ الحَرفيةِ، وبناءِ المعنى بناء جُزئيًّا تراكُميًّا من الكلمات المكتوبَةِ في النَّصِّ المقروءِ فقط. ولا يُعَوِّل هذا الأنموذَجُ على العَمَليات الذِّهنِيةِ خارِجَ النَّصِّ؛ كاستِحضار المعلوماتِ السابقَة، وربَطِها بالنَّص، وتَخمِينِ المعنى، بل يُرَكز على جوانِبَ أخرى، مثل التَّمثِيلِ الرَّمزِيِّ، وتَعَرُّفِ الحُروف، ومُشكِلاتِ الرَّبطِ بين الرَّمزِ والمعنى، والبحثِ المعجَمي، والذَّاكِرَةِ الأوَّلِيةِ قَصيرَةِ الأمَد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج گوف ","nonDiacriticsLemma":"أنموذج گوف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ گوف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5f551a20-82cf-4bee-a896-aeb878ba0f6b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5f551a20-82cf-4bee-a896-aeb878ba0f6b","word":"ضَبْطٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91b3","lexicalEntryId":"5f551a20-82cf-4bee-a896-aeb878ba0f6b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ضَبْطٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ في السياسَة اللغويةِ والتَّخطيط، اقتَرَحَه ميشيل فوكو Michel Foucault أواخِرَ السبعينياتِ من القَرن العشرين، يُعنَى بالَبحث في كيفيّة استِعمالِ السياسَةِ اللغويةِ لأغراض التَّحَكُّم والضَّبطِ السياسيِّ والثَّقافيِّ من قِبَل الهيئاتِ المحَلِّيَّة، ويتَمَثَّل في مجموع النُّظُمِ والممارَساتِ التَّشريعيَّةِ والإداريةِ والماليةِ والتعليميةِ والمهنِيّةِ التي تَضبِط سُلوكَ الأفرادِ والجماعَة، والكَيفيّةَ التي تتمّ بها الحِواراتُ والمناقَشاتُ في مجالات اللغةِ والثقافَةِ والتربيَةِ ونحوِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"ضبط ","nonDiacriticsLemma":"ضبط","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ضَبْطٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7218efce-cc00-47f8-934b-8da6dc7cf538/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7218efce-cc00-47f8-934b-8da6dc7cf538","word":"جِنْسٌ نَحْوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91b4","lexicalEntryId":"7218efce-cc00-47f8-934b-8da6dc7cf538","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جِنْسٌ نَحْوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جنسُ الكلمةِ من حيث التذكيرُ والتأنيثُ، وفقًا لقواعد اللغة واستعمالِها، لا وفقًا لطبيعةِ الاسمِ أو حقيقتِه. فالشمسُ - في العربية مثلاً - مؤنثٌ نحويٌّ، والقَمَرُ مُذكَّرٌ نحويٌّ، في حين أن المعلِّمَ مُذكرٌ طبيعيٌّ، والمعلِّمةَ مؤنثٌ طبيعيٌّ، وفقا للتركيب الفسيولوجيِّ لكلٍّ منهما. ويختَلِف الجِنسُ النحويُّ من لغةٍ إلى أخرى؛ فما يُصَنَّف مُذكرا في لغةٍ ما قد يُصَنَّف مؤنَّثا في لغةٍ أو لغاتٍ أخرى، وكذلك العَكس. راجع:  @(gender) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جنس نحوي ","nonDiacriticsLemma":"جنس نحوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جِنْسٌ نَحْوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

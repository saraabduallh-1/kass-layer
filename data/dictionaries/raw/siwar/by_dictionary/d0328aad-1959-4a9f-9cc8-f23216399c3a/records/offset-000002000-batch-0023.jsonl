{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e5575790-1ca4-4ace-9228-ba73dc4959a7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e5575790-1ca4-4ace-9228-ba73dc4959a7","word":"لُغَةٌ مَوْرُوثَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b926d","lexicalEntryId":"e5575790-1ca4-4ace-9228-ba73dc4959a7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مَوْرُوثَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اسمُ يُطلَق على أيِّ لغةٍ لأسْلاف مجموعَةٍ من الناس، ليسَت لغَتَهم الأمَّ، ولا لغةَ عامَّةِ الناسِ، وتَشمل لغاتِ أسْلافِ الأقَليَّاتِ المهاجِرَة، ولغاتِ أهلِ البلَدِ الأصْليِّين indigenous people، حين لا تكون هي اللغةَ الأمَّ أو اللغةَ الأولى أو الرَّسميةَ في ذلك البلد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة موروثة ","nonDiacriticsLemma":"لغة موروثة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مَوْرُوثَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/73c595bd-3b39-4643-b8fe-f702ec9d7d16/get-public-entry"},"browse_index_record":{"lexicalEntryId":"73c595bd-3b39-4643-b8fe-f702ec9d7d16","word":"لُغَةٌ غَيرُ مُتَجَانِسَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b926e","lexicalEntryId":"73c595bd-3b39-4643-b8fe-f702ec9d7d16","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ غَيرُ مُتَجَانِسَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تحليل الخِطابِ والنَّقدِ اللِّساني، يُشير إلى ظاهرَةٍ لغويةٍ اجتماعيةٍ تظهَر في استِعمال أشكالٍ مختلفةٍ للُغَة واحدة، أو أنماطٍ لهَجيةٍ منها، في نَصِّ واحدٍ في أثناء التواصُل الشَّفَهيِّ، وفي كتابةِ الرِّوايات، والقصصِ القَصيرَة، والمسرَحيات، لكنها لا تستَعمل في الكتابات التّقنية، ولا في المكاتَبات الرَّسمية، ولا في الوَثائق التجارِية. وقد أشار اللغويُّ الرُّوسيُّ ميخائيل باختن Mikhail Bakhtin  - في وَقتٍ مبكِّر - إلى أهميَّة هذه الظاهرةِ في الأعمال الأدَبية، وتأثيرِها في المتلَقِّي. يؤكِّد باختن أهميةَ تفاعُلِ تَنَوُّعاتٍ مختَلِفةٍ من لهجاتٍ اجتماعيةٍ ومحلِّيَّة، ولهجات فِئَوِيةٍ لمجموعاتٍ مِهنِيةٍ مختَلِفة، وأنه ليس ثمةَ كلمات محايِدَة، بل إن اللغةَ ذاتَها ليسَت صَوتا واحدا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة غير متجانسة ","nonDiacriticsLemma":"لغة غير متجانسة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ غَيرُ مُتَجَانِسَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/289de4bd-1657-4dca-9e19-1843cb7b3116/get-public-entry"},"browse_index_record":{"lexicalEntryId":"289de4bd-1657-4dca-9e19-1843cb7b3116","word":"وَرَقَةُ تَدريبٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba1d1","lexicalEntryId":"289de4bd-1657-4dca-9e19-1843cb7b3116","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَرَقَةُ تَدريبٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَرَقةُ تَدريباتٍ، وهي وَرَقةٌ يَضَع عليها الطالبُ إجابتَه عما يَرِد فيها من تدريبات عَمَليّةٍ كتابيّة. وقد تكون وَرَقةُ التدريبِ جُزءًا من الواجِبات، فيعطيها المعلِّمُ لطلابه ويُخَصِّص لها جُزءًا من درَجَة المقرَّر. ووَرقةُ التدريباتِ هذه مهمَّةٌ في فُصول تعليمِ اللغات، إذ يَعتَمِد عليها الطالبُ في مَعمَل اللغةِ language laboratory خاصة لتَدوين مَلحوظاتِه عما يَسمَعه في فَهم المسموع، وكتابَةِ إجاباتِه عن الأسئلة الموَجَّهَةِ إليه. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ورقة تدريب ","nonDiacriticsLemma":"ورقة تدريب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَرَقَةُ تَدريبٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

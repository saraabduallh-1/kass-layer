{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/73197740-46c6-47a1-aba0-47fdf0ccdc67/get-public-entry"},"browse_index_record":{"lexicalEntryId":"73197740-46c6-47a1-aba0-47fdf0ccdc67","word":"عِلْمُ الصَّرْفِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8878","lexicalEntryId":"73197740-46c6-47a1-aba0-47fdf0ccdc67","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ الصَّرْفِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"دراسةُ البناءِ الداخليِّ للكلمة، وما يَطرأ عليها من تغيِير أو زيادَةٍ أو حَذف. وهو أحَدُ مستوياتِ اللغة، والشِّقُّ الأساسُ لعلم النحوِ الذي يَتداخَل معه في كثيرٍ من الأبواب والموضوعاتِ والمسائل. وهو حَلَقةُ وَصلٍ بين الأصوات والنحو؛ إذ يَعتَمِد على ما تُقدِّمه له الأصواتُ، ويكوِّن - في الوَقت نفسِه - أساسَ النحوِ ومادَّتَه. ومَفهومُ المورفولوجيا في علم اللغةِ الحديثِ أوسَعُ مجالا من مَفهوم الصَّرفِ العربي؛ إذ يمكن تطبيقُ مبادئه ونتائجِه على أيِّ لغة، في حين يَقتَصِر الصرفُ العربيُّ على مسائل معيَّنةٍ في العربية. يُقسَّم علمُ الصَّرفِ إلى قسمَين رئيسَين هما: علمُ الصرفِ التَّصريفيِّ inflectional morphology، وعلمُ الصرفِ الاشتِقاقيِّ derivational morphology.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم الصرف ","nonDiacriticsLemma":"علم الصرف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ الصَّرْفِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

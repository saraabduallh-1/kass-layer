{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2456b429-a103-4d1b-9598-c984928dd3a8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2456b429-a103-4d1b-9598-c984928dd3a8","word":"قُدْرَةٌ أكَادِيمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8883","lexicalEntryId":"2456b429-a103-4d1b-9598-c984928dd3a8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قُدْرَةٌ أكَادِيمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قُدرَةُ المرءِ على النجاح في مجالٍ أو مجالاتٍ أكادِيميَّةٍ، بما في ذلك تعلُّمُ اللغاتِ الأجنَبية. والقُدرَةُ الأكاديميةُ للأجنَبيِّ مرتَبِطةٌ بتعلُّم اللغةِ language learning تَعلُّمًا مَنهَجِيًّا مُنَظَّمًا أكثَرَ من ارتباطها باكتِسابها language acquisition. فالمتعلِّمُ الذي يَملِك قُدرَةً أكاديميَّةً قد يَتَفَوَّق في الجوانب الأكاديميةِ من اللُّغة، كأن يُلِمَّ بقواعدها ويَحفَظَ مُفرداتِها، وربما لا يَكتَسبها طَبَعِيًّا ولا يَستَعملها استِعمالاً تَواصُليًّا عامًّا، لكن هذه القُدرَةَ مُهمَّةٌ لمتعلِّم اللغةِ حين تكون هذه اللغةُ هي لغةَ التعليمِ في تخصُّصه. راجع:  @(CALP) و  @(BICS) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قدرة أكاديمية ","nonDiacriticsLemma":"قدرة أكاديمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قُدْرَةٌ أكَادِيمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b57ed445-83bf-4913-b832-30acbcf9baa8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b57ed445-83bf-4913-b832-30acbcf9baa8","word":"قِرَاءةٌ أكَادِيمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8884","lexicalEntryId":"b57ed445-83bf-4913-b832-30acbcf9baa8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قِرَاءةٌ أكَادِيمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على القراءة المنهَجِيَّةِ (باللغة الهَدَفِ)، المقرَّرَةِ على الطالب في المراحِل الأكاديميةِ (الجامِعية)، في مُقابِل القراءةِ المكثَّفَةِ المقرَّرَةِ عليه في مرحلَة تعلُّمِه اللغةَ الهَدَف، أو في مقابِل القراءةِ الحُرَّةِ free reading أو القراءةِ الموسَّعَةِ extensive reading. وتُصَنَّف القراءةُ الأكاديميةُ، أي القُدرَة عليها، في المرحَلة الخامسةِ من مراحِل اكتِسابِ اللغةِ الثانية، وهي مرحَلةُ النُّمُوِّ المتَّصِلِ أو المستَمِرِّ continued language development، وذلك حين يجتاز الطالبُ المستوى المتقدِّمَ في تعلُّم اللغةِ الهَدَف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قراءة أكاديمية ","nonDiacriticsLemma":"قراءة أكاديمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قِرَاءةٌ أكَادِيمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

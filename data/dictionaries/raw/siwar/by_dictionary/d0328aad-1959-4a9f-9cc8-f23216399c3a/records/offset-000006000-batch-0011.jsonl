{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5213b04d-56db-46b4-ac71-5cba00449bdb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5213b04d-56db-46b4-ac71-5cba00449bdb","word":"صَامِتٌ مُطبَقٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba129","lexicalEntryId":"5213b04d-56db-46b4-ac71-5cba00449bdb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَامِتٌ مُطبَقٌ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"صوتٌ صامِتٌ يَرتَفِع مؤخَّرُ اللِّسانِ في أثناء نطقِه نحوَ الطَّبَق، ومنه في العربية: اللامُ المفخَّمَةُ، والرّاءُ المفخَّمَةُ، والصادُ، والضادُ، والطاءُ، والظاء. ويُسَمِّيه بعضُ اللغويين صامتا مُفخَّما لا مُطبَقا؛ إذ يميِّز بين الإطباقِ والتَّفخيم؛ فالصوتُ المطبَق هو الذي يُنطَق بوَضع اللِّسانِ في مَوضِع نُطقِ نَظيرِه المرَقَّقِ مع رَفع ظَهرِ اللِّسانِ باتجاه الطَّبَقِ حتى يَقتَرِب منه، خلافا للصوت المفَخَّم الذي يتَقَعَّر فيه ظَهرُ اللِّسانِ فلا يرتَفِع باتجاه الطَّبَق، كما في نُطق اللامِ العربيةِ في لَفظ الجلالَةِ (الله).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صامت مطبق ","nonDiacriticsLemma":"صامت مطبق","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَامِتٌ مُطبَقٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

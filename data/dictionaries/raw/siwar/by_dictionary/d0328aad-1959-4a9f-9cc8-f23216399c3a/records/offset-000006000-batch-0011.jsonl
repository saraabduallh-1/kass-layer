{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8095b323-6580-4d18-81b5-09b40f474ac5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8095b323-6580-4d18-81b5-09b40f474ac5","word":"شَرِيطُ الفِيدْيو","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba12c","lexicalEntryId":"8095b323-6580-4d18-81b5-09b40f474ac5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"شَرِيطُ الفِيدْيو","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظامٌ مغناطِيسيٌّ لتَسجيل الصوتِ والصورَةِ في آنٍ واحد، وهو من الوسائل التعليميةِ المعينَةِ في تعليم اللغاتِ خاصَّة، يتمَيَّز بإمكان إعادَةِ عَرضِه أكثَرَ من مئة مرَّةٍ دونَ تَلَف. ويمكن أن تُسَجَّل فيه دروسٌ في تعليم اللغاتِ، ويُستَفاد منه في تدريب المعلِّمين؛ إذ تُعرَض عليهم الدُّرُوسُ الأنموذَجِية، ويُسجَّل فيه أداءُ المتدرِّبِ لتَحليله ونَقدِه بطريقَةٍ فَردِيَّةٍ أو جَماعِيّة، ولاسيّما في التدريس المصَغَّر. كان شريطُ الفيديو - إلى عهدٍ قريب - أحَدَثَ وَسيلَةٍ تعليميّة، بَيدَ أن تَقنِياتِ الحاسوبِ قلَّلَت من أهميَّته.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"شريط الفيديو ","nonDiacriticsLemma":"شريط الفيديو","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"شَرِيطُ الفِيدْيو"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

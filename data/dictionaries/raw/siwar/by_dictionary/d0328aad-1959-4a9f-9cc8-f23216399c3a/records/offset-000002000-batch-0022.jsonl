{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/146e7604-ec91-41f5-8d1b-06d1b39090f2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"146e7604-ec91-41f5-8d1b-06d1b39090f2","word":"لُغَةٌ مِثَالِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9255","lexicalEntryId":"146e7604-ec91-41f5-8d1b-06d1b39090f2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مِثَالِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على اللغة التي تُكتَب كما تُقرَأ، وتُقرَأ كما تُكتَب، وهو وَصفٌ يَندُر وُجودُه في اللغات، إلّا إذا قُصِد به المِثالِيَّةُ النِّسبِيَّة؛ فاللغاتُ - بهذا الوَصفِ - تتَفَاوَت في وُصولها إلى هذه المِثالِيَّة. وتُعَدُّ العربيةُ من اللغات المِثالِيَّة، خاصةً حين تُشَكَّل حُروفُها؛ إذ يَرمز الحَرفُ الواحِدُ فيها إلى صَوتٍ واحِد، ويُكتَب الصَّوتُ الواحِدُ بحَرفٍ واحدٍ، باستِثناء حالاتٍ محدودةٍ جدّا، في حين أن الإنجليزيةَ مثلا ليسَت من اللغات المِثالِيَّةِ رغمَ تمثيل الصوائت عند كتابتها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة مثالية ","nonDiacriticsLemma":"لغة مثالية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مِثَالِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

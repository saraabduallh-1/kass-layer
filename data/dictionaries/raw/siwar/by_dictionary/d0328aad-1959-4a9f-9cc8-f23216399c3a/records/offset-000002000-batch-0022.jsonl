{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4ceb480e-fa57-48b4-9ef8-8b10c0c7f939/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4ceb480e-fa57-48b4-9ef8-8b10c0c7f939","word":"الكَلِمَةُ الجُمْلَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9250","lexicalEntryId":"4ceb480e-fa57-48b4-9ef8-8b10c0c7f939","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الكَلِمَةُ الجُمْلَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ نحويٌّ، يُطلَق على أيِّ كلمةٍ تَقوم مقامَ الجُملة، كحُروف الجوابِ، مثل: (نعَم) و(لا) و(بَلى)، حين تكون إجابةً عن سؤال، وغيرِها مثل: (أمسِ) جَوَابا عن: مَتى وَصَلتَ إلى مَكة؟ ومن ذلك الكلمةُ الإسبانيةُ: salgo التي تَعني: أنا ذاهبٌ إلى الخارِج، أو أنا خارِجٌ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُطلَق على الكلمَة التي يَنطِقها الطفلُ في المراحِل المبكّرَة من اكتِسابه لغَتَه الأمَّ للتَّعبير بها عن مَعنى جُملة؛ كأن يقول: (ماء) أي أُريدُ ماءً، أو: (سُوق) أي: أبي في السُّوق، حين يُسأل عن أبيه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الكلمة الجملة ","nonDiacriticsLemma":"الكلمة الجملة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الكَلِمَةُ الجُمْلَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/386e1865-7daa-462c-bae7-eadb8a893df0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"386e1865-7daa-462c-bae7-eadb8a893df0","word":"اللُّغَاتُ الهِسْبَانِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b924e","lexicalEntryId":"386e1865-7daa-462c-bae7-eadb8a893df0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَاتُ الهِسْبَانِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اسمٌ يطلَق على اللغات التي تفرَّعَت من اللاتينِية ضِمنَ المجموعَةِ الإيطاليقيةِ من العائلَة الهنديةِ الأورُبية، وتَشمَل ثلاثَ لغاتٍ هي: الإسبانيةُ، والبُرتغاليةُ، والكَتلانية. لكن هذا الاسمَ - في عَصرنا الحاضِرِ - غالبا ما يُطلَق، في الوَلايات المتحدَةِ الأمريكية خاصةً، على الناطِقين باللغة الإسبانيةِ، الذين من سُكّان دُوَل أمريكا الوُسطى وأمريكا الجنوبيةِ والبَحرِ الكاريببي، مثل المكسيكِ وكوبا وبورتوريكو وكوستاريكا، ويمثِّلون نسبَةً عاليَةً من الأقَلِّيَّات العِرقيةِ واللغويةِ والثقافيةِ في الولايات المتحدة الأمريكية، ويُسمَّون أيضا باللاتِينيِّين Latinos.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغات الهسبانية ","nonDiacriticsLemma":"اللغات الهسبانية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَاتُ الهِسْبَانِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bcb605aa-d322-4b23-bb18-925fbacf775a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bcb605aa-d322-4b23-bb18-925fbacf775a","word":"مُدَوَّنَةُ المُتَعَلِّمِين","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9520","lexicalEntryId":"bcb605aa-d322-4b23-bb18-925fbacf775a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُدَوَّنَةُ المُتَعَلِّمِين","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مجموعَةٌ لغويةٌ حاسوبيةٌ مَقروءةٌ من البَيانات النَّصِّيَّةِ الواقِعِيَّةِ للُّغَة الهدَف، جُمِعَت وفقا لمعايِيرَ لغويةٍ حاسوبيةٍ واضِحَة. وهي مدوَّنةٌ لغوية، تحوِي نُصوصا من إنتاج متعلِّمي اللغةِ الناطقين بغيرها، غالبا ما تُستخدَم لتَحديد درَجاتِ شُيُوعِ الأخطاء، وتحليلِها، أو لمقارَنَة لغةِ متعلِّمي اللغةِ الهدَفِ بلُغة الناطقين بها؛ لأغراضٍ تعليميّة، أو تحليليّةٍ عامَّة، أو بحثِيَّةٍ تَطبيقِيَّة. وقد تُخصَّص لأخطاء الناطِقين باللغة، ولاسيّما الأخطاءُ الإملائيةُ والنحويةُ والأسلوبيةُ. ومن أهم مدوّنات المتعلمين المدوّنة الدولية لمتعلمي الإنجليزية International Corpus of Learner English.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مدونة المتعلمين ","nonDiacriticsLemma":"مدونة المتعلمين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُدَوَّنَةُ المُتَعَلِّمِين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/91e7adb4-48c8-49a5-bf87-fd14ca869a17/get-public-entry"},"browse_index_record":{"lexicalEntryId":"91e7adb4-48c8-49a5-bf87-fd14ca869a17","word":"جِذْعٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9521","lexicalEntryId":"91e7adb4-48c8-49a5-bf87-fd14ca869a17","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جِذْعٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"جُزءٌ من كلمةٍ يُضاف إليه مورفيمٌ أو مَجموعةٌ من المورفيمات تَقبَل الزيادة، وتَتَمَثَّل في الماضي من الأفعال والمفرَد من الأسماء في العربية. يختَلف الجِذعُ أو السَّاقُ عن الجِذْر root؛ فكلِمَةُ: (الجالِسُون) جَذعُها: (جالِسٌ) وكلمة (يجلسون) جِذعُها: (جَلَسَ)، لكن جِذْرَ الكلمَتَين واحدٌ هو مادَّةُ: (ج ل س ). والكلمةُ الإنجليزيةُ: harmful جِذعٌ لأنها تَقبَل السابقةَ: un، فيُقال: unharmful، لكنها ليسَت جِذرا بل الجِذْر هو: harm. ويكون الجِذعُ: بَسيطا أي مكوَّنا من جِذرٍ فقط، مثلُ: work و: harmful، ويكون جِذرا مع زائدة مثلُ: works، وقد يكون من جِذرَيْن أو أكثَرَ، مثلُ: workshop. وقد يُستَعمَل لفظُ جِذع أو ساق بمعنى جِذر أو العَكس، وذلك حين يكون الجِذعُ أو الساقُ بسيطا مُكَوَّناً من جِذرٍ واحِدٍ، أي يكون مورفيما (وحدة صرفيّة) واحدا  فقط.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات","اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"جذع ","nonDiacriticsLemma":"جذع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جِذْعٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cb816a6a-7fb7-4df5-a33f-39e1ce7e69d7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cb816a6a-7fb7-4df5-a33f-39e1ce7e69d7","word":"تَنْشِيطٌ مُعْجَمِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9522","lexicalEntryId":"cb816a6a-7fb7-4df5-a33f-39e1ce7e69d7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَنْشِيطٌ مُعْجَمِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أن تُسَهِّل كلمةٌ تَذَكُّرَ كلمةٍ أخرى أو تُعَرِّفها، حين تكون بين الكلمَتَين علاقةٌ قويَّةٌ، مثلُ: (طَبِيب ومَريض) و(سَفَر وطائرَة) و(تعلُّم ومدرَسة). وتَطبيقُ هذا التَّنشيطِ المعجَميِّ في تدريبات الرَّبط الشائعَةِ الاستعمالِ في بعض طرائق تدريسِ اللغاتِ الأجنَبية، مُفيدٌ في زيادَة الثروَةِ المعجَميةِ وتَنويعِ استعمالاتِها لدى المتعلِّمين، خاصةً حين تُقَدَّم من خلال المذهبِ المعجَميِّ الذي يُركِّز على المتَصاحِبات اللَّفظِيةِ collocations.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تنشيط معجمي ","nonDiacriticsLemma":"تنشيط معجمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَنْشِيطٌ مُعْجَمِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5f8b80aa-1ff5-4f1f-8f94-b7725267a5cb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5f8b80aa-1ff5-4f1f-8f94-b7725267a5cb","word":"نُمُوٌّ مُعْجَمِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9523","lexicalEntryId":"5f8b80aa-1ff5-4f1f-8f94-b7725267a5cb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نُمُوٌّ مُعْجَمِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"زيادةُ رَصيدِ المرءِ من مفرَدات لغَتِه الأمِّ أو مفرَدات اللغةِ الثانيةِ أو الأجنبيةِ. يرى بعضُ علماءِ اللغةِ النفسيّين أن النُّمُوَّ المعجَميَّ مما يَصعُب ضَبطُه في النُّمُوِّ اللغويِّ المرحَليِّ لدى الطفلِ أو الكَبير، قِياسا على النُّمُوِّ في الجوانب الصوتيةِ والصرفيةِ والتركيبية. فالثَّروَةُ اللغويةُ تؤثِّر فيها البيئةُ المحيطَةُ بالطفلِ والثقافةُ المنزِليةُ، ونوعُ وَسائلِ الإعلامِ التي يَتَلقّاها، في حين يَقِلُّ تأثيرُ هذه العواملِ (الخارِجيةِ) في النُّمُوِّ اللغويِّ في الجوانب الأخرى، ولاسيّما في الجوانب التركيبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نمو معجمي ","nonDiacriticsLemma":"نمو معجمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نُمُوٌّ مُعْجَمِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

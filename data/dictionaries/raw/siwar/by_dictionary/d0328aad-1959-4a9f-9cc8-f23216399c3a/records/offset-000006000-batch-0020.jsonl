{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/093a1089-6c97-419f-9818-a4d5629dd913/get-public-entry"},"browse_index_record":{"lexicalEntryId":"093a1089-6c97-419f-9818-a4d5629dd913","word":"تَغذِيَةٌ رَاجِعَةٌ مَكتوبَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba203","lexicalEntryId":"093a1089-6c97-419f-9818-a4d5629dd913","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَغذِيَةٌ رَاجِعَةٌ مَكتوبَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ما يُقدِّمه المعلِّمُ من تعليقاتٍ وتَوجيهاتٍ على ما يَكتُبه الطالبُ، سواء أكان المكتوبُ تعبيرا أم إجابةً عن أسئلةٍ أم اختبارا. والتغذيةُ الكتابيةُ الراجعةُ مادَّةٌ مُهمَّةٌ لتَحليل النُّمُوِّ اللغويِّ المعرِفيِّ في مرحَلة اكتِسابِ اللغة؛ حيث يَرصُد المعلِّمُ أو الباحِثُ درَجَةَ فَهمِ الطالبِ لهذه التغذية، ومَدَى استِجابَتِه لها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تغذية راجعة مكتوبة ","nonDiacriticsLemma":"تغذية راجعة مكتوبة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَغذِيَةٌ رَاجِعَةٌ مَكتوبَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f055e936-7a73-49be-8f46-1b7aafbb5158/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f055e936-7a73-49be-8f46-1b7aafbb5158","word":"مَنْطِقَةُ النُّمُوُّ التَّقارُبِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba204","lexicalEntryId":"f055e936-7a73-49be-8f46-1b7aafbb5158","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَنْطِقَةُ النُّمُوُّ التَّقارُبِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مفهومٌ عامٌّ يقَع ضمنَ النظريةِ الاجتماعيّةِ الثقافيّةِ، والنظريّةِ الاجتماعيةِ التفاعُليّةِ المفسِّرَةِ لاكتساب اللغة، وهما لعالم النفسِ الرُّوسيِّ ليف فيغوتسكي Lev Vygotsky، الذي عُنِي بالبحث في مجال نُمُوِّ الطفلِ، بما في ذلك نُمُوُّه اللغويّ. ومنطقةُ النموِّ التقارُبيّ وَصفٌ للمَجال الذي يمكن أن يحدُث فيه التعلُّمُ، وهو مجالُ المعرِفةِ أو المهارَةِ الذي يكون فيه المتعلِّمُ غيرَ قادِرٍ بعدُ على الأداء المنفَرِد، ولكنه قادِرٌ على تحقيق النتيجَةِ المرغوبَةِ حين يحصل على المسانَدَة المطلوبَة. وضَّح فيغوتسكي هذه المنطقةَ بأنها الفَرقُ بين مستوى نُمُوِّ الطفلِ كما يتحَدَّد من خلال حَلِّه المستَقِلِّ للمُشكلات والمستوى الأعلى من النُّمُوِّ المحتَمَل كما يتحَدَّد من خلال حَلِّ المشكلاتِ تحتَ إشرافِ والِدَيْن أو مُعلِّمِينَ أو زُملاءَ أكثَرَ قُدرَةً من الطفل. طُبِّق هذا المفهومُ في تفسير اكتسابِ اللغةِ الثانية، ثم في تعليم اللغةِ الثانيةِ واللغةِ الأجنَبية، وارتبَط بمفهوم المسانَدَة. راجع:  @(scaffolding) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"منطقة النمو التقاربي ","nonDiacriticsLemma":"منطقة النمو التقاربي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَنْطِقَةُ النُّمُوُّ التَّقارُبِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8548c94e-c5f8-4205-a3e8-04a7745cd7a3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8548c94e-c5f8-4205-a3e8-04a7745cd7a3","word":"صَوْغُ الكَلِمَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba205","lexicalEntryId":"8548c94e-c5f8-4205-a3e8-04a7745cd7a3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَوْغُ الكَلِمَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"بناءُ الكلمةِ الجَديدَة، أي تَوليدُ كلمةٍ من أخرى، أو تَحويلُ صِيغَةِ الكلمةِ إلى صِيغَة أخرى بالاشتِقاق أو بالتَّصريف أو بالإضافَة أو الدَّمج. من أساليب صَوغِ الكلمات: إضافَةُ زائدَةٍ affix على الكلمة، أو حَذفُ زائدَةٍ منها، أو تَأليفُ الكلمةِ بضَمّ بعضِها إلى بعضٍ compounding، أو اختِصارُ الكلمةِ clipping، أو تَكرارُ أجزاءٍ منها، أو نَحْتُ صِيغَةٍ من كلمَتَين blending، أو غيرُ ذلك. وقد تكون الكلمةُ الجَديدَةُ مختَرَعَةً أو مُقتَرَضَةً من لغةٍ أخرى. تختَلِف اللغاتُ في الأَخذ بأيٍّ من الأساليب السابقةِ لصَوغ كلماتِها الجديدة، وتُعَدُّ الإنجليزيةُ من أبرَز اللغاتِ التي تتنوَّع فيها أساليبُ صياغَةِ الكلماتِ الجديدة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صوغ الكلمات ","nonDiacriticsLemma":"صوغ الكلمات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَوْغُ الكَلِمَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0dff961e-fb65-4aa5-9147-0ef404f11320/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0dff961e-fb65-4aa5-9147-0ef404f11320","word":"قَائمَةُ مُفْرَدَاتٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba206","lexicalEntryId":"0dff961e-fb65-4aa5-9147-0ef404f11320","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَائمَةُ مُفْرَدَاتٍ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"قائمةٌ تَضُمُّ الكلماتِ الأساسيةَ الأكثَرَ شيُوعا أو الأكثَرَ أهميةً من غيرها في اللغة الهَدَف؛ لتُبنَى عليها الموادُّ التعليميةُ. هذه القائمةُ تكون عامّةً في اللغة، أو خاصّةً بتخَصُّصٍ أو حَقلٍ من حُقول المعرِفة. راجع:  @(word count) و  @(word frequency) و  @(word frequency count) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ يَشيع استِعمالُه في البَحث في الكلام الرَّسميِّ في الدراسات اللغويةِ الاجتِماعية، حيث يُستَنْطَق المفْحوصُون في المقابَلات الشَّخصِية، باستِعمال قائمَةٍ من المفرَدات المتَضَمِّنَةِ سِماتٍ صَوتيةً مُعَيَّنَةً مُرتَبِطَةً بأهداف الدراسة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قائمة مفردات ","nonDiacriticsLemma":"قائمة مفردات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَائمَةُ مُفْرَدَاتٍ"}],"lemmaLanguage":
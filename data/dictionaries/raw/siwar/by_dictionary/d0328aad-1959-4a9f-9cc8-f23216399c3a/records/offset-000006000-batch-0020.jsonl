{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/37fe8bb4-d59c-4f18-a8e6-35017e7a9a62/get-public-entry"},"browse_index_record":{"lexicalEntryId":"37fe8bb4-d59c-4f18-a8e6-35017e7a9a62","word":"الفَرْضِيَّةُ الوُورْفِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba1fc","lexicalEntryId":"37fe8bb4-d59c-4f18-a8e6-35017e7a9a62","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الفَرْضِيَّةُ الوُورْفِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةُ النِّسبِيَّةِ اللغويةِ التي ابتدعها فون هومبولت von Humboldt، ثم أكمَلَها سابِير و وُورف Sapir & Whorf، وتُسمّى أيضا فَرضِيةَ سابِير و وُورف Sapir-Whorf hypothesis، وتُسمّى كذلك الوُورْفِيَّة Whorfianism. وترَكِّز على تأثير اللغةِ في التَّفكير، وتَنظِيمِ هذا العالَمِ في ذِهنه، وتَرَى أن لغةَ المرءِ هي التي تحَدِّد إدراكَه للعالَم الخارِجيِّ تحديدًا كُلِّيًّا أو جُزئيًّا. راجع:  @(Linguistic Relativism/Relativity) و  @(Sapir-Whorf Hypothesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الفرضية الوورفية ","nonDiacriticsLemma":"الفرضية الوورفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الفَرْضِيَّةُ الوُورْفِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b431ddcc-812a-44bd-a832-1dda60ed36de/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b431ddcc-812a-44bd-a832-1dda60ed36de","word":"رَبْطُ الكَلِمَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba1fd","lexicalEntryId":"b431ddcc-812a-44bd-a832-1dda60ed36de","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رَبْطُ الكَلِمَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"رَبطُ الكلماتِ بعضِها ببعضٍ بأساليب معيَّنَةٍ لتَيسير تَعلُّمِها وتذَكُّرِها، أو تَداعِيها في الذاكِرَة، وهو أنواع منها: الرَّبطُ التَّقابُليّ، والرَّبطُ التَّشابُهِيّ، والرَّبطُ الشَّكلِيّ، والرَّبطُ المعنَوِيّ. وفي اختِبار رَبطِ الكلماتِ word association test، وفي التدريبات اللغوية، يُعطَى الطالبُ كلمةً أو مجموعةً من الكلمات، ويُطلَب منه رَبطُ بعضِها ببعض. ورَبطُ الكلماتِ يُدرَس في ميادين لغويةٍ مختَلِفة؛ كعلم الدَّلالة، وعلمِ النَّفس، ونَظرياتِ تعلُّمِ اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ربط الكلمات ","nonDiacriticsLemma":"ربط الكلمات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رَبْطُ الكَلِمَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/493fc6ac-89ab-4139-9ec6-741fa4c42640/get-public-entry"},"browse_index_record":{"lexicalEntryId":"493fc6ac-89ab-4139-9ec6-741fa4c42640","word":"قانُونُ زِيف","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba1fe","lexicalEntryId":"493fc6ac-89ab-4139-9ec6-741fa4c42640","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قانُونُ زِيف","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قانونٌ يَصِف ظاهرَةً رياضيّةً مُطَّرِدَةً في اللغة، وهي أنه إذا رُتِّبَت أنواعُ الكلماتِ في عيِّنَة كبيرةِ الحَجمِ من نُصوص اللغةِ تَبَعا لتكرار استِعمالِها بتَرتيبٍ تَنازُليّ، فإن مُعَدَّل التَّناقُصِ لجَميع الكلماتِ - باستثناء الكلماتِ الأكثَر شُيوعا في الاستِعمال - يكون مُعدَّلا ثابِتا. فالإحصاءاتُ تبيِّن أن كلَّ اللغاتِ تستَعمِل عدَدا محدودا من الكلمات بكثرَةٍ مَلحوظة. ويُلحَق بهذا القانونِ أيضا قانونٌ لغويٌّ إحصائيٌّ آخَر، وَضَعَه زِيف، هو قانونُ الاختِصارِ law of abbreviation، وهو وُجودُ عَلاقَةٍ عَكسيّةٍ بين طُولِ الكلمةِ وشُيُوعِها؛ فكلَّما طالَت الكلمةُ قَلَّ شُيوعُها، وكلَّما قَصُرَت زاد شُيوعُها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قانون زيف ","nonDiacriticsLemma":"قانون زيف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قانُونُ زِيف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

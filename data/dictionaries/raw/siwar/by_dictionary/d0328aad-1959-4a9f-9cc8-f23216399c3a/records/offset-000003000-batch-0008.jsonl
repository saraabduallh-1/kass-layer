{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3c353a2d-5166-4354-9987-4bd2c4813b91/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3c353a2d-5166-4354-9987-4bd2c4813b91","word":"مَسْحٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94e2","lexicalEntryId":"3c353a2d-5166-4354-9987-4bd2c4813b91","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَسْحٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم اللغةِ الجُغرافيِّ، يَعني تَقَصِّيَ الوَضعِ اللغويِّ في دولَةٍ أو منطقَة؛ لمعرِفة اللغةِ أو اللغاتِ المستَعمَلةِ في تلك الدولة أو المنطقَة المحدَّدَة، وتحديدِ الأغراضِ والمجالاتِ التي تُستَعمَل فيها، وتَعيينِ درَجاتِ الكِفايَةِ لدى الناطقين بها. وقد يُجرَى المسحُ اللغويُّ لمعرِفَة حالِ اللغةِ ومستوَياتِها ومجالاتِ استعمالِها لدى فئةٍ معيَّنَةٍ من الناس، محدَّدَةِ العُمر أو المهنَةِ أو الانتِماءِ الثقافيِّ أو الطَّبَقيِّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مسح لغوي ","nonDiacriticsLemma":"مسح لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَسْحٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a7f14b21-a31a-40c9-b462-626a81d9575b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a7f14b21-a31a-40c9-b462-626a81d9575b","word":"قَانُونُ الاخْتِصَارِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94e3","lexicalEntryId":"a7f14b21-a31a-40c9-b462-626a81d9575b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَانُونُ الاخْتِصَارِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قانونٌ وَضَعَه اللغويُّ الأمريكيُّ جورج زِيف George Kingsley Zipf، المتوفى عام 1950م، ويُسمّى أيضا قانون زِيف Zipf's Law، مفادُه أن بين طُولِ الكلمةِ وشيُوعِها علاقةً عَكسِية؛ فالكلماتُ الأقصَرُ في لغةٍ ما هي الأشيَعُ فيها، والكلماتُ الأطوَلُ هي الأقَلُّ شيُوعًا. أُجرِيَ عَدَدٌ من الدراسات في هذا القانونِ على بعض الصُّحفِ الأمريكية، واستُخرِج منها أشيَعُ الكلماتِ في الإنجليزية. وقانون الاختصارِ هذا هو أشهَرُ نماذجِ قانونٍ عامٍّ وَضَعه زِيف يُمكن تَطبيقُه في مجالاتٍ متنوِّعة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قانون الاختصار ","nonDiacriticsLemma":"قانون الاختصار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَانُونُ الاخْتِصَارِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2ac312a0-2e23-48c7-81ce-43f229b33d09/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2ac312a0-2e23-48c7-81ce-43f229b33d09","word":"كَثَافَةٌ مُعْجَمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94e4","lexicalEntryId":"2ac312a0-2e23-48c7-81ce-43f229b33d09","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَثَافَةٌ مُعْجَمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نِسبَةُ الأصنافِ اللغويةِ types، أو الكلماتِ غيرِ المكرَّرَة، في نَصٍّ لغويٍّ إلى مجموع الكلماتِ فيه، أي معَدَّلُ وُرُودِها بالنسبة إلى العَدَد الإجماليِّ للكلمات في النَّص. تُقاسُ هذه النسبةُ بقِسمَة الكلماتِ المعيَّنةِ على مجموع الكلماتِ ثم يُضرَب الحاصِلُ في مئة. ويرى بعضُ اللغويِّين أنها النِّسبةُ بين عَدَدِ الكلماتِ المعجَميةِ lexical words مَقسومةً على عَدَد الكلماتِ النحويةِ grammatical words. وتُفيد نتائجُ بعضِ الدراساتِ اللغويةِ التطبيقيةِ أن زيادةَ الكَثافَةِ المعجَميةِ في النَّصِّ مؤشِّرٌ على صُعُوبَته. راجع:  @(type) و  @(Type-Token Ratio (TTR)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كثافة معجمية ","nonDiacriticsLemma":"كثافة معجمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَثَافَةٌ مُعْجَمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/899055c5-0948-4627-882c-c0661e26dba0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"899055c5-0948-4627-882c-c0661e26dba0","word":"جَانِبِيَّةُ التَّحَكُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94d7","lexicalEntryId":"899055c5-0948-4627-882c-c0661e26dba0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جَانِبِيَّةُ التَّحَكُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُقصَد به سيطرَةُ أحَدِ نِصفَيْ الدِّماغِ على أنشِطَةٍ جِسميةٍ ووَظائفَ معيَّنةٍ، بما في ذلك الوَظائفُ اللغوية. يَتِمُّ هذا التحَكُّمُ بأسلوب مُتعاكِس؛ فيُسَيطِر النصفُ الأيمنُ من الدِّماغ على حرَكَة الجانبِ الأيسرِ من الجِسم، ويُسَيطِر النصفُ الأيسَرُ من الدِّماغ على حرَكَات الجانبِ الأيمَنِ من الجِسم. وهذا التحَكُّمُ الجانِبِيُّ مُرتَبطٌ بتوزيع وَظائفِ اللغةِ في نِصفَيْ الدِّماغ؛ فمُعظَمُ الذين يَستَخدمون اليدَ اليُمنى (95%) - ونسبةٌ عاليةٌ من الذين يَستخدمون اليدَ اليُسرى (61%) - تَتَمَركز لغَتُهم في النِّصف الأيسَرِ من الدِّماغ. راجع:  @(brain) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جانبية التحكم ","nonDiacriticsLemma":"جانبية التحكم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جَانِبِيَّةُ التَّحَكُّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":nu
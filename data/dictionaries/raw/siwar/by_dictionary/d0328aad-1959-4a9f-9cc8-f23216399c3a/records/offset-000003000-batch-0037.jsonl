{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3d8b3af3-384b-4c75-ae7c-ade0d724d6ce/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3d8b3af3-384b-4c75-ae7c-ade0d724d6ce","word":"عِلْمُ اللُّغَةِ العَصَبِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97bf","lexicalEntryId":"3d8b3af3-384b-4c75-ae7c-ade0d724d6ce","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ العَصَبِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من فروع علمِ اللغةِ النفسيِّ في نشأته، ثم استقَلَّ عنه فيما بعدُ، يُعنَى بدراسة وَظائفِ الدِّماغِ ذاتِ العلاقةِ باللغة من حيث اكتسابُها وتعلُّمُها، واستعمالُها، ومشكلاتُها. بيدَ أنه يهتَمُّ بشَكلٍ خاصٍّ بالمشكلات اللغويةِ التي سبَبُها إصاباتُ الدِّماغ؛ كالحُبسَة بأنواعها، إضافةً إلى دراسة الجوانبِ المعرفيةِ المرتَبطةِ باللغة؛ كالذَّكاء والذاكِرَة. ويُركِّز على أجزاء الدِّماغِ التي تتحَكَّم في مهارات اللغةِ فَهمًا وإنتاجًا، والأجزاءِ التي تتحَكَّم في أعصاب السَّمعِ وأعضاءِ النُّطق. ويُسمّى أيضا: neurological linguistics، كما يُسمّى أحيانا: nervolinguistics.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة العصبي ","nonDiacriticsLemma":"علم اللغة العصبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ العَصَبِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRo
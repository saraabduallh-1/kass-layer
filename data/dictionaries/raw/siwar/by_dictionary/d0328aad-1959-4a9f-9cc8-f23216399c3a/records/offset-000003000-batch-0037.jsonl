{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f78b2a50-8d5b-4b19-b521-c24f003e394c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f78b2a50-8d5b-4b19-b521-c24f003e394c","word":"لُيُونَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97c8","lexicalEntryId":"f78b2a50-8d5b-4b19-b521-c24f003e394c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُيُونَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُقصَد به لُيُونةُ أنسِجَةِ الدِّماغِ لُيُونةً تُكسِبها القُدرَةَ على اكتساب اللغةِ الأمِّ واللغاتِ الثانيةِ والأجنَبية. يرى بعضُ اللغويين النَّفسيِّين أن هذه اللُّيُونةَ تَقتَصِر على مرحَلة الطُّفُولةِ مع اختِلافٍ في تحديد نِهايتِها، ثم تبدأ أنسِجةُ الدِّماغِ في التَّصَلُّب حتى تَتَوَقَّف في مرحَلةٍ عُمريةٍ مُعيَّنة؛ فيَصعُب حينئذٍ اكتسابُ اللغاتِ اكتسابًا طبيعيًّا. غير أن لغويِّين آخَرِين لا يؤيِّدون هذا الرأيَ، ولا يَعتَمِدون عليه في تفسيرهم لاكتساب اللغةِ الثانية، بل يَرَون أن اكتسابَها تؤثِّر فيه عوامِلُ متعَدِّدةٌ، وأنّ عُمرَ المتعلِّمِ يُؤثِّر في هذا الاكتساب تأثيرًا غيرَ مُباشِر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"ليونة ","nonDiacriticsLemma":"ليونة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُيُونَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":
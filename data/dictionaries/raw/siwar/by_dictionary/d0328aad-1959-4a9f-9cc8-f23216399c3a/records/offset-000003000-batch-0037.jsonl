{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bab001e5-3ed7-4e80-8b12-14fc779815d0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bab001e5-3ed7-4e80-8b12-14fc779815d0","word":"تَعَدُّدِيَّةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97c1","lexicalEntryId":"bab001e5-3ed7-4e80-8b12-14fc779815d0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعَدُّدِيَّةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"معرفةُ شَخصٍ ما لأكثَر من لغَتَين، أو استعمالُ مجتَمَعٍ ما أكثَرَ من لغَتَين، أو معجَمٌ مَداخِلُه متعَدِّدةُ اللغاتِ، أو كتابٌ، أو نظامٌ حاسوبيٌّ، أو موقعٌ شَبَكيٌّ بأكثَر من لغَتَين. والتَّعدُّدِيّةُ اللغويةُ في المجتَمَعات أو المناطقِ الجغرافيةِ تُصنَّف - بحسب سَيطَرَةِ لغةٍ أو لغاتٍ معيَّنَةٍ منها - إلى أصناف؛ كأن تكون لغةٌ واحدةٌ منها غالبةً على غيرها، أو تكون واحدةٌ منها فقط لغةَ أقَلِيَّة، أو تكون لغاتُ الأقلِّيَّةِ هي الغالِبَة، وربما تكون اللغةُ البَديلَةُ هي الغالِبَة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعددية لغوية ","nonDiacriticsLemma":"تعددية لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعَدُّدِيَّةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ba03eb89-87ff-4b60-9129-943078729802/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ba03eb89-87ff-4b60-9129-943078729802","word":"الأُمَّةُ واللُّغَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97c2","lexicalEntryId":"ba03eb89-87ff-4b60-9129-943078729802","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الأُمَّةُ واللُّغَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عَلاقَةُ اللغةِ بالأمَّة؛ فاللغةُ هُوِيَّةُ الأمَّةِ أو الدولَة، ولا توجَد أمَّةٌ دونَ لغَةٍ تنتَمي إليها وتجمَعها، وتُسمّى اللغةَ القَوميةَ أو الرّسمية. وقد تتعَدَّد اللغاتُ القَوميةُ أو الرّسميةُ في الدولَة الواحدَة، كما في الهند ودولَةِ جنوبِ أفريقيا، وربما تكون اللغةُ هي الوَسيلةَ الوحيدَةَ لجَمع عدَدٍ من الدوَل المختَلِفَةِ ضِمنَ أمَّةٍ واحدَة، كحال اللغةِ العربيةِ التي تجمَع ما يربو على عشرين دولَة، بل هي الأمَّةُ الوَحيدَةُ في العالم المعاصِرِ التي تَسمَّى باسم لغَتِها. راجع:  @(national language) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الأمة واللغة ","nonDiacriticsLemma":"الأمة واللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الأُمَّةُ واللُّغَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0393a25d-531f-4d96-b29a-deb987447208/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0393a25d-531f-4d96-b29a-deb987447208","word":"تَدْرِيبٌ تَسَلْسُلِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b45","lexicalEntryId":"0393a25d-531f-4d96-b29a-deb987447208","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيبٌ تَسَلْسُلِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغات، يُشير إلى تَدريبٍ لغويٍّ شَفَهيٍّ في الطريقة السَّمعِية الشَّفَهِية، يُجْرَى في الفَصل ويَسير بشَكلٍ تَسَلْسُليٍّ. يُسأل فيه طالبٌ سؤالا يُجيب عنه طالبٌ آخَرُ، ثم يُسأل الطالبُ الآخَرُ السؤالَ ذاتَه فيُجِيب عنه طالبٌ ثالثٌ، وهكذا حتى يكون كلُّ طالبٍ في الصَّفِّ قد سَأل سؤالا وأجاب عنه في الوَقت نفسِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريب تسلسلي ","nonDiacriticsLemma":"تدريب تسلسلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيبٌ تَسَلْسُلِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/28e15784-9f79-422c-947c-2587111859b8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"28e15784-9f79-422c-947c-2587111859b8","word":"تَجْوِيفُ الصَّدْرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b46","lexicalEntryId":"28e15784-9f79-422c-947c-2587111859b8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَجْوِيفُ الصَّدْرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مكوِّن من مكوِّنات الصَّوتِ اللغويِّ، وهو تجويفٌ يقَع فوقَ الحِجابِ الحاجِز، ويحيط به القَفَصُ الصَّدرِيُّ، ويحوِي الرِّئتَين اللَّتَين هما المصدَرُ الأولُ للطاقة الهوائية التي هي أساسُ الصوت؛ إذ تَنتَفِخان في أثناء عمَليةِ الشَّهيقِ ويَتَّسِع لهما تجويفُ الصَّدرِ قليلا، وتنكَمِشان في أثناء عمَلية الزَّفيرِ؛ نتيجَةَ ضَغطِ الحِجابِ الحاجِز والقَفَصِ الصدرِيِّ عليهما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تجويف الصدر ","nonDiacriticsLemma":"تجويف الصدر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَجْوِيفُ الصَّدْرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5a0d31ad-416e-48fc-8f5d-2e7b82c36ca2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5a0d31ad-416e-48fc-8f5d-2e7b82c36ca2","word":"صِنْفٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b47","lexicalEntryId":"5a0d31ad-416e-48fc-8f5d-2e7b82c36ca2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صِنْفٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مجموعةٌ من العناصِر اللغويةِ التي تُصَنَّف في بابٍ نحويٍّ واحد؛ لتَشابُه خَصائصِها وسِماتِها وطريقةِ بِنائها ونَظْمِها مع كلمات أخرى. وتختَلِف بعضُ اللغاتِ فيما بينها في كثرَة هذه الأصناف، ودُخُولِ بعضِها في بعض، لكن الأصنافَ اللغويةَ الرئيسةَ في معظَم لغاتِ العالَمِ هي: الأسماءُ والصِّفاتُ والأفعالُ والحُروف. وقد يُطلق هذا المصطلَحُ على الباب النحوي؛ كالمبنِي للمَجهول، والحالِ والتَّمِيِيز.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"صنف ","nonDiacriticsLemma":"صنف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صِنْفٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1b16ae8e-3ef6-42e7-ae68-6cb5e52375a4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1b16ae8e-3ef6-42e7-ae68-6cb5e52375a4","word":"لُغَةٌ مُكَسَّرةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b48","lexicalEntryId":"1b16ae8e-3ef6-42e7-ae68-6cb5e52375a4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مُكَسَّرةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على اللغة التي لا تتقيَّد بالقواعد المعروفَةِ لدى الناطقين بها، كاللغة الهَجِين مثلا pidgin language، أو على استِعمال اللغةِ استِعمالا غيرَ سَليم، لاسيَّما في الجوانب الصرفيةِ والنحوية؛ إذ تكون الصيَغُ غيرَ صَحيحَة، مع خَلَلٍ في الترتيب الصحيحِ لعناصِر الجُملة، وفَقْدٍ للكلماتِ والأدواتِ الوَظيفِية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة مكسرة ","nonDiacriticsLemma":"لغة مكسرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مُكَسَّرةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/125380b4-32b2-49c7-bff2-898990691984/get-public-entry"},"browse_index_record":{"lexicalEntryId":"125380b4-32b2-49c7-bff2-898990691984","word":"لَهْجَةٌ طَبَقِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b5e","lexicalEntryId":"125380b4-32b2-49c7-bff2-898990691984","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لَهْجَةٌ طَبَقِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتِماعيٌّ، يُشير إلى مستَوًى من مستَوَيات اللغةِ في مجتَمَعٍ ما مختَلِفٍ عن المستَوَيات الأخرى أو اللَّهَجاتِ الأخرى؛ لارتِباطه بطَبَقَةٍ اجتماعيةٍ معيَّنةٍ أو بأصحاب مِهنَةٍ محدَّدَة. وقد تُسمى لغةً طَبَقِيةً class language، وذلك حين تكون عَبْرَ عَدَدٍ من اللغات، كلغة الأطِباء، ولغةِ المهندسين، ولغةِ الصناعيِّين، ولغةِ الإعلامِيِّين، ولغةِ السياسِيِّين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لهجة طبقية ","nonDiacriticsLemma":"لهجة طبقية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لَهْجَةٌ طَبَقِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

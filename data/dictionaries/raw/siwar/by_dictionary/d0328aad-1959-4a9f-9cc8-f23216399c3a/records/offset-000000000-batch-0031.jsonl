{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c803c957-c4eb-45b8-9613-cf350e354727/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c803c957-c4eb-45b8-9613-cf350e354727","word":"مُرَبَّعُ كَايْ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b5b","lexicalEntryId":"c803c957-c4eb-45b8-9613-cf350e354727","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُرَبَّعُ كَايْ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اختبارٌ إحصائيٌّ، يَكشِف عن درَجة الاختِلافِ والتَّشابُه بين المشاهَداتِ الملاحَظَةِ من جهةٍ والمشاهداتِ المتوقَّعَةِ من جهةٍ أخرى، وذلك حين يكون الفَرضُ الصِّفريُّ صحيحا. فيُستَعمَل هذا الاختبارُ لمعرفة ما إذا كانت العلاقةُ مستَقِلَّةً بين متَغَيِّرَيْن أو أكثر؛ كأن يُستعان به في تحديد العلاقةِ بين القُدرَةِ على الكتابة والمستوى الاجتماعيِّ الذي ينتَمي إليه متعلِّمُ اللغة، أو يُستَعان به في مقارَنة أسلوبَين من التغذية الراجِعَةِ feedback داخلَ حجرَةِ الدَّرس، أحدُهما مباشِر، والآخَرُ غيرُ مباشِر؛ لمعرفة أيهما أفضَلُ في إزالَة التَّحَجُّرِ اللغويِّ لدى متعلِّم اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مربع كاي ","nonDiacriticsLemma":"مربع كاي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُرَبَّعُ كَايْ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a00a936e-d23e-4690-adbd-d249ed31a717/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a00a936e-d23e-4690-adbd-d249ed31a717","word":"اللِسانِيّاتُ التُّشُومْسْكِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b5c","lexicalEntryId":"a00a936e-d23e-4690-adbd-d249ed31a717","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللِسانِيّاتُ التُّشُومْسْكِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلِقه بعضُ اللغويين على الاتِّجاه المعرِفيِّ الفِطرِيِّ في دراسة اللغةِ وتفسيرِ اكتِسابِها، وذلك وفقاً لآراء نوم تشومسكي Noam Chomsky ونظرياتِه التي ظَهَرت في نهايَة الخمسينياتِ من القرن العشرين. ومن أهم النظرياتِ التي اشتُهِر بها تشومسكي النظريةُ التوليديةُ التحويلية، والنحو التوليديُّ التحويلي، والنحوُ الكُلِّيُّ، ونظريةُ الحَّدِّ الأدنى، والنظريةُ الفطريةُ في اكتساب اللغة، والمسألةُ المنطقيةُ في اكتساب اللغة، وفَقرُ المدخَلاتِ اللغويةِ في اكتساب اللغة. مرَّت نظرياتُ تشومسكي بمراحِل عدَّة، وهيمَنَت على الدراسات اللغويةِ بنَوعَيها النظريِّ والتطبيقي، وقلَّلَت من أهميَّة الاتِّجاهِ البِنيَويِّ السُّلوكيِّ الذي كان سائدا منذ ظُهُورِ علمِ اللغةِ الحديثِ، ومُهَيمِنا على دراسة اللغةِ ومناهجِ البحثِ في اكتسابها وتَعلُّمِها وتعليمِها. نادى تشومسكي منذ ظُهورِه لغويًّا بأن علمَ اللغةِ علمٌ لغويٌّ نفسيٌّ إدراكيٌّ، وعُنِي بتفسير السُّلوكِ اللغويِّ في ضَوء علمِ النفسِ الإدراكيِّ cognitive psychology، ودعا اللغويِّين إلى التَّعمُق في اللغة داخِلَ العَقلِ البشَريِّ بدلا من البحث البِنيَويِّ الشَّكليِّ في اللغة الظاهِرَة. لهذا انضَمَّ إليه باحثون ومتخَصِّصون في علم النفسِ الإدراكيِّ وعلمِ نفسِ النُّمُوِّ developmental psychology، حتى عُدّ كثيرٌ منهم لُغوَوِيِّين وهم ليسُوا كذلك. على الرّغم من ذلك، فإن آراءَ تشومسكي ونظرياتِه، لاسيَّما آراؤه ونظرياتُه في اكتساب اللغة، فَلسفيةٌ ومَنطِقيةٌ جَدَليةٌ في عُمومها، أي إنها لم تُبن على نتائج دراساتٍ عِلميةٍ تجريبيَّةٍ مخْبَرِيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللسانيات التشومسكية ","nonDiacriticsLemma":"اللسانيات التشومسكية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللِسانِيّاتُ التُّشُومْسْكِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

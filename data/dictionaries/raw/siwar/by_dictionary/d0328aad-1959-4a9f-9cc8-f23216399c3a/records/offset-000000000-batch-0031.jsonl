{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ff9c15a0-84a2-4526-94f0-78610126901a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ff9c15a0-84a2-4526-94f0-78610126901a","word":"رَقَمٌ أَصْلِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b4a","lexicalEntryId":"ff9c15a0-84a2-4526-94f0-78610126901a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رَقَمٌ أَصْلِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عَدَدٌ رَئيسٌ تُوافِق صِيغَتُه الصيغةَ المستَعمَلةَ في العَدِّ (واحد، اثنان، ثلاثة one, two, three,)، ويمكن الإجابةُ به عن السؤال المبدوءِ بكلمة (كَم) الاستفهامية. ويُقابِله العَدَدُ الترتيبيُّ (الأوّل، الثاني، الثالث first, second, third) راجع:  @(ordinal number) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"رقم أصلي ","nonDiacriticsLemma":"رقم أصلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رَقَمٌ أَصْلِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e9f3ecea-42ab-4886-8ea3-631eabc860f0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e9f3ecea-42ab-4886-8ea3-631eabc860f0","word":"الشِّرْيَانُ السُّبَاتِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b4c","lexicalEntryId":"e9f3ecea-42ab-4886-8ea3-631eabc860f0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الشِّرْيَانُ السُّبَاتِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"شريانٌ في عنُق الإنسانِ يُحقَن بمادَّةٍ خافضَةٍ لنشاط الأعصاب، تُسمّى أميتال الصوديوم؛ لتخدير الجانبِ الأيسَرِ من دماغه؛ للتأكُّد من تأثير هذه المادَّةِ المخدِّرَةِ في النشاط اللغويِّ، وذلك ضِمنَ التجاربِ والمقاييسِ الفسيولوجيةِ التي أجرِيَت على دماغ الإنسانِ لتحديد مناطِقِ اللغةِ فيه. عُرِفت هذه التجربةُ باختبار وَدا Wada Test، نسبةً إلى الجرّاح اليابانيِّ ج. وَدا J. Wada، الذي أجراها ونشَرَها مع زميله راسموسن Rasmussen في كتابٍ صدَر عام 1949م. وفي وَقتنا الحاضِرِ أمكَن تحديدُ وَظائفِ الدِّماغ، وتحديدُ النِّصفِ الذي تتَمَركَز فيه الوَظائفُ اللغوية، باستخدام جِهازَيْ: PET و MRI، وهما جهازان يمثِّلان الأسلوبَ الأمثَلَ لتحديد هذه الوَظائف؛ لدِقَّتِّهما وقِلَّةِ خُطورَتِهما. راجع:  @(Wada Test) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الشريان السباتي ","nonDiacriticsLemma":"الشريان السباتي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null}
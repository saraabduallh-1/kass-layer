{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/29b79fda-844c-4032-99e7-c8f42dd1c1bd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"29b79fda-844c-4032-99e7-c8f42dd1c1bd","word":"جِرِاحَةُ الدِّمَاغِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b54","lexicalEntryId":"29b79fda-844c-4032-99e7-c8f42dd1c1bd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جِرِاحَةُ الدِّمَاغِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُطلَق وصفا على تَشريح الدِّماغِ بعد مَوتِ المصابِ بأمراضٍ لغويةٍ أو نُطقِية، وذلك لأغراض الدراساتِ العلمية، كما يُطلَق وصفا على دراسات جِراحاتِ الدماغِ حين يَتِمُّ فَصلُ جانِبَيْ الدماغِ أو أجزاء منه لأغراضٍ طبيةٍ، تُجرَى خلالها دراساتٌ ترصد ما يحدُث لوَظائف اللغةِ في أدمِغَة المرضى، ومُقارَنة الآثارِ اللغويةِ لما يحدُث في أحَد جانِبَيْ الدماغِ بالآثار التي تحدُث في الجانب الآخَر. وهاتان الوَسيلَتان من الوَسائل التي يتِمُّ بها تحديدُ مناطِقِ اللغةِ ووَظائفِها في الدماغ؛ كملاحَظَة سُلوكِ المرضَى، والاختباراتِ السلوكية، واستِعمالِ المقاييسِ الفسيولوجِية، ونحوِ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جراحة الدماغ ","nonDiacriticsLemma":"جراحة الدماغ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جِرِاحَةُ الدِّمَاغِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

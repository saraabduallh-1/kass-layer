{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/800964e3-6dfc-4d94-bef3-a233010716da/get-public-entry"},"browse_index_record":{"lexicalEntryId":"800964e3-6dfc-4d94-bef3-a233010716da","word":"التَّرْجَمَةُ الوَظِيفِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90ee","lexicalEntryId":"800964e3-6dfc-4d94-bef3-a233010716da","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّرْجَمَةُ الوَظِيفِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على الترجَمة التي تَنقُل المعانيَ المقصودَةَ في اللغة المصدَرِ إلى مَعانٍ مَفهومَةٍ ومتَّفِقَةٍ مع طبيعة اللغةِ الهدَف، دونَ تقيُّدٍ بالصورَة الأصليةِ في اللغة المصدَر. فالمثَلُ الإنجليزيُّ: Make hay while sun shines يُتَرجَم وَظيفيًّا إلى: إذا هَبَّت رياحُك فاغتَنِمْها، بدَلا من ترجَمته حَرفيًّا إلى: اصنَعِ التّْبنَ ما دامَت الشَّمسُ مُشرِقَةً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الترجمة الوظيفية ","nonDiacriticsLemma":"الترجمة الوظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّرْجَمَةُ الوَظِيفِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/aa96da5a-4a0e-4d3e-aab3-7b39e1179dd7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"aa96da5a-4a0e-4d3e-aab3-7b39e1179dd7","word":"وَظَائِفُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90ef","lexicalEntryId":"aa96da5a-4a0e-4d3e-aab3-7b39e1179dd7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَظَائِفُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الوَظائفُ الأساسُ التي تُؤدِّيها اللغةُ، وفقا لما يراه كثيرٌ من اللغويين، أو وفقا لنظرية هاليداي. راجع:  @(functions of language) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]},{"definition":"الوَظائفُ التي تؤدِّيها اللغةُ، وفقا لنَظرية هاليداي. وهي ثلاثٌ: تفكيريةٌ وشَخصيةٌ ونصِّيَّةٌ.  فالوَظيفةُ التفكيريةُ أو الفِكرِيةُ ideational function تَعني استعمالَ اللغةِ في أثناء التفكيرِ أو تنظيمَ المعلوماتِ في الذِّهن قبلَ إخراجِها مَنطوقَةً أو مَكتوبَةً، وتتمثَّل في التعبير عن خِبرَة المتكلِّمِ بعالَم الواقِع. والوَظيفةُ الشَّخصيةُ interpersonal function تَعني استعمالَ اللغةِ بين شخصَين، أو استغلالَها لبناء علاقَةٍ بين شخصَين أو للمُحافَظَة عليها. والوَظيفةُ النَّصِّيَّةُ textual function تعني إنشاءَ نَصٍّ مَنطوقٍ أو مَكتوبٍ مُتماسِكِ الأفكار، ومناسِبٍ للمقام. ويُطلَق عليها أيضا  language functions.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وظائف اللغة ","nonDiacriticsLemma":"و
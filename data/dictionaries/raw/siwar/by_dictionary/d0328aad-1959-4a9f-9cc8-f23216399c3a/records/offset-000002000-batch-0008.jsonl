{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e4db8850-22f5-451e-b910-edc065f4d346/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e4db8850-22f5-451e-b910-edc065f4d346","word":"تَدْرِيبٌ رُبَاعِيُّ الخُطُواتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90e9","lexicalEntryId":"e4db8850-22f5-451e-b910-edc065f4d346","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيبٌ رُبَاعِيُّ الخُطُواتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تعليميٌّ، يُطلَق على تَدريبٍ لغويٍّ شَفَهيٍّ يُجرَى على النَّمَط المرادِ تدريسُه في مَعمَل اللغةِ عادةً. يَمُر إجراؤه بأربَع خطواتٍ، هي: إثارةٌ تُصدرِها المادةُ المسجَّلَةُ، وفُرصَةٌ زمنية كافيةٌ للطالب للإجابَة، وتَعزيزٌ للإجابة الصحيحةِ يَصدُر من الشريط المسَجَّل، وتَكرارُ الطالبِ أو الصَّفِّ الإجابةَ الصحيحةَ المسموعةَ من الشريط. وقد يُجرَى التدريبُ في الفَصل من المعلِّم مباشرَةً مثلما يُجرى من شَريطٍ مسجَّل، يَسيرُ المعلِّمُ فيه وفقَ الخطواتِ السابقة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريب رباعي الخطوات ","nonDiacriticsLemma":"تدريب رباعي الخطوات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيبٌ رُبَاعِيُّ الخُطُواتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

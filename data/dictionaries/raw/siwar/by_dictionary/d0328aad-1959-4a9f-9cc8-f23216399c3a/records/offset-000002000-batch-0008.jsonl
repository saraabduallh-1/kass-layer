{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6b489077-5548-40e3-89d8-8071772047bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6b489077-5548-40e3-89d8-8071772047bf","word":"وَصْفٌ وَظِيفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90fa","lexicalEntryId":"6b489077-5548-40e3-89d8-8071772047bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَصْفٌ وَظِيفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في النحو الوَظيفيِّ functional grammar، يَعني وَصفَ وَظائفِ أركانِ الجُملةِ ممثَّلَةً في شَكل مجموعَةٍ من المحاوِر التي تَنتَظِم على كلِّ محوَرٍ منها مجموعةٌ من الوَظائف التي تُناظِر مكوِّناتِ الجُملةِ صراحةً أو ضِمنًا بالتقدير. فالاسمُ مثلا قد تكون وَظيفتُه فاعلَ الفعلِ، وقد تكون مفعولَ الفعل، وقد يكون مَذكورًا صراحةً أو مُقدَّرًا، كفاعل جُملةِ الأمرِ مثلًا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في النحو المعجَميِّ الوظيفيِّ lexical-functional grammar، يُشير إلى مجموعَة مُعادَلاتٍ تركيبيةٍ ومُعادَلاتٍ معجَميةٍ تُحَدِّد بنيةَ الخصائص النحويةِ للجُملة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وصف وظيفي ","nonDiacriticsLemma":"وصف وظيفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَصْفٌ وَظِيفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/32ee03d5-08c9-4493-8c11-15a30098866c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"32ee03d5-08c9-4493-8c11-15a30098866c","word":"نَظَرِيَّةُ النَّحْوِ الوَظِيفِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90fb","lexicalEntryId":"32ee03d5-08c9-4493-8c11-15a30098866c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ النَّحْوِ الوَظِيفِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويةٌ عامّةٌ ظهَرت في السبعينيات من القرن العشرين، وجَمَعت بين العوامِل الخارِجيةِ والدَّاخليةِ للُّغة؛ فعُنِيَت بالمفهوم العمَليِّ الواقِعِيِّ للُّغة الذي يظهَر في التفاعُل الاجتماعيِّ من ناحيَة، وبالنحو والدّلالَةِ والأصواتِ الوَظيفيةِ من ناحيَةٍ أخرى. لهذا تُعَدّ في نظَر كثيرٍ من اللغويِّين ردًّا على النظريات والآراءِ اللغويةِ الموغِلَةِ في التَّجريد، ولاسيّما النظرياتُ والآراءُ التي نادى بها التوليديون التحويليون.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية النحو الوظيفي ","nonDiacriticsLemma":"نظرية النحو الوظيفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ النَّحْوِ الوَظِيفِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b7f02efb-a948-439d-b20d-aecec06f9f0a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b7f02efb-a948-439d-b20d-aecec06f9f0a","word":"اللِّسَانِيَّاتُ الوَظِيفِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90fc","lexicalEntryId":"b7f02efb-a948-439d-b20d-aecec06f9f0a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللِّسَانِيَّاتُ الوَظِيفِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرعٌ من علم اللغة؛ يَدرس اللغةَ بوَصفها أداةً للتواصُل الاجتماعي، لا نظامًا تركيبيًّا منعَزِلًا، ويهتَمُّ بالوَسائل والأدواتِ التي يستَخدِمها الفَردُ في اكتساب اللغةِ والتواصُلِ بها مع الناس في المجتَمَع. يَتميَّز هذا الفَرعُ أو المنهَجُ عن غيره من المناهِج اللِّسانيةِ بتأكيده أنّ الأبنيَةَ الصوتيةَ والتركيبيةَ والدّلاليةَ مَحكومَةٌ بالوَظائف التي تؤدِّيها في المجتَمَعات التي تعمَل فيها، وفي هذا خُروجٌ عن المبدأ الذي أرساه دي سوسير، وتَبِعَه البنيَوِيُّون، من أن الأبنيَةَ اللغويةَ يجب أن تُدرَس لذاتها بعيدا عن العناصِر الخارِجَةِ عن النِّظام اللغوي. اهتَمَّت مدرسةُ براغ Prague School بهذا الفَرعِ من علم اللغةِ في العشرينيات من القرن العشرين، ثم طوَّرَه جون فيرث John Firth في الأربعينيات والخمسينيات منه، ثم تَبَعه هاليداي Halliday، حتى ظَهَر هايمز Hymes الذي اشتَقَّ منه الكِفايَةَ التواصُليةَ communicative competence وطَبَّقَها في تعليم اللغاتِ الأجنبية. والنحوُ الوَظيفيُّ Functional Grammar، الذي طوَّرَة سيمون ديك Simon C. Dik في أواخِر السبعينياتِ من القرن العشرين، يُعَدُّ أبرَزَ جوانبِ علمِ اللغةِ الوَظيفيِّ. أما أبرَزُ تطبيقاتِ هذا الفَرعِ أو المنهَجِ فقد ظَهَر جَليًّا في تفسير اكتسابِ الطفلِ لغتَه الأمَّ؛ حيث اتَّخَذ منهَجا وَسَطا بين التفسيرِ البِنيَوِيِّ السُّلوكيِّ الذي يرى أن البيئةَ المحيطَةَ بالطفل هي العامِلُ الأوّلُ في بناء لغتِه، والتفسيرِ الفِطرِيِّ الذي يرى أن الجانِبَ الفِطرِيَّ هو العامِلُ الأوّلُ في ذلك. فالتفسيرُ الوَظيفيُّ لاكتِساب اللغةِ يعتَمِد على التَّفاعُل بين هذه العوامِلِ مجتَمِعَةً، ويؤكد أن التأثيرَ الفِطرِيَّ يَنحَصِر فيما لا يمكن أن يُفسَّر بالعوامِل البيئيَّةِ والتواصُلية. راجع:  @(Functional Grammar) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللسانيات الوظيفية ","nonDiacriticsLemma":"اللسانيات الوظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللِّسَانِيَّاتُ الوَظِيفِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c41e15a8-1b55-40ac-974e-6479d65149ff/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c41e15a8-1b55-40ac-974e-6479d65149ff","word":"عِبْءٌ وَظِيفِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90fd","lexicalEntryId":"c41e15a8-1b55-40ac-974e-6479d65149ff","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِبْءٌ وَظِيفِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَدَى الأهميةِ الوَظيفيةِ للتَّحليل التَّقابُليِّ contrastive analysis بين وَحدَتَين لغويَّتَين؛ إذ إن هذا التقابُلَ ليس على درَجَة واحدةٍ من الأهميَّة الوَظيفيةِ في جميع اللغاتِ أو جميعِ الحالاتِ في اللغة الواحدة. فالفَرقُ بين صوتَي: /p/ و /b/ في بدايَة الكلمةِ الإنجليزيةِ مثلا يؤدِّي إلى التَّفريق بين عَدَدٍ كبيرٍ من الكلمات الإنجليزية، أي إنه يحمِل عِبئًا وَظيفيًّا عالِيًا، خِلافا للفَرق بين صوتَي:  /th/و  /th/في كلمتَي: wreathe, wreath على التوالي، الذي لا يحمِل إلا عِبئًا وَظيفِيًّا ضَعِيفا. ويُسمّى هذا العِبءُ أيضا المردُودَ الوَظيفِيَّ functional yield.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عبء وظيفي ","nonDiacriticsLemma":"عبء وظيفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِبْءٌ وَظِيفِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/83375359-fc16-4c3e-9366-496656480ae6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"83375359-fc16-4c3e-9366-496656480ae6","word":"العَلاقَاتُ الوَظِيفِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90fe","lexicalEntryId":"83375359-fc16-4c3e-9366-496656480ae6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"العَلاقَاتُ الوَظِيفِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في النحو الوَظيفيِّ، يُشير إلى أحَدِ المبادئِ الأساسيةِ التي تؤدِّي وَظيفَةً مهمَّةً في التنظيم النحوي، حيث يُمَيَّز بين ثلاثةِ مستوَياتٍ أساسيةٍ من الوَظائف، هي: الوَظائفُ الدّلاليةُ semantic functions، والوَظائفُ التركيبيةُ أو النحويةُ syntactic functions، والوَظائفُ التداوليةُ pragmatic functions. والعلاقةُ الوَظيفيةُ تَعني علاقةَ العنصُرِ اللغويِّ بغيره من حيث ما يؤدِّيه من وَظيفةٍ في التركيب؛ كعلاقة الكلمةِ الواقِعَةِ فاعِلًا بالكلمة الواقِعَةِ فِعلًا، وعلاقةِ الكلمةِ الواقِعَةِ فِعلًا بالكلمة الواقِعَةِ مَفعولًا به، وهكذا، خِلافا للعلاقة التَّصنِيفِية، كما في تقسيم الكلمةِ العربيةِ مثلًا إلى: اسمٍ، وضميرٍ، وفِعلٍ، وحَرفٍ، ونحوِ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"العلاقات الوظيفية ","nonDiacriticsLemma":"العلاقات الوظيفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"العَلاقَاتُ الوَظِيفِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

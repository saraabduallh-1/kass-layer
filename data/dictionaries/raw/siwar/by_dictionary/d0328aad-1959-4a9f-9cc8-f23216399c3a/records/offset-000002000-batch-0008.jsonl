{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/76367284-501b-4ca1-be1c-70bba28d2fc7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"76367284-501b-4ca1-be1c-70bba28d2fc7","word":"القُدْرَةُ المَعْرِفِيَّةُ العَامَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9100","lexicalEntryId":"76367284-501b-4ca1-be1c-70bba28d2fc7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"القُدْرَةُ المَعْرِفِيَّةُ العَامَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"القُدرةُ أو القُدراتُ العَقليةُ العامَّةُ لدى الفَرد؛ كالقُدرَة على حَلِّ المشكلات، والقُدرَةِ على التخطيط واستِخلاصِ النتائجِ بطريقةٍ منطِقيّة. ويَدخُل ضِمنَ هذه القُدرَةِ أو القُدراتِ المعرِفيةِ العامَّةِ المعرِفَةُ اللغويةُ، إذ تُعَدُّ اللغةُ قُدرَةً عَقلِيّةً عُليا ضِمنَ القُدرَةِ المعرفيّةِ العامَّةِ، بيدَ أنها من أهمِّ هذه القدراتِ أو هي أهمُّها؛ لارتباطها بوَظيفة التواصُلِ، التي هي أبرَزُ خصائصِ الإنسان، حتى إن بعضَ اللغويِّين يرَون أن عَدَمَ قُدرَةِ المخلوقاتِ غيرِ البشَريةِ على استعمال اللغةِ يعود إلى فقد هذه القدرَةِ المعرفيّةِ العامَّة. ومن اللغويِّين من يرى أن القُدرةَ اللغويّةَ مرتَبِطةٌ بالقدرَة أو القُدراتِ المعرفيّةِ العامَّة، لكنها قُدرَةٌ مستَقِلَّةٌ في طبيعتها ووَظيفَتِها ونُمُوِّها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"القدرة المعرفية العامة ","nonDiacriticsLemma":"القدرة المعرفية العامة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"القُدْرَةُ المَعْرِفِيَّةُ العَامَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/433d3b74-242d-4fa9-8be2-780c0c5c1503/get-public-entry"},"browse_index_record":{"lexicalEntryId":"433d3b74-242d-4fa9-8be2-780c0c5c1503","word":"الكُلِّيَّاتُ الشَّكْليَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9101","lexicalEntryId":"433d3b74-242d-4fa9-8be2-780c0c5c1503","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الكُلِّيَّاتُ الشَّكْليَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في الكليات اللغويةِ language universals، استَعمَله تشومسكي في الستينيات من القرن العشرين، ويُقصَد به الشروطُ الضرورِيةُ التي يجب أن تتضَمَّنَها أبنيَةُ اللغة، بما فيها المكوِّنات، وأنواعُ القواعد، وترتيبُ الكلمات. والكُلِّيَّاتُ الشَّكليةُ تُقابِلها الكُلِّيَّاتُ المادِّيَّةُ substantive universals، والفَرقُ بينهما مَبنِيٌّ على الفَرق بين المادَّةِ والشَّكلِ أو الصِّيغَة. راجع:  @(language universals) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الكليات الشكلية ","nonDiacriticsLemma":"الكليات الشكلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الكُلِّيَّاتُ الشَّكْليَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

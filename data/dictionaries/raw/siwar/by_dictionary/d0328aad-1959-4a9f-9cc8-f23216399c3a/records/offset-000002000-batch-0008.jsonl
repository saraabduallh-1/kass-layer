{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0af29461-2348-4a8a-a44e-ec1c3b9db112/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0af29461-2348-4a8a-a44e-ec1c3b9db112","word":"مِعْيارُ الشُّيُوعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b90ec","lexicalEntryId":"0af29461-2348-4a8a-a44e-ec1c3b9db112","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مِعْيارُ الشُّيُوعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المعيارُ الذي يَعتَمِد عليه الباحثُ، أو مُعِدُّ المادةِ التعليميةِ في تعليم اللغة، في عَدِّ الكلمةِ شائعَةً أو غيرَ شائعَةٍ. وهو رَقمٌ يَضَعُه الباحثُ أو المؤلِّفُ ويَلتَزِم به؛ كأن يكون ترَدُّدُ الكلمةِ في النَّصِّ الواحدِ سبعَ مرّاتٍ - مثلاً - كافيًا لعَدِّها شائعَةً، وما قَلَّ عن ذلك لا يُعَدُّ شائعًا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلَحٌ لغويٌّ تعليميٌّ، يُقصَد به اعتِمادُ الشُّيوعِ مِعيارًا لاختيار الموادِّ التعليميةِ في تعليم اللغةِ الهَدَف، أي إعطاءُ الكلماتِ الشائعَةِ أولَوِيَّةً في اختيار مفرَداتِ اللغةِ الهَدَف، وتَنظيمِها، وتقديمِها، في النُّصوص المقرَّرةِ على الطلاب.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معيار الشيوع ","nonDiacriticsLemma":"معيار الشيوع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مِعْيارُ الشُّ
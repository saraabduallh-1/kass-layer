{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/aba0d631-9a94-4b94-bfd6-6c4cc4089cef/get-public-entry"},"browse_index_record":{"lexicalEntryId":"aba0d631-9a94-4b94-bfd6-6c4cc4089cef","word":"لَهْجَةٌ مَغْرُوسَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0bd","lexicalEntryId":"aba0d631-9a94-4b94-bfd6-6c4cc4089cef","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لَهْجَةٌ مَغْرُوسَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أيُّ لغةٍ أو لهجَةٍ هاجَرَت واستَقَرَّت في بيئةٍ أو منطقَةٍ جغرافيّةٍ جديدَةٍ بعيدَةٍ عن مَوطِنها الأصليِّ، أي لم تكُن مجاوِرَةً لبيئتها الجديدَة، تُسمى أحيانا لغةً أو لهجَةً مُصدَّرَةً transported language/dialect. من أمثلَة هذه الظاهِرَةِ لغَةُ الآمِش Pennsylvania Dutch/Deutsch، وهي لَهجَةٌ ألمانيةٌ استَقَرّت مع الآمِش Amish في مناطِق من أمريكا الشّمالية، والفرنسيةُ في أقليم كِيبِك الكَنَدِي، والإنجليزيةُ في عدَدٍ من المستَعمَرات البريطانيةِ السّابِقَة. وقريبٌ من ذلك العربيةٌ في عُصُور الفُتوحاتِ الإسلاميةِ خارِجَ الجزيرَةِ العربية، بَيدَ أن العربيةَ أصبَحَت بمرور الزَّمَنِ اللغةَ الأمَّ واللغةَ الأولى أو الرَّسميةَ في كثيرٍ من تلك البِلاد، كالعِراق والشّامِ ومِصرَ ودوَلِ شَمالِ أفريقيا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لهجة مغروسة ","nonDiacriticsLemma":"لهجة مغروسة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لَهْجَةٌ مَغْرُوسَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8cdb6da3-7871-4933-943d-44ce42ebd16d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8cdb6da3-7871-4933-943d-44ce42ebd16d","word":"النَّحْوُ الكُلِّيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0be","lexicalEntryId":"8cdb6da3-7871-4933-943d-44ce42ebd16d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوُ الكُلِّيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ اقتَرَحَها وطَوَّرها نوم تشومسكي Noam Chomsky، ضِمنَ نظريتِه اللغويةِ المَعرِفيَّةِ الفِطرِيَّة، وتُعَرَّف بأنها: مجموعةُ القواعدِ والقوانينِ والمبادئِ العامَّةِ التي تَشتَرِك فيها معظمُ اللغات، ولا تختَصُّ بها لغةٌ معيَّنة. هذه القواعدُ مَوجودَةٌ في عُقول جميعِ الأطفال، يَكتَسبونها بشَكلٍ طبيعيّ، وتَنمو معهم بصورَةٍ متَشابِهَة، مهما اختَلَفَت لغاتُهم وتبايَنَت بيئاتُهم وثقافاتُهم. تؤكِّد هذه النظريةُ أن أيَّ ناطِقٍ بلغةٍ ما يَملِك كفايَةً في لغته ولو لم يتعلَّم قواعدَها وقوانينَها بشَكل نظريٍّ مباشِر. تتضَمَّن هذه الكِفايَةُ معرفةَ المرءِ بالمبادئ principles التي تَنطَبِق على جميع اللغات، ومعرِفَتِه بالمحدّدات parameters التي تختَلِف من لغةٍ إلى أخرى في حُدودٍ ضيِّقَة. ويرَى صاحب هذه النظرية أن اكتسابَ المرءِ لغتَه الخاصَّة، كالعربية أو الإنجليزيةِ أو الفرنسية، يَتمُّ بتَطبيق مبادئِ القواعدِ الكُلِّيَّةِ على لغته، وتعلُّمِ ما يناسِب كلَّ متغيِّرٍ منها. ويَرَى كثيرٌ من اللغويين أن معظمَ مبادئِ القواعدِ الكُلِّيَّةِ تَنطبِق على اكتِساب اللغةِ الثانية، أو يمكن تَفسيرُها على أساسٍ من هذه القواعد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النحو الكلي ","nonDiacriticsLemma":"النحو الكلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّحْوُ الكُلِّيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c1b6a404-4804-49c5-a976-da8f4b69373d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c1b6a404-4804-49c5-a976-da8f4b69373d","word":"نِظَامُ الفَهْمِ الآلِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0bf","lexicalEntryId":"c1b6a404-4804-49c5-a976-da8f4b69373d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نِظَامُ الفَهْمِ الآلِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، يُشير إلى نظامٍ أو جهازٍ حاسوبيٍّ متكامِلٍ ببرامِجَ ومُعدّاتٍ خاصةٍ، يجمَع بين مُعالَجَةِ اللغاتِ الطبيعيةِ والمعالَجَةِ الصوتيةِ والسَّمعية؛ إذ يُمكِنه فَهمُ الكلامِ البَشَرِيِّ آلِيًّا. والمكوِّناتُ الأساسيةُ لهذا النظامِ هي: المحلِّلُ الصوتيُّ phonological analyzer، والمحلِّلُ الصرفيُّ morphological analyzer، والمحلِّلُ المعجَميُّ lexical analyzer، والمحلِّلُ التركيبيُّ syntactical analyzer ، والمحلِّلُ الدّلاليُّ semantic analyzer، والمحلِّلُ التداوليُّ pragmatic analyzer.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظام الفهم الآلي ","nonDiacriticsLemma":"نظام الفهم الآلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نِظَامُ الفَهْمِ الآلِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8a5e868e-f789-492e-9375-2f18530cab12/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8a5e868e-f789-492e-9375-2f18530cab12","word":"لُغَةُ الوِحْدَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0c0","lexicalEntryId":"8a5e868e-f789-492e-9375-2f18530cab12","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةُ الوِحْدَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم اللغةِ السياسيِّ والتَّخطيطِ اللغوي، يُشير إلى لغةٍ موَحَّدَةٍ منتَقاةٍ من لَهَجاتٍ أو لُغاتٍ متَجاوِرَة، الهَدَفُ منها جَمعُ أبناءِ الوَطَنِ الواحدِ أو الأمَّةِ الواحِدَةِ على لغةٍ واحدة، لأهدافٍ وَطَنيّةٍ أو دينيّةٍ أو سياسيّةٍ أو اجتِماعيّةٍ أو اقتصاديّةٍ أو تواصُليّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة الوحدة ","nonDiacriticsLemma":"لغة الوحدة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةُ الوِحْدَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/70ef7627-b4db-4b19-9473-fb5266060fd0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"70ef7627-b4db-4b19-9473-fb5266060fd0","word":"نِظَامُ الوحْدَاتِ المُتَكَامِلَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0c1","lexicalEntryId":"70ef7627-b4db-4b19-9473-fb5266060fd0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نِظَامُ الوحْدَاتِ المُتَكَامِلَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظامٌ لتعلُّم اللغاتِ وتعليمِها طوَّرَه المجلسُ الأورُوبي؛ تُصنَّف فيه أهدافُ برامجِ تعليمِ اللغاتِ الأجنَبيّةِ إلى وحدات، كل وحدةٍ منها تمثِّل مجموعةً مختارةً من حاجات المتعلِّم، وتَرتَبط بالوحدات الأخرى في البرنامج. ويَتسلَّم المتعلِّمُ شهادة رَسميّة كلَّما اجتاز وحدةً من هذه الوحدات. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظام الوحدات المتكاملة ","nonDiacriticsLemma":"نظام الوحدات المتكاملة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نِظَامُ الوحْدَاتِ المُتَكَامِلَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/766b6a5f-b562-401e-a2ff-275547016e55/get-public-entry"},"browse_index_record":{"lexicalEntryId":"766b6a5f-b562-401e-a2ff-275547016e55","word":"الآلِيّاتُ المَعْرِفِيَّةُ الكُلِّيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0c2","lexicalEntryId":"766b6a5f-b562-401e-a2ff-275547016e55","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الآلِيّاتُ المَعْرِفِيَّةُ الكُلِّيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اكتِساب اللغة، يُشير إلى الآلِيَّة العَقليّةِ التي يرَى المعرِفيّون الفِطرِيّون أنها تتحكَّم في اكتِساب الطفلِ لغَتَه الأمَّ، وتتحكَّم أيضا في اكتِساب الصغيرِ والكبيرِ اللغةَ الثانيةَ. هذه الآليّاتُ يَشتَرك فيها جميعُ أطفالِ العالَم ومتعلِّمي اللغات، على اختِلاف لغاتِهم وتَبايُنِ ثقافاتِهم وتَباعُدِ بيئاتِهم، وهي التي تفسِّر التَّدرَّجَ الطبيعيَّ الذي يَسير عليه هؤلاء الأطفالُ والمتعلِّمون.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الآليات المعرفية الكلية ","nonDiacriticsLemma":"الآليات المعرفية الكلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الآلِيّاتُ المَعْرِفِيَّةُ الكُلِّيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4902072d-f684-45f5-b5ef-11747ebfc324/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4902072d-f684-45f5-b5ef-11747ebfc324","word":"الطَّرَائقُ التَّقْلِيدِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0c3","lexicalEntryId":"4902072d-f684-45f5-b5ef-11747ebfc324","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطَّرَائقُ التَّقْلِيدِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يُطلَق على بعض الطرائقِ القَديمةِ في حَقل تعليمِ اللغاتِ الأجنبيةِ، التي لا تَستَنِد إلى نظرياتٍ ومذاهبَ في علم اللغةِ أو علمِ النفس، وإنما تَوَارَثَها الناسُ واعتادوا استِعمالَها، وخَيرُ ما يمثِّل هذه الطرائقَ طريقةُ القواعدِ والترجمة. بَيدَ أن بعضَ الطرائقِ التي كانت تُعَدُّ حديثةً أصبَحَت الآنَ قديمةً، ووُصِفَت بأنها طرائقُ تَقليدِية، كالطريقَة السَّمعيةِ الشَّفَهية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الطرائق التقليدية ","nonDiacriticsLemma":"الطرائق التقليدية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطَّرَائقُ التَّقْلِيدِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9a33f658-745e-4e8e-a0d9-15d84ccba077/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9a33f658-745e-4e8e-a0d9-15d84ccba077","word":"انْتِقَالُ أَثَرِ التَّعَلُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0c4","lexicalEntryId":"9a33f658-745e-4e8e-a0d9-15d84ccba077","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"انْتِقَالُ أَثَرِ التَّعَلُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أن يُؤثِّر تعلُّمٌ سابِقٌ في تعلُّم لاحِق؛ كانتِقال أَثَرِ اللغةِ الأمِّ إلى اللغة الهَدَف، وانتِقالِ أَثَرِ تعلُّمِ الاستِماع إلى الكلام، وانتِقالِ أَثَرِ تعلُّمِ القراءةِ إلى الكتابة، وهو نوعان: سَلبيٌّ، وإيجابيٌّ. بُنِي على النَّوع الإيجابيِّ - داخِلَ مهاراتِ اللغةِ الهَدَفِ - بعضُ طرائقِ التدريس، أهمُّها طريقةُ القراءةِ The Reading Method، حيث يرَى أصحابُها أن إتقانَ المتعلِّم مهارةَ القراءةِ في اللغة الهَدَف، مع قدرَتِه على فَهم المعنى من النُّصوص المكتوبةِ، وَسيلةٌ لإتقان المهاراتِ الأخرى في اللغة. راجع:  @(transfer) و  @(transfer of training) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"انتقال أثر التعلم ","nonDiacriticsLemma":"انتقال أثر التعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"انْتِقَالُ أَثَرِ التَّعَلُّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__
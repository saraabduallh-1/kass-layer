{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fa59217b-9dd0-452d-85c3-22085107ccf0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fa59217b-9dd0-452d-85c3-22085107ccf0","word":"مَدَاخِلُ التَّرْجَمَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0c6","lexicalEntryId":"fa59217b-9dd0-452d-85c3-22085107ccf0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَدَاخِلُ التَّرْجَمَةِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"المذاهِبُ والاتجاهاتُ التي تَنطَلِق منها الترجَمة؛ كالمدخَل اللِّسانيّ، والمدخَلِ الاجتماعيّ، والمدخَلِ التَّوَاصُلِيّ، والمدخَلِ الفَلسَفيّ، والمدخَلِ الثقافيّ، والمدخَلِ الأيديولوجيّ، والمدخَلِ الفَنِّيِّ أو الأدَبيّ، والمدخَلِ النَّصِّيّ، والمدخَلِ التَّدَاوُليّ. ويختَلِف أسلوبُ الترجَمةِ بحسب المدخَلِ أو الفَلسَفةِ التي ينطَلِق منها المترجِمُ؛ فالمدخَلُ اللِّسانيّ مثلا يرَى أصحابه أن الترجمةَ عمَليةٌ لغويةٌ في الأصل، ويختَلِف أيضا باختِلاف النظريةِ اللغويةِ، كالبنيَوية والتوليدِيةِ والوَظيفيةِ وغيرِها، بل إن في كل مدخَلٍ أو اتجاهٍ نماذِجَ يتميَّز بعضُها من بعض؛ ففي المدخَل اللِّسانيّ مثلا، يُلحَظ أن الأنموذَجَ البِنيَوِيَّ يُعنَى بالعَلاقات التركيبيةِ بين الأنظِمَة، في حين يهتَمّ الأنموذَجُ النَّصِّيُّ بالمواقِف التواصُلية، أما الأنموذَج اللِّسانيُّ النَّفسيُّ الإدراكيُّ فيركِّز على العمَليات الذِّهنِيةِ في الترجمة، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَصفٌ يُطلَق على المناهِج والأساليبِ والأنماطِ التي تَشيع في الترجَمَة؛ كترجَمة كلِمَةٍ بكَلِمَةٍ word-for-word translation، والترجَمةِ الحَرفِيّةِ literal translation، والترجَمةِ الحُرّةِ free translation، والترجَمةِ الدلاليّة semantic translation.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مداخل الترجمة ","nonDiacriticsLemma":"مداخل الترجمة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَدَاخِلُ التَّرْجَمَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

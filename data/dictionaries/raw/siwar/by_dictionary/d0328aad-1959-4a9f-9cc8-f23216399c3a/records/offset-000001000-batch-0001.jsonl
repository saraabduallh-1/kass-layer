{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/54dff784-8813-4c04-b869-4710e7153e66/get-public-entry"},"browse_index_record":{"lexicalEntryId":"54dff784-8813-4c04-b869-4710e7153e66","word":"صِدْقُ المُحْتَوَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c61","lexicalEntryId":"54dff784-8813-4c04-b869-4710e7153e66","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صِدْقُ المُحْتَوَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الصِّدقُ المنهَجِيُّ، وهو نوعٌ من أنواع الصِّدقِ الذي هو أحَدُ شُروطِ الاختِبارِ الجيِّد. ويُقصَد به أن يَعكِس الاختِبارُ ما وُضِع من أجله بدقَّة، فيَقِيس ما يجب أن يَقِيسَه. فإذا كان الاختِبارُ تَحصيلِيا فيَجب أن يركِّز على المحتَوَى الذي دَرَسَه الطلابُ من الكتاب المقرَّرِ عليهم، وأن تُوزَّع الأسئلةُ عليه تَوزيعا عادِلا؛ فلا يُقتَصَر على جوانب من المقرَّر، وتُغفَل جوانبُ أخرى منه. وإذا كان الاختبارُ لقِياس صِحَّةِ نُطقِ الأصواتِ مثلا، فيَجب أن يَشمل نُطقَ الأصواتِ بأنواعها: القِطْعِية وفَوقَ القِطْعِية، في كلماتٍ وسياقاتٍ مختَلِفة؛ فلا يُقتَصَر على نوعٍ من الأصوات، أو على نُطقها منعَزِلَةً عن بيئتها. وإذا كان اختبارَ كِفايَةٍ فيَجب أن يَشمل جميعَ مهاراتِ اللغةِ وعناصِرِها؛ فلا يرَكِّز على مقرَّرٍ أو موادَّ تعليميةٍ محدَّدَة. راجع:  @(validity) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صدق المحتوى ","nonDiacriticsLemma":"صدق المحتوى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01
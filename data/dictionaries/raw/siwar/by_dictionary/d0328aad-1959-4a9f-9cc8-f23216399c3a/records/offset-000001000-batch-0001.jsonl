{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a8b27ed1-52d3-4ee8-8104-a53589dbd3c3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a8b27ed1-52d3-4ee8-8104-a53589dbd3c3","word":"التَّدْرِيسُ بمُسَاعَدَةِ الحَاسُوبِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c5a","lexicalEntryId":"a8b27ed1-52d3-4ee8-8104-a53589dbd3c3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّدْرِيسُ بمُسَاعَدَةِ الحَاسُوبِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"استِعمالُ الحاسوبِ في برامج التعليم، لاسيَّما تعليمُ اللغات، ويَتِم بأشكالٍ مختَلِفةٍ منها: تعليمُ اللغةِ المبرمَجِ الذي يَعتَمِد على التدريس الفَردِيِّ المناسِبِ لكلِّ طالبٍ مع الإرجاعِ المناسِبِ في كل خطوَة، والتدرَّجِ معه بحسب نتائجِه في كل دَرس. ومنها التدريسُ الحاسوبيُّ الذي يُراقِب تَقَدُّمَ الطالبِ ويوجِّهُه إلى المواد التعليميةِ المناسِبةِ له. وقد يَشمل جميعَ أساليبِ التدريسِ بالحاسوب؛ كإعداد الموادِّ التعليمية، وتَنظيمِها وعَرضِها، والأنشطةِ الصَّفِّيَّةِ، والاختباراتِ، وغيرِها. ويتعامَل الحاسوبُ مع مَضمون المادَّةِ التعليميةِ والأسئلةِ والإجاباتِ التي يوَجِّهُها المتعلِّمُ إليه. ويختلف التَّدرِيسُ بمُساعَدَة الحَاسُوبِ عن علم اللغةِ الحاسُوبِيِّ computational linguistics على الرَّغم من أن الأولَ يَتضَمَّن بعضَ تَطبيقاتِ الثاني.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التدريس بمساعدة الحاسوب ","nonDiacriticsLemma":"التدريس بمساعدة الحاسوب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّدْرِيسُ بمُسَاعَدَةِ الحَاسُوبِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

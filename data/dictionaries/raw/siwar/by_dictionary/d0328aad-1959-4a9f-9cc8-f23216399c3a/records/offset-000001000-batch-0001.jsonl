{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/15496936-c02a-46a6-b511-8f76aa98288b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"15496936-c02a-46a6-b511-8f76aa98288b","word":"قَوَاعِدُ غَيرُ سِيَاقِيَّةٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c58","lexicalEntryId":"15496936-c02a-46a6-b511-8f76aa98288b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَوَاعِدُ غَيرُ سِيَاقِيَّةٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قواعدُ التركيبِ العِبارِيِّ للجُملة، تَسمَح بإحلال مكوِّناتٍ محَلَّ مكوِّناتٍ أخرى إذا كانت من النوع نفسِه، باعتبار أن كلَّ مكوِّنٍ في الجُملة مستَقِلٌّ عن المكوِّنات الأخرَى وغيرُ متَأثِّرٍ بها. وهذه القواعدُ لا تتَعَرَّف القُيُودَ التركيبيةَ التي توجَد بين المكوِّنات، مثلُ القاعدةِ: S→NP VP  التي تُنتِج جُمَلا صحيحةً نحويا قد تكون مُفيدَةً أو غَيرَ مُفيدَةٍ سياقيا، وتُنتِج أيضا جُمَلا غيرَ صحيحةٍ نحويا. ويَقِلُّ استِعمالُ هذه القواعدِ في اللغة الطبيعيةِ، لكنه يَشِيع في إعراب جُمَلِ بَرامِجِ الحاسوبِ للترجَمَة التركيبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قواعد غير سياقية ","nonDiacriticsLemma":"قواعد غير سياقية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَوَاعِدُ غَيرُ سِيَاقِيَّةٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

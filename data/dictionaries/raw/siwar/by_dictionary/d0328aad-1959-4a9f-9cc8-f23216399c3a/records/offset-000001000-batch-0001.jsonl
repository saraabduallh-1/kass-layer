{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/89131166-5c87-4d8e-b8be-27ae8a0d20bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"89131166-5c87-4d8e-b8be-27ae8a0d20bf","word":"ثُنائِيَّةٌ لُغَوِيَّةٌ مُرَكَّبَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c67","lexicalEntryId":"89131166-5c87-4d8e-b8be-27ae8a0d20bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ثُنائِيَّةٌ لُغَوِيَّةٌ مُرَكَّبَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ جانِبَي النظريةِ التي تُفسِّر نَظرَةَ ثُنائيِّ اللغةِ إلى المعنى في كلٍّ من لغته الأمِّ ولغتِه الثانية، تُسمى أيضا بالثُّنائية اللغويةِ المتَجانِسَة. فالثُّنائيةُ المركَّبةُ تَرَى أن ثُنائيَّ اللغةِ لدَيه نظامٌ واحدٌ للمعنى في اللغَتَين؛ فكلمةُ: (خُبْزٌ) في العربية وكلمةُ: bread في الإنجليزية تدُلان في ذهنه على مَدلولٍ واحد. أما الجانبُ الآخَرُ لهذه الثُّنائيةِ فتُمَثِّله الثُّنائيةُ المتَخَالِفَةُ التي تَعني أن لدَى ثُنائيِّ اللغةِ معنَيَين مختلِفَين لكلِّ شيء: معنى في لغته الأمِّ، ومعنى آخَرُ مختَلِفٌ في اللغة الثانية. وكان التَّميِيزُ بين النوعَين مُهِمّا في دراسة اكتسابِ المفرَداتِ في اللغة الثانيةِ في عُقُودٍ سابِقَة. راجع:  @(co-ordinate bilingualism) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"أن يَستَعمِل شخصٌ ما لغَتَين بدرَجَةٍ واحدةٍ من حيث المهاراتُ اللغويةُ والوَظائفُ التواصُلية، ولا يجِد فَرقاً بين استِعمالِ اللغَتَين في أيِّ مَوقِفٍ من المواقِف. وتَنشأ هذه الثُّنائيةُ حين يَكتَسِب الشخصُ اللغَتَين في مكانٍ واحدٍ في مراحِل عُمريةٍ مُتَوازِيَةٍ، بدرَجةٍ لا يُمَيَّز في كلامه بين اللغَتَين الأمِّ والثانية، وهذه الثُّنائيةُ نادِراً ما تتَحقَّق، إلا لدى الأطفال ثنائيِّي اللغةِّ الأمِّ المتَزامِنَة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ثنائية لغوية مركبة ","nonDiacriticsLemma":"ثنائية لغوية مركبة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ثُنائِيَّةٌ لُغَوِيَّةٌ مُرَكَّبَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d16ecf07-e784-4f66-8228-9e3d4cb683e8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d16ecf07-e784-4f66-8228-9e3d4cb683e8","word":"التَّعَلُّمُ بمُسَاعَدَةِ الحَاسُوبِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c68","lexicalEntryId":"d16ecf07-e784-4f66-8228-9e3d4cb683e8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّعَلُّمُ بمُسَاعَدَةِ الحَاسُوبِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ عامٌّ لاستِعمال الحاسوبِ في التعلُّم والتعليمِ لتَحقيق الأهدافِ التربية. ومن أبرَز برامِجِه التعليمُ المبرمَجُ الذي يَسير مع كلِّ متعلٍّم بالتَّدريج حسبَ تقدُّمِه في البرنامج، ويُتابِعه في درَجَة الفَهمِ وطَبيعة الأخطاء، ويحَدِّد الموادَّ التعليميةَ المناسبةَ له في كلِّ مرحَلَةٍ تاليَة. وقد تقدَّمَت برامجُ التعليمِ بالحاسوب، لكن لوحِظ تأثيرُها السَّلبيُّ في بعض المهاراتِ الأساسِ لطلاب المرحَلةِ الابتدائية، لاسيَّما في الكلام والخَطِّ والإملاءِ والتعبير.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التعلم بمساعدة الحاسوب ","nonDiacriticsLemma":"التعلم بمساعدة الحاسوب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّعَلُّمُ بمُسَاعَدَةِ الحَاسُوبِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

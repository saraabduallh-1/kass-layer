{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fb84506b-4ddb-47aa-a430-dc9608496c8b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fb84506b-4ddb-47aa-a430-dc9608496c8b","word":"تَدْرِيسُ المَجْمُوعَةِ الكامِلَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba1ba","lexicalEntryId":"fb84506b-4ddb-47aa-a430-dc9608496c8b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيسُ المَجْمُوعَةِ الكامِلَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ من أساليب التدريسِ، أو إدارَةِ الصَّفِّ، يُقصَد به تَدريسُ جميعِ طلابِ الفَصلِ طوالَ مُدَّةِ الدَّرس، بما في ذلك الشرحُ والتدريباتُ والأنشِطَة، بدَلًا من تدريسهم في مَجموعات. هذا الأسلوبُ غيرُ مناسِبٍ لفُصول تعليمِ اللغاتِ الأجنَبيّة؛ لاختِلاف طلابِ هذه الفُصولِ في الثقافة، وأساليبِ التعلُّمِ وإستراتيجياتِه، وتفاوُتِهم في الفُروق الفَردِيّة، اللغويّةِ منها، وغيرِ اللغوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريس المجموعة الكاملة ","nonDiacriticsLemma":"تدريس المجموعة الكاملة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيسُ المَجْمُوعَةِ الكامِلَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

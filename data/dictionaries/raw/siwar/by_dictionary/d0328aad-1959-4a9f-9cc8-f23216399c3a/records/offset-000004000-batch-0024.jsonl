{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c5322bda-71af-4be3-bbe3-4a4f6d997b64/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c5322bda-71af-4be3-bbe3-4a4f6d997b64","word":"عَمَليَّاتُ الإنْتَاجِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a78","lexicalEntryId":"c5322bda-71af-4be3-bbe3-4a4f6d997b64","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَمَليَّاتُ الإنْتَاجِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عَمَلياتُ إنتاجِ الكَلامِ أو إصدارِه في مُقابِل عَمَلياتِ الفَهم. ولم َتَحْظَ عمَلياتُ الإنتاجِ بنَصيبٍ كافٍ من البحث والتَّقَصِّي كما حَظِيَت عمَلياتُ الفَهمِ، باستِثناء تَحليلِ الأخطاءِ وجَوَانِبَ من تَحليل المنطُوقِ. والسَّببُ في ذلك صُعُوبةُ إجراءِ البُحوثِ وضَبطِ المتَغيِّراتِ في الكلام المنطوقِ الذي غالبًا ما يَتأثَّر بالموقِف أو المقام، ولا يُنبئ عن الكِفايَة الحقيقيَّةِ للمتكلِّم، إضافةً إلى صُعوبة التَّمييزِ بين التَّغَيُّراتِ المنتَظِمَةِ والتَّغَيُّراتِ الحُرَّةِ في الكفاية اللغويَّةِ الشَّفهيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عمليات الإنتاج ","nonDiacriticsLemma":"عمليات الإنتاج","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَمَليَّاتُ الإنْتَاجِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/73cfa38d-3215-4457-bee6-a82a35297ae7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"73cfa38d-3215-4457-bee6-a82a35297ae7","word":"مُتَحَدِّثٌ مَحْدُودُ الإنجلِيزِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94a6","lexicalEntryId":"73cfa38d-3215-4457-bee6-a82a35297ae7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُتَحَدِّثٌ مَحْدُودُ الإنجلِيزِيَّةِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"شخصٌ لدَيه معرِفةٌ او كِفايَةٌ محدودَةٌ باللغة الإنجليزية، لا تُؤهِّله للاندِماج في فُصولٍ دراسيةٍ تُستَعمَل فيها الإنجليزيةُ لغةً للتدريس. وإذا التَحَق هذا الشخصُ بمدرسةٍ التعليمُ فيها باللغة الإنجليزية، لاسيَّما في الولايات المتحدةِ الأمريكيةِ وكندا وبريطانيا، فغالبًا ما تُخَصِّص له المدرسةُ معلِّمًا في اللغة الإنجليزيةِ؛ حتى يستطيع الاندِماج في الفُصول العادِيَّة، ويَلحَق بزملائه الناطِقين بها، فيما يُعرَف ببرامِج الدَّمْجِ أو الغَمْس immersion programs.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"متحدث محدود الإنجليزية ","nonDiacriticsLemma":"متحدث محدود الإنجليزية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُتَحَدِّثٌ مَحْدُودُ الإنجلِيزِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0a7e09aa-3da7-4568-ae7a-047ef0517081/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0a7e09aa-3da7-4568-ae7a-047ef0517081","word":"إصْلاحٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94a7","lexicalEntryId":"0a7e09aa-3da7-4568-ae7a-047ef0517081","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إصْلاحٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الجُهودُ والمحاوَلاتُ التي يَبذُلها أفرادٌ أو مؤسّساتٌ رَسميةٌ أو غيرُ رَسميةٍ لإصلاح بعضِ جوانبَ من اللغة في مجتَمَعٍ ما أو تَعديلِها؛ كإصلاح التَّهجِئةِ أو الرُّموزِ الكتابية لأغراضٍ تعليميّةٍ أو تِقنيّة، أو إعادَةِ ترتيبِ الأبوابِ النحويّة وصِياغَتِها، أو إضافةِ لغةٍ أو لغاتٍ أجنَبيّةٍ في التعليم. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إصلاح لغوي ","nonDiacriticsLemma":"إصلاح لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إصْلاحٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/40f53365-33c2-411e-adcc-d2862d642fd0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"40f53365-33c2-411e-adcc-d2862d642fd0","word":"مَهارَاتُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94a8","lexicalEntryId":"40f53365-33c2-411e-adcc-d2862d642fd0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَهارَاتُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعةُ القُدراتِ التي يمتَلِكُها المرءُ أو يجب أن يَمتلِكَها، وتُمَكِّنه من استعمال اللغةِ في المواقِف العادِيَّةِ استعمالا يتَّفِق مع استعمال الناطقين بها أو يَقرُب منه. تُقَسَّم مهاراتُ اللغةِ إلى أربعٍ رئيسة، هي: الاستماعُ، والمحادَثَةُ، والقراءةُ، والكتابةُ، وتُصنَّف تَصنيفاتٍ مختَلِفة، أهمُّها: تَصنيفُها إلى استِقبالِيَّةٍ receptive skills تَشمل الاستِماعَ والقراءةَ، وإنتاجيَّةٍ productive skills تَشمَل المحادَثةَ والكتابةَ. ولكلِّ مهارَةٍ رئيسةٍ عَدَدٌ من المهارات الفَرعيةِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مهارات اللغة ","nonDiacriticsLemma":"مهارات اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَهارَاتُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d075ade2-5338-40ce-b48d-d5f9b7ea2032/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d075ade2-5338-40ce-b48d-d5f9b7ea2032","word":"الإدْرَاكُ اللُّغَوِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94a9","lexicalEntryId":"d075ade2-5338-40ce-b48d-d5f9b7ea2032","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإدْرَاكُ اللُّغَوِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يَعني تَميِيزَ الصوتِ اللغويِّ أو الكلامِ المسموع، أي تَمييزَ أنواعِ الأصواتِ من حيث خواصُّها وسِماتُها ووَظائفُها، والاستجاباتُ العصبيةُ اللازمةُ لها في مناطِق اللغةِ في الدِّماغ. وإدراكُ الكلامِ مرحَلةٌ تَلي مرحَلةَ استقبالِ الكلامِ المسموعِ وتَسبِق مرحَلةَ فَهمِه، لكن الباحثين في علم اللغةِ العَصَبيِّ يُواجِهون صُعوباتٍ في تحديد مرحَلةِ إدراكِ الكلامِ تحديدا دقيقا؛ لصُعُوبة تحديدِ الفَواصِلِ بين عَمَلياتٍ ثلاث، هي: عَمَلياتُ السَّمع، وعَمَلياتُ الإدراك، وعَمَلياتُ الفَهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإدراك اللغوي ","nonDiacriticsLemma":"الإدراك اللغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإدْرَاكُ اللُّغَوِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

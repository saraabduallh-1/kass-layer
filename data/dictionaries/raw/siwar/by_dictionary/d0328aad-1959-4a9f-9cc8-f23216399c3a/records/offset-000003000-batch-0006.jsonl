{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f11aabe7-4b04-4907-9822-5470befb292f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f11aabe7-4b04-4907-9822-5470befb292f","word":"قَابِلِيَّةُ التَّعَلُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94ad","lexicalEntryId":"f11aabe7-4b04-4907-9822-5470befb292f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَابِلِيَّةُ التَّعَلُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ أو فَرضيةٌ لغويةٌ نفسية، تَسعى إلى تأكيد أن أيَّ نوعٍ من القواعد يجب أن يكون قابِلا للتعلُّم لدى الأطفالِ الناطقين باللغة حين يَسمَعونه في بيئتهم، أي حين يكون دَليلا إيجابيًّا positive evidence في المُدخَلات اللغويةِ التي يتَلَقَّونه فيها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"نظريةٌ أو فرضيةٌ لغويةٌ مَعرِفية، ترى أن قواعدَ أيِّ لغةٍ تنقَسِم قِسمَين: قِسمٌ يمكن تعَلُّمُه learnable وتعليمُه teachable ويَصعُب على المرء اكتِسابُه من غير تعلُّمٍ أو تعليمٍ أو تَنبِيهٍ لقواعده، وقِسمٌ آخَرُ غيرُ قابِلٍ للتعلُّم unlearnable أو التعليمِ unteachable، وإنما يُكتَسَب من المدخَلات اللغويةِ بطريقَةٍ ضِمنِيّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُطلَق وَصفًا على اللغة الإنسانيةِ بوَصفها نظامًا رَمزيًّا خاصًّا بالإنسان دونَ غيره من المخلوقات، قابِلًا للتعلُّم والاكتسابِ، خلافا للأنظِمَة الرَّمزِيةِ الأخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قابلية التعلم ","nonDiacriticsLemma":"قابلية التعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَابِلِيَّةُ التَّعَلُّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

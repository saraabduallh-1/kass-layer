{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5eddf31a-bd93-417e-bde9-f389509fba53/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5eddf31a-bd93-417e-bde9-f389509fba53","word":"النِّصْفُ الأيَسَرُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94af","lexicalEntryId":"5eddf31a-bd93-417e-bde9-f389509fba53","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النِّصْفُ الأيَسَرُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الجانبُ الأيْسَر من قِشرَةِ الدِّماغِ البَشَريِّ، في مُقابِل الجانبِ الآخَرِ منها، وهو النصفُ الأيمَنُ. والنصفُ الأيسَرُ مسؤولٌ عن معظَم وَظائفِ اللغة، ويَقَع فيه معظَمُ مناطِقِها؛ كالمنطقةِ الحَرَكيةِ المسؤولةِ عن الكلام والمعروفَةِ بمنطَقة بروكا، والمنطقةِ الحِسِّيةِ المسؤولةِ عن استقبال الكلامِ وفَهمِه وهي منطَقةُ فيرنيكه، والتَّلْفيفَةِ الزَّاوِيَّةِ المسؤولةِ عن تحويل المثيرِ البَصَريِّ إلى شكلٍ سَمعيٍّ والعَكس. إضافةً إلى ذلك، يتحكَّم النصف الأيسر من الدماغ في الجانب الأيمنِ من الجسم بما فيه من أعضاء تُشارِك في الوَظائف اللغوية. راجع:  @(brain) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النصف الأيسر ","nonDiacriticsLemma":"النصف الأيسر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النِّصْفُ الأيَسَرُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

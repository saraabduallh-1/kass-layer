{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2061b8d8-0810-40b7-a06a-ad162d6b145f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2061b8d8-0810-40b7-a06a-ad162d6b145f","word":"تَجَمُّد التَّعَلُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94a3","lexicalEntryId":"2061b8d8-0810-40b7-a06a-ad162d6b145f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَجَمُّد التَّعَلُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اللغة المرحَليةِ لمتعلِّمي اللغاتِ الأجنَبيّة، يُشير إلى توَقُّفٍ مؤقَّتٍ في التعلُّم لا يَظهَر فيه تقَدُّمٌ لدى المتعلِّمِ ولا تغَيُّرٌ في مُنحنَى تعلُّمِه. ويحدُث هذا التوَقُّف لمتعلِّم اللغةِ الثانيةِ أو الأجنبيةِ أحيانا بعد تخَطِّيه المرحَلةَ الأولى أو المرحَلةَ المبتدئةَ من تعلُّم اللغةِ الهَدَف؛ حيث يَشعُر بتوَقُّف نُمُوِّه اللغويِّ، ثم يَعود إلى التقَدُّم مرَّةً أخرى. وهذا التوَقُّفُ قد يكون حقيقيًّا، وقد يكون وَهميًّا حين يُقارِن الطالبُ مرحَلتَه الحاليّةَ بمرحَلَتِه السابِقَة. ويَرجِع هذا التوَقُّفُ إلى أسبابٍ عدَّة، منها: الشُّعورُ بالتَّعَب والملَلِ، وفقدانُ الدَّافِعيةِ، وسوءُ تخطيطِ البرنامَجِ اللغويِّ وما يَحوِيه من موادَّ لغوية، خاصةً حين لا يختَلِف المستوى المتوسِّطُ كثيرا عن المستوى المبتدئ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تجمد التعلم ","nonDiacriticsLemma":"تجمد التعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَجَمُّد التَّعَلُّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6e3253cf-8c09-47b2-9e30-5209e1ad5d9a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6e3253cf-8c09-47b2-9e30-5209e1ad5d9a","word":"أُسْلُوبُ التَّعَلُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94a4","lexicalEntryId":"6e3253cf-8c09-47b2-9e30-5209e1ad5d9a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُسْلُوبُ التَّعَلُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَمَطٌ أو أنماطٌ من التعلُّم الأنموذَجيةِ المفضَّلَةِ لدى فَردٍ أو جَماعَةٍ من المتعلِّمين، بما في ذلك تعلُّمُ اللغات. وهو سُلوكٌ تعليميٌّ يتأثَّر بعَدَدٍ من العوامِل الداخلية والخارجية، الذِّهنيةِ والنفسيةِ والثقافيةِ والاجتِماعية؛ كالأسلوب البصَريّ، والأسلوبِ السَّمعيّ أو الشَّفهيّ، وغيرِ ذلك. يُستَعمَل المصطلَحُ أيضا مُرادِفا للأسلوب المعرِفيِّ في التعلُّم؛ لأنهما يؤدِّيان وَظائفَ متماثِلَة؛ إذ يُساعد كلُّ واحدٍ منهما المتعلِّمَ على اختِيار الأنشِطَةِ والإستراتيجياتِ المناسِبَةِ، لكنهما مختَلِفان من حيث ارتباطُ الأساليبِ المعرِفيةِ بالمجالات الأكاديميةِ والبَحثِيَّةِ النَّظَرية، وارتِباطُ أساليبِ التعلُّمِ بالتَّطبيقات العَمَليةِ في التعلُّم. راجع:  @(cognitive style) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أسلوب التعلم ","nonDiacriticsLemma":"أسلوب التعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُسْلُوبُ التَّعَلُّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/16b7279f-1302-450e-b74f-e871e6ebe70a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"16b7279f-1302-450e-b74f-e871e6ebe70a","word":"نَظَرِيَّةُ التَّعَلُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94a5","lexicalEntryId":"16b7279f-1302-450e-b74f-e871e6ebe70a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ التَّعَلُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلق على مجموع النظرياتِ النفسيةِ التربويةِ التي تُعنَى بدراسة الطرائقِ أو الأساليبِ التي يَسلُكها المتعلِّم، أو تُفسِّر تلك الطرائقَ والأساليب. وفي حَقل تعلُّمِ اللغاتِ وتعليمِها، يُنظَر إلى نظرية التعلُّمِ هذه بأنها إحدى النظرياتِ التي تُفسِّر اكتسابَ اللغة، أي إن اللغة - وفقا لهذه النظرية - تُكتَسَب بالتعلُّم كما تُكتَسَب المعارِفُ الإنسانيةُ والعُلومُ الطبيعية. وهو تفسيرٌ نفسيٌّ تربويٌّ يَرفُضُه معظَمُ اللغويِّين التطبيقيِّين، ويُعارِض معظَمَ النظرياتِ اللغويةِ واللغويةِ النفسيةِ واللغويةِ الاجتماعية، لاسيَّما النظرياتُ التي تَنطَلِق من الاتجاه المعرِفيِّ الفِطرِيِّ في دراسة اللغةِ وتفسيرِ اكتِسابِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية التعلم ","nonDiacriticsLemma":"نظرية التعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ التَّعَلُّمِ"}],"lemmaLanguage":{"code":"ar","label":"
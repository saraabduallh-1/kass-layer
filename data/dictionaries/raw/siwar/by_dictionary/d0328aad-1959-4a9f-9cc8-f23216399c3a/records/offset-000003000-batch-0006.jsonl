{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ce18fa11-7829-46c6-a8de-af4b0de122ac/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ce18fa11-7829-46c6-a8de-af4b0de122ac","word":"قُوَّةُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94b6","lexicalEntryId":"ce18fa11-7829-46c6-a8de-af4b0de122ac","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قُوَّةُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"درَجةُ التأثيرِ الذي تَصِل إليه لغةٌ ما في الناطقين بها وفي غيرهم من الناطقين بلغاتٍ أخرى. تتمَتَّع بعضُ اللغاتِ بهذه القوَّةُ لأسبابٍ ذاتيةٍ أو دينيةٍ أو ثقافيةٍ أو تاريخيةٍ أو سياسيةٍ أو اقتصادية؛ كقوَّة العربيةِ في عُصور ازدهارِ الخلافةِ الإسلاميةِ العربية، وقوَّةِ الإنجليزيةِ في عصرِنا الحاضِر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قوة اللغة ","nonDiacriticsLemma":"قوة اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قُوَّةُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/924bb519-64ab-4b6f-ae2a-33753c62149f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"924bb519-64ab-4b6f-ae2a-33753c62149f","word":"تَفْضِيلٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94b7","lexicalEntryId":"924bb519-64ab-4b6f-ae2a-33753c62149f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَفْضِيلٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أن يُفَضِّل شَخصٌ ثُنائيُّ اللغة، أو متعَدِّدُ اللغات، لغةً ما على غيرها من اللغات التي يُتقِنها؛ فيستَعمِلها دونَ غيرِها في جميع المجالاتِ أو في مجالٍ أو مجالاتٍ معيَّنة. وقد يكون تفضيلُ لُغةٍ معيَّنةٍ على غيرها عامًّا في المجتَمَع ثنائيِّ اللغةِ أو متعَدِّدِ اللغات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تفضيل لغوي ","nonDiacriticsLemma":"تفضيل لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَفْضِيلٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/818b4433-25cb-4b51-9fc2-25b55ef87453/get-public-entry"},"browse_index_record":{"lexicalEntryId":"818b4433-25cb-4b51-9fc2-25b55ef87453","word":"مَوَاقِفُ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94b8","lexicalEntryId":"818b4433-25cb-4b51-9fc2-25b55ef87453","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَوَاقِفُ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ تعليميٌّ، يُطلَق على المواقِف والحالاتِ في الحياة اليَوميةِ التي يَفتَرِض واضِعو المناهجِ ومُعِدُّو الموادِّ التعليميةِ ومؤلِّفو الكتُبِ أن متعلِّمَ اللغةِ الهَدَفِ سوف يتعَرَّض لها، ويحتاج إليها في حياته. من هذه المواقِفِ مثلا: المطار، ومكتَب الجوازات، ومكتَب البريد، والجامِعة، وشؤون الطلاب، والسُّوق، والمطعَم، والفندق. وتُقَدَّم هذه المواقِفُ لمتعلِّم اللغةِ في حواراتٍ ومحادَثاتٍ، وتُضَمَّن فيها الأنماطُ اللغويةُ المرادُ تدريسُها. وكان تعليمُ اللغةِ من خلال المواقِفِ شائعًا في المذهب السَّمعيِّ الشَّفَهيٍّ والطريقةِ السَّمعيةِ الشَّفَهية، غير أنه انتُقِد انتِقادًا شديدًا؛ لأن معظمَ المواقِفِ كانت مُتكَلَّفةً، والحواراتُ فيها كانت مَصنوعَةً، وغالبا ما يُفاجَأ المتعلِّمُ بأن ما حَفِظَه من حواراتٍ وأنماطٍ لا وُجودَ لها في الموقِف الطبيعيِّ الحَيِّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مواقف لغوية ","nonDiacriticsLemma":"مواقف لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَوَاقِفُ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

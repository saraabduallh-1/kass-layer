{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5526e097-38f4-43c0-95c8-80aaf7fd15a2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5526e097-38f4-43c0-95c8-80aaf7fd15a2","word":"أَنْمَاطٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94b2","lexicalEntryId":"5526e097-38f4-43c0-95c8-80aaf7fd15a2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَنْمَاطٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النَّمَطُ أنموذَجٌ واحدٌ من نماذِج البِناءِ اللغويِّ، يمكن أن يَرِد على غِراره ما لا يُحصَى من الجُمَل أو العبارات، ولكلِّ لغةٍ أنماطٌ يمكن حَصرُها، لكن لا يمكن حَصرُ أمثِلَتِها. فالمبتدأُ والخَبرُ - في العربية مثلا - نَمَطٌ لغويٌّ، يَرِد منه ما لا حصر له من الجُمَلِ مثلُ: الكتابُ ضَخمٌ، الشمسٌ مُشرِقةٌ، محمدٌ مجتهد؛ والمضافُ مع المضافِ إليه نَمَطٌ لغويٌّ، يَرِد منه ما لا حصر له من العبارات، مثلُ: كتابُ المعلِّمِ، غُرفَةُ المنزِلِ، بَيتُ الوَزير؛ والفعلُ مع الفاعلِ نَمَطٌ لغويٌّ، يَرِد منه ما لا حصر له من الجُمَلِ، مثلُ: خَرَجَ الولدُ، نَجَحَ الطالبُ، سافَرَ الحاجُّ، وهكذا. راجع:  @(pattern) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنماط لغوية ","nonDiacriticsLemma":"أنماط لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَنْمَاطٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedR
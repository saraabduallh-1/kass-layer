{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0555286e-69bb-492d-a34c-b25fa3368f9d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0555286e-69bb-492d-a34c-b25fa3368f9d","word":"مَذْهَبُ الفَهْمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c4e","lexicalEntryId":"0555286e-69bb-492d-a34c-b25fa3368f9d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَذْهَبُ الفَهْمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ في تعليم اللغاتِ الثانيةِ والأجنبيةِ، استُمِدَّ من أسلوب اكتِسابِ الطفلِ لغتَه الأمَّ، لكنه لم يَظهَر على شَكل طريقَةِ تدريسٍ مستقَلَّة، وإنما ظَهَرَت بعضُ تَطبيقاتِه في طريقَة الاستِجابَةِ الجَسَدِيةِ الكامِلَةِ TPR. يُعنَى هذا المذهبُ بتَدريب المتعلِّمِ على فَهم المسموعِ مدَّةً كافيةً قبلَ تَدريسِه الكلامَ، وتَدريبِه على فَهم المعنى باللغة الهَدَفِ فقط، ويؤكِّد أن قُدرَةَ المتعلِّمِ على الفَهم يجب أن تَفوق قُدرَتَه على الكلام، وأن مهارَتَيْ الإنتاجِ (الكلامِ والكتابة) تَظهران بشَكل طبعيٍّ عَفوِيٍّ نتيجَةَ التَّنمِيَةِ السَّليمَةِ لمهارَتَيْ الاستقبالِ (الاستماع والقراءة).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مذهب الفهم ","nonDiacriticsLemma":"مذهب الفهم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَذْهَبُ الفَهْمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

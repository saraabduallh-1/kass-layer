{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6176f262-51a9-49d7-90fc-f2eede0a1e9b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6176f262-51a9-49d7-90fc-f2eede0a1e9b","word":"المَنْهَجُ السِّيَاقِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c3c","lexicalEntryId":"6176f262-51a9-49d7-90fc-f2eede0a1e9b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَنْهَجُ السِّيَاقِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهَجٌ أو مذهبٌ لغويٌّ يُسمى أيضا المنهجَ العَمَلِيَّ operational approach، عُرِفَت به مدرسةُ لندَن London School، وتزعَّمَه جون فيرث John Firth الذي اهتَمّ بالوَظيفة الاجتماعيةِ للغة، إضافةً إلى لُغويِّين آخرِين أمثال هاليداي Halliday وماكنتوش Mcintosh وسنكلير Sinclair وغيرهم. ويرى أصحابُ هذا المنهجِ أو المذهبِ أن الكلمةَ لا معنى لها خارِجَ السِّياق، ولا بدَّ لها من سِياقٍ يوَضِّح معناها، وأن الكلماتِ لا يمكن وَصفُها أو تحديدُها إلا بملاحَظَة الوحداتِ الأخرى التي تُجاوِرُها. وقد انبَثَق عن هذا المنهَجِ ما عُرِف بالمذهب المعجَمِيِّ Lexical approach، الذي طُبِّق في تعليم اللغةِ بعنوان Lexical approach in language teaching، الذي يُركِّز على المصاحِبات اللَّفظِية، والعباراتِ الجاهِزَة، والأمثالِ السائرَة، والمصطَلَحات. راجع:  @(Lexical Approach) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المنهج السياقي ","nonDiacriticsLemma":"المنهج السياقي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَنْهَجُ السِّيَاقِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

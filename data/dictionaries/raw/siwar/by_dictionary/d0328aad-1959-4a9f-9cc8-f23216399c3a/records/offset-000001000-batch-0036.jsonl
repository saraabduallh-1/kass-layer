{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d1d27db2-d4cd-42f8-8cbc-ebd02a7dc418/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d1d27db2-d4cd-42f8-8cbc-ebd02a7dc418","word":"الإِسْبِرَانْتُو","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fce","lexicalEntryId":"d1d27db2-d4cd-42f8-8cbc-ebd02a7dc418","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإِسْبِرَانْتُو","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ مَصنوعةٌ وَضعَها زامينهوف L. L. Zamenhof عام 1887م؛ لتكون لغةَ تواصُلٍ عالَميةً مبَسَّطةً تحلّ محَلَّ لغاتِ العالَمِ في كثيرٍ من المواقِف والمجالات، ولاسيَّما بين الناطقين بلغاتٍ مختَلِفة. وهي مؤلَّفَةٌ من ثلاثة وعشرين صوتا صامِتا وخمسةِ صوائت، وتضمّ كلماتٍ مُعظَمُها من اللغات الأوروبية. وعلى الرَّغم من إعجاب بعضِ الناسِ بها، وتدريسِها في بعض المدارِسِ والجامعاتِ العالَمِية، فإنها تراجَعَت ولم تُؤدِّ الغَرَضَ الذي استُحدِثَت من أجله، ولو استُعمِلَت لغةً طبيعيةً على نِطاقٍ واسِعٍ لأَصابها ما يُصيب اللغاتِ الطبيعيةَ الأخرى من تَعقيدٍ واستِثناءاتٍ وشُذوذ، وسوف تَنقَسِم إلى لَهَجاتٍ ولغاتٍ فَرعيةٍ كما تنقَسِم اللغاتُ الطبيعية. راجع:  @(artificial language) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإسبرانتو ","nonDiacriticsLemma":"الإسبرانتو","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإِسْبِرَانْتُو"}],"lemmaLanguage":{"c
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6cd91ac8-8aef-4ded-b493-8dca180922de/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6cd91ac8-8aef-4ded-b493-8dca180922de","word":"تَدْرِيبُ التَّوْسِيعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fc8","lexicalEntryId":"6cd91ac8-8aef-4ded-b493-8dca180922de","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيبُ التَّوْسِيعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوعٌ من أنواع التدريباتِ يَشِيع استعمالُه في بعض طرائقِ تدريسِ اللغاتِ الأجنبيةِ التقليدية، ولاسيّما في الطريقة السَّمعيةِ الشَّفهية، يتطلَّب من الطالب تَوسيعَ عناصِرِ الجُملَةِ، بزيادة بعضِ الكلماتِ أو العباراتِ التي قد يَتِمُّ المعنى بدونها في الجملة البسيطة. فالجُملةُ: سافَرَ محمدٌ، يمكن أن تُوسَّع عدَّةَ مرّات، فيُقال: سافَرَ محمدٌ إلى مكةَ، ويُقال أيضا: سافَرَ محمدٌ إلى مكةَ أمسِ، كما يُقال: سافَرَ محمدٌ إلى مكةَ أمسِ بالطائرة، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريب التوسيع ","nonDiacriticsLemma":"تدريب التوسيع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيبُ التَّوْسِيعِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/16a4212c-c022-4858-ba7b-a14226654c59/get-public-entry"},"browse_index_record":{"lexicalEntryId":"16a4212c-c022-4858-ba7b-a14226654c59","word":"رُقِيُّ الدَّلالَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fc9","lexicalEntryId":"16a4212c-c022-4858-ba7b-a14226654c59","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رُقِيُّ الدَّلالَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ضَربٌ من التَّغيُّر الدّلاليّ، يرتَقِي فيه معنى الكلمةِ عبرَ الزَّمانِ من معنى حَقيرٍ إلى معنى شَريفٍ أو راقٍ، مثلُ الكلمةِ الإنجليزيةِ: nice التي اقتُرِضَت من الفرنسية القديمةِ في القرن الثالث عشَر الميلادي حين كانت تَعني: (غَبيّ) أو (مُغَفَّل) حتى ارتقَت دلالَتُها فأصبَحَت تَعني الشيءَ الجَميلَ، ومثلُها كلمةُ: minister التي كانت تَعني الخادِمَ، ثم أُطلِقَت الآنَ على الوَزير وعلى القِسِّ في الكنيسَة البروتِستانتِية. ويُطلَق على هذا الارتقاء أيضا مصطلَح: amelioration أو: ameliorative change.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"رقي الدلالة ","nonDiacriticsLemma":"رقي الدلالة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رُقِيُّ الدَّلالَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/826fbe88-f684-408a-afb5-ddfe7814c9b9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"826fbe88-f684-408a-afb5-ddfe7814c9b9","word":"فَلْسَفةُ العُلُومِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fca","lexicalEntryId":"826fbe88-f684-408a-afb5-ddfe7814c9b9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَلْسَفةُ العُلُومِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"دراسةُ ما يَعرِفة الإنسانُ وكيف يَعرِفه، وهي النظريةُ التي تُعالِج طبيعةَ المعرِفةِ وصِدقَها، وتَدرُس العُلومَ من حيث موضوعاتُها ومَبادِئُها وقوانينُها وعلاقاتُ بعضِها ببعض، والقوانين التي تحكم تطوّرها. وهي جُزءٌ من الفَلسَفَة والميتافيزيقا، وهذا سبَبُ تسميَتِها فلسفةَ العُلوم. فالقَولُ إنّ علمَ اللغةِ مثَلا عامٌّ وَصفِيٌّ، وليس عِلمًا صُورِيًّا، ليس قَولا من داخِل هذا العِلمِ وليس من قضاياه، وإنما هو قَولٌ يُقال عنه. ويُقابِل فلسفةَ العُلوم أو نظريةَ المعرِفَةِ علمُ المعرِفَةِ أو الإدراكُ cognition الذي يَدرُس أيضا الظواهِرَ نفسَها، لكنه يَدرُسها من الناحية النَّفسيةِ المعرِفية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فلسفة العلوم ","nonDiacriticsLemma":"فلسفة العلوم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَلْسَفةُ العُلُومِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6d8ed0c5-f393-43b7-9253-1a895036e3a6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6d8ed0c5-f393-43b7-9253-1a895036e3a6","word":"مُسَمًّى باسْمِه","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fcb","lexicalEntryId":"6d8ed0c5-f393-43b7-9253-1a895036e3a6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُسَمًّى باسْمِه","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الشخصُ الذي يُنسَب إليه اسمٌ أو يُسمَّى باسمه شيءٌ؛ كأسماء الطَّعام، وأسماءِ البِلاد، وأسماءِ القبائل، ونحوِ ذلك. وهو كثيرٌ في العربية، ولاسيّما أسماءُ القبائلِ والأماكِن. ومنه في الإنجليزية كلمةُ: sandwich المنسوبَةُ إلى اللُّورْد ساندويتش Lord Sandwich، والكلمةُ الإنجليزيةُ: hamburger التي تُطلَق على نوعٍ من الوَجبات الأمريكيةِ السَّريعَةِ، نسبةً إلى مدينة هامبوغ الألمانية، ومنه كلمةُ: watt، التي هي شِدَّة التَّيَّارِ الكهربائي، نِسبَةً إلى مُكتِشِفِها الأسكوتلنديِّ جميس وات James Watt. وتَسميةُ الشيءِ باسم صاحِبِه يُطلَق عليها eponymous؛ أما العَلاقةُ بين الاسمِ والمسمَّى باسمه أو المنسُوبِ إليه فتُسمّى: eponymy.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مسمى باسمه ","nonDiacriticsLemma":"مسمى باسمه","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُسَمًّى باسْمِه"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3b340478-41e1-4b74-aff4-efe3bdf55494/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3b340478-41e1-4b74-aff4-efe3bdf55494","word":"المَعْرِفَةُ الصَّرِيحَةُ باللُّغَةِ الثانِيَةِ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fd5","lexicalEntryId":"3b340478-41e1-4b74-aff4-efe3bdf55494","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَعْرِفَةُ الصَّرِيحَةُ باللُّغَةِ الثانِيَةِ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَعرِفةُ متعلِّمِ اللغةِ الثانيةِ بقواعدها وقوانينِها ووَحداتِها معرِفةً صريحةً تُمكِّنه من الحديث عنها وتَوضيحِها وشَرحِها. وهي معرِفةٌ نَظَريةٌ، تُوصَف أحيانا بأنها معرِفةُ ما وراءَ اللغةِ meta-lingual knowledge أو meta-linguistics، وتُقابِلها المعرِفةُ الضِّمنِيَّةُ implicit knowledge. وتُشير نتائجُ الدراساتِ اللغويةِ التَّطبيقيةِ إلى أنّ متعلِّمَ اللغةِ يحتاج إلى قَدرٍ معيَّنٍ أو حَدٍّ أدنَى من المعرِفة الصَّريحَةِ باللغة الثانية، لكنّ هذه المعرِفةَ غيرُ كافيَةٍ لبناء كِفايَتِه اللغوية، إذ يحتاج إلى المعرِفة الضِّمنِيَّةِ بقَدرٍ أكبَرَ من حاجَتِه إلى المعرِفة الصَّريحَة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المعرفة الصريحة باللغة الثانية  ","nonDiacriticsLemma":"المعرفة الصريحة باللغة الثانية ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَعْرِفَةُ الصَّرِيحَةُ باللُّغَةِ الثانِيَةِ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

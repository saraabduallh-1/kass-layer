{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f43e472a-3cf6-4ea6-a0c6-c834f145e58d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f43e472a-3cf6-4ea6-a0c6-c834f145e58d","word":"جَمْعُ المَادَّةِ اللُّغَوِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c16","lexicalEntryId":"f43e472a-3cf6-4ea6-a0c6-c834f145e58d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جَمْعُ المَادَّةِ اللُّغَوِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التَّدوين، وهو جَمعُ اللغويِّ أو الباحثِ الموادَّ اللغويةَ من ألسِنَة أبنائها، وتَرتِيبِها، بهدف تحليلِها وتَقعيدِها على جميع المستويات (الصوتيةِ والصرفيةِ والنحويةِ والمعجَميةِ والدّلالية)، أو على واحدٍ منها. والتَّدوين - بهذه الصورة - منهَجٌ لغويٌّ سَلَكَه اللغويون العربُ منذ القرنِ الهجريِّ الأول، وما زال منهَجا متَّبَعا في دراسة اللغاتِ التي لم تُدرَس من قبلُ في إفريقيا وأمريكا الجنوبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جمع المادة اللغوية ","nonDiacriticsLemma":"جمع المادة اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جَمْعُ المَادَّةِ اللُّغَوِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a2218262-01d4-4428-9c5d-3c7999de346e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a2218262-01d4-4428-9c5d-3c7999de346e","word":"مُؤَشِّرَاتُ التَّصَاحُبِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c17","lexicalEntryId":"a2218262-01d4-4428-9c5d-3c7999de346e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُؤَشِّرَاتُ التَّصَاحُبِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ معجَميٌّ شاع استِعمالُه في لسانيّات المدوَّنات، ويقصَد به المتتابعاتُ اللَّفظِيَّةُ السابقَةُ أو اللاحِقَةُ، التي تختِلف امتِداداتُها بحسب درَجَةِ التّصاحُب، وتقَع ما بين 1-15 كلمةً. راجع:  @(collocational range) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مؤشرات التصاحب ","nonDiacriticsLemma":"مؤشرات التصاحب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُؤَشِّرَاتُ التَّصَاحُبِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2209e71d-570f-40ba-b2b1-f5f17146d407/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2209e71d-570f-40ba-b2b1-f5f17146d407","word":"تَدْرِيبٌ تَوَاصُلِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c18","lexicalEntryId":"2209e71d-570f-40ba-b2b1-f5f17146d407","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيبٌ تَوَاصُلِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَدريبٌ أو تدريباتٌ لغويةٌ ذاتُ معنى مَفهوم، تهدِف إلى بناء القُدرَةِ التواصُليةِ لدى متعلِّمِ اللغة. وهي تدريباتٌ يتصَرَّف فيها المتعلِّمُ بدَلا من أن يتحكَّم فيها المعلِّمُ، وهي - بهذه الصِّفة - تختَلِف عن التدريبات الآلِيَّةِ وتدريباتِ الأنماطِ التي يتحكَّم فيها المعلِّمُ بدرَجةٍ عاليَة. راجع:  @(meaningful drill) و  @(mechanical drill) و  @(pattern drills) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريب تواصلي ","nonDiacriticsLemma":"تدريب تواصلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيبٌ تَوَاصُلِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/504032ac-009d-43f1-952e-fe54d5067767/get-public-entry"},"browse_index_record":{"lexicalEntryId":"504032ac-009d-43f1-952e-fe54d5067767","word":"وَظِيفَةٌ تَوَاصُلِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c19","lexicalEntryId":"504032ac-009d-43f1-952e-fe54d5067767","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَظِيفَةٌ تَوَاصُلِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المهمَّةُ التواصُليةُ التي تؤدِّيها اللغةُ في المجتَمَع، وهي ما يؤدِّيه الكلامُ من غَرَضٍ في التخاطُب بين إنسانٍ وآخَر؛ كالإخبار والأمرِ والنَّهيِ والتَّرَجِّي، والاستفهامِ والتعجُّب، مهما كان نوعُ الصِّيَغِ الصرفيةِ والتراكيبِ النحوية. وتختَلِف اللغاتُ في هذه الوَظيفة؛ فبعضُ اللغاتِ تؤدِّي وَظائفَها التواصُليةَ في مجتَمَعها كامِلةً، كاليابانية في اليابان مثلاً، وتَقِلّ عنها لغاتٌ أخرى كالعربية الفُصحى في الأقطار العربيةِ في العَصر الحاضِر، في حين تقتَصِر بعضُ اللغاتِ على وَظائف تواصُليةٍ في مجالات محدودَةٍ، كما هي الحالُ في بعض لغاتِ إفريقيا، وتفتَقِر لغاتٌ أخرى إلى أبسَط الوَظائفِ التواصُليةِ، كاللغة البالِيَّة عند البوذِيِّين في كلٍّ من سريلنكا والهندِ الصينيةِ، واللغاتِ الدِّينيَّةِ للأقَلِّيَّاتِ في بعض الأقطارِ العربية، حيث لا تؤدِّي سِوى وَظائفَ دينِيةٍ في طُقوسٍ معيَّنةٍ وأماكنَ محدَّدَةٍ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وظيفة تواصلية ","nonDiacriticsLemma":"وظيفة تواصلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَظِيفَةٌ تَوَاصُلِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/aef017f8-e712-4e97-bec1-65e7529c3e15/get-public-entry"},"browse_index_record":{"lexicalEntryId":"aef017f8-e712-4e97-bec1-65e7529c3e15","word":"طَرِيقَةُ تَنْظِيم الفَصْلِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c1a","lexicalEntryId":"aef017f8-e712-4e97-bec1-65e7529c3e15","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"طَرِيقَةُ تَنْظِيم الفَصْلِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تعليميٌّ عامٌّ، يُشير إلى الطريقَة التي يُنظِّم بها معلِّمُ اللغةِ قاعَة الدَّرسِ؛ لتَحقيق الفائدَةِ القُصوَى من التعلِّم، كتَقسيم الطلابِ إلى مجموعاتٍ، أو توزيعِهم زُمَرا أو صُفوفا، أو إجلاسِهم حَولَ طاوِلَةٍ مستَديرَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"نَشاطٌ من أنشِطَة الطريقةِ الإيحائيَّةِ Suggestopedia، يُشير إلى تَحويل جَوِّ قاعَةِ الدَّرسِ إلى بيئة مختَلفَةٍ تماما عن الفَصل العادِيّ؛ وذلك بتَعتِيم الإضاءة، وتَشغيلِ الموسيقى الخافِتَة، وتَجهيزِ المقاعِدِ الوَثيرَة، وتَزيِينِ الجُدران بصَوَرٍ من بيئة اللغةِ الهَدَفِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"طريقة تنظيم الفصل ","nonDiacriticsLemma":"طريقة تنظيم الفصل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"طَرِيقَةُ تَنْظِيم الفَصْلِ"}],"lemma
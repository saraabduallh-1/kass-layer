{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1146e455-3b69-497f-990a-a64bda4d0ab9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1146e455-3b69-497f-990a-a64bda4d0ab9","word":"لُغَةُ الطِّفْلِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a6e","lexicalEntryId":"1146e455-3b69-497f-990a-a64bda4d0ab9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةُ الطِّفْلِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"كلامُ الطفلِ في مرحَلةِ اكتِسابِه لغتَه الأمَّ في السنوات السِّتِّ الأولى، قبلَ التِحاقِه بالمدرسة. وهي لغةٌ تختَلِف عن لغة الكِبار، وتتَّسِم بسِماتٍ معيَّنة، كاستِعمال الكلماتِ ذاتِ الدَّلالاتِ الحِسِّيَّة، وقِصَرِ التراكيب، وحَذفِ بعضِ أدواتِ الرَّبط، وفرْطِ التَّعمِيمِ في القواعد والدَّلالات. راجع:  @(language acquisition) و  @(first language acquisition) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]},{"definition":"اللغةُ التي يتحدَّث بها الناسُ مع الأطفال، لاسيّما الوالدان، وهي لغةٌ مُبَسَّطةٌ ذاتُ ألفاظٍ خاصةٍ مثل: (بابا) و(دادا) و(نونو) و(نوني) و(كِخْ). ولكنّ إطلاقَ هذا الوَصفِ على هذه اللغةِ مَوضِعُ خلافٍ بين علماءِ اللغةِ النفسيين؛ لأن الأمَّ بصفةٍ خاصةٍ لا تُكلِّم طِفلَها بلغة الطُّفُولَةِ المبسَّطَة، كما يتَّضِح من الفقرة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"اللغةُ التي يتحدَّث بها الأطفالُ فيما بينهم، وهي لغةٌ ذاتُ تراكيبَ مبسَّطَةٍ تخلو من الكلمات الوَظيفِية، أي إنها تَحوي أخطاء. وسُمِّيَت لغةَ الطُّفولَةِ في مقابِل لُغةِ الأُمومَةِ التي تتَّسِم بالصِّحَّة اللغويةِ على الرَّغم من بساطَتها. راجع:  @(motherese (language)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة الطفل ","nonDiacriticsLemma":"لغة الطفل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةُ الطِّفْلِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/43fa64c8-b50a-49b0-9d9b-a44d505a8e01/get-public-entry"},"browse_index_record":{"lexicalEntryId":"43fa64c8-b50a-49b0-9d9b-a44d505a8e01","word":"تَرَاجُعٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a6f","lexicalEntryId":"43fa64c8-b50a-49b0-9d9b-a44d505a8e01","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرَاجُعٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ في اللغويات الحاسوبية، وفي الإعراب الآلِيِّ تَحديداً، يَعني رُجوعَ البرنامَجِ إلى الخُطوَة السابقةِ في الإعراب لتَجريب مَسارٍ آخَرَ إذا لم يَنجَح تحليلُ جُزءِ الجُملةِ الجارِي إعرابُه بالأسلوب غيرِ المحدَّدِ nondeterministic، حيث يختار برنامَجُ الإعرابِ أحَدَ البدائلِ ويَتّبَعه إلى النِّهايَة، فإذا فَشِل رَجَع إلى نُقطة تَفَرُّعِ البَدائلِ لأَخذِ بَديلٍ آخَر. ويحتاج المُعرِبُ في هذه الحالَةِ إلى تخصيص حَيِّزٍ في الذاكرَة يُسمّى عَمُودَ الاختِزانِ stack ليُحفَظ فيه بمؤشِّر يدُلّ على مَوضِع التَّفَرُّعِ حتى يُمكِنه الرُّجوعُ إليه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تراجع ","nonDiacriticsLemma":"تراجع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرَاجُعٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

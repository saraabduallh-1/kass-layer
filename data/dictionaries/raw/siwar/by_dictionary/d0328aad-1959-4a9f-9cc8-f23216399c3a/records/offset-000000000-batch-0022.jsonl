{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/12dad903-3b53-42b6-afb5-0ce2bb046861/get-public-entry"},"browse_index_record":{"lexicalEntryId":"12dad903-3b53-42b6-afb5-0ce2bb046861","word":"فَرضِيَّةُ البَرْمَجَةِ الإحيائية","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8a6b","lexicalEntryId":"12dad903-3b53-42b6-afb5-0ce2bb046861","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرضِيَّةُ البَرْمَجَةِ الإحيائية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضيةٌ أو نظريةٌ لغويةٌ اجتِماعيةٌ تُفسِّر نُشوءَ اللغاتِ الجديدة، خاصةً اللغاتِ المولّدة creoles، كما تُفسِّر النُّمُوَّ اللغويَّ لدى الطفل، وتعتَمِد على مبادئ فِطريةِ اللغةِ التي هي مَغروسَةٌ في عَقل الإنسانِ ويتَميَّز بها عن غيره من المخلوقات. أكَّدَ هذه الفَرضيةَ أو النظريةَ ديريك بيكرتون Derek Bickerton عام 1981م، وبيَّن فيها أن الإنسانَ يُولَد ولَدَيْه قُدرَةٌ دلاليةٌ على التَّميِيز بين التراكيب، كالتَّميِيز بين الخاصِّ وغيرِ الخاصِّ، وبين الجامِدِ والمتحرِّك، وبين المؤقَّتِ وغيرِ المؤقَّت. وتَظهَر هذه الفرضيةُ في بعض اللغاتِ المولَّدَةِ التي يَتَشابَه بناؤها مهما اختَلَفَت أصولُها اللغوية، كما تَظهَر في المراحل المبكِّرَةِ من لغة الطفل، وتُفسِّر سُرعَةَ اكتسابِه للُغتِه الأم. لكن هذه النظريةَ واجَهَت مُعارَضَةً من عَدَد من اللغويين التَّطبِيقِيين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية البرمجة الإحيائية ","nonDiacriticsLemma":"فرضية البرمجة الإحيائية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرضِيَّةُ البَرْمَجَةِ الإحيائية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

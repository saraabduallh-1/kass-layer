{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4ea8aa58-ce75-4513-9700-73b85324a793/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4ea8aa58-ce75-4513-9700-73b85324a793","word":"الطَّرِيقَةُ اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9595","lexicalEntryId":"4ea8aa58-ce75-4513-9700-73b85324a793","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطَّرِيقَةُ اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌ تعليميٌّ، يُشير إلى مجموعَةٍ من طرائق تدريسِ القراءةِ في اللغة الأمّ، تنطَلِق من المبادئ اللغويةِ البِنيَويةِ لدى اللغويَّين الأمريكيَّين، أمثال ليونارد بلومفيلد Leonard Bloomfield، وتشارلز فريز Charles Fries، وغيرِهما. ولأن اللغةَ المكتوبةَ - وفقا لهذه المبادئ - تعتَمِد على اللغة المنطوقَة، فإن العلاقةَ بين اللغَتَين يجب أن يُرَكَّزَ عليها في تعليم القراءة؛ فيُبدأ بتعليم الكلماتِ التي تَتَّفِق حُروفُها مع طريقَة نُطقِها، ثم يُنتَقَل إلى الكلمات الأقَلِّ توافُقا، ويُؤَخَّر تعليمُ الكلماتِ التي تحوِي مشكلاتٍ قرائيّةً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الطريقة اللغوية ","nonDiacriticsLemma":"الطريقة اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطَّرِيقَةُ اللُّغَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

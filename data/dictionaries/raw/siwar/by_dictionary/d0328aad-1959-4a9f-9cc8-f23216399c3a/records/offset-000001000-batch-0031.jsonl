{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f484a5e5-b464-4aab-8a72-cf1871b43d1d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f484a5e5-b464-4aab-8a72-cf1871b43d1d","word":"عِلْمُ النَّفْسِ التَّرْبَوِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f47","lexicalEntryId":"f484a5e5-b464-4aab-8a72-cf1871b43d1d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ النَّفْسِ التَّرْبَوِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من فروع علم النفس، يُعنَى بالجوانب النفسيةِ للعَمَليات التربوية؛ كالاستِعداد للتعلُّم، والصحَّةِ العَقلية، والتَّوَافُقِ الاجتماعي، وقِياسِ النُّمُوِّ التربويِّ عند المتعلِّمين، وتَشخيصِ مشاكلِ التعليم. تعتَمِد عليه التربيةُ في بناء نظرياتِها، وتُطبِّق كثيرا من نظرياته ونتائجِ دراساتِه، لاسيّما المقاييسُ العقليةُ ذاتُ العلاقَةِ بالتعلُّم والتعليم. وقد استفاد علمُ اللغةِ التطبيقيُّ من نظريات علمِ النفسِ التربويِّ وتَطبيقاتِه في عَمَلية التدريس، وتَصميمِ المناهج، وإعدادِ الموادِّ التعليميةِ، وتصميمِ المقرَّرات، والتَّقييم، وبناءِ الاختباراتِ وتَنفيذِها، وإعدادِ المعلِّمين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم النفس التربوي ","nonDiacriticsLemma":"علم النفس التربوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ النَّفْسِ التَّرْبَوِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a0d910fc-2c98-45e0-a9fd-78a6260fbfb9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a0d910fc-2c98-45e0-a9fd-78a6260fbfb9","word":"حُبْسَةٌ إمْلائيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f44","lexicalEntryId":"a0d910fc-2c98-45e0-a9fd-78a6260fbfb9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حُبْسَةٌ إمْلائيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصبيٌّ، يُسمى أيضا عُسْرَ الكتابة، ويُشير إلى نوعٍ من حُبسَة الكتابةِ خاصَّةٍ بالإملاء؛ تَظهر في عَدَم قُدرَةِ المُصابِ بها على الكتابة الإملائيةِ الصحيحة، أي تَكثُر أخطاؤه الإملائيةُ على الرَّغم من قُدرَته على الكتابة أو الخَطِّ أحيانًا. وهو خَلَلٌ في قدرة المرءِ على رَبط الأصواتِ بالحُروف، وصُعوبَةٌ في التَّقسيم أو التَّوزيعِ الحَرفيِّ للكلمات، ونِسيانُ بعضِ حروفِ الكلمة، أو إضافةُ حُروفٍ ليسَت من الكلمة، أو استِبدالُ مَواقِعِ بعضِ الحروفِ المتَشَابهَةِ ببعضها في الكلمة الواحدة. وتختَلف هذه الحُبسَةُ عن الحُبسَة الكتابيةِ أو الاضطِرابِ الكِتابي الخَطِّيِّ dysgraphia.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حبسة إملائية ","nonDiacriticsLemma":"حبسة إملائية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حُبْسَةٌ إمْلائيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4f330d85-603f-4488-8bea-6ba91eb3f64d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4f330d85-603f-4488-8bea-6ba91eb3f64d","word":"لُغَةٌ مُهَيْمِنَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f40","lexicalEntryId":"4f330d85-603f-4488-8bea-6ba91eb3f64d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مُهَيْمِنَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُشير إلى اللغة المسيطِرَةِ التي يَشيع استِعمالُها في مجتَمَعٍ ما، بعد أن غَلَبَت اللغةَ الأصليةَ لهذا المجتَمَع. وتحدُث هذه السيطرَةُ لأسبابٍ سياسيةٍ أو عسكريةٍ أو دينيةٍ أو ثقافيةٍ أو اقتصادية. وقد تكون السيطرةُ للَهجَةٍ ما دون غيرِها من اللَّهَجات داخِلَ اللغةِ الواحدة. راجع:  @(dominant dialect) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نفسيٌّ اجتماعيٌّ، يُشير إلى سَيطرَة إحدى اللغاتِ التي يَتَحَدَّثُها الفَردُ - دون غيرها - في حياته، أو في مَجالٍ من مجالات حياتِه؛ كسَيطرَة لغتِه الأمِّ، أو لغتِه الثانية، أو لغتِه الأجنبية، أو سَيطرَةِ لغتِه الأمِّ على حديثه في المنزل، و سَيطرَةِ لغتِه الثانيةِ أو الأجنبيةِ عليه في دراسته أو في مَجال عَمَلِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُطلَق على اللغة الأقوَى stronger language في حياة الطفلِ ذي الثُّنائيةِ اللغويةِ المتزامِنَةِ ، أي غير المتعاقِبَة، ويُقصَد بها اللغةُ القَويةُ المهيمِنَةُ في المدخَلات والمخَرجَاتِ اللغويةِ للطفل الذي يتعرَّض للغَتَين منذُ ولادَتِه حتى بلوغِه السنةَ الرابعَةَ من عُمره. وتُقابِلها اللغةُ الأضعَفُ weaker language.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة مهيمنة ","nonDiacriticsLemma":"لغة مهيمنة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مُهَيْمِنَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

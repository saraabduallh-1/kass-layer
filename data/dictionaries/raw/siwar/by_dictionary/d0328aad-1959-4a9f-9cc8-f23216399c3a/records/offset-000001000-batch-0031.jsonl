{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5d8c10ec-5bce-4773-82c0-102e2e39b9b6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5d8c10ec-5bce-4773-82c0-102e2e39b9b6","word":"رَسْمٌ سَمْعِيٌّ كَهْرَبائِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f57","lexicalEntryId":"5d8c10ec-5bce-4773-82c0-102e2e39b9b6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رَسْمٌ سَمْعِيٌّ كَهْرَبائِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَسجيلُ التَّغَيُّراتِ الحاصِلَةِ في الجَرَيان الفَمَوِيِّ والأنفيِّ للهواء في أثناء نُطقِ الأصواتِ الكلامية، وما يَسبق ذلك من أنشِطةِ عَضَلاتِ البَطنِ والصَّدر لإخراج الهواء، باستعمال المرسَمَةِ السَّمعيةِ الكهربائيةِ، أو الراسِمِ العَضَليِّ electromyograph، وهو الراسمُ الذي يُسَجِّل كميةَ النَّشاطِ الكامِنِ في عضَلات النُّطقِ إبّان تقلُّصها واسترخائها. وباستعمال هذا الراسِمِ تمكَّن علماءُ الأصواتِ من التوصُّل إلى معظَم النتائجِ التي تَصِف حرَكاتِ الوَترَيْن الصوتييْن في أثناء الكلام، وذلك قبلَ تطَوُّرِ البرامجِ الحاسوبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"رسم سمعي كهربائي ","nonDiacriticsLemma":"رسم سمعي كهربائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رَسْمٌ سَمْعِيٌّ كَهْرَبائِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

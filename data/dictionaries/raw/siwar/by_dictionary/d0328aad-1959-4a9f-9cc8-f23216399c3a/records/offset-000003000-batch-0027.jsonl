{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/21d17d7a-e663-4962-ab30-48493679b949/get-public-entry"},"browse_index_record":{"lexicalEntryId":"21d17d7a-e663-4962-ab30-48493679b949","word":"بَرْنَامَجُ الحَدِّ الأدنَوِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96b2","lexicalEntryId":"21d17d7a-e663-4962-ab30-48493679b949","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بَرْنَامَجُ الحَدِّ الأدنَوِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مرحلةٌ حديثةٌ من مراحل تَطوِّرِ نظريةِ القواعدِ التوليديةِ لتشومسكي، طرَحها في التسعينيات من القرن العشرين، بيدَ أن مَلامِحَها بدأت تظهَر منذ أواخِر الثمانينيات. تتلخَّص فكرةُ هذا المبدأِ في التَّقليل من الوَسائل والأدواتِ والعناصِرِ الوَصفية إلى حَدِّها الأدنى. يتَّفِق هذا المبدأُ مع مبدأ الاقتصادِ  economy principleالذي يؤكِّد أن بناءَ الجُملةِ يجب أن يقتَصِر على الضَّروريِّ من العناصِر اللغويةِ الضَّروريةِ لتوليد الجُملة، وينسَجِم مع المبدأ العامِّ لاكتساب الطفلِ لغتَه الأمَّ الذي يتطلَّب - في نظَر تشومسكي - الحَدَّ الأدنى من المدخَلات اللغوية. يرى تشومسكي وأتباعُه أن هذا المبدأَ امتِدادٌ وتطوُّر طبيعيٌّ لنظرية القواعدِ التوليديةِ في سَعيها لطَرح مقولاتٍ كُلِّيَّةٍ وبسيطَةٍ حولَ اللغةِ البشَرية قدرَ الإمكان، بَيدَ أن بعضَ اللغويين يرَون أن هذا المبدأَ تحوُّلٌ عن مبادئ نظريةِ القواعدِ التوليدية؛ لاختِلاف المنهَجَين، واختِلافِ المصطلَحاتِ المستَخدَمةِ فيهما. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"برنامج الحد الأدنوي ","nonDiacriticsLemma":"برنامج الحد الأدنوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بَرْنَامَجُ الحَدِّ الأدنَوِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/727dd26a-4d77-42f4-8e68-673262dcdbf9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"727dd26a-4d77-42f4-8e68-673262dcdbf9","word":"تحليلُ الوحداتِ الصرفيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96b9","lexicalEntryId":"727dd26a-4d77-42f4-8e68-673262dcdbf9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تحليلُ الوحداتِ الصرفيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على دراسة المورفيم بوَصفه وحدةَ التَّحليلِ الصَّرفي، وهو أصغَرُ الوحداتِ اللغويةِ ذاتِ المعنى، الصالِحةِ للتَّحليل في جميع اللغات. واستُعمِل المورفيمُ وحدةً لهذا التَّحليلِ بديلا من الكلمة، ليكون هو موضوع علمِ الصرف؛ لأن تعريفَ الكلمةِ وبيانَ حُدودِها مما تَختَلِف فيه اللغاتُ، بل إن تحديدَ الكلمةِ يَختَلِف في اللغة الواحدةِ أحيانا؛ كجُموع التَّكسيرِ في العربية، والجُموعِ غيرِ القياسيةِ في الإنجليزية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل الوحدات الصرفية ","nonDiacriticsLemma":"تحليل الوحدات الصرفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تحليلُ الوحداتِ الصرفيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

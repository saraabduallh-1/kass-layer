{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d58cbb1f-5422-4083-9cc8-8528252e4e14/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d58cbb1f-5422-4083-9cc8-8528252e4e14","word":"المَعنَى المُنْعَكِسُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9bcc","lexicalEntryId":"d58cbb1f-5422-4083-9cc8-8528252e4e14","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَعنَى المُنْعَكِسُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ دلاليٌّ، يُشير إلى نَوعٍ من المعنى الإيحائيِّ، وهو المعنى الذي يَثور في حالات تَعَدُّدِ المعنى الأساس، فغالبا ما يَترُك المعنى الأكثَرُ شُيوعًا أو الأكثَرُ إلفًا أثَرَه الإيحائيَّ في المعنى الآخَر. يَتَّضِح المعنى الانعِكاسِيُّ في الكلمات ذاتِ المعاني المكرُوهَةِ أو المحظُورَة، مثلُ الكلماتِ المرتَبِطَةِ بالجِنس، ومَوضِعِ قَضاءِ الحَاجَةِ، وما له علاقةٌ بالموت، ونحوِ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المعنى المنعكس ","nonDiacriticsLemma":"المعنى المنعكس","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَعنَى المُنْعَكِسُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/715cc590-7f09-4d57-8fec-36a1b91106d6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"715cc590-7f09-4d57-8fec-36a1b91106d6","word":"تَعْلِيمٌ تَأمُّلِيٌّ للمُعَلِّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9bcd","lexicalEntryId":"715cc590-7f09-4d57-8fec-36a1b91106d6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْلِيمٌ تَأمُّلِيٌّ للمُعَلِّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"طَريقةٌ لتَأهيل المعلِّمين، بمن فيهم مُعلِّمي اللغات، تُرَكِّز على تَنمِيَة التَّفكيرِ التَّحليلِيِّ والتَّشاوُرِيّ، لتَحسينِ القُدرَةِ على التَّدريس؛ استِنادًا إلى بَيانات نَتائجِ الطلابِ، ومُمارَساتِ تَدريسٍ مَرغُوبٍ فيها، واتِّباعِ مبادئَ أخلاقيَّةٍ في التَّدريس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم تأملي للمعلم ","nonDiacriticsLemma":"تعليم تأملي للمعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْلِيمٌ تَأمُّلِيٌّ للمُعَلِّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/604ea846-991b-48a7-9214-aa32690b8368/get-public-entry"},"browse_index_record":{"lexicalEntryId":"604ea846-991b-48a7-9214-aa32690b8368","word":"تَدْرِيسٌ تَأَمُّلِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9bce","lexicalEntryId":"604ea846-991b-48a7-9214-aa32690b8368","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيسٌ تَأَمُّلِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَشاطٌ تَدريسِيٌّ يُستَخدَم في برامج إعدادِ المعلِّمين، ويَهدِف إلى إمداد الطلابِ المعلِّمين بِخبراتٍ تَدريسِيَّةٍ جيِّدة، وفُرَصٍ حَقيقِيَّةٍ للتَّأمُّل في طَبيعَة التَّدريسِ ومَعرِفةِ أهدافِه، وإمكانيةِ التَّحَقُّقِ من أدائهم في مُحاوَلَةٍ لتَحسين التَّعلُّم لدى طلابِهم. يَتضمَّن هذا التدريسُ أربعَ مَراحِل: تبدأ بتَقسيم الطلابِ إلى مَجموعاتٍ صغيرةٍ، ثم إعطاءِ كلِّ المجموعاتِ دَرسًا واحِدًا جديدًا لتَدريسِه، يلي ذلك تَدريسُ كلِّ فَردٍ لمجموعَته مع رَصد مُخرَجاتِ التَّدريسِ باختِبارٍ تَحريريٍّ، ثم تَدريسٍ تَأمُّلِيٍّ يُرَكَّز فيه على آثار الخِبرَةِ التَّدريسِيَّةِ ونَوعِيَّتِها.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مَذهَبٌ في التَّدريس وإعدادِ المعلِّمين؛ يَنطَلِق من فَرضِيَّةٍ مُؤدّاها أن المعلِّمين يُمكن أن يُطَوِّروا فَهمَهم لعَمَليَّة التَّدريسِ بالتَّأمُّل النَّقدِيِّ في خِبراتهم التَّدريسِيَّة. وتَتَضَمَّن بَرامجُ تَدريبِ المعلِّمين أنشِطَةً تَهدِف إلى التَّأمُّل العَميقِ في عَملِيَّة التَّدريسِ ومَهاراتِه، وتَتَضَمَّن:\r\nأ- سِجِلاتٌ أو يومِيّاتٌ يَكتُبها الطلابُ المعلِّمون عن التَّدريس؛ يَصِفون فيها خِبراتِهم فيه، ويَنطَلِقون منها للمُرَاجَعَة والتَّأمُّل.\r\nب- تَسجيلُ الدُّروسِ على أشرِطَة فيديو أو في بَرامجَ حاسُوبيةٍ للاستِفادَة منها فيما بعد في المراجَعَة والتَّأمُّل.\r\nج- مُناقَشَةٌ جَماعيَّةٌ مع الزُّملاء أو مع المشرِفين حول ما تَمَّ إنجازُه؛ لتَكوِين الأفكارِ، والتَّأمُّلِ في مُخرَجات هذه الخِبرات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريس تأملي ","nonDiacriticsLemma":"تدريس تأملي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيسٌ تَأَمُّلِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

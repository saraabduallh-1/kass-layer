{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ddf1309c-3077-4cad-ac47-f6b99bd1006c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ddf1309c-3077-4cad-ac47-f6b99bd1006c","word":"سَابِقَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a41","lexicalEntryId":"ddf1309c-3077-4cad-ac47-f6b99bd1006c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سَابِقَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"زائدةٌ أو مُورفيمٌ مُقَيَّدٌ يَسبِق الجِذرَ ويُكوِّن معه كلمةً واحدةً، فيُغيِّر معنى الكلمةِ أو وَظيفتَها. مثلُ همزَةِ التَّعديَةِ وحُروفِ المضارَعَةِ في العربية، ومثلُ:  un, im, dis, في الكلمات الإنجليزيةِ: unlike, impossible, dislike. والسَّوابِقُ تُقابِلها اللَّواحِق suffixes التي تَلحَق أواخِرَ الكلماتِ وتُغَيِّر معانيَها أو وَظائفَها. أما الحروفُ الزائدةُ في داخِل الكلمةِ التي تُغيِّر معناها أو وَظيفتَها، فتُسمَّى دَواخِلَ infixes؛ كالأصوات التي تَدخُل المشتَقَّاتِ العربيةَ في الأفعال والأسماء، ومنها الألِفُ التي تُعبِّر عن صِيغَة الفاعِلِ فيُفَرَّق بها بين كلمَتَيْ: (كَتَبَ) و(كاتِب).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"A","root":null,"wordForms":[],"relatedSenses":[],"search":"سابقة ","nonDiacriticsLemma":"سابقة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سَابِقَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

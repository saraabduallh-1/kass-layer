{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4574a0e6-e41d-4969-9fde-ae4cc6410e3a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4574a0e6-e41d-4969-9fde-ae4cc6410e3a","word":"أَدَاةٌ مُتَأخِّرَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a3a","lexicalEntryId":"4574a0e6-e41d-4969-9fde-ae4cc6410e3a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَدَاةٌ مُتَأخِّرَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مورفيمٌ أو كلمةٌ تأتي بعد الاسمِ أو الضميرِ أو شِبهِ الجُملةِ الاسميِّ، وتُشير إلى المكان أو الاتِّجاهِ أو المِلكية؛ فهي تُشبه أداةَ الجَرِّ في كلِّ شيءٍ إلا أنها لاحِقَةٌ للمَجرور. تَشيع هذه الأداةُ في اللغة اليابانيةِ حيث تَعمَل حُروفُ الجرِّ في الأسماء التي تَسبقها، وتُستَعمَل بكثرَةٍ في الفِنلَّندية، وتوجَد بقِلَّةٍ في الإنجليزية؛ فالكلمةُ الإنجليزيةُ: notwithstanding يُمكن أن تُستَعمَل في كلا التَّركيبَين: السَّائدُ وهو المتقدِّمُ preposition، والقليلُ وهو المتأخِّرُ postposition، فيَصحُّ أن يُقال: The plan went ahead, my protests notwithstanding، كما يُقال: The plan went ahead, notwithstanding, my protests. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أداة متأخرة ","nonDiacriticsLemma":"أداة متأخرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَدَاةٌ مُتَأخِّرَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"auto
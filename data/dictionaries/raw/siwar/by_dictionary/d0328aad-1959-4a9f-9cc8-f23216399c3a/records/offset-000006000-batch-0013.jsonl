{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c0b63a73-7e7e-4649-8fdb-79a8fe4a9a72/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c0b63a73-7e7e-4649-8fdb-79a8fe4a9a72","word":"وَقْتُ الانْتِظَار","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba162","lexicalEntryId":"c0b63a73-7e7e-4649-8fdb-79a8fe4a9a72","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَقْتُ الانْتِظَار","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مهارةٌ في طَرح معلِّمِ اللغةِ للسؤال، وهي مُدَّةُ التَوَقُّفِ التي تكون بين طَرحِ المعلِّمِ للسُّؤال وإجابَةِ الطالبِ عنه، وتتَّضِح مَهارَةُ المعلِّمِ في مدَى دِقَّتِه في التَّوقيت لهذه المدَّة والتِزامِه بها. فالمعلِّمُ الذي يَستَعجِل الإجابةَ فيُجيب بنفسه عن الطالب، أو يَطلُب الإجابةَ من طالِبٍ قبلَ نهايَةِ الوَقت، غيرُ ماهِرٍ في طَرحِ السؤال، ومِثلُه المعلِّمُ الذي يمنَح الطالِبَ وَقتا يزيد على المدَّة المخصَّصَة. ودِقَّةُ المعلِّمِ في تحديد مدَّةِ الانتِظار وتَنفيذِها - سواء قبلَ إجابَةِ الطالبِ أو بعدَها - تُتِيح لأكبَر عَدَدٍ من الطلاب فُرَصَ المشارَكَةِ ومَمارَسَةَ اللغةِ في الفَصل. وتُطبَّق هذه المهارَةُ في دراسات التفاعُل الصَّفِّيِّ في فصول تعليمِ اللغات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلَحٌ حاسوبيٌّ، يُشير إلى المدَّة الزَّمَنِيَّةِ بين اللَّحظَةِ التي تُعطَى فيها التَّعليماتُ وتَنفيذِها أو عَودَةِ النَّتيِجَة، مثل الزَّمَنِ بين طَلَبِ البياناتِ وانتِقالِ البياناتِ من الذاكِرَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وقت الانتظار ","nonDiacriticsLemma":"وقت الانتظار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَقْتُ الانْتِظَار"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

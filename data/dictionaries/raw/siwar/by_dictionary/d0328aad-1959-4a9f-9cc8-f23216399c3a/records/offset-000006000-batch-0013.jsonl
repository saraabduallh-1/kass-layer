{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eed6543a-88d9-4673-ad56-e881d60d6a9a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eed6543a-88d9-4673-ad56-e881d60d6a9a","word":"تَرَاكِيبُ رَأْسِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba14f","lexicalEntryId":"eed6543a-88d9-4673-ad56-e881d60d6a9a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرَاكِيبُ رَأْسِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اللغة المرحَلِيّة، يُطلَق على تراكيبَ وأبنيَةٍ لغويةٍ يستَعمِلها متعلِّمُ اللغةِ في مرحَلَةٍ من مراحِل التعلُّم، تَتَمثَّل في اقتِراض أنماطٍ وتراكيبَ تَعَلَّمها في مراحِلَ أو مواقِفَ سابِقَة، مع إضافَةِ صِيَغٍ أخرى إليها من عنده. ففي قَولِ متعلِّمِ الإنجليزيةِ: No come here، يُحتَمَل أنه اقتَرَض النّمَطَ: come here من استِعمال سابِقٍ ثم أضاف إليه أداةَ النَّفْيِ: no بطَريقَةٍ غيرِ سَليمَة. يَرَى بعضُ اللغويين أن ظُهُورَ التراكيبِ العَمودِيَّةِ في لغة المتعلِّمِ مؤشِّرٌ على ظُهُور التراكيبِ الأفُقيَّةِ horizontal constructions","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تراكيب رأسية ","nonDiacriticsLemma":"تراكيب رأسية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرَاكِيبُ رَأْسِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d2be969c-596d-49e6-980f-a1b6907240a2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d2be969c-596d-49e6-980f-a1b6907240a2","word":"الإنجلِيزِيَّةُ المِهْنِيَّةُ لُغَةً ثانِيَةً","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba150","lexicalEntryId":"d2be969c-596d-49e6-980f-a1b6907240a2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنجلِيزِيَّةُ المِهْنِيَّةُ لُغَةً ثانِيَةً","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تعلُّمُ الإنجليزيةِ وتَعليمُها لغةً ثانيةً لأغراضٍ مِهنِيَّة. كما يَعني المصطلح أيضا اللغةَ الإنجليزيةَ المهنيةَ لغةً ثانيةً. وهو مجالُ تعلُّمٍ تفاعُليٍّ عبرَ الحاسِبِ الآليِّ، يُتيح للمستَخدِم القيامَ بمجموعَةٍ من أنشِطَة التعليمِ والتعلُّمِ الإبداعيِّ؛ كالقيام برحلَةٍ ميدانيةٍ افتراضيةٍ عبرَ مَوقِعٍ إلكترونيٍّ للتعلُّم التفاعُليِّ بمحاكاةٍ ثلاثيةِ الأبعاد. وتتوفر هذه البرامِج أيضا في أجهزَة الحاسوبِ الصغيرة، والألعابِ الإلكترونيةِ المحمولة، والتلفزيونِ التفاعُليّ، والأنظمَةِ المسجَّلَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية المهنية لغة ثانية ","nonDiacriticsLemma":"الإنجليزية المهنية لغة ثانية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنجلِيزِيَّةُ المِهْنِيَّةُ لُغَةً ثانِيَةً"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6d3e715a-e005-4ce9-89aa-79c4d37885b3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6d3e715a-e005-4ce9-89aa-79c4d37885b3","word":"الحِبَالُ الصَّوْتِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba151","lexicalEntryId":"6d3e715a-e005-4ce9-89aa-79c4d37885b3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الحِبَالُ الصَّوْتِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"شَريطان عَضَليّان مَرِنان يُشبِهان الشَّفَتَين، يَقعان في الحَنجرَة في قِمَّة القَصَبةِ الهوائية، ويَمتدّان أفُقِيًّا إلى الحَلق حتى يَرتَبِطا من الأمام بالغُضروف الدَّرَقِيِّ البارِزِ المعروفِ بتفاحة آدم، وهما أهمُّ أجهزَةِ التَّصويتِ لدى الإنسان. ولهما أوضاعٌ مختَلِفةٌ وحَرَكاتٌ معقَّدَة، بَيدَ أن أهمَّها ثلاثةٌ تُؤثِّر في الأصوات الكلامية، الأوّل: الانقِباضُ التّامُّ الذي يَصحَبه انفِجارٌ كما في حال النُّطقِ بالهمزة العربية. والثاني: الانفِراجُ التّامُّ، وهو حالُ استِرخاءٍ دونَ تَذبذُبٍ كما في حال التَّنفُّسِ العادِيِّ ونُطقِ الأصواتِ المهموسَة. والثالثُ: حالٌ بين الانقِباضِ والانفِراج، أو التَّذبذُبِ والتَّوَتُّر، كما في حال الكلامِ العادِيّ. ولها أسماءٌ مختَلِفةٌ مثلُ: vocal cords (chords), vocal folds, vocal bands. وتُسمّى في العربية أحيانا بالحِبال الصَّوتيَّة، بالنَّظر إلى أن كلَّ واحدٍ منها لَفيفٌ من الحِبال، ويرَى بعضُ الكُتّاب أن ذلك راجعٌ إلى ترجَمتها من الإنجليزية التي هي بصيغَة الجَمعِ حيث لا صيغةَ للتَّثنية في الإنجليزية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/091e39cc-a484-4676-8a19-3891a36b5f8c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"091e39cc-a484-4676-8a19-3891a36b5f8c","word":"تَوضيحُ القِيَمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba15a","lexicalEntryId":"091e39cc-a484-4676-8a19-3891a36b5f8c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوضيحُ القِيَمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نشاطٌ تعليميٌّ تَوَاصُليٌّ يَقود الطلابَ إلى اكتشاف قيَمِهم واتجاهاتِهم نحوَ موضوعٍ ما يَطرحُه المعلِّمُ عليهم؛ فيُنَبِّه الطلابَ إلى الجوانب الإيجابيةِ والجوانبِ السَّلبِيَّةِ في ثقافاتهم ومجتَمَعاتِهم، ويُطْلعهم على قِيَم الآخرِين واتجاهاتِهم وثقافاتِهم. مثالُ ذلك، أن يَسأل المعلِّمُ الطلابَ عن كَيفيَّة التَصَرُّفِ حين يَعتَدِي أحَدٌ على بيُوتهم أو على مُمتَلَكاتهم، فحينئذٍ تَظهَر الفُروقُ بين القِيَمِ والثقافاتِ في الإجابة عن هذا السؤال، ويَكتَشِف بعضُهم المزايا والعُيُوبَ التي تُرافِق التصرُّفَ تجاهَ هذا الحَدَثِ في بيئته ومجتَمَعِه، ويَطَّلِع على تصرُّفات المجتَمعاتِ الأخرى نحوَ الحَدَثِ نفسه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"توضيح القيم ","nonDiacriticsLemma":"توضيح القيم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَوضيحُ القِيَمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}
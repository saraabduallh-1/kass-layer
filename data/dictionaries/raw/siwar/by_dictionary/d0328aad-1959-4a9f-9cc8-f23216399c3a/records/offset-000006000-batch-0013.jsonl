{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ee1f4855-535e-4f14-b97b-2a03df38a187/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ee1f4855-535e-4f14-b97b-2a03df38a187","word":"نَظَرِيَّةُ المَوْجَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba153","lexicalEntryId":"ee1f4855-535e-4f14-b97b-2a03df38a187","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ المَوْجَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويةٌ اجتِماعيةٌ، طوَّرَها بيلي C. J. Bailey عام 1973م، لتَفسير التَّغَيُّرِ اللغويّ، حتى سُمِّيَت: Wave Theory of language change، وتُختصر أحيانا إلى: Wave Theory of language. يرَى صاحب هذه النظريةِ أن التَّغيُّرَ الذي يحدُث في لَهجَةٍ ما يَسير في شَكل مَوجاتٍ يُمكن تَمثيلُها على رَسمٍ بَيَانِيّ، يَتَّضِح فيه أن هذا التَّغَيُّرَ يَخِفُّ كلَّما زادَت المسافةُ الجغرافيةُ التي تَفصِل تلك اللَّهجَةَ عن اللَّهَجات الأخرى، وأن اللَّهَجاتِ المتَباعِدَةَ تَفتَرِق تَدريجِيًّا حتى تُصبِح لغاتٍ مستَقلَّة. توضِّح هذه النظريةُ أيضا كَيفِيَّةَ انتِشارِ قواعدَ معيَّنةٍ من بيئةٍ إلى أخرى، وكَيفِيةَ بُروزِ قواعدَ جديدة. وقد اتُّخِذ مَسارُ العائلَةِ الهنديةِ الأوروبيةِ، في النِّصف الثاني من القرن السابِع عشَر الميلاديِّ، مثالا على ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية الموجات ","nonDiacriticsLemma":"نظرية الموجات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ المَوْجَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/13ea2dc2-0872-4a06-b251-45f02a828568/get-public-entry"},"browse_index_record":{"lexicalEntryId":"13ea2dc2-0872-4a06-b251-45f02a828568","word":"مَنْطِقَةُ فِيرنِيكَه","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba154","lexicalEntryId":"13ea2dc2-0872-4a06-b251-45f02a828568","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَنْطِقَةُ فِيرنِيكَه","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منطقةُ الحِسِّ في الدِّماغ، وهي أحدُ مَراكزِ اللغةِ الثلاثةِ الرَّئيسةِ في الدِّماغ، إضافةً إلى منطقة برُوكا والتَّلفِيفَةِ الزَّاوِيِّة. وسُمِيت بهذا الاسمِ نسبةً إلى طبيب الأعصابِ الألمانيِّ كارل فِيرنِيكَه Carl Wernicke الذي اكتَشفَها عام 1874م. وتَقَع بالقُرب من منطقة السَّمعِ في الفَصِّ الصَّدَغِيِّ من القِشرَة الدِّماغيّة، ويَربطها بمنطقة برُوكا حزمَةٌ من الألياف العَصَبيَّةِ المسماةِ بحزمَة الأليافِ المقَوّسَةِ arcuate fasciclulus، ومُهِمَّتُها استقبالُ المدخَلاتِ السَّمعيةِ وفَهمُ المعاني. والتَّلَفُ في هذه المنطقة تنتُج عنه حُبسَةُ فِيرنِيكَه أو الحُبسَةُ الحِسِّيَّةُ sensory aphasia ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"منطقة فيرنيكه ","nonDiacriticsLemma":"منطقة فيرنيكه","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَنْطِقَةُ فِيرنِيكَه"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

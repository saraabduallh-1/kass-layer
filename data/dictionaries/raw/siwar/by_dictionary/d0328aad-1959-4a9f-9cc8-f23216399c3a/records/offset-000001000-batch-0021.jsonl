{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/69be2a0b-6429-4b0c-909d-216b5a707ffd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"69be2a0b-6429-4b0c-909d-216b5a707ffd","word":"عِلْمُ اللُّغَةِ الوَصْفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e5a","lexicalEntryId":"69be2a0b-6429-4b0c-909d-216b5a707ffd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ الوَصْفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على علم اللغةِ الحديثِ منذ نشأتِه في أواخِر القرنِ التاسع عشَر وبدايةِ القرنِ العشرين، ولاسيَّما الاتجاهُ البِنيَويُّ الذي سيطَرَ على الدراسات اللغويةِ حتى أواخِرِ الخمسينيات من القرن العشرين؛ لاعتِماده منهَجَ دراسَةِ اللغةِ دراسةً وَصفيةً بنيويةً شَكليةً. وغالبا ما يُقابَل هذا العلمُ بالدراسة المِعيارِيةِ للغة prescriptive linguistics؛ الذي يُعنَى بتَقنِين الاستعمالِ المعيارِيِّ للغة، وفَرضِ هذا الاستعمالِ في تعليم اللغةِ على هيئة قواعدَ صارِمَة، سواء أكانت مستَعمَلةً أم غيرَ مستَعمَلة. لكن هذا العلمَ أصبَح الآنَ يُذكَر في مُقابِل علمِ اللغةِ المعرِفِيِّ cognitive linguistics الذي ظَهَرَ على يَدي تشومسكي في أواخِر الخمسينياتِ من القرن العشرين، واختَلَف عنه في أهدافه ومنهَجِه من دراسة اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وصفٌ يُطلَقه بعض اللغويين على دراسة لُغةٍ مُعيَّنة، كالعربية والإنجليزية والفرنسية مثلا، في مُقابِل علمِ اللغةِ العامِّ general linguistics الذي يُعنَى بدراسة اللغةِ من حيث هي ظاهرةٌ بَشَرِيةٌ تُميِّز الإنسانَ عن المخلوقات الأخرى، ونظامٌ يَتَمَيَّز عن الأنظِمة الإبلاغِيَّة الأخرى، وتَعتَمِد عليه دراسَةُ اللغةِ الخاصَّة. وهذا التَّفريقُ يَتَّصِل بالتَّفريق بين اللغةِ بوَصفِها ظاهرَةً عامَّة، واللغةِ المعيَّنةِ حين تكون موضوعَ الدراسةِ الوَصفيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة الوصفي ","nonDiacriticsLemma":"علم اللغة الوصفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ الوَصْفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

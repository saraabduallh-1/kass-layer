{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a0f53c3b-3611-49dc-ac6a-68511b182b9a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a0f53c3b-3611-49dc-ac6a-68511b182b9a","word":"لُغَةٌ مُزَاحَةٌ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e4b","lexicalEntryId":"a0f53c3b-3611-49dc-ac6a-68511b182b9a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مُزَاحَةٌ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُطلَق على أيِّ لغة تقَهقَرَت أمامَ لغةٍ أخرى حَلَّت محَلَّها في الاستعمال السائدِ في مجتَمَعٍ ما؛ نتيجةَ عواملَ ثقافيةٍ أو سياسيةٍ أو عسكرية، كما حَصَل لكثيرٍ من لغات الشعوبِ الإسلاميةِ حين حَلَّت العربيةُ محلَّها نتيجَةَ الفَتحِ الإسلاميِّ، خاصةً فيما يُعرَف الآنَ بالوطن العربيِّ في الشرق الأوسَطِ وشمالِ إفريقيا، ولغاتِ الهُنودِ الحُمرِ في أمريكا الشماليةِ التي حَلَّت محلَّها الإنجليزيةُ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة مزاحة  ","nonDiacriticsLemma":"لغة مزاحة ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مُزَاحَةٌ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f2bfd384-b25a-4aa0-952e-dcbad3b8fcca/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f2bfd384-b25a-4aa0-952e-dcbad3b8fcca","word":"إِزاحَةٌ عَن الغَائِبِ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e4c","lexicalEntryId":"f2bfd384-b25a-4aa0-952e-dcbad3b8fcca","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إِزاحَةٌ عَن الغَائِبِ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سِمَةٌ من سمات اللغة البَشَرِية التي تميِّزها من معظَم أنظِمَةِ التواصُلِ لدى المخلوقاتِ الأخرى، أو سِمَةٌ من سِمات التخطيطِ فيها، كما يَرَى اللغويُّ الأمريكيُّ تَشارلز هوكيت Charles Hockett، تُمَيِّزها من أيِّ نظامٍ رَمزِيٍّ للتواصُل لدَى المخلوقاتِ الأخرى. فالإنسانُ قادِرٌ على أن يتحدَّث عن الماضي والحاضِرِ والمستَقبل، ويَستَعمِل لذلك أفعالا في أزمنِة مختَلِفة، ويُخطِّط لما سوف يقوم به في المستَقبَل بلغة المستَقبَل، وقد يتلاعَب بالأزمِنة والأحداثِ بلغةٍ واضِحَةِ المقصَد، في حين لا يتعدَّى الحيوانُ أو الطَّيرُ الحَدَثَ الذي يَعيش فيه وزَمنَه؛ فلا يتحدَّث عن الماضي ولا عن المستَقبَل، إلا في حالاتٍ نادِرَةٍ جدا ومحدودَة؛ كاللغة المصطَنَعَةِ لدى أنواعٍ من القُرود، وكلُغَة النَّحلِ في البَحث عن الرحيق. ويُطلَق مصطلَحُ الإزاحَةِ displacement أحيانا، لاسيَّما حين يُستَعمَل وحدَه، فيُقصَد به المعنى اللغويُّ التركيبيُّ الذي هو نَقلُ عُنصُرٍ لغويٍّ، كالنَّغمَة والنَّبرِ والكلمةِ والعبارةِ ونحوِها، من مَوضِعه الأصليِّ إلى مَوضِعٍ آخَر. راجع:  @(design features) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إزاحة عن الغائب  ","nonDiacriticsLemma":"إزاحة عن الغائب ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إِزاحَةٌ عَن الغَائِبِ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f217be35-273f-4173-bc4f-9558e1ab283e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f217be35-273f-4173-bc4f-9558e1ab283e","word":"التَّعَلُّمُ عن بُعْدٍ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e4d","lexicalEntryId":"f217be35-273f-4173-bc4f-9558e1ab283e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّعَلُّمُ عن بُعْدٍ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"طريقةٌ في التعلُّم والتعليم، لا ترتَبِط بمكانٍ معيَّن، وإنما يَتواصَل بها الطلابُ مع أساتذتهم مهما تباعَدَت مَواقِعُهم، عبرَ وسائلَ تَقنِيَةٍ مسموعةٍ ومرئيةٍ ومَقروءة. وقد بدأ التعلُّمُ عن بُعدٍ باستعمال الكتُب والأشرِطَة، والتواصُل بالهاتِف، ثم تطوَّر إلى استعمال الأقمارِ الصناعية، ثم ظهَرَت تَقنِياتُ الاتصالِ عبرَ الشَّبَكاتِ الحاسوبيةِ والمواقِعِ الإلكترونيةِ التي تُتيح التَّفاعُلَ الحيَّ بين المعلِّم والمتعلِّم بتكلفةٍ ماليةٍ منخَفضَة، وأصبَحَ التعلُّمُ عن بُعدٍ يعتَمِد على علمٍ آخَرَ هو التعلُّمُ الإلكترونيُّ E-learning. وعلى الرَّغم من أهمية هذا النوعِ من التعلُّم فإن تعلُّمَ اللغاتِ عن بُعد - حتى مع استِعمال التِّقَنِية - يُفقِدُه أهمَّ جوانِبِه وهو التفاعُلُ الحيُّ والتواصُلُ الحقيقيُّ باللغة الهَدَف، لا بين المعلِّمِ وطلابِه وحَسب، وإنما بين الطلابِ أيضا.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التعلم عن بعد  ","nonDiacriticsLemma":"التعلم عن بعد ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّعَلُّمُ عن بُعْدٍ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

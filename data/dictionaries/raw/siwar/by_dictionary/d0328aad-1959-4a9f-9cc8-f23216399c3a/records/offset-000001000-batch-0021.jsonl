{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dc95b48a-f994-44b8-bec4-b1589ec42d7a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dc95b48a-f994-44b8-bec4-b1589ec42d7a","word":"أخْطَاءُ نُمُوٍّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e4f","lexicalEntryId":"dc95b48a-f994-44b8-bec4-b1589ec42d7a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أخْطَاءُ نُمُوٍّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الأخطاءُ الشائعةُ بين متعلِّمي اللغة، التي ليسَت هَفَوَاتٍ ولا زَلّاتِ لِسانٍ، ولكنها أخطاءٌ منتَظمَةٌ تحدُث نتيجةَ النُّمُوِّ اللغويِّ المرحَليِّ لدى المتعلِّمِ في مراحِلَ معيَّنَةٍ لأسبابٍ محدَّدَة؛ كتَدَخُّل أنظِمَةِ لغتِه الأمِّ في اللغة الهَدَف، وتَعميمِ قاعِدَةِ نَمَطٍ ما على نَمَطٍ أو أنماطٍ لا تَنطَبق عليها القاعدَةُ، والقِياسِ الخاطِئ، ونحوِ ذلك. مثالُ ذلك أن يَجمَع متعلِّمُ العربيةِ  كلمات: تِلميذ ومَدرَسَة ومعهَد، على تلميذون ومَدْرَسات ومعْهَدون، بدَلا من: تلاميذ ومدارس ومعاهد، على التوالي؛ وأن يَستَعمِل متعلِّمُ الإنجليزيةِ: comed, goed, breaked,  صيَغا للفعل الماضي في الإنجليزية بدلا من الصِّيَغ: came, went, broke، على التوالي. وهذه الأخطاءُ غالِبا ما تَزول في مرحَلةٍ أو مراحِلَ لاحِقَةٍ بطريقَةٍ مَرحَليةٍ منتَظِمَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أخطاء نمو ","nonDiacriticsLemma":"أخطاء نمو","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أخْطَاءُ نُمُوٍّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/acb5591e-a366-4771-bc41-2cea3f5c083c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"acb5591e-a366-4771-bc41-2cea3f5c083c","word":"مَرَاحِلُ النُّمُوِّ (اللُّغَوِيِّ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e50","lexicalEntryId":"acb5591e-a366-4771-bc41-2cea3f5c083c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَرَاحِلُ النُّمُوِّ (اللُّغَوِيِّ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مراحلُ النُّمُوِّ اللغويِّ التي يَمُرُّ بها الطفلُ في اكتسابه لغتَه الأم، وكذلك مراحِلُ النُّمُوِّ اللغويِّ التي يَمُرُّ بها متعلِّمو اللغةِ الثانيةِ أو اللغةِ الأجنَبيةِ من الصِّغار أو الكِبار، المعروفَةِ باللغة المرحَلية. وهذه المراحِلُ في اكتساب الطفلِ لغتَه الأمَّ لدى الباحثين في علم اللغةِ النفسي تختَلِف عن المراحِل التي حدَّدَها عُلماءُ النَّفس، ولاسيما عالمُ النفسِ السويسريِّ جان بياجيه. راجع:  @(interlanguage) و  @(Piagetian developmental stages) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مراحل النمو (اللغوي) ","nonDiacriticsLemma":"مراحل النمو (اللغوي)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَرَاحِلُ النُّمُوِّ (اللُّغَوِيِّ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

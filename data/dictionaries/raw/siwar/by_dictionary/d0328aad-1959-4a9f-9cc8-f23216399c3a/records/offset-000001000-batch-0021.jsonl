{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9df2d99e-d921-4b60-bba5-eb35aafe97fe/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9df2d99e-d921-4b60-bba5-eb35aafe97fe","word":"دِرَاسَةُ المُذَكِّرَاتِ اليَوْمِيَّةِ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e52","lexicalEntryId":"9df2d99e-d921-4b60-bba5-eb35aafe97fe","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دِرَاسَةُ المُذَكِّرَاتِ اليَوْمِيَّةِ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَسيلةٌ من وَسائل جَمعِ المادةِ العلميةِ في البحث في اكتساب اللغات الثانيةِ والأجنبية، ولاسيَّما في دراسة الحالَة، وغالبا ما تُضاف إلى المعلومات المجموعةِ بوسائل أخرى في الدراسة، كالاختبارات والاستِبانات والمقابَلات. وفيها يُسَجِّل الباحِثُ في كل يومٍ مَلحوظاتِه على سلوك الطالبِ المدروسِ ونُمُوِّه اللغوي، مع وَصفٍ دَقيقٍ للمَوقِف والسِّياقِ وغيرِهما مما تتَطَلَّبه الدراسة. وربما تكون هذه المذكراتُ تجاربَ وخِبراتٍ شخصيةً يدوِّنها الباحثُ عن مَسيرَته حين كان يتعلَّم لغتَه الثانيةَ أو الثالثةَ أو الأجنبيةَ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دراسة المذكرات اليومية  ","nonDiacriticsLemma":"دراسة المذكرات اليومية ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دِرَاسَةُ المُذَكِّرَاتِ اليَوْمِيَّةِ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ea8f1524-82eb-4ea5-859d-aeb3ae6305c4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ea8f1524-82eb-4ea5-859d-aeb3ae6305c4","word":"انْتِشَارٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e53","lexicalEntryId":"ea8f1524-82eb-4ea5-859d-aeb3ae6305c4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"انْتِشَارٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُشير إلى حال اللغةِ حين تَنتَشِر في مناطِقَ مختَلِفةٍ من العالَم؛ كانتِشار العربيةِ في العالم الإسلاميِّ إبَّان الفتوحاتِ، وانتِشارِ الإنجليزيةِ في العَصر الحاضِرِ في معظَم أنحاءِ العالَم، وانتِشارِ الروسيةِ إبَّان هَيمَنَةِ الاتحادِ السوفياتيِّ السابِقِ وانتِقالِها إلى أجزاء من أوروبا. وقد يَعقُب انتِشارَ اللغةِ وتَوَسُّعَها التَّبَدُّدُ والانحِلالُ dispersion، كما حَصَل للغَة الإيطاليةِ حين اكتَسبَت انتِشارا وتَوَسُّعا على أيدي المهاجِرين إلى مختَلِف أنحاءِ العالَم، ثم خضَعَت لعامِل التَّبَدُّدِ والانحِلالِ حتى فَنِيَت بعد الجيلِ الثاني أو الثالثِ من هؤلاء المهاجِرين. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُطلَق على انتِشار الكلماتِ وتَغَيُّرِ نُطقِ الأصواتِ بطريقَةٍ تدريجيةٍ من شخصٍ إلى آخَرَ أو من مجتَمَعٍ إلى آخَرَ في ضوء أنموذَجِ الموجاتِ في علم اللغةِ التاريخي. ويُطلَق المصطلحُ أيضا على انتِشار الطَّيفِ الصوتي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"انتشار ","nonDiacriticsLemma":"انتشار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"انْتِشَارٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

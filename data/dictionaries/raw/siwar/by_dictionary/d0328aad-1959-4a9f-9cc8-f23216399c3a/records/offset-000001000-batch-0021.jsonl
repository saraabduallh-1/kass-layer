{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dfe754af-e33f-48b0-be5f-512f28cb9bd0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dfe754af-e33f-48b0-be5f-512f28cb9bd0","word":"عِلْمُ اللُّغَةِ النَّمَائِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e5c","lexicalEntryId":"dfe754af-e33f-48b0-be5f-512f28cb9bd0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ النَّمَائِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرعٌ من فروع علمِ اللغةِ النفسيِّ، بل هو أهمُّ فُروعِه، يُعنَى بدراسة اكتسابِ اللغة؛ فيُعنَى بالنُّمُوِّ اللغويِّ لدَى الطفلِ في اكتسابه لغتَه الأمَّ، وباللغة المرحَليةِ لدَى متعلِّمِ اللغةِ الثانية. وقد يُستَعمَل مُرادِفا لاكتساب اللغةِ language acquisition، كما يُستَعمَل مُرادِفا لعلم اللغةِ النفسيِّ النَّمَائيِّ، أو علمِ نَفسِ النُّمُوِّ اللغويِّ. راجع:  @(developmental psycholinguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، استَعمَله ريتشارد بايلي Richard Bailey، لوَصف نظرَتِه للُّغة بأنها نظامٌ من الأنماط الحيَّةِ المتطوِّرَةِ تاريخيًّا، خِلافا للنظرَة التي ترَى أن تطوُّرَ اللغةِ يعتَمِد على سُلوك الجماعَةِ الناطِقَةِ بها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة النمائي ","nonDiacriticsLemma":"علم اللغة النمائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ النَّمَائِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/947a8519-3ee4-42f6-9c56-f9bd57f45aa5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"947a8519-3ee4-42f6-9c56-f9bd57f45aa5","word":"تَدْرِيسٌ تَشْخِيصِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e5d","lexicalEntryId":"947a8519-3ee4-42f6-9c56-f9bd57f45aa5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيسٌ تَشْخِيصِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نمطٌ من أنماط التدريس، يَسعَى إلى تحديد احتياجاتِ المتعلِّم ومشكلاتِه تَمهيدا لعِلاجها. وتَظهَر أهميةُ هذا النمَطِ في تدريس اللغاتِ حين تتَفاوَت خَلفياتُ الطلابِ اللغويةُ والثقافيةُ، ويُلاحِظ المعلِّمُ ضَعفَ بعضِ طلابِ الصَّفِّ الواحد، أو صُعوبةَ لحاقِهم بزملائهم؛ فيتطلَّب الأمرُ حينئذٍ تَشخيصَ هذه المشكلةِ وعِلاجَها؛ ليَلحَق هؤلاء الطلابُ الضِّعافُ ببَقِيَّة زملائهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريس تشخيصي ","nonDiacriticsLemma":"تدريس تشخيصي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيسٌ تَشْخِيصِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/02ac018c-60f9-4d20-806d-1979f33eaf2f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"02ac018c-60f9-4d20-806d-1979f33eaf2f","word":"تَقَارُبٌ لَهَجِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e5e","lexicalEntryId":"02ac018c-60f9-4d20-806d-1979f33eaf2f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَقَارُبٌ لَهَجِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلٌح لغويٌّ اجتماعيٌّ، يُقصَد به التغيُّرُ اللغويُّ لبَعض اللغاتِ نتيجَةَ تَضييق الفَجوَةِ بين لهجَتَين تنتَمِيان إلى لغةٍ واحدةٍ أو إلى لغَتَين مختَلِفَتَين، فتَقِلّ الفُروقُ بينهما وتزداد المفرَداتُ والعباراتُ المشتَرَكةُ بينهما. يحدُث ذلك في حالات التَّمَاسِّ اللَّهَجِي، أو حين حين تَفرِض الدولةُ نظاما لغويًّا موَحّدا. من أمثلة التقارُبِ اللهَجِيِّ ضِمنَ اللغةِ الواحدَةِ تَقارُبُ بعضِ اللهَجاتِ العربيةِ المعاصِرَة، ومن أمثِلَته في لغَتَين مختَلِفَتَين تقاربُ لهَجاتِ لغاتٍ مختلفةٍ في باكستان وأفغانستان، وفي بعض الدوَلِ الأوروبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تقارب لهجي ","nonDiacriticsLemma":"تقارب لهجي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَقَارُبٌ لَهَجِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

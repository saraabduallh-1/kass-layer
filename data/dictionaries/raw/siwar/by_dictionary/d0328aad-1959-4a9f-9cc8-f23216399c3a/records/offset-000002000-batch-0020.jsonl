{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8c0028b5-768c-44d1-9b32-ea56d742a912/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8c0028b5-768c-44d1-9b32-ea56d742a912","word":"لَهْجَةٌ فَرْدِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9223","lexicalEntryId":"8c0028b5-768c-44d1-9b32-ea56d742a912","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لَهْجَةٌ فَرْدِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لُكنةٌ فَرديةٌ خاصةٌ أو عادَةٌ كلاميةٌ تُمَيِّز شَخصا ما عن غيره من الناس، ولاسيّما في طريقة نُطقِه للأصوات بما في ذلك النَّبرُ والتَّنغيم. وقد تشمل جميع جوَانِبِ اللغة؛ فتَشمل نُطقَ الأصوات، واختِيارَ الكلمات، وتَنظيمَ الجُمَل، وطريقةَ إلقاءِ الكلام. وهذه العادةُ خاصَّةٌ بالفَرد نفسِه، لا تُمَثِّل لغتَه ولا لَهجَةَ بيئتِه التي تَقَع ضِمنَ هذه اللغةِ dialect، وقد تَظهَر لدى الفَردِ في لغته الثانيةِ أو الأجنَبيةِ كما تَظهَر في لغته الأمِّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لهجة فردية ","nonDiacriticsLemma":"لهجة فردية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لَهْجَةٌ فَرْدِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

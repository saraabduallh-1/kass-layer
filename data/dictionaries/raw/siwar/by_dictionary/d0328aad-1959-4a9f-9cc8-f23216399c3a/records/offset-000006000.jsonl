{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ad6bb2ae-0da1-4486-8807-9e21192a3a79/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ad6bb2ae-0da1-4486-8807-9e21192a3a79","word":"ظَاهِرَةُ  على طَرَفِ اللِّسَانِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba010","lexicalEntryId":"ad6bb2ae-0da1-4486-8807-9e21192a3a79","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ظَاهِرَةُ  على طَرَفِ اللِّسَانِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"ظاهرَةٌ لغويةٌّ نفسيةٌ لدى كثيرٍ من الناس، خاضِعَةٌ للدراسَة العِلميةِ كجُزءٍ من نظرِيةٍ تقليديةٍ في إنتاج الكلام. يرى أصحابُ هذه النظريةِ أن الذين يَمُرُّون بهذه الخِبرَة، المسمّاةِ بظاهرَة على طَرَف اللِّسان، يتَمتَّعون بالقُدرَة على تذكُّر السِّماتِ أو الخصائصِ العامَّةِ للكلمة التي هي على طَرَف ألسِنَتِهم؛ فيتذَكَّرون عَدَدَ مَقاطِعِها، وأنماطَ نَبراتِها، وجُزئياتِها الصوتية. ويُستَدلُّ بهذه الظاهِرَةِ على أن الكلماتِ تتَفاوَت من حيث تمثيلُها الفونولوجيُّ في الدِّماغ، وأن سِماتٍ معيَّنةً لبِنيَة الكلمةِ تُحفَظ في حَيِّزٍ في الدّماغِ مُستَقِلٍّ عن حَيِّز الكلماتِ الأخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ظاهرة  على طرف اللسان ","nonDiacriticsLemma":"ظاهرة  على طرف اللسان","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ظَاهِرَةُ  على طَرَفِ اللِّسَانِ"}],"lemmaLanguage":{"code":"ar","labe
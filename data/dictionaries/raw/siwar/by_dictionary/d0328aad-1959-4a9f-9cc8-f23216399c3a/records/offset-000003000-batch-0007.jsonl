{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b2bd23fe-2941-41c1-abcf-30fcccf2ba54/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b2bd23fe-2941-41c1-abcf-30fcccf2ba54","word":"لُغَةُ التَّفْكِيرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94be","lexicalEntryId":"b2bd23fe-2941-41c1-abcf-30fcccf2ba54","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةُ التَّفْكِيرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ التي يُفَكِّر بها الشخصُ حين يكون وَحيدا دون أن يُخاطِب أحدا، أو حين يُفكِّر في مسألَةٍ عِلميَّةٍ أو يَشرَحُها أو يكتُب فيها. ولا يَلزم أن تكون هذه اللغةُ هي لغتَه الأمَّ أو الأولى، بل تكون الثانيةَ أو الأجنبيةَ بحسب طبيعةِ الموضوعِ الذي يُفَكِّر فيه. فقد تكون لغةُ التفكيرِ هي الإنجليزيةَ لناطِقٍ بالعربية حين يُفكِّر في مسألةٍ علميّةٍ دَرَسَها بالإنجليزية، وقد تكون العربيةُ هي لغةَ التفكيرِ لناطقٍ بالأُردية حين يُفكِّر في مسألة دينيةٍ تلقّاها في بيئة عربية أو مدرسةٍ عربية. وتَفكيرُ المرءِ بلغةٍ ثانيةٍ أو أجنبيةٍ غالبا ما يكون دَليلا على إتقانه إيّاها بدرَجةٍ عاليَة، لاسيّما حين يكون متأثِّرا إلى حَدٍّ كبيرٍ بثقافَة مجتَمَعٍ آخَرَ عاش فيه أو درَسَ لغَتَه مدَّةً طويلَة، أو حين تكون لغَتُه الأمُّ أو مَعرِفَتُه بها لا تُسْعِفه في التَّعبير عن المصطَلَح أو الموضوعِ الذي يُفكِّر فيه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة التفكير ","nonDiacriticsLemma":"لغة التفكير","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةُ التَّفْكِيرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ac8e549a-8ad2-44a1-8afb-11a8aa1eb72f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ac8e549a-8ad2-44a1-8afb-11a8aa1eb72f","word":"طَلاقَةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9487","lexicalEntryId":"ac8e549a-8ad2-44a1-8afb-11a8aa1eb72f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"طَلاقَةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"استعمالُ اللغةِ بشَكل عَفويٍّ تِلقائيٍّ سَلِسٍ. وحين يَرِد هذا المصطلحُ في تعليم اللغاتِ الأجنبيةِ يُقصَد به عَدَمُ التوقُّفِ عند الدِّقَّةِ أو الصِّحَّةِ اللغويةِ language accuracy، لاسيّما حين تكون الثانيةُ مُعِيقةً للأولى. راجع:  @(fluency) و  @(accuracy) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"طلاقة لغوية ","nonDiacriticsLemma":"طلاقة لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"طَلاقَةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c1f5f704-52b3-4c16-8ca1-20b90c320b26/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c1f5f704-52b3-4c16-8ca1-20b90c320b26","word":"النِّظَامُ الآلِيُّ لتَوْلِيدِ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9488","lexicalEntryId":"c1f5f704-52b3-4c16-8ca1-20b90c320b26","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النِّظَامُ الآلِيُّ لتَوْلِيدِ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظامٌ آليٌّ حاسوبيٌّ، يتلَقَّى طلباتِ تَخاطُبٍ باللغة الطبيعيةِ من مُستَعمِله للاستِعلام عن أُمورٍ في مجالِ تخَصُّصٍ معيَّن؛ فيُحَلِّل نظامَ الاستفسارات، ويَبحَث في ذاكِرَته عن المفاهيم المنطِقِيةِ التي تُناسِب الرَّدَّ على الاستفسارات، فيَختار الألفاظَ التي تَدُل على هذه المفاهيم، ثم يَختار الصِّيَغَ والتراكيبَ اللغويةَ المناسِبة؛ فيُدخِل فيها الألفاظَ المختارَةَ، ويَوَلِّد نَصَّ الرَّدِّ على الاستِفسار، ويَعرِضُه على شاشَة الجِهازِ أو يَطبَعُه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظام الآلي لتوليد اللغة ","nonDiacriticsLemma":"النظام الآلي لتوليد اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النِّظَامُ الآلِيُّ لتَوْلِيدِ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7e5b4044-2d5d-4a4d-8989-424ae30176aa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7e5b4044-2d5d-4a4d-8989-424ae30176aa","word":"الغَرِيزَةُ اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9489","lexicalEntryId":"7e5b4044-2d5d-4a4d-8989-424ae30176aa","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الغَرِيزَةُ اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ استَعمَله ستيفن بنكر Steven Pinker عالِمُ اللغةِ النفسيِّ الكَنَدي في عام 1990م، لوَصف الفِطرَةِ أو القُدرَةِ اللغويةِ الفَريدَةِ التي يولَد الطفلُ وهو مزَوَّدٌ بها، وتُمَكِّنه من اكتساب لغتِه الأمِّ دونَ حاجَةٍ إلى تعلُّم مادام الطفل طبيعيًّا وقادِرا على سَماع اللغةِ من مُحيطه. وتُمَكِّن هذه الغَريزَةُ الطفلَ أيضا من اكتساب لغةٍ ثانيةٍ أو أكثَرَ إذا تعَرَّض لها بشَكلٍ طبيعيٍّ. وهذه الغَريزَةُ نفسها تمكِّن الأطفالَ من اكتساب اللغةِ الهَجِينِ pidgin في مجتَمَع مُختَلطِ اللغات، ثم تحويلها إلى لغةٍ موَلَّدَة creole. بل إن هذه الغَريزَةَ تُمكِّن الأطفالَ من ابتِكار لغةٍ خاصَّةٍ بهم إذا لم يتعَرَّضوا إلى لغةٍ طبيعية، كما تُمكِّن الأطفالَ الصُمَّ من اكتساب لغةِ الإشارَة. راجع:  @(language competence) و  @(language faculty) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الغريزة اللغوية ","nonDiacriticsLemma":"الغريزة اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الغَرِيزَةُ اللُّغَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9d9e9d20-d0ab-41e6-88af-95ed589e12c3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9d9e9d20-d0ab-41e6-88af-95ed589e12c3","word":"مُتَعلِّمُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b948a","lexicalEntryId":"9d9e9d20-d0ab-41e6-88af-95ed589e12c3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُتَعلِّمُ اللُّغَةِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على من يتعلَّم لغةً ما، سواء أكانت لغةً أُمًّا أم ثانيةً أم أجنَبية، بيدَ أن هذا الوصفَ غالبا ما يُطلَق على متعلِّم اللغةِ الثانيةِ أو الأجنبيةِ الناطِقِ بغيرها، تَميِيزا له من الناطِق بها، بالنظَر إلى أن الناطِقَ باللغة يَكتَسِبها اكتِسابا طبيعيا دونَ حاجَةٍ إلى تعلُّم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"متعلم اللغة ","nonDiacriticsLemma":"متعلم اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُتَعلِّمُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8e0919cb-67d7-4b79-b3ca-ba3dadba6137/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8e0919cb-67d7-4b79-b3ca-ba3dadba6137","word":"الحِفَاظُ علَى اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b948b","lexicalEntryId":"8e0919cb-67d7-4b79-b3ca-ba3dadba6137","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الحِفَاظُ علَى اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أن يُحافِظ شَعبٌ على لغَته على مَرِّ القرون ولا يتحَوَّل عنها إلى غيرها، أو لا تعتَريها تَغيراتٌ كبيرة؛ كالحِفاظ على اللغة العربيةِ الفُصحى في المجتَمَع العربي، والحِفاظِ على اللغة الوِيلزيَّةِ Welsh في مقاطَعة وِيلز البريطانيةِ على الرَّغم من هَيمَنة الإنجليزيةِ على معظَم نواحي الحياةِ هناك. تتعَدَّد العوامِلُ التي تُساعِد في الحِفاظ على اللغة؛ كالعوامِل الدِّينيةِ والسياسيةِ والثقافيةِ والاجتماعيةِ والاقتصادية؛ بيدَ أن التعليمَ باللغة، أي جَعلها لغةَ التعليم، أقوى أسبابِ المحافظَةِ عليها. ويَعني الحِفاظُ على اللغة أيضا مُحافظةَ الفَردِ أو الأفرادِ على لغتهم والتمسُّكَ بها، أو إحياءَها باستِعمالها والتواصُلِ بها، ومُراجَعتِها وتَنقيحِها، والدِّفاعِ عنها، خاصّةً في المجتَمَعات ثنائيةِ اللغةِ أو متعدِّدَةِ اللغات. يَرتَبِط بالحِفاظ على اللغة، أو يُساعِد عليه، مفاهيمُ أو مصطلحاتٌ لغويةٌ أخرى قَريبةٌ، منها: إحياءُ اللغةِ language rivival، وانتِشارُ اللغةِ language spread، وإعادَةُ تَوطِينِ اللغةِ language renativization ، والوَلاءُ للُّغَة language loyalty.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الحفاظ على اللغة ","nonDiacriticsLemma":"الحفاظ على اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الحِفَاظُ علَى اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ea0e2ad0-3615-4409-87e5-56e46f72ac98/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ea0e2ad0-3615-4409-87e5-56e46f72ac98","word":"مُفَكِّرَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b948c","lexicalEntryId":"ea0e2ad0-3615-4409-87e5-56e46f72ac98","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُفَكِّرَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"نوعٌ من الكِتابة التي يُدَوِّنها الطالبُ يوميًّا في كرّاسّةٍ خاصَّة، تُسمّى أيضا صَحيفةَ الطالب، تتضمَّن أفكارَه ومشاعِرَه وبعضَ الجوانبِ المعرِفيةِ في شخصِيته، ولا ترتَبط بموضوعٍ محَدَّد. وفي مرحَلة تعلُّمِ اللغةِ الثانية، يُشجِّع المعلِّمُ طلابَه على كتابة هذه المدوَّنات، دونَ تَدقيقٍ في الصِّحَة اللغويةِ لهذه الكِتابة؛ بهَدَف تدريبِهم على الكتابة، ومراجَعَةِ نُمُوِّهِم اللغويِّ فيما بعد. وقد تكون مُفكِّرَةً للمعلِّم يَستَعين بها في تقيِيم أدائه، أو تقيِيمِ طُلّابِه. راجع:  @(learning log) و  @(teaching journal) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"مفكرة ","nonDiacriticsLemma":"مفكرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُفَكِّرَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2b20dfe4-3186-4299-8f18-a4f550c024da/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2b20dfe4-3186-4299-8f18-a4f550c024da","word":"الجُمْلَةُ النَّوَاةُ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b948d","lexicalEntryId":"2b20dfe4-3186-4299-8f18-a4f550c024da","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الجُمْلَةُ النَّوَاةُ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في النحو التحويليِّ، يُطلَق على الجُملَة الأصليةِ البَسيطَة، وتُوصَف بأنها خَبَرِية تَقريرِيَّة، ومَعلومَةُ الفاعِلِ، وتامَّةٌ في بِنيَتها النحوية، ولا تحتَوي على أجزاء اختِيارية، بل إن تحوِيلاتها جَبْرِية، ويمكن أن يُبنَى منها بالتَّحوِيل جُمَلٌ أكبَرُ منها وأكثَرُ تعقيدا؛ كالجُمَل المبنِيةِ للمَجهول، وجُمَلِ الاستفهامِ والنَّفيِّ. مثالُ ذلك في العربية: فتَحَ عليٌّ البابَ، وفي الإنجليزية: The man opened the door، خِلافًا للجُمَل الفَرعيةِ أو غيرِ النَّواةِ non-kernel sentences؛ كالجُمل الاستفهاميةِ، وجُمَل النَّفيِ، ونحوِ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الجملة النواة  ","nonDiacriticsLemma":"الجملة النواة ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الجُمْلَةُ النَّوَاةُ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

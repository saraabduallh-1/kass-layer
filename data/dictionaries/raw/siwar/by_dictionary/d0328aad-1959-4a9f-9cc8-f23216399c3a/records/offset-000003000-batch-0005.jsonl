{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/49283214-4f9d-440a-b6cd-0462187effb0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"49283214-4f9d-440a-b6cd-0462187effb0","word":"اللُّغَةُ عَبْرَ المَنْهَجِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b949a","lexicalEntryId":"49283214-4f9d-440a-b6cd-0462187effb0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ عَبْرَ المَنْهَجِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ في تعليم اللغة؛ يُرَكِّز على تعليم مهاراتِ اللغةِ وكلِّ ما له علاقَةٌ باستعمالاتها في جميع المقرَّراتِ المدرَسية، ويؤكِّد تعليمَها من خلال محتوَياتِ الموادِّ التعليميةِ بجميع أنواعِها content areas، بدَلًا من تعليمها في مقرَّرٍ منفَصِلٍ عن المقرَّرات الأخرى. يتطَلَّب هذا المذهبُ أمرَين، أحَدُهما: مُراعاةُ الجوانبِ اللغويةِ، أي النُّمُوِّ اللغويِّ للمتعلِّم، في محتوى كلِّ مقرَّرٍ من مقرَّرات المنهج، والآخَرُ: تأهيلُ جميعِ المعلِّمين لتعليم اللغةِ إضافةً إلى تأهيلهم في تخصُّصاتهم الأصليةِ في العُلوم والرياضياتِ والعُلومِ الاجتماعيةَ. ويَرتَبط بهذا المذهبِ جوانبُ، منها: القراءةُ عَبرَ المنهَج reading across the curriculum، والكتابةُ عبرَ المنهَج writing across the curriculum.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة عبر المنهج ","nonDiacriticsLemma":"اللغة عبر المنهج","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ عَبْرَ المَنْهَجِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9a170b73-ac07-4433-be3c-e40a87185244/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9a170b73-ac07-4433-be3c-e40a87185244","word":"فُنُونُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b949d","lexicalEntryId":"9a170b73-ac07-4433-be3c-e40a87185244","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فُنُونُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يُطلَق أحيانا على مهارات اللغةِ التي يتضَمَّنها المنهج، وهي المهاراتُ الأربعُ: الاستِماعُ، والمحادَثَةُ، والقراءةُ، والكتابةُ، يُضاف إليها فروعُ اللغةِ اللازِمةُ لاستعمالها؛ كالخَطِّ، والإملاءِ، والقواعدِ، والدَّلالةِ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فنون اللغة ","nonDiacriticsLemma":"فنون اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فُنُونُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/30aac421-3ceb-4cfa-8656-dab67153be42/get-public-entry"},"browse_index_record":{"lexicalEntryId":"30aac421-3ceb-4cfa-8656-dab67153be42","word":"مَوْتُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b949e","lexicalEntryId":"30aac421-3ceb-4cfa-8656-dab67153be42","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَوْتُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يَعني اختِفاءَ اللغةِ من الاستعمال لغةً أُمًّا بطريقَةٍ تدريجيةٍ تؤدِّي إلى مَوتها. فاللغةُ قد تَقَع فَريسَةً لِلُغةٍ غازِيَةٍ أو لغةِ طَبَقَةٍ عُليا تُهَيْمِن على معظَم جوانبِ الحياة؛ فتَضيق مجالاتُ استعمالِ اللغةِ المغلوبَةِ حتى لا تكاد تُستَعمَل بين الأطفال، ثم تظهَر أجيالٌ لا تعرِف منها إلا كلماتٍ مَعدودَةً تستَعمِلها في مجالاتٍ محَلِّيةٍ محدودَة، وقد تُحَرَّف هذه الكلماتُ فتَدخُل ضِمنَ مفرَداتِ اللغةِ الغازِيَة. وقد تَموت اللغةُ في مكانٍ وتحيا في مكانٍ آخَر؛ بسبَب نُزوحِ الناطقين بها إلى أماكِن أخرى، كما حَدَث لبعض لغاتِ إفريقيا. وقد تَموتُ اللغةُ في مناطِق ليسَت من مناطِقها الأصلية؛ فتَنحَسِر منها إلى مَوَاطِنها الأصلية، كما حَدَث للُّغة العربيةِ حين انحسَرَت من معظَم البلادِ الإسلاميةِ، لكنها بقِيَت لغةً أمًّا أو لغةً أولى في البلاد العربية. وربما تَموت اللغةُ نتيجَةَ ابتعاد لَهَجاتِها عنها وتحوُّلها إلى لغاتٍ مستَقِلَّة، كما حَدَث للّاتِينِية. راجع:  @(language attrition/loss) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"موت اللغة ","nonDiacriticsLemma":"موت اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَوْتُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/86916865-258a-4c20-936d-e248faf9aaa0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"86916865-258a-4c20-936d-e248faf9aaa0","word":"هَنْدَسَةُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9493","lexicalEntryId":"86916865-258a-4c20-936d-e248faf9aaa0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"هَنْدَسَةُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُطلَق على نَمَطٍ من التَّخطيط اللغويِّ language planning، يُقصَد به الجُهُودُ اللغويةُ المنظَّمَةُ التي تُبذَل لحَلِّ المشكلاتِ التواصُليةِ في مجتَمَع اللغةِ أو خارِجَه بدراسة عَدَدٍ من اللغات في المجتَمَع، أو بدراسة اللَّهَجاتِ المستَعمَلةِ فيه؛ لبناءِ سياسةٍ لغويةٍ تَنتَهي باختيار اللغةِ أو اللَّهجَةِ أو الاستعمالِ الذي يؤدِّي إلى زيادة كِفايَةِ الاتصالِ اللغويِّ داخِلَ المجتَمَعِ أو خارِجَه. وقد يُستَعمَل المصطلحُ بمعنى التَّخطيطِ اللغويِّ. راجع:  @(language planning) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في اللسانيات الحاسوبيّةِ والترجَمةِ الآليَّة، يُقصَد به تَطبيقُ المعرِفةِ باللغة المنطوقَةِ والمكتوبَةِ في بناء أنظِمَةٍ قادِرَةٍ على تَعرُّف اللغةِ البَشَريّةِ وفَهمِها وترجَمَتِها، وتطويرِ لغاتٍ تقنيَّة، لخِدمَة الترجَمةِ الآلية، وتعرُّفِ الكلامِ، والقدرَةِ على تركيب الجُمَل، والبحثِ الدَّلالي، واستِدعاءِ المعلومات. تهدف الهندسةُ اللغويةُ إلى تَيسير استِخدامِ التَّطبيقاتِ المختَلِفةِ، وزيادَةِ احتِمالاتِ التَّواصُلِ بين لغاتِ العالمِ، بدَمج الطرُقِ الجديدةِ لمعالجَة اللغةِ الشفهيةِ والمكتوبة؛ كإنشاء الوَثائقِ وإدارتِها، وخَدماتِ المعلوماتِ والاتصالات، والترجَمة، واكتسابِ اللغاتِ الأجنبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"هندسة اللغة ","nonDiacriticsLemma":"هندسة اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"هَنْدَسَةُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/258efa0d-7c2d-4614-a5b9-fdaf12016d95/get-public-entry"},"browse_index_record":{"lexicalEntryId":"258efa0d-7c2d-4614-a5b9-fdaf12016d95","word":"أَيْديُولُوجِيَّةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9494","lexicalEntryId":"258efa0d-7c2d-4614-a5b9-fdaf12016d95","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَيْديُولُوجِيَّةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُقصَد به الاتجاهاتُ والقَناعاتُ حَولَ لغةٍ أو لغاتٍ معيَّنة، التي غالبا ما تَستَنِد إلى قِيَمٍ أو مَفاهيمَ ثقافيةٍ معيَّنة، ويُفسَّر في ضَوئها بقاءُ لغةٍ أو اندِثارُ أخرى، أو هيَمَنَةٌ لغةٍ على غيرها من اللغات في مجتَمَع معيَّن. تُفيد نتائجُ بعضِ الدراساتِ أن لغةَ الطبَقَةِ العُليَا أو لهجَتَها في مجتَمَعٍ ما تُهَيمِن على اللغات أو اللهَجاتِ الأخرى، ويُعجَب بها الناسُ؛ بتَأثير التعليمِ ووَسائل الإعلامِ التي تُهَيمِن عليها هذه الطبَقَةُ، وليس نتيجةً لقوُّةِ اللغةِ نفسِها. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أيديولوجية لغوية ","nonDiacriticsLemma":"أيديولوجية لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَيْديُولُوجِيَّةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f3a16160-ae87-45d6-bc81-3d92c10856a5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f3a16160-ae87-45d6-bc81-3d92c10856a5","word":"تَدَخُّلٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9495","lexicalEntryId":"f3a16160-ae87-45d6-bc81-3d92c10856a5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدَخُّلٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تحليل الأخطاء، يُشير إلى ما يحدُث لمتعلِّم لغةٍ ثانيةٍ أو أجنَبيةٍ حين تتدَخَّل أنظِمَةُ لغتِه الأمِّ في اللغة الهَدَف. وغالبا ما يُشير هذا المصطلَحُ إلى التدَخُّل السَّلبيِّ الذي يُعَدُّ مشكلةً تعليميةً قد تُعِيق تعلُّمَ اللغةِ الهَدَف. لكن هذا التدَخُّلَ لم يَعُد عائقًا حقيقيًّا في نَظَر اللغويين المعرِفيِّين الفِطرِيِّين، كما كان يُعتَقَد إبّان هيمَنةِ الاتجاهاتِ البِنيَويةِ السُّلوكيةِ على حَقل تعليمِ اللغات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدخل لغوي ","nonDiacriticsLemma":"تدخل لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدَخُّلٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/97fff320-fee4-4ec7-a395-23f818b90fbe/get-public-entry"},"browse_index_record":{"lexicalEntryId":"97fff320-fee4-4ec7-a395-23f818b90fbe","word":"كَلِمَةٌ مِفْتَاحٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9496","lexicalEntryId":"97fff320-fee4-4ec7-a395-23f818b90fbe","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمَةٌ مِفْتَاحٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"كلمةٌ تُشير إلى مَفهومٍ خاصٍّ في عَصرٍ من العُصُور، أو تُعبِّر عن قِيَم طبَقَةٍ اجتماعية، مثلُ: (صُعلوك) في الجاهلية، و(إقطاعِيٌّ) في مرحَلة من تاريخ أوروبا، و(رَفيقٌ) في حِزبٍ شيُوعيٍّ. ويدخُل فيها بعضُ الألفاظِ الإسلاميةِ المرتَبِطَةِ بزَمَنٍ معيَّن، مثلُ: (جاهِليّ) و(صَحَابيّ) و(تابِعِيّ) و(مخَضْرٌم). ومن ذلك الكلمةُ الفرنسيةُ: raison (السبَب) التي هي كلمةٌ مفتاحٌ للتَّنَوُّر الفرنسي، وكذلك: rigo(u)t (التَّدقيق) التي هي كلمةٌ مفتاحٌ للغويِّين الأمريكيِّين في الأربعينيات والخمسينيات من القرن العشرين. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"الكلِمةُ أو الكلِماتُ التي تترَدَّد في النَّصِّ المقروءِ أو المترجَم، وترتَبِط بموضوعه ارتِباطا وَثيقا بدرَجَةِ أن النّصّ لا يُفهَم ما لم تُفْهَم هذه الكلمةُ أو الكلماتُ. ومن الضَّرورِي أن يَفهَمَها القارئُ فَهما دقيقا حتى يَفهَم النَّصَّ، وفي حال الترجَمة، لا بُدَّ أن يَفهَمها المترجِمُ ويقدِّمَها للمتَلَقِّي بمُقابِلٍ مَفهومٍ حتى لا يَفقِد النَّصُّ معناه، خِلافا للكلمات غير المفتاح، سواء أكانت ثانويةً أم هامِشيَّةً أم حَشْوًا.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمة مفتاح ","nonDiacriticsLemma":"كلمة مفتاح","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمَةٌ مِفْتَاحٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

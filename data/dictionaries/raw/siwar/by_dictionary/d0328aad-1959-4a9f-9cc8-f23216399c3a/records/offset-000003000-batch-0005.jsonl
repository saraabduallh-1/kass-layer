{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fdcb91ba-d3a9-4439-a946-458dded397f3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fdcb91ba-d3a9-4439-a946-458dded397f3","word":"الصِّحَّةُ اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9492","lexicalEntryId":"fdcb91ba-d3a9-4439-a946-458dded397f3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الصِّحَّةُ اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سُلوكٌ لغويٌّ يُقصَد به اهتِمامُ المعلِّمِ أو المتعلِّمِ بصِحَّة استعمالِ التركيبِ أو الجُملةِ من الناحيَة النحويةِ بشَكلٍ دَقيق. ويُفَرِّق المختَصون بتعليم اللغاتِ الأجنَبيةِ بين هذا المصطلَحِ ومصطلَحٍ آخَرَ أو سُلوكٍ لغويٍّ آخَرَ هو: الطَّلاقةُ اللغويةُ language fluency الذي يَعني اهتِمامَ المعلِّمِ أو المتعلِّمِ باستعمال اللغةِ بشَكلٍ عَفويٍّ أكثَرَ من اهتِمامه بصِحَّة هذا الاستعمالِ ودِقَّتِه. لوحِظ أن بعضَ المذاهِبِ اللغويةِ التَّطبيقيةِ وطرائقِ التدريس، كالطريقة السَّمعيةِ الشَّفَهية، تهتَم بالدِّقَّة اللغويةِ أكثَرَ من اهتِمامها بالطَّلاقَةِ اللغوية، في حين تهتَمّ طرائقُ أخرى، كالطريقَة الاتصاليةِ وتعليم اللغة بالمهمّات، بالطلاقَة اللغويةِ أكثَرَ من اهتِمامها بالدِّقَّةِ اللغوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الصحة اللغوية ","nonDiacriticsLemma":"الصحة اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetai
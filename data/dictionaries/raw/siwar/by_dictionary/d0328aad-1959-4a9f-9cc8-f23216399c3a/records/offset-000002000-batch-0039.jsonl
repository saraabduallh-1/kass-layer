{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a2a1e780-1d7e-4fcb-8a75-28964c8022de/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a2a1e780-1d7e-4fcb-8a75-28964c8022de","word":"اللُّغَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9408","lexicalEntryId":"a2a1e780-1d7e-4fcb-8a75-28964c8022de","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"لغةٌ خاصَّةٌ أو لغةٌ مُعَيَّنةٌ، تُعَرَّف بأنها: نظامٌ من الرُّموز الصوتيةِ والصوَرِ اللَّفظِيةِ المخزونَةِ في أذهان الناطقين بها للتَّفاهُم فيما بينهم، وفقَ نظامٍ اجتماعيٍّ متَّفَقٍ عليه بين أفرادِ الجَماعة. وهذه اللغةُ يَكتَسِبُها الإنسانُ في مجتَمَعه، وتُسمَّى لغتَه الأمَّ أو لغتَه الأولى؛ كالعربية والإنجليزيةِ والأُرديةِ واليابانيةِ والصِّينية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]},{"definition":"اللغةُ الإنسانيةُ العامَّةُ: وهي القُدرَةُ الفِطرِيةُ الكامِنَةُ في عَقل كلِّ إنسانٍ منذ ولادَتِه. هذه اللغةُ مُتشابِهَةٌ لدى جميعِ الناسِ في قواعدها البِنيَويةِ وقوانينِها الاجتماعية، وفي نَشأتها ونُمُوِّها وطريقَةِ اكتِسابِها، وهي موضوعُ الدراسةِ في علم اللغةِ بجميع فُروعِه ومجالاتِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"لُغةٌ غَيرُ إنسانيةٍ: وتَشمَل أيَّ وَسيلةٍ للتفاهُم بين مجموعَةٍ من المخلوقات؛ كلغةِ النَّحْل، ولغةِ الطَّير، ولغةِ الحيَوان، وقد يَشمَل هذا المفهومُ اللغاتِ الاصطِناعِيَّة artificial languages.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة ","nonDiacriticsLemma":"اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

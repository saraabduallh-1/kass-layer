{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5cf943d3-8bfe-412a-a824-461119aab0c4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5cf943d3-8bfe-412a-a824-461119aab0c4","word":"رَطانَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93fa","lexicalEntryId":"5cf943d3-8bfe-412a-a824-461119aab0c4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رَطانَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"لغةٌ خاصّةٌ أو لَهْجَةٌ خاصّةٌ لمجموعَةٍ مِهنيَّة من الناس، يَستَخدِم أصحابُها كلماتٍ وعباراتٍ بعَينها لا يَفهَمها غيرُهم. والمجموعةُ قد تَنتَمي إلى طبَقَةٍ اجتماعيةٍ عالِيَةٍ كالأطبّاء والمحامين والمهندِسين، أو إلى طبَقَةٍ دُنيا كالسّوقَة وعُمّالِ المصانِعِ وعُمّالِ النظافَة. ولأن الرَّطانَةَ مَفهومةٌ لدى المجموعةِ المعْنِيَّة، فإن هذه المجموعة لا تُطلِقُها على نفسها، وإنما تُطلَق عليها من خارِجها، أي ممن لا يَفهَمونها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"سِمَةٌ للغة الطفلِ في المراحِل الأولى لاكتسابه اللغةَ، لا يَفهَمها سوى والدَيه أو مُرَبِّيه أو غيرِهم من القَريبِين منه. وقد تُطلَق على المراحِل الأولى للغة متعلِّمِ اللغةِ الثانية، وقد تُطلَق على ما يَصعُب فَهمُه من كلام الفَردِ بسبَب عَيبٍ في النطق.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"رطانة ","nonDiacriticsLemma":"رطانة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:0
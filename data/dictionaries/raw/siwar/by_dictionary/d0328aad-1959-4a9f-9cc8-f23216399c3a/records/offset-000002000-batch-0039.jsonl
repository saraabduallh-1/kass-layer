{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/676e5b6f-8dcf-410e-97cc-ec4ab9dff314/get-public-entry"},"browse_index_record":{"lexicalEntryId":"676e5b6f-8dcf-410e-97cc-ec4ab9dff314","word":"الجَاكُوبْسُونِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93f7","lexicalEntryId":"676e5b6f-8dcf-410e-97cc-ec4ab9dff314","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الجَاكُوبْسُونِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على آراء اللغويِّ الأمريكيِّ، الروسيِّ الأصل، رومان جاكوبسون Roman Jakobson، أحَدِ أبرزِ مؤسِّسي مدرسةِ براغ Prague School، ذاتِ الأثَرِ الواضِحِ في الدراسات اللغويةِ المعاصِرَة. ظهَرَت في منتَصَف الخمسينيات من القرن العشرين، وتَمَيزت بأمرَين، أحدُهما: نظريةُ السِّماتِ المميِّزَةِ distinctive feature theory التي استعمَلها جاكوبسون وزميلُه هال Jakobson and Halle، والآخَرُ: فَرضِيةُ جاكوبسون في اكتساب اللغة. راجع:  @(Jakobsonian Hypothesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"الجاكوبسونية ","nonDiacriticsLemma":"الجاكوبسونية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الجَاكُوبْسُونِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b7d7fa12-7135-4666-b7d0-4d77cd0c7f57/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b7d7fa12-7135-4666-b7d0-4d77cd0c7f57","word":"خَطٌّ لَهَجِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93f8","lexicalEntryId":"b7d7fa12-7135-4666-b7d0-4d77cd0c7f57","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"خَطٌّ لَهَجِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"خَطٌّ أو فاصِلٌ لغويٌّ أو لَهَجيٌّ، يُبَيِّن على الأطلَس اللغويِّ حُدودَ المنطقةِ التي يَظهَر فيها مَعْلَمٌ لغويٌّ ما؛ فيتَبيَّن فيه التوزيعُ الجغرافيُّ للمعالِم اللغويةِ التي تُميِّز اللغاتِ أو اللَّهَجاتِ داخِلَ اللغةِ الواحدة. وهو خَطٌّ يقوم على بياناتٍ إحصائية، لكنه غيرُ ثابِتٍ في الغالب. ويُقَسَّم هذا الخَطُّ - بالنظر إلى المعالِم - أقسامًا، منها: الخَطُّ الصوتيٌّ، والخَطُّ النَّغميُّ، والخَطُّ المورفيميُّ، والخَطُّ التركيبيُّ، والخَطُّ الدّلاليُّ، والخَطُّ اللغويُّ الثقافيُّ. ويُسمّى أحيانًا: isoglottic line، كما يُسمّى أيضا: isograph، على الرَّغم من صُعوبة تحديدِ هذا الخَطِّ بين لغَتَين أو لهجَتَين. ويُقصَد بهذا المصطلحِ أحيانا التَّماثُلُ اللغويّ، أي السِّمةُ اللغويةُ المشترَكةُ بين بعضِ متكلِّمي لغةٍ ما وإن اختَلَفت لهَجاتُهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"خط لهجي ","nonDiacriticsLemma":"خط لهجي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"خَطٌّ لَهَجِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

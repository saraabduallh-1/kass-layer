{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5e03925d-adda-4333-9b55-e4331f98f159/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5e03925d-adda-4333-9b55-e4331f98f159","word":"نَظَرِيَّةُ التَكْيِيفِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b88e7","lexicalEntryId":"5e03925d-adda-4333-9b55-e4331f98f159","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ التَكْيِيفِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويةٌ تَداوُليَّة، اقترَحها جيف فركورن Jef Verchueren عامَ 1987م، ثم طوَّرها ونشرَها في كتابه: Understanding Pragmatics الذي أصدره عامَ 1991م. ترى هذه النظريةُ أن استعمالَ اللغةِ سُلوكٌ يحمِل نشاطاً، ويتضمَّن معانيَ اجتماعية، وأن الظاهرَةَ اللغويةَ ترتَبِط بالاستعمال من مَنظورٍ اجتماعيٍّ إدراكيٍّ ثقافيٍّ. وبناء على ذلك، فإن التَّداوُليةَ لا  تُضيف إلى اللغة مُكَوِّنا جديدا، لكنها تقدِّم لها تفسيراً مختَلِفاً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية التكييف ","nonDiacriticsLemma":"نظرية التكييف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ التَكْيِيفِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f6f022e7-c320-4d98-8234-2b3433bc54e4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f6f022e7-c320-4d98-8234-2b3433bc54e4","word":"عَيِّنَةٌ عَرَضِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b88e0","lexicalEntryId":"f6f022e7-c320-4d98-8234-2b3433bc54e4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَيِّنَةٌ عَرَضِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوعٌ من أنواع العيِّناتِ في البحث العلميِّ، يُقصَد به العيِّنةُ التي تُتَاح للباحث مصادَفَةً، فيختارها لدراسته دونَ إجراءِ مُعايَنَةٍ دقيقة. وعلى الرّغم من سُهولة الحُصولِ على هذه العيِّنةِ فإنها لا تُمثِّل مجتَمَعَ الدراسةِ تمثيلاً حقيقياً، لكنها قد تُفيد في الدراسات اللغويةِ النظريةِ العامَّة؛ لأن الناطقَ بلغةٍ معيَّنةٍ غالبا ما يُمثِّل مجتَمَعَه من الناحية اللغويةِ، ما لم تكن الدراسةُ مُوجَّهةً نحو طَبَقةٍ اجتماعيةٍ أو ثقافيةٍ معيَّنةٍ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عينة عرضية ","nonDiacriticsLemma":"عينة عرضية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَيِّنَةٌ عَرَضِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

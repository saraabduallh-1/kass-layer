{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ab87e92e-65eb-40b7-b304-874582c27d96/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ab87e92e-65eb-40b7-b304-874582c27d96","word":"كَلِمَاتٌ مُجَرَّدَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b88e9","lexicalEntryId":"ab87e92e-65eb-40b7-b304-874582c27d96","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمَاتٌ مُجَرَّدَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الكَلِماتُ ذاتُ المفاهيمِ الذِّهنِيَّةِ التَّجريدِية، سواء أكانت أسماء، مثل: (الصِّدق) و(الوَفاء) و(الحُبِّ) و(الجَمال) و(النِّفاق) و(الإيمان) و(الكُفْر)، أم أفعالًا مثلُ: (يَعتَقِد) و(يَظُنُّ) و(يُدرِك). ويُقابِل هذا النوعَ من الكلمات ما يُعرَف بالكلمات المحسوسَةِ concrete words، وهي التي تَدُل على أشياء عَيْنيِّةٍ محسوسَة، مثل: (الرَّجُل) و(الحِصان) و(العُصفور) و(الشَّجرَة) و(الطائرَة)، ومثل: (يأكُل) و(يَشرَب) و(يَمشي).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمات مجردة ","nonDiacriticsLemma":"كلمات مجردة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمَاتٌ مُجَرَّدَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

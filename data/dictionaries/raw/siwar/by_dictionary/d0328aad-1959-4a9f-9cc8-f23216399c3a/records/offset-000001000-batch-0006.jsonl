{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9dfd295a-6308-472f-bdcb-a6d2d1041b32/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9dfd295a-6308-472f-bdcb-a6d2d1041b32","word":"بِنْيَةُ المُكَوِّناتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8cdb","lexicalEntryId":"9dfd295a-6308-472f-bdcb-a6d2d1041b32","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بِنْيَةُ المُكَوِّناتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التراكيبُ المكَوِّنةُ، وهي سِلسِلَةٌ هَرَميةٌ من الوحدات اللغويةِ أو المكوِّناتِ المباشِرَةِ لكل مستوى من مستويات الحديثِ أو جُزءٍ منه، وتُكَوِّن في مجموعها جُملةً. فالمحَدِّدُ والاسمُ والنعتُ في نحو: الطالبُ المُجِدُّ، مكوِّناتٌ للعبارة الاسمية، والعبارةُ الاسميةُ كلُّها مكوِّنٌ من مكوِّنات الجُملة، نحو: الطالبُ المُجِدُّ ناجِحٌ. وتُعرَض المكوِّناتُ بصُوَرٍ مختَلِفةٍ من صُوَر التحليلِ اللغوي؛ منها التحليلُ الشَجَرِي، والتحليلُ بالأقواس، ونحوُ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"بنية المكونات ","nonDiacriticsLemma":"بنية المكونات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بِنْيَةُ المُكَوِّناتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

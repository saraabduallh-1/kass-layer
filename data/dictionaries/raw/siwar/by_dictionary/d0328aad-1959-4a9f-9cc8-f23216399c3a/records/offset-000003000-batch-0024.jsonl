{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b31ea03-d610-4a83-980d-1bad5faa47c3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b31ea03-d610-4a83-980d-1bad5faa47c3","word":"إعْلامٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9670","lexicalEntryId":"9b31ea03-d610-4a83-980d-1bad5faa47c3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إعْلامٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ عامٌّ يُطلَق على عَدَدٍ من الوَسائل الإعلامية، كالتِّلفاز والإذاعَةِ والصحافةِ وغيرِها من الوَسائل التي تَهدِف إلى تَسلِيَة الناسِ وتوعيَتِهم وإيصالِ الأخبارِ والمعلوماتِ إليهم. ويَدخُل في ذلك الوَسائلُ الحاسوبيةُ الحديثةُ، كالشَّبَكة العالَميةِ internet، والشَّبكاتِ الداخليةِ intranet، وغيرِها من وَسائل التواصُلِ الاجتماعيِّ الحديثةِ المنقولَةِ عَبرَ أجهِزَةِ الهواتِفِ المحمولَة. وفي برامِج تعليمِ اللغة، يتضَمَّن إعدادُ الموادِّ التعليميةِ أنواعا من الوَسائل الإعلاميةِ المسموعَةِ والمقروءةِ والمرئية، وتُسمّى الوَسائلَ المتعدِّدةَ multi media أو mixed media. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"إعلام ","nonDiacriticsLemma":"إعلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إعْلامٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/731a77ea-d5aa-4db2-8e36-02cf201eed6a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"731a77ea-d5aa-4db2-8e36-02cf201eed6a","word":"العَقلانِيُّون","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9671","lexicalEntryId":"731a77ea-d5aa-4db2-8e36-02cf201eed6a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"العَقلانِيُّون","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُطلَق على أتباع المدرسةِ المعرِفيةِ العَقلانيةِ الفِطريةِ، وعلى رأسهم نوم تشومسكي، الذين يؤكدون أن اللغةَ قُدرَةٌ معرِفيةٌ فِطريةٌ، لا سُلوكٌ آليٌّ كما يَعتَقِد أتباعُ المدرسةِ السُّلوكيةِ في علم النفسِ ومؤيِّدوهم من أتباع المدرسةِ البِنيَويةِ في علم اللغة. وهؤلاء العَقلانيون ينطَلِقون في تفسيرهم للُّغة واكتسابِها من النظرَة المعرِفيةِ التي تَستَند إلى علم النفسِ المعرِفيِّ الإدراكِيِّ cognitive psychology، حتى إنهم حَوَّلوا الدراساتِ اللغويةَ إلى دراسات شَبيهَةٍ بالدراسات النفسيةِ المعرِفيةِ الإدراكِية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"A","root":null,"wordForms":[],"relatedSenses":[],"search":"العقلانيون ","nonDiacriticsLemma":"العقلانيون","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"العَقلانِيُّون"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

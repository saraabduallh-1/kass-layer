{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1e1bf626-f786-4dd0-b29c-771bc82bd011/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1e1bf626-f786-4dd0-b29c-771bc82bd011","word":"جِنْسٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b914f","lexicalEntryId":"1e1bf626-f786-4dd0-b29c-771bc82bd011","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جِنْسٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ نحويٌّ، يُشير إلى التَّميِيز النحويِّ للأسماء والصفاتِ بالوَحدات الصرفيةِ في شَكل سَوابِقَ أو لواحِق، واستِعمالِ أدواتٍ للتَّعريف والتَّنكيرِ والضمائر. وتحدِّد بعضُ اللغاتِ جِنسَ وَحداتِها اللغويةِ بالمذكَّر والمؤنَّثِ فقط، كالعربية، وبالمذكَّر والمؤنَّثِ والمحايِدِ، كالإنجليزية. وتُوجِب بعضُ اللغاتِ - كالعربية - مُطابَقَةً في التذكير والتأنيثِ بين العناصِرِ اللغوية؛ كالمطابَقَةِ بين النَّعتِ ومَنعُوتِه، والضَّمِيرِ ومَرجِعِه، والمطابَقَةِ بين المسنَدِ والمسنَدِ إليه. وتوجِب لغاتٌ أخرى المطابَقَةَ في التذكير والتأنيثِ بين الاسمِ وأداتَيْ التعريفِ والتنكيرِ الداخِلَتَيْن عليه، كالفرنسية، في حين تَزيد الألمانيةُ أداةً خاصةً بالمحايِد. وعلى كلٍّ، فالجِنسُ في اللغات تَصنيفٌ نحويٌّ اصطلاحيٌّ، لا يَعنِي بالضرورَة الجِنسَ الطبيعيَّ البيولوجيَّ؛ فما يكون مذَكَّرًا في لغةٍ ما قد يكون مؤنَّثًا في لغةٍ أخرى والعَكس بالعكس، ولهذا يُسمّى الِجنسَ النحويَّ grammatical gender تمييزًا له عن الجِنس الطبيعيِّ natural gender. راجع:  @(grammatical gender) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُشير إلى مَفهومٍ عامٍّ يُطلَق على جِنس المخلوقِ البَشرِيِّ sex/sexuality of human beings، والفُروقِ بين الرجالِ والنِّساء من حيث طبيعةُ الكلامِ لدى كلٍّ منهما، وما يَرتَبِط بهذه الفُروقِ من دراساتٍ لغويةٍ اجتماعيةٍ، مثلُ: اللغة والجِنس language and gender، والطريقة التي يُخاطَب بها الجِنسان في الكتابات الأدبيةِ والعِلمية؛ فهل يُوَجَّه الخِطابُ إلى جِنسٍ واحِدٍ هو الرَّجُلُ باعتبار أن الإشارَةَ إليه تَعني الإشارَةَ إلى الجِنس البَشَرِي، أم يُوَجَّه الخطابُ إلى الجنسَين كلَيهما في آنٍ واحد، فيُقال في العربية مثلا: هو و هي، ويُقال في الإنجليزية: He or She.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلَحٌ لغويٌّ نفسيٌّ، يُعنَى بالفُروق بين الجنسَين في اكتِساب اللغة، ويَبحث في اختِلاف الإناثِ عن الذُّكور في النُّمُو اللغويِّ. وتُشير كثيرٌ من الدراساتِ في اكتِساب اللغةِ إلى أن البناتِ أسرَعُ في النُّمُو اللغويِّ من البَنين في مرحَلَة الطُّفولَةِ حتى سِنِّ الخامسَةِ أو السادسَة، ثم يَبدأ الجِنسان في التَّقارُب فالتَّساوِي. ويُرَجَّح أن يكون السببُ في ذلك أن نُمُوَّ الخَلايا في بعض مناطِقِ اللغةِ في الدِّماغ لدى الإناثِ أسرَعُ منه لدى الذُّكورِ في مرحَلَة الطُّفولَةِ سُرعَةً تُشبِه سُرعَةَ الإناثِ في البُلوغ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"جنس ","nonDiacriticsLemma":"جنس","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جِنْسٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7c774f00-c04f-407e-b65d-0e0419fd7be9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7c774f00-c04f-407e-b65d-0e0419fd7be9","word":"قَوَاعِدُ عَامَّةٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9150","lexicalEntryId":"7c774f00-c04f-407e-b65d-0e0419fd7be9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَوَاعِدُ عَامَّةٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قواعدُ تهتَمُّ باللغات عامّةً، ولا تختَصُّ بلغةٍ معيَّنة، وهي القواعدُ التي تكون موضوعا للدراسات اللغويةِ العامَّةِ general linguistics، ولاسيَّما في المراحِل المبكِّرة من ظُهور علمِ اللغةِ العام. ثم أصبَحت وَصفاً يُطلَق - في الغالب - على القواعدَ الكُلِّيَّةِ Universal Grammar. وتُقابِل القواعدَ العامَّةَ هذه القواعدُ الخاصَّةُ التي تُعنَى بقواعد لغةٍ بعَينها، مثل قواعدِ اللغةِ العربية، وقواعدِ اللغةِ الإنجليزية، وقواعدِ اللغةِ اليابانية. وتقابلها أيضا القواعدُ التطبيقيةُ التي تُدرَس لأهدافٍ لغويةٍ نفسيةٍ، أو لغويةٍ اجتماعيةٍ، أو لغويةٍ تعليمية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قواعد عامة ","nonDiacriticsLemma":"قواعد عامة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَوَاعِدُ عَامَّةٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/99f71901-e669-4767-ba33-44d9d69d2755/get-public-entry"},"browse_index_record":{"lexicalEntryId":"99f71901-e669-4767-ba33-44d9d69d2755","word":"تَعْمِيمٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9151","lexicalEntryId":"99f71901-e669-4767-ba33-44d9d69d2755","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْمِيمٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يَعني تَعميمَ الطفلِ القاعدةَ اللغويةَ التي تعلَّمها من قبلُ على حالاتٍ جديدةٍ لم يتعلَّمها؛ كأن يتعلَّم أن المذكَّرَ المفرَدَ مثلَ: (مُسلم) يُجمَع جمعَ مذكَّرٍ سالما على: (مسلمون ومسلمين)، فيعَمِّم هذه القاعدةَ على كلِّ كلمةٍ جديدة، مثل: (مؤمِن ومؤمنون)، و(معلِّم ومعلِّمون). وقد يكون التَّعميمُ خَطأً أو مبالَغا فيه، فيُسمّى التَّعميمَ الخاطئ faulty generalization. راجع:  @(overgeneralization) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نظَريٌّ عامٌّ، يَعني أن تكون الظواهِرُ التي يُلاحِظها اللغويُّ في اللغة المدروسةِ على درَجةٍ من العُموم؛ فتُفسِّر الغالبيةَ العُظمى من حالاتها، وتقتَصِر على الحَدِّ الأدنى من الاستِثناءات. والتَّعميمُ أساسُ الدراساتِ اللغويةِ الحديثة؛ لأن الهَدَف منها الوُصولُ إلى القواعد العامَّةِ للُّغات البَشرِية، وصياغةُ نظرياتٍ عامَّةٍ تَنطَبِق على جميع اللغاتِ أو مُعظَمها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ دلاليٌّ، يَعني تَعميمَ الدّلالة، وهو اتِّساعُ معنى الكلمةِ على مَرِّ السنين بالنظر إلى ما كانت تدُل عليه في الأصل أو الوَضع، في مُقابِل التخصيصِ أو تَضييقِ الدّلالة. راجع:  @(extension (of meaning)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في الذَّكاء الاصطناعيِّ واللغوياتِ الحاسوبية، يُشير إلى ما يُعطَى للتَّعميم من أهميَّةٍ كبيرةٍ في تَمثيل المعارِفِ وتعليمِ الحاسوب. وتُوصَف عمليةُ التَّعميمِ أحيانا بأنها عَمَليةُ تعَلُّمِ القواعدِ أو عَمَليةُ بناءِ المفاهيمِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"تعميم ","nonDiacriticsLemma":"تعميم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْمِيمٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b49ef773-177a-4524-baa0-b3c1902a9696/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b49ef773-177a-4524-baa0-b3c1902a9696","word":"الاضْطِرَابَاتُ اللُّغَوِيَّةُ العَامَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9152","lexicalEntryId":"b49ef773-177a-4524-baa0-b3c1902a9696","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الاضْطِرَابَاتُ اللُّغَوِيَّةُ العَامَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُشير إلى مجموعَةٍ من الاضطِرابات اللغويةِ التي تُصيب الإنسانَ ولا تَنحَصِر أسبابُها في إصاباتٍ تُصيب مراكِزَ اللغةِ ووَظائفَها في الدِّماغ، وإنما تَعود إلى أسبابٍ متنوِّعَة، بعضُها وِراثِيٌّ، وبعضُها بسبَب أمراضٍ في أثناء الحَمْل، وبعضُها نتيجة تَخَلُّفٍ عَقلِيٍّ، وبعضُها بسبَب عُيُوبٍ في أعضاء النُّطقِ ومخارِجِ الأصوات. من هذه الاضطراباتِ: الخَنْخَنةُ، والثَّأثَأةُ أو اللَّثغَةُ، والتَّلَعثُمُ في الكلام، وتأخُّرُ لغةِ الطفلِ عن لغة أترابِه، ونحوُ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الاضطرابات اللغوية العامة ","nonDiacriticsLemma":"الاضطرابات اللغوية العامة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الاضْطِرَابَاتُ اللُّغَوِيَّةُ العَامَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

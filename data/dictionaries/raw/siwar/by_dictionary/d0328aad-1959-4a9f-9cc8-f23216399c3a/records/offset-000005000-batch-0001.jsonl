{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7b233c9a-19e2-421c-94b4-dd4fb25b6add/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7b233c9a-19e2-421c-94b4-dd4fb25b6add","word":"المُرَحِّلُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c26","lexicalEntryId":"7b233c9a-19e2-421c-94b4-dd4fb25b6add","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المُرَحِّلُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على المتَرجِم الشَّفهِيِّ الذي يُترجِم عَبرَ لغةٍ أخرى، ولاسيَّما في المؤتمرات المتعدِّدَةِ اللغات، حيث لا يَفهَم المترجِمون الشَّفهِيُّون جميعَ اللغاتِ المستَعمَلةِ في المؤتمر. مثال ذلك مؤتَمَرٌ يعتَمِد الفرنسيةَ والروسيةَ والإسبانيةَ، والمترجِمُ الإسبانيُّ يَفهَم الفرنسيةَ ولا يَفهَم الروسيةَ، في حين يَفهَم المترجِمُ الفرنسيُّ اللغاتِ الثلاثَ. فإذا أُلقِيَ خِطابٌ بالروسية فإن المترجِمَ الفرنسيَّ يَنقله إلى الفرنسية، ثم ينقل المترجِمُ الإسبانيُّ الترجَمةَ الفرنسيةَ إلى الإسبانية؛ إذ لا يستَطيع نقلَه من الروسية مباشَرَة. في هذه الحالَة، يكون المترجم الفَرنسيِّ هو المرحِّل؛ لأنه رَحَّل المعنى بالروسية عَبرَ الفرنسيةِ إلى زميله ليَنقله زميلُه من الفرنسية إلى الإسبانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"A","root":null,"wordForms":[],"relatedSenses":[],"search":"المرحل ","nonDiacriticsLemma":"المرحل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المُرَحِّلُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

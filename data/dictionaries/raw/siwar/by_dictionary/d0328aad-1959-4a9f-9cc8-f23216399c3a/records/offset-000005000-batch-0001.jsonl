{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4ad5db37-cc1f-4b6d-9d5c-ec31bdd10686/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4ad5db37-cc1f-4b6d-9d5c-ec31bdd10686","word":"أُنْمُوذَجُ رَمَلْهَارْتْ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c22","lexicalEntryId":"4ad5db37-cc1f-4b6d-9d5c-ec31bdd10686","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ رَمَلْهَارْتْ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ في القراءة التَّفاعُلية، وَضَعه ديفيد روملهارت David Rumelhart لوَصف عَمَليةِ القراءةِ بأنها مجموعَةُ عَمَلياتٍ إدراكِيَّةٍ مَعرِفيّةٍ تَفاعُليّةٍ مُتكامِلَة. يتَميَّز هذا الأنموذَجُ بأنّ صاحبَه أوَّلُ من عارَض فكرَةَ النَّماذجِ الخَطِّيَّةِ linear models، التي تُصَوِّر القراءةَ بأنها عمَليّةٌ تَسير في اتجاهٍ واحدٍ يبدأ من الأدنى إلى الأعلى أو من الأعلى إلى الأدنى؛ لأن المعنى - في نَظَره - لا يأتي من مصدَرٍ واحد، ولا يَسير في اتجاهٍ واحد، ويؤكد أن القارئَ لا يَفهم المعنى من النَّص المكتوبِ فقط بطريقَةٍ جُزئيّةٍ حَرفيّةٍ تَراكُميّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج رملهارت ","nonDiacriticsLemma":"أنموذج رملهارت","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ رَمَلْهَارْتْ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

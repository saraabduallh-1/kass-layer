{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e51bb746-ed77-4f87-a76f-33b32540a126/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e51bb746-ed77-4f87-a76f-33b32540a126","word":"النِّسْبِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c25","lexicalEntryId":"e51bb746-ed77-4f87-a76f-33b32540a126","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النِّسْبِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"نظريةٌ ترى أن المعايِيرَ والمعانيَ والحَقائقَ ليس لها قوَّةٌ مطلَقَة، ولكنها محكومةٌ بمقامها وسِياقِها وعلاقاتِها، بيدَ أن الباحثين اختَلفوا في حَقيقَة النِّسبيَّةِ بهذا المعنى، وانتَقَدها بعضُهم لاتِّساع تَطبيقاتِها في مجالات عمَليَّةٍ كالسياسَة مثلا، وما ترتَّب على ذلك من التّلاعُب بالنُّصوص وتَغيِيرِ الحَقائقِ والمفاهيم. ميَّزَ كثيرٌ من الباحثين بين نَوعَين من النِّسبيَّة هما: النِّسبيَّةُ الثقافية، والنِّسبيَّةُ المعرِفيةُ، ولكل من النَّوعِين أتباعٌ ومؤيِّدون؛ فالمجموعَةُ الأولى تؤمِن بأن اختِلافَ الثقافاتِ يؤدِّي إلى فَهم الآخَرِين، أما الثانيةُ فتَرَى خِلافَ ذلك، وتؤكِّد أن التَّبايُنَ يجعل التواصُلَ محالًا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"النسبية ","nonDiacriticsLemma":"النسبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النِّسْبِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"auto
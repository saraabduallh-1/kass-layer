{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6e2460ca-2a4e-4f18-8f29-f84685b43003/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6e2460ca-2a4e-4f18-8f29-f84685b43003","word":"عِلْمُ الإنسان الثَّقَافِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8dd5","lexicalEntryId":"6e2460ca-2a4e-4f18-8f29-f84685b43003","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ الإنسان الثَّقَافِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ أنثروبولوجيٌّ، يُسمى أيضا الأنثروبولوجيا الثقافيةَ، يُقصَد به العِلمُ الذي يَبحث في عادات الإنسانِ وحضارَتِه وثقافتِه وقِيَمِه ومبادئِه. وهو مُهمٌّ في تعليم اللغاتِ الأجنَبيةِ؛ للارتِباط الوَثيقِ بين اللغةِ وثقافتِها وسُلوكِ أفرادِها. راجع:  @(anthropology) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم الإنسان الثقافي ","nonDiacriticsLemma":"علم الإنسان الثقافي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ الإنسان الثَّقَافِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/290c3c4d-5e25-4ec2-8dd8-5dd74d24a493/get-public-entry"},"browse_index_record":{"lexicalEntryId":"290c3c4d-5e25-4ec2-8dd8-5dd74d24a493","word":"سِيَاقٌ ثَقَافِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8dd6","lexicalEntryId":"290c3c4d-5e25-4ec2-8dd8-5dd74d24a493","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سِيَاقٌ ثَقَافِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ دلاليٌّ، يُشير إلى أحَد أنواعِ السِّياقِ وفقاً لتَقسيم آمّر K. Ammer ضمنَ نظريةِ السياق، الذي يَقتَضي تحديدَ المحيطِ الثقافيِّ أو الاجتماعيِّ الذي يمكن أن تُستَعمَل فيه الكلمة. فكلمةُ: (جِذْر) في العربية لها معنى عند المزارِع، ومعنى ثانٍ عند اللغوي، ومعنى ثالثٌ عند عالِمِ الرياضيات. ومثلُ ذلك كلمةُ: (عَقِيلَته) التي تُعَدُّ في العربية المعاصِرَةِ علامَةً على الطَّبَقة الاجتماعيةِ المتميِّزَةِ بالمقارنة مع كلمة: (زَوجَته) مثلا. ومثلُ ذلك في الإنجليزية عبارةُ: looking glass التي هي علامَةُ الطبقَةِ الاجتماعيةِ في بريطانيا مقارنةً مع كلمة: mirror، وكذلك كلمةُ: rich مقارنة مع كلمة: wealthy","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في الترجَمة، يُشير إلى أحَد العناصِرِ غيرِ اللغويةِ التي يجب أن يُعنَى بها المترجِمُ بدرَجَةٍ لا تَقِلّ عن عنايَته بالجوانب اللغويةِ التركيبية؛ فما يكون مَقبولا في ثقافةٍ لغةٍ ما ربما لا يُقبَل في ثقافَة لغةٍ أو لغاتٍ أخرى. ففي العربيةِ ألفاظٌ، كالأخُوَّة والحُبِّ، لا تُتَرجَم حَرفيًّا إلى بعض اللغاتِ الأوربيةِ مثلا؛ لأنها تُستَعمَل في سياقاتٍ ثقافيةٍ عربيةٍ إسلاميةٍ مختَلِفَةٍ عن سياقاتها الغربية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"سياق ثقافي ","nonDiacriticsLemma":"سياق ثقافي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سِيَاقٌ ثَقَافِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

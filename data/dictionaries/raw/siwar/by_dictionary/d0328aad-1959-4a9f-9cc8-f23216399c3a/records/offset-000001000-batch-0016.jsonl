{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bc29c89d-afe2-4140-8723-a5e4935b8624/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bc29c89d-afe2-4140-8723-a5e4935b8624","word":"دِرَاسَةٌ عَرْضِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de0","lexicalEntryId":"bc29c89d-afe2-4140-8723-a5e4935b8624","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دِرَاسَةٌ عَرْضِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ أو طريقةٌ في البحث في النُّمُوِّ اللغويِّ، واكتسابِ اللغة خاصّةً، تُبنَى على معلوماتٍ لغويةٍ، تُجمَع من أفرادِ عَيِّنَةِ الدراسةِ في مرحَلةٍ معيَّنةٍ بطريقةٍ أُفُقِيَّةٍ horizontal . وتَنطَلِق هذه الطريقةُ من أن كلَّ فَردٍ أو مجموعَةٍ من أفراد العَيِّنَةِ يمثِّل مرحَلةً عُمرِيةً محدَّدةً أو يَنتَمي إليها. وهذه الطريقةُ سَهلَةٌ في إجراءاتها، ولا تتطلَّب وقتا طويلا لجَمع مَوادِّها العلميةِ اللغوية، لكنها لا تمثِّل النُّمُوَّ اللغويَّ تَمثيلا دَقيقا كما تمثِّله الطريقةُ الطُّوليَّةُ العَمِيقةُ. راجع:  @(longitudinal study/method) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دراسة عرضية ","nonDiacriticsLemma":"دراسة عرضية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دِرَاسَةٌ عَرْضِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cd8c727c-d822-42de-b466-b7fdf1b4f041/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cd8c727c-d822-42de-b466-b7fdf1b4f041","word":"أُحْجِيَّاتُ الكَلِمَاتِ المُتَقَاطِعَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8de1","lexicalEntryId":"cd8c727c-d822-42de-b466-b7fdf1b4f041","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُحْجِيَّاتُ الكَلِمَاتِ المُتَقَاطِعَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لُعبةٌ لغويةٌ تتكوَّن من لَوحَةٍ مُربَّعَةٍ أو مستَطيلَة، بداخِلها مُربَّعاتٌ عديدةٌ بعضُها مسَوَّدةٌ وبعضُها فارِغةٌ. وعلى الطالب أن يَضَع حَرفا واحدا في كل مُربَّعٍ فارِغٍ، حتى تتكوَّن كلماتٌ أُفُقِيَّةٌ وكلماتٌ رَأسِيَّةٌ، بناء على تعليماتٍ تَظهَر تحتَ اللَّوحَة. وفائدةُ هذه اللُّعبةِ مُساعَدةُ متعلِّمِ اللغةِ على تذَكُّر الكلماتِ ومعانيها وتهجِئتِها في آنٍ واحد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أحجيات الكلمات المتقاطعة ","nonDiacriticsLemma":"أحجيات الكلمات المتقاطعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُحْجِيَّاتُ الكَلِمَاتِ المُتَقَاطِعَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

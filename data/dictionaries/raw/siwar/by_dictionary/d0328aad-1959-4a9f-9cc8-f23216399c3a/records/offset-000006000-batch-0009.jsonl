{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8cbffd5c-a63a-4695-8a09-57b3716af39d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8cbffd5c-a63a-4695-8a09-57b3716af39d","word":"التَّعَلُّمُ بالمحَاوَلَةِ والخَطَأِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0e6","lexicalEntryId":"8cbffd5c-a63a-4695-8a09-57b3716af39d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّعَلُّمُ بالمحَاوَلَةِ والخَطَأِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ تعليميٌّ، انطَلَق من التفسير السُّلوكيِّ الآلِيِّ للتعلُّم، اشتَهَر به أدوارد ثورندايك Thorndike Edward حين استَنتَج من تجاربه أن الحيوانَ يتعلَّم بالمحاوَلَةِ والخَطأ. وبناء على ذلك، صاغَ قانونَ التلازُمِ والترابُطِ الذي ينُصُّ على أن تعلُّمَ استجابةٍ معيَّنةِ يتِمّ بتَجَاوُر الاستجابَةِ والنَّجاح، ثم أضاف إليه قانونَيْن آخَرَيْن هما: قانونُ الأثَرِ law of effect، وقانونَ الثوابِ law of reward. حاوَل بعضُ اللغويين التطبيقيين من أتباع الاتجاهِ السُّلوكيِّ تَطبيقَ هذا المبدأِ في حَقل تعليمِ اللغاتِ الأجنبية، لكنهم واجَهوا بعضَ المبادئِ في تعلُّم اللغة الأجنبية، المبنيَّةِ أيضاً على الاتجاه السُّلوكيّ، أهمُّها أن تعلُّمَ اللغةِ هو تَكوينُ عاداتٍ سُلوكيّةٍ آلِيَّةِ سَليمَة؛ وذلك بتَعزيز الاستجاباتِ الصَّحيحَة، وإبعادِ الاستجاباتِ الخاطِئة. ومن الباحثين من يرَى أن الطفلَ يَتَّبِع أسلوبَ المحاوَلَةِ والخَطأِ في اكتسابه لغَتَه الأمَّ، ويؤكِّد أن ما يرَدِّده المعرِفيّون الفِطرِيّون من اعتِمادِ الطفلِ على فَرض الفُروضِ حَولَ أنماطِ اللغةِ وتجريبِ هذه الفُروضِ، وتَثبيتِ ما يَصِحُّ منها، واستِبعادِ ما لا تؤيِّده المدخَلاتُ اللغويةُ، نوعٌ من التعلِّم بالمحاوَلَة والخَطأ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التعلم بالمحاولة والخطأ ","nonDiacriticsLemma":"التعلم بالمحاولة والخطأ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّعَلُّمُ بالمحَاوَلَةِ والخَطَأِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2842e54b-6f6a-4175-aaff-a00b3a0d640e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2842e54b-6f6a-4175-aaff-a00b3a0d640e","word":"تَمْيِيزٌ نَاقِصٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0e7","lexicalEntryId":"2842e54b-6f6a-4175-aaff-a00b3a0d640e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَمْيِيزٌ نَاقِصٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يَعني عَدَمَ تَميِيزِ المرءِ - في الفَهم أو في النُّطق - بين فُونِيمَيْن مُتقارِبَيْن في لغةٍ ما، ولاسيَّما لدى الناطِقين بغيرها، كعَدَمِ تَفريقِ غير العربيّ بين فونيمَيْ السِّين والصادِ، وفونيمَيْ القافِ والكافِ في العربية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُشير إلى استِخدام اللغويِّ الباحِثِ (في لغةٍ جديدَة) رَمزا واحدا لفونِيمَين أو أكثَرَ في المراحل الأولى من بحثه حتى يَثبُت لدَيه أنهما فونيمان مُختَلِفان، وذلك بتَأثير عاداتِه اللغويّةِ الخاصَّة، أي التَّقليل في تَقدير الاختِلافات، في مقابِل المبالَغَةِ في تقدير الاختِلافات. وتُسمّى هذه أيضاً كتابةً قاصِرَةَ التَّميِيزِ under-differentiated transcription. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تمييز ناقص ","nonDiacriticsLemma":"تمييز ناقص","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَمْيِيزٌ نَاقِصٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

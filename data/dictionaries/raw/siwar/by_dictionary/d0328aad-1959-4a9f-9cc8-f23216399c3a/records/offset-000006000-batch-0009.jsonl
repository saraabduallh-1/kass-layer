{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2f11178e-4522-4c54-bc76-761a8df6017e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2f11178e-4522-4c54-bc76-761a8df6017e","word":"تَعْلِيمٌ ثُنَائِيٌّ انْتِقَالِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0f3","lexicalEntryId":"2f11178e-4522-4c54-bc76-761a8df6017e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْلِيمٌ ثُنَائِيٌّ انْتِقَالِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَمَطٌ من أنماط التعليمِ الثُّنائيِّ اللُّغةِ في مراحِل التعليمِ الأساس، ولاسيَّما المرحلةُ الابتدائية، يَنتَقِل فيه الطالبُ من لغته الأمِّ إلى اللغة الثانيةِ أو الأجنبيةِ بطريقَةٍ تَدريجِيَّة؛ فيَبدأ باستِعمال اللغةِ الأمِّ وحدَها أو مع اللغة الهَدَفِ، ثم يَقتَصِر على اللغة الهَدَفِ لغةً للتدريس دونَ اللغةِ الأمِّ. ويُسمّى هذا التعليمُ أيضا: transitional bilingual teaching. راجع:  @(bilingual education) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم ثنائي انتقالي ","nonDiacriticsLemma":"تعليم ثنائي انتقالي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْلِيمٌ ثُنَائِيٌّ انْتِقَالِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

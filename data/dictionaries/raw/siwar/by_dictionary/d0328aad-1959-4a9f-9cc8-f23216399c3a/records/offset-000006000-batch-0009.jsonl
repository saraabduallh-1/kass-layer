{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2685437e-dbcc-4e05-9b4b-36d48a9abef8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2685437e-dbcc-4e05-9b4b-36d48a9abef8","word":"مَنْطِقَةٌ انْتِقَالِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0f8","lexicalEntryId":"2685437e-dbcc-4e05-9b4b-36d48a9abef8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَنْطِقَةٌ انْتِقَالِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيّ، يُشير إلى منطقةٍ جُغرافيّةٍ وُسطى لا تَبدو فيها فَوارِقُ اللَّهَجاتِ واضحةً؛ لوُقوعها على حُدود لهجَتَين مُتَميِّزَتَين، كحال المناطقِ التي تَقَع على الحُدود بين الدُّوَلِ العربيةِ أو داخلَ الدولةِ الواحِدة. قد يَنطَبق هذا الوَصفُ على لغَتَين مختَلِفَتَين، وذلك حين تَتَجاوَر اللغَتان، ويُصبح المقيمون على الحُدود بينهما يُتقِنون اللغَتَين بدرَجَةٍ واحدةٍ حتى لا تكاد تُمَيَّز لغتُهم الأمُّ من لغتِهم الثانية، كما هي حالُ العَرَبِ الذين ضُمَّت بلادُهم إلى بلاد مجاوِرَةٍ غيرِ ناطِقةٍ بالعربية؛ كعَرَب تركيا، وعَرَبِ إيران.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"منطقة انتقالية ","nonDiacriticsLemma":"منطقة انتقالية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَنْطِقَةٌ انْتِقَالِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

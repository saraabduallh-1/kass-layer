{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b906f5f3-04b9-4094-8a85-8491872d0f57/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b906f5f3-04b9-4094-8a85-8491872d0f57","word":"لُغَةٌ تَنْغِيمِيَّةٌ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93c7","lexicalEntryId":"b906f5f3-04b9-4094-8a85-8491872d0f57","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ تَنْغِيمِيَّةٌ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ للُّغة التي تَستَخدِم التَّنغيمَ جُزءًا من الجُملة لا جُزءًا من الكلمة؛ فتستَخدِم التَّنَوُّعاتِ الموسيقيةَ في الكلام بطريقَةٍ تَميِيزِيَّةٍ تفرِّق بين المعاني. فاختلافُ التَّنغيمِ يُمَكِّننا من التعبير عن جميع مشاعِرِنا وحالاتِنا الذِّهنِيةِ من كلِّ نوع، كما يمَكِّننا من تَغيِير الجُملةِ من خَبَرٍ إلى استِفهامٍ إلى توكيدٍ إلى انفِعالٍ إلى تعَجُّبٍ، بتَغيِير التَّنغيم، دونَ تَغيِيرٍ في شَكل الكلماتِ المكوِّنَةِ للجُملَة أو تَغيِيرِ مَوَاقِعِها. وبهذا المفهومِ فإن معظَمَ اللغاتِ يمكن أن تُسمّى تَنغيمِية، بيدَ أن لكلِّ لغةٍ نماذِجَ معيَّنةً من التَّنغيم، وكذلك كلُّ لَهجَةٍ داخِلَ اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة تنغيمية  ","nonDiacriticsLemma":"لغة تنغيمية ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ تَنْغِيمِيَّةٌ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":n
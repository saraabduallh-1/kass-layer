{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dad0b044-7001-44a9-86dc-e9ebb6b78f7a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dad0b044-7001-44a9-86dc-e9ebb6b78f7a","word":"مُشْكِلَةٌ تَنْغِيمِيَّةٌ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93be","lexicalEntryId":"dad0b044-7001-44a9-86dc-e9ebb6b78f7a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُشْكِلَةٌ تَنْغِيمِيَّةٌ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"صُعوبةٌ يُواجِهها متعلِّمُ اللغةِ في نُطق جُملةٍ أو جُمَلٍ في اللغة الهَدَفِ بالتنغيم الصحيح، ولاسيَّما حين لا يمكن التَّميِيزُ بين الجُملةِ الإخبارِيةِ والجُملةِ الاستفهاميةِ والجُملةِ التعَجُّبِيةِ والجٌملةِ المنفِيةِ- إلا بالتنغيم. وتزداد هذه الصُّعوبةُ حين يكون المتعلِّمُ ناطِقًا بلُغةٍ غيرِ تَنغيمية، ولم يتعَوَّد على الوَظائف التنغيمِيةِ للجُملة. وتحدُث هذه المشكِلةُ في فَهم المعنى أيضا حين لا يمكن التميِيزُ بين أنواعِ الجُمَلِ التي تختَلِف في التنغيم فقط. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مشكلة تنغيمية  ","nonDiacriticsLemma":"مشكلة تنغيمية ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُشْكِلَةٌ تَنْغِيمِيَّةٌ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/df7615d3-4a4c-4e16-b0f0-1ed09fed3165/get-public-entry"},"browse_index_record":{"lexicalEntryId":"df7615d3-4a4c-4e16-b0f0-1ed09fed3165","word":"خَطَأٌ لُغَوِيٌّ دَاخِلِيٌّ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93bf","lexicalEntryId":"df7615d3-4a4c-4e16-b0f0-1ed09fed3165","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"خَطَأٌ لُغَوِيٌّ دَاخِلِيٌّ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تحليل الأخطاء، يُشير إلى الخَطأ اللغويِّ الذي يَقَع فيه متعلِّمُ اللغةِ الأجنَبية؛ لسبَبٍ أو لأسبابٍ داخِلَ اللغةِ الهَدَف، وليس نتيجَةَ تَدَخُّلٍ أو نَقلٍ من اللغة الأمِّ للمتعلِّمِ. ومن الأخطاء ذاتِ الأسبابِ الداخِلية: انتِقالُ أثَرِ التدريبِ من نَمَطٍ إلى آخَرَ داخِلَ اللغةِ الهَدَف، والمبالَغَةُ في التعميم، والجَهلُ بقُيُود القاعدة، والتطبيقُ الناقِصُ للقاعدة، وعدَمُ اطِّرادِ القاعدَةِ التي تحكُم النَّمَطَ في اللغة الهدَف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"خطأ لغوي داخلي  ","nonDiacriticsLemma":"خطأ لغوي داخلي ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"خَطَأٌ لُغَوِيٌّ دَاخِلِيٌّ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

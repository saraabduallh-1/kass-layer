{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/91b68cf6-d938-4993-a631-bb8c12e67867/get-public-entry"},"browse_index_record":{"lexicalEntryId":"91b68cf6-d938-4993-a631-bb8c12e67867","word":"النَّحْوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b919c","lexicalEntryId":"91b68cf6-d938-4993-a631-bb8c12e67867","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُطلِقه أصحابُ النماذِجِ الوَظيفيةِ في اكتساب اللغةِ الثانيةِ على سِمَةٍ تظهَر في المراحِل المبكِّرةِ من اللغة المرحَليةِ لدى متعلِّمِ اللغةِ الثانية؛ حيث يَعتَمِد على الإستراتيجيات التَّداوُليَّةِ المقاميَّةِ في توصيل رِسالَتِه إلى المخاطَب، بدَلًا من استعمال التراكيبِ اللغويةِ بطريقَةٍ سَليمة. ثم يتحَوَّل تدريجيًّا عن هذه الإستراتيجيةِ إلى استعمال القواعدِ والقوانينِ اللغويةِ التي تَحْكُم استعمالَ اللغةِ بعد أن يكون قد أتقَنَها. والنحويَّةُ هنا استِعمالٌ مجازِيٌّ تَعني استِعمالَ الإستراتيجياتِ أو الإشارات بدَلًا من النَّحو.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"النحوية ","nonDiacriticsLemma":"النحوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّحْوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9ca2ee36-88ce-4fab-b31f-3eee967708fe/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9ca2ee36-88ce-4fab-b31f-3eee967708fe","word":"مَعْنَى نَحْوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b919d","lexicalEntryId":"9ca2ee36-88ce-4fab-b31f-3eee967708fe","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَعْنَى نَحْوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وصفٌ يُطلَق على معنى الكلمةِ في التركيب النحويِّ الذي قد يختَلِف عن معناها المعجَميِّ، أي يختَلِف عن معناها منفَصِلَةً عن الجُملة أو عن السِّياق. وهذا هو المعنى الحقيقيُّ؛ لأن الكلمةَ لا معنى لها خارِجَ السِّياق، وقد يختَلِف هذا المعنى عن المعنى الخاصِّ الذي يتعلَّق بالمتكلِّم والسّامِع فقط.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وصفٌ يُطلَق على المعنى الوَظيفيِّ للكلمة أو معنى الكلمةِ الوَظيفيةِ function word، أي غيرِ المعجَمية؛ فالكلماتُ الوَظيفيةُ ذاتُ مَعانٍ نحويةٍ، لا تَستَقِلُّ بذاتها بل تَفتَقِر إلى كلماتٍ أخرى في التركيب ليتَّضِح معناها. ووَظيفتُها في الكلام التعبيرُ عن العلاقات النحويةِ والرَّبطُ بين عناصِرِ الجُملة. فالضمائرُ والموصولاتُ وحروفُ الجَرِّ وحروفُ العَطفِ كلُّها ذاتُ مَعانٍ نحوية. راجع:  @(function(al) word) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وصفٌ يُطلَق على المعنى العامِّ للجُملةِ، المستَمَدِّ من ترتيب كلماتِها، وما يرتَبِط بهذه الكلماتِ من سوابِقَ ولواصِقَ ولواحِق، وما تتضَ
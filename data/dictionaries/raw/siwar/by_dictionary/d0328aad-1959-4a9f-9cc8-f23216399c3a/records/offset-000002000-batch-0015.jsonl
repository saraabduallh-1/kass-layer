{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e57b547d-40a9-450b-847c-daf3603ff42e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e57b547d-40a9-450b-847c-daf3603ff42e","word":"تَرْتِيبٌ نَحْوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91ac","lexicalEntryId":"e57b547d-40a9-450b-847c-daf3603ff42e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْتِيبٌ نَحْوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ترتيبُ الكلماتِ والعباراتِ داخِلَ الجُملةِ بحسَب قوانينِ النحو في لغةٍ مُعيَّنة. وتختَلِف وَظيفةُ هذا الترتيبِ وأهميَّتُه من لغةٍ إلى أخرى بحسَب القرائنِ التي تُعين على تحديد المعنى والوَظائفِ النحويةِ لعناصِر الجُملة. فاللغةُ العربيةُ مثلا يَعتَمِد بناءُ الجُملةِ فيها على العلامَة الإعرابيةِ في أغلَب الحالات، وتَستَغني بها عن ترتيب الكلمات؛ في حين يَعتَمِد بناءُ الجُملةِ الإنجليزيةِ اعتمادا شِبهَ كُلِّيٍّ على هذا الترتيب. ويُسمّى هذا الترتيبُ أيضا: syntactic order.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ترتيب نحوي ","nonDiacriticsLemma":"ترتيب نحوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرْتِيبٌ نَحْوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

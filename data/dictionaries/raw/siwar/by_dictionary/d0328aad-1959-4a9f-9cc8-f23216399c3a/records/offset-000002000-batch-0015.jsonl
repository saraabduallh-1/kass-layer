{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/79231997-cea4-456c-8d17-8e4d5a87e299/get-public-entry"},"browse_index_record":{"lexicalEntryId":"79231997-cea4-456c-8d17-8e4d5a87e299","word":"تَحْلِيلٌ نَحْوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91aa","lexicalEntryId":"79231997-cea4-456c-8d17-8e4d5a87e299","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلٌ نَحْوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تحليلُ الجُملةِ على مستَوًى تركيبيٍّ، أي تحليلُ التراكيبِ اللغويةِ من حيث ترتيبُ كلماتِها، والعلاقاتُ بين أجزائها، ووَظائفُها، كما في تحليل الجُملةِ إلى مُكوِّناتها المباشِرَة. لكلِّ مدرسةٍ أو نظريةٍ لغويةٍ - قديمةٍ أو حديثةٍ - منهَجٌ في التَّحليل النحويِّ؛ بعضُها يركِّز على الشَّكل ويُهمِل المعنى أو يُصنِّفه في مستوى أدنى، وبعضُها يُعنَى بالشَّكل والمعنى بدرَجَةٍ واحدة. والإعرابُ في اللغة العربيةِ منهَجٌ من مناهِج التَّحليلِ النحويّ، يجمَع بين الشَّكل والمعنى، فالإعرابُ في النحو العربيِّ فَرعُ المعنى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل نحوي ","nonDiacriticsLemma":"تحليل نحوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلٌ نَحْوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

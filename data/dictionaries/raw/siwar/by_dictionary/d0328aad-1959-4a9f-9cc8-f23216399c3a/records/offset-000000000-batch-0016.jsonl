{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c8075159-77f3-4261-87be-ea946e829a86/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c8075159-77f3-4261-87be-ea946e829a86","word":"المُعِينَاتُ السَّمْعِيَّةُ البَصَرِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89e4","lexicalEntryId":"c8075159-77f3-4261-87be-ea946e829a86","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المُعِينَاتُ السَّمْعِيَّةُ البَصَرِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الوَسائلُ والأدواتُ السَّمعيةُ البَصَريةُ التي يَستَعمِلها المعلِّمُ لتَوصيل المعلوماتِ إلى طلابه بسُهولة، ولضَمان بقائها في ذاكرَة المتعلِّمِ مدَّةً أطوَل. ومن المُعِينات السَّمعيةِ البَصَريةِ في تعليم اللغات: العَيِّناتُ الحَقيقِيةُ، والصُّوَرُ، والمجَسَّماتُ، والجَداوُلُ، والبِطاقاتُ، وآلاتُ التَّسجيلِ، وأجهِزَةُ الفِيديو، والتلفازُ، ومنها البرامجُ الحاسوبيةُ التي أغنَت عن كثيرٍ من الوَسائل التعليميةِ التقليدية؛ لشُمُولها ومُرونَتِها ودِقَّتِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المعينات السمعية البصرية ","nonDiacriticsLemma":"المعينات السمعية البصرية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المُعِينَاتُ السَّمْعِيَّةُ البَصَرِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

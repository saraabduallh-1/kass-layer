{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2179672b-e09a-4900-adec-313413ff33bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2179672b-e09a-4900-adec-313413ff33bf","word":"مَوَادُّ مَصْنُوعَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89d6","lexicalEntryId":"2179672b-e09a-4900-adec-313413ff33bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَوَادُّ مَصْنُوعَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تَطبيقيٌّ تعليميٌّ، يُقصَد به الموادُّ التعليميةُ المصنوعَةُ المخصَّصَةُ لمتعلِّمي اللغةِ الأجنبيةِ الناطقين بغيرها، التي رُوعِي في اختِيارها وتَنظيمِها وعَرضِها المبادئُ اللغويةُ التطبيقيةٌ الصارِمَةُ؛ من تَدَرُّجٍ في الصُّعُوبة، ومُراعاةٍ للشُّيوع، ونحوِ ذلك، في كلٍّ من المفرَدات والدّلالاتِ والصِّيَغِ والتراكيبِ والمفاهيمِ الثقافية. ويُقابِل هذه الموادَّ المصنوعةَ الموادُّ الأصيلَةُ أو الحَقيقِيةُ authentic materials الموجَّهَةُ أصلًا للناطقين باللغة الهَدَف، المأخوذَةُ من مصادِرَ لغويةٍ أو مَواقِفَ طبيعية. ويُعتَقَد أن النوعَ الأولَ مُفيدٌ في المراحِل المبكِّرَةِ لتعلُّم اللغة، لكن يجب الانتِقالُ منه تَدريجيًّا إلى النوع الثاني ابتداءً من المستوَى المتوسِّط. راجع:  @(authentic materials) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مواد مصنوعة ","nonDiacriticsLemma":"مواد مصنوعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَوَادُّ مَصْنُوعَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

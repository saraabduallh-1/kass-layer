{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/818ea82f-8fa7-4a08-ac64-6507b3325d62/get-public-entry"},"browse_index_record":{"lexicalEntryId":"818ea82f-8fa7-4a08-ac64-6507b3325d62","word":"طَلاقَةٌ (لُغَوِيَّةٌ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b904e","lexicalEntryId":"818ea82f-8fa7-4a08-ac64-6507b3325d62","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"طَلاقَةٌ (لُغَوِيَّةٌ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إصدارُ الكلامِ بطريقَةٍ سَلِسَةٍ، من غير تَفكيرٍ في اختيار الكلماتِ وبناءِ الصِّيَغِ والتراكيب، ولا ترَدُّدٍ ولا تَلَعْثُم في الكلام، بل يكون الكلامُ طبعيًّا من حيث السرعةُ والوَصلُ والوَقفُ والنَّبرُ والتَّنغيمُ والإيقاعُ، واستعمالُ حُروفِ الجَرِّ وأدواتِ الرَّبط، واختِيارُ الكلماتِ المناسِبةِ، ونحوُ ذلك. وفي تعليم اللغاتِ الأجنَبيةِ تُوصَف الطلاقَةُ بأنها الكِفايَةُ التواصُليةُ لمتعلِّم اللغةِ الَهدَفِ ولو تضَمَّن كلامُه بعضَ الأخطاءِ التي لا تؤدِّي إلى صُعوباتٍ في فَهم الرِّسالة. ويُفرَّق عادةً بين الطلاقَة - بهذا المفهومِ - والدِّقَّة اللغويةِ أو الصِّحَّة النحويةِ accuracy؛ فالثانيةُ مَطلوبَةٌ شَريطَةَ ألا تكون على حساب الأولى. بيدَ أن التركيزَ على الطلاقَة في وَقتٍ مُبكِّرٍ قد يؤدِّي إلى تحَجُّر أخطاء متعلِّمِ اللغةِ error fossilization أو بعضِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"طلاقة (لغوية) ","nonDiacriticsLemma":"طلاقة (لغوية)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"طَلاقَةٌ (لُغَوِيَّةٌ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d984d8d1-40ca-4f7d-b5eb-eb56eeebe8e9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d984d8d1-40ca-4f7d-b5eb-eb56eeebe8e9","word":"أُسْلُوبٌ رَسْمِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b904f","lexicalEntryId":"d984d8d1-40ca-4f7d-b5eb-eb56eeebe8e9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُسْلُوبٌ رَسْمِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ في الكتابة يُعنَى بالجوانب الرَّسمية، ومُراعاةِ سِياقِ الحالِ أو المقامِ  المناسِبِ للمتَلَقِّي من حيث الشَّكلُ والمعنى والطُّولُ والقِصَرُ ونحوُ ذلك. ويُفَرَّق بين الأسلوبِ الرَّسميِّ هذا والأسلوبِ غيرِ الرَّسميِّ informal style. فالأسلوبُ الأوّلُ يكون في الكتابَة العلميةِ وفي الوَثائق الرَّسميةِ والقانونية؛ حيث تختُار الكلماتُ الطويلةُ، والجُمَلُ المعقَّدَةُ التي لا لَبسَ فيها، والأساليبُ المهذَّبَةُ. أما الأسلوبُ الثاني، الذي يكون في الكلام العاديِّ أو في الكتابَة غيرِ الرَّسمية، فتكون فيه الكلماتُ قصيرَةً شائعَةً، والجُمَلُ بسيطَةً وقصيرَة، وقد تتضَمَّن معانيَ خاصَّةً أو استِعمالاتٍ تداوُليةً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أسلوب رسمي ","nonDiacriticsLemma":"أسلوب رسمي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُسْلُوبٌ رَسْمِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1320a411-0942-4580-8cef-b890c3d0e691/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1320a411-0942-4580-8cef-b890c3d0e691","word":"شَخْصٌ انْبِسَاطِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9050","lexicalEntryId":"1320a411-0942-4580-8cef-b890c3d0e691","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"شَخْصٌ انْبِسَاطِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إنسانٌ منبَسِطُ الشَّخصِيةِ أو مُنفَتِحُ الشَّخصِية، يَستَمتِع بالاختِلاط بالناس، ويتفاعَل معهم، ويتَّسِم بالمجازَفَة وتحَمُّل المخاطِر، خلافا للشَّخص المنطوِي على نفسه introvert. وعلى الرَّغم من صُعوبَة التَّفريقِ بين الشَّخصِيَّتَين، وظُهورِ كلا النَّمَطَين في سُلوك شخصٍ واحدٍ أحيانا كثيرة، فإن بعضَ اللغويِّين التطبيقيين يَرَون أن الشَّخصَ المنبَسِطَ أقدَرُ على تعلُّم اللغةِ من الشَّخص المنطَوِي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"شخص انبساطي ","nonDiacriticsLemma":"شخص انبساطي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"شَخْصٌ انْبِسَاطِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

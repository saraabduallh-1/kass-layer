{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/87834558-3a32-46a2-9847-fa5777a720e1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"87834558-3a32-46a2-9847-fa5777a720e1","word":"عِلْمُ اللُّغَةِ المَيْدَانِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b903b","lexicalEntryId":"87834558-3a32-46a2-9847-fa5777a720e1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ المَيْدَانِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يُطلَق على طبيعَة البَحثِ اللغويِّ الميدانِيّ، حيث يجمَع الباحِثُ اللغويُّ مادَّتَه العِلميةَ عن اللغة التي يدرُسها بالاتّصال الحَيِّ المباشِرِ بالناطِقين بها، أو بمُخْبِرٍ منهم informant؛ فلا يقتَصِر على الموادِّ المنشورَة، أو ما يُكتَب حَولَ اللغة. يَنطَبِق هذا الوَصفُ أيضا على الدراسة اللغويةِ التَّطبيقِيةِ في النُّمُوِّ اللغويِّ المرحَلِيِّ في كلٍّ من اللغة الأمِّ واللغةِ الثانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة الميداني ","nonDiacriticsLemma":"علم اللغة الميداني","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ المَيْدَانِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/82bfb02b-1e0c-4f62-9a6d-ce348b4b6c08/get-public-entry"},"browse_index_record":{"lexicalEntryId":"82bfb02b-1e0c-4f62-9a6d-ce348b4b6c08","word":"دِرَاسَةٌ تَتَبُّعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b903c","lexicalEntryId":"82bfb02b-1e0c-4f62-9a6d-ce348b4b6c08","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دِرَاسَةٌ تَتَبُّعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في البحث العلمي، يُشير إلى أيِّ دراسةٍ تُنَفَّذ لمتَابَعَة نتائجِ دراسةٍ سابِقَة بغَرَض التأكُّدِ من نتائجها، أو للنظر فيما قد تأخذه هذه النتائجُ من مُنحَنى بعد مدَّةٍ زَمَنِيةٍ طويلةٍ نِسبِيًّا، أو بعد إجراءِ بعضِ التعديلاتِ المحدودَةِ على الدراسة. وتعليمُ اللغاتِ الأمِّ والثانيةِ والأجنبيةِ من أهم الميادينِ التي تهتَمُّ بهذا النوعِ من الدراسات، ولاسيَّما في دراسات النُّمُوِّ اللغويِّ في اللغة الأمِّ، ودراساتِ اللغةِ المرحَليةِ في اللغة الثانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دراسة تتبعية ","nonDiacriticsLemma":"دراسة تتبعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دِرَاسَةٌ تَتَبُّعِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

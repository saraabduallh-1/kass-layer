{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/37f81838-b60b-4f82-a2f0-9566a9718019/get-public-entry"},"browse_index_record":{"lexicalEntryId":"37f81838-b60b-4f82-a2f0-9566a9718019","word":"نِظَامٌ اعْتِبَاطِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89fb","lexicalEntryId":"37f81838-b60b-4f82-a2f0-9566a9718019","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نِظَامٌ اعْتِبَاطِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظامٌ لا توجَد فيه علاقةٌ سَبَبيَّةٌ بين صيَغِ الكلماتِ ودلالاتِها، وهو إشارةٌ إلى اللغة البشَريةِ التي تُعَدُّ الاعتِباطيةُ إحدى سِماتِها. راجع:  @(arbitrariness) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في لغةِ الإشارة لدى الصُّمِّ، يُشير إلى أن العلاقةَ بين الأصواتِ الإشارِيَّةِ ودَلالاتِها اعتِباطيةٌ غيرُ منطِقِيةٍ، مثلما أن العلاقةَ بين الصوتِ والمعنى اعتباطيةٌ في اللغات المنطوقَة، وإن كانت العلاقَةُ بينهما في لغة الإشارَةِ أقلَّ اعتِباطِيةً منها في اللغة المنطوقَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظام اعتباطي ","nonDiacriticsLemma":"نظام اعتباطي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نِظَامٌ اعْتِبَاطِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9e3241f4-22ff-4848-84b0-031e434c2930/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9e3241f4-22ff-4848-84b0-031e434c2930","word":"صِيغَةٌ مَهْجُورَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89fc","lexicalEntryId":"9e3241f4-22ff-4848-84b0-031e434c2930","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صِيغَةٌ مَهْجُورَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"كلمةٌ أو تَعبيرٌ مَهْجور يَلجأ إليه المترجِمون وأعضاءُ المجامِعِ اللغوية؛ لاستِخدامِه مُقابِلَ كلمةٍ أو تَعبيرٍ أعجَميٍّ يتَعذَّر وَصفُه أو إيجادُ مُقابِلٍ له في مُعجَم اللغةِ المعاصِرَة، مثلُ كلمةِ (قِطار) التي أطلقها العربُ على وَسيلَة النَّقلِ المعروفَةِ train، وكانت تُطلَق في العربية على البَعير الذي يتقَدَّم الإبلَ فيَقودها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"لفظٌ قديمٌ أو مَهجورٌ، لا يُستَعمَل إلا في أساليب التخاطُبِ ذاتِ الطابَعِ المحافِظِ أو في المناسَباتِ والطُّقوسِ الدِّينيَّةِ والمراسِمِ والبروتوكولاتِ الرَّسمية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صيغة مهجورة ","nonDiacriticsLemma":"صيغة مهجورة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صِيغَةٌ مَهْجُورَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/432633de-4df7-4560-a85b-5008f6e72ded/get-public-entry"},"browse_index_record":{"lexicalEntryId":"432633de-4df7-4560-a85b-5008f6e72ded","word":"الفُونِيمُ الأُمّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89fd","lexicalEntryId":"432633de-4df7-4560-a85b-5008f6e72ded","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الفُونِيمُ الأُمّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ أطلَقَه ترُوبتسكوي Trubetszkoy لوَصف الفُونيمِ الأصليِّ الذي يتفَرَّع إلى متَغِيِّراتٍ لا تؤثِّر في المعنى. فالجيمُ العربيةُ: /ج/ فونيمٌ أمٌّ لأن جميعَ متغيِّراتِه، كالجيم المعطَّشَةِ والجيمِ القاهريةِ وغيرِها، لا تُغيِّر المعنى. ومثلُه الفونيمُ: /T/ الذي له عَدَدٌ من المتغيِّرات في الإنجليزية، ويُرمَز له بحَرفٍ كبيرٍ: /T/.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الفونيم الأم ","nonDiacriticsLemma":"الفونيم الأم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الفُونِيمُ الأُمّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/39f4d166-0750-42dc-ba1a-a9b38b34c4b3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"39f4d166-0750-42dc-ba1a-a9b38b34c4b3","word":"لُغَةٌ اصْطِنَاعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89fe","lexicalEntryId":"39f4d166-0750-42dc-ba1a-a9b38b34c4b3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ اصْطِنَاعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ غيرُ طبيعية، أي ليسَت لغةً لشَعبٍ من الشعوب، وإنما صُنِعت لأغراضٍ تواصُليّةٍ خاصَّةٍ كلُغةِ البحّارَة ولغةِ المِلاحَةِ الجَوِّيَّة، أو لتَيسِير التواصُلِ بين الناسِ وتحويلِه إلى لغةٍ ثانيةٍ عالَمِيةٍ موحَّدَةٍ كلُغة الإسبرانتو Esperanto، ولغةِ الأيدو Ido، وغيرِهما من اللغات التي بلغت المئات منذ منتَصف القرنِ الثامن عشَر. وقد يُطلَق المصطلَحُ على لغةِ المنطِق. ويطلَق هذا المصطلح - أيضاً - على أيِّ لغةٍ إلكترونيةٍ تُستَخدَم في تَشغيل الحاسوبِ وبرمَجَتِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة اصطناعية ","nonDiacriticsLemma":"لغة اصطناعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ اصْطِنَاعِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7da69463-f2b3-4081-a834-472498a03af2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7da69463-f2b3-4081-a834-472498a03af2","word":"مِقْيَاسُ الاتِّجَاهِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b89ff","lexicalEntryId":"7da69463-f2b3-4081-a834-472498a03af2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مِقْيَاسُ الاتِّجَاهِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أداةٌ تَقيس مَوقِفَ الطالبِ من اللغة الأجنبيةِ التي يتعلَّمها أو سَوفَ يتعلَّمها، وذلك بقياس مَواقِفِه من قضايا ذاتِ علاقَةٍ بهذه اللغةِ وثقافةِ الناطقين بها وقِيَمِهم. وتقاسُ الاتجاهاتُ بمقايِيسَ مختَلِفة، ذاتِ درَجاتٍ متفاوِتَة، أهمها مقياسَا ثورستون وليكَرت. وقد يُستفاد من هذه المقاييسِ في دراسة الدَّوافعِ لدى متعلِّمي اللغاتِ الأجنبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مقياس الاتجاه ","nonDiacriticsLemma":"مقياس الاتجاه","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مِقْيَاسُ الاتِّجَاهِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

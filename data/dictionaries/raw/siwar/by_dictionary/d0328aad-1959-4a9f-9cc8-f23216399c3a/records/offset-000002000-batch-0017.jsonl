{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/54eeb010-1f80-4b8e-b338-f9ebc101585f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"54eeb010-1f80-4b8e-b338-f9ebc101585f","word":"لاحِقَةٌ نَحْوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91d7","lexicalEntryId":"54eeb010-1f80-4b8e-b338-f9ebc101585f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لاحِقَةٌ نَحْوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لاحِقةٌ لا تُغيِّر معنى الكلمةِ ولا نوعَها، وإنما تغيِّر حالَتَها من مفرَدٍ إلى مثنى أو جَمعٍ، أو من مضارِعٍ إلى ماضٍ، وتُسمّى أيضا: inflectional suffix. وهي أنواعٌ تختَلِف من لغةٍ لأخرى، يَبلُغ عدَدُها في الإنجليزية مثلاً ثمانيَ لواحِق، هي: لاحِقَةُ الجَمعِ s، كما في books، ولاحِقَةُ المِلكيةِ boy's، ولاحِقَةُ الاستِمرارِ reading، ولاحِقَةُ الزمن الحاضر للمفرَد الغائبِ studies، ولاحِقَةُ الماضي learned، ولاحِقَةُ اسمِ المفعولِ written، ولاحِقَةُ المقارَنَةِ larger، ولاحِقَةُ التَّفضيلِ المطلق largest. وتُقابِلها اللاحِقَةُ الاشتِقاقيةُ derivational suffix.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لاحقة نحوية ","nonDiacriticsLemma":"لاحقة نحوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لاحِقَةٌ نَحْوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d3b9a969-4dce-48fa-b006-20808cf5c261/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d3b9a969-4dce-48fa-b006-20808cf5c261","word":"النِّظَامُ النَّحْوِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91d8","lexicalEntryId":"d3b9a969-4dce-48fa-b006-20808cf5c261","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النِّظَامُ النَّحْوِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ استَعمَله تشومسكي، إشارَةً إلى وِجهَة نَظَرِه في النظام النحوي؛ إذ يَرى أن الشَّرطَ الأساسَ الأولَ في هذا النظامِ أن يكون قادِرا على التَّميِيز بين الأقوالِ الصحيحةِ والأقوالِ غيرِ الصحيحةِ نحويًّا، وأن يُقَدِّم القوانينَ التي سوف تتَنَبّأ بما هو صحيحٌ نحويًّا وما هو غيرُ صحيحٍ نحويًّا من كلِّ الأقوالِ الممكِنَةِ التي لم تُسمَع من قَبل. ويؤكّد تشومسكي أن هذا موضوعٌ تجريبيٌّ يُشبِه التَّنبُّؤات العلميةَ في البحث في الحقائق التي يمكن ملاحَظَتُها، وإذا طُبِّق هذا الشَّرطُ في الدراسات اللغويةِ فهذا يَعني إمكانَ التَّنَبُّؤِ بالجُمَل التي يُصدِرها المتكلِّمُ الناطِقُ باللغة، وتكون مَقبولَةً لدى الناطقين بها، ومتَّفِقَةً مع القواعد النحويةِ لهذه اللغة، ويَخرُج من ذلك الجُمَلُ غيرُ الصحيحةِ التي يُصدِرها المتكلِّمُ أحيانا، وكذلك الجُمَلُ الناقِصَةُ لأسبابٍ عارِضَة. ويرى تشومسكي أيضا أن ثَمةَ شَرطا آخَرَ للنظام النحويِّ، هو ألّا تكون قوانينُه قادِرةً إلا على توليد كل الجُمَلِ الصحيحةِ نحويًّا، وهو ما أطلَق عليه السِّمَةَ التوليديةَ الضَّعيفةَ weak generative capacity. أما الشَّرطُ الثالثُ المثاليُّ في نَظَره، فهو أن يَصِل النظامُ النحويُّ إلى مستوَى الكِفايَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظام النحوي ","nonDiacriticsLemma":"النظام النحوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النِّظَامُ النَّحْوِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

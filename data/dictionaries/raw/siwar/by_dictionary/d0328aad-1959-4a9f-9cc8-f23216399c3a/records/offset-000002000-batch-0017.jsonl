{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5f00ec64-fa56-443a-878f-6d0c0b7de694/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5f00ec64-fa56-443a-878f-6d0c0b7de694","word":"كَلِمَةٌ مُحَرَّفَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91dd","lexicalEntryId":"5f00ec64-fa56-443a-878f-6d0c0b7de694","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمَةٌ مُحَرَّفَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"كلمةٌ محرَّفةٌ عن صِيغَتها الأصلية؛ إما بسَبب خَطأٍ في الكتابة أو النَّقلِ أو الكلام، أو بسَبب استِعمالِ الأجانِبِ لها وفَهمِهم إيّاها خطأً، خاصةً حين تَلتَبِس الصِّيغَةُ بصِيغَةٍ أخرى في اللغة ذاتِها. مثالُ ذلك نُطقُ العرَبِ الكلمةَ الإنجليزيةَ: suburban  هكذا (سوبرمان) اعتقادا منهم أنها هي نفسُها superman دونَ تَمَعُّن في شَكلها ومعناها، وكلمةَ: penalty التي يَنطقونها بالعربية مَعكوسَةً هكذا: balanty. ومثلُهما كلمةُ: hemenex المستَعمَلةُ في بعض الدولِ الأوروبيةِ الناطِقَةِ بغير الإنجليزيةِ تحرِيفًا للعبارَة الإنجليزيةِ: ham and eggs. وهذه الصِّيَغُ والكلماتُ غالِبًا ما تتحَجَّر في لغة متعلِّمي اللغةِ الأجنَبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمة محرفة ","nonDiacriticsLemma":"كلمة محرفة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمَةٌ مُحَرَّفَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGen
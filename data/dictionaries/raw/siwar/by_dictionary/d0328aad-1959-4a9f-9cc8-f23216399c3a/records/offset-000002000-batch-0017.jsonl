{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/918cee5e-6ffe-472c-908b-009a86b11057/get-public-entry"},"browse_index_record":{"lexicalEntryId":"918cee5e-6ffe-472c-908b-009a86b11057","word":"مَدْرَسَةُ جِنِيف","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91cb","lexicalEntryId":"918cee5e-6ffe-472c-908b-009a86b11057","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَدْرَسَةُ جِنِيف","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المدرسةُ اللغويةُ التي أسَّسَها اللغويُّ السويسريُّ فرديناند دي سوسير Ferdinand de Saussure، رائدُ علمِ اللغةِ الحديث، الذي دَرَّس مبادئَ علمِ اللغةِ الحديثِ في جامعة جنيف بين عامَي 1906-1911م، ثم جَمَع بعضُ طلّابِه محاضراتِه في كتاب بعنوان: محاضرات في علم اللغةِ العامِّ. وهذه المدرسةُ هي نَواةُ علمِ اللغةِ الحديثِ في شَكله الوَصفِي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"اسمٌ يُطلَق أحيانا على منهَجٍ في اكتِساب اللغةِ وفقًا لآراء عالمِ النفسِ السويسريِّ جان بياجيه Jean Piaget، الذي عاش بين عامَيْ 1896-1980م، لاسيَّما تلك الدراساتُ التجريبيّةُ في النُّمُوِّ اللغويِّ لدَى الأطفالِ، التي طُبِّقت في عَدَدٍ من لغات العالَم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مدرسة جنيف ","nonDiacriticsLemma":"مدرسة جنيف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَدْرَسَةُ جِنِيف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

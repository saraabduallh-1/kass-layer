{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8482197f-1704-4ce3-b917-00fa9dc0256e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8482197f-1704-4ce3-b917-00fa9dc0256e","word":"عِلْمُ نَفْسِ الجِشْتالْت","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91d3","lexicalEntryId":"8482197f-1704-4ce3-b917-00fa9dc0256e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ نَفْسِ الجِشْتالْت","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ في علم النفس، أو علمِ النفسِ التربويِّ، تُركِّز على التعلُّم الكُلِّيِّ، وترَى أن الإدراكَ يتَّجِه إلى الكُلِّ أوّلا، وأن الكُلَّ ليس مجرَّدَ مجموعِ الأجزاء، وأن العَمَلياتِ العَقليةَ والسُّلوكَ لا يمكن تحليلُها إلى وحداتٍ أوَّلِيَّة، خِلافا للنَّظرَة السُّلوكيةِ والنظريةِ الاستِبطانِية. كانت هذه النظريةُ في بدايَتها مَقصورَةً على علم نفسِ الإدراك، ثم اتَّسَعَت آفاقُها لتَشمل التعلَّمَ وغيرَه من جوانب الحياةِ المختَلِفة. وتُعَدُّ أساسًا نظريًّا للطريقَة الكُلِّيَّة في تعليم القراءةِ للمبتَدئين، وطُبِّقَت نتائجُها في بعض طرائقِ تدريسِ اللغاتِ الأجنَبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم نفس الجشتالت ","nonDiacriticsLemma":"علم نفس الجشتالت","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ نَفْسِ الجِشْتالْت"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/70b5f4d6-0807-45ec-8cb2-731abc49c537/get-public-entry"},"browse_index_record":{"lexicalEntryId":"70b5f4d6-0807-45ec-8cb2-731abc49c537","word":"النَّظَرِيَّةُ الجِينِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91d1","lexicalEntryId":"70b5f4d6-0807-45ec-8cb2-731abc49c537","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّظَرِيَّةُ الجِينِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ ترَى أن استخدامَ الأصواتِ في كل لغةٍ خاضِعٌ لعواملَ جِينيةٍ خاصةٍ بأهلِ اللغةِ الأصليِّين، وأن ثمةَ عَلاقةً مباشِرةً بين استخدامِ صَوتٍ مُعيَّنٍ في إحدى اللغاتِ والتَّكوين الجِينِيِّ لذلك المجتَمَعِ اللغوي. لكن هذه النظريةَ مُخالِفةٌ لأسس علمِ اللغة، بل إن الواقِعَ يُخالِفها؛ فالطفلُ الذي يَعيش في بيئةٍ لغويةٍ يَكتَسِب لغتَها، بما فيها الأصوات، ويُصبِح ناطِقًا بها ولو لم يَنحَدِر من أصولِ المجتَمَعِ الأصلِيِّ لهذه اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظرية الجينية ","nonDiacriticsLemma":"النظرية الجينية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّظَرِيَّةُ الجِينِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

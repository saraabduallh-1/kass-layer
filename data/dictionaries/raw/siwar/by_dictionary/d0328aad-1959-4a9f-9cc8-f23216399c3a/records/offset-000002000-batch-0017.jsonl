{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a43d2c93-9614-42f9-abf7-4722358cee54/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a43d2c93-9614-42f9-abf7-4722358cee54","word":"مُورْفِيمٌ نَحْوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91cd","lexicalEntryId":"a43d2c93-9614-42f9-abf7-4722358cee54","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُورْفِيمٌ نَحْوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المورفيمُ الذي يؤدِّي وَظيفةً نحويةً، أي يُبَيِّن العلاقةَ بين الكلمةِ وسياقِها، كمورفيمات التَّثنِيةِ والجَمعِ والتأنيثِ والزَّمنِ والنَّسَبِ والإضافَةِ والتعَدِّي واللُّزوم. فاللاحِقَةُ (الواو والنون) في آخِرِ الاسمِ المفرَدِ في حالَةِ الرَّفعِ ليتحَوَّل إلى جَمعِ مذكَّرٍ سالم، مورفيمٌ نحويٌّ، مثلُ: (مُسلِم ومُسلمون)، و(مُعلِّم ومعلِّمون). ومثلُ ذلك مورفيمُ المفرَدِ الغائبِ: S الذي يَلحَق الفعلَ في الإنجليزية، نحوَ: He speaks English، ومثلُ: be, by في استعمالهما مع المبنيِّ للمَجهول، نحوَ: The apple was eaten by John. والمورفيمُ النحويُّ أحَدُ أنواعِ المورفيماتِ التي تَشمل أيضا المورفيمَ الصَّرفيَّ والمورفيمَ المعجَميَّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مورفيم نحوي ","nonDiacriticsLemma":"مورفيم نحوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُورْفِيمٌ نَحْوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

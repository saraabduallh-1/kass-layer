{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a8a0e778-e7a1-42d8-8f13-0b532d260ce9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a8a0e778-e7a1-42d8-8f13-0b532d260ce9","word":"جُزْئِيُّ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c7f","lexicalEntryId":"a8a0e778-e7a1-42d8-8f13-0b532d260ce9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جُزْئِيُّ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في الثَّنائيَّة اللغويَّةِ والتَّعدُّدِ اللغويِّ، يُطلَق على الشَّخص الذي تعلَّمَ عَدَدًا من اللغات في مَراحِلَ مختَلِفةٍ من عُمُره لكنه لم يَصِل في واحِدةٍ منها إلى دَرَجةٍ من الكِفايَة اللغوية تُشبِه كِفايَةَ الناطقين بها. وما زال اللغويون مختَلِفين في تَصنِيف هذه الظاهرَةِ ضِمنَ التَّعَدُّدِ اللغويِّ للأفراد والجَماعات؛ لصُعوبَة تَحديدِ دَرَجةِ الكِفايَةِ اللغويةِ التي تَجعل الشخصَ أو الجماعَةَ ضِمنَ المتحدِّثِين بلُغةٍ ما لُغةً ثانية. وقد يَعني المصطلحُ شِبهَ ثُنائيَّةٍ لُغويةٍ، وهي حالة الشَّخصِ أو المجتمَعِ الذي لم تَصِل ثُنائيَّتُه اللغويّةُ إلى درَجَة الكِفايَةِ اللغويةِ المطلوبَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جزئي اللغة ","nonDiacriticsLemma":"جزئي اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جُزْئِيُّ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__
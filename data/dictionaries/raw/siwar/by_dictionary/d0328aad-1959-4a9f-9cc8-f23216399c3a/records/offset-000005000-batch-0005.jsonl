{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/869cdc37-3b8e-45b9-b552-61fb6946d064/get-public-entry"},"browse_index_record":{"lexicalEntryId":"869cdc37-3b8e-45b9-b552-61fb6946d064","word":"فَرْضِيَّةُ الانْتِبَاهِ الانْتِقَائِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c8e","lexicalEntryId":"869cdc37-3b8e-45b9-b552-61fb6946d064","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرْضِيَّةُ الانْتِبَاهِ الانْتِقَائِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضِيَّةٌ في اكتِساب اللغةِ الثانية، يرَى أصحابها أن التعليمَ المنهَجِيَّ formal instruction للُّغة يُساعِد المتعلِّمَ في اكتِساب اللغةِ الثانية، لا بطَريقَةٍ مُباشِرَةٍ من التعليم نفسِه، التي تَجعَل النَّمَطَ اللغويَّ جُزءًا من لغته المرحَلِيَّة، وإنما بتَقديم ما يُساعِده في فَهم المدخَلِ اللغَويِّ، ويُنَبّهُه إلى ما يَحويه هذا المدخَلُ من سِماتٍ وأنماطٍ وتراكيب، وأن التَعليمَ يُحرِّك زِنادَ اكتِسابِ النَّمَط المستَهدَفِ إذا قُدِّم للمتعلِّم في الوَقت المناسِب.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية الانتباه الانتقائي ","nonDiacriticsLemma":"فرضية الانتباه الانتقائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرْضِيَّةُ الانْتِبَاهِ الانْتِقَائِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a494ca25-53a5-4251-bf18-0b98fff5b2f9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a494ca25-53a5-4251-bf18-0b98fff5b2f9","word":"مَرْكَزُ التَّعلُّمِ الذَّاتِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c8f","lexicalEntryId":"a494ca25-53a5-4251-bf18-0b98fff5b2f9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَرْكَزُ التَّعلُّمِ الذَّاتِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قاعَةٌ أو غُرفَةٌ داخِلَ المؤسَّسَةِ التَّعليميَّة، خاصةً في برامِج تَعليمِ اللغات، تَحوِي مَصادِرَ تَعلُّمٍ مختَلِفةً، يُمكن للطالب الاستِفادَةُ منها في أيِّ وَقتٍ تحتَ إشرافِ مُوجِّهٍ أو مُعلِّم. غالبا ما تَحوِي القاعَةُ أجهِزَةً حاسُوبيَّةً شَخصيَّةً، وأجهِزَةَ فِيديو، وشاشاتٍ تلفزيونيّةً، وأجهِزَةً سَمعِيّةً، ومَصادِرَ تعلُّمٍ أخرى متَنَوِّعةً، إضافةً إلى بعض الكُتَيِّبات والقصَصِ والرِّواياتِ والصُّوَرِ والمجسَّمات. تَحوِي هذه الأجهِزَةُ والمصادِرُ أيضا مَوَادَّ تَعليميَّةً مُكمّلةً لبرنامَج اللغةِ أو مَوَادَّ مُستَقلَّةً تُفيد في تعلُّم اللغة، وقد تكون مَربوطَةً بقواعدِ مَعلوماتٍ ومُدَوَّناتٍ لُغويَّةٍ مَحَلِّيَّةٍ أو عالَميَّة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مركز التعلم الذاتي ","nonDiacriticsLemma":"مركز التعلم الذاتي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَرْكَزُ التَّعلُّمِ الذَّاتِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5498dc42-c4f2-456f-b707-f128f0a4f097/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5498dc42-c4f2-456f-b707-f128f0a4f097","word":"تَعْلِيمٌ ذَاتِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c90","lexicalEntryId":"5498dc42-c4f2-456f-b707-f128f0a4f097","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْلِيمٌ ذَاتِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ في التَّعلُّم يَعمل فيه المتعلِّمُ وَحدَه أو مع مَجموعَةٍ من المتعلِّمين دون تَدَخُّلٍ أو سَيطَرَةٍ من معلِّم. هذا النَّوعُ من التعلُّم يَمنَح المتعلِّمَ أنشِطةً ذاتِيَّةً لتعلُّم اللغةِ تُساعِده في السَّيطَرَة الذَّاتِيَّةِ على طَريقَته وسُرعَتِه في التعلُّم. يَنطَلِق هذا الأسلوبُ من الإيمان بأن التعلُّمَ يكون أقوَى تَأثِيرًا إذا مُنِح المتعلِّمُ حُرِّيَةَ اختِيارِ الموادِّ التي يَتَعلَّمها، والإستِراتيجياتِ التي يَتَّبِعها، وتَحديدِ الوَقتِ الذي يَكفيه، والتَّوقيتِ الذي يُناسِبه، لكنّ متعلِّمَ اللغةِ لا يَستَغني عن المعلِّم طَوالَ مدَّةَ التعلُّم، ولا يَكتَفي بهذا التعلِّمِ الذاتيِّ؛ لأن تعلُّمَ اللغاتِ يحوِي مَهاراتٍ أصليّةً ومهاراتٍ فَرعيّةً تتطلَّب المشارَكةَ العمَليّةَ داخِلَ حُجرَةِ الصَّفِّ أو في الحياة العامَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم ذاتي ","nonDiacriticsLemma":"تعليم ذاتي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْلِيمٌ ذَاتِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

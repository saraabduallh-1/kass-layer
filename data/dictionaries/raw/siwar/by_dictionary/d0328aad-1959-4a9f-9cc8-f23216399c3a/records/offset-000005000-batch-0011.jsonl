{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/88a0f484-37b0-41ee-9581-2ffbf5072a6c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"88a0f484-37b0-41ee-9581-2ffbf5072a6c","word":"مُعَالَجَةٌ تَتَابُعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d2d","lexicalEntryId":"88a0f484-37b0-41ee-9581-2ffbf5072a6c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعَالَجَةٌ تَتَابُعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":" مُعالَجَةُ المَرءِ للمَعلومات أو العَمَلياتِ التي يَقوم بها بطريقَةٍ مُتَتَابِعَة؛ كأن يَستَمِع إلى شَخصَين يَتَحَدَّثان في وَقتٍ واحد، ولكنه لا يَنتَبِه إليهما في آنٍ واحد، وإنما يَنتَبِه إلى أحدهما مرَّةً ثم يَنتَقِل إلى الآخَر ثم يَعود إلى الأوَّل وهكذا. وهذه إحدى عَمَليّاتِ مُعالَجَةِ المعلومات، وتُقابِلها المعالَجَةُ المتَوَازِيَةُ  parallel processing","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معالجة تتابعية ","nonDiacriticsLemma":"معالجة تتابعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعَالَجَةٌ تَتَابُعِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3656e5ad-7f81-4b9c-aae3-412dea212ce7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3656e5ad-7f81-4b9c-aae3-412dea212ce7","word":"الاخْتِلافَاتُ اللغَوِيَّةُ بين الجِنْسَيْنِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d2e","lexicalEntryId":"3656e5ad-7f81-4b9c-aae3-412dea212ce7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الاخْتِلافَاتُ اللغَوِيَّةُ بين الجِنْسَيْنِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ اجتماعيٌّ، يَعني الفُروقَ بين الرَّجلِ والمرأةِ في الكلام، وذلك في نُطق الأصواتِ واستِعمالِ الكلماتِ والعباراتِ وأنماطِ الجُمَل، واستِعمال لغة الجسد. يتَفاوَتُ نوعُ هذا الاختِلافِ ودَرَجاتُه من لغةٍ إلى أخرى، وتُعَدُّ اللغةُ الإنجليزيةُ من أَقَلِّ اللغاتِ فُروقا بين الجنسَين في ذلك، بيدَ أن نتائجَ بعضِ الدِّراساتِ تُفيد أن النِّساءَ أكثَرُ من الرجال استِعمالا لصِيَغ الاستِفهامِ الذَّيليِّ tag questions، وألفاظ مدْحِ اللِّباسِ؛ مثل الكلماتِ الإنجليزيةِ: cute, divine, and durable، ومُفرداتِ ألوانٍ خاصَّةٍ مثلُ: beige, burgundy, and ecru، وأن الرِّجالَ أكثَرُ استِعمالًا من النِّساء لصِيَغ الحَلِف. وتُشير نتائجُ دراساتٍ أخرى أن الرِّجالَ يختَلفون عن النِّساء في تَنظِيم المحادَثَة وإدارتِها؛ إذ يَميل الرَّجُل إلى الجَدَل في الخِطاب ويَحرص على غَلَبَةِ مُخاطَبِه في الرأي، في حين تَميل المرأةُ إلى احتِرام رأي المخاطَبِ والتَّوَاصُلِ معه بأسلوب تَعاوُنيٍّ تَفَاوُضِيّ. في مُقابِل ذلك، لوحِظ أن الرَّجلَ - حين يَنخَرِط في محادَثَةٍ مع غيره - لا يتكلَّم حتى يأتيَ دَورُه في الكلام، في حين تَميل المرأةُ إلى التَّدَخُّل والمقاطَعَةِ بالتَّأيِيد أو بالرَّفض في أثناء حديثِ غيرِها. وعلى الرّغم من قلَّة الدراساتِ في هذا الموضوع بالعربية، فقد لوحِظ أن النِّساءَ العربيّات أكثَرُ حَلِفا من الرِّجال، وأكثَرُ منهم استِعمالا للإشارات ولغة الجسد في أثناء الحديث","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الاختلافات اللغوية بين الجنسين ","nonDiacriticsLemma":"الاختلافات اللغوية بين الجنسين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الاخْتِلافَاتُ اللغَوِيَّةُ بين الجِنْسَيْنِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1a772818-1bf1-4bea-a1b4-6803ca283bbb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1a772818-1bf1-4bea-a1b4-6803ca283bbb","word":"حَرَكَةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94f2","lexicalEntryId":"1a772818-1bf1-4bea-a1b4-6803ca283bbb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَرَكَةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُطلَق على أيِّ حَركَةٍ أو نَشاط لجماعَةٍ تُطالِبٍ بحَقٍّ لُغَويٍّ عامٍّ أو خاصٍّ. مثال ذلك أن تُطالِب جماعةٌ بأن تكون لغَتُها ضِمنَ اللغاتِ القَوميةِ في المجتَمَع، أو أن تكون ضِمنَ لُغاتِ التعليمِ فيه؛ كما حدَث للغة إقليمِ الباسْك في إسبانيا، واللغةِ الأمازيغيةِ في بعض دوَلِ شمالِ إفريقيا. وقد تكون الحَركَةُ غيرَ ذلك؛ كحَركَة اللغةِ الإنجليزيةِ فقَط English-only movement في الولايات المتحدَةِ الأمريكية، وحَركَة اللغةِ البَسيطَةِ Plain-language movement في الدُّوَل الناطِقَةِ بالإنجليزية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حركة لغوية ","nonDiacriticsLemma":"حركة لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حَرَكَةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

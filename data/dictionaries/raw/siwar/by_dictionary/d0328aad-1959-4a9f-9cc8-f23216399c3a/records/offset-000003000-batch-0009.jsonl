{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d772545c-dff1-478b-8bfd-be43c69b4626/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d772545c-dff1-478b-8bfd-be43c69b4626","word":"مُنْحَنَى التَّعَلُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94f7","lexicalEntryId":"d772545c-dff1-478b-8bfd-be43c69b4626","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُنْحَنَى التَّعَلُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جَدوَلٌ أو رَسمٌ بيانيٌّ يُوضِّح سُرعةَ تقدُّمِ المتعلِّمِ في اكتساب مهارَةٍ ما أو تعلُّمِ موادَّ تعليميةٍ جديدةٍ في مدَّة زَمنيةٍ معيَّنة، غالبا ما يَستَعمِله الباحثون في النُّمُوِّ اللغويِّ واللغةِ المرحَلية. فنُمُوُّ متعلِّمِ اللغةِ الإنجليزيةِ في اكتساب النفيِ مثلا يُمكن تصويرُه في رسمٍ بيانيٍّ يُمثّل المراحِلَ التي مَرَّ بها منذ بدأ تعلُّمَ اللغة الهَدَف، بما فيها من أخطاء مرحَلية، حتى اكتَسَب الاستعمالَ الصحيحَ لهذا التركيب. ويُرسَم المنحَنَى بناء على المعلومات التي جَمَعها الباحثُ أو المعلِّمُ بالتسجيل، أو بتَدوين الملحوظاتِ في فَتَراتٍ زَمنيةٍ مُتَعاقِبَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"منحنى التعلم ","nonDiacriticsLemma":"منحنى التعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُنْحَنَى التَّعَلُّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ce90a8a0-7af5-4caf-821a-5d888f5bb733/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ce90a8a0-7af5-4caf-821a-5d888f5bb733","word":"صُعُوبَةُ التَّعَلُّمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94f8","lexicalEntryId":"ce90a8a0-7af5-4caf-821a-5d888f5bb733","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صُعُوبَةُ التَّعَلُّمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المشكِلةُ أو المشكِلاتُ التي يُعاني منها المتعلِّمُ وتؤثِّر في تحصيله العلميِّ في مجالٍ معيَّنٍ، مقارَنةً بأترابه الطبيعيِّين. من أبرَز صُعوباتِ التعلُّمِ: حُبسَةُ القراءةِ dyslexia، وحُبسَةُ الكتابةِ dysgraphia. وفي حال تعلُّمِ اللغاتِ الأجنبية، قد تكون الصُّعوباتُ مَرحَليّةً ناتِجَةً عن عوامِل من داخِل المتعلِّمِ، أو لأسبابٍ تتعَلَّق بلغته الأمِّ، أو باللغة الهَدَفِ نفسِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صعوبة التعلم ","nonDiacriticsLemma":"صعوبة التعلم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صُعُوبَةُ التَّعَلُّمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/748d933a-79d6-405e-b102-e32b52b93846/get-public-entry"},"browse_index_record":{"lexicalEntryId":"748d933a-79d6-405e-b102-e32b52b93846","word":"أَيْسَرُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b94f9","lexicalEntryId":"748d933a-79d6-405e-b102-e32b52b93846","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَيْسَرُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الشخصُ الأعسَرُ الذي يَستَعمِل يَدَه اليُسرى، ويعتَمِد عليها أكثرَ من اعتِماده على يَده اليُمنى، في مقابِل الشخصِ الأيمَنِ right-handed. تُشير الدراساتُ في هذا المجالِ إلى أن نسبةَ الذين يَستَخدِمون اليَدَ اليُسرى من الناس تُبلغ 11%، وأن 60% من هؤلاء من النساء و 40% من الرجال. ويشير هذا المصطلَحُ إلى نوعٍ من التَّخصيصِ الجانبيِّ لوَظائف الدِّماغِ بما في ذلك الوَظائفُ اللغوية. وتُشير الدراساتُ إلى أن61% من الذين يَستَخدِمون اليَدَ اليُسرى، و95% من الذين يَستَخدِمون اليَدَ اليُمنى تتَمَركَز لغَتُهم في الجانِب الأيسَرِ من الدِّماغ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"A","root":null,"wordForms":[],"relatedSenses":[],"search":"أيسر ","nonDiacriticsLemma":"أيسر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَيْسَرُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

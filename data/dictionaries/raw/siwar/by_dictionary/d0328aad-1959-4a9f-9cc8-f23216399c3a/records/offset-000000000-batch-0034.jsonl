{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/67f9eaa9-3e2e-4ada-9ea8-8b81045ec3ee/get-public-entry"},"browse_index_record":{"lexicalEntryId":"67f9eaa9-3e2e-4ada-9ea8-8b81045ec3ee","word":"لُغَةُ الجَمَاعَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b98","lexicalEntryId":"67f9eaa9-3e2e-4ada-9ea8-8b81045ec3ee","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةُ الجَمَاعَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ التي تَستَعمِلها جَماعةٌ لغويةٌ معيَّنةٌ في بلَدٍ ما، ولاسيّما لغاتُ الأقليَّاتِ العِرقِيةِ في المجتَمَع؛ كاللغات - غيرِ الإنجليزيةِ - في نيويورك التي منها العربيةُ والإسبانيةُ والإيطاليةُ والفرنسيةُ والألمانية، واللغاتِ - غيرِ الإنجليزيةِ - في بريطانيا التي منها العربيةُ والأرديةُ والهندية. وهذا المصطلَحُ لغويٌّ اجتماعيٌّ، يختَلِف عن مصطلَح: تَعَلُّمُ لُغةِ الجماعَةِ Community Language Learning، الذي هو لغويٌّ تطبيقيٌّ يُشير إلى طريقَةٍ من طرائق تدريسِ اللغاتِ الأجنبية. راجع:  @(Community Language Learning (CLL)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة الجماعة ","nonDiacriticsLemma":"لغة الجماعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةُ الجَمَاعَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/25ec2049-7e6a-4c40-a33b-8e7c60d28d8d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"25ec2049-7e6a-4c40-a33b-8e7c60d28d8d","word":"بِيئَةُ التَّعْلِيمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b99","lexicalEntryId":"25ec2049-7e6a-4c40-a33b-8e7c60d28d8d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بِيئَةُ التَّعْلِيمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الجَوُّ أو المناخُ الذي تتَّسِم به قاعَةُ الدَّرسِ، وتَأثيرُ هذا الجَوِّ في العَمَلية التعليميةِ سَلبا أو إيجابا. وهذا الجَوُّ أو المناخُ يتأثَّر بسُلوك المعلِّم، وطَبيعةِ المادَّةِ التعليمية، وشُعورِ الطالبِ بالرَّغبَة أو بعَدَمها. والمعلِّمُ الناجِحُ هو الذي يُهَيِّئ المناخَ التعليميَّ المناسِبَ للطلاب؛ فيَجذِبهم إلى الدَّرس، ويُرَغِّبهم في التعلُّم، ويُقَوِّي حَوافزَهم، ويَزرَع فيهم اتِّجاها إيجابيا نحوَ اللغةِ الهَدَفِ وحُبًّا في تعلُّمِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"بيئة التعليم ","nonDiacriticsLemma":"بيئة التعليم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بِيئَةُ التَّعْلِيمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

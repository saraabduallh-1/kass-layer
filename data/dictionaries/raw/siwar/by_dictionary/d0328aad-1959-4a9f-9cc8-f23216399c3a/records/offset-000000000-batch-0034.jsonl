{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d78d8166-5a2c-409c-a9a3-24c61885547d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d78d8166-5a2c-409c-a9a3-24c61885547d","word":"النُّمُوُّ المَعْرِفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b9d","lexicalEntryId":"d78d8166-5a2c-409c-a9a3-24c61885547d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النُّمُوُّ المَعْرِفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نُمُوُّ الإدراكِ لدى الفَردِ من وِلادَته حتى مرحَلَةِ البُلوغ، وهو عند جان بياجيه Jean Piaget عمَليةُ التَّفكيرِ لدى الفَرد، وتَكَيُّفُه مع بيئته، وتَمَثُّلُ المعلوماتِ والأفكار. وهذا النُّمُوُّ مهمٌّ في اكتساب اللغة؛ لأن كثيرا من الأنماط والتراكيبِ اللغويةِ المعقَّدَةِ لا يَكتَسبِها الفَردُ ولا يَستَعمِلها إلا في مراحِلَ متأخِّرَةٍ، على الرَّغم من قُدرَته على التَّعبير عما يريده باستعمال أنماطٍ وأساليبَ بَسيطَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النمو المعرفي ","nonDiacriticsLemma":"النمو المعرفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النُّمُوُّ المَعْرِفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d7d2d2e1-7a62-4a14-b2bc-05d484840dac/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d7d2d2e1-7a62-4a14-b2bc-05d484840dac","word":"عِلْمُ النَّفْسِ المَعْرِفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b9e","lexicalEntryId":"d7d2d2e1-7a62-4a14-b2bc-05d484840dac","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ النَّفْسِ المَعْرِفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرعٌ من فُروع علمِ النفس، يُسمى أيضا علمَ النَّفسِ الإدراكي، يَدرُس أساليبَ التعلُّمِ واكتِسابِ المعرِفة، خاصَّةً ما له علاقَةٌ بالتَّفكير والإدراكِ والفَهمِ والذَّاكِرة. وفي نهايَة الخمسينياتِ من القرن العشرين، ارتَبَط علمُ النَّفسِ المعرفيِّ هذا بعلم اللغة، حين دعا تشومسكي إلى دراسة الجوانبِ المعرِفيةِ من اللغة، وعَدَمِ الاقتِصارِ على جَوانِبها البِنيَوِيةِ الشَّكليةِ الظاهرَة. ومنذ ذلك التاريخِ تحَوَّل علمُ اللغةِ إلى علمٍ لغويٍّ معرِفيٍّ، ومن ثم زاد الاهتِمامُ بعلم اللغةِ النَّفسيّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم النفس المعرفي ","nonDiacriticsLemma":"علم النفس المعرفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ النَّفْسِ المَعْرِفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

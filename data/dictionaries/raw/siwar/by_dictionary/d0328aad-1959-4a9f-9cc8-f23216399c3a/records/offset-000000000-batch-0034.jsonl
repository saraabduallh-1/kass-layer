{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/29f1936e-d5d4-48a2-9ba1-b6240cdcc5bc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"29f1936e-d5d4-48a2-9ba1-b6240cdcc5bc","word":"قَوْقَعَةُ الأُذُنِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ba4","lexicalEntryId":"29f1936e-d5d4-48a2-9ba1-b6240cdcc5bc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَوْقَعَةُ الأُذُنِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُشير إلى جُزء مُهمٍّ في الأذُن الدّاخلية، على هَيئة دِهلِيزٍ مُغلَقٍ ذي جُدرانٍ صُلبَةٍ على شَكل تجويفٍ داخِلَ تركيبٍ عَظمِي مُلتَفٍّ على بعضه على نحوٍ يُشبه محارَةً حَلَزُونِيَّة، متَّصِلٍ بعَظم الرِّكابِ من جهَة الأذُنِ الوُسطى، وفي داخله سائلٌ مائيٌّ لَزِج مَملوءٌ بعشرات الآلافِ من الأعصاب السَّمعِيةِ المتَّجِهَةِ إلى الدِّماغ. ووَظيفَةُ القَوقَعَةِ تحويلُ الاهتِزازاتِ الوارِدَةِ من الأذُن الوُسطى عبرَ الرِّكابِ إلى اندِفاعاتٍ عَصَبِيَّةٍ كهربائيةٍ تُنقَل إلى مَراكِز السَّمعِ في الدِّماغ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قوقعة الأذن ","nonDiacriticsLemma":"قوقعة الأذن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَوْقَعَةُ الأُذُنِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

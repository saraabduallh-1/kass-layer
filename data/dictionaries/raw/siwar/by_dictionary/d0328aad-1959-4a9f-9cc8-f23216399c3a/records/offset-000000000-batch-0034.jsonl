{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4efc734c-4270-4a46-88cb-39321295b7a0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4efc734c-4270-4a46-88cb-39321295b7a0","word":"إِشْرَافٌ عِيَادِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ba9","lexicalEntryId":"4efc734c-4270-4a46-88cb-39321295b7a0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إِشْرَافٌ عِيَادِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ في إعداد المعلِّم، يَقوم به المشرِفُ أو الموَجِّهُ التَّربَويُّ، ويَعتَمِد على العلاقَة بين المشرِفِ والمعلِّم؛ إذ يُركِّز المشرِفُ على رَفع أداءِ المعلِّمِ بالملاحَظَة المنتَظِمَة، والإرجاعِ المستَمِرِّ، والتَّعزيز. ويتضَمَّن الإشرافُ العِياديُّ العلاقةَ الحَميمَةَ المباشِرَةَ، والتَّفاهُمَ بين المعلِّمِ والمشرِفِ، والتركيزَ على السُّلوك العَمَليِّ للمعلِّم داخِلَ الفَصلِ لتَنمِيَة مهاراتِه. ويَتمّ ذلك باتِّباع ثلاثِ خُطواتٍ إستراتيجيةٍ، هي: وَضعُ خطَّةِ عَمَلٍ بين المعلِّمِ والمشرِفِ تتضمَّن الأهدافَ والأساليبَ والمشكلاتِ المتَوَقَّعَةَ وعَدَدَ اللِّقاءات، ومُلاحَظَةُ المشرِفِ الميدانيةُ للمعلِّم في أثناء أدائه التَّدريسيِّ، ولقاءٌ منتَظِمٌ بين المشرِفِ والمعلِّمِ لمناقَشَة أداءِ المعلِّم ومراجَعَةِ ما جَمَعَه المشرِفُ من مَلحوظاتٍ إيجابيةٍ أو سَلبية، وتَبادُلِ الآراءِ لتَحسين عَمَليةِ التدريس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إشراف عيادي ","nonDiacriticsLemma":"إشراف عيادي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إِشْرَافٌ عِيَادِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

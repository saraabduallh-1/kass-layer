{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/73717d1f-0b60-4514-8bf5-d7a08fe0edde/get-public-entry"},"browse_index_record":{"lexicalEntryId":"73717d1f-0b60-4514-8bf5-d7a08fe0edde","word":"مَذْهَبُ الشّفْرَةِ المَعْرِفِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ba6","lexicalEntryId":"73717d1f-0b60-4514-8bf5-d7a08fe0edde","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَذْهَبُ الشّفْرَةِ المَعْرِفِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَذهَبٌ أو مدخلٌ في تعليم اللغاتِ الأجنبيةِ، ينطَلِق من الاعتِقاد بأن تعلُّمَ اللغةِ الثانيةِ أو الأجنبيةِ يتطلَّب عَمَليّاتٍ مَعرِفيةً نَشِطَةً، وليس مجرَّدَ بناءِ عاداتٍ سُلوكيةٍ آلِيَّة. فهذا المذهبُ يؤكِّد أهمية النشاط العَقليِّ المعرِفيِّ في تعلُّم اللغة، لاسيَّما في تعلُّم القواعد. وعلى الرَّغم من أن هذا المذهبَ لم يتمَثَّل في طريقَةِ تدريسٍ معيَّنَة، فإن تَطبيقاتِه ظَهَرَت جَلِيَّةً في الطريقة التواصُلية، تلك الطريقةُ التي ارتَبَطَت بمذهَبٍ آخَرَ هو المذهَبُ التواصُلي. راجع:  @(communicative approach) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مذهب الشفرة المعرفية ","nonDiacriticsLemma":"مذهب الشفرة المعرفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَذْهَبُ الشّفْرَةِ المَعْرِفِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

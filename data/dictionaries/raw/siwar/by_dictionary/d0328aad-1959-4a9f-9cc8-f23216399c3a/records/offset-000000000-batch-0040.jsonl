{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f269c265-d135-4466-bac2-274e4b3a344f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f269c265-d135-4466-bac2-274e4b3a344f","word":"التَّرْجَمَةُ التَّركِيبِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c34","lexicalEntryId":"f269c265-d135-4466-bac2-274e4b3a344f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّرْجَمَةُ التَّركِيبِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، يَعني تحويلَ برنامجٍ موضوعٍ بلُغةِ برمَجَةٍ عاليَةِ المستوى إلى برنامَجٍ بلغةِ الآلَةِ، يكون مستَقِلا وقابِلا للتَّنفيذ تِلقائيا بالحاسوب. وتتَّسِم هذه الترجمةُ بإمكان اختيارِ الأنسَبِ من أوامِر اللغةِ الآلِيَّة، ومكوِّناتِ الحاسوبِ المادِّيَّةِ التي سوف تُنَفِّذها، وبأن أوامِرَ البرنامَجِ الناتِجِ منها أعَمُّ وأكثَرُ تجريدا من الأوامِر الناتِجَةِ من الترجمة التَّجمِيعِية؛ فيكون الأمرُ الواحِدُ منها مناظِرا لعدَّة أوامِرَ باللغة الآلِية، وكذلك بالمقارَنة بالترجمة التَّنفيذيةِ التي يتَرجَم فيها البرنامجُ في كل مرَّةٍ ينفّذ فيها من جديد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الترجمة التركيبية ","nonDiacriticsLemma":"الترجمة التركيبية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّرْجَمَةُ التَّركِيبِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot"
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/66f9f7ab-ac96-46db-b77c-f58d00d50143/get-public-entry"},"browse_index_record":{"lexicalEntryId":"66f9f7ab-ac96-46db-b77c-f58d00d50143","word":"كِفَايَةٌ (لُغَوِيُّةٌ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c2b","lexicalEntryId":"66f9f7ab-ac96-46db-b77c-f58d00d50143","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كِفَايَةٌ (لُغَوِيُّةٌ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المَلَكَةُ اللغويةُ أو القُدرةُ اللغوية، وهي المعرِفةُ الضِّمنِيَّةُ بقواعد اللغةِ وقوانِينِها. وكان تشومسكي أبرَزَ من اهتَم بها، وبيَّن أنها فطرَةٌ موجودةٌ لدى كلِّ ناطِقٍ بلغةٍ معيَّنةٍ منذ ولادَتِه، وأنها لا تحتاج إلى تعلُّم منظَّم، وفَرَّق بينها وبين الأداءِ اللغويِّ performance الذي ينبغي أن يَعكِس هذه الكِفايَةَ، وقد يَنحرَف عنها لأسبابٍ عارِضَة. انتَقَد بعضُ اللغويين الاجتماعيِّين، أمثال مايكل هاليداي M.A.K. Halliday وديل هايمز Dell Hymes، مفهومَ الكِفايَة هذا لدى تشومسكي؛ لاعتِقادهم أنه مَفهومٌ مَقصورٌ على الكفايَة النحوية، واقتَرَحوا أن تَشمل الكفايَةُ اللغويةُ الجوانِبَ الاجتماعيةَ والتواصليةَ والمقاميةَ إضافةً إلى الكِفايَة النحوية. راجع:  @(communicative competence) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كفاية (لغوية) ","nonDiacriticsLemma":"كفاية (لغوية)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كِفَايَةٌ (لُغَوِيُّةٌ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6d13d0a8-fb28-4880-8781-28c1bca468e9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6d13d0a8-fb28-4880-8781-28c1bca468e9","word":"الطَّرِيقَةُ المُبَاشِرَةُ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8eb6","lexicalEntryId":"6d13d0a8-fb28-4880-8781-28c1bca468e9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطَّرِيقَةُ المُبَاشِرَةُ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"طريقةٌ لتدريس اللغاتِ الأجنَبِية، ظهَرَت في أوائل القرنِ العشرين؛ نتيجةَ التَّذَمُّر من طريقَةِ القواعدِ والتَّرجَمة. وهي شَبيهةٌ بالطريقَة الطبيعيةِ The Natural Method أو هي مرحَلَةٌ من مراحِلها المتقدِّمَة، ويمكن الجَمعُ بينهما تحتَ اسمٍ واحدٍ هو: الطريقةُ الطبيعيةُ المباشِرَة. تَنطلِق هذه الطريقةُ من أن اللغةَ الثانيةَ يمكن أن يتَعَلَّمها الأجنبيُّ بطريقَةٍ طبَعيةٍ مباشِرَةٍ كما يَكتَسِب الطفلُ لغتَه الأمَّ، وأن المهاراتِ الأربعَ يجب أن تُقدَّم للمتعلِّم مرتَّبَةً في مراحِلَ زمانيةٍ مشابِهَةٍ لتَرتيبها لدى الطفل. في هذه الطريقةِ يُمنَع في الفَصل استعمالُ اللغةِ الأمِّ، أو أيِّ لغةٍ أخرى غيرِ اللغةِ الهَدَف، ويُرَكَّز على الطلاقَة من غير إغفالٍ للدِّقَّة اللغوية، أما القواعدُ فلا تُدَرَّس مباشَرَةً وإنما تُقدَّم أنماطُها بطريقَةٍ ضِمنِيَّة.    ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الطريقة المباشرة  ","nonDiacriticsLemma":"الطريقة المباشرة ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطَّرِيقَةُ المُبَاشِرَةُ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

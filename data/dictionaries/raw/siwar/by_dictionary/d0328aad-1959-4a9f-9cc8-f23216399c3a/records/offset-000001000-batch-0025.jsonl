{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0c9dfb4f-639c-4805-ba86-c787cd66fd29/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0c9dfb4f-639c-4805-ba86-c787cd66fd29","word":"تَدْرِيسٌ مُبَاشِرٌ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ec1","lexicalEntryId":"0c9dfb4f-639c-4805-ba86-c787cd66fd29","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيسٌ مُبَاشِرٌ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تدريسُ القواعدِ اللغويةِ لمتعلِّمي اللغة الثانية أو الأجنبية بطريقَةٍ مباشِرَة؛ سواء شُرِحَت لهم القاعِدَةُ أوَّلاً ثم قُدِّمَت لهم أمثلةٌ أو نُصوصٌ تُمثِّلُها، أو قُدِّمَت لهم نُصوصٌ ثم استُنبِطَت منها القاعِدَةُ وشُرِحَت شَرحا مباشِرا؛ كما في طريقة القواعدِ والترجَمة. ويُقابِله التدريسُ غيرُ المباشِرِ للقواعد. راجع:  @(indirect teaching) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":" أسلوبٌ عامٌّ في التدريس، يهتَم بزيادَة حَصيلةِ الطالبِ من المعلومات التي تحَقِّق أهدافا أكاديميةً محدَّدةً؛ حيث يركِّز المعلِّمُ على الأنشِطَة التي تحقِّق هذه الأهدافَ، ويتأكَّد من إلمام الطلابِ بها، ويختَبِرهم فيها، ويَسعى إلى تدريب الطلابِ على طريقَته في التدريس، والتعامُلِ معه على هذا الأساس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"نَمَطٌ من أنماط التدريسِ يتمَحوَر حولَ المعلِّم، ويُوَجَّه لكلِّ الطلاب، حيث يقوم المعلِّمُ بعَرض المحتَوَى وشَرحِه وتَقديمِه للطلاب بطريقَةٍ واضحَةٍ مباشِرَة، ويؤدِّي فيه دَورَ الناقِلِ للمَعرفة وحسب. وهذا التدريسُ مُقابِلٌ لكلٍّ من التدريس الاستِدلالِيِّ inductive teaching، والتدريسِ الاكتِشافِيِّ discovery teaching، والتدريسِ البِنائيِّ constructive teaching. وهذا النَّمَطُ من التدريس غيرُ مناسِبٍ لفُصول تعليمِ اللغاتِ الأجنبية، خلافا للثلاثة الأخرى المقابِلَةِ التي تمنَح المتعلِّمَ فُرصا كثيرةً للتَّفاعُل داخِلَ الصَّف، وممارَسَةِ اللغةِ الهَدَفِ فيه، وتجعَل المعلِّمَ يؤدِّي وَظيفةَ الوَسيطِ أو الميَسِّرِ للتعلُّم facilitator. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريس مباشر  ","nonDiacriticsLemma":"تدريس مباشر ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيسٌ مُبَاشِرٌ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

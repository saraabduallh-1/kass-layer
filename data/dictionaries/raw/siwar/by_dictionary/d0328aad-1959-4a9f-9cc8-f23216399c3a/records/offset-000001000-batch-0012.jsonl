{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/21f924e1-599c-402e-b4a1-a0efc301f33c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"21f924e1-599c-402e-b4a1-a0efc301f33c","word":"فَرضِيَّةُ التَّحْلِيلِ التَّقَابُلِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d75","lexicalEntryId":"21f924e1-599c-402e-b4a1-a0efc301f33c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرضِيَّةُ التَّحْلِيلِ التَّقَابُلِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضيةٌ لغويةٌ تطبيقيةٌ، ترى أن جميعَ أخطاءِ متعلِّمي اللغاتِ الثانيةِ والأجنبيةِ ناتِجةٌ عن الاختلاف بين أنظمَةِ اللغَتَين الأمِّ والهَدَفِ في الجوانب الصوتيةِ والصرفيةِ والنحويةِ والدّلالية. ولهذه الفَرضيةُ صِيغَتان: إحداهما قويَّةٌ strong form ترى أنه يُمكن التَّنبُّؤُ بأخطاء متعلِّمي اللغةِ الهَدَفِ بناء على الاختلاف بين اللغَتَين، والأخرى ضَعيفَةٌ weak form ترى أنه يُمكن تَفسيرُ الخَطأِ - بعد وُقوع المتعلِّمِ فيه - على أنه نتيجةٌ لهذا الاختِلاف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية التحليل التقابلي ","nonDiacriticsLemma":"فرضية التحليل التقابلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرضِيَّةُ التَّحْلِيلِ التَّقَابُلِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

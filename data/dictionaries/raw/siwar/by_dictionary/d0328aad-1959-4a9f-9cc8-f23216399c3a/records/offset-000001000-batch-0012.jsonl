{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b1c26482-0c92-4278-a272-b28d6e77ef3a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b1c26482-0c92-4278-a272-b28d6e77ef3a","word":"الإرْشَادُ النَّفْسِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d6d","lexicalEntryId":"b1c26482-0c92-4278-a272-b28d6e77ef3a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإرْشَادُ النَّفْسِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ اعتَمَد عليه تشارلز كارِن Charles A. Curran في طريقته: تعلُّم لغةِ الجَماعَةِ Community-Language Learning (CLL)، ونادى بتَطبيقه في تعليم اللغاتِ الأجنَبية. وفيه يرى أن الصعوباتِ التي يُعاني منها متعلِّمو اللغاتِ الأجنَبيةِ ناشِئةٌ من مشكلاتٍ نَفسِيةٍ واجتِماعية، ربما يكون سبَبُها صُعوبَةَ تَعبيرِ المتعلِّم عما في نفسه. فرأى كارِن أن حَلَّ هذه المشكلاتِ يَكمُن في بناء علاقَةٍ حَميمَةٍ بين المعلِّمِ بوَصفه مُرشِدا أو طَبيبا نَفسِيا والمتعلِّمِ بوَصفه مَريضا أو عَمِيلا يترَدَّد على عيادَة الطبيبِ النَّفسِيِّ (المعلِّمِ)؛ فيُحاوِل المعلِّمُ فَهمَ مشكلاتِ المتعلِّم، ثم تَقديمَ المشورَةِ له، تَمهيدا لحَلِّ مشكلاتِه بالطريقة التي يتَعامَل بها المرشِدُ النَّفسِيُّ مع مَرضاه في عِيادَته.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإرشاد النفسي ","nonDiacriticsLemma":"الإرشاد النفسي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails"
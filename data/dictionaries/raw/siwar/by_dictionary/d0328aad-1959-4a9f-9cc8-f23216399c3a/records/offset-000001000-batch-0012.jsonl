{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e25c606a-961c-4b47-aa1d-0c2448e9690c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e25c606a-961c-4b47-aa1d-0c2448e9690c","word":"تَحْلِيلُ مُقارَنَةِ الثَّقَافَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d73","lexicalEntryId":"e25c606a-961c-4b47-aa1d-0c2448e9690c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ مُقارَنَةِ الثَّقَافَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَحليلُ تعَدُّدِ الثقافات، وهو تَحليلُ معلوماتٍ من مجموعَتَين ثقافيَّتَين أو أكثَرَ؛ لمعرِفة ما إذا كانت المفاهيمُ والقِيَمُ المستخلَصَةُ من مجموعةٍ يمكن أن تَنطَبِق على المجموعة أو المجموعاتِ الأخرى. وتَحليلُ الثقافاتِ منهَجٌ من مناهِج علمِ اللغةِ الاجتماعي، وذو أهميةٍ خاصةٍ في تعليم اللغةِ الثانيةِ وتعلُّمِها؛ لتَذليل العَقَباتِ المتوقَّعَةِ نتيجَةَ اختِلافِ الثقافات، وتَيسيرِ التَّثاقُف لمتعلِّمي اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل مقارنة الثقافات ","nonDiacriticsLemma":"تحليل مقارنة الثقافات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ مُقارَنَةِ الثَّقَافَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

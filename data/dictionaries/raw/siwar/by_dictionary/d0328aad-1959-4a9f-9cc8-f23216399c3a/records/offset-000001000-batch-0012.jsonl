{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6aea86aa-3c9f-4cc8-a0f7-9eaab0631dc5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6aea86aa-3c9f-4cc8-a0f7-9eaab0631dc5","word":"مَدْرَسَةُ كُوبِنْهاجِن","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d67","lexicalEntryId":"6aea86aa-3c9f-4cc8-a0f7-9eaab0631dc5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَدْرَسَةُ كُوبِنْهاجِن","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المدرسةُ اللغويةُ، أو الحَلقَةُ اللغويةُ، التي تأسَّسَت في منتَصف الثلاثينيات من القرن العشرين، واشتُهِرت بمنهج اللغوياتِ الرياضيةِ glossematics، الذي يَعني وَصفَ اللغةِ وَصفا رياضيا، أي باستِخدام الرياضيات. وتَزَعَّم هذه المدرسةَ لغويون نَظريون أمثال لويس هيامسليف Louis Hjelmslev. تطوَّرَت هذه المدرسة، وقدَّمَت آراءً لغويةً مهمةً ساهَمَت في بناء النظريةِ اللغوية، واستَمرَّت قويةً حتى ظهَرَت النظريةُ التوليديةُ التحويليةُ التي هيمَنَت على الدراسات اللغويةِ منذ أواخِرِ الخمسينياتِ من القرن العشرين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مدرسة كوبنهاجن ","nonDiacriticsLemma":"مدرسة كوبنهاجن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَدْرَسَةُ كُوبِنْهاجِن"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

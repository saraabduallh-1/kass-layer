{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f0f358cd-761d-4b70-9bab-eb87344636fe/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f0f358cd-761d-4b70-9bab-eb87344636fe","word":"خَطَأٌ خَفِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d7a","lexicalEntryId":"f0f358cd-761d-4b70-9bab-eb87344636fe","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"خَطَأٌ خَفِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تحليل الأخطاء، يُطلَق على الخَطأ اللغويِّ الذي يَقَع فيه متعلِّمُ اللغة، ولا يَظهَر في التركيب السَّطحيِّ للجُمَل، وإنما يَظهَر في رَكاكَة الأسلوب، أو في تحاشِي استِعمالِ مفرَداتٍ أو صِيَغٍ أو تراكيبَ معيَّنةٍ واللُّجُوءِ إلى استِعمال تراكيبَ بسيطَة. ويُقابِله الخَطأُ الظاهِرُ أو الخطأُ في الظاهر overt error، وهو الخَطأُ اللغويُّ كما يَظهَر للسامِع أو القارئِ لكنه قد يكون صحيحا بالنَّظَر إلى قَصد المتكلِّمِ أو الكاتِب. ويُطلَق المصطلَحُ أيضا على الجُملة الصحيحةِ نحويا حين يَنطِقها المرءُ أو يَكتُبها لكنها لا تُعَبِّر عن مَقصوده، ويُكتَشَف هذا الخَطأُ من السِّياق أو المقامِ الذي وَرَدَت فيه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"خطأ خفي ","nonDiacriticsLemma":"خطأ خفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"خَطَأٌ خَفِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0a897722-820b-4e33-9b99-5c3bb5ea27b2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0a897722-820b-4e33-9b99-5c3bb5ea27b2","word":"تَرْجَمَةٌ إبْدَاعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d7b","lexicalEntryId":"0a897722-820b-4e33-9b99-5c3bb5ea27b2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْجَمَةٌ إبْدَاعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قُدرَةُ المترجِمِ على نَقل الجوانِبِ الفَنِّيَّةِ الإبداعيةِ من اللغة المصدَرِ إلى اللغة الهدَف، وهي قُدرَةٌ نادِرَةٌ جدًّا في مِهنَة الترجَمة، ولاسيَّما في نَقل المعاني المجازِيَّة، بل يرَى كثيرٌ من اللغويِّين أن الفُنونَ الأدبيةَ عامَّةً والشِّعرَ خاصَّةً غيرُ قابِلَةٍ لَنقل معانيها الفنِّيَّةِ وصوَرِها الإبداعية، وأن ما يُنشَر من ترجمات شِعريةٍ لا يتعدَّى النَّقلَ التَّقريبيَّ للمعاني والأفكار.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ترجمة إبداعية ","nonDiacriticsLemma":"ترجمة إبداعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرْجَمَةٌ إبْدَاعِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

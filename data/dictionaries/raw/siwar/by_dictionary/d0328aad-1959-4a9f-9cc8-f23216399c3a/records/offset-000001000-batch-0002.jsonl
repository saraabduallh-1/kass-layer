{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d8cd4e5d-0463-4306-94a7-24fd8ca87925/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d8cd4e5d-0463-4306-94a7-24fd8ca87925","word":"تَرَادُفٌ تَامٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c73","lexicalEntryId":"d8cd4e5d-0463-4306-94a7-24fd8ca87925","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرَادُفٌ تَامٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَرادُفٌ تَوزيعَيٌّ شامِل، يتَطابَق فيه تَوزيعُ الكلمَتَين المترادفَتَين، أي يُمكن أن تحلَّ كلمةٌ محَلَّ كلمةٍ أخرى في جميع السِّياقاتِ دونَ تَطابُقٍ في المعنى المعرِفِيِّ والمعنى الوِجدانِي. ويَرَى كثيرٌ من اللغويِّين عَدَمَ صِحَّةِ هذا التطابُقِ، ولاسيّما في اللغة العربية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ترادف تام ","nonDiacriticsLemma":"ترادف تام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرَادُفٌ تَامٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/566d5e7b-8dc8-4592-86e7-9065a1861e51/get-public-entry"},"browse_index_record":{"lexicalEntryId":"566d5e7b-8dc8-4592-86e7-9065a1861e51","word":"مَوْجَةٌ صَوْتِيَّةٌ مُرَكَّبَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c74","lexicalEntryId":"566d5e7b-8dc8-4592-86e7-9065a1861e51","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَوْجَةٌ صَوْتِيَّةٌ مُرَكَّبَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم الأصوات، يُشير إلى الموْجَة الصوتيةِ المكوَّنةِ من مَوجَتَين بسيطَتَين أو أكثَر. وأصواتُ الكلامِ في عُمومها تُحدِث مَوجاتٍ صوتيةً مركَّبةً؛ لأنها تَمُرُّ - إثرَ خُروجِها من الحَنجَرَة - بعوائقَ وتجاوِيفَ وتَصطَدِم ببعضها، وربما يَسبِق بعضُها بعضا؛ فتتحَوَّل من مَوجاتٍ بسيطةٍ إلى مَوجاتٍ مُركَّبةٍ أو مُعَقَّدَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"موجة صوتية مركبة ","nonDiacriticsLemma":"موجة صوتية مركبة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَوْجَةٌ صَوْتِيَّةٌ مُرَكَّبَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/483c8126-e295-429e-8700-5cda42182006/get-public-entry"},"browse_index_record":{"lexicalEntryId":"483c8126-e295-429e-8700-5cda42182006","word":"أُنْمُوذَجُ المُخْرَجِ المَفْهُومِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c75","lexicalEntryId":"483c8126-e295-429e-8700-5cda42182006","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ المُخْرَجِ المَفْهُومِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذجٌ لغويٌّ تطبيقيٌّ، يَرَى أن المخرَجاتِ اللغويةَ، وهي ما يُنتِجه متعلِّمُ اللغةِ من كلامٍ أو كتابة، مُهِمَّةٌ لاكتِساب اللغة الهَدَف. فالكلامُ الذي يَقوله المتكلِّمُ (المتعلِّمُ) ويَفهَمه المخاطَبُ يُعزِّز اللغةَ لدى المتكلِّمِ المتعلِّمِ، لأن المتكلِّمَ الأجنَبيَّ غالبا ما يجتَهِد في ضَبط كلامِه ليَضمَن وُصولَه إلى المخاطَب بصورَةٍ واضحَةٍ تَضمَن فَهمَ المخاطَبِ له. وقد طُبِّق هذا الأنموذَجُ في طريقَة تعلُّم اللغةِ وتعليمِها بالمهمّات TBLT، التي تَنطَلِق من نظرَةٍ ترى أن استِعمالَ اللغةِ يؤدِّي إلى اكتِسابها، خِلافا للنظرَة التَّقليديةِ التي ترى عَكسَ ذلك. راجع:  @(Task-Based Learning/Teaching (TBLT)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج المخرج المفهوم ","nonDiacriticsLemma":"أنموذج المخرج المفهوم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ المُخْرَجِ المَفْهُومِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/34122088-4066-470b-888b-93f7dc06cea7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"34122088-4066-470b-888b-93f7dc06cea7","word":"اخْتِبَارٌ شَامِلٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c76","lexicalEntryId":"34122088-4066-470b-888b-93f7dc06cea7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِبَارٌ شَامِلٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يُشير إلى أيِّ اختِبارٍ شامِلٍ يَقيس جميعَ المهاراتِ اللغويةِ لدى متعلِّمِ اللغة، ولا يَرتَبِط بمنهَج أو مقرَّرٍ أو مادَّةٍ تعليمية، أي ليس اختِبارا تحصِيليا. وهو شَبيهٌ باختبار الكِفايَةِ المقنَّنِ proficiency test، كاختبارات: TEOFL و: IELTS في اللغة الإنجليزية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"اختبارٌ أكاديميٌّ يُعطَى لطلاب الدراساتِ العُليا، وفي مرحَلَة الدكتوراه خاصةً؛ يَقيس عدَدا من القُدرَات المعرِفيةِ والعلميةِ والمِهنِيةِ التي يجب أن تتوافر فيمَن يُرشَّح للحُصول على درَجَةٍ علميةٍ عالِيَةٍ كالدكتوراه، ويأخذه الطالبُ - في الغالب - بعد نجاحِه في المقرَّرات الدراسيةِ بمعدَّلٍ تراكُميٍّ معيَّن، وقبلَ تَسجيلِ الرِّسالة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار شامل ","nonDiacriticsLemma":"اختبار شامل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِبَارٌ شَامِلٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a97acf32-1e1a-41dd-90a8-43e47cb1d30e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a97acf32-1e1a-41dd-90a8-43e47cb1d30e","word":"عِلْمُ اللُّغَةِ الحَاسُوبِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c77","lexicalEntryId":"a97acf32-1e1a-41dd-90a8-43e47cb1d30e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ الحَاسُوبِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":" فرعٌ من فروع علمِ اللغة، يُعنَى بدراسة اللغةِ الطبيعيةِ باستخدام الأساليبِ الحسابيةِ الآلِيَّةِ بهَدَف تَمكين الحاسوبِ من مُحاكاة عمَلياتِ فَهمِ اللغةِ الإنسانيةِ واستِعمالِها. ظَهَر في الأربعينِيات من القرن العشرين، وارتَبَط ببحوث الترجَمةِ الآلِيَّةِ في الخمسينِيَّات، ثم تحدَّدَت مَلامِحُه في الستينيات على هيئة تطبيقاتٍ حاسوبيةٍ لنظرية اللغوياتِ التوليديةِ التحويلية. يَهتَم هذا العلمُ بالتحليل اللغوي، وحَلِّ المشكلاتِ اللغوية، وإعدادِ القوائمِ والفهارِس، والترجَمةِ الآلِيَّةِ، والتعليمِ المبرمَجِ آلِيًّا للُّغات. ونتيجَةً لتقَدُّم أساليبِ الحاسوبِ وتنوُّعِ برامِجِه، تطوَّر علمُ اللغةِ الحاسوبيُّ وتفَرَّع إلى مجالاتٍ منها: الإحصاءُ اللغويُّ الآلِيُّ، والتحليلُ والتركيب، وتحليلُ النُّصوص، والذَّكاءُ الاصطناعي، وبناءُ المدوَّناتِ اللغوية، وصناعَةُ المعاجِم، وتَعَرُّفُ الأصواتِ اللغوية، وإنتاجُ الكلامِ آلِيًّا، والترجَمةُ الآلِيَّة، وتعليمُ اللغات، إضافةً إلى التطبيقات التعليمية، وتَصويبِ الأخطاءِ في جميع المستوياتِ اللغوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة الحاسوبي ","nonDiacriticsLemma":"علم اللغة الحاسوبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ الحَاسُوبِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

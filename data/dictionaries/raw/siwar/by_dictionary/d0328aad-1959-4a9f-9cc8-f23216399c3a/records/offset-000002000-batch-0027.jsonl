ty":null},"lammaDetails":[{"form":"كُلِّيَّاتٌ اسْتِتْبَاعِيَّةٌّ تَضْمِينِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

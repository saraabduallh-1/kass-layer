{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e443b678-5d61-4fcb-8260-9664835ce532/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e443b678-5d61-4fcb-8260-9664835ce532","word":"عَلامَةٌ اسْتِتْبَاعِيَّةٌ مُتَضَمِّنَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92da","lexicalEntryId":"e443b678-5d61-4fcb-8260-9664835ce532","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَلامَةٌ اسْتِتْبَاعِيَّةٌ مُتَضَمِّنَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَصويرُ العَلاقةِ بين شَيئَين أو أكثَرَ، باستخدام جَدوَلٍ استِتباعِيٍّ يمكن تطبيقُه في حَقل اكتسابِ اللغة. مثالُ ذلك عَرضُ التدَرُّج في اكتساب عَدَدٍ من الطلاب لمورفيم الجَمعِ: s، وأداتَيْ التَّنكيرِ: a, an، وأداةِ التعريفِ: the في الإنجليزية، ومراحل هذا الاكتساب، ووَضعُ علاماتٍ أمامَ كلِّ عنصُرٍ أو مورفيمٍ لكل طالبٍ في مرحَلةٍ محدَّدَةٍ للدّلالة على اكتسابه له من عَدَمه. وقد يُستَعمل هذا الجدوَلُ في رَصد تحَوُّلِ المتعلِّمِ من اللغة الهَجينِ أو اللغةِ المولَّدَةِ إلى المستوى الفَصيح.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علامة استتباعية متضمنة ","nonDiacriticsLemma":"علامة استتباعية متضمنة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَلامَةٌ اسْتِتْبَاعِيَّةٌ مُتَضَمِّنَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

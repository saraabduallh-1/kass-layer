{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e34548e9-5cfd-4547-b16d-3d5043068546/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e34548e9-5cfd-4547-b16d-3d5043068546","word":"الدِّرَاسَاتُ الأمْرِيكِيَّةُ الإفْرِيقِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b891d","lexicalEntryId":"e34548e9-5cfd-4547-b16d-3d5043068546","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الدِّرَاسَاتُ الأمْرِيكِيَّةُ الإفْرِيقِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"حَقلٌ من حُقول الدراساتِ الثقافيةِ الاجتِماعية، ظَهَر في الولايات المتحدةِ الأمريكيةِ في بداية الستينياتِ من القرن العشرين. يهتَم هذا الحَقلُ بالجوانب الأكاديميةِ والاجتِماعيةِ والثقافيةِ في حياة المواطِنين الأمريكيين من ذَوِي الأصولِ الإفريقية. أُنشِئ لهذا الحَقلِ رَوَافدُ ومحاضِنُ في الجامعات والمكتباتِ العامة، وخُصِّصت له مراكزُ ثقافية اجتِماعية، تُوثِّق تاريخَ الأمريكيين الأفارِقَةِ African Americans وأديانهم ولُغاتِهم وفُنُونهم وتُراثهم، وتُبرِز مُساهماتِ زُعمائهم ورُمُوزِهم في عُلوم السياسةِ والاجتِماعِ والاقتِصادِ والفَنِّ. وكان من نتائج هذه الدراساتِ اكتِشافُ وثائقَ تتضمَّن نُصوصا دينِيَّةً وأدبيةً وتاريخيةً تُشير إلى اللغات الأصليةِ للأفراد والجَماعاتِ التي كانت تُجلَب إلى الولايات المتحدةِ الأمريكية، من ضِمنها اللغةُ العربية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الدراسات الأمريكية الإفريقية ","nonDiacriticsLemma":"الدراسات الأمريكية الإفريقية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الدِّرَاسَاتُ الأمْرِيكِيَّةُ الإفْرِيقِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fccea957-eb4f-4d63-92a9-174dbc473101/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fccea957-eb4f-4d63-92a9-174dbc473101","word":"فُرُوقُ التَّعَلُّمِ العُمُرِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b891e","lexicalEntryId":"fccea957-eb4f-4d63-92a9-174dbc473101","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فُرُوقُ التَّعَلُّمِ العُمُرِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اختلافُ متعلِّمي اللغاتِ في التَّحصيل والكفايَةِ اللغويةِ نتيجةَ اختلافِ أعمارِهم في مرحَلة تعلُّمهم اللغةَ الثانيةَ؛ كالقَول بأن الصغيرَ أقدَرُ على اكتساب اللغةِ من الكبير، وأنه كلَّما تقدَّم السِّنُّ بالمتعلِّم ازدادَت صُعوباتُ تعلُّمِه للُّغة الثانية. والمسألةُ مَوضِعُ خلافٍ بين اللغويين والمربِّين منذ منتَصف القرنِ العشرين، والأرجَحُ أن لكل مرحَلةٍ عُمريةٍ مِيزاتٍ وعُيُوبا في تعلُّم اللغةِ الثانيةِ أو الأجنبية؛ فالطفلُ أقدَرُ من الكبير على نُطق الأصواتِ واستعمالِ اللغةِ بشَكل طَبَعيٍّ عَفوِيّ، والكبيرُ أقدَرُ من الصغير على استيعاب المفرَداتِ والقواعدِ والمفاهيمِ المجرَّدَة. لكن تَمَيُّزَ الصغيرِ من الكبير ناتِجٌ عن أسبابٍ وعواملَ خارجيةٍ، لاسيَّما حين يَعيشان في بلَد اللغةِ الهَدَف، أبرزُها: أهميةُ اللغةِ في حياة الطفلِ اليَومية، وطُولُ الوَقتِ الذي يُمضِيه الطفلُ في مُمارَسَة اللغةِ الهَدَفِ، خِلافا للكبير.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فروق التعلم العمرية ","nonDiacriticsLemma":"فروق التعلم العمرية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فُرُوقُ التَّعَلُّمِ العُمُرِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b88b8c4-0bc1-459b-9e6e-037e84062729/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b88b8c4-0bc1-459b-9e6e-037e84062729","word":"غَامِضٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b891a","lexicalEntryId":"9b88b8c4-0bc1-459b-9e6e-037e84062729","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"غَامِضٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"صفةٌ للكلمة أو العبارةِ أو الجُملةِ المحتَمِلَةِ لأكثَر من معنى، ككَلِمَتَيْ: (عَين) و(ضَرَبَ)، وجُملَتَيْ: ظُلْمُ المعلِّمِ حرامٌ، ومَطْلُ الغَنيِّ ظُلْمٌ. ومنه في الإنجليزية كلمةُ: bank التي تَعني (مَصْرَف) و(ضفَّة نَهْر)، وجُملةُ: The lamb is too hot to eat. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في الإعرابِ الآليِّ، يَعني أن الجُملةَ الواحدةَ لها أكثَرُ من تحليل واحد، أي لها أكثَرُ من مُشتَقَّة derivation، وبالتالي لها أكثَرُ من شَجَرَة tree. ويحدث هذا بسَبَبٍ لُغَويٍّ، كتَعَدُّد قواعدِ التركيب، أو تَعَدُّدِ المعاني اللغوية، بخلاف الغُموضِ أو الإبهامِ الذي يَنتج عن تَعَدُّد المعاني أو التفاسيرِ غيرِ اللغوية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"AS","root":null,"wordForms":[],"relatedSenses":[],"search":"غامض ","nonDiacriticsLemma":"غامض","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"غَا
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/30b835d6-43d9-4960-8713-dccf1f0bbc2d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"30b835d6-43d9-4960-8713-dccf1f0bbc2d","word":"رُقِيُّ (الدَّلالَةِ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b891b","lexicalEntryId":"30b835d6-43d9-4960-8713-dccf1f0bbc2d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رُقِيُّ (الدَّلالَةِ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ الإنجليزيةُ كما يَستَعمِلها سُكَّانُ الولاياتِ المتحدةِ الأمريكية الآن، وهو استِعمالٌ يختَلِف قليلا عن اللغة الإنجليزيةِ البريطانيةِ في جوانب من نُطقِ الأصواتِ واستِعمالِ المفرداتِ وصِياغَةِ التراكيب. فمن الفُروق في النُّطق بين اللَّهجَتَين الاختلافُ في نُطق: /r/, /a/, /o/, /t/ في كلماتٍ مثل: car, pass, dog, letter على التوالي. ومن الفُروق في استِعمال المفرَداتِ استِعمالُ: truck, elevator في الإنجليزية الأمريكيةِ بدلا من: lorry, lift، على التوالي، في الإنجليزية البريطانية. وعلى مُستوى التراكيبِ يُلحَظ الفَرقُ بين اللَّهجَتَين في تَرتيب بعضِ مَواقِعِ الأفعالِ المساعِدةِ في جُمَل الاستِفهام.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"رقي (الدلالة) ","nonDiacriticsLemma":"رقي (الدلالة)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رُقِيُّ (الدَّلالَةِ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

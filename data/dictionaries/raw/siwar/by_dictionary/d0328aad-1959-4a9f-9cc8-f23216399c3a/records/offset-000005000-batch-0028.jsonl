{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/392c448a-0243-4123-ab44-679c7cd3c66b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"392c448a-0243-4123-ab44-679c7cd3c66b","word":"تَبْسِيطٌ دَلالِيٌّ تَرْكِيبِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ed9","lexicalEntryId":"392c448a-0243-4123-ab44-679c7cd3c66b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَبْسِيطٌ دَلالِيٌّ تَرْكِيبِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اللغة المرحَلِيَّةِ لمتعلِّمي اللغاتِ الأجنبية، يُشير إلى سِمَةٍ تَظهَر في لُغة المبتَدئين من متعلِّمي اللغات الثانيةِ والأجنبية، وتَتَميَّز بتَبسيط التراكيب والأبنِيَة والدَّلالات، وتمثِّل نَمَطا من أنماط اللغةِ الهَجِين pidgin language. فالتَّبسيطُ التركيبيُّ يَظهَر في حَذف بعضِ الأدواتِ والكلماتِ الوَظيفيةِ من الجُملة. وتبسيطُ الصِّيَغ يَظهَر في استعمال صِيَغٍ ناقِصَةٍ مُكوِّناتُها الصَّرفيةُ من سَوابِقَ أو لَوَاحِق. وأمّا التَّبسيطُ الدَّلاليُّ فيَظهَر في حَذف بعضِ العناصِرِ الدَّلالية، أو استِعمالِ الكلمةِ لمعنًى واحِدٍ مَهما اختَلفَت السِّياقات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تبسيط دلالي تركيبي ","nonDiacriticsLemma":"تبسيط دلالي تركيبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَبْسِيطٌ دَلالِيٌّ تَرْكِيبِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b774be7-d0eb-45e8-b622-f5c4ff3da3d3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b774be7-d0eb-45e8-b622-f5c4ff3da3d3","word":"تَرْكِيبٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9eda","lexicalEntryId":"9b774be7-d0eb-45e8-b622-f5c4ff3da3d3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْكِيبٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسُوبِيٌّ، يُقصَد به القواعدُ التي تُحَدِّد كَيفيَّةَ استعمالِ أوامِرِ لغةِ الحاسوب، وتحدِّد كَيفيَّةَ مُلاءَمةِ بعضِها لبعض، وكذلك التعليماتُ التي تقوم عليها لغاتُ الحاسوبِ فيُصبح لها معنى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]},{"definition":"مجموعةٌ من العناصِر اللغويةِ في أحَد مستوياتِ التحليلِ اللغويِّ، ولاسيَّما النحو؛ كالأصوات التي تؤلِّف المورفيمات، والمورفيماتِ التي تؤلِّف الكلمات، والكلماتِ التي تؤلِّف الجُمَل.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"وَصفٌ للتركيبِ من حيث مُستوى التحليلِ اللغوي، ولاسيَّما في التَّميِيز بين البِنيَةِ السَّطحيّةِ والبِنيَةِ العَميقَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"تركيب ","nonDiacriticsLemma":"تركيب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:
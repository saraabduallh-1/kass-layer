{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b2ea1063-59a8-49f8-863c-6bad5ef0a194/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b2ea1063-59a8-49f8-863c-6bad5ef0a194","word":"لُغَةٌ قَوْمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97a8","lexicalEntryId":"b2ea1063-59a8-49f8-863c-6bad5ef0a194","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ قَوْمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ السائدةُ في بلَدٍ أو لدى أمَّةٍ من الأمَم، وهي التي تُعَدُّ اللغةَ الرسميةَ المعتَمَدةَ في بلَدٍ أو في مجموعَةٍ من البلدان في التعليم والإعلامِ والمكاتَباتِ الرسميةِ والتجارية؛ كالعربية في الأقطار العربية، والتركيةِ في تركيا، والفرنسيةِ في فرنسا، والألمانيةِ في ألمانيا، والإنجليزية في بريطانيا والولايات المتحدة الأمريكية وكندا وأستراليا. واللغةُ القوميةُ قد تكون اللغةَ الوحيدةَ في الدولة، وربما تكون واحدةً من عدَّة لغات، بيدَ أن الدولةَ هي التي تُقرِّر أن لغةً ما هي اللغةُ القوميةُ الوحيدةُ، كالتركيةِ في تركيا. وربما تَتَبنَّى الدولةُ أكثَرَ من لغةٍ رسميةٍ واحدة، مثلُ كندا التي فيها الإنجليزيةُ والفرنسيةُ، وبلجيكا التي فيها الدانمركيةُ والفرنسيةُ، وكذلك الهندُ التي فيها أكثَرُ من لغَتَين قوميَّتَين. وقد تختَلِف اللغةُ القوميةُ عن اللغة أو اللغاتِ الرسميةِ في بلَدٍ ما، كما في لوكسمبورغ Luxembourg التي كان فيها حتى عامَ 1980م لغَتان رَسميَّتان هما الفرنسيةُ والألمانية، ثم أصبَحَت اللغةُ القوميةُ هي اللُّوكْسُمْبورجيةَ Luxembourgish التي هي مُشتَقَّةٌ من الألمانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة قومية ","nonDiacriticsLemma":"لغة قومية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ قَوْمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/18ccc01b-08c7-4a35-88e8-e8ed79c46555/get-public-entry"},"browse_index_record":{"lexicalEntryId":"18ccc01b-08c7-4a35-88e8-e8ed79c46555","word":"كَلِمَةٌ مُطَبَّعَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97a9","lexicalEntryId":"18ccc01b-08c7-4a35-88e8-e8ed79c46555","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلِمَةٌ مُطَبَّعَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"كلمةٌ مُقتَرَضَةٌ من لغةٍ أخرى عُدِّلت صيغتُها لتَنسَجِم مع القواعد الصوتيةِ والصرفيةِ للُّغة التي اقترَضَتها، مثلُ كثيرٍ من الكلمات المعرَّبة في العربية التي منها: (تِلفاز) إذ صُرِّفت إلى: (تَلفَزَ) و(يُتَلفِزُ) و(تَلْفَزَة) و(مُتَلفَز)، ومنها كثيرٌ من الكلمات الفارسيةِ والتركيةِ التي دخَلَت العربية، وكذلك الكلماتُ العربيةُ التي دخَلَت الفارسيةَ والتركيةَ. تُسمّى هذه الظاهِرَةُ تَعريبًا في حال العربية، وأنْجْلَزَةً في حال الإنجليزية. راجع:  @(nativized form) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلمة مطبعة ","nonDiacriticsLemma":"كلمة مطبعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلِمَةٌ مُطَبَّعَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1d688778-d180-4f53-9934-eaf9bf9538c8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1d688778-d180-4f53-9934-eaf9bf9538c8","word":"الطَّرِيقَةُ الطَّبِيعِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97aa","lexicalEntryId":"1d688778-d180-4f53-9934-eaf9bf9538c8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطَّرِيقَةُ الطَّبِيعِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إحدى طرائقِ تدريسِ اللغاتِ الأجنبية، ظهَرَت في القرن التاسع عشر رَدًّا على طريقَة القواعدِ والترجَمة. تَنظُر الطريقةُ إلى تعلُّم اللغةِ الثانيةِ واللغةِ الأجنبيةِ على أنه سُلوكٌ طبيعيٌّ، لا يَختَلِف عن تعلُّم الطفلِ لغتَه الأمّ، وتهتَمُّ بالجانب المنطوق، وتَسَلسُلِ المهاراتِ اللغويةِ وفقًا لتَسَلسُلها كما في اكتساب الطفلِ لغتَه الأم، والابتِعاد عن الترجَمَة. تَطوَّرت هذه الطريقةُ فيما بعد إلى الطريقَة المباشِرَةِ Direct Method، واعتَمَد عليها المذهبُ الطبيعيُّ. راجع:  @(Natural Approach) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الطريقة الطبيعية ","nonDiacriticsLemma":"الطريقة الطبيعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطَّرِيقَةُ الطَّبِيعِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

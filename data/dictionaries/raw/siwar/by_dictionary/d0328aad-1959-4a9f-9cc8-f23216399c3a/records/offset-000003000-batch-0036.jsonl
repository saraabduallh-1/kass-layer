{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/22237cd4-6231-4d9e-84ac-0f909b0a017e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"22237cd4-6231-4d9e-84ac-0f909b0a017e","word":"الارْتِبَاطُ المُتَعَدِّدُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9798","lexicalEntryId":"22237cd4-6231-4d9e-84ac-0f909b0a017e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الارْتِبَاطُ المُتَعَدِّدُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في الإحصاء والبحثِ العلميِّ، يُقصَد به مُعامِلُ ارتِباطٍ بين ثلاثة متَغيِّراتٍ أو أكثَر؛ واحدٌ منها مستَقِلٌّ، والأخرى تابِعَةٌ، أو العَكس؛ أي العلاقةُ بين متَغيِّر مستَقِلٍّ ومتَغيِّرَيْن تابِعَيْنِ أو أكثَر أو العَكس. مثالُ ذلك العلاقةُ بين كِفايَةِ الطلابِ في اللغة الثانيةِ (متغيِّر تابِع)، وثلاثةِ متَغيِّراتٍ مستَقِلةٍ، هي: عَدَدُ ساعاتِ الواجباتِ المنزليةِ في الأسبوع، ومستوى مَعرفَتِهم بالقواعد، ومستوى دَوافِعِهم نحوَ تعلُّمِ اللغةِ الهَدَف. فالعلاقةُ بين المتغيِّرِ التَّابعِ وكلٍّ من المتغيِّرات الثلاثةِ المستَقِلَّةِ ارتِباطٌ متعَدِّدٌ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الارتباط المتعدد ","nonDiacriticsLemma":"الارتباط المتعدد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الارْتِبَاطُ المُتَعَدِّدُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

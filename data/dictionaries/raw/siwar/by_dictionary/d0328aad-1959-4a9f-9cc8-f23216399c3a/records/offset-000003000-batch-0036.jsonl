{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/904f7f5d-b0e3-4f6b-99ff-0fd1cb1b3280/get-public-entry"},"browse_index_record":{"lexicalEntryId":"904f7f5d-b0e3-4f6b-99ff-0fd1cb1b3280","word":"الجِهازُ العَصَبِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97a0","lexicalEntryId":"904f7f5d-b0e3-4f6b-99ff-0fd1cb1b3280","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الجِهازُ العَصَبِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النِّظامُ العَصَبيُّ، وهو مجموعةٌ من الأنسِجَة العَصَبيَّة؛ تتَحَكَّم في جِسم الإنسان، وتَقوم بتَنظيم أنشِطَتِه وحَرَكاتِه الإراديَّةِ وغيرِ الإراديَّة. يَنقَسم الجِهازُ العصَبيُّ قِسمَين مُستَقِلَّيْن تَشريحيًّا مُتعاوِنَيْن وَظيفيًّا، هما: الجِهازُ العَصَبيُّ المركَزَيُّ central nervous system، والجِهازُ العَصَبيُّ المحِيطِيُّ السَّطحِيُّ peripheral nervous system، إضافةً إلى الجِهاز العصَبيِّ المستَقِلِّ autonomic nervous system. بيدَ أن الجِهازَ العَصَبيَّ المركَزيَّ أهمُّ هذه الأجهزَة؛ لأن فيه الدِّماغَ الذي يَتحَكَّم في مُعظَم أنشِطَةِ الإنسانِ، بما في ذلك الأنشِطَةُ اللغوية. راجع:  @(brain) و  @(central nervous system) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الجهاز العصبي ","nonDiacriticsLemma":"الجهاز العصبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الجِهازُ العَصَبِيُّ"}],"lemmaLanguage":{"code":"ar","lab
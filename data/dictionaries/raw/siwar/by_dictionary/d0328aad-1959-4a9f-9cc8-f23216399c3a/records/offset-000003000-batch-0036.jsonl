{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/090bd8f6-702f-4b56-baf1-9a507bc17567/get-public-entry"},"browse_index_record":{"lexicalEntryId":"090bd8f6-702f-4b56-baf1-9a507bc17567","word":"مُعَالَجَةُ المَعْنَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97ae","lexicalEntryId":"090bd8f6-702f-4b56-baf1-9a507bc17567","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعَالَجَةُ المَعْنَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مناقشَةُ المعنى ومعالجَته بين متحَدِّثَيْن، وهو إستراتيجيةٌ تواصُليةٌ في تعليم اللغات الأجنبيةِ خاصةً، تُشير إلى ما يَبذُله المتحدِّثان من جُهودٍ لإنجاح عمليةِ التواصُلِ بينهما. وهذا يَتطلَّب خطواتٍ متواصِلةً، منها: التغذيةُ الراجِعةُ، والتَّكرارُ، وإعادَةُ الصِّياغَة، والتعزيزُ، والتفسيرُ، وتَجليَةُ المفاهيمِ الغامِضَةِ، وتصويبُ الأخطاءِ المعيقَةِ لفَهم الرسالة. يَشيع استعمالُ هذا المصطلَحِ بين مُتحدِّثَيْن بلُغة ثانيةٍ أو أجنبية؛ لأن مُشكلاتِ التواصُلِ وصُعوبةَ فَهمِ المعنى غالبا ما تكون بين مُتحدِّثَيْن بلغةٍ ثانيةٍ أو بلغةٍ أجنَبيةٍ لأحدهما أو لكِلَيهِما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معالجة المعنى ","nonDiacriticsLemma":"معالجة المعنى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعَالَجَةُ المَعْنَى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1a753a77-ac28-4b39-8c00-de70a6a82be1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1a753a77-ac28-4b39-8c00-de70a6a82be1","word":"عِلْمُ اللُّغَةِ الاجْتِمَاعِيُّ الأَصْغَرُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96ae","lexicalEntryId":"1a753a77-ac28-4b39-8c00-de70a6a82be1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ الاجْتِمَاعِيُّ الأَصْغَرُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الدراسةُ التفصيليةُ التي تتَناوَل مسألةً أو مسائلَ لغويةً اجتماعيةً محدَّدةً وتتعَمَّق فيها؛ كأحداث الكلام، وأنماطِ الحِوار، وأساليبِ الطَّلَب، ونحوِها من أنماط التواصُل الشخصيِّ، خلافا لعلم اللغةِ الاجتماعيِّ الأكبَرِ أو الموَسَّعِ الذي يتَناول القضايا اللغويةَ الاجتماعيةَ العامَّة؛ كالازدواجية اللغوية، والثنائيةِ اللغوية، والتعَدُّدِ اللغوي، والتخطيطِ التَّقْنِينيِّ، والسياسةِ اللغوية. راجع:  @(macro-sociolinguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة الاجتماعي الأصغر ","nonDiacriticsLemma":"علم اللغة الاجتماعي الأصغر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ الاجْتِمَاعِيُّ الأَصْغَرُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/68de7cdb-8dea-4b9b-b3fa-d2cb0c525597/get-public-entry"},"browse_index_record":{"lexicalEntryId":"68de7cdb-8dea-4b9b-b3fa-d2cb0c525597","word":"التَّدْرِيسُ المُصَغَّرُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96af","lexicalEntryId":"68de7cdb-8dea-4b9b-b3fa-d2cb0c525597","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّدْرِيسُ المُصَغَّرُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ من أساليب تَدريبِ المعلِّمين؛ يمثِّل صورةً مُصغَّرَةً للدرس أو جُزءًا من أجزائه، أو مهارةً من مهاراته الأصليَّةِ أو الفَرعِيَّة، يَتِمُّ تحت ظروفٍ مَضبوطَة، ويُقَدَّم لعَدَدٍ محدودٍ من المتعلِّمين أو المعلِّمين المتدرِّبين. وهو أنواعٌ مختَلِفة؛ كالتدريب المبكّرِ على التدريس المصغَّر، والتدريبِ في أثناء الخِدمَة، والتدريسِ المصغّرِ المستَمِرّ، والتدريسِ المصغّرِ الخِتامِيّ، والتدريسِ المصغَّرِ الموَجَّه، والتدريسِ المصغَّرِ الحُرّ، والتدريسِ المصغَّرِ العامّ، والتدريسِ المصغّرِ الخاصّ. يتطلَّب التدريسُ المصغَّر مهاراتٍ معيَّنةً، ويَمُرُّ بعَدَدٍ من المراحِل، ويُلجأ إليه لحَلِّ المشكلاتِ التي يُواجِهُها المدَرِّبون والمتَدَرِّبون؛ كانعِدام الطلابِ الحقيقيِّين، أو بُعدِهم عن مكان التدريب. وينطَلِق التدريسُ المصغَّرُ من فَلسَفَةٍ ترى أن التدريسَ عَمَليةٌ مُعقَّدَة، مكَوَّنَةٌ من مهاراتٍ وأنشِطَة، يمكن تَفكيكُها إلى أجزاء ومهاراتٍ وأنشِطَةٍ صغيرة، وتدريبُ المعلِّمين عليها أمامَ عَدَدٍ محدودٍ من الطلاب أو الزملاءِ المعلمين، أمَلًا في القُدرَة على تركيبِ هذه الأجزاءِ وإعادَتِها إلى أُصولها. طُبِّق التدريسُ المصغَّرُ في تَدريب معلِّمي اللغاتِ الأجنَبية على نِطاقٍ واسِعٍ في الخمسينيات والستينياتِ من القرن العشرين، إبَّان هَيمَنَةِ الطريقةِ السَّمعيةِ الشَّفَهية، ثم أُعيدَ تَطبيقُه في ضَوء الاتجاهاتِ المعرِفيةِ الفطريةِ والمذاهبِ التواصُليةِ في تعليم اللغات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التدريس المصغر ","nonDiacriticsLemma":"التدريس المصغر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّدْرِيسُ المُصَغَّرُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/59d6956c-a6d5-4c6f-8a0d-be31720fd4e7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"59d6956c-a6d5-4c6f-8a0d-be31720fd4e7","word":"كِتَابَةٌ مُوَسَّعَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b03","lexicalEntryId":"59d6956c-a6d5-4c6f-8a0d-be31720fd4e7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كِتَابَةٌ مُوَسَّعَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَرميزٌ أو كتابةٌ فونِيمِية، وهي طريقةٌ من طرائق الكتابةِ الصوتيةِ يُكتَفَى فيها بكتابَة الرُّموزِ الفونيمِيةِ الوَظيفِية، وتوضَع بين خَطَّين مائلَين، مثلُ كلمةِ: foot التي تكتَب: /fut/; /f/, /u/, /t/. ويُستَفاد من هذه الكتابةِ في كتابة اللغاتِ التي ليس لها نظامٌ كتابيٌّ، كما تستَعمَل لتوضيح طريقةِ نُطقِ الكلماتِ لأهدافٍ معجَمية أو تعليمية. راجع:  @(phonemic notation) و  @(phonetic notation) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كتابة موسعة ","nonDiacriticsLemma":"كتابة موسعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كِتَابَةٌ مُوَسَّعَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0ec80818-b728-4b7a-acda-28e03397e8b8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0ec80818-b728-4b7a-acda-28e03397e8b8","word":"التَّحْلِيلُ التَّقَابُلِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b04","lexicalEntryId":"0ec80818-b728-4b7a-acda-28e03397e8b8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّحْلِيلُ التَّقَابُلِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَحليلُ أنظمَةِ لغَتَين، أو إجراءُ مقارَنَةٍ بينهما؛ لتَحديد مواطِنِ التَّشابُه والاختِلافِ بينهما في الجوانب الصوتيةِ والصرفيةِ والنحويةِ والدّلاليةِ والمفاهيمِ الثقافية. وهو فرعٌ من فروع علمِ اللغة، بجانبيه النظريِّ العامِّ والتَّطبيقِيِّ. ازدَهَر في الخَمسينِيات والستينيات من القرن العشرين نتيجةَ سيطَرَةِ الاتجاهِ السُّلوكيِّ البِنيَويِّ على دراسة اللغاتِ وتعلُّمِها وتعليمِها، واعتُمِد عليه في تحليلِ الأخطاء، وبناءِ الموادِّ التعليمية. وقد بُني التَّحليلُ التَّقابُليُّ على عَدَدٍ من الفَرضيات، منها: أن معظمَ الصعوباتِ التي يُواجِهُها متعلمُ اللغةِ سبَبُها تَدَخُّل أنظِمَةِ اللغةِ الأمِّ في اكتساب اللغةِ الهَدَف، وأن هذه الصعوباتِ يمكن التَّنَبُّؤُ بها بواسطة التَّحليلِ التَّقابُلي، وأن الموادَّ التعليميةَ المبنِيةَ على نتائج التَّحليلِ التَّقابُلِيِّ تُقلِّل من تأثير التَّدَخُّلِ اللغوي. ونتيجةً لأفُول نجمِ الاتجاهِ السُّلوكيِّ البِنيَويِّ في السّبعينيات من القَرن العِشرين، ولاسيَّما في تعليم اللغات، سَقَطَت الثِّقَةُ بالتَّحليل التَّقابُلِيِّ بوَصفه أساسا لتَحليل الأخطاءِ وبناء الموادِّ التعليمية، باستِثناء جوانبَ محدودَةٍ في الأصوات، وحَلَّت محَلَّه نظرياتٌ في التَّحليل وتَفسيرِ الأخطاء؛ أهمُّها تحليلُ الخِطابِ، ونظريةُ المَوسومِيَّةِ في تفسير الأخطاء. وفي السنوات الأخيرَة عادَ هذا المنهَجُ من نافِذَة المدوّناتِ اللغوية، لا في مُقارَنة لغَتَين وحَسب، وإنما في مُقارَنة التَّنَوُّعاتِ اللغوية، ومُقارَنَةِ اللَّهَجاتِ داخِلَ اللغةِ الواحِدَة، ومُقارَنَةِ اللغةِ المرحَليَّةِ لمتعلِّمي اللغةِ الهدَفِ بلُغَة الناطِقين بها. راجع:  @(Error Analysis (EA)) و  @(contrastive discourse analysis) و  @(Markedness Theory) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التحليل التقابلي ","nonDiacriticsLemma":"التحليل التقابلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّحْلِيلُ التَّقَابُلِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/879689b2-2fe4-49e6-9f96-8cf8976fff31/get-public-entry"},"browse_index_record":{"lexicalEntryId":"879689b2-2fe4-49e6-9f96-8cf8976fff31","word":"أَصْنَافُ الوَظِيفَةِ التَّوَاصُلِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b05","lexicalEntryId":"879689b2-2fe4-49e6-9f96-8cf8976fff31","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَصْنَافُ الوَظِيفَةِ التَّوَاصُلِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ التَّصنيفاتِ النَّوعيةِ التي وَضَعَها اللغويُّ التطبيقيُّ ديفيد وِيلْكِنز David Wilkins، عامَيْ 1972و 1976م، في منهَج الفِكرَةِ أو المنهَجِ الفِكرِيِّ الوَظيفِيِّ في تعليم اللغةِ notional/functional syllabus. وقد غَلَب عليها مصطلَحُ وَظائف functions، وتَعني الوَظائفَ التي تُعبِّر عن استِعمال اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أصناف الوظيفة التواصلية ","nonDiacriticsLemma":"أصناف الوظيفة التواصلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَصْنَافُ الوَظِيفَةِ التَّوَاصُلِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0031af46-fac6-4eaa-bd08-ce82c1fdbb05/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0031af46-fac6-4eaa-bd08-ce82c1fdbb05","word":"فِعْلُ التَّعْدِيَةِ السَّبَبِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b06","lexicalEntryId":"0031af46-fac6-4eaa-bd08-ce82c1fdbb05","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فِعْلُ التَّعْدِيَةِ السَّبَبِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فعلٌ سَببيٌّ متَعَدٍّ، تدُل صِيغَتُه على أن فاعِلَه سبَّبَ وُقوعَ الفِعلِ، مثلُ: (ألبَسَ) و(أطعَمَ) و(أنزَلَ) في العربية، ومثلُ: fell, bake, roll في الإنجليزية. والهمزةُ والتَّضعيفُ في العربية من الأدوات التي تجعَل الفعلَ اللازِمَ متَعَدِّيا، وتجعَل الفعلَ المتعدِّيَ إلى مفعول به واحدٍ متعَدِّيا إلى مَفعولَين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فعل التعدية السببي ","nonDiacriticsLemma":"فعل التعدية السببي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فِعْلُ التَّعْدِيَةِ السَّبَبِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3329c1fe-79d5-4a03-9715-756fb290e0bc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3329c1fe-79d5-4a03-9715-756fb290e0bc","word":"مَعْنَى مَرْكَزِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b07","lexicalEntryId":"3329c1fe-79d5-4a03-9715-756fb290e0bc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَعْنَى مَرْكَزِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المعنى الأساسُ أو الأكثَرُ تَداوُلا للكلمة التي لها أكثَرُ من معنى، وهو المعنى المعجَميُّ للكلمة حينما تَرِد في أقَلِّ سِياقٍ أو تَرِد منفَرِدَةً، خلافا للمَعنى الهامِشِيِّ أو المعنى الإضافيِّ أو الثانوي. فكلمةُ: (امرأة) لها معنى معجَميٌّ مركَزَيٌّ هو أنها إنسانٌ أنثى بالِغَة، ولها معانٍ هامِشِيةٌ إضافيةٌ تختَلِف من ثقافَةٍ إلى أخرى؛ كأن تَدُل على الحَنان والنُّعومَة، ولُبسِ نَوعٍ من الملابِس، والعِنايَةِ بالألوان، وإتقانِ الطَّبخ، وقد تَعنِي الثرْثرَة في بعض المجتَمَعات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معنى مركزي ","nonDiacriticsLemma":"معنى مركزي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَعْنَى مَرْكَزِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

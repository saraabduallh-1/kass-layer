{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2e091cc4-cb44-491c-aed3-91dc859897fc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2e091cc4-cb44-491c-aed3-91dc859897fc","word":"بَرْنامَجٌ تَفْرِيعِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8afa","lexicalEntryId":"2e091cc4-cb44-491c-aed3-91dc859897fc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بَرْنامَجٌ تَفْرِيعِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"برنامجٌ في تعليم اللغةِ المبَرمَج، يُسمّى أيضا branched programmed instruction، وهو مَبنيٌّ بناءً تَدرجِيًّا تراكُمِيًّا، يُوَجَّه فيه الطالبُ الضعيفُ إلى موادَّ تعليميةٍ إضافيةٍ فَرعيةٍ تُكمِل ما يَنقُصه عن زملائه حتى إذا قَرُب من مستواهم عاد إلى البرنامَج الأصلي. ويمكّن هذا البرنامَجُ الحاسوبَ من تَقديم عَشَراتِ الدُّروسِ في المادة الأساسيةِ نفسِها، ويَسمَح بتَصميم برامجَ مختَلِفةٍ لطلابٍ من خَلفيّاتٍ ومُستَوَياتٍ مختَلِفة، ويَسير كلُّ طالبٍ فيه بحسب قُدراتِه. راجع:  @(programmed learning) و  @(programmed instruction/teaching) و  @(linear program) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"برنامج تفريعي ","nonDiacriticsLemma":"برنامج تفريعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بَرْنامَجٌ تَفْرِيعِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

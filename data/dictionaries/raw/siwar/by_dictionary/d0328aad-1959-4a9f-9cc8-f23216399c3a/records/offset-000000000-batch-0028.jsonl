{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4b267c09-28cc-4ee8-a9b0-276d639e9da6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4b267c09-28cc-4ee8-a9b0-276d639e9da6","word":"مَجْمُوعَةُ مُتَحَادِثَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b0f","lexicalEntryId":"4b267c09-28cc-4ee8-a9b0-276d639e9da6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَجْمُوعَةُ مُتَحَادِثَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ تعليميٌّ، يُقصَد به مجموعةٌ من الطلاب تُناقِش مسألَةً أو قَضِيَّةً أو مَوضوعا لمدَّة قَصيرة، خمس دقائقَ مثلاً؛ بهدَف تكوينِ آراءٍ أو إجاباتٍ على أسئلَة محدَّدة، أو لتَهيِئة الطلابِ للدَّرس الجديدِ والتفاعُلِ مع أنشِطَته، أو لتَهيئتهم لإجراء محادَثَةٍ مع المجموعة كلِّها. وهو من الأساليب المفيدَةِ في تعليم اللغاتِ الأجنَبية؛ إذ يُساعِد على كَسر حاجِزِ الخَوفِ من الكلام، ويَدفَع الطلابَ نحوَ الطلاقَةِ في اللغة الهَدَف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مجموعة متحادثة ","nonDiacriticsLemma":"مجموعة متحادثة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَجْمُوعَةُ مُتَحَادِثَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/695761d7-9f85-4a5e-ae8d-60538149c86f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"695761d7-9f85-4a5e-ae8d-60538149c86f","word":"مَجْمُوعَةٌ نَفَسِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b0c","lexicalEntryId":"695761d7-9f85-4a5e-ae8d-60538149c86f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَجْمُوعَةٌ نَفَسِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سِلسِلَةٌ من الأصوات الكَلاميةِ المنطوقَةِ في عَمَلِيَّة زَفيرٍ واحدة، تتَتابَع في أثناء الكلامِ العادِي، ويَسبِقها شَهيقٌ ويَتلوها شَهيق. وتختَلِف هذه الأصواتُ من لغةٍ إلى أخرى، ومن شَخصٍ إلى آخَر، ومن مَوقِفٍ إلى آخَر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مجموعة نفسية ","nonDiacriticsLemma":"مجموعة نفسية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَجْمُوعَةٌ نَفَسِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7c2a013e-bf2d-41cf-81fb-8adfe4a6dee4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7c2a013e-bf2d-41cf-81fb-8adfe4a6dee4","word":"منطَقَةُ بْرُوكَا","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b0d","lexicalEntryId":"7c2a013e-bf2d-41cf-81fb-8adfe4a6dee4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"منطَقَةُ بْرُوكَا","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إحدى أهمِّ مناطِقِ اللغةِ في الدِّماغ، وهي المنطقةُ الحَرَكية المسؤولَةُ عن إصدار الكلام، وتَقَع في الجِهَة الخَلفِيَّةِ من الجانب الأيسَرِ من الدِّماغ. وسُمِّيَت بهذا الاسمِ نِسبَةً إلى الجَرّاح الفرنسيِّ بُول بْرُوكا Paul Broca الذي اكتَشَفها عام 1861م في أثناء تَشريحِه دِماغَ شخصٍ مُسِنٍّ أُصيبَ بحُبسَة كَلامِية، حين وَجَد أن هذه المنطقةَ سوداءُ مَعطُوبَة. وتحدُث الإصابةُ بهذه الحُبسَةِ نتيجَةَ تَلَفٍ في هذه المنطقةِ، وتُسمّى حُبسَةَ بروكا Broca's aphasia","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"منطقة بروكا ","nonDiacriticsLemma":"منطقة بروكا","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"منطَقَةُ بْرُوكَا"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

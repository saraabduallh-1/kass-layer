{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e4d9f763-5243-4b8d-aef4-c8f9a64beb2b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e4d9f763-5243-4b8d-aef4-c8f9a64beb2b","word":"مُحَوِّلٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97fc","lexicalEntryId":"e4d9f763-5243-4b8d-aef4-c8f9a64beb2b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُحَوِّلٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"آلةٌ نظريةٌ بسيطَةٌ، تُستَعمَل في اللغويات الحاسوبية، تُرسَم أحيانا في شَكل مخطَّطٍ أو نحوِه؛ لتُمَثِّل قاعدةً لغويةً على هيئة سِلسِلَةِ حالاتٍ محدودَة؛ بعضُها يُناظِر مُدخلاتِ القاعدَةِ اللغوية، وبعضُها يُناظِر مُخرَجاتِها؛ فتُنتِج المخرجاتِ آلِيًّا بتَجميع العناصِرِ المفرَدةِ الداخِلَةِ إليها واحدا تِلوَ الآخَرِ تَبعا لتَسَلسُل الحالات، ثم تَجمَع عناصِرَ المخرَجاتِ المناظِرَةِ لها أيضا بحسَب التَّسَلسُلِ الذي تحَدِّده القاعدَة، وتُسَجِّله على شَريطٍ وَرَقيٍّ أو غيره.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات","اللغات"],"translations":[]}],"pos":"A","root":null,"wordForms":[],"relatedSenses":[],"search":"محول ","nonDiacriticsLemma":"محول","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُحَوِّلٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/82455bda-6bac-4963-a6bf-c4b932692e2f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"82455bda-6bac-4963-a6bf-c4b932692e2f","word":"أَصْلُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97fd","lexicalEntryId":"82455bda-6bac-4963-a6bf-c4b932692e2f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَصْلُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"البحثُ الذي يُعنَى بأصل اللغةِ الإنسانيةِ ونَشأتِها، من حيث كونُها إلهامًا وتوقيفًا، أو مُواضَعَةً واصطِلاحًا، أو محاكاةً لأصوات الطبيعةِ، أو نتيجةَ صَرَخاتٍ انفِعاليةٍ، أو نحوَ ذلك. على الرّغم من أن الرأيَ السائدَ الآنَ هو أن اللغةَ مُواضَعَةٌ واصطِلاحٌ، فإن معظَمَ اللغويّين المعاصِرِين يَرَون أن الحديثَ في هذا الأمرِ جَدَلٌ فَلسَفيٌّ لا فائدةَ منه، ويَصعُب إثباتُه بالأدِلَّة العلمية. يُطلَق المصطلحُ أيضا على الحديث أو البحثِ في أصْل اللغةِ الإنسانية، والخِلافِ حولَ ما إذا كانت جميعُ اللغاتِ تعود إلى لغةٍ واحدَةٍ تفرَّعَت وتعَدَّدَت بمرور الزَّمَن، أم إنها كانت متعَدِّدَة منذ البِدايَة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أصل اللغة ","nonDiacriticsLemma":"أصل اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَصْلُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ef2f2906-124c-434b-88d0-4a8fe9b4becf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ef2f2906-124c-434b-88d0-4a8fe9b4becf","word":"تَوْسِيعُ القِيَاسِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97fe","lexicalEntryId":"ef2f2906-124c-434b-88d0-4a8fe9b4becf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوْسِيعُ القِيَاسِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"خَطأٌ يَقَع فيه متعلِّمُ اللغةِ الثانيةِ نتيجةَ التَّوسُّعِ في قياس نَمَطٍ في اللغة الهَدَفِ على نَمَطٍ في لغته الأمِّ، مثلُ استعمالِ بعضِ متعلِّمي الإنجليزيةِ لكلمة: regime بمعنى (نظام)، قياسا على معناها في لغاتهم، على الرّغم من أن لهذه الكلمةِ في الإنجليزية المعاصِرَةِ معنًى سَلبيًّا محدودًا يَنحَصِر في وَصف النظامِ السياسيِّ الفاسِدِ، أو المتَّهَمِ بالفَساد، في دَولةٍ ما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"توسيع القياس ","nonDiacriticsLemma":"توسيع القياس","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَوْسِيعُ القِيَاسِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

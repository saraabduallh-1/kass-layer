{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ded8cd2e-6c81-4c5a-9a60-6a28643ef64d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ded8cd2e-6c81-4c5a-9a60-6a28643ef64d","word":"أَسَالِيبُ المُلاحَظَةِ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97f8","lexicalEntryId":"ded8cd2e-6c81-4c5a-9a60-6a28643ef64d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَسَالِيبُ المُلاحَظَةِ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أساليبُ في البحث تَعتَمِد على الملاحَظَة المنظَّمَةِ للأحداث والأنشِطَة، وتُستَعمَل فيها أدواتٌ بحثيةٌ معيَّنة؛ كالتسجيل بأنواعه المسموعَةِ والمرئيةِ، والجَداولِ، وقوائمِ الملاحَظَة. يشيع استعمالُ هذه الأساليبِ في دراسة اللغةِ الأمِّ، وملاحَظَةِ ما يَحدُث في فُصول تعليمِ اللغةِ الثانيةِ أو الأجنَبية، حيث تُطبَّق أساليبُ البحثِ الإثنوغرافيِّ ethnographical research. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أساليب الملاحظة  ","nonDiacriticsLemma":"أساليب الملاحظة ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَسَالِيبُ المُلاحَظَةِ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5e29443e-7e1f-40da-8374-dc1dff795521/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5e29443e-7e1f-40da-8374-dc1dff795521","word":"الأُوكْسِيدنْتَال ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97f9","lexicalEntryId":"5e29443e-7e1f-40da-8374-dc1dff795521","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الأُوكْسِيدنْتَال ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"لغةٌ مَصنوعةٌ وَضَعَها إدگار دي فاهل Edgar de Wahl، بهَدَف تَيسير التواصُلِ بين الناطقين باللغات الغربية، ونَشَر تفاصيلَها عام 1922م؛ ثم اكتَسَبَت أتباعًا في بعض دولِ آسيا حتى عُدَّت ثاني لغةٍ عالميةٍ مَصنوعة. اعتَمَدَت على اللغات الأوروبية، كما يَدُلّ عليها اسمُها الذي يَعني (الغربية) Western أو كلَّ ما له صِلةٌ بالغَرب، لاسيَّما لغاتُ أوروبا الغربيةِ أو اللغاتُ الرومانسية؛ حيث اقتبسَت منها مفرَداتِها وصِيغَها وتراكيبَها بطريقةٍ مُبَسَّطَة. وعلى الرّغم من أنها انحسرت في منتَصَف القرنِ العشرين، فقد اكتَسَبت قيمَةً عمليّةً مع شيُوع استعمالِ الشبكَةِ العالميةِ internet. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"الأوكسيدنتال  ","nonDiacriticsLemma":"الأوكسيدنتال ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الأُوكْسِيدنْتَال "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b47636c3-21ce-4a6c-bf1a-4466cc6e7a0d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b47636c3-21ce-4a6c-bf1a-4466cc6e7a0d","word":"الاسْتِمْرَارُ والإبدَاعُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b97fa","lexicalEntryId":"b47636c3-21ce-4a6c-bf1a-4466cc6e7a0d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الاسْتِمْرَارُ والإبدَاعُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ ابتَدَعَه اللغويٌّ الأمريكيُّ تشارلز هوكيت Charles Hockett عامَ 1960م، مُرادِفاً لمصطلحَيْ الإنتاجِ productivity والإبداعِ creativity، المعروفَيْن قبل ذلك بعُقُود، أو بَديلًا عنهما. يَقصد به قُدرَةَ الإنسانِ على الإبداع اللُّغويِّ المتمَثِّلِ في إنتاج عَدَدٍ غيرِ محدودٍ من الكلمات والعباراتِ والجُملِ للتعبير عمّا يُريده، وهي مما يُمَيِّزَ لغةَ الإنسانِ عن لغات سائرِ المخلوقاتِ الأخرى. فالإنسانُ يَصوغ كلامَه في كلماتٍ وعباراتٍ وجُمَلٍ مُتجدِّدَةٍ في المبنى والمعنى وفقَ قواعدِ اللغةِ التي يَتحدَّث بها، في حين لا يَستطيع القِردُ مثلا تبليغَ ما يُريد إلّا بإرسال رسالةٍ message أو نداءٍ call أو صوتٍ sound من ألفاظٍ محفوظةٍ محصورةٍ، من غير قُدرَةٍ على صياغةِ ذلك في جُملة أو تركيبٍ، فضلًا عن عَدَم قُدرتِه على تَغييره وتَنويعِ دلالاتِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الاستمرار والإبداع ","nonDiacriticsLemma":"الاستمرار والإبداع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الاسْتِمْرَارُ والإبدَاعُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

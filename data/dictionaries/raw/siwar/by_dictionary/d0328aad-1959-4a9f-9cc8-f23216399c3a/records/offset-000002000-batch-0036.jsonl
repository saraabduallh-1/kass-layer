{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/53d17191-10f2-4084-baba-fbeda39bfa09/get-public-entry"},"browse_index_record":{"lexicalEntryId":"53d17191-10f2-4084-baba-fbeda39bfa09","word":"التَّبَعِيَّةُ المُتبادَلةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93ac","lexicalEntryId":"53d17191-10f2-4084-baba-fbeda39bfa09","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّبَعِيَّةُ المُتبادَلةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مبدأٌ لغويٌّ تطبيقيٌّ وَضعَه جيم كامِنْز Jim Cummins، يرى فيه أن الكِفايَةَ اللغويةَ الأكاديميةَ المعرِفيةَ cognitive academic language proficiency  عامَّةٌ في اللغات ومشتَرَكةٌ بينها، ومن ثمَّ فإن من السَّهل تحويلَ هذه الكِفايَةِ من لغةِ المتعلِّمِ الأمِّ إلى اللغة الهَدَف. ويرى كامِنْز أن هذا المبدأَ يُفَسِّر ما يُلاحَظ من أن متعلِّمي اللغةِ الثانيةِ والأجنبيةِ، ذوِي التعليمِ الجيِّدِ في لغتهم الأم، لا يواجِهون صُعوباتٍ كبيرةً في اكتساب الكِفايَةِ اللغويةِ الأكاديميةِ المعرفيةِ في اللغة الثانيةِ أو الأجنبيةِ وإن لم يتَمَكَّنوا من الكِفايَة التواصُلية، في حين يُواجِهُ الأمِّيُّون صُعوباتٍ جمَّةً في اكتساب هذه الكِفايَةِ اللغويةِ الأكاديمية. راجع:  @(Cognitive Academic Language Proficiency (CALP)) و  @(Basic Interpersonal Communication Skills (BICS)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التبعية المتبادلة ","nonDiacriticsLemma":"التبعية المتبادلة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/618f0d5b-2874-422f-850b-1aa0e31b8a7f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"618f0d5b-2874-422f-850b-1aa0e31b8a7f","word":"اسْتِيعَابٌ ثَقَافِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d8a","lexicalEntryId":"618f0d5b-2874-422f-850b-1aa0e31b8a7f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْتِيعَابٌ ثَقَافِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغات، يَعني دَمجَ شَخصٍ ما في ثقافة البَلدِ المضيفِ لدرَجَة ذَوَبانِه فيها. والاستيعابُ الثقافيُّ، أو الذَّوَبانُ الثقافيُّ كما يُسمى أحيانا، هو أعلى درَجاتِ المثاقَفَةِ أو التَّثاقُفِ أو التَّطَبُّعِ الثقافيِّ acculturation الذي يُساعد الأجنبيَّ على اكتساب لغةِ البلَدِ المضيفِ بشَكلٍ طبيعيٍّ، وفقَ شروطٍ لغويةٍ اجتماعيةٍ معيَّنةٍ وَضَعَها أصحابُ نظريةِ التَّثاقُفِ أو التَّطبُّعِ الثقافيِّ Acculturation Theory أمثال شُومان Schumann، وأصحابُ نظريةِ المواءمَةِ أمثال جايلز Giles.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"استيعاب ثقافي ","nonDiacriticsLemma":"استيعاب ثقافي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْتِيعَابٌ ثَقَافِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/65fbdb02-1e05-4c1a-9ad5-0402ed60703c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"65fbdb02-1e05-4c1a-9ad5-0402ed60703c","word":"ثَقَافَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d82","lexicalEntryId":"65fbdb02-1e05-4c1a-9ad5-0402ed60703c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ثَقَافَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مجموعةُ المفاهيمِ والقِيَمِ والاتجاهاتِ والعاداتِ والسُّلوكِ لدى مجموعَةٍ من الناس في بيئةٍ اجتماعيةٍ معيَّنة، وتشمل الممارَساتِ الفنِّيَّةَ والعِلميةَ والأخلاقيةَ والدِّينيةَ والاقتصاديةَ والسياسية، والمؤسّساتِ والمعايِيرَ والمعتَقَدات. هذا المفهومُ أقرَبُ إلى المفهوم الغَربيِّ للثقافة، الذي يَشمل الدِّينَ أيضا بما فيه من عَقيدَةٍ ومبادِئَ وأخلاقٍ وسُلوك، وهو معنى قريبٌ من مَفهوم الموروثِ الاجتِماعيِّ الذي هو من صُنْع البَشَر، كما أكَّدَه ديريك أتريدج Derek Attridge وغيرُه من الغَربيِّين. أما المفهومُ الإسلاميُّ للثقافة، فيَرى أنها مُنبَثِقةٌ من الدِّين بما يَحويه من عَقيدَةٍ ومبادئَ وأخلاقٍ وسُلوك، أي إن الدِّينَ أساسُ الثقافةِ لا العَكس، بل إن الثقافةَ العرَبيةَ في عُمومها منبَثِقَةٌ من الإسلام. وثمةَ فَرقٌ بين الثقافةِ الإسلاميةِ التي هي نمَطُ الحياةِ لمجتَمَعٍ من المجتَمَعات الإسلاميةِ، والثقافةِ الإسلاميةِ بمعنى الشَّريعةِ التي تَصِف ما يَنبَغي أن تكون عليه هذه الحياةُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"ثقافة ","nonDiacriticsLemma":"ثقافة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ثَقَافَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/356df1ba-3ff0-419e-88ba-34503e29134a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"356df1ba-3ff0-419e-88ba-34503e29134a","word":"إعْدَادُ المَنْهَج","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d83","lexicalEntryId":"356df1ba-3ff0-419e-88ba-34503e29134a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إعْدَادُ المَنْهَج","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إعدادُ دراسةٍ مفَصَّلَةٍ لمنهَجِ برنامَجٍ تعليميٍّ معيَّنٍ من حيث الأهدافُ، ونَوعُ المحتَوَى، وطَريقةُ التَّطبيق، وأساليبُ التقييم. وفي تعليم اللغةِ يتضَمَّن إعدادُ المنهَجِ دراسةَ الأهدافِ التي يحتاجُها المتعلِّمُ بعد تحليلِ حاجاتِه، ووَضعِ الأهدافِ، وتَحديدِ مُفرداتِ المقرَّراتِ الدراسيةِ، والموادِّ التعليمية، وطرائقِ التدريسِ وأنشِطَتِه، وتحديدِ أساليبِ التقييمِ التي تَقيس مَدَى تَحقُّقِ الأهدافِ المرسومةِ للبرنامَج.  ويُسمّى هذا أيضا: curriculum design.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إعداد المنهج ","nonDiacriticsLemma":"إعداد المنهج","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إعْدَادُ المَنْهَج"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dba56f11-c17a-4041-8b16-c45d70b2eeca/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dba56f11-c17a-4041-8b16-c45d70b2eeca","word":"أَصَمّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d84","lexicalEntryId":"dba56f11-c17a-4041-8b16-c45d70b2eeca","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَصَمّ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"هو الشخصُ المصابُ بالصَّمَمِ deafness، أو العاجِزُ عن سَماع الصّوت، سواء أكان طفلا أم بالِغا. ويَعتَقِد معظمُ الناس أن كلَّ أصمّ أبكمُ والعَكس؛ لأن مُعظَمَ الصُّمِّ غيرُ قادِرين على الكلام، لكن المختَصِّين يميِّزون بين الأصَمِّ deaf والأبكَمِ mute/dumb. فالأصَمُّ وَصفٌ لفاقِد السَّمعِ فقط، سواء أكان قادِرا على الكلام أم غيرَ قادِرٍ عليه، أما الأبكَمُ فهو الإنسانُ غيرُ القادِرِ على الكلام لأسباب كثيرةٍ قد يكون الصَّمَمُ أحَدَها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"AA","root":null,"wordForms":[],"relatedSenses":[],"search":"أصم ","nonDiacriticsLemma":"أصم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَصَمّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7e2d69fd-c61a-48a0-a13b-f463208a1bed/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7e2d69fd-c61a-48a0-a13b-f463208a1bed","word":"مَعْرِفَةٌ تَصْرِيحِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d85","lexicalEntryId":"7e2d69fd-c61a-48a0-a13b-f463208a1bed","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَعْرِفَةٌ تَصْرِيحِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم النفسِ المعرِفيِّ ونظريةِ التعلُّم، شاع استعمالُه في تعليم اللغات، يُطلَق على إحدى الطريقَتَين لحِفظ المعلوماتِ في الذاكرَة طويلةِ الأَمَد، ويُقصَد به المعلوماتُ النظريةُ التي يحفَظها المتعلِّمُ في الذاكرَة بطريقةٍ صَريحةٍ واعِيَةٍ غيرِ ضِمنِيةٍ ويستَطيع التَّعبيرَ عنها ووَصفَها. مثالُ ذلك أن يَعرِفَ الطالبُ - نظرياً - قاعِدَةَ بناءِ الجُملَةِ الفعليةِ ومكوِّناتِها من فعلٍ وفاعلٍ ومفعولٍ به. أما الطريقةُ الثانيةُ فتُسمّى المعرِفةَ الإجرائيةَ procedural knowledge، وتَعني قُدرَةَ الطالبِ الفعليةَ على استعمال جُملةٍ فيها فعلٌ وفاعلٌ ومفعولٌ به استعمالا صحيحا وإن لم يَعرِف القاعدةَ معرِفةً نَظريةً. ويَرَى كثيرٌ من اللغويين التطبيقيين أن مُعظَم جوانبِ اللغةِ وأنماطِها تُكتَسَب، أو يجب أن تُكتَسب، بالطريقة الثانيةِ لا بالطريقة الأولى. راجع:  @(declarative knowledge) و  @(procedural knowledge) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معرفة تصريحية ","nonDiacriticsLemma":"معرفة تصريحية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَعْرِفَةٌ تَصْرِيحِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5a2defe7-04fd-45a8-989f-4fbe155f7092/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5a2defe7-04fd-45a8-989f-4fbe155f7092","word":"لُكْنَةُ المُهَاجِرِينَ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92f5","lexicalEntryId":"5a2defe7-04fd-45a8-989f-4fbe155f7092","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُكْنَةُ المُهَاجِرِينَ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لَهْجةٌ أو مستَوى من مستوَيات لغةٍ ما في بلدٍ ما، تُمَيِّز المهاجِرين أو الوافِدين إلى البَلد من بلدٍ أو بلادٍ أخرى عن سواهم من السُّكان الأصليِّينِ الناطقين باللغة ذاتِها، كالعربية اللبنانيةِ التي يَتحدَّث بها الأرمَنُ في لبنان، والعربيةِ التي يتحدَّث بها اليَمنيون المهاجِرون إلى إندونيسيا، واللُّكنَةِ الهنديةِ التي تَظهَر في إنجليزية الهنودِ في بريطانيا. وتتَّسِم هذه اللَّهجَةُ بسِماتٍ عامَّةٍ متشابهةٍ لدى المهاجرين، مهما اختَلَفَت لغاتُهم الأمُّ، وقد تتحَوَّل إلى لغةٍ هَجينٍ pidgin حين يَغلِب عَدَدُ المهاجِرين عدَدَ السُّكانِ الأصليِّين، وربما تتحَوَّل اللغةُ الهَجينُ إلى لغةٍ موَلَّدة creole. راجع:  @(immigrant language) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لكنة المهاجرين ","nonDiacriticsLemma":"لكنة المهاجرين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُكْنَةُ المُهَاجِرِينَ"}],"lemmaLanguage":{"code"
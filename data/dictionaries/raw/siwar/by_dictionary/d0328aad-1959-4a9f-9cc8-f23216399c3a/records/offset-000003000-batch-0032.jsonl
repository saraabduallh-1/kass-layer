{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/989b809d-4ffd-4925-b822-7c97222ecf85/get-public-entry"},"browse_index_record":{"lexicalEntryId":"989b809d-4ffd-4925-b822-7c97222ecf85","word":"النَّظَرِيَّةُ الاِسْمِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b974c","lexicalEntryId":"989b809d-4ffd-4925-b822-7c97222ecf85","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّظَرِيَّةُ الاِسْمِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويةٌ عامّةٌ، تُسمّى أيضا الاصطِلاحِيةَ conventionalism، كما تُسمّى المذهبَ الاسميَّ، يَرى أصحابُها أن الكلماتِ لا تَرتبِط ارتِباطًا طبيعيًّا بما تَدُلُّ عليه، وإنما هي مجرَّدُ اصطلاحٍ اعتِباطيٍّ. هذه النظريةُ هي السائدةُ في الدراسات اللغويةِ الحديثة، تُقابِلها النظريةُ الطبيعيةُ. راجع:  @(naturalism) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظرية الاسمية ","nonDiacriticsLemma":"النظرية الاسمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّظَرِيَّةُ الاِسْمِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

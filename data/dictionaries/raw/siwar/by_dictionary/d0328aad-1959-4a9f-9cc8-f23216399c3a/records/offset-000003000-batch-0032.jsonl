{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/95f41139-fd27-4138-9262-6252a412a3eb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"95f41139-fd27-4138-9262-6252a412a3eb","word":"المَذْهَبُ الطَّبِيعِيُّ الفِطْرِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9746","lexicalEntryId":"95f41139-fd27-4138-9262-6252a412a3eb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَذْهَبُ الطَّبِيعِيُّ الفِطْرِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ لغويٌّ نفسيٌّ، يرى أن القُدرةَ على اكتساب اللغةِ فِطرَةٌ بَشَريةٌ مَوجودةٌ لدى كلِّ طفلٍ منذ وِلادَتِه، وأن هذه القُدرةَ الفِطريةَ مُتشابهةٌ لدى الأطفالِ على اختلاف ثقافاتِهم وتَبايُنِ لغاتِهم الأمّ. هذا المذهبُ، الذي يَنطَلِق من نظرية القواعدِ الكُلِّيَّة أو الكلِّياتِ اللغوية، مُخالِفٌ لما يراه السلوكيون من أن بيئةَ الطفلِ وحدَها هي التي تُشكِّل لغتَه حيث يَكتَسب هذه اللغةَ بالمحاكاة والتقليدِ والتعزيزِ فقط","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المذهب الطبيعي الفطري ","nonDiacriticsLemma":"المذهب الطبيعي الفطري","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَذْهَبُ الطَّبِيعِيُّ الفِطْرِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/57fefb3b-de1b-4dc6-b401-27c8543ee1f8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"57fefb3b-de1b-4dc6-b401-27c8543ee1f8","word":"لُغَةٌ طَبِيعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9747","lexicalEntryId":"57fefb3b-de1b-4dc6-b401-27c8543ee1f8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ طَبِيعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ بَشريةٌ يَتحدَّثُ بها مجتَمَعٌ ما لغةً أمًّا أو لغةً أولى، خلافا للُّغَة الهَجِينِ pidgin language التي ليسَت لغةً أمًّا لأحَدٍ من مستَعمِليها، ولِلُغة الإشارَةِ للصُمِّ sign language، وخلافا أيضا للُّغات المصطَنَعةِ artificial languages التي تُصنَع لتسهيل التواصُلِ بين البَشَر، كالإسبِرانتو والأوكسِيدنتال ولغةِ البحّارَة ولغةِ الملاحَةِ الجَوِيَّة، أو تُصنَع للأغراض العِلمية، كلُغة المنطِقِ ولغةِ الرياضياتِ ولغةِ البرمَجَةِ الحاسوبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مَفهومٌ تخَيُّليٌّ أو مثاليٌّ لما يمكن أن يكون عليه نظامُ لغةٍ ما، طبيعيةٍ أو مصطَنَعَةٍ، بحيث تكون العلاقةُ بين جميعِ كلماتِها ومعاني تلك الكلماتِ نظاميّةً غيرَ اعتِباطية، وهذا أمرٌ غيرُ مُمكِن. مثالُ ذلك أن يُفتَرَض أن أيَّ كلمةٍ تدُلّ على حيوان تَبدأ بالصوت: /b/، وأن أيَّ كلمةٍ تدُلّ على طير تَبدأ بالصوت: /d/، وأن أيِّ كلمةٍ تدُل على شَجَرٍ تَبدأ بالصوت: /s/، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة طبيعية ","nonDiacriticsLemma":"لغة طبيعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ طَبِيعِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0266e657-3925-4f8a-918f-9e53b2d5ed9c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0266e657-3925-4f8a-918f-9e53b2d5ed9c","word":"لَفْظٌ مُوَلَّدٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9740","lexicalEntryId":"0266e657-3925-4f8a-918f-9e53b2d5ed9c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لَفْظٌ مُوَلَّدٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ معجميٌّ، يُقصَد به أيُّ كلمةٍ أو تَعبيرٍ دخَل اللغةَ حديثا، أو استُحدِث بطريقَة النَّحت، وهو مُقتَرَضٌ من المصطلَح الفَرنسيِّ المبنيّ على عَناصِرَ يونانية. وهو ظاهرَةٌ لغويةٌ مَعروفةٌ في جميع اللغات، لكنّ اللغاتِ تتَفاوَت في سُرعَة قَبولِها للَّفظ الجَديد، وطريقَةِ معامَلَتِه. وفي عصرنا الحاضِرِ كَثُر دُخولُ الألفاظِ المحدَثَةِ في اللغات كثرَةً لم تُعهَد من قبل؛ نتيجةَ النُّموِّ التّقنيِّ، وتَطوُّرِ أنظمةِ الاتصالِ الحديثة؛ فدخَلَت ألفاظٌ مثل: null hypothesis, software, floppy disk, internet, website، وتُرجِمَت إلى معظَم لغاتِ العالَم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لفظ مولد ","nonDiacriticsLemma":"لفظ مولد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لَفْظٌ مُوَلَّدٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/39e44c30-c70f-4429-bd07-620b81f8344d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"39e44c30-c70f-4429-bd07-620b81f8344d","word":"انْتِقَالُ أَثَرِ التَّدْرِيبِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0e1","lexicalEntryId":"39e44c30-c70f-4429-bd07-620b81f8344d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"انْتِقَالُ أَثَرِ التَّدْرِيبِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ أسبابِ وُقوعِ متعلِّمِ اللغةِ الأجنبيةِ في الخَطأ، ويُقصَد به نَقلُ ما تَدَرَّب عليه متعلِّمُ اللغةِ في نَمَطٍ لُغويٍّ إلى نَمَط آخَرَ حتى يَقَع في الخَطأ، خاصةً إذا أفرَط في التَّدَرُّب على النَّمَط السابِق. مثالُ ذلك أن يَقلِب متعلِّمُ العربيةِ الهَمزَةَ عَينا نَتيجةَ فرْطِ التَّدَرُّبِ على النُّطق الصحيحِ للعَين. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في طريقَة الاستِجابةِ الجَسَديَّةِ الكامِلَةِ TPR في تعليم اللغة، يُقصَد به انتِقالُ أَثَرِ التَّدريبِ في مَهارَة معيَّنَةٍ إلى مَهارَة أو مَهاراتٍ أخرى. فإتقانُ مَهارَةِ القراءةِ يَضمَن - في نَظَر أصحابِ هذه الطريقةِ - إتقانَ المهاراتِ الأخرى؛ كفَهم المسموع، والكلام، والكتابة، كما أن فَهمَ المسموعِ يؤدِّي إلى إتقان الكلام. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"انتقال أثر التدريب ","nonDiacriticsLemma":"انتقال أثر التدريب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"انْتِقَالُ أَثَرِ التَّدْرِيبِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/374e945d-169f-4a7a-905c-1b8fa858b53b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"374e945d-169f-4a7a-905c-1b8fa858b53b","word":"قَوَاعِدُ تَحْوِيلِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba0e2","lexicalEntryId":"374e945d-169f-4a7a-905c-1b8fa858b53b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَوَاعِدُ تَحْوِيلِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قواعدُ تُطبَّق في النحو التحويليِّ التوليديِّ على السِلسِلَة النِّهائيةِ الناتِجَةِ عن تَطبيق قواعدِ البِنيَةِ شبهِ الجُمَلية، وذلك بعَمَلياتٍ مختَلِفةٍ كالزيادَة والحَذفِ والتغييرِ والاستِبدال. تَطوَّرَت هذه القواعدُ عما كانت عليه في بدايَة ظُهُورِ القواعدِ التحويليةِ التوليدية، وأُدخِلَت عليها تعديلاتٌ وإضافات. والقواعدُ التحويليةُ هذه تقَع ضِمنَ أربعَةِ أنماطٍ من القوانين في النحو التحويليِّ التوليدي، هي: القوانينُ الأساسُ basic rules، وقوانينُ المفرداتِ lexical rules، والقوانينُ التحويليةُ، والقوانينُ الصوتيةُ الصرفيةُ morphophonemic rules.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قواعد تحويلية ","nonDiacriticsLemma":"قواعد تحويلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَوَاعِدُ تَحْوِيلِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ae1a3cf4-18d8-48a0-a035-e459be244482/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ae1a3cf4-18d8-48a0-a035-e459be244482","word":"اللِّسَانِيّاتُ الوَظِيفِيَّةُ النِّظَامِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f33","lexicalEntryId":"ae1a3cf4-18d8-48a0-a035-e459be244482","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللِّسَانِيّاتُ الوَظِيفِيَّةُ النِّظَامِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ أو منهَجٌ لغويٌّ وَظيفيٌّ طوَّرَه مايكل هاليداي Michael Halliday، يرَى أن اللغةَ نظامٌ رَمزيٌّ اجتماعيٌّ، وجُزءٌ من السّياق الاجتماعيِّ الواسِع، وأن القواعدَ مِفتاحٌ المعنى وحَسب. أثَّرَ هذا المنهَجُ في تعليم اللغاتِ الأمِّ والثانية ولاسيّما في المملكة المتحدة، فضلا عن تأثيره في مناهِج البَحثِ اللغويِّ عامَّة، ومناهجِ تحليلِ الخِطابِ خاصَّة. راجع:  @(systemic functional grammar) و  @(systemic grammar) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللسانيات الوظيفية النظامية ","nonDiacriticsLemma":"اللسانيات الوظيفية النظامية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللِّسَانِيّاتُ الوَظِيفِيَّةُ النِّظَامِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e1b02d67-2de9-4438-a4b2-44648e7a5145/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e1b02d67-2de9-4438-a4b2-44648e7a5145","word":"عِلْمُ اللُّغَةِ النِّظَامِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f34","lexicalEntryId":"e1b02d67-2de9-4438-a4b2-44648e7a5145","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ النِّظَامِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللِّسانياتُ النظاميةُ، وهي مذهَبٌ لُغَويٌّ طَوَّرَه مايكل هاليداي Michael Halliday على أساس من النظرية الوَظيفيةِ Functionalism عند جون فيرث John Firth. يَنظُر هذا المذهَبُ إلى اللغة في سِياقها الاجتِماعيّ، ويَنطَلِق من نظرية وَظيفيةٍ لا شَكلِية؛ إذ يَرَى أن اللغةَ أداةٌ للتَّواصُل الاجتماعيِّ وليسَت مجموعةً من القواعد، فهو يَنظُر إلى اللغة نَظرَةً أوسَعَ من نَظرَة المذاهِبِ اللغويةِ الأخرى، ويَهتَم بالمعنى ويَربطه بجَميع مُكوِّناتِ اللغةِ من أصوات وكلماتٍ وتراكيب، ويؤكِّد أن المعنى هو الهَدَفُ وأن الجَوَانبَ اللغويةَ الشَّكليةَ وَسيلةٌ لخِدمَته. راجع:  @(systemic grammar) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة النظامي ","nonDiacriticsLemma":"علم اللغة النظامي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ النِّظَامِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"au
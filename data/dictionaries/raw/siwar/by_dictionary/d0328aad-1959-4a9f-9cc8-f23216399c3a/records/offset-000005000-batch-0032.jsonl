{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/09178009-1073-4fdd-9d46-f5c28e20e697/get-public-entry"},"browse_index_record":{"lexicalEntryId":"09178009-1073-4fdd-9d46-f5c28e20e697","word":"تَولِيفٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f3d","lexicalEntryId":"09178009-1073-4fdd-9d46-f5c28e20e697","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَولِيفٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"جَمْعُ العَناصِرِ اللغويةِ لتَكوِين الكلام، أو جَمْعُ عُنصُرَين لغَويَّين من مستوًى واحدٍ لتَكوِين وَحدةٍ جَديدة، مثلُ جَمعِ مورفيمَين أو أكثَرَ لتَكوِين كلمةٍ مركَّبة، أو ضَمِّ كلمَتَين أو أكثَرَ لتَكوِين جُملَة. هذا التركيبُ أو التوليفُ يكون طبيعيًّا حين يَقوم به الإنسانُ، ويكون آلِيًّا حين يقوم به برنامَجٌ حاسوبيٌّ، كما في تأليف الكلام. والتركيبُ أو التأليفُ يُقابِله التَّحليلُ analysis. راجع:  @(speech synthesis) و  @(synthetic speech) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"إحدى المراحِلِ الأساسيةِ الثلاثِ التي تتَطلَّبها الترجَمةُ، وتتمَثَّل في إعادَة بناءِ النَّصِّ في اللغة الهدَف، بعد إخضاعِة لعمَلِيَّتَيْ التَّحليلِ والتَّحويل. راجع:  @(restructuring) و  @(transfer) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"توليف ","nonDiacriticsLemma":"توليف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَولِيفٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7c946cf1-3f33-4359-ac25-42f37e3b397f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7c946cf1-3f33-4359-ac25-42f37e3b397f","word":"كَلامٌ تَرْكِيبِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f3e","lexicalEntryId":"7c946cf1-3f33-4359-ac25-42f37e3b397f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كَلامٌ تَرْكِيبِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، يُشير إلى تركيب الكلامِ وإنتاجِه بطريقَةٍ آليَّةٍ مُصطَنَعَة، ويُسمّى النظامُ الحاسوبيُّ الذي يقوم بهذه المهمَّةِ بمركِّب الكلامِ speech synthesizer، كما تُسمّى العمَليةُ نفسُها بتركيب الكلامِ أو تأليفِ الكلامِ syntactic speech. ويَستَخدِم هذا الأسلوبَ من لا يستطيع الكلامَ بطريقَةٍ طبيعة؛ فيكتُب ما يريد التعبيرَ عنه على لوحَة المفاتيح، ثم يقوم البرنامجُ الحاسوبيُ المخصَّصُ لهذا الغرَض بتركيب الكلماتِ في جُمَلٍ صحيحة. بدأ إنتاجُ الأصواتِ الاصطناعيةِ قبلَ عدَّةِ عُقُودٍ في عدَدٍ من الجامعات الأمريكيةِ والبريطانيةِ على هيئة مَشروعاتٍ بحثيةٍ تُجرَى في أقسام الأصواتِ وفي مختَبراتٍ صوتيةٍ تقليديةٍ باستعمال آلاتِ إنتاجِ الأصواتِ الصناعيةِ synthetic speech devices، أهمُّها جهازُ الكلامِ الآلِيِّ البراميتريِّ The parametric artificial talking device، ثم طُوِّرَت الفِكرَةُ إلى برامِجَ لغويةٍ حاسوبيةٍ أصبحَت أكثَرَ دقَّةً في التصميم، ووُضوحًا في الصوت، وسُرعَةً في الأداء. راجع:  @(speech synthesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كلام تركيبي ","nonDiacriticsLemma":"كلام تركيبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كَلامٌ تَرْكِيبِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/33fdf693-2f7d-40bf-909c-64c3e3efc442/get-public-entry"},"browse_index_record":{"lexicalEntryId":"33fdf693-2f7d-40bf-909c-64c3e3efc442","word":"خَطَأٌ مُنْتَظِمٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f3f","lexicalEntryId":"33fdf693-2f7d-40bf-909c-64c3e3efc442","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"خَطَأٌ مُنْتَظِمٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ للخَطأ اللغويِّ الذي يَقَع فيه مُعظمُ متعلِّمي اللغات الثانيةِ والأجنبية، ويُمثِّل مرحَلةً من مَراحِل اكتساب اللغةِ الهَدَف، وقد يَنِمُّ عن صُعوبةٍ مَرحَلِيَّةٍ ناتِجَةٍ عن تَأثير اللغةِ الأمِّ أو اللغةِ الهَدَفِ، أو ناتِجةٍ عن صُعوبَةٍ في اللغة الهَدَف أو في جُزءٍ منها. هذا الخَطأُ هو الذي يُمكِن تَحليلُه وتَفسيرُه وعِلاجُه، خِلافا للخَطأ غيرِ المنتَظِم، الذي يَحدُث لأسبابٍ عارِضَةٍ، من سَهْوٍ أو مَرَضٍ أو تَعَبٍ أو عَدَمِ اهتِمام. راجع:  @(slip of the tongue) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"خطأ منتظم ","nonDiacriticsLemma":"خطأ منتظم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"خَطَأٌ مُنْتَظِمٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

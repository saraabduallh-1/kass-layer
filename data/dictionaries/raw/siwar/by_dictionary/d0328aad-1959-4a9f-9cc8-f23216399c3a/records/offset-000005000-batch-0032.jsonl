{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d1f3ac53-04a8-48b0-bd0e-a5402ce8920e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d1f3ac53-04a8-48b0-bd0e-a5402ce8920e","word":"مِلْمَاحٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f35","lexicalEntryId":"d1f3ac53-04a8-48b0-bd0e-a5402ce8920e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مِلْمَاحٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"آلَةٌ تُعرَض بواسِطَتها الحُروفُ أو الكلماتُ أو الجُملُ المتعاقِبةُ عَرضا سَريعا، ثم تُزال ويُطلَب من الناظِرين إليها أن يَذكروا الحُروفَ أو الكلماتِ أو الجُملَ التي رأوها. تُستَعمَل هذه الآلَةُ لقِياس الإدراكِ البَصَريِّ في أثناء القراءة، وتَحديدِ سُرعتها، عند تدريس القراءةِ، أو لأغراض البَحثِ فيها أو في تَدريسها. وقد حلَّت محلَّ المبصارِ أو الملماحِ التقليديِّ برامجُ حاسوبيّةٌ تَعرِض النصوصَ القرائيةَ المستَهدَفةَ بطريقَةٍ سَريعةٍ ودَقيقة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"ملماح ","nonDiacriticsLemma":"ملماح","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مِلْمَاحٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8eafdb8b-0c8f-4f11-b669-c90a3cd0a37b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8eafdb8b-0c8f-4f11-b669-c90a3cd0a37b","word":"تَوْجِيهٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9f37","lexicalEntryId":"8eafdb8b-0c8f-4f11-b669-c90a3cd0a37b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوْجِيهٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ تعليميٌّ، يَعني مُراقَبةَ الموَجِّهِ أو المشرفِ لأداءِ المعلِّمِ وتَوجيهَه وتقيِيمَه. يختَلِف المربُّون في وَظيفة المشرفِ أو الموَجِّه؛ فيَرَى فريقٌ منهم أن وَظيفتَه الأساسَ هي تَقييمُ أداءِ المعلِّم، والتأكُّدُ من التِزامه بالسُّلوك التعليميِّ المطلوب، وتَنبِيهُه إلى ما يُخالِف ذلك. ويرى فريقٌ آخَرُ أن وَظيفتَه هي تقديمُ النُّصحِ للمعلِّم والتوجيههُ وإرشادُه، ومساعدتُه في تَنمِية مَهاراتِه التَّدريسيةِ وحَلِّ مُشكلاتِه من خلال المناقَشَةِ والإقناعِ والمراقَبَةِ الذَّاتية. وهذا الرأيُ هو المطبَّقُ حاليًّا في معظم برامجِ التعليم، حيث حَلَّ الإشرافُ أو التوجيهُ والمشرف أو الموجِّهُ محلَّ التَّفتيشِ والمفَتِّش.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"توجيه ","nonDiacriticsLemma":"توجيه","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَوْجِيهٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0
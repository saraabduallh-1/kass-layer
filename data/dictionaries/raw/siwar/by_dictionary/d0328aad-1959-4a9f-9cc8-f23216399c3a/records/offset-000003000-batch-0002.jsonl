{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/997cfad5-4405-4f18-a7ef-475ca642091b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"997cfad5-4405-4f18-a7ef-475ca642091b","word":"لُغَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9440","lexicalEntryId":"997cfad5-4405-4f18-a7ef-475ca642091b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"لغةٌ خاصَّةٌ أو لغةٌ مُعَيَّنةٌ، تُعَرَّف بأنها: نظامٌ من الرُّموز الصوتيةِ والصوَرِ اللَّفظِيةِ المخزونَةِ في أذهان الناطقين بها للتَّفاهُم فيما بينهم، وفقَ نظامٍ اجتماعيٍّ متَّفَقٍ عليه بين أفرادِ الجَماعة. وهذه اللغةُ يَكتَسِبُها الإنسانُ في مجتَمَعه، وتُسمَّى لغتَه الأمَّ أو لغتَه الأولى؛ كالعربية والإنجليزيةِ والأُرديةِ واليابانيةِ والصِّينية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"اللغةُ الإنسانيةُ العامَّةُ: وهي القُدرَةُ الفِطرِيةُ الكامِنَةُ في عَقل كلِّ إنسانٍ منذ ولادَتِه. هذه اللغةُ مُتشابِهَةٌ لدى جميعِ الناسِ في قواعدها البِنيَويةِ وقوانينِها الاجتماعية، وفي نَشأتها ونُمُوِّها وطريقَةِ اكتِسابِها، وهي موضوعُ الدراسةِ في علم اللغةِ بجميع فُروعِه ومجالاتِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"لُغةٌ غَيرُ إنسانيةٍ: وتَشمَل أيَّ وَسيلةٍ للتفاهُم بين مجموعَةٍ من المخلوقات؛ كلغةِ النَّحْل، ولغةِ الطَّير، ولغةِ الحيَوان، وقد يَشمَل هذا المفهومُ اللغاتِ الاصطِناعِيَّة artificial languages.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"لغة ","nonDiacriticsLemma":"لغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/779d549a-b246-4d22-ab6b-3e64f620c727/get-public-entry"},"browse_index_record":{"lexicalEntryId":"779d549a-b246-4d22-ab6b-3e64f620c727","word":"اكْتِسَابُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9441","lexicalEntryId":"779d549a-b246-4d22-ab6b-3e64f620c727","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اكْتِسَابُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نُمُوُّ اللغةِ الأمِّ لدى الطفلِ بشَكلٍ طبعيٍّ في المراحِل المبكِّرةِ من عُمُره، وهو اكتِسابُ اللغةِ الأمِّ first language acquisition. وكذلك نُمُوُّ اللغةِ الثانيةِ لدى الأجنَبيِّ بشَكلٍ طبعيٍّ أو شِبهِ طبعيٍّ من حيث تلَقِّي اللغةِ الهَدَفِ واستعمالُها واكتِمالُها، خلافا لتعلُّم اللغةِ الأجنَبيةِ foreign language learning الذي يَعتَمِد فيه المتعلِّمُ اعتمادًا كُلِّيًّا على موادَّ تعليميةٍ مَصنوعَةٍ لأغراضٍ تَعليمِية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"فَرعٌ مُهمٌّ من فُروع علمِ اللغة؛ بَرَز في النِّصف الثاني من القرن العشرين، واعتَمَد على عَدَدٍ من الدراساتِ في علم اللغةِ التطبيقيِّ، وعلمِ اللغةِ النفسيِّ، وعلمِ اللغةِ الاجتماعيِّ، وعلمِ النفس. يَهدِف إلى فَهم العَمَلياتِ والمراحِلِ التي يَمُرُّ بها الإنسانُ في اكتسابه اللغةَ الأمَّ واللغةَ الثانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اكتساب اللغة ","nonDiacriticsLemma":"اكتساب اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اكْتِسَابُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

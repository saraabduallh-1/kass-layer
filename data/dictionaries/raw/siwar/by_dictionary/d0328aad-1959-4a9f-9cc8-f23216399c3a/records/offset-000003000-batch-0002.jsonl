{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/597ffcd3-102e-456c-a6cf-eb32ac63bff6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"597ffcd3-102e-456c-a6cf-eb32ac63bff6","word":"عَجْزٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9444","lexicalEntryId":"597ffcd3-102e-456c-a6cf-eb32ac63bff6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَجْزٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُطلَق على العَجْز اللغويِّ الوَظيفيِّ العامِّ لدى المرء؛ بسبَب خَلَلٍ في مناطِق اللغةِ في الدِّماغ. ويُفَرِّق بعضُ اللغويين النفسيّين بين العَجزِ اللغويِّ بهذا المعنى وعُيوبِ النُّطقِ أو عُيوبِ الكلامِ speech defects، التي تؤثِّر في عُضوٍ من أعضاء النُّطق، وتظهَر في نوعٍ خاصٍّ من صُعوبات النُّطقِ ومشكلاتِ الكلام. فالعَجزُ اللغويُّ بهذا المفهومِ العامِّ قريبٌ من مَفهوم الحُبْسَةِ اللغويةِ aphasia، أو هو أنواعٌ مجتَمِعَةٌ من هذه الحُبْسَة. راجع:  @(aphasia) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عجز لغوي ","nonDiacriticsLemma":"عجز لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَجْزٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1aa9fa3e-9144-4c78-8e71-6d5e87f4aeb9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1aa9fa3e-9144-4c78-8e71-6d5e87f4aeb9","word":"سِجِلٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9445","lexicalEntryId":"1aa9fa3e-9144-4c78-8e71-6d5e87f4aeb9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سِجِلٌّ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"نوعٌ من الكِتابة التي يُدَوِّنها الطالبُ يوميًّا في كرّاسّةٍ خاصَّة، تُسمّى أيضا صَحيفةَ الطالب، تتضمَّن أفكارَه ومشاعِرَه وبعضَ الجوانبِ المعرِفيةِ في شخصِيته، ولا ترتَبط بموضوعٍ محَدَّد. وفي مرحَلة تعلُّمِ اللغةِ الثانية، يُشجِّع المعلِّمُ طلابَه على كتابة هذه المدوَّنات، دونَ تَدقيقٍ في الصِّحَة اللغويةِ لهذه الكِتابة؛ بهَدَف تدريبِهم على الكتابة، ومراجَعَةِ نُمُوِّهِم اللغويِّ فيما بعد. وقد تكون مُفكِّرَةً للمعلِّم يَستَعين بها في تقيِيم أدائه، أو تقيِيمِ طُلّابِه. راجع:  @(learning log) و  @(teaching journal) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"سجل ","nonDiacriticsLemma":"سجل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سِجِلٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

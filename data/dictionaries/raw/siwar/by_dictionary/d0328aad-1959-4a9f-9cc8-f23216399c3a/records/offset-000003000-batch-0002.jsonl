{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fbf34ee9-ac37-4292-bc02-321dad1cc70e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fbf34ee9-ac37-4292-bc02-321dad1cc70e","word":"النُّمُوُّ اللُّغَوِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9451","lexicalEntryId":"fbf34ee9-ac37-4292-bc02-321dad1cc70e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النُّمُوُّ اللُّغَوِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يَعني نُمُوَّ لغةِ الطفلِ والمراحِلَ اللغويةَ التي يَمُرُّ بها منذُ وِلادَتِه حتى اكتِمال لغَتِه الأساسيةِ قُبَيل دُخولِه المدرسة. هذا النموُّ يَسير وفقَ تدَرُّجٍ طبيعيٍّ منتَظمٍ في الأصوات والصرفِ والنحوِ والمفرَداتِ والدَّلالة، ومتَشابهٍ لدى جميعِ أطفالِ العالَمِ مهما اختَلَفَت لغاتُهم وتباعَدَت بيئاتُهم. ويُطلَق مصطلح النُّمُوّ اللغويّ أيضا على اللغة المرحَليّةِ لمتعلِّمي اللغاتِ الثانيةِ والأجنبيةِ interlanguage من الصِّغار والكِبار، وهو أيضا نُمُوٌّ منتَظِمٌ يَسير وفقَ مراحِلَ متَشابِهَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النمو اللغوي ","nonDiacriticsLemma":"النمو اللغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النُّمُوُّ اللُّغَوِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/23d5945f-c0d7-4d69-9fbc-229c98f73420/get-public-entry"},"browse_index_record":{"lexicalEntryId":"23d5945f-c0d7-4d69-9fbc-229c98f73420","word":"اخْتِبَارُ الاِسْتِعْدَادِ اللُّغَوِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b944e","lexicalEntryId":"23d5945f-c0d7-4d69-9fbc-229c98f73420","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِبَارُ الاِسْتِعْدَادِ اللُّغَوِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اختبارٌ يَقيسُ مدى استعدادِ المتعلِّمِ لتعلُّم لغةٍ ثانيةٍ أو أجنَبية، ويُساعِد في التَّنَبُّؤِ بمستوى التقَدُّمِ الذي يمكن أن يُحَقِّقَه المتعلِّمُ مستَقبَلًا في المدَّة المقرَّرةِ لتعلُّمها قبلَ أن يَشرَع في تعلُّمها، ومن أمثِلَته: Modern Language Aptitude Test (MLAT). ويَشمَل الاختبارُ قياسَ جوانبَ مَعرِفيةٍ فِطريةٍ ونَفسيةٍ واجتماعية. ولصُعوبة قِياسِ هذه الجوانب، وتدَخُّلِ عوامِلَ أخرى خارجيةٍ غيرها؛ شَكَّ بعضُ الباحثين في جدوَى هذا الاختبار، وحَصَرَه آخَرون بأنه الوَقت الذي يحتاج  إليه الإنسانُ لتعلُّم اللغة، أي إن الفُروقَ بين الناسِ في الاستِعداد لتعلُّمِ اللغةِ تَعنِي الاختلافَ بينهم في الوَقت الذي يَحتاجه كلُّ واحدٍ منهم لتعلُّم اللغة. بل إن الدراساتِ التي أُجرِيَت في الاستعداد اللغويِّ لم تَكشِف عن مَوهِبَةٍ واحدةٍ يمكن تَسميَتُها بالاستعداد اللغويِّ أو الموهِبةِ اللغويةِ (الفِطرية) التي يمكن أن يَنفَرِد بها أشخاصٌ دونَ غيرِهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار الاستعداد اللغوي ","nonDiacriticsLemma":"اختبار الاستعداد اللغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِبَارُ الاِسْتِعْدَادِ اللُّغَوِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

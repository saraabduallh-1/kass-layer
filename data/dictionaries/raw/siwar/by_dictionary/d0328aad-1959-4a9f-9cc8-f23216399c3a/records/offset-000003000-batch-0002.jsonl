{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a0936d49-efe0-436e-b21d-a50710420e24/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a0936d49-efe0-436e-b21d-a50710420e24","word":"الأَلْعَابُ اللُّغَوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9454","lexicalEntryId":"a0936d49-efe0-436e-b21d-a50710420e24","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الأَلْعَابُ اللُّغَوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي الألعابُ التي تُستَخدَم وَسائلَ لتَيسير تعلُّمِ اللغةِ الهَدَفِ وتعليمِها، سواء أكانت أنشِطةً ترفيهِيةً أم وَسائلَ تعليمية، في داخِل الفَصلِ أو خارجَه. وهي أنواعٌ كثيرة، منها: ألعابُ المهاراتِ اللغوية، وألعابُ الاتصال، والألعابُ الجَماعيةُ. وتُستَخدَم فيها الأشياءُ الحقيقيةُ والصُّورُ والمكعَّباتُ والألغازُ والمتاهاتُ والمسابَقاتُ ونحوُها، ومعظَمُ هذه الألعابِ تحوَّلَت إلى ألعابٍ إليكترونيةِ حاسوبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الألعاب اللغوية ","nonDiacriticsLemma":"الألعاب اللغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الأَلْعَابُ اللُّغَوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

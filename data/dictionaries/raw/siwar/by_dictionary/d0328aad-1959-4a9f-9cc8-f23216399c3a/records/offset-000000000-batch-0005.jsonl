{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4b4f911e-4303-4837-991a-4968d01564a6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4b4f911e-4303-4837-991a-4968d01564a6","word":"بَحْثٌ إجرائيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b88cf","lexicalEntryId":"4b4f911e-4303-4837-991a-4968d01564a6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بَحْثٌ إجرائيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"البحثُ الذي يَهدف إلى إيجاد حَلٍّ لمشكلاتٍ محدَّدَة، أو يَسعى إلى تَغيِير سُلوكٍ اجتماعيٍّ أو نشاط. ويُقارَن عادةً بالبحث الأساسِ basic research الذي يَهدف إلى بناءِ نظريةٍ جديدَةٍ، أو تأييدِ نظريةٍ قائمَةٍ، أو دَحضِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"البحثُ الذي يُجريه المعلِّمُ داخِلَ حُجرَةِ الصَّفِّ؛ لرَفع مستَوى أدائه في التدريس، أو لفَهم سُلوكِ طلابِه، أو للتأكُّد من فائدةِ طريقةٍ أو إجراءٍ أو نَشاطٍ داخِلَ الفَصلِ أو خارِجَه. وقد أصبح هذا البحثُ رافِدا للعمَلية التعليميةِ، ومُهمًّا في تحسين عمَليةِ التعلُّمِ والتعليم، لاسيَّما في حَقل تعليمِ اللغات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"بحث إجرائي ","nonDiacriticsLemma":"بحث إجرائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بَحْثٌ إجرائيٌّ"}],"lemmaLanguage":{"code":"ar","lab
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/165eac4d-c8ea-4ac0-9fe9-c46524e3d26c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"165eac4d-c8ea-4ac0-9fe9-c46524e3d26c","word":"سُهُولَةُ الوُصولِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b88cc","lexicalEntryId":"165eac4d-c8ea-4ac0-9fe9-c46524e3d26c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سُهُولَةُ الوُصولِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُقصَد به سُهولَةُ حُصولِ المتكلِّمِ على الكلمة الصَّحيحةِ واستِدعائها من الذاكرَة حين يحتاج إليها. وتَتَميَّز بعضُ كلماتِ اللغةِ بسُهولَة الاستِذكارِ والاستِدعاءِ، ما يُيَسِّر استعمالَها في الكلام والكتابة، في حين يَصعُب ذلك في بعض الكلماتِ حتى إنها لا تَصلح إلا في الفَهم.    ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":" مصطلحٌ لغويٌّ تعليميٌّ، يُقصَد به توفيرُ المدرسةِ أو المعهدِ جميعَ مصادِرِ التعلُّم التي يمكن أن يستَخدِمها الطالبُ ليُثريَ حَصيلتَه اللغويةَ بما يتَّفِق مع قُدراته اللغوية، وسُرعتِه في التعلُّم، والوَقتِ الذي يُناسِبه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في تقنيّات تعليمِ اللغات، يُقصَد به إمكانيَّةُ الدُّخولِ إلى المعلومَة اللغويةِ المطلوبَةِ والحُصُولِ عليها من شَريطٍ أو نظامٍ حاسوبيٍّ أو قواعد معلومات. وهذه الإمكانيَّةُ قد تكون تَسَلسُلِيَّةً sequence access، كما في البحث عن المعلومة المسجَّلَةِ على شَريط كاسِيت، الذي يتطلَّب استِعراضَ الشَّريطِ من أوَّلِه. وقد تكون الإمكانيةُ مباشِرةً direct access أو عَشوائيةً random access؛ كالمعلومة المخزَّنَةِ في الحاسوب، أو في قُرصٍ مُدمَج، خاصةً في برامج تعلُّمِ اللغةِ بمساعَدَة الحاسوب CALL. راجع:  @(direct access) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"سهولة الوصول ","nonDiacriticsLemma":"سهولة الوصول","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سُهُولَةُ الوُصولِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

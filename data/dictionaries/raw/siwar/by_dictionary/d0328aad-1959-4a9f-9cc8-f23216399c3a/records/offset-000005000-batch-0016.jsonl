utoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1a3b2762-1aac-4a49-8a5f-6510556ac7b2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1a3b2762-1aac-4a49-8a5f-6510556ac7b2","word":"زَلَّةُ اللِّسَانِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d97","lexicalEntryId":"1a3b2762-1aac-4a49-8a5f-6510556ac7b2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"زَلَّةُ اللِّسَانِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":" الخَطَأُ اللغويُّ الذي يَقَع فيه متعلِّمُ اللغةِ لسَبَبٍ عارِضٍ من تَعَبٍ أو مَرَضٍ أو تَساهُل، ولا يَنِمُّ عن نَقصٍ في كِفايَته اللغوية. يُفرِّق اللغويون بين زَلَّةِ اللسانِ هذه والخَطأِ error الذي يَنِمُّ عن نَقصٍ في الكِفايَة اللغويّةِ لدى المتعلِّم؛ فالأوَّلُ عارِضٌ نادِر، والثاني منتَظِمٌ متَكَرِّرٌ يمثِّل مرحَلَةً في النُّمُو اللغوي. يُخَصِّص بعضُ اللغويّين زَلَّةَ اللِّسانِ بنَوعٍ من الأخطاء كقَول القائل: حَبْسُ الخَشَبِ، بدَلاً من: خَشَبُ الحَبْسِ، ومثلُه: chapel harlot، بدَلًا من: apple charlotte، وهو قريبٌ مما يُسمِّيه بعضُ علماءِ النَّفسِ سَبْقَ الدِّماغِ slip of the brain","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"زلة اللسان ","nonDiacriticsLemma":"زلة اللسان","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"زَلَّةُ اللِّسَانِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

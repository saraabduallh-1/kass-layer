{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/23654aec-f2a6-4ef8-83d4-a9d94c22fef7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"23654aec-f2a6-4ef8-83d4-a9d94c22fef7","word":"التَّفَاعُلُ الاجْتِمَاعِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dad","lexicalEntryId":"23654aec-f2a6-4ef8-83d4-a9d94c22fef7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّفَاعُلُ الاجْتِمَاعِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغات، يُقصَد به مدَى تفاعُلِ متعلِّمِ اللغةِ الثانيةِ مع أفراد مجتَمَعِها، وما يُشتَرَط لهذا التفاعُلِ من نَوع الحديثِ وطبيعَتِه ومَوضوعاتِه المناسبةِ لكلِّ مستوى لغويٍّ أو مَوقِفٍ اجتماعيٍّ أو مقام. ولكي يؤدِّيَ التفاعُلُ الاجتماعيُّ وَظيفَتَه ويَقودَ إلى الاكتِساب الحقيقيِّ للغة، فإن الحديثَ مع الكِبار يجب أن تختَلِف موضوعاتُه ومستَويَاتُه عن الحديث مع الصِّغار أو المراهِقين، وإن الحديثَ مع أهل مِهنَةٍ أو طبَقَةٍ اجتماعيّةٍ معيَّنةٍ يجب أن يكون مناسِبًا لها وضِمنَ اهتِماماتِها. ولا تقتصر أهميّةُ التفاعُلِ الاجتماعيِّ على متعلِّمي اللغاتِ الثانيةِ والأجنبية، وإنما تَشمَل أيضا اكتسابَ الطفلِ لغَتَه الأمَّ، وتَزداد هذه الأهميَّةُ في اكتِساب المفاهيمِ التَّداوُليّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التفاعل الاجتماعي ","nonDiacriticsLemma":"التفاعل الاجتماعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّفَاعُلُ الاجْتِمَاعِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

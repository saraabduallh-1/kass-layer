{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/05c19529-308b-445c-a689-8eb355dbc6b2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"05c19529-308b-445c-a689-8eb355dbc6b2","word":"الطَّرِيقَةُ الصَّامِتَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d9d","lexicalEntryId":"05c19529-308b-445c-a689-8eb355dbc6b2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطَّرِيقَةُ الصَّامِتَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"طريقَةٌ طَوَّرَها كاليب غاتينو Caleb Gattegno عام 1963م، لتَدريس اللغاتِ الأجنبيةِ خارِجَ بيئاتِها. تَبدأ بمرحَلةٍ صامِتَةٍ لا يتكلَّم فيها المعلِّمُ بكلمةٍ واحدة، لكنه يَستَعمِل الإشاراتِ والحَرَكاتِ التَّمثِيلِيّةَ الصَّامِتَةَ، والمعِيناتِ البَصَرِيَّةَ، والرُّسومَ الحائطِيَّةَ، والعِصِيَّ ذاتَ الألوانِ المختَلِفة؛ بهدَف مساعَدَةِ الطلابِ على الكلام. تَعتَمِد الطريقةُ على تَشجيع الطلابِ على استِعمال اللغةِ الهَدَفِ في الفَهم والكلامِ استِعمالًا سِياقِيًّا مَفهومًا، بكلماتٍ مَحدودَةِ العَدَدِ مع التَّوَسُّعِ في استِعمالها تَدريجيًّا، وعدَمِ إغراقِ الطلّابِ بِسَيْلٍ من الكلمات غيرِ المفهومَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الطريقة الصامتة ","nonDiacriticsLemma":"الطريقة الصامتة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطَّرِيقَةُ الصَّامِتَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"au
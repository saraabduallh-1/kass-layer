{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/347197bc-d221-4dea-97e4-a5fc6ad56689/get-public-entry"},"browse_index_record":{"lexicalEntryId":"347197bc-d221-4dea-97e4-a5fc6ad56689","word":"مَسَافَةٌ اجْتِمَاعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9da2","lexicalEntryId":"347197bc-d221-4dea-97e4-a5fc6ad56689","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَسَافَةٌ اجْتِمَاعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"شُعورُ المرءِ بقُربه من شَخصٍ ما وبُعدِه عن شَخصٍ آخَرَ من الناحيَة الاجتِماعيّة. هذه المسافةُ تؤثِّر في طريقَة التواصُلِ بين الأشخاصِ أو المجتَمَعات، ومن ثم تؤثِّر في قُدرَة كلِّ طَرَفٍ على تَعلُّم لُغَةِ الطَّرَفِ الآخَر، خاصَّةً بين المهاجِرين (الأجانِبِ) وأهلِ البَلَدِ الأصليِّين الناطقين باللغة الهَدَف. يُؤثِّر في هذه المسافَة عدَّةُ عَوَامِل، منها: اختِلافُ حَجمِ المجموعَتَين، وقوَّةُ كلٍّ منهما وتَأثيرُها في المجتَمَع. والمسافةُ الاجتِماعيةُ عامِلٌ من عَوامِلِ النظريةِ الاجتِماعيةِ في اكتِساب اللغة، وإحدى النظرياتِ التي تُفسِّر اكتِسابَ اللغةِ الثانية، وتتلخَّص في أنه كلَّما توفرَت العوامِلُ الاجتماعيةُ التي تُقرِّب المتعلِّمَ من ثقافَة اللغةِ الهدَفِ أصبَحَ تعلُّمُه أيسَرَ، والعَكسُ بالعَكس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مسافة اجتماعية ","nonDiacriticsLemma":"مسافة اجتماعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":nu
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f2edc62e-5735-4ef4-b0d5-134abc469ea2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f2edc62e-5735-4ef4-b0d5-134abc469ea2","word":"نَبْرُ الجُمْلَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9daf","lexicalEntryId":"f2edc62e-5735-4ef4-b0d5-134abc469ea2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَبْرُ الجُمْلَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النَّبرَةُ الرَّئيسَةُ التي تَقَع على إحدى كلماتِ الجُملَة، وغالبا ما تكون هذه النَّبرَةُ على الكلمة الأخيرَةِ في الجُملة أو الكلمةِ المهِمَّةِ فيها. هذه النَّبرَةُ تختَلف عن نَبرَة الكلمةِ word stress حين تكون الكلمةُ منعَزلَةً عن الجُملة. والعربيةُ إحدى اللغاتِ التي يَشيع فيها نَبرُ الجُملَة، وقد يكون وَظيفِيًّا، خلافًا لنَبر الكلمةِ الذي يَندر أن يَكون وَظيفِيًّا في العربية الفُصحى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نبر الجملة ","nonDiacriticsLemma":"نبر الجملة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَبْرُ الجُمْلَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e2796d11-32df-42bc-a193-849c6150cc6c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e2796d11-32df-42bc-a193-849c6150cc6c","word":"ثُنَائيَّةُ النَّمَطِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f67","lexicalEntryId":"e2796d11-32df-42bc-a193-849c6150cc6c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ثُنَائيَّةُ النَّمَطِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سِمةٌ للُّغة البَشَرِية، تُميِّزها عن غيرها من أنماط التواصُلِ لدى المخلوقاتِ الأخرى، وعن لغة الإشارَةِ البشريةِ sign language أيضا. تتلخَّص هذه السِّمَةُ في أن اللغةَ البَشَرِيةَ (المنطوقَةَ) تتكوَّن من مجموع وحداتٍ صغيرة، تُسمى الأصواتَ أو الأصواتَ الوَظيفِيةَ phonemes، وتختَلِف اللغاتُ في عَدَدها، بَيدَ أن هذه الأصواتَ لا تَحمِل معنى بذاتِها حين تَرِد منفرِدَة، فلا يوجَد في العربية مثلا معنى لصوت الصادِ أو السينِ أو القاف. لكنها هذه الأصواتَ حين تجتَمِع في كلمةٍ يكون للكلمة معنى، ولو كانت الكلمةُ مكوَّنَةً من صَوتَين فقط. وهذه السِّمةُ هي التي تَسمَح للُّغة بإنتاج عشراتِ الآلافِ من الكلمات التي يُمكن أن تخرُج من الجِهاز الصوتيِّ vocal tract الذي يُصدِر أصواتا مَحدودَة العَدَد، وهي السِّرُّ الحقيقيُّ لقُدرَة الإنسانِ على استعمال اللغةِ المَنطوقَةِ بطريقةٍ نحويةٍ تواصُليةٍ ناجِحَة، وإنتاجِ ما لا نِهايَة له من الجُمَل ذاتِ المعاني المختَلِفة. وكان اللغويُّ الأمريكيُّ تشارلز هوكيت Charles Hockett أوَّلَ من استَعمَل هذا المصطلَحَ في الستينيات من القرن العشرين، بدلاً من المصطلَح: double articulation الذي استَعمَله اللغويُّ الفرنسيُّ أندريه مارتينه  André  Martinet في الخمسينيات من القرن العشرين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ثنائية النمط ","nonDiacriticsLemma":"ثنائية النمط","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ثُنَائيَّةُ النَّمَطِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/27258c05-51db-486d-8e19-95097e597df8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"27258c05-51db-486d-8e19-95097e597df8","word":"اللُّغَوِيَّاتُ التَّعْلِيمِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f69","lexicalEntryId":"27258c05-51db-486d-8e19-95097e597df8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَوِيَّاتُ التَّعْلِيمِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من فروع علمِ اللغة، يَقَع في الجانب التطبيقيِّ منه، ويُعنَى بما له علاقةٌ بتعليم اللغة الأمِّ أو الثانيةِ أو الأجنبيةِ؛ فيَسعى إلى وَضع نظريةٍ متكامِلَة، وتَطبِيقِ هذه النظريةِ في تعليم اللغةِ خاصَّةً والعَمَليةِ التعليميةِ عامَّةً، وهو قريب من مصطلح: pedagogical linguistics. ويُطلَق أحيانا على علم اللغةِ التطبيقيِّ على الرَّغم من أنه فَرعٌ من فُروعه، ويُسمّى بأسماء أخرى؛ كعلم اللغةِ التعليميِّ، وعلمِ اللغةِ التربويِّ،  واللغوياتِ التربوية. راجع:  @(pedagogical linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغويات التعليمية ","nonDiacriticsLemma":"اللغويات التعليمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَوِيَّاتُ التَّعْلِيمِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

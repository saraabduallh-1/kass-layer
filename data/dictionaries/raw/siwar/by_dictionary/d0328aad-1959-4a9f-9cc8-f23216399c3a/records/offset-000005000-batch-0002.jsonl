{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/816b37b1-0570-4eca-9bfe-dc0e51dbfac2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"816b37b1-0570-4eca-9bfe-dc0e51dbfac2","word":"اللُّغَويَّاتُ السُّوسيرِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c33","lexicalEntryId":"816b37b1-0570-4eca-9bfe-dc0e51dbfac2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَويَّاتُ السُّوسيرِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"آراءُ رائدِ علمِ اللغةِ الحديثِ، فِردِينان دي سوسير Ferdinand de Saussure ونَظريّاتُه اللغويةُ التي تُعَدُّ أساسَ علمِ اللغةِ الحديثِ عامَّةً، وعلمِ اللغةِ الوَصفِيِّ خاصَّة، ولاسيَّما آراؤه التي تَضَمَّنَتْها محاضَرَاتُه في علم اللغةِ العامِّ، التي نَشرَها طلابُه بعد وَفاتِه في عام 1916م، وأصبَحَت مَرجِعًا في هذا العلم. وُصِف دي سوسير برائد علمِ اللغة الحديثِ على الرّغم من أن كثيرًا من آرائه اللغويةِ قد عُرِفَت قبلَه، لكنها لم تَحْظ بالقَبول والشّهرَة كما حَظِيَت آراءُ دي سوسير. بَيد أن تَطوُّرَ هذا العلمِ فيما بعد أدَّى إلى انتِقاد بعضِ آراء سوسير ونظرياتِه حولَ طبيعةِ اللغةِ ومَنهَجِ دراسَتِها. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغويات السوسيرية ","nonDiacriticsLemma":"اللغويات السوسيرية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَويَّاتُ السُّوسيرِيَّةُ"}],"lemmaLanguage":{"code
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/306841fa-8b4d-4afd-8478-d57e2bf91810/get-public-entry"},"browse_index_record":{"lexicalEntryId":"306841fa-8b4d-4afd-8478-d57e2bf91810","word":"سُلُوكٌ قَاعِدِيٌّ مُقَنَّنٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c30","lexicalEntryId":"306841fa-8b4d-4afd-8478-d57e2bf91810","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سُلُوكٌ قَاعِدِيٌّ مُقَنَّنٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اللغة المرحَليَّةِ لمتعلِّمي اللغاتِ الأجنبية، أو هو تَفسيرٌ لطَبيعة اللغةِ المرحليةِ ذاتهِا حين تُوصَف بأنها سُلوكٌ لغويٌّ تَحكُمه القواعد. ويُقصَد به مَعرِفةُ الشَّخصِ باللغة الهَدَف، وهي الكِفايَةُ اللغوية، التي هي نِظامٌ مُكوَّنٌ من قواعد تَحكُم الوحداتِ اللغويةَ كالمورفيمات والكلماتِ والعباراتِ والجُمل، ويُصدِرها النّاطقُ باللغة بطَريقةٍ فِطرِيّةٍ عَفويّةٍ وإن لم يُدرِك قَوَاعدَها النَّظَرية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"سلوك قاعدي مقنن ","nonDiacriticsLemma":"سلوك قاعدي مقنن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سُلُوكٌ قَاعِدِيٌّ مُقَنَّنٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2f814a74-72d0-4789-b74a-d7572d8bead7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2f814a74-72d0-4789-b74a-d7572d8bead7","word":"رَوْمَنَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c48","lexicalEntryId":"2f814a74-72d0-4789-b74a-d7572d8bead7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رَوْمَنَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تَحويلُ نِظامِ الكتابةِ في لغةٍ ما إلى أبجَدَيَّةٍ رُومانِيَّةٍ أو لاتِينِيَّة، كما فَعَل الأتراكُ حين حَوَّلوا نِظامَ الكتابةِ التُّركيَّةِ من الحَرف العربيِّ إلى الحَرف الرُّومانِيِّ أو اللاتِينيِّ، وما فَعَلَه الأندونيسيُّون والماليزيُّون والصُّوماليون وغيرُهم ممن كتِبَت لغاتُهم بالحُروف اللاتينِيَّةِ بعد أن كانت تُكتَب بالحُروف العربية؛ ففقَدَت إثرَ ذلك جزءًا كبيرًا ومُهمًّا من تُراثها وثَقَافَتِها وآدابِها. وقريبٌ من ذلك محاوَلَةُ إصلاحِ الخَطِّ في الصين باعتِماد الحُروفِ اللاتينِيَّةِ المعَدَّلَةِ لتَحلَّ محلَّ الحَرفِ الصينيِّ التَّقليديّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"رومنة ","nonDiacriticsLemma":"رومنة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رَوْمَنَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

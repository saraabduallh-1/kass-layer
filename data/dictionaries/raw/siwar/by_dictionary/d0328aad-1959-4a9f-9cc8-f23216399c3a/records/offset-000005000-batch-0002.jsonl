{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a70ca748-dabf-4265-9f72-5eff4d85a0ad/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a70ca748-dabf-4265-9f72-5eff4d85a0ad","word":"نَظَريَّةُ العَلاقَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c34","lexicalEntryId":"a70ca748-dabf-4265-9f72-5eff4d85a0ad","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَريَّةُ العَلاقَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَظَريَّةٌ مَعرِفيَّةٌ تَداوُلِيَّةٌ، تَرى أن التَّواصُلَ عَمَليَّةُ استِنتاجٍ واستِنباط لا يَعتَمِد على الرَّمزيَّة، وهذا ما يَحمِل المتحدِّثَ على التَّقليل من الكلام الذي يَتَطلَّب مَعلوماتٍ رَمزِيَّةً، ويَدفَعه إلى حَمل المخاطَبِ على فَهم المعنى من السِّياق والمقام، برَبط مَعلوماتِ المخاطَبِ السَّابقَةِ بالمعلومات الوارِدَةِ في الكلام. تَرى هذه النظريةُ أنه كلَّما اجتَهَد المتحدِّثُ في حَفز المخاطَب على التَذَكُّر والرَّبطِ والاستِنباطِ زاد احتِمالُ فَهمِ الكلامِ من السِّياق، وقَلَّ الاعتِمادُ على الرَّمزِيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية العلاقة ","nonDiacriticsLemma":"نظرية العلاقة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَريَّةُ العَلاقَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

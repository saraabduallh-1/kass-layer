{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2d66a5ec-0b81-4a07-bf51-ae8c32f3fbff/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2d66a5ec-0b81-4a07-bf51-ae8c32f3fbff","word":"عِبَارَةُ تَأَدُّبٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9969","lexicalEntryId":"2d66a5ec-0b81-4a07-bf51-ae8c32f3fbff","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِبَارَةُ تَأَدُّبٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تركيبٌ مَسكوكٌ أو عبارَةٌ محفوظَةٌ تُستَعمَل في مقام التأدُّب، وتختَلِف بحسَب العلاقَةِ الاجتماعيةِ بين المتكلِّمِ والسامِع. فيُقال في العربية لمعظَم الناسِ: بارَك اللهُ فيك، ويُقال للمُسِنِّ إجلالاً له: أمَدَّ اللهُ في عُمُرِك على خَير، أو متَّعك الله بالصحَّة والعافيَة، ويُقال لكلِّ ذي مَنزِلَةٍ اجتماعيةٍ أو مَنصِبٍ رَسميٍّ ما يُناسِبه وبحسَب مَنزِلته. قَسَّم براون ولفينسون P. Brown & S. Levinson إستراتيجياتِ صِيَغ التأدُّبِ إلى نوعَين: إستراتيجياتُ تأدُّبٍ إيجابيةٍ positive politeness strategies، وإستراتيجيات تأدُّبٍ سَلبيةٍ negative politeness strategies.    ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عبارة تأدب ","nonDiacriticsLemma":"عبارة تأدب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِبَارَةُ تَأَدُّبٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3cade733-67f6-4a6a-8fc7-fae350be529f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3cade733-67f6-4a6a-8fc7-fae350be529f","word":"دَرَجَةُ الصَّوْتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9963","lexicalEntryId":"3cade733-67f6-4a6a-8fc7-fae350be529f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دَرَجَةُ الصَّوْتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"دَرَجَةُ الصَّوتِ أو طَبَقةُ الصَّوت، وهي الصِّفةُ التي تُمَيِّز بها الأذُنُ الأصواتَ من حيث الحِدَّةُ والغِلظَةُ التي تَتَوَقَّف على عَدَد الاهتِزازات أو الذَّبذَبات التي يُصدِرها الوَتَران الصَّوتيان في الثانية، وتُعرَف بالتَّرَدُّد. فإذا زادَ عَدَدُ الذَّبذَباتِ الصَّوتيةِ في الثانية كان الصوتُ حادًّا رَقيقًا، وإذا قَلَّ عَدَدُها كان الصوتُ غليظًا أو سَميكًا. عَدَدُ الذَّبذَباتِ الصَّوتيةِ لدى الإنسان مُرتَبِطٌ بثلاثة عوامِلَ، هي: سُمكُ الوَتَرَين الصَّوتيَين، وطولُهما، وتَوَتُّرُهما، وهذا هو سبَبُ حِدَّةُ صَوتِ المرأةِ والطفل؛ لقِصَر أوتارِهما الصَّوتية ودِقَّتِها، خلافًا لصَوتِ الرَّجلِ الذي يَتَّسِم بالغِلظَة؛ لطُول وَتَرَيْه الصَّوتيَّيْن وغِلظَتِهما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"درجة الصوت ","nonDiacriticsLemma":"درجة الصوت","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دَرَجَةُ الصَّوْتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/22f30ce7-8381-4a4b-82cd-aa5ebbb4c16f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"22f30ce7-8381-4a4b-82cd-aa5ebbb4c16f","word":"الإنْجلِيزِيَّةُ البَسِيطَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9964","lexicalEntryId":"22f30ce7-8381-4a4b-82cd-aa5ebbb4c16f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنْجلِيزِيَّةُ البَسِيطَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ تَوَاصُليٌّ مبَسَّطٌ من الإنجليزية، دعا إلى استعماله في الكتابة جَماعةٌ من اللغويين والكتَّاب في بريطانيا والولاياتِ المتحدةِ الأمريكية، رَدًّا على ما كان سائدا في القرن العشرين من الوَلَع بطُول الجُمَلِ وتَعقيدِها وغَرابَةِ كلماتها. يَهتَم المنادون بهذا الأسلوبِ بحاجات القارئِ العادِيِّ، والاقتصارِ على استعمال كلماتٍ وجُمَلٍ قصيرة، وتحاشي استعمالِ الكلماتِ الغامِضَةِ والمصطلَحاتِ الخاصَّةِ غيرِ الضَّرورية. وقد وُضعَت تَوصياتٌ عمَليةٌ بهذا الشأن، منها: بَدءُ الجُملةِ الإنجليزيةِ بالفاعِل فالفَعلِ فالمفعولِ SVO، واستعمالُ الجُملةِ المبنيَّةِ للمَعلومِ بدَلا من الجُملة المبنيَّةِ للمَجهول، واستعمالُ الأفعالِ بدَلا من الأسماء، واختيارُ الكلماتِ التي لا تَخفَى معانيها على عامَّة القُرّاء، وتَحاشي الجُملِ المعقَّدةِ والعباراتِ المضَمَّنة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية البسيطة ","nonDiacriticsLemma":"الإنجليزية البسيطة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنْجلِيزِيَّةُ البَسِيطَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

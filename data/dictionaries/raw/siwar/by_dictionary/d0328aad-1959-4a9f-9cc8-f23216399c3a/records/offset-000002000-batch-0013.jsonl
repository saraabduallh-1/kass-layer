{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8ad3e6ac-23a0-4306-b49c-9977fd06d255/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8ad3e6ac-23a0-4306-b49c-9977fd06d255","word":"الأُسْلُوبُ الكُلِّيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9173","lexicalEntryId":"8ad3e6ac-23a0-4306-b49c-9977fd06d255","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الأُسْلُوبُ الكُلِّيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ نفسيٌّ تربويٌّ، يُقصَد به التعلُّم الكُلِّيّ، وهو أسلوبٌ مَعرِفيٌّ يتَذكَّر فيه المتعلِّمُ الشيءَ المرادَ تعلُّمُه كُتلَةً واحدةً، دونَ النظرِ في مُكوِّناته وأجزائه. فمتعلِّمُ اللغةِ الأجنبيةِ، مثلا، يحفَظ الجُملَةَ كامِلَةً ويَستَعمِلها، بدلًا من تحليلها إلى مورفيماتٍ وكلماتٍ وعباراتٍ أو يُرَكِّبها تركيبا جُزئيًّا. وفُسِّر صَمتُ بعضِ الأطفالِ مدَّةً من الزَّمَن ثم إصدارُه جُملةً أو جُمَلا سليمةً بأنه أسلوبٌ كُلِّيٌّ أو إستراتيجيةٌ جِشتَالتِيَّة. وقد طُبِّق الأسلوبُ الكُلِّيُّ في تعليم القراءةِ للمبتَدئين. ويُقابِل هذا الأسلوبَ الأسلوبُ التَّحليلِيُّ analytic style أو الأسلوبُ الجُزئيُّ part style. والجِشتالتُ كلمةٌ ألمانيّة تَعني (شَكل) أو (مَظهر).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الأسلوب الكلي ","nonDiacriticsLemma":"الأسلوب الكلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الأُسْلُوبُ الكُلِّيُّ"
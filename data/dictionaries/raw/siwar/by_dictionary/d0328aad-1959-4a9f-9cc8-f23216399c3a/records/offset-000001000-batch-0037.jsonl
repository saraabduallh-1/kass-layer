{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/684f7146-8564-4fa7-bf53-68034e75f080/get-public-entry"},"browse_index_record":{"lexicalEntryId":"684f7146-8564-4fa7-bf53-68034e75f080","word":"مَنْهَجُ التَّجْسِيدِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fe3","lexicalEntryId":"684f7146-8564-4fa7-bf53-68034e75f080","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَنْهَجُ التَّجْسِيدِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهجٌ في البحث في دراسة اللغة، استَعمله تشومسكي، ويَعنِي به جَمعَ اللغويِّ عيِّناتٍ لغويةً حقيقيةً من لغةٍ أو لغاتٍ محدَّدَة؛ للوُصول إلى منهَجٍ وَصفيٍّ لقواعد اللغة. ويُفَرِّق تشومسكي بين هذا المنهَجِ ومنهَجٍ آخَرَ مُقابِلٍ له، سمّاه المنهَجَ الفِطرِيَّ أو المنهَجَ الذّاتِيَّ internalized approach، وفضَّله على المنهَج الأوّل، ويَعنِي به وَصفَ اللغويِّ قواعدَ اللغةِ المدروسةِ بناء على سَليقَةِ الناطقين بها ومَعرفتِهم الفِطريَّةِ بهذه القواعد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"منهج التجسيد ","nonDiacriticsLemma":"منهج التجسيد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَنْهَجُ التَّجْسِيدِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c98ae297-939b-4cf0-9e79-ccc21f300996/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c98ae297-939b-4cf0-9e79-ccc21f300996","word":"لُغَةٌ داخِلِيَّةُ المَعَايِيرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fe4","lexicalEntryId":"c98ae297-939b-4cf0-9e79-ccc21f300996","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ داخِلِيَّةُ المَعَايِيرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ تُطبَّق مَعاييرُها ضِمنَ المنطَقةِ التي نشَأت فيها. فالإنجليزيةُ ضِمنِيةُ المعاييرِ في بريطانيا والولاياتِ المتحدةِ الأمريكيةِ وكندا وأستراليا ونيوزيلندا، لكنها ليسَت كذلك في الدُّوَل التي تَستَعملها لغةً ثانيةً كماليزيا وهونج كونج ونيجريا. والإسبانيةُ ضِمنِيةُ المعايِيرِ في إسبانيا، لكنها ليسَت كذلك في أمريكا اللاتينية. ويقابِلها اللغةُ خارِجيّة المعايِير. راجع:  @(exonormative (language)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة داخلية المعايير ","nonDiacriticsLemma":"لغة داخلية المعايير","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ داخِلِيَّةُ المَعَايِيرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fc794009-8bf9-4e74-b0a5-921737156879/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fc794009-8bf9-4e74-b0a5-921737156879","word":"الإنجلِيزِيَّةُ لأَغْرَاضٍ خَاصَّةٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fe5","lexicalEntryId":"fc794009-8bf9-4e74-b0a5-921737156879","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنجلِيزِيَّةُ لأَغْرَاضٍ خَاصَّةٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تعليمُ الإنجليزيةِ لأغراضٍ تعليميةٍ أو مِهْنِية؛ كتعليمها بغَرَض استعمالِها لغةً للتدريس في الجامعة في تخصُّصاتِ الهندسةِ أو الطِّبِّ أو الصيدلةِ أو الفيزياءِ أو علومِ الحاسِب، أو تعليمِها للتواصُل بها في مِهنَةٍ معيَّنَة؛ كالطِّبِّ والتَّمريض، والتجارَة، والأغراضِ الدِّبلوماسية. وتُبنَى برامِجُ تعليمِ الإنجليزيةِ لأغراضٍ خاصَّةٍ بعد تحليلِ حاجاتِ المتعلِّمين لاستِعمال اللغة، ثم تُحَدَّد المفرَداتُ والعباراتُ والجُمَلُ والمصطلَحاتُ والمواقِفُ التي يتطلَّبها البرنامَج. ويَدخُل ضِمنَ تعليمِ الإنجليزيةِ لأغراضٍ خاصَّةٍ تعليمُ الإنجليزيةِ لأغراضٍ أكاديمية، وتعليمُ الإنجليزيةِ للعُلوم والتّقنية، ويُقابِل هذه البرامَجَ عادَةً تعليمُ الإنجليزيةِ لأغراضٍ عامَّةٍ English for general purposes (EGP).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية لأغراض خاصة ","nonDiacriticsLemma":"الإنجليزية لأغراض خاصة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنجلِيزِيَّةُ لأَغْرَاضٍ خَاصَّةٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

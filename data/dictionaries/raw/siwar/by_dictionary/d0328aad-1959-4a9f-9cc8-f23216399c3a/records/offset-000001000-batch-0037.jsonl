{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4f97ed3f-0445-480c-8ae6-c19b1e111e90/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4f97ed3f-0445-480c-8ae6-c19b1e111e90","word":"نَظَرِيَّةُ المَعْرِفَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fe7","lexicalEntryId":"4f97ed3f-0445-480c-8ae6-c19b1e111e90","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ المَعْرِفَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"دراسةُ ما يَعرِفة الإنسانُ وكيف يَعرِفه، وهي النظريةُ التي تُعالِج طبيعةَ المعرِفةِ وصِدقَها، وتَدرُس العُلومَ من حيث موضوعاتُها ومَبادِئُها وقوانينُها وعلاقاتُ بعضِها ببعض، والقوانين التي تحكم تطوّرها. وهي جُزءٌ من الفَلسَفَة والميتافيزيقا، وهذا سبَبُ تسميَتِها فلسفةَ العُلوم. فالقَولُ إنّ علمَ اللغةِ مثَلا عامٌّ وَصفِيٌّ، وليس عِلمًا صُورِيًّا، ليس قَولا من داخِل هذا العِلمِ وليس من قضاياه، وإنما هو قَولٌ يُقال عنه. ويُقابِل فلسفةَ العُلوم أو نظريةَ المعرِفَةِ علمُ المعرِفَةِ أو الإدراكُ cognition الذي يَدرُس أيضا الظواهِرَ نفسَها، لكنه يَدرُسها من الناحية النَّفسيةِ المعرِفية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية المعرفة ","nonDiacriticsLemma":"نظرية المعرفة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ المَعْرِفَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d9632558-d1b5-4b17-943b-682eff214188/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d9632558-d1b5-4b17-943b-682eff214188","word":"مَنْسُوبٌ إلَيْهِ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fe8","lexicalEntryId":"d9632558-d1b5-4b17-943b-682eff214188","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَنْسُوبٌ إلَيْهِ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الشخصُ الذي يُنسَب إليه اسمٌ أو يُسمَّى باسمه شيءٌ؛ كأسماء الطَّعام، وأسماءِ البِلاد، وأسماءِ القبائل، ونحوِ ذلك. وهو كثيرٌ في العربية، ولاسيّما أسماءُ القبائلِ والأماكِن. ومنه في الإنجليزية كلمةُ: sandwich المنسوبَةُ إلى اللُّورْد ساندويتش Lord Sandwich، والكلمةُ الإنجليزيةُ: hamburger التي تُطلَق على نوعٍ من الوَجبات الأمريكيةِ السَّريعَةِ، نسبةً إلى مدينة هامبوغ الألمانية، ومنه كلمةُ: watt، التي هي شِدَّة التَّيَّارِ الكهربائي، نِسبَةً إلى مُكتِشِفِها الأسكوتلنديِّ جميس وات James Watt. وتَسميةُ الشيءِ باسم صاحِبِه يُطلَق عليها eponymous؛ أما العَلاقةُ بين الاسمِ والمسمَّى باسمه أو المنسُوبِ إليه فتُسمّى: eponymy.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"منسوب إليه  ","nonDiacriticsLemma":"منسوب إليه ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَنْسُوبٌ إلَيْهِ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/52113e34-cadc-4031-97c8-693d46b2ce2e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"52113e34-cadc-4031-97c8-693d46b2ce2e","word":"فَداحَةُ الخَطَأِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fe9","lexicalEntryId":"52113e34-cadc-4031-97c8-693d46b2ce2e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَداحَةُ الخَطَأِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَدَى تَأثيرِ الخَطأِ اللغويِّ الذي يَقَع فيه متعلِّمُ اللغةِ في العَمَلية التواصُلِية، أو مدَى تأثِيرِه في الناطقين باللغة أو تقييمهم له من حيث إزعاجُ السامِعِ من عَدَمِه. وتختَلِف درَجةُ خُطورةِ الخَطأِ بحسَب نوعِه؛ كالخطأ في النُّطق، والخَطأِ في المفرَدات، والخَطأِ في التراكيب، والخَطأِ في الاستعمال التَّداوُلي. فبعضُ الأخطاءِ خَفيفَةٌ لا تُؤثِّر في فَهم الرِّسالَةِ ولا تُزعِج السامِعَ، وبعضُها لا تؤثِّر في الفَهم ولكنها تُزعِج السامِعَ، وبعضُها تُسبِّب صُعوباتٍ تواصُليةً، وقد تَمنَع فَهمَ الرِّسالة. وتختَلِف خُطورَةُ الخَطأِ في جانبٍ معيَّنٍ من لغةٍ إلى أخرى؛ ففي العربية غالبا ما يكون الخَطأُ في العلامَة الإعرابيةِ مؤثِّرا في فَهم المعنى، وفي الإنجليزية غالبا ما يكون الخَطأُ في ترتيب عناصِرِ الجُملةِ سبَبا في تَغيُّر معنى الجُملة، وكذلك الخَطأُ في النَّبر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فداحة الخطأ ","nonDiacriticsLemma":"فداحة الخطأ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَداحَةُ الخَطَأِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

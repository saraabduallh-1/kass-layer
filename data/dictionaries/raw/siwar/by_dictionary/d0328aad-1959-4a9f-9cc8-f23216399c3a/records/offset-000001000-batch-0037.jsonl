{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/78c00205-fc3d-4b10-80e5-8538489042ea/get-public-entry"},"browse_index_record":{"lexicalEntryId":"78c00205-fc3d-4b10-80e5-8538489042ea","word":"إحْيَاءٌ (لُغَوِيٌّ) عِرْقِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fd9","lexicalEntryId":"78c00205-fc3d-4b10-80e5-8538489042ea","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إحْيَاءٌ (لُغَوِيٌّ) عِرْقِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، شاع استعمالُه في الولايات المتحدةِ الأمريكيةِ في الرّبع الأخيرِ من القَرن العِشرين، ويُقصَد به سَعْيُ أحفادِ المهاجِرين إلى إحياء لغاتِ أسلافِهِم، وما يرتَبِط بها من مَفاهيمَ ثقافية. تُشير نتائجُ الدراساتِ في هذا الشّأنِ أن الجيلَين الأوّلَ والثانيَ من أولئك المهاجِرين كانوا مَعنِيِّين بوَضعِهم الاجتماعيِّ والاقتِصاديِّ؛ أما الجيلُ الثالثُ فهو الذي شَرَع في السَّعي لإحياء لغةِ أسلافِه، وإن لم يتمَكَّن من التحدُّث بها بطلاقَةٍ تُشبه طلاقَتَه في الإنجليزية التي هي لغتُه الأمّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إحياء (لغوي) عرقي ","nonDiacriticsLemma":"إحياء (لغوي) عرقي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إحْيَاءٌ (لُغَوِيٌّ) عِرْقِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

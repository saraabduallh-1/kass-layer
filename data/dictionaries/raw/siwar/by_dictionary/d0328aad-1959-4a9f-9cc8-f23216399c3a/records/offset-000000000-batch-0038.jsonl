{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a3af5aa1-8768-43c9-901c-4148b621e577/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a3af5aa1-8768-43c9-901c-4148b621e577","word":"كِفَايَةٌ تَوَاصُلِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c03","lexicalEntryId":"a3af5aa1-8768-43c9-901c-4148b621e577","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كِفَايَةٌ تَوَاصُلِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قُدرَةٌ كامِنةٌ في الفَرد تُمَكِّنه من الاتصال اللغوي، ولا تنحَصِر هذه القُدرةُ في معرِفة قواعدِ اللغة، وإنما تَشمل أيضا معرِفةَ أصولِ الكلامِ وأساليبِه، ومُراعاةَ طبيعةِ المخاطَبين، وتَنويعَ الكلامِ حسبَ مُقتَضى الحال، ومُراعاةَ القوانينِ والقواعدِ التَّداوُليةِ للغة الهَدَف. والكِفايَةُ أو القُدرةُ التواصُليةُ غالبا ما تُقابَل بكلٍّ من القُدرَة اللغويةِ (النحوية) grammatical competence، والأداءِ اللغويِّ language performance، المتمَثِّلِ في النَّشاط اللغويِّ الفِعليِّ من كلامٍ وكتابة، وكلاهما من مصطلحات تشومسكي التي انتَقَدها اللغويون الاجتماعيون أمثالُ مايكل هاليداي M.A.K. Halliday وديل هايمز Dell Hymes. راجع:  @(language competence) و  @(language performance) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كفاية تواصلية ","nonDiacriticsLemma":"كفاية تواصلية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كِفَايَةٌ تَوَاصُلِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

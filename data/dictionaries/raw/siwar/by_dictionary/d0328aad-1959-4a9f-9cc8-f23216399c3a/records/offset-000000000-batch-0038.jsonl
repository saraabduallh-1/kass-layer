{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8931f9ef-a455-47ea-baa3-f2fc87fde6a4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8931f9ef-a455-47ea-baa3-f2fc87fde6a4","word":"تَرْمِيز","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c07","lexicalEntryId":"8931f9ef-a455-47ea-baa3-f2fc87fde6a4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْمِيز","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تَحْوِيلُ الرَّمْزِ اللُّغَوِيِّ، أو عمَليةُ وَصفِ اللغةِ المدروسَة؛ لتَحديد قواعِدِها، ومُفرَداتها المعجَمية، وأنظِمَتِها الكِتابية، ونحوِ ذلك مما تتَطلَّبه دراسَةُ أيِّ لغةٍ دراسةً وَصفيَّة. تُتَّبَع خطواتُ هذه العمَليةِ أيضا في التَّخطيط اللغويِّ، لكن تُضاف إليها خطواتٌ أخرى؛ كالتَّقيِيس أو التَّعيِير، ووَضعِ قواعدِ التَّهجِئةِ، ووَضعِ المعجَمِ، ونحوِ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"ترميز ","nonDiacriticsLemma":"ترميز","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرْمِيز"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cfade044-6993-450e-b3e5-f058eb719807/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cfade044-6993-450e-b3e5-f058eb719807","word":"عِلْمُ الإدْرَاكِ المَعْرِفِي","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c08","lexicalEntryId":"cfade044-6993-450e-b3e5-f058eb719807","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ الإدْرَاكِ المَعْرِفِي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمٌ يَستَمِدُّ مادَّتَه من البحث في علم اللغةِ وعلمِ النفسِ وعلمِ النفسِ المعرِفيِّ والذَّكاءِ الاصطناعِيِّ، ويهتَم بالدراسة العلمِيةِ للعَمَليات الذِّهنِية، كالذَّكاء والتفكيرِ والاستِنتاجِ ومُعالَجَةِ المعلوماتِ وفَهمِ اللغةِ والتَّخطيطِ وحَلِّ المشكِلات، ويَسعَى إلى قَوْلَبَة العَقلِ modularity of mind وتَقسيمِه إلى وحداتٍ لكلٍّ منها وَظيفةٌ أو مجموعَةٌ من الوَظائف التي تتواصَل فيما بينها وتتكامَل لتأديَة وَظائفِها. وغالبا ما يُقابَل هذا العلمُ بالعلوم الطبيعيةِ التي تَدرُس النُّظُمَ والأجهِزَةَ البيولوجية. وفي العُقود الأربعةِ الأخيرةِ، أصبَحَ هذا العلمُ موضوعا للبحث في اللغويات، لاسيَّما اللغوياتُ التوليديةُ التحويليةُ واللغوياتُ الحاسوبيةُ، التي تَرَى أن اللغةَ خاصِّيَّةٌ من خصائص العَقلِ البَشَريِّ وتُعامِلُها بوَصفها ظاهِرَةً مَعرِفيةً أو عَمَليَّةً مَعرِفية، تحدُث نتيجَةَ التفاعُلاتِ والتراكيبِ العَقليةِ والنفسيةِ التي يتَمَيَّز بها الإنسانُ، وتَشتَرك فيها القُدراتُ المعرِفيةُ الأخرى غيرُ اللغوية، بما في ذلك المعارِفُ العامَّةُ التي تؤثِّر في فَهم الكلامِ وإنتاجِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم الإدراك المعرفي ","nonDiacriticsLemma":"علم الإدراك المعرفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ الإدْرَاكِ المَعْرِفِي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a7c3cd57-a834-4b32-bbe7-162eee4c81e5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a7c3cd57-a834-4b32-bbe7-162eee4c81e5","word":"النِّظامُ المَعْرِفِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c09","lexicalEntryId":"a7c3cd57-a834-4b32-bbe7-162eee4c81e5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النِّظامُ المَعْرِفِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعةٌ متَرابِطَةٌ متكامِلةٌ من التراكيب الفِطرِيةِ في عَقل الإنسانِ، تحمِل المعارِفَ والأفكارَ التي يَكتَسِبها الإنسانُ عن العالَم المحيطِ به، ومن هذه المنظومات القدرةُ اللغويةُ البَشَرِيةُ. ولأن اللغةَ نظامٌ مَعرِفيٌّ فإن دراسةَ اللغةِ في ضَوء علمِ اللغة، خاصةً علمَ اللغةِ المعرِفيَّ الفِطرِي، يَتناوَل العَمَلياتِ العَقليةَ التي يَنطَوِي عليها اكتِسابُ اللغةِ وفَهمُها واستِعمالُها، سواء في الجانب العقليِّ الفَردِيِّ المتمثِّلِ في قُدرَة الفَردِ على معرِفة قواعدِ لغتِه وقوانِينِها اللغويةِ والاستِعمالية، أو في الجانب النَّظَرِيِّ التَّجرِيدِيِّ المتمثِّلِ في تَقعيد هذا النظامِ وتَقنِينِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظام المعرفي ","nonDiacriticsLemma":"النظام المعرفي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النِّظامُ المَعْرِفِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2000877c-b2ba-4f81-95ef-6279eca2f8dc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2000877c-b2ba-4f81-95ef-6279eca2f8dc","word":"النَّظَرِيَّةُ المَعْرِفِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c0a","lexicalEntryId":"2000877c-b2ba-4f81-95ef-6279eca2f8dc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّظَرِيَّةُ المَعْرِفِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويةٌ نفْسيَّةٌ، ظهَرَت في النِّصف الأوَّلِ من القرن العشرين؛ اهتَمَّت بالجوانِب العقليةِ المعرفيةِ لدى الإنسان، وعارَضَت جوانِبَ كثيرةً من النظرية السُّلوكية، خاصَّةً ما يتعلَّق بتَفسير اكتسابِ اللغةِ وتعلُّمِها. وقد اعتَنَق تشومسكي هذه النظريةَ وبَنَي عليها كثيرا من آرائه اللغويةِ الفِطريةِ في اكتساب اللغةِ الأمِّ، ثم طُبِّقت آراؤُه فيما بعدُ في حقل اكتسابِ اللغةِ الثانيةِ وتَعَلُّمِها. راجع:  @(cognitive psychology) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"إحدَى النظرياتِ النَّفسيةِ التي تُفسِّر اكتسابِ الطفلِ لغتَه الأمَّ. وهي النظريةُ التي تَبنّاها عالم النفس السويسري جان بياجيه Jean Piaget. وتتلَخَّص في أن القُدراتِ المعرِفيةَ العامَّةَ للإنسان تتحكَّم في نُمُوِّه اللغوي، وأن اللغةَ مرتَبِطَةٌ بمستَويات الذَّكاءِ والذاكرَة، خِلافا لما يَراه تشومسكي من أن اللغةَ فِطرَةٌ مَغروسَةٌ في عَقل الإنسان، تَنمو بشَكلٍ متدرِّجٍ ومنتَظِم، ولا تتطلَّب سِوَى الحَدِّ الأدنَى من الذَّكاء، والحَدّ الأدنَى من المدخَلات اللغويةِ التي توقِظها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظرية المعرفية ","nonDiacriticsLemma":"النظرية المعرفية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّظَرِيَّةُ المَعْرِفِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/61871298-9b96-4b28-8b6e-93986c9b9c10/get-public-entry"},"browse_index_record":{"lexicalEntryId":"61871298-9b96-4b28-8b6e-93986c9b9c10","word":"قُيُودُ المُصَاحَبَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c0b","lexicalEntryId":"61871298-9b96-4b28-8b6e-93986c9b9c10","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قُيُودُ المُصَاحَبَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"القُيودُ الدَّلاليةُ والسِّياقِيّةُ التي تمنَع بعضَ الكلماتِ من أن تُصاحِبَ كلماتٍ أخرى. وهي  إحدى مُشكلاتِ الترجَمة، خاصًة حين يَنقُل المترجِمُ المعنى حَرفيًّا؛ فيَرِد في كلامه كلماتٌ مُتَصاحِبَةٌ بطريقَةٍ لا تَقبَلها أنظِمَةُ اللغةِ الهدَف، وقد تُسَبِّب صُعوباتٍ في فَهم المعنى، ولو كان البناءُ التركيبيُّ سليما. فالعبارَةُ الإنجليزيةُ: breaking the law مثلاً، لا تُتَرْجَم إلى: كَسْر القانون، بل إلى: الخُروج على القانون، وكلمةُ (ضَحِك) في العربية لا تَرِدُ مع غير العاقِلِ من المخلوقات، ما لم يكُن الاستِعمالِ مجازيًّا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قيود المصاحبة ","nonDiacriticsLemma":"قيود المصاحبة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قُيُودُ المُصَاحَبَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6ef530af-5227-4a1e-a1ce-df22cd9092b5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6ef530af-5227-4a1e-a1ce-df22cd9092b5","word":"نَظَرِيَّةُ المُصَاحَبَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c0c","lexicalEntryId":"6ef530af-5227-4a1e-a1ce-df22cd9092b5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ المُصَاحَبَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النظريةُ اللغويةُ التي اقترَحَها جون فيرث John Firth في الخمسينيّات من القَرن العشرين في المصاحَبَة اللَّفظِية، وبيّن أنواعها ودرَجاتِها وقيودها، وطوَّرَها من بعده جون سنكلير John Sinclair في التِّسعينيات من القرن العشرين، بَيدَ أن الأخيرَ اهتَمَّ بالموضِع position، خِلافا لسَلَفه الذي عُنِيَ بالمدَى span. وفي أواخِر القَرنِ العشرين طبِّقَت هذه النظريةُ في تعليم اللغاتِ الأجنبيةِ وفي النُّموِّ اللغويِّ المرحَلي، ضِمنَ تطبيقاتِ المذهَبِ المعجَمِيِّ في تعليم اللغات. راجع:  @(collocation) و  @(Lexical Approach) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية المصاحبة ","nonDiacriticsLemma":"نظرية المصاحبة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ المُصَاحَبَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1aef393f-7efb-4848-87c1-eed2888da803/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1aef393f-7efb-4848-87c1-eed2888da803","word":"المُجتَمَع","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c0d","lexicalEntryId":"1aef393f-7efb-4848-87c1-eed2888da803","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المُجتَمَع","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"اللغةُ التي تَستَعمِلها جَماعةٌ لغويةٌ معيَّنةٌ في بلَدٍ ما، ولاسيّما لغاتُ الأقليَّاتِ العِرقِيةِ في المجتَمَع؛ كاللغات - غيرِ الإنجليزيةِ - في نيويورك التي منها العربيةُ والإسبانيةُ والإيطاليةُ والفرنسيةُ والألمانية، واللغاتِ - غيرِ الإنجليزيةِ - في بريطانيا التي منها العربيةُ والأرديةُ والهندية. وهذا المصطلَحُ لغويٌّ اجتماعيٌّ، يختَلِف عن مصطلَح: تَعَلُّمُ لُغةِ الجماعَةِ Community Language Learning، الذي هو لغويٌّ تطبيقيٌّ يُشير إلى طريقَةٍ من طرائق تدريسِ اللغاتِ الأجنبية. راجع:  @(Community Language Learning (CLL)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"المجتمع ","nonDiacriticsLemma":"المجتمع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المُجتَمَع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/956a6654-264e-419b-83bb-4048c99e20c7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"956a6654-264e-419b-83bb-4048c99e20c7","word":"تَعَلُّمُ لُغَةِ الجَمَاعَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c0e","lexicalEntryId":"956a6654-264e-419b-83bb-4048c99e20c7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعَلُّمُ لُغَةِ الجَمَاعَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":" طريقةٌ من طرائق تدريسِ اللغاتِ الأجنَبية، أنشأها وطوَّرها القِسُّ اليَسوعيُّ تشارلْز كيران Charles Curran، أستاذُ علمِ النفسِ الإرشادِيِّ في جامعة لويولا الأمريكيةِ بشيكاغو Loyola University, Chicago، عام 1976م. وهي طريقةٌ تختَلِف عن كثيرٍ من طرائق تدريسِ اللغاتِ الأجنَبيةِ من حيث النَّشأةُ والمرجِعِيَّة؛ فقد ارتَبَطَت بمجال الإرشادِ النَّفسي، حتى سُمِّيَت طريقة تعلُّمِ الإرشادِ النَّفسيِّ Counseling-Language Learning Method. والواقعُ أنها ليسَت طريقةً إرشادِيةً، وإنما هي تَطبيقٌ لبعض الأساليبِ الإرشادِيةِ في تعليم اللغاتِ الأجنبية؛ حيث تُتَاح الفُرصَةُ لمتعلِّمي اللغةِ الهَدَفِ ليتَحدَّثوا عما في أنفسهم، ويُعَبِّروا عن مشاعِرهم، ويتَبادَلوا ما لديهم من آراء وأفكارٍ ومشكلاتٍ وَسطَ جَماعَةٍ تَشعُر بهذه الحاجاتِ وتحسُّ بهذه المشاعر. وهذه الجماعةُ يمكن أن يمثِّلها الطلابُ في حُجرَة الدَّرس، بعد تَقسيمِهم إلى جماعاتٍ لغويةٍ مُتعاوِنَة، يُشارِك فيها المعلِّمُ بنفسِه وشُعورِه بطريقَةٍ إيجابِيةٍ فَعّالَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعلم لغة الجماعة ","nonDiacriticsLemma":"تعلم لغة الجماعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعَلُّمُ لُغَةِ الجَمَاعَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8a0abfde-2c8b-4bc7-8206-b2e93e6d279e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8a0abfde-2c8b-4bc7-8206-b2e93e6d279e","word":"عُيُوبُ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e39","lexicalEntryId":"8a0abfde-2c8b-4bc7-8206-b2e93e6d279e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عُيُوبُ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُقصَد به أيُّ مُشكلاتٍ أو عُيوبٍ لدى المرءِ في إصدار الكلام، وتُسمّى أيضا عُيُوبَ النُّطقِ أو مُشكلاتِ الكلام؛ بعضُها فسيولوجِيّةٌ كالخَنْخَنَة rhinolalia ، والثَّأثَأَةِ أو اللَّثْغَةِ lisping، وبعضُها نَفسِيّةٌ كالتَّهتَهَةِ أو التَّلَعثُمِ في الكلام stuttering، وبعضُها يَحدُث نَتيجَةَ إصابَةٍ في الدِّماغ كحُبسَة الكلامِ أو الحُبسَةِ اللَّفِظِيَّةِ verbal aphasia، أو لضَعفٍ في السَّمع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عيوب الكلام ","nonDiacriticsLemma":"عيوب الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عُيُوبُ الكَلامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2019b617-28c2-4a09-accd-6ecd27651d70/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2019b617-28c2-4a09-accd-6ecd27651d70","word":"عَمَلِيَّاتُ مُعَالَجَةِ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e3a","lexicalEntryId":"2019b617-28c2-4a09-accd-6ecd27651d70","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَمَلِيَّاتُ مُعَالَجَةِ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُشير إلى العَمَليّات والمعالَجاتِ اللازمةِ لإحداث الكلامِ سواء أكانت فسيولوجِيةً أم عَصَبِيةً أم مَعرِفيةً نَفسِية. وهي عمَلياتٌ مُتَداخِلَةٌ؛ تَبدأ بالتَّفكير في محتَوَى الكلام، ثم التَّهَيُّؤِ لإصدار الصوتِ الكلاميِّ بإدخال الهواء إلى الرِّئتَين، ثم إخراجِ الهواءِ بالزَّفير وتَحريك أعضاءِ النُّطقِ في أثناء مُرورِ الهواءِ بها، وما تَتَطَلَّبه هذه العمَلياتُ من أنشِطَةٍ ذِهنيةٍ مَعرِفية، وما تحتاجه من استِدعاءٍ للمَخزون اللغويِّ في الذَّاكرَة، وما يَستَدعيه المقامُ من مُراقَبةٍ للكلام وتَفاعُلٍ مع المخاطَب، ونحوِ ذلك. وقد يُطلَق المصطلحُ على كلٍّ من إنتاج الكلامِ speech production واستِقبالِه speech reception أو إدراكِه speech recognition في العَمَلية التواصُليّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عمليات معالجة الكلام ","nonDiacriticsLemma":"عمليات معالجة الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.
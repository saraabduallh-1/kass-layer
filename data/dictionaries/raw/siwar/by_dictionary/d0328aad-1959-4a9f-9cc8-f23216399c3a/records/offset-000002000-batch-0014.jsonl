{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ad89800c-a0f4-4d7d-84a3-7b11f8c271ce/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ad89800c-a0f4-4d7d-84a3-7b11f8c271ce","word":"أُنْمُوذَجُ جُودْمان","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9195","lexicalEntryId":"ad89800c-a0f4-4d7d-84a3-7b11f8c271ce","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ جُودْمان","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ في علم النِّفسِ القِرائيِّ (سَيكولوجية القراءة)، يُشير إلى أبرَز نماذِجِ القراءةِ الكلِّيَّةِ أو نماذِجِ قراءةِ المعنى Top-down Models وأقدَمِها. وَضَع هذا الأنموذَجَ كينيث جودمان Kenneth Goodman في الستينيَّات من القرن العشرين؛ لتَفسير عمَليةِ القراءةِ من أجل الفَهم. وهو أقرَبُ نماذِجِ القراءةِ ونظرياتِها إلى علم اللغةِ النَّفسيِّ؛ بسَبب تَفسيرِه عَمَليةَ القراءةِ تفسيرًا لغويًّا نفسيًّا وفقَ النظرةِ اللغويةِ المعرِفية، وتركيزِه على الخَلفِية اللغويةِ المعرِفيةِ للقارئ، وابتعادِه عن الجوانب الشَّكليةِ من حُروفٍ وأصواتٍ وكلمات؛ بل إن جودمان ربَطَ أنموذَجَه بعلم اللغةِ النفسيِّ رَبطا مباشِرا حين نَشَرَه بعنوان: Reading: A Psycholinguistic Guessing Game. ويُعَدُّ أكثَرَ النماذِجِ فائدةً لمتعلِّمي اللغاتِ الأجنِبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج جودمان ","nonDiacriticsLemma":"أنموذج جودمان","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ جُودْمان"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

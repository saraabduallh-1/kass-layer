{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/955e91f4-6c1d-48ec-81d5-8f36b4311c9b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"955e91f4-6c1d-48ec-81d5-8f36b4311c9b","word":"أَسَالِيبُ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e17","lexicalEntryId":"955e91f4-6c1d-48ec-81d5-8f36b4311c9b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَسَالِيبُ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"طرائقُ الحَديثِ التي تَتَنَوَّع داخِلَ المجتَمَعِ بحسَب مستَوَى المتكلِّم أو المخاطَب، وما يَتَطلَّبه المقامُ من كلامٍ رَسمِيٍّ، أو عامِّيٍّ غيرِ رَسمِيٍّ. فأسلوبُ الكلامِ داخِلَ العائلةِ الواحدة، أو بين الصَّديقَين يختَلِف عن أسلوب الكلامِ في المناسَبات الرَّسميَّة، والكلامُ في مَقام الحُزنِ أو العَزاءِ يَتَطلَّب تَحفُّظا وجِدِّيَّةً في الأسلوب لا يُستَعمَلان في حالات الفرَحِ ولا في المواقِف العادِيَّةِ بين الأصدِقاء.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أساليب الكلام ","nonDiacriticsLemma":"أساليب الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَسَالِيبُ الكَلامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3833b408-a49d-4308-a1e8-ece60a017a7a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3833b408-a49d-4308-a1e8-ece60a017a7a","word":"عَمَلِيَّةُ الدِّمَاغِ المَفْصُولِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e18","lexicalEntryId":"3833b408-a49d-4308-a1e8-ece60a017a7a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَمَلِيَّةُ الدِّمَاغِ المَفْصُولِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصبيٌّ، يُسمّى أيضا فَصْل جانِبَيْ الدِّماغِ، ويُشير إلى عَمَلية نادِرَةٍ تُجرَى للشَّخص المصابِ بمَرَضٍ في الدِّماغ، ثم تُجرَى على الشَّخص نفسِه دراساتٌ لغويّةٌ عَصَبِيَّة، فتُرصَد مناطقُ اللغةِ ووَظائفُها في دِماغه في هذه المرحَلَة، وتُقارَن الآثارُ اللغويّةُ التي تحدُث في الجانب الآخَرِ من الدِّماغ؛ للتأكُّد من انتِقال بعضِ الوَظائف اللغويّة إليه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عملية الدماغ المفصول ","nonDiacriticsLemma":"عملية الدماغ المفصول","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَمَلِيَّةُ الدِّمَاغِ المَفْصُولِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

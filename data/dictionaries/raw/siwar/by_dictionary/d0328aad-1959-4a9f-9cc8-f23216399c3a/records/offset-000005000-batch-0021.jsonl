{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6759effe-f157-4d3d-be5e-23a6d12792f7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6759effe-f157-4d3d-be5e-23a6d12792f7","word":"حَدَثٌ كَلامِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e15","lexicalEntryId":"6759effe-f157-4d3d-be5e-23a6d12792f7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَدَثٌ كَلامِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَبادُلُ الكلامِ بين الناس، كالمحادَثَة العادِيَّةِ وإلقاءِ التَّحيّةِ والاستِفسار، وتَحكُمها قواعدُ الكلامِ وقَوَانينُه التي تختَلِف باختِلاف المجتَمَعات. وللحَدَث الكلامِيِّ مُكوِّناتٌ منها: المقامُ setting، والمشاركون في الكلام participants، والرِّسالةُ message، والقَناةُ channel التي تَحمِل الرِّسالَةَ. ويُطلَق المصطلحُ أيضا على المناسَبَة التي يحدُث فيها الكلامُ، كالمحاضَرات والمناقَشات والمقابَلاتِ الصَحَفيّة، وغيرِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حدث كلامي ","nonDiacriticsLemma":"حدث كلامي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حَدَثٌ كَلامِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

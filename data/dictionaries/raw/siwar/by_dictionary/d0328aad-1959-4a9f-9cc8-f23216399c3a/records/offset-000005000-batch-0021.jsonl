{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fc493236-5a62-48ee-a80d-2ca922d1fe3d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fc493236-5a62-48ee-a80d-2ca922d1fe3d","word":"اللُّغَةُ المَرْجِعُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e20","lexicalEntryId":"fc493236-5a62-48ee-a80d-2ca922d1fe3d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ المَرْجِعُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على اللغة الأمِّ، أو اللغةِ المشتَرَكَة، لمتعلِّمي اللغةِ الثانيةِ أو الأجنبيةِ التي يُرجَع إليها في التَّرجَمة أو التَّفسيرِ أو التَّوضيحِ في قاعَة الدَّرس، في مُقابِل اللغةِ الهَدَفِ target language. فالعربيةُ هي اللغةُ المرجِعُ في فُصول تعلُّمِ الإنجليزيةِ حين يكون الطلابُ عَرَبًا، والإنجليزيةُ هي اللغةُ المرجِعُ في فُصول تعلُّمِ الفَرنسيّةِ حين يكون الطلابُ هُنُودًا من مناطِقَ هنديّةٍ مختَلِفَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة المرجع ","nonDiacriticsLemma":"اللغة المرجع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ المَرْجِعُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e946d076-3dae-47c9-9c4a-f4c5c2e9a061/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e946d076-3dae-47c9-9c4a-f4c5c2e9a061","word":"كِفَايَةٌ لُغَوِيَّةٌ مُتَخَصِّصَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e21","lexicalEntryId":"e946d076-3dae-47c9-9c4a-f4c5c2e9a061","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"كِفَايَةٌ لُغَوِيَّةٌ مُتَخَصِّصَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الكِفايَةُ اللغويةُ التي يتَمتَّع بها المرءُ في لغةِ العِلمِ الذي يُدرِّسه أو المهنَةِ التي يمارِسها، وحينئذٍ يجب أن يُلِمّ بهذه اللغةِ إلمامًا كافيًا. وكذلك المترجِمُ الذي يجب أن يتمتَّع بكِفايَةٍ في لغة النَّصِّ المرادِ ترجَمَتُه، وما تتميَّز به هذه اللغةُ من خصائصَ تركيبيّةٍ ومُعجَميّةٍ وأسلوبيّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"كفاية لغوية متخصصة ","nonDiacriticsLemma":"كفاية لغوية متخصصة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"كِفَايَةٌ لُغَوِيَّةٌ مُتَخَصِّصَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d878a0e2-ca44-4702-b0c7-631fee5ab614/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d878a0e2-ca44-4702-b0c7-631fee5ab614","word":"فِعلٌ كَلامِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e22","lexicalEntryId":"d878a0e2-ca44-4702-b0c7-631fee5ab614","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فِعلٌ كَلامِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الكلامُ بوَصفه وحدَةً وَظيفِيةً في التواصُل اللغويّ. وبحسَب نظريَّةِ الحَدَثِ الكلاميِّ Speech Act Theory، فإن أيَّ كلامٍ مَلفوظٍ يتَضَمَّن نَوعَيْن من المعنى: أحَدُهما ظاهرٌ يتمثَّل في الكلمات والعباراتِ والجُمَلِ وفقَ بناءٍ محدَّد، والآخَرُ معنى تَحقِيقِيٌّ وهو الأثَرُ الذي يُحدِثه الكلامُ في السامِع. والحَدَثُ الكلامِيُّ أنواع، منها: الأمرُ، والطَّلَبُ، والالتِماسُ، والشَّكوَى، والوَعدُ، ويُصنَّف أيضا إلى: كلامٍ مُباشِر، وكلامٍ غيرِ مباشِر. راجع:  @(illocutionary force) و  @(locutionary meaning) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فعل كلامي ","nonDiacriticsLemma":"فعل كلامي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فِعلٌ كَلامِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

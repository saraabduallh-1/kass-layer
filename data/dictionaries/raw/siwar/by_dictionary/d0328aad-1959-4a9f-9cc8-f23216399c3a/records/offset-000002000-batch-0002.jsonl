{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/165b5d26-df23-4231-a0fd-54147a2f4ac1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"165b5d26-df23-4231-a0fd-54147a2f4ac1","word":"عِلْمُ اللُّغَةِ الجِنَائِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9068","lexicalEntryId":"165b5d26-df23-4231-a0fd-54147a2f4ac1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ الجِنَائِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من علم اللغةِ، يُسمى أيضا علمَ اللغةِ القَضائيِّ أو القانونيِّ، يُعنَى بتَطبيق الوَسائلِ اللغوية، من أصواتٍ وكتابَةٍ ونحوِ ذلك، في التحقيق الجِنائيِّ في الجرائم التي يُشَكِّل الاستخدامُ اللغويُّ بعضا من أدِلَّتها. مثالُ ذلك أن يُستَدلَّ بكتابةٍ أو صَوتٍ بعد تحليلِهما على مُرتَكِب الجريمةِ - موضوعِ البَحث - أو على من له علاقَةٌ بها؛ فقد يُثبِت التَّحليلُ اللغويُّ الجِنائيُّ أن الكلامَ المنسُوبَ إلى المتَّهَمِ في التَّحقيقِ مثلا لا يمكن أن يَصدُر منه؛ بسَبَب عُمُرِه، أو مِهنَتِه، أو لهجَتِه، أو طبَقَتِه الاجتِماعية. ويَشمل هذا العلمُ مجالاتٍ منها: إثباتُ هُوِيَّةِ المتحدِّثِ باستِعمال البَصْمَةِ الصوتية، وإثباتُ هُوِيَّةِ الكاتِبِ في حال النُّصوصِ المكتوبة، وتحليلُ اللغةِ أو اللَّهجَةِ الأصليةِ للمُتحدِّث، وتحليلُ المِصداقيَّةِ اللغوية، وإصلاحُ اللغةِ القانونية، وغيرُها. اكتَسَب هذا العلمُ أهميةً كُبرى في المؤسسات القانونية، وظهَرَت مراكزُ وهيئاتٌ متخصِّصَةٌ في هذا المجال؛ كالجَمعِية العالَميةِ لعلم اللغةِ الجِنائيِّ في الولايات المتحدَةِ الأمريكية، والجَمعِية العالَميةِ لعِلم الأصواتِ الجِنائيِّ. راجع:  @(forensic phonetics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة الجنائي ","nonDiacriticsLemma":"علم اللغة الجنائي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ الجِنَائِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a96b52a4-3e25-4df4-b6ff-1e56fb784398/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a96b52a4-3e25-4df4-b6ff-1e56fb784398","word":"لُغَةٌ رَسْمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9069","lexicalEntryId":"a96b52a4-3e25-4df4-b6ff-1e56fb784398","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ رَسْمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ المعتمَدة رَسميًّا في مجتَمَعٍ أو دَولةٍ ما في التعليم والإعلامِ والقَضاءِ والشؤونِ الإداريةِ والوَثائق الرَّسمية، سواء أكانت لغةً أمًّا لجميع أفرادِ المجتَمعِ كالعربية في المملكة العربيةِ السعودية، أم لم تكُن كذلك كالإنجليزية في بريطانيا والولاياتِ المتحدَةِ الأمريكية، والرُّوسيَّةِ في الاتحاد الروسي. وقد تَتَعدَّد اللغاتُ الرسميةُ في البلد الواحدِ إذا تَعدَّدَت فيه القَوميّاتُ أو الأعراقُ. تَلجأ بعضُ الدولِ إلى اختِيار لغةٍ رسميةٍ عامَّةٍ ولغاتٍ رَسميةٍ لكلِّ ناحيةٍ أو منطقةٍ كما في الهند ونيجيريا؛ اعترافًا بالتَّنوُّع اللغويِّ أو الثقافيِّ أو العِرقِيِّ، أو تَجنُّبًا للصِّراعات العِرقيَّةِ داخِلَ البلدَ الواحد. وقد تَتَمَسَّك بعضُ الدولِ بلغةٍ رسميةٍ واحدةٍ على الرّغم من تَعَدُّد اللغاتِ فيها كما في إسبانيا وروسيا. راجع:  @(national language) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة رسمية ","nonDiacriticsLemma":"لغة رسمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDate
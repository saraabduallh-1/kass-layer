{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a93a511a-849e-4775-b463-860920e5a4cf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a93a511a-849e-4775-b463-860920e5a4cf","word":"صِدْقٌ ظَاهِرِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9064","lexicalEntryId":"a93a511a-849e-4775-b463-860920e5a4cf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صِدْقٌ ظَاهِرِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوعٌ من أنواع الصِّدقِ validity الذي هو أحَدُ شُروطِ الاختِبارِ الجيِّد. ويَعنِي أن يَقِيس الاختبارُ ما يجب أن يَقيسَه وفقَ النَّصِّ الظاهِرِيِّ للأسئلة. وهو صِدقٌ مَبدَئيٌّ يعتَمِد على الملحوظات والانطِباعاتِ الشَّخصيةِ من مُحَكَّمِين خارِجِيِّين، أو على سؤال الطلابِ الممتَحَنِين عن صُعوبَة الامتحانِ أو سُهولَتِه، وطُولِه أو قِصَرِه، ودرَجَةِ شُمولِه للمنهَج أو المقرَّر، ونحوِ ذلك. وهذا النوعُ من الصِّدق شَكْلِيٌّ غيرُ حَقيقيٍّ، لا يُعَوَّل عليه كثيرا إلا في اختبارات التَّحصيل؛ لذا يَلزَم الرُّجوعُ إلى الطرُق الأخرى لقِياس صِدقِ الاختبار. راجع:  @(validity) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صدق ظاهري ","nonDiacriticsLemma":"صدق ظاهري","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صِدْقٌ ظَاهِرِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

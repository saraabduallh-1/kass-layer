{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/478cb9d1-f0bf-43ce-bc15-c069d64a5ff0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"478cb9d1-f0bf-43ce-bc15-c069d64a5ff0","word":"مُعَلِّمٌ أَجْنَبِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9061","lexicalEntryId":"478cb9d1-f0bf-43ce-bc15-c069d64a5ff0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعَلِّمٌ أَجْنَبِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ يُطلِقه بعضُ اللغويين التطبيقيِّين على المعلِّم الأجنَبيِّ عن اللغة الهَدَف، والمعلُّمِ الناطِقِ بلغَةٍ غيرِ اللغةِ الهَدَف، وإن كان ناطقا بلغَة المتعلِّمين؛ كمعلِّم اللغةِ العربيةِ لغةً ثانيةً أو أجنبيةً من الناطقين باللغة الأردية أو بالإنجليزية أو بالسواحيلية مثلا، ومعلِّمِ اللغةِ الإنجليزيةِ لغةً ثانيةً أو أجنَبيةً من الناطقين بالعربية أو الأردية. وترى بعضُ المذاهبِ في تعليم اللغاتِ الأجنبيةِ أن المعلِّمَ الأجنبيَّ الناطِقَ بلغَة المتعلِّمين يُفيد طُلابَه في المراحِل المبتَدئة، لكنه قد يكون سببا في تحَجُّر لغتِهم المرحَليَّةِ إذا كان هو المصدَرَ الوَحيدَ للمُدخَلات اللغويةِ التي يتَلَقَّونها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معلم أجنبي ","nonDiacriticsLemma":"معلم أجنبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعَلِّمٌ أَجْنَبِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRo
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f9dff9fc-2d80-4142-9071-25da9feada6e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f9dff9fc-2d80-4142-9071-25da9feada6e","word":"المَرْحَلَةُ العَمَلِيَّةُ المَنْهَجِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9062","lexicalEntryId":"f9dff9fc-2d80-4142-9071-25da9feada6e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَرْحَلَةُ العَمَلِيَّةُ المَنْهَجِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إحدى مراحِلِ النموِّ المعرِفيِّ لدى الطفلِ في نظريَّة جان بياجيه Jean Piaget، تبدأ من سِنِّ الحاديةَ عشرةَ فما فوق. وهي عمَليةٌ عقليةٌ يستطيع فيها الطفلُ إدراكَ المفاهيمِ المجرَّدَة، وفَرْضَ الفُروضِ حولَ اللغة، والاستِنتاجَ والتَّعميمَ. وقد استفاد بعضُ اللغويين من تفسير بياجيه لهذه المرحلَةِ في دراسة العلاقةِ بين النُّمُوِّ المعرِفيِّ والنُّمُوِّ اللغويِّ خلالها، وتَطبيقِ نتائجِها في تعليم اللغات الأمِّ والثانيةِ والأجنبيةِ. راجع:  @(genetic epistemology) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المرحلة العملية المنهجية ","nonDiacriticsLemma":"المرحلة العملية المنهجية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَرْحَلَةُ العَمَلِيَّةُ المَنْهَجِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/59893c1c-7bb2-42b5-bd9f-48d8acfe9818/get-public-entry"},"browse_index_record":{"lexicalEntryId":"59893c1c-7bb2-42b5-bd9f-48d8acfe9818","word":"حَوَاجِزُ ثَقَافِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d9d","lexicalEntryId":"59893c1c-7bb2-42b5-bd9f-48d8acfe9818","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَوَاجِزُ ثَقَافِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اكتساب اللغةِ الثانية، استَعمَله اللغويون الاجتماعيون لوَصف حالَةِ متعلِّمِ اللغةِ الثانيةِ حين تكون الحواجِزُ بين ثقافَتِه وثقافَةِ اللغةِ الهدَفِ قَويَّةً قُوَّةً تمنَعه من التَّثاقُفِ أو التَّطبُّعِ الثقافيِّ مع الناطقين بها، أو تُقلِّل من اختلاطه بهم، مع أنه يَعيش بينهم؛ فتَقِلُّ مُدخَلاتُه اللغوية، وحينئذٍ يَصعُب عليه فَهمُ اللغةِ واستعمالُها استعمالا سليما في سياقاتٍ ومواقفَ طبيعية. راجع:  @(culture shock) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حواجز ثقافية ","nonDiacriticsLemma":"حواجز ثقافية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حَوَاجِزُ ثَقَافِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c7f0d769-f0ab-4150-8d0d-b3acf1c8de11/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c7f0d769-f0ab-4150-8d0d-b3acf1c8de11","word":"عِلْمُ التَّحَكُّمِ الذَّاتِيِّ (السِّيبْرَانِيَّةُ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d9e","lexicalEntryId":"c7f0d769-f0ab-4150-8d0d-b3acf1c8de11","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ التَّحَكُّمِ الذَّاتِيِّ (السِّيبْرَانِيَّةُ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمٌ تأسَّسَ في الأربعينيات من القرن العشرين، واعتَمَد على عدَّة عُلومٍ أهمّها علمُ اللغة، وعلمُ النفس، وعلومُ الحاسِب. يُعنَى بدراسة التَّحَكُّمِ والاتصالِ الداخليِّ والخارِجيِّ لأيِّ جهازٍ أو نظامٍ بَشَرِيٍّ أو آلِيٍّ؛ لتَحقيق اتِّصالٍ واضِحٍ خالٍ من الغُمُوض، وتَحقيقِ التَّكيُّفِ والاستِقرارِ والبَقاء. ويهتَم بدراسة الاتصالِ والسيطرَةِ على أنظِمَة المعلوماتِ الطبيعيةِ والصناعية، خاصةً مقارَنَةَ نظامِ السَّيطرَةِ الكهربائيةِ والميكانيكيةِ بالنظام البيولوجيِّ في الدِّماغ البَشَرِي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم التحكم الذاتي (السيبرانية) ","nonDiacriticsLemma":"علم التحكم الذاتي (السيبرانية)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ التَّحَكُّمِ الذَّاتِيِّ (السِّيبْرَانِيَّةُ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"auto
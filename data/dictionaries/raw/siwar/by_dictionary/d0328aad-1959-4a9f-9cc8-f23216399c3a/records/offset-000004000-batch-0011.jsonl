{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e71a093c-dfbd-46ff-b146-5b7823ab9287/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e71a093c-dfbd-46ff-b146-5b7823ab9287","word":"أُنْمُوذَجُ بِيرْسون وتِيرْني","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b991d","lexicalEntryId":"e71a093c-dfbd-46ff-b146-5b7823ab9287","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ بِيرْسون وتِيرْني","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ من النَّماذِج التَّفاعُليةِ في القراءة Interactive models of reading، طوَّرَه ديفيد بيرسون David وروبرت تيرني Robert Tierney، وعُرِف باسمٍ آخَرَ هو أنموذَجُ القراءةِ والكتابةِ Reading and Writing Model؛ لِرَبْطه القراءةَ بالكتابة في العَلاقَة بين الكاتِبِ والقارئ، نظَرًا إلى تَشابُه العَمَلياتِ الذِّهنِيةِ في المهارَتَين. تُوصَف القراءةُ في هذا الأنموذَجِ بأنها عمَليةٌ مستَمِرَّة، ومناقَشةٌ للمعنى بين القارئِ والكاتبِ اللذَيْن يَشتَرِكان معا في تَكوُّن المعنى، ويَسيران للوُصول إلى ذلك في خطواتٍ متَشابِهَة. فالكاتِبُ يؤلِّف النصَّ في ضَوء معلوماتٍ ومَعانٍ معيَّنة، والقارئُ يَستَخلِص المعلوماتِ والمعانيَ على هيئة نَصٍّ، أي إن الأولَ يَبني النَّصَّ، والآخَرَ يُحَلِّله.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج بيرسون وتيرني ","nonDiacriticsLemma":"أنموذج بيرسون وتيرني","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ بِيرْسون وتِيرْني"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

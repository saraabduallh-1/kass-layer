{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ad9e982b-8f37-4a36-a8ef-7ccfe7bb9042/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ad9e982b-8f37-4a36-a8ef-7ccfe7bb9042","word":"حُبْسَةُ اسْتِبدَاليَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9917","lexicalEntryId":"ad9e982b-8f37-4a36-a8ef-7ccfe7bb9042","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حُبْسَةُ اسْتِبدَاليَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُطلَق على نوعٍ من الحُبسَة أو اضطِرابات اللغةِ المحكيَّة، تظهَر في استعمال المصابِ بها كلماتٍ أو عباراتٍ أو جُمَلًا غريبةً لا تتَّفِق مع الفِكرَة التي يَنوِي التَّعبيرَ عنها، وبتَشوُّهات في حُروف الكلماتِ ومَقاطِعِها، وغالبا ما يَلجأ المصابُ بهذه الحبسَةِ إلى إحلال كلماتٍ محَلَّ كلماتٍ أخرى على نحوٍ غيرِ صحيحٍ ولا مَقبول، الأمرُ الذي يَجعل الكلامَ غيرَ مَفهومٍ لدى السامعين. تؤدِّي الدرَجةُ العُليا من هذه الحُبسةِ إلى رَطانَةٍ غيرِ مفهومةٍ يَصعُب على السَّامع أن يَتعرَّف الكلمةَ في حين لا يَشعر المصابُ بأخطائه. ويُلاحَظ هذا التَّشوُّه في اللغة في بعض الحُبسات النَّاجِمةِ عن إصابة الفَصِّ الصَّدَغيِّ الأيسَرِ وفي الحُبسة الحسِّيَّةِ القِشرِيَّةِ لمنطقَة فِرنيكِه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حبسة استبدالية ","nonDiacriticsLemma":"حبسة استبدالية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حُبْسَةُ اسْتِبدَاليَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/95e2a2b6-8681-40d0-818e-1917954df7b0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"95e2a2b6-8681-40d0-818e-1917954df7b0","word":"الذَّاكِرَةٌ البَصَرِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba186","lexicalEntryId":"95e2a2b6-8681-40d0-818e-1917954df7b0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الذَّاكِرَةٌ البَصَرِيَّةٌ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلَحٌ نفسيٌّ معرِفيٌّ، يُشير إلى نَمَطٍ من أنماط الذَّاكرَةِ، تسمّى أيضا الذَّاكرَةَ التَّصويرِيَّةَ iconic memory، تقوم بإحدى مُهِمّاتِ الذّاكرَةِ قَصِيرَةِ الأَمَد، فتَنقُل الانطباعاتِ البَصَرِيَّةَ إلى المعالَجَة المعرِفيّةِ اللاحِقَة. بيدَ أن أهمَّ وَظائفِها حِفظُ المعلوماتِ مدَّةً لا تزيد على ثانيةٍ واحدة، واستِدعاءِ المعلوماتِ البَصَرِيّةِ مباشرَةً وبسُهولة. وهي مهمَّةٌ ومَطلَبٌ لفَهم المقروءِ واستِيعابِه؛ فالقارئُ يَستَعين بها في تَذَكُّر ما أبصَرَه أو قرَأه في الجُملة السابِقَةِ أو السَّطرِ السَّابِق. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الذاكرة البصرية ","nonDiacriticsLemma":"الذاكرة البصرية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الذَّاكِرَةٌ البَصَرِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

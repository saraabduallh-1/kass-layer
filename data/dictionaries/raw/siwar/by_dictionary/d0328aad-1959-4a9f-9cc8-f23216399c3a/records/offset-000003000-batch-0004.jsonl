{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c6b065e3-493b-406f-87b3-f8ce89932f6b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c6b065e3-493b-406f-87b3-f8ce89932f6b","word":"الإيمَائِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9481","lexicalEntryId":"c6b065e3-493b-406f-87b3-f8ce89932f6b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإيمَائِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الحرَكيةُ أو دراسةُ الحرَكاتِ المجرَّدَة، أي حرَكاتِ الجسمِ التي تؤدِّي معنى إشاريًّا تواصُليًّا. استُعمِلَت مصطَلَحًا في الدراسات اللغويةِ الأمريكيةِ في الخمسينيات من القرن العشرين، والكينيماتُ kinemes فيها أصغَرُ الوَحداتِ التحليليةِ الإشارِية. ويُستعمَل هذا المصطلَحُ أيضا مُرادِفًا للمصطلَح: kinemics، بل إن اللغويين يختَلِفون في المصطلَحاتِ الرَّمزيةِ الإيمائيةِ الثلاثة، وهي: kines ، و: kinemes، و: allokines.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"الإيمائية ","nonDiacriticsLemma":"الإيمائية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإيمَائِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c29dcf8e-0ba7-4d36-a9ac-de8d2efd58bb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c29dcf8e-0ba7-4d36-a9ac-de8d2efd58bb","word":"إرْجَاعٌ حَرَكِيٌّ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9482","lexicalEntryId":"c29dcf8e-0ba7-4d36-a9ac-de8d2efd58bb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إرْجَاعٌ حَرَكِيٌّ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُقصَد به التَّرجيعُ العَضَلِيُّ للنُّطق، وهو التغذيةُ الراجِعةُ (للمتكلِّم) من حَرَكات العَضَلاتِ وأعضاءِ النُّطقِ في أثناء الكلامِ أو الكتابة. فإحساسُ المتكلِّمِ بمَوضِع لِسانِه في أثناء كلامِه عامِلٌ مُهمٌّ في إصدار الكلامِ بوضوح، وتظهَر فائدةُ هذا الإحساسِ في حال تخديرِ اللِّثَةِ لعلاج الأسنان مثلا. ويُقابِل هذا الإرجاعَ الحركيَّ نوعٌ آخرُ من الإرجاع يُسمّى الإرجاعَ السَّمعيَّ auditory feedback، ويتمثّل في مراقبة المتكلمِ كلامَه في أثناء التواصُل مع الآخَرين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إرجاع حركي  ","nonDiacriticsLemma":"إرجاع حركي ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إرْجَاعٌ حَرَكِيٌّ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7d9b40d8-cdc7-4984-a168-a3db394a2e89/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7d9b40d8-cdc7-4984-a168-a3db394a2e89","word":"اللُّغَةُ في التَّعْلِيمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b947e","lexicalEntryId":"7d9b40d8-cdc7-4984-a168-a3db394a2e89","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ في التَّعْلِيمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تَعليمِيٌّ، يُشير إلى وَظيفَة اللغةِ الأمِّ في التعليم العامِّ والجامِعيّ، والأساليبِ التي يجب أن تُقَدَّم بها هذه اللغةُ في المناهِج والمقرَّراتِ والموادِّ التعليمية، وأن تُواكِب النُّمُوَّ اللغويَّ للطلاب لا في المقَرَّرات اللغويةِ وحَسب، وإنما في الرياضيات والعُلومِ الطبيعيةِ والعُلومِ الاجتماعيةِ أيضا، وأن يُستَنَد في ذلك إلى سياسَةٍ لغويةٍ واضِحَةِ المعالِمِ وتخطيطٍ لغويٍّ سَليم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ تَطبيقِيٌّ، يُطلَق على تعليم اللغاتِ الأجنَبيةِ في التعليم العامِّ والجامِعيّ والقَوانين والسِّياساتِ اللغويةِ التي تحْكُمه، حيث تُعَلَّم اللغةُ الأجنبيةُ مُقَرَّرًا مُنفَصِلًا subject matter، أي لا تكون لغةَ التعليمِ في جميع المقرّرات. في هذه الحالَةِ، يُستَخدَم المصطلَحُ بصيغَة الجَمعِ languages، خِلافا للحالَة الأولى التي تُستَخَدَم فيها اللغةُ مُفرَدَةً language. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلَحٌ في السياسة اللغوية، يُشير إلى ضَرورَة تعليمِ الطلابِ في المرحَلة الثانويةِ قواعِدَ لغَتِهم الأمِّ وقوانينَها تعليما صَريحا ومُباشرا، وهو اتِّجاهٌ يَقوده بعضُ اللغويِّين والتربويِّين في البلاد الناطِقَةِ بالإنجليزية. راجع:  @(language awareness) و  @(meta-language) و  @(meta-linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة في التعليم ","nonDiacriticsLemma":"اللغة في التعليم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ في التَّعْلِيمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f8c4366b-4b45-4ad9-865b-581d6fb095f4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f8c4366b-4b45-4ad9-865b-581d6fb095f4","word":"فَقْدُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b947f","lexicalEntryId":"f8c4366b-4b45-4ad9-865b-581d6fb095f4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَقْدُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَقْدُ الفَردِ القُدرةَ على استعمال اللغةِ فَجأةً في الفَهم والكلامِ والكتابة؛ بسبَب حادِثٍ يصيب الدِّماغَ، أو مشكلةٍ في أعضاء النُّطقِ أو أجهزَةِ السَّمع. وقد تُفقَد اللغةُ تدريجيًّا، كما يحدُث للمهاجِرِين الذين يَفقِدون لغاتِهم الأمَّ لعَدَم ممارَسَتِها في البيئة الجديدة. وتُفقَد اللغةُ الثانيةُ أو الأجنبيةُ تدريجيًّا في حال عَدَمِ ممارَسَتِها. وقد يُطلَق المصطلحُ على فَقْد اللغةِ في المجتَمَع حين يَقِلُّ عَدَدُ الناطقين بها أو يَنتَهي. راجع:  @(language attrition/loss) و  @(language death) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فقد اللغة ","nonDiacriticsLemma":"فقد اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَقْدُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f6c269e3-97e9-4ff7-b475-14089faeff9b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f6c269e3-97e9-4ff7-b475-14089faeff9b","word":"صَامِتٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8c9f","lexicalEntryId":"f6c269e3-97e9-4ff7-b475-14089faeff9b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَامِتٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الصوامِتُ هي أحَدُ القِسمَين الرئيسَين للأصوات: الصوامِتُ، والصوائت. ويُعَرَّف الصامِتُ بأنه الصوتُ الذي يَحدُث في أثناء النُّطقِ به اعتِراضٌ في مجرَى الهواء؛ كُلِّيّاً كما في حالتَي الباءِ والدالِ /b/, /d/، أو جُزئيّاً كما في حالتَي السين والفاءِ /s/, /f/. ويدخُل في الصوامتِ الأصواتُ الأنفِيةُ كالميم والنون، والأصواتُ المنحَرِفَةُ كاللام. وتُقَسَّم الصوامِتُ إلى تقسيمات عدَّة، أشهرُها ثلاثة، الأولُ: من حيث وَضعُ الأوتارِ الصوتية، والثاني: من حيث مواضِعُ النُّطقِ (مخارِجه)، والثالثُ: من حيث طريقَةُ النُّطقِ (حالَة مَمَرِّ الهواء). والصوامِتُ في العربية تَشمل جميعَ الأصواتِ التي تمثِّلها الحروفُ الهجائيةُ من الهمزة إلى الياء. وقد يُطلَق المصطلَحُ على الرَّمز الكتابيِّ للصوت الصامِت، تَميِيزا له عن الحَرَكة، ويُسمى حَرفا ساكِنا أو حَرفا صحيحا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"AS","root":null,"wordForms":[],"relatedSenses":[],"search":"صامت ","nonDiacriticsLemma":"صامت","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَامِتٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

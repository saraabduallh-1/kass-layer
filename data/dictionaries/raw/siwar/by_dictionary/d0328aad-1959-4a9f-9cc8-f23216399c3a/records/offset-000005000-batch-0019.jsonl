{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f1515baa-dba2-42bf-bc61-0e1584d82432/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f1515baa-dba2-42bf-bc61-0e1584d82432","word":"مَصْدَرُ الرِّسَالَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9df6","lexicalEntryId":"f1515baa-dba2-42bf-bc61-0e1584d82432","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَصْدَرُ الرِّسَالَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ عَناصِرِ العَمَليَّةِ التَّواصُلِيَّةِ في نَظرية المعلومات، وهي المرحَلَةُ الأولى من هذه العمَلية، وتَتَمَثَّل في المتكلِّم الذي يَختار الرِّسالَةَ message، فيُرسِلها لتَتَحَوَّل إلى إشارَة signal، تَسير عَبرَ وَسَطٍ، كالهاتِف مثلا، ليَستَقبِلَها مُستَقبِلٌ كجِهاز الهاتِفِ مثلا، ثم تَعود مرةً أخرى إلى حالَتها الأولى ليَتَلقّاها المتلَقِّي receiver رسالَةً مَسموعَةً كما أرسَلَها المتكلِّمُ. وفي التواصُل الشَّفَهيِّ الطبيعيِّ يُصبِح المتكلِّمُ سامِعًا والسامِعُ متكلِّمًا في آنٍ واحد. راجع:  @(information theory) و  @(signal) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مصدر الرسالة ","nonDiacriticsLemma":"مصدر الرسالة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَصْدَرُ الرِّسَالَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3a238f8f-f2ad-443f-ae50-383d35ac4ef1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3a238f8f-f2ad-443f-ae50-383d35ac4ef1","word":"الطَّرَائقُ الحَدِيثَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96f6","lexicalEntryId":"3a238f8f-f2ad-443f-ae50-383d35ac4ef1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطَّرَائقُ الحَدِيثَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على طرائق تدريسِ اللغاتِ الأجنبيةِ التي نشَأت حديثًا، واعتمَدَت على أسُسٍ من النظريات الحديثةِ في علم اللغةِ وعلمِ النفسِ وعلمِ الاجتماع. منها الطرائقُ المنبَثِقَةُ من المذهب الاتصاليِّ، والمذهبِ المعرفيِّ الحديث، والمذهبِ السمعيِّ الشفهيِّ، على الرّغم من أن الأخيرَ يُعَدُّ الآنَ مذهبًا تقليديًّا قديمًا، لكن هذه الطرائقَ تُقاس بالطرائق الموغِلَةِ في القِدَمِ والتَّقلِيدِيَّةِ، خاصةً طريقةَ القواعدِ والترجمةِ التي لم تَنبَثِق من نظريةٍ لغويةٍ أو نفسيةٍ أو تعليمية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الطرائق الحديثة ","nonDiacriticsLemma":"الطرائق الحديثة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطَّرَائقُ الحَدِيثَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

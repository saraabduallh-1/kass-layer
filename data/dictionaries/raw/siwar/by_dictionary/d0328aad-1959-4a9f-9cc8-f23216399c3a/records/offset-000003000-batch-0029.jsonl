{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b3e72859-f201-445e-a8c0-9afcbf7bef3a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b3e72859-f201-445e-a8c0-9afcbf7bef3a","word":"لُغَةٌ أُنْمُوذَجِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96fe","lexicalEntryId":"b3e72859-f201-445e-a8c0-9afcbf7bef3a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ أُنْمُوذَجِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ مثاليةٌ افتراضيةٌ، تتمَتَّع بصفاتٍ يَستَحيل أن تجتَمِع في لغةٍ واحدة. فتتَمَتَّع بقواعدَ وقوانينَ منتظِمَةٍ بحيث يكون لكلِّ كلمةٍ معنى واحدٌ ونُطقٌ واحدٌ وشَكلٌ كتابيٌّ واحدٌ، وتكون هذه القواعدُ والقوانينُ مطَّرِدَةً لا تَخرِقها الاستِثناءاتُ ولا الشَّواذُّ. وتكون هذه اللغةُ مألوفةً لدى معظَمِ سُكّان العالَم، وتحوِي أكثَرَ الكلماتِ شيُوعًا وفائدةً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ نظَريٌّ عامٌّ، يُشير إلى اللغة التي يَفتَرِضها الباحثُ اللغويُّ لأغراض المقارَنةِ باللغات الطبيعية؛ فيَنسِب إليها سِماتٍ خاصّةً في أنظِمَتها الصوتيةِ والصرفيةِ والنحويةِ والدّلالية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة أنموذجية ","nonDiacriticsLemma":"لغة أنموذجية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ أُنْ
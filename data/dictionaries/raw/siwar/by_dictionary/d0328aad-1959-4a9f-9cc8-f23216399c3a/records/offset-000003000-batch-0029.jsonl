{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c277028f-9dc6-4b03-9a30-816701f5e669/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c277028f-9dc6-4b03-9a30-816701f5e669","word":"مُقَرَّرٌ مُتَعَدِّدُ الأَبْعَادِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96f9","lexicalEntryId":"c277028f-9dc6-4b03-9a30-816701f5e669","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُقَرَّرٌ مُتَعَدِّدُ الأَبْعَادِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"أسلوبٌ في إعداد الموادِّ التعليميةِ في تعليم اللغاتِ، اقترَحَه كِيثْ جونسون Keith Johnson، يَتَّسِم بالمرونة والتعديلِ في أثناء التطبيق. فيُمكن أن يكون التركيزُ في محتوى المقرَّرِ ومفرَداتِه على التراكيب اللغويةِ مرةً، وعلى الوَظائف مرةً أخرى، وعلى التَّنظيم مرةً ثالثةً، وذلك بحسَب المقامِ أو الموقِفِ اللغويِّ أو حاجَةِ الطلابِ أو غيرِ ذلك. ويمكن أن يُطبَّق أكثَرُ من أسلوبٍ في دَرسٍ واحد؛ فينتَقِل الموقِفُ من تركيبيٍّ، إلى وَظيفيٍّ، إلى غير ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مقرر متعدد الأبعاد ","nonDiacriticsLemma":"مقرر متعدد الأبعاد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُقَرَّرٌ مُتَعَدِّدُ الأَبْعَادِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b1982f25-6bba-43a2-94e0-3b514045af5a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b1982f25-6bba-43a2-94e0-3b514045af5a","word":"لُغَةٌ وُسْطَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96fa","lexicalEntryId":"b1982f25-6bba-43a2-94e0-3b514045af5a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ وُسْطَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ تَقَع في مرحَلة تاريخيةٍ متوسِّطةٍ بين المرحَلَتَين القديمةِ والحديثةِ للُغَة ما؛ كالإنجليزية الوُسطى Middle English الواقعَةِ بين الإنجليزيةِ القديمةِ Old English والإنجليزيةِ الحديثةِ Modern English ، وكذلك الفرنسيةُ الوُسطى Middle French، والألمانيةُ الوُسطى Middle German. والعربيةُ ليس لها مرحَلةٌ تاريخيةٌ يمكن تَميِيزُها عن غيرها لغويًّا كما تُمَيَّز تلك اللغات، لأن معظَمَ مستَوَياتِها اللغويةِ في الاستعمال موجودَةٌ في جميع عُصورِها بدرَجات مختَلِفَةٍ من التطوُّر اللغويِّ الطبيعي، مع المحافظَة على المستوَى الفَصيح. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"ضَرْبٌ أو مستوى من الاستِعمال اللغوي؛ يَظهَر في بعض حالاتِ ازدِواجِيةِ اللغة، ويَقَع وَسطًا بين المستوى الفَصيحِ والمستوى العامِّيِّ للُّغة. مثالُ ذلك اللغةُ العربيةُ التي يتواصَل بها العرَبُ من مختَلِف اللَّهَجات في عَصرِنا الحاضِر، وهي مستوى أدنى من مستوى العربيةِ الفُصحى Classical Arabic، وأدنى قليلا من العربية الفَصيحةِ أو الفُصحى المعاصِرَة Modern Arabic، وأعلى من العامِّيَّات المحكيَّةِ الدَّارِجَة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة وسطى ","nonDiacriticsLemma":"لغة وسطى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ وُسْطَى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/31460d11-ae65-48ed-8ca5-68b6f3538247/get-public-entry"},"browse_index_record":{"lexicalEntryId":"31460d11-ae65-48ed-8ca5-68b6f3538247","word":"أُنْمُوذَجٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96fb","lexicalEntryId":"31460d11-ae65-48ed-8ca5-68b6f3538247","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"قاعدةٌ عامَّةٌ مجرَّدَةٌ في اللغويات الحاسُوبيّة؛ تُبَيِّن تَرتيبَ العَلاقاتِ بين الأشياء، وتكون أنموذَجًا لعِدَّة قواعدَ أخرى أكثَرَ تَفصيلًا، فتَختَصِرها في صِيغَة واحدةٍ تَجمَع الخصائصَ المشتَرَكَةَ بينها. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات","اللغات"],"translations":[]},{"definition":"وَصفٌ يُطلَق على الشَّخص أو الشيءِ المعياريِّ الذي يَسعى المعلِّمُ أو واضِعو المنهجِ إلى أن يَصِل إليه الطالبُ؛ كأن تكون طريقةُ نُطقِ المثقَّفين من الناطقين باللغة الهَدَفِ هي الأنموذجَ الذي يجب أن يَصِل إليه مستوى متعلِّمي اللغةِ في نُطق الأصوات. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج ","nonDiacriticsLemma":"أنموذج","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

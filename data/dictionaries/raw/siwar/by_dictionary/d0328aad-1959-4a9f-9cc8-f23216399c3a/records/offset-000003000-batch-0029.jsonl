{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f28361c7-11ba-4144-bb2a-1b623aa3fdc1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f28361c7-11ba-4144-bb2a-1b623aa3fdc1","word":"الأُنْمُوذَجُ المتَعَدِّدُ الأَبْعَادِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96f1","lexicalEntryId":"f28361c7-11ba-4144-bb2a-1b623aa3fdc1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الأُنْمُوذَجُ المتَعَدِّدُ الأَبْعَادِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ في اكتساب اللغةِ الثانية، طرَحَه عَدَدٌ من اللغويين المعرِفيِّين، يُميِّز بين مجموعَتَين من سِمات اللغةِ المرحَلية. فالمجموعةُ الأولى سِماتٌ تَطوُّريةٌ أو سِماتُ نُموٍّ developmental features، والمجموعةُ الأخرى: سِماتٌ مُتغيِّرةٌ variable features. فالأولى تُكتَسَب بطريقة تَدَرُّجِيَّةٍ وفقَ عَمَلياتٍ محدَّدةٍ نتيجةَ استعمالِ إستراتيجياتٍ معيَّنة، أما الثانيةُ فلا تَرتَبِط بزمن، بل تُكتَسَب في أي مرحَلة، وتعتَمِد على اتجاهاتٍ ومُيُولٍ اجتماعيةٍ وعاطِفيةٍ معيَّنة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الأنموذج المتعدد الأبعاد ","nonDiacriticsLemma":"الأنموذج المتعدد الأبعاد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الأُنْمُوذَجُ المتَعَدِّدُ الأَبْعَادِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/21be104c-1634-45df-b42b-b6b599fd6bc8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"21be104c-1634-45df-b42b-b6b599fd6bc8","word":"مُقَارَنَةُ الطَّرَائقِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96f2","lexicalEntryId":"21be104c-1634-45df-b42b-b6b599fd6bc8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُقَارَنَةُ الطَّرَائقِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الدراسةُ التاريخيةُ المقارَنةُ لطرائق تدريسِ اللغاتِ الأجنبية، والبحثُ في نشأة تلك الطرائقِ وهَيمَنَتِها واندِثارِها، وعلاقَةُ ذلك بنُشوء طرائقَ أخرى على أنقاض الطرائقِ المندَثِرة، وتفَرُّعُ طريقةٍ ما إلى عَدَدٍ من الطرائق، واندِماجُ مجموعةٍ من الطرائق في طريقَةٍ واحدة، ورَبطُ ذلك كلِّه بالمذاهب والنظرياتِ اللغويةِ والنفسيةِ والاجتماعيةِ المعاصِرَة لكلِّ طريقَة. ويَدخُل في ذلك تَفضيلُ طريقةٍ ما على أخرى، وذِكرُ ميزاتِ كلِّ طريقةٍ وعُيوبِها، والمقارَنةُ بين إجراءاتِ الطرائقِ وأنشِطَتِها، ومناسبةُ طريقَةٍ أو طرائقَ معيّنةٍ لتدريس لغةٍ أو مستوى من اللغة أو تدريس مجموعَةٍ من المتعلِّمين الصِّغارِ أو الكِبار. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مقارنة الطرائق ","nonDiacriticsLemma":"مقارنة الطرائق","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُقَارَنَةُ الطَّرَائقِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"}
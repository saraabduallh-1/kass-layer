{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/58057f87-045b-438f-9478-6a53e4dfc0cb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"58057f87-045b-438f-9478-6a53e4dfc0cb","word":"لُغَةٌ مُخْتَلِطَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b96f4","lexicalEntryId":"58057f87-045b-438f-9478-6a53e4dfc0cb","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مُخْتَلِطَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ مكوَّنَةٌ من مفرَدات مُقتَبَسَةٍ من عدَّة لغات؛ بسبَب اختِلاطِ مجموعَةٍ من الناطقين بلغاتٍ مختَلِفةٍ في مكانٍ واحد، أو بسبَب تَماسِّ عَدَدٍ من اللغات في منطقةٍ معيَّنة. ويُطلَق على هذه اللغةِ تسمياتٌ مختَلِفَة، مثلُ: اللغةِ الهَجين pidgin language، واللغةِ المولَّدَة creole language, hybrid language. بَيدَ أن هذه اللغةَ المختَلطَةَ تختَلِف عن الهَجين بأنها تَنشأ في مناطِق التَّماسِّ أو التَّجاوُرِ اللغويّ، في حين تَنشأ الهَجِينُ في مناطِق التواصُل التجاريِّ أو المِهْنيِّ أو التَّجَمُّعِ العُمَّالي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة مختلطة ","nonDiacriticsLemma":"لغة مختلطة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مُخْتَلِطَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

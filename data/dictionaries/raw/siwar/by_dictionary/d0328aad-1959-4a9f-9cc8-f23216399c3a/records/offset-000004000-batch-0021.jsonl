{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/848d3beb-7965-4320-98ef-a27cebd1688f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"848d3beb-7965-4320-98ef-a27cebd1688f","word":"تَخْطِيطُ مَكانَةٍ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a20","lexicalEntryId":"848d3beb-7965-4320-98ef-a27cebd1688f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَخْطِيطُ مَكانَةٍ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في التخطيط اللغويِّ، استَعمَله هارالد هارمان Harald Haarmann لوَصف نَوعٍ من التَّخطيطِ اللغويِّ، يُسمّى أحيانًا تَرقِيَةَ اللغةِ language promotion، تَشرَع فيه السُّلطَةُ السياسيةُ أو الاجتماعيةُ برَفع مُستوَى لغةٍ أو لهجَةٍ دُنيَا لتَصِل بها إلى مرتَبَة لغةٍ أو لهجَةٍ عُليَا أو رَسمية؛ وذلك بتَشجيع الناسِ على استِعمال هذه اللغةِ أو اللّهَجة، وقد تَفرِضها عليهم في وَسائل الإعلامِ ومناهِجِ التعليم، وقد يتمّ ذلك بوَسائل غير رَسمية، كاستعمال اللغةِ في التَّسويق والإعلاناتِ التّجارِية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تخطيط مكانة  ","nonDiacriticsLemma":"تخطيط مكانة ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَخْطِيطُ مَكانَةٍ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

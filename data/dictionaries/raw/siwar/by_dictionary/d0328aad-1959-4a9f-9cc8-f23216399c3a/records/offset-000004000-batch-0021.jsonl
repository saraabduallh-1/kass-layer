{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6d5f6bbd-21ba-4e69-b37b-1251e069f91d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6d5f6bbd-21ba-4e69-b37b-1251e069f91d","word":"لُغَةٌ بُدَائِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a22","lexicalEntryId":"6d5f6bbd-21ba-4e69-b37b-1251e069f91d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ بُدَائِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ التي يتحَدَّث بها شَعبٌ بُدائيٌّ، غالبًا ما تكون مَحكِيَّةً لا مَكتُوبَة، ولا تَرتَبِط بثقافَة عِلميَّةٍ أو أدبيَّة، لكنها تَتَمَتَّع بجميع سِماتِ اللغاتِ الطبيعية. ولا يُفرِّق اللغويون المحدَثون بين اللغاتِ البُدائيةِ واللغاتِ المتحضِّرَةِ من حيث المبادئُ الأساسيةُ والسِّماتُ العامَّةُ للُّغات، ومن حيث وَفاؤها بالحاجات التَّواصُليَّةِ للناطقين بها في بيئتهم، بل إنهم يُنكِرون وُجودَ لغاتٍ بهذا المفهُوم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة بدائية ","nonDiacriticsLemma":"لغة بدائية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ بُدَائِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c523710a-fb02-4807-b7fb-a903ac1ecacc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c523710a-fb02-4807-b7fb-a903ac1ecacc","word":"سِلْسِلَةُ العَرْضِ فالتَّدَرُّبِ فالإنتَاجِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a29","lexicalEntryId":"c523710a-fb02-4807-b7fb-a903ac1ecacc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سِلْسِلَةُ العَرْضِ فالتَّدَرُّبِ فالإنتَاجِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سِلسِلَةٌ أو حَلقاتٌ مُتَتابِعةٌ من الأنشِطة الصَّفِّيَّةِ في تَعليم اللغاتِ الأجنبية، يُقسَّم فيها الدَّرسُ إلى ثلاث مَراحِلَ مُتَتَابِعَةٍ، هي: العَرْضُ presentation، ثم التَّدَرُّبُ أو المِرانُ practice، ثم الإنتاجُ production. فالأولى تَعني عَرضَ المعلِّمِ الدَّرسَ على الطلاب، والثانيةُ تُشير إلى التَّدريبات اللُّغَويَّةِ، كتدريبات الأنماطِ مثلاً، وتُشير الثالثةُ إلى حُرِّيَّة الطالبِ في الحديث. هذه المراحِلُ لا تَختَصُّ بتعليم اللغات، وإنما تَشمل تَدريسَ أنواعٍ مُختَلِفةٍ من التَّخصُّصات، غيرَ أن تَطبيقَها في مجال تعليم اللغاتِ يَعني الرَّجعَةَ إلى الأساليب والأنشِطَةِ التَّقليديَّة، كالتَّكرار والحِفظِ ونحوِ ذلك من الأساليبِ والأنشِطَةِ والإجراءاتِ التي كانت مُتَّبَعَةٍ في الطريقة السَّمعيةِ الشَّفهيَّةِ، وكذلك الأساليبُ والإجراءاتُ الاجتهاديةُ التي لم تَنبَثِق من طَريقَةٍ أو مَذهَبٍ أو نظريّةٍ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"سلسلة العرض فالتدرب فالإنتاج ","nonDiacriticsLemma":"سلسلة العرض فالتدرب فالإنتاج","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سِلْسِلَةُ العَرْضِ فالتَّدَرُّبِ فالإنتَاجِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9c328e36-af39-4736-8205-d6c61b50727f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9c328e36-af39-4736-8205-d6c61b50727f","word":"لُغَةُ الحَيَوَانِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8926","lexicalEntryId":"9c328e36-af39-4736-8205-d6c61b50727f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةُ الحَيَوَانِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ التي يَتَواصَل بها الحيوانُ مع جِنسِه من الحيوانات، وتُسمّى لغةً بالمفهوم العامِّ بوَصفها شَكلا من أشكال التواصُلِ بين مجموعةٍ من المخلوقات، لكنها تختَلِف عن لغة الإنسانِ human language. وكانت لغةُ الحيواناتِ والطُّيورِ والنَّحلِ مما اهتَمَّت به المدرسةُ البنيويةُ السُّلوكيةُ التي كانت مُهَيمِنَةً على الدراسات اللغويةِ النَّفسيةِ في منتَصَف القرنِ العشرين، لكن الاتجاهاتِ اللغويةَ المعرِفيةَ الفِطرِيّة، التي رَفَضَت آراءَ المدرسةِ البنيويةِ السُّلوكيةِ، ركَّزَت على اللغةِ البَشرِيةِ بوَصفها سِمَةً خاصةً بالإنسان دونَ غيرِه من المخلوقات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة الحيوان ","nonDiacriticsLemma":"لغة الحيوان","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةُ الحَيَوَانِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

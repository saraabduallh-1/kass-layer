{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1de8504b-6250-47d7-b977-a30f0a0e5acd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1de8504b-6250-47d7-b977-a30f0a0e5acd","word":"القَنَاةُ السَّمْعِيَّةُ الخَارِجِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fa2","lexicalEntryId":"1de8504b-6250-47d7-b977-a30f0a0e5acd","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"القَنَاةُ السَّمْعِيَّةُ الخَارِجِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصبيٌّ، يُطلَق على الصّماخ الخارِجِيِّ external auditory meatus، الذي هو أحَدُ الأجزاءِ الرئيسَةِ في الأذُن الخارجية. تَقَع هذه القناةُ بين الصِّيوانِ والطَّبلَةِ بطُولٍ قَدْرُه بوصَةٌ واحدةٌ ونِصفُ البُوصَة. وتُشَكِّل تَجويفًا مِرْنانًا يَقوم بدَعم التَّرَدُّداتِ الصَّوتِيَّةِ وتَضخِيمِها لتُناسِب الأجهزةَ السَّمعيةَ الداخِليَّةَ. وتحمي الأجزاءَ الحسّاسَة في الأذُن من الصَّدَمات وتمَنع دُخُولَ الأشياءِ الغَريبةِ إليها بفضل الشُّعَيْراتِ الموجودَةِ في مَدخَل الأذُنِ والمادَّةِ الدُّهنِيَّةِ المعروفَةِ بالصِّملاخ. وسُمِّيَت بالقَناة السَّمعِيةِ الخارِجيَّةِ تَميِيزا لها عن القَناة السَّمعِيَّةِ الداخليةِ التي تخرُج من الأذُن الداخليةِ في العَظْم الصَّدَغيِّ إلى الدِّماغ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"القناة السمعية الخارجية ","nonDiacriticsLemma":"القناة السمعية الخارجية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"القَنَاةُ السَّمْعِيَّةُ الخَارِجِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4d8fbe64-f9fb-48b1-abeb-68bdc54d9f14/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4d8fbe64-f9fb-48b1-abeb-68bdc54d9f14","word":"لُغَةٌ ضِمْنيَّةٌ نِطَاقِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fa3","lexicalEntryId":"4d8fbe64-f9fb-48b1-abeb-68bdc54d9f14","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ ضِمْنيَّةٌ نِطَاقِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغةُ الأمُّ أو اللغةُ الأولى لمعظَم سُكانِ منطقَةٍ أو دولةٍ ما. فالعربيةُ هي اللغةُ الضِّمنِيةُ أو النِّطاقِيةُ للأقطار العربية، لكنها ليسَت لغةً ضِمنيةً لتركيا والصومالِ وجُزُرِ القَمَر. والإنجليزيةُ هي اللغةُ الضِّمنِيةُ أو النِّطاقِيةُ لبريطانيا والولاياتِ المتحدةِ الأمريكيةِ وأستراليا ونيوزيلندا ومُعظمِ أجزاءِ كندا، لكنها ليسَت لغةً ضِمنِيةً لغانا وسنغافورة ونيجيريا. والسياسَةُ اللغويةُ التي تُنَظِّم هذه اللغة تُسمّى سياسةَ اللغةِ الضِّمنيةِ النِّطاقيةِ endoglossic language policy. يُقابِلها اللغةُ غيرُ الضِّمنِيةِ أو غيرُ النِّطاقِيةِ exoglossic (language).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة ضمنية نطاقية ","nonDiacriticsLemma":"لغة ضمنية نطاقية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ ضِمْنيَّةٌ نِطَاقِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7f4ba1b8-a7c9-4546-9358-c35c02fc0398/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7f4ba1b8-a7c9-4546-9358-c35c02fc0398","word":"تارِيخٌ خَارِجِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f8b","lexicalEntryId":"7f4ba1b8-a7c9-4546-9358-c35c02fc0398","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تارِيخٌ خَارِجِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التاريخُ الخارِجِيُّ للغةٍ ما، ويُقصَد به الحديثُ عن العوامِل ذاتِ العلاقةِ باللغة من الناحية التاريخيةِ والاجتماعيةِ والسياسية، في مُقابِل تاريخِها الداخليِّ المتمثِّلِ في النظام التركيبيِّ الداخليِّ أو القواعد. فمن التاريخ الخارجيِّ للُّغَة العربيةِ مثلا القَولُ بأنها دَخَلت مصرَ قبلَ الفَتحِ الإسلاميِّ، وأنها دَخَلت شمالَ إفريقيا نتيجةَ الفَتحِ الإسلاميِّ. ومن التاريخ الخارجيِّ للُّغَة الأرديةِ القَولُ بأنها نشأت لغةً هَجينًا من العربية والفارِسيةِ ولغاتٍ أخرى مَحَلِّيَّةٍ في القارَّة الهندِيَّة، ثم تحوَّلَت إلى لغةٍ موَلَّدَة، ثم إلى لغةٍ طبيعيةٍ مِعيارِية. ومن التاريخ الخارجيِّ للإنجليزية القَولُ بأنها دَخَلت بريطانيا على أيدي المهاجِرين وأنها كُتِبَت بالألفبائية الرومانيةِ حين كان الناس يتكلَّمون الإنجليزيةَ والفرنسيةَ في العُصور الوُسطَى، وأنها دَخَلت أمريكا الشماليةَ في القرن السابع عشر، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تاريخ خارجي ","nonDiacriticsLemma":"تاريخ خارجي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تارِيخٌ خَارِجِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2b625803-8f01-4305-95b5-8d3d1ff0cf58/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2b625803-8f01-4305-95b5-8d3d1ff0cf58","word":"الإنجلِيزِيَّةُ لُغَةً ثَانِيَةً","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f8c","lexicalEntryId":"2b625803-8f01-4305-95b5-8d3d1ff0cf58","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنجلِيزِيَّةُ لُغَةً ثَانِيَةً","lemmaType":"MWE","pattern":" ","senses":[{"definition":"استعمالُ الأجانبِ اللغةَ الإنجليزيةَ أو تعلُّمُهم إياها لغةً ثانيةً في بلدها؛ كاستعمال المهاجرين والطلابِ الأجانبِ اللغةَ الإنجليزيةَ في بريطانيا وأمريكا وكندا وأستراليا في المدرسة والجامعةِ والحياةِ العامَّة، إلى جانب لغاتِهم الأمِّ في المنزِل. وتُقابَل هذه الحالَةُ عادةً بحالَةِ تعلُّمِها أو استعمالهِا خارجَ بلدِها؛ كالإنجليزية في المملكة العربيةِ السعوديةِ ومصرَ واليَمنِ والعراق، حيث تُدَرَّس في مقرَّراتٍ منفَصِلَة، وتُستَعمَل في مجالاتٍ محدودَة، أي إنها ليسَت لغةَ التواصُلِ اليَومِيّ للمواطِنين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"استعمالُ اللغةِ الإنجليزيةِ في بلدٍ ما لغةً رسميةً، أو شِبهَ رسميةٍ، في التعليم والإعلامِ والتجارةِ والدوائرِ الحكوميةِ وفي بعض مجالاتِ التواصُل اليَوميِّ، من غير أن تكون اللغةَ الوحيدةَ في البلَد أو اللغة الأمَّ للمواطِنين، كما هي الحالُ في سنغافورة والفلبين والهند ونيجريا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"استعمالُ الإنجليزيةِ في بلدٍ ما استعمالا يأتي في الدَّرَجة الثانيةِ بعد اللغة الأمِّ لكنه لا يُنافِسها في جميع مجالاتِها؛ كاستعمال الإنجليزيةِ في ألمانيا واليابانِ والمملكةِ العربيةِ السعودية. ويَشيع هذا المصطلحُ لدى اللغويين الأمريكيين، ويُشبه المصطلحَ البريطانيَّ: الإنجليزيةُ لغةً أجنبيةً EFL","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية لغة ثانية ","nonDiacriticsLemma":"الإنجليزية لغة ثانية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنجلِيزِيَّةُ لُغَةً ثَانِيَةً"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d94fb180-df49-4a7c-9abe-66f29f9437d1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d94fb180-df49-4a7c-9abe-66f29f9437d1","word":"الإنجلِيزِيَّةُ لأَغْرَاضٍ أكَادِيمِيَّةٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f8d","lexicalEntryId":"d94fb180-df49-4a7c-9abe-66f29f9437d1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنجلِيزِيَّةُ لأَغْرَاضٍ أكَادِيمِيَّةٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجالٌ من مجالات تعليمِ اللغةِ الإنجليزيةِ وتَعلُّمِها، يُرَكَّز فيه على المفرَدات والعباراتِ والتراكيبِ والمصطَلَحاتِ ذاتِ العلاقَةِ بالدراسة العلميةِ المتخصِّصَةِ في مجالٍ معيَّن، بدلا من الاهتِمام بالجوانب النظريةِ أو الجوانبِ التواصُليةِ العامَّة. وفيه يُختار المحتَوى اللغويُّ من الموادِّ العلميةِ المستَهدَفَة؛ كالهندسة والفيزياءِ والكيمياءِ وعلومِ الحاسبِ والاقتصادِ والطِّب، ثم يُعَدُّ ويُقَدَّم للطلاب في ضَوء حاجاتِهم الأكاديمية. وتَنتَشِر في الإنجليزية أنواعٌ من الموادِّ والمقرَّرات التعليمةِ تُنسَب إلى المجال الأكاديميِّ الذي تخدمه، مثلُ: English for science, English for computer science, English for nursing, English for math.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية لأغراض أكاديمية ","nonDiacriticsLemma":"الإنجليزية لأغراض أكاديمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنجلِيزِيَّةُ لأَغْرَاضٍ أكَادِيمِيَّةٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2ebf5b02-11f3-4435-8603-8ad3f07561c0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2ebf5b02-11f3-4435-8603-8ad3f07561c0","word":"اقْتِضَاءٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f8e","lexicalEntryId":"2ebf5b02-11f3-4435-8603-8ad3f07561c0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اقْتِضَاءٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ مَنطِقيٌّ استُعمِل في التحليل الدّلالي، يُشير إلى عَلاقَةِ تَلازُمٍ دلاليٍّ بين جُملَتَين أو أكثَرَ بمَعزِلٍ عن أيِّ سياق، أي كَون صِدقِ قَولٍ ما يَتبَع صِدقَ قَولٍ آخَرَ من الناحية المنطِقِية. فمَعرِفتُنا لجُملةٍ ما أنها صَحيحةٌ تدُلنا على صِحَّة الجُملةِ التاليةِ لها، أي إن صحَّةَ الجُملةِ الثانيةِ نتيجةٌ لصِحَّة الأولى. فإذا كانت الجُملة: (سوفَ أشتِري حِصانا) صحيحةً فهذا يَستَلزِم أن تكون جُملةُ: (سوفَ أشتَري حيوانا) صحيحةً أيضا. فالجُملةُ الأولى مستَلزِمَةٌ للثانية، والثانيةُ لازِمَةٌ للأولى. وقد يكون الاستِلزامُ عَكسِيًّا؛ فجُملَةُ: رأيتُ محمدا يَجري في الساعة السابعةِ صباحا، تَستلزِم أن جُملَةَ: رأيتُ محمدا نائما في الساعة السابعةِ صباحا، غيرُ صَحيحَة. وهذا الاستِتباعُ مَعنَوِيٌّ دلاليٌّ لا يعتَمِد على السِّياق.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"اقتضاء ","nonDiacriticsLemma":"اقتضاء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اقْتِضَاءٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

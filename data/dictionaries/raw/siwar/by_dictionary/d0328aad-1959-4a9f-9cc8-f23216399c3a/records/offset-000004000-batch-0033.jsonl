{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/36ef0528-bc59-4dbf-a51d-ceea523d0b17/get-public-entry"},"browse_index_record":{"lexicalEntryId":"36ef0528-bc59-4dbf-a51d-ceea523d0b17","word":"إعَادَةُ البِنَاءِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b46","lexicalEntryId":"36ef0528-bc59-4dbf-a51d-ceea523d0b17","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إعَادَةُ البِنَاءِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُطلَق على دراسَة اللغةِ دراسَةً تاريخيَّةً مُقارَنَة؛ لإحياء لغةٍ مَيّتَة، أو لمعرِفَة مَرحَلَةٍ أو مَراحِلَ مَجهُولَةٍ من لغة مُعيَّنة أو لَهجَةٍ من اللَّهَجات المندَثِرَة لتلك اللغة. وإحياءُ لغةٍ مَيّتَةٍ يَتَطَلَّب دراسَةَ اللغاتِ الشَّقيقَةِ لها أو القَريبَةِ منها من خلال المقارَنَةِ الخَارِجِيَّةِ أو إعادَةِ البِناءِ بالمقارَنَة comparative reconstruction. أما إحياءُ لَهجَةٍ من لَهَجات لغةٍ معيَّنةٍ أو إحياءُ مَرحَلَةٍ مَجهولَةٍ من مَراحِلها فيكون بالدِّراسة الدَّاخِليةِ للغة internal reconstruction. وقد شَهِد العَصرُ الحديثُ نماذجَ كثيرةً من بَعث لُغاتٍ ولَهَجاتٍ مَيتَةٍ لأهداف سياسية وثقافية واجتماعية. يُطلَق المصطلحُ بهذا المعنى أيضا على عمَلية إعادَةِ التركيبِ اللغويِّ إلى أصله التارِيخي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إعادة البناء ","nonDiacriticsLemma":"إعادة البناء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إعَادَةُ البِنَاءِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6bb1357c-08fb-48fb-870c-05d0611e703c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6bb1357c-08fb-48fb-870c-05d0611e703c","word":"التَّجْدِيدِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b47","lexicalEntryId":"6bb1357c-08fb-48fb-870c-05d0611e703c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّجْدِيدِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"فَلسَفَةٌ تَربَويَّةٌ ترى أن التَّربيةَ هي إعادةُ البِناءِ الثَّقافيِّ والاجتِماعيِّ في المجتَمَع وتَشكِيلِه وتَكيِيفِه، وأن القِيَمَ الأكاديميَّةَ يجب أن تَصُوغ الإنسانَ صِياغَةً جديدةً وتُكَيِّفَه وتُسَيِّرَه بدَلا من أن يُسَيِّرها. وتُقابِلها الفَلسَفَةُ التَّقَدُّميَّةُ progressivism التي تَرى أن القِيَمَ الأكاديميَّةَ يجب أن تُسَخَّر لخِدمة الإنسان، وأن الموادَّ الدراسيةَ يجب أن تُكَيَّف وفقا لتَطوُّر مَعرِفةِ الإنسانِ لنفسه ولعالَمِه، وأن تكون وسائلَ وخبراتٍ تُعِينه على الاعتِماد على نفسه. راجع:  @(progressivism) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"التجديدية ","nonDiacriticsLemma":"التجديدية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّجْدِيدِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e6802371-b4c4-45cf-abb3-0eb7f92d073a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e6802371-b4c4-45cf-abb3-0eb7f92d073a","word":"نَحْوٌ مَرْجِعِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b49","lexicalEntryId":"e6802371-b4c4-45cf-abb3-0eb7f92d073a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَحْوٌ مَرْجِعِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النَّحوُ الذي يُقدِّم مَعلوماتٍ نَظريةً عن اللغة الهَدَف، ويَتَضَمَّن قواعدَ اللغةِ بتَفصيلاتها ومَسائلِها وأمثِلَتِها، سواء أكانت هذه القواعدُ مُهمَّةً لتعلُّم اللغةِ وفَهمِها واستعمالِها أم كانت نَظريّةً فَلسَفيَّة، وغالبا ما يَتَمَثَّل في كتاب أو مَجموعةِ كُتُبٍ مَرجِعِيَّةٍ يَتَّفِق عليها المختَصُّون من أهل اللغة. يُسمّى هذا النحوُ أحيانا بالنحو المعياريِّ prescriptive grammar في مُقابِل النحوِ الوَصفيِّ descriptive grammar. يَنطبق هذا الوَصفُ المرجِعيُّ المعيارِيُّ على كتُب النحوِ العربيِّ التراثيِّ، وكتُبِ النحوِ التقليديِّ الغربيِّ traditional grammar التي يَرجِع إليها من يَشتَبه عليه أمرٌ أو مسألةٌ من مسائل النحوِ والصرف. يُقابِله النَّحوُ التَّطبيقيُّ التَّعليميُّ pedagogical grammar الذي يُرَكِّز على ما يُفيد في تَعلُّم اللغةِ واستِعمالِها استِعمالًا سَليمًا، بما في ذلك التدريباتُ اللغوية، ويَتَمَثَّل هذا في الكُتُب التَّعليميَّةِ المقرَّرَةِ على الطلاب. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نحو مرجعي ","nonDiacriticsLemma":"نحو مرجعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَحْوٌ مَرْجِعِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

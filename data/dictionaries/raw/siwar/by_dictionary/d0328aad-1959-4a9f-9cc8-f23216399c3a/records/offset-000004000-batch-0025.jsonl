{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/74d3a22d-2550-4fd9-a395-81ff90fe7a9c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"74d3a22d-2550-4fd9-a395-81ff90fe7a9c","word":"فَشَلٌ لُغَويٌّ تَدَاوُليٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a7b","lexicalEntryId":"74d3a22d-2550-4fd9-a395-81ff90fe7a9c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَشَلٌ لُغَويٌّ تَدَاوُليٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في اكتساب اللغةِ الثانية، استعمَلتْه جيني توماس Jenny Thomas للإشارة إلى سِمَةٍ في اللغة المرحَلِيَّةِ لمتعلِّم اللغةِ الثانية، تَظهَر حين يُحاوِل (المتعلِّمُ) أداءَ حَدَثٍ كَلامِيٍّ سَليمٍ بوسائلَ لُغويَّةٍ خاطِئة، وتُسمّى تلك السمةُ أيضا pragmatic linguistic failure. يُقابله الفَشَلُ الاجتماعيُّ التَّدَاوُليُّ social-pragmatic failure الناتجُ من عدَم إلمامِ المتعلِّمِ بالعوامِل الاجتماعيةِ في التواصُل باللغة الهدَف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فشل لغوي تداولي ","nonDiacriticsLemma":"فشل لغوي تداولي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَشَلٌ لُغَويٌّ تَدَاوُليٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/98f901c0-a924-44d8-a11d-b0bcf84f8d0d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"98f901c0-a924-44d8-a11d-b0bcf84f8d0d","word":"المَقَامِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a7c","lexicalEntryId":"98f901c0-a924-44d8-a11d-b0bcf84f8d0d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَقَامِيَّةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"فرعٌ من علم اللغة، أو علمِ العَلاماتِ أو الرموز semiotics، يُنسَب المصطلحُ إلى تشارلز موريسCharles Morris  حين اقتَرَحَه في الثلاثينيات من القرن العشرين، ثم تطوَّرَت دراساتُه في أواخِر القرنِ العشرين. ويُعَدّ بول جرايس Paul Grice عرّابَ التَّداوليةِ في النصف الثاني من القَرن العشرين. يوصَف هذا العلمُ الآنَ بأنه نقطَةُ التِقاءِ فروعِ اللسانيات، تلتَقي فيه  اللسانياتُ الاجتماعيةُ واللسانياتُ النفسيةُ وعلمُ الدّلالَة، واللسانياتُ الأسلوبية، وتحليلُ الخِطابِ وغيرُها. تُرجِم في اللغة العربية إلى عدَّة مصطلحات منها: السِّياقِيَّةُ والموْقِفِيَّةُ والواقِعِيَّةُ والنَّفعِيَّةُ/البَراجماتِيَّةُ والمقامِيَّةُ أو علمُ المقامِ وعلمُ الدّلالةِ العَمَليَّةِ وعلمُ مقاصِدِ الكلامِ، وعلمُ الرُّموزِ التَّواصُليُّ، إضافةً إلى التَّداوُلِيَّة. يُعنَى هذا العلمُ بدراسة كيفيَّةِ استِعمالِ اللغةِ في التَّواصُلِ بطريقةٍ رَمزيَّةٍ يَفهَمها السَّامِعُ حسبَ ما يَقتَضيه المقامُ، ويتَطَلَّب معرِفةَ العَلاقةِ بين الجُملةِ والسِّياقِ اللُّغويِّ والمقامِ الذي قِيلَت فيه الجُملةُ، وهذا كلُّه يتطلَّب فَهمَ الواقِعِ الاجتماعيِّ فَهمًا حقيقيًّا. فهو دراسةٌ ما يَحمِله الكلامُ من معنى يَقصده المتكلِّمُ في مَوقِف معيَّنٍ ويَفهَمه السَّامِعُ، مع أن ظاهرَ الكلامِ لا يدُلّ على هذا المعنى. فقولُ المتكلِّم: الجوُّ حارٌّ هنا، لا يَعني الإخبارَ بحرارَة الجَوِّ، وإنما يَعني طلبَ تَشغيلِ مُكيِّفِ الهواء، أو فَتحَ النَّافذةِ. وقولُ المتَّصلِ بالهاتف: هل محمدٌ هنا؟ لا يَقصد السُّؤالَ عن وُجودِ محمدٍ وإنما يَطلُب الحديثَ معه. وجملةُ: هنالك سيَّارةٌ قادِمةٌ، قد تُعبِّر عن عِدَّة معانٍ بحسب المقامِ لا بحسب معناها اللغويِّ الأصليِّ: فقد يُقصَد بها تَنبيهُ شَخصٍ ما أو تحذيرُه من قَطْعِ الشَّارع، وقد تُقال للتَّفاؤل حين يَنتَظِر جَماعةٌ من الناس شخصا تأخَّر وصولُه، وهكذا. تُقابَل التَّداوُليَّةُ أحيانا بعلم الدّلالةِ semantics؛ لأن الثانيةَ غالبا ما تهتمّ بدراسة المعنى الأصليِّ أو المعجَميِّ من غير نَظَرٍ إلى الاستِعمال والوَظيفةِ التَّواصُليَّةِ للكلام. شَهِدَت التَّدواليةُ نُموًّا مطَّرِدًا في العُقود الأخيرة، وتفرَّعَت فروعًا مختِلفَة؛ كالتدواليَّة الاجتِماعيةِ sociopragmatics، والتداوليةِ اللِّسانيّةِ pragmalinguistics، والتداوليةِ العامَّةِ general pragmatics، والتداوليةِ الأدَبيةِ literary pragmatics، والتداوليةِ التَّطبيقيةِ applied pragmatics. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"المقامية ","nonDiacriticsLemma":"المقامية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَقَامِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

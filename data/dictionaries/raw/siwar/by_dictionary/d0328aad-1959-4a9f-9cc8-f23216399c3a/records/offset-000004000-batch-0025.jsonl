{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7ff857a3-7977-453a-9509-6cb50f89a3d8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7ff857a3-7977-453a-9509-6cb50f89a3d8","word":"نَحْوٌ مِعْيَارِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a7f","lexicalEntryId":"7ff857a3-7977-453a-9509-6cb50f89a3d8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَحْوٌ مِعْيَارِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حديثٌ، يُطلَق على القواعد التَّقليديَّةِ التي تَستَنِد إلى كُتُب النَّحوِ والصَّرفِ في تحديد ما هو صَحيحٌ أو خَطَأٌ في لغةٍ ما، كقواعد اللغةِ العربيةِ الفُصحى عامَّةً، وقواعدِ اللغةِ الإنجليزيةِ حين تُعرَض في موادَّ تَعليمية. يُطلَق على هذه القواعدِ المعياريةِ أيضا: normative grammar، في مقابِل القواعدِ الوَصفيَّةِ descriptive grammar أو النَّحوِ الوَصفيِّ الذي يُعنَى بوَصف الاستِعمالِ اللغويِّ لِلُغةٍ ما أو لَهجَةٍ ما في زَمنٍ محدَّد، وَصفًا عِلميًّا مَوضوعيًّا، يَهدِف إلى الكَشف عن طبيعة اللغةِ المدروسَة. راجع:  @(descriptive grammar) و  @(normative grammar) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نحو معياري ","nonDiacriticsLemma":"نحو معياري","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَحْوٌ مِعْيَارِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/936935ad-3557-48e8-8b53-a4dc7e6a8806/get-public-entry"},"browse_index_record":{"lexicalEntryId":"936935ad-3557-48e8-8b53-a4dc7e6a8806","word":"مَا قَبْلَ الفِعْلِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a80","lexicalEntryId":"936935ad-3557-48e8-8b53-a4dc7e6a8806","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَا قَبْلَ الفِعْلِ","lemmaType":"MslCom","pattern":" ","senses":[{"definition":"عنصُرٌ لغويٌّ أو مورفيمٌ يَسبِق جِذرَ الفعلِ لتَكوين وحدةٍ مُعجَميَّةٍ، مثلُ: re- و: pre- في الكلمَتَين الإنجليزِيَّتَين: remake و precook على التَّوَالي. هذا النَّوعُ يختَلِف قليلًا عن السَّوابِق prefixes، التي تُشابِهه في البناء والوَظيفَة، من ناحيَتَين: إحداهما أن مُستوى النَّبرِ فيها أعلى من النَّبر في السَّوابق، والأخرى أنها قد تَتَّصِل بالفعل كالسَّابِقة، لكنها قد تَنفَصِل عنه في بعض اللغاتِ، كالألمانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ما قبل الفعل ","nonDiacriticsLemma":"ما قبل الفعل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَا قَبْلَ الفِعْلِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a888de6f-c27c-4f28-914a-ae0f4b90771e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a888de6f-c27c-4f28-914a-ae0f4b90771e","word":"مَعْنًى رَئيسٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a81","lexicalEntryId":"a888de6f-c27c-4f28-914a-ae0f4b90771e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَعْنًى رَئيسٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ معجَميٌّ دلاليٌّ، يَعني ما تَدُلُّ عليه الكلمةُ في أصل وَضعِها وفقًا لمعناها المعجَميِّ الأوَّليِّ العامِّ، يُقابِله المعنى الثانويُّ للكلمة الذي يَنِمُّ عن انتِساب المتكلِّم إلى طَبَقَةٍ اجتماعيةٍ معيَّنَةٍ أو منطَقَةٍ جُغرافيَّةٍ مُحَدَّدَة، ويُقابِله أيضا المعنى الخاصُّ بمجالٍ مُعيَّن.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معنى رئيس ","nonDiacriticsLemma":"معنى رئيس","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَعْنًى رَئيسٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/87777d20-a85a-4580-95e0-85daa8c31690/get-public-entry"},"browse_index_record":{"lexicalEntryId":"87777d20-a85a-4580-95e0-85daa8c31690","word":"ذَاكِرَةٌ أوَّليَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a82","lexicalEntryId":"87777d20-a85a-4580-95e0-85daa8c31690","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ذَاكِرَةٌ أوَّليَّةٌ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ نفسيٌّ، يُطلَق على الذَّاكِرَة قَصيرَةِ الأمَدِ short-term memory، وهي الذاكِرَةُ التي تَستَقبِل المعلوماتِ وتَحفَظها مدَّةً قصيرَةً جدًّا حتى تَتِم مُعالَجَتَها، فتُرسَل حينئذٍ إلى الذاكِرَة طَويلَةِ الأمَدِ long-term memory أو تُنسَى. هذه الذاكِرَةُ مهمَّةٌ لمتعلِّمي اللغةِ بصِفَةٍ خاصَّة؛ لأن الفَهمَ والحديثَ يتطلَّبان ذاكِرَةً أوَّلِيَّةً قابِلَةً للاحتِفَاظ بالجُملة وما يَرتَبِط بها، من حيث المعنى والمبنى، مدَّةً كافيةً.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ حاسوبيٌّ، يُشير إلى ذاكِرَةٍ صغيرَةٍ سريعَةِ التوصُّلِ في نظام الحاسوبِ الذي تكون ذاكِرَتُه الرئيسَةُ ثانويةً وبَطيئة، خلافا للذاكِرَة الرئيسَةِ main memory التي تتعامَل مع وحدَة التَّشغيلِ المركَزِيَّة، التي تُخزن فيها وتُستَرجَع منها البرامِجُ والبياناتُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ذاكرة أولية ","nonDiacriticsLemma":"ذاكرة أولية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ذَاكِرَةٌ أوَّليَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

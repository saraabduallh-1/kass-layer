{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/73407d4d-e9d3-4c51-b462-209f6b70320d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"73407d4d-e9d3-4c51-b462-209f6b70320d","word":"الوَقْتُ اللازِمُ للْمُعَالَجَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a84","lexicalEntryId":"73407d4d-e9d3-4c51-b462-209f6b70320d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الوَقْتُ اللازِمُ للْمُعَالَجَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُشير إلى الوَقت أو الزَّمنِ الذي يَستَغرِقه المرء في مُعالجة الجُملةِ في الكلام من حيث الفَهمُ والأداء. يختَلِف هذا الوَقتُ من شَخصٍ لآخَر، ومن لغةٍ لأخرى، ومن الناطِق باللغة إلى متعلِّمها. فمن حيث الفَهمُ وُجِد أن تَعديلَ الناطِقِ باللغة من طريقَته في الحديث لمسايَرَة المتعلِّم يُعطِي المتعلِّمَ مَزيدًا من الوَقت لمعالَجَة الكلامِ ومن ثم فَهمه؛ كأن يُطيلَ الناطِقُ باللغة في الوَقَفات pauses، أو يُبطئَ في النُّطق لتتَّضِح مخارِجُ الأصواتِ وتتَحَدَّدَ بداياتُ الكلماتِ ونِهاياتُها، أو يُقَلِّلَ من اختِلاس الحَرَكات، أو يَستَخدمَ الجُمَلَ القصيرَةَ والبَسيطَة. ومن حيث الأداءُ أو الكلامُ فإن الوَقتَ اللازِمَ لمعالَجَته يختَلِف أيضا من شَخصٍ لآخَر ومن لغةٍ لأخرى، ومن نَمَطٍ لآخَر؛ فأداءُ النَّفيِ مثلا غيرُ أداءِ الإثبات، وأداءُ الجُملَةِ المبنيَّةِ للمَعلوم غيرُ أداءِ الجُملَةِ المبنيَّةِ للمَجهول، وهكذا. استخدَم الباحثون في علم اللغةِ النفسيِّ هذا الاختلافَ في الاستِدلال على مسائلَ نحويةٍ تحويليةٍ، ويتلَخَّص في وُجود تحويلاتٍ معيَّنةٍ تتطلَّب وَقتًا أطوَلَ مما تتطلَّبه تحويلاتٌ أخرى؛ بحسَب ما إذا كانت الجُملةُ نواةً أو معقَّدةً، مُثبَتةً أو مَنفيَّةً، مبنيَّةً للمَعلومِ أو مبنيَّةً للمَجهول، أو غيرَ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الوقت اللازم للمعالجة ","nonDiacriticsLemma":"الوقت اللازم للمعالجة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الوَقْتُ اللازِمُ للْمُعَالَجَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8c1b2645-6a02-425c-8ba6-d4917e6aa5a7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8c1b2645-6a02-425c-8ba6-d4917e6aa5a7","word":"نَغْمَةٌ مُنْبِئَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a85","lexicalEntryId":"8c1b2645-6a02-425c-8ba6-d4917e6aa5a7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَغْمَةٌ مُنْبِئَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَغْمَةٌ تَدُلّ على أن الكلامَ يَتَضَمَّن مَعلومَةً جديدةً يُريد المتكلِّمُ أن يُخبِر بها المخاطَبَ. تُقابِلها النَّغمةُ المُحِيلَةُ referring tone التي تَدُلّ على أن الكلامَ لا يَتَضَمَّن مَعلومَةً جديدةً يُريد المتكلِّمُ أن يُخبِر بها المخاطَبَ، وإنما يَتَضَمَّن مَعلوماتٍ يَعرِفها الطَّرَفان؛ فينَبِّه المتكلِّمُ المخاطَبَ إليها، أي يُحِيلُه إلى ما يَشتَرِكان فيه من معلوماتٍ سابِقَة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نغمة منبئة ","nonDiacriticsLemma":"نغمة منبئة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَغْمَةٌ مُنْبِئَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/279f8d7b-7a58-4bc9-a291-d0426f735ef0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"279f8d7b-7a58-4bc9-a291-d0426f735ef0","word":"مُحَدِّدُ حَذْفِ الضَّمِيرِ الفَاعِلِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9a86","lexicalEntryId":"279f8d7b-7a58-4bc9-a291-d0426f735ef0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُحَدِّدُ حَذْفِ الضَّمِيرِ الفَاعِلِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ في القواعد الكُّلِّيَّة، يُقصَد به أيُّ مُتَغَيِّرٍ يُحَدِّد ما إذا أمكَن حَذفُ الفاعِل أو إضمارُه في الجُملة المثبَتَةِ. وتختَلِف المتَغَيِّراتُ في هذا الأمرِ باختِلاف اللغاتِ في حُدودٍ مُعَيَّنَة؛ فبعضُ اللغاتِ، كالعربية والإيطاليةِ والإسبانيةِ، تُجِيز أو تُوجب حَذفَ الفاعِل من الجُمْلةِ المـثبَتَة، مثل قولنا: (أُصلِّي) أو (نُصلِّي)، فالفاعل هنا ضميرٌ مستترٌ وجوبًا، وبعضُها لا تُجيز حذفَه، كالفرنسية والإنجليزية والألمانية. والاختِلاف بين اللغات في هذا الجانِبِ مُهِمٌّ في البَحث في اكتِساب الطِّفلِ لغتَه الأمَّ، ولاسيَّما البحثُ في كيفيَّة بناءِ الطفلِ مُتَغَيِّرَ القواعدِ الكُلِّيَّةِ لتُناسِب لغتَه الخاصَّةَ. والاختِلافُ مُهِمٌّ أيضا في البَحث في اكتِساب اللغةِ الثانية، خاصةً إذا كان مُتَغَيِّرُ اللغةِ الأمِّ يختَلِف عن مُتَغَيِّر اللغةِ الهدَف؛ حيث يَحتاج المتعلِّمُ إلى إعادَة بِناءِ المتَغَيِّرِ؛ كما يحدُث في اكتِساب الناطق بالإنجليزية للُّغة العربيةِ أو الإسبانيةِ مثلًا","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"محدد حذف الضمير الفاعل ","nonDiacriticsLemma":"محدد حذف الضمير الفاعل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُحَدِّدُ حَذْفِ الضَّمِيرِ الفَاعِلِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/93e1d915-9f71-4380-93d7-1d90a882357e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"93e1d915-9f71-4380-93d7-1d90a882357e","word":"ثُنَائِيَّةٌ لُغَوِيَّةٌ أُفُقِيَّةٌ مُتَكَافِئَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9230","lexicalEntryId":"93e1d915-9f71-4380-93d7-1d90a882357e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ثُنَائِيَّةٌ لُغَوِيَّةٌ أُفُقِيَّةٌ مُتَكَافِئَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوعٌ من أنواع الثُّنائيَّةِ اللغوية، يَعني تَعادُلَ لغَتَين في بلَدٍ ما من حيث الاستِعمالُ الرَّسمي، والمنزلِةُ الاجتماعية، والتواصُلُ بهما في جميع المستوياتِ والمناسَبات، في المنزِل والشّارِعِ والحياةِ العامّة، ويَنطَبِق هذا الوَصفُ على التَّعَدُّدِيَّةِ اللغويةِ أيضا horizontal multi-lingualism. وتُقابِلها الثُّنائيَّةُ غَيرُ المتكافِئةِ diagonal bilingualism؛ حيث تُهَيمِن لغةٌ في مجتَمَعٍ ما على مُعظَم مجالاتِ الاستِعمال، وتَبقَى الأخرى هامِشِيَّةً، وكذلك الثنائيةُ العَموديةُ vertical bilingualism وهي ثُنائيةٌ لهَجِيَّةٌ في الغالِب.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ثنائية لغوية أفقية متكافئة ","nonDiacriticsLemma":"ثنائية لغوية أفقية متكافئة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ثُنَائِيَّةٌ لُغَوِيَّةٌ أُفُقِيَّةٌ مُتَكَافِئَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/91110f03-bc37-4bde-99e4-d6bc307cf19f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"91110f03-bc37-4bde-99e4-d6bc307cf19f","word":"تَرْكِيبٌ هَجِينٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9231","lexicalEntryId":"91110f03-bc37-4bde-99e4-d6bc307cf19f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَرْكِيبٌ هَجِينٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تركيبٌ يحتَوي على كلماتٍ تَنتَمي إلى أكثَرَ من لغةٍ واحدة، وتحدُث هذه الظاهِرَةُ في المجتَمَعات ثنائيةِ اللغة، مثلُ بعضِ التراكيبِ التي يَستَعمِلها الهنودُ حين يتحَدَّثون بالإنجليزية أو يكتُبون بها. وقد يَدخُل هذا التركيبُ اللغةَ بسبَب الاقتراضِ اللغويِّ، مثلُ التراكيبِ العربيةِ الشائعَةِ في الفارسية والتركيةِ والسواحيليةِ وغيرِها من لغات الشُّعوبِ الإسلامية. تَشيع هذه التراكيبُ الهَجِينُ أيضا في لغة العلومِ المرتَبِطَةِ بأكثَرَ من لغةٍ، كعُلوم الطِّبِّ والصيدلةِ مثلا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تركيب هجين ","nonDiacriticsLemma":"تركيب هجين","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَرْكِيبٌ هَجِينٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

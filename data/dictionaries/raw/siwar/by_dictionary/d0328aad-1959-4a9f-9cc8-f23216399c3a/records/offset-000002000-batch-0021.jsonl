{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/153da9eb-bfcd-4322-9d2a-79f5a56a640f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"153da9eb-bfcd-4322-9d2a-79f5a56a640f","word":"مِثَالِيَّةُ المُتَحَدِّثِ أو السَّامِعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9235","lexicalEntryId":"153da9eb-bfcd-4322-9d2a-79f5a56a640f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مِثَالِيَّةُ المُتَحَدِّثِ أو السَّامِعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مثاليةٌ تَفتَرِض وُجودَ كِفايَةٍ كامِلةٍ لدى الناطقِ بلغةٍ معيَّنة، تحميه من الوُقوع في الخَطأ في لغته، وتُمَكِّنه من اكتِشاف الخَطأِ فيها إذا سَمِعَه من غيره. وهذه المثاليةُ مَبنيَّةٌ على الارتِباط التامِّ (المفتَرَض) بين الكِفايَةِ competence والأداءِ performance. لكن هذا الارتِباطَ المثاليَّ غيرُ مطَّرِدٍ دائما؛ لأن الأداءَ لا يَعكِس الكِفايَةَ في جميع الأحوال؛ فقد يُخطِئ الناطقُ باللغة في الأداء مع وُجودِ الكِفايَةِ؛ لأسبابٍ مختَلِفة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مثالية المتحدث أو السامع ","nonDiacriticsLemma":"مثالية المتحدث أو السامع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مِثَالِيَّةُ المُتَحَدِّثِ أو السَّامِعِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c6e463f9-bec6-4940-a04a-06891307d236/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c6e463f9-bec6-4940-a04a-06891307d236","word":"باطِنيَّةُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9236","lexicalEntryId":"c6e463f9-bec6-4940-a04a-06891307d236","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"باطِنيَّةُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"العَمَليّاتُ العَقليةُ التي تحدُث في أثناء فَهمِ اللغةِ أو إنتاجِها. تنطَلِق فِكرتُها من المذهب الذي يَنظُر إلى اللغة على أنها سِمَةٌ إنسانيةٌ داخليةٌ خاصةٌ بالإنسان، وليسَت شيئا خارِجا عنه. وهذا المذهبُ، الذي يُمثِّل رأيَ تشومسكي وأتباعِه من المعرفيين الفِطريين، يرى أن الفَردَ يولَد ولدَيه قُدرَةٌ فِطرِيةٌ داخِليةٌ تُوَجِّه اكتسابَه اللغةَ؛ فيَكتَشِف بها قواعدَ لغتِه وقوانينَها، من غير حاجةٍ إلى تعلُّمٍ رَسميٍّ أو تَوجِيهٍ من البيئة المحيطَةِ به. ويُقابِل هذا النظرَةَ النظرَةُ الخارِجيةُ للُّغة externalized language (E-language) التي تُمَثِّل النظرَةَ البِنيَويةَ السلوكيةَ وترَى أن اللغةَ ظاهِرَةٌ خارِجية، يَكتَسِبها الفَردُ بالتأثِير البيئيِّ المحيطِ به كما يَكتَسِب أيَّ سُلوكٍ آخَر. ولكلٍّ من النظرَتَين تفسيرٌ لاكتساب اللغةِ يختَلِف عن تفسير الأخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"باطنية اللغة ","nonDiacriticsLemma":"باطنية اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"باطِنيَّةُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

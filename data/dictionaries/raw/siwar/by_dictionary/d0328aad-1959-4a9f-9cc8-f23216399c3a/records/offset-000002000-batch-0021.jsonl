{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/67bc7b75-ef1f-43cf-99e2-db4b65380c84/get-public-entry"},"browse_index_record":{"lexicalEntryId":"67bc7b75-ef1f-43cf-99e2-db4b65380c84","word":"إشَارَةٌ يَدَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9238","lexicalEntryId":"67bc7b75-ef1f-43cf-99e2-db4b65380c84","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إشَارَةٌ يَدَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إجراءٌ من إجراءات طرائقِ تدريسِ اللغاتِ الأجنَبية يَتَمَثَّل في إشارَةٍ باليَد، يَستَخدِمها معلِّمُ اللغةِ لإعطاء تَعليماتٍ صَامِتةٍ لطلابه؛ ليَبدَؤوا تَكرارَ ما يقوله تَكرارًا جَمْعِيًّا أو فئويًّا زُمَرِيًّا أو فَردِيًّا، أو للإشارَة إلى خَطأٍ في أدائهم ليُصَوِّبوه. وكانت الإشارةُ اليَدَويةُ متَّبَعةً بشَكلٍ رَئيسٍ في تدريس الحِواراتِ اللغويةِ وإجراءِ التدريباتِ في الطريقة السَّمعيةِ الشَّفَهية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إشارة يدوية ","nonDiacriticsLemma":"إشارة يدوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إشَارَةٌ يَدَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f74fa75b-adbf-4aca-a987-a16c38dd2db6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f74fa75b-adbf-4aca-a987-a16c38dd2db6","word":"اسْتِئْصَالُ نِصْفِ الدِّمَاغِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9239","lexicalEntryId":"f74fa75b-adbf-4aca-a987-a16c38dd2db6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْتِئْصَالُ نِصْفِ الدِّمَاغِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُقصَد به فَصلُ أحَدِ جانِبَيْ القِشرَة الدِّماغية، أو فُصلُ أحَدِ جانِبَيْ الدِّماغِ عن الآخَر split brain؛ لأسبابٍ مرَضِيَّة، ثم إجراءُ دراساتٍ، من قِبَل عُلماءِ الأعصاب، على المرضَى الذين أُجرِيَت لهم هذه العَمَليات، ورَصدُ ما يحدُث لأدمِغَتِهم من آثارٍ لغوية، ومقارَنَةُ آثارِ ما يحدُث في أحَد جانِبَيْ الدِّماغِ بالآثار التي تحدُث في الجانب الآخَر منه. وقد تَبَيَّن من نتائج بعضِ الدراساتِ العَصَبيةِ أن استِئصالَ الجانِبِ الأيسَرِ يُفقِد المريضَ الوَظائفَ اللغويةَ مع بقاء مُعظَمِ الوَظائفِ العَقليةِ سَليمَةً، أما استِئصالُ الجانِبِ الأيمَنِ فلم يُلاحَظ له تأثيرٌ سلِبيٌّ كبيرٌ في وَظائِف اللغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"استئصال نصف الدماغ ","nonDiacriticsLemma":"استئصال نصف الدماغ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْتِئْصَالُ نِصْفِ الدِّمَاغ
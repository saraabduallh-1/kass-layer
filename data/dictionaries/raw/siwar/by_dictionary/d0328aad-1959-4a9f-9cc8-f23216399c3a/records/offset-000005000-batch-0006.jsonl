{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/311b9de5-bb68-41c7-a34d-8336c3e895de/get-public-entry"},"browse_index_record":{"lexicalEntryId":"311b9de5-bb68-41c7-a34d-8336c3e895de","word":"مُثَلَّثُ دَلالِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ca8","lexicalEntryId":"311b9de5-bb68-41c7-a34d-8336c3e895de","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُثَلَّثُ دَلالِيُّ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مُثَلَّثٌ أو أٌنموذَجٌ لتَوضيح المعنى، يُنسَب إلى ريتشاردز و أوغدِن Richards & Ogden في نهايَة الربع الأولِ من القرن العشرين. يُوضِّح هذا المثلَّثُ العَلاقَةَ بين الشيءِ والكلمةِ والمعنى، بالنَّظَر إلى أن الشيءَ مَوجودٌ في الطبيعَة خارِجَ اللغةِ، والكلمةَ اسمٌ لهذا الشيءِ، والمعنى ما يَفهَمه المَرءُ حينَ يَسمَع الكلمةَ. فكلمةُ: (حِصان) مثلا يمكن أن تُمَثَّل في مثلَّثٍ إحدى زواياه الكلمةُ أو الرَّمزُ symbol، والثانيةُ هي الشيءُ نفسهُ thing، والثالثةُ هي المفهومُ concept/thought، ويَربط ستيفن أولمان Stephen Ullmann بين الكلمةِ والشيءِ بخَطٍّ افتِراضِيٍّ مَنقوط؛ لوَصف العَلاقَةِ غيرِ المنطِقيَّةِ بينهما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مثلث دلالي ","nonDiacriticsLemma":"مثلث دلالي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُثَلَّثُ دَلالِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":nu
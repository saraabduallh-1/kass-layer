{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c20b429e-a8ec-44d9-acf0-78669913652b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c20b429e-a8ec-44d9-acf0-78669913652b","word":"ذَاكِرَةٌ دَلالِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ca6","lexicalEntryId":"c20b429e-a8ec-44d9-acf0-78669913652b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ذَاكِرَةٌ دَلالِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جُزءٌ أو حَيِّزٌ من الذَّاكِرَة، تُنَظَّم فيه الكلماتُ بناء على أنواعها وأصنافِها وسِماتِها الدَّلالِيَّة، أي تُختَزَل فيه الكلماتُ مع مَعانِيها والعَلاقات بينها. فكلمةُ (عُصفُور) تُخزن مَقترنةً بذاكِرَة الطَّير، وكلمةُ (تُفّاحَةٌ) مَقترنة بذاكِرَة الفَوَاكِه، وكلمةُ (قَمِيص) مَقترنة بذاكِرَة الملابِس، وكلمة (غُرفَة) مَقترنة بذاكرة المنزل، وهكذا. والذَّاكِرَةُ الدّلالِيَّةُ تُقابِلها الذَّاكِرَةُ العَرَضِيَّةُ episodic memory التي تُنَظَّم على أساسٍ من الخِبرات الشَّخصِيَّةِ والعَرَضِيَّة. راجع:  @(episodic memory) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ذاكرة دلالية ","nonDiacriticsLemma":"ذاكرة دلالية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ذَاكِرَةٌ دَلالِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

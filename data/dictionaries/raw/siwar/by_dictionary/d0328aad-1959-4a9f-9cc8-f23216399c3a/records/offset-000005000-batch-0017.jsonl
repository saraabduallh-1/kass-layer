{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e1974540-696c-474c-bf03-16357c2c74f9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e1974540-696c-474c-bf03-16357c2c74f9","word":"لَوْحَةُ الأصواتِ المُلَوَّنَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dc4","lexicalEntryId":"e1974540-696c-474c-bf03-16357c2c74f9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لَوْحَةُ الأصواتِ المُلَوَّنَةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لَوحَةٌ تُستَعمَل في الطريقَة الصّامِتَةِ لتعليم أصواتِ اللغةِ الهَدَف، وتحتَوي على مُكَعَّبات مُلوَّنةٍ يمثِّل كلٌّ منها صوتًا من أصوات اللغةِ الهَدَفِ، يَستَعملها المعلِّمُ فيلفت نَظَرَ طلّابِه إلى الألوان أوّلًا لتَكوين المقاطِعِ الصَّوتِيَّةِ syllables، ثم لتَكوين الكَلِماتِ والجُمَلِ. ففي تدريس الأصوات، مثلا، يَضرِب المعلِّمُ على لَونٍ معيَّنٍ بشدَّة محاوِلا النَّبرَ على الكلمة الهَدَف. وتُعلِّم اللَّوحةُ الطلابَ تكوينَ الأصواتِ المركَّبَةِ بدون تَكرار، وتَجذِب انتِباهَهم للُّغة وليس للمعلِّم، كما أنها تَسمَح للطلاب باستِرجاع المعلوماتِ عن الصوت المطلوبِ في حال اختِلاطِ الأصوات، وتُساعِدهم في تحديد ما تعلَّموه وما لم يَتعلَّموه من الأصوات، ممّا يُشعِر المتعلِّمَ بالاستِقلال.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لوحة الأصوات الملونة ","nonDiacriticsLemma":"لوحة الأصوات الملونة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لَوْحَةُ الأصواتِ المُلَوَّنَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

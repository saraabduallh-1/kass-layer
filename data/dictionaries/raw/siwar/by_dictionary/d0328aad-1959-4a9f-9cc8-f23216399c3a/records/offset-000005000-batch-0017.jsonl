{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a3115ca9-56ba-4fd9-b569-b8b34311af98/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a3115ca9-56ba-4fd9-b569-b8b34311af98","word":"أُنْمُوذَجُ سْمِيثْ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dbd","lexicalEntryId":"a3115ca9-56ba-4fd9-b569-b8b34311af98","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجُ سْمِيثْ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذَجٌ من نماذِج القراءةِ الكُلِّيَّة أو قراءةِ المعنى top-down models of reading، طوَّرَه فرانك سميث Frank Smith، ووَصف فيه القراءةَ بأنها عمَليةٌ لغويةٌ نَفسيّةٌ، وأكَّد أهميةَ المعنى وحاجَةَ القارِئِ إلى توقُّع هذا المعنى في أثناء القراءةِ، ولخَّص القراءةَ بأنها: ليسَت استِخلاصًا للمعنى من النَّص المكتوبِ بقَدر ما هي إحضارُ المعنى إلى هذا النَّص. لم يُفرِّق سميث بين عمَلِيَّتيْ فَكِّ الشَّفرَةِ والقراءة، بل أدمجَهما في عمَليّةٍ واحدةٍ تَسبِق فَهمَ المعنى وتَقُود إليه. أُعِدَّ هذا الأنموذَجُ لتفسير القراءةِ في اللغة الأمِّ، لكنه عُدَّ من أفضَل النماذِجِ لتَفسير القراءةِ في اللغات الثانيةِ والأجنَبيّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج سميث ","nonDiacriticsLemma":"أنموذج سميث","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجُ سْمِيثْ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

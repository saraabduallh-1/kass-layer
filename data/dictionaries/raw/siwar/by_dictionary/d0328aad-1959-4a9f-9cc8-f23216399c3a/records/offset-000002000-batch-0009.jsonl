{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5d5af3d8-4c84-48f4-8a38-b0e0696556ee/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5d5af3d8-4c84-48f4-8a38-b0e0696556ee","word":"النَّظَرُ في وَظِيفَيَّةِ الجُمِلَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b910f","lexicalEntryId":"5d5af3d8-4c84-48f4-8a38-b0e0696556ee","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّظَرُ في وَظِيفَيَّةِ الجُمِلَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهجٌ في التحليل اللغويِّ، ظَهَر في أوائل الستينيات من القرن العشرين، وارتَبَط بمدرسة براغ Prague School، واهتَمَّ بالنَّظَر إلى الجُملة ووَصفِها بناء على تَوزيع المعلوماتِ فيها، خاصَّةً أثَرَ توزيعِ المعلوماتِ المعروفَةِ لدى السامِعِ أو القارِئ، أو الموضوعِ theme، والمعلوماتِ المقدَّمَةِ له في النَّص، أو الخَبَرِ rheme. خِلافا للتحليل في النحو التقليديِّ الذي يَنطَلِق من التَّفريق بين المسنَدِ إليه والمسنَدِ الذي ليس بالضرورَة مُوَازِيا للتَّفريق بين الموضوعِ والخَبِر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظر في وظيفية الجملة ","nonDiacriticsLemma":"النظر في وظيفية الجملة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّظَرُ في وَظِيفَيَّةِ الجُمِلَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

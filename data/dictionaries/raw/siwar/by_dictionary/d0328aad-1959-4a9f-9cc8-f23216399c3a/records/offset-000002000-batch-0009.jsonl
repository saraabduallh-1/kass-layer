{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0235f353-206a-4195-bb12-b823858c31d5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0235f353-206a-4195-bb12-b823858c31d5","word":"لُغَةٌ انْدِمَاجِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9104","lexicalEntryId":"0235f353-206a-4195-bb12-b823858c31d5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ انْدِمَاجِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يطلَق على اللغةِ التي لا يوجَد في الكلمة الواحدةِ فيها حُدودٌ فاصِلَةٌ بين وَحدةٍ صرفيةٍ وأخرى، وتُسمّى أيضا لغةً انصِهارِيةً أو لغةَ الانصِهارِ، وهو وَصفٌ يُميِّزها عن اللغات اللَّصقِيَّةِ agglutinative languages. ويَنطَبق هذا الوَصفُ على اللغات التَّصريفِيةِ inflecting languages، وهي اللغاتُ التي يؤدِّي تغَيُّرُ الصِّيغَةِ فيها إلى تَغَيُّرِ المعنى أو تَغَيُّرِ الوَظيفةِ التركيبية؛ كاللغات السَّاميّةِ بما فيها العربية، واللغاتِ الهنديةِ الأوربية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة اندماجية ","nonDiacriticsLemma":"لغة اندماجية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ انْدِمَاجِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0aa12417-5f0c-4174-8db2-9f9382a4702c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0aa12417-5f0c-4174-8db2-9f9382a4702c","word":"النَّحْوُ العَامُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9105","lexicalEntryId":"0aa12417-5f0c-4174-8db2-9f9382a4702c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوُ العَامُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قواعدُ تهتَمُّ باللغات عامّةً، ولا تختَصُّ بلغةٍ معيَّنة، وهي القواعدُ التي تكون موضوعا للدراسات اللغويةِ العامَّةِ general linguistics، ولاسيَّما في المراحِل المبكِّرة من ظُهور علمِ اللغةِ العام. ثم أصبَحت وَصفاً يُطلَق - في الغالب - على القواعدَ الكُلِّيَّةِ Universal Grammar. وتُقابِل القواعدَ العامَّةَ هذه القواعدُ الخاصَّةُ التي تُعنَى بقواعد لغةٍ بعَينها، مثل قواعدِ اللغةِ العربية، وقواعدِ اللغةِ الإنجليزية، وقواعدِ اللغةِ اليابانية. وتقابلها أيضا القواعدُ التطبيقيةُ التي تُدرَس لأهدافٍ لغويةٍ نفسيةٍ، أو لغويةٍ اجتماعيةٍ، أو لغويةٍ تعليمية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النحو العام ","nonDiacriticsLemma":"النحو العام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّحْوُ العَامُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4af9a908-5378-4cb4-9876-48e62092f4f2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4af9a908-5378-4cb4-9876-48e62092f4f2","word":"شُيُوعٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b911a","lexicalEntryId":"4af9a908-5378-4cb4-9876-48e62092f4f2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"شُيُوعٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يَشيع استِعمالُه في المعالجة الآليَّةِ للنُّصوص وفي لسانيّات المدوَّنات، ويُقصَد به درَجةُ شُيوعِ العنصُرِ اللغويِّ (صوت أو مورفيم أو كلمة أو تركيب) في نَصٍّ ما أو مدَوَّنةٍ لغويةٍ، أي عَدَدُ مرّاتِ وُرُودِه. وتختَلِف درَجاتُ شُيوعِ العنصُرِ اللغويِّ في النُّصوص المسموعة عنها في النُّصوص المكتوبة، وغالبا ما تكون الكلماتُ الوَظيفيةُ أكثَرَ شُيوعا من كلمات المحتوى. ويُسمّى هذا أيضا تَكرارَ الحُدوثِ frequency of occurrence.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"شيوع ","nonDiacriticsLemma":"شيوع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"شُيُوعٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

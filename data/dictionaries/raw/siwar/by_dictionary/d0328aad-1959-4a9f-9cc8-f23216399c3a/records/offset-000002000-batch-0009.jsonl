{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2c41ce85-9ce6-41d1-a580-c0c7df38f768/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2c41ce85-9ce6-41d1-a580-c0c7df38f768","word":"النِّظَامُ الإطَارِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9111","lexicalEntryId":"2c41ce85-9ce6-41d1-a580-c0c7df38f768","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النِّظَامُ الإطَارِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، يَعني النظامَ المبنيَّ على الأُطُر، ويُسمى أيضا: frame system. وهو برنامجٌ حاسوبيٌّ مُصمَّمٌ لتحليل الكلامِ الطبيعي، يَعتَمِد في تنظيمه على مُحاكاة ما يفعله الإنسانُ حين يحاوِل فَهمَ أيِّ معلوماتٍ جديدة. ففي فَهمِ مَوقِفٍ معيَّن، يستَحضِر البرنامجُ الأطُرَ المتَّصِلةَ بالموضوع، ويَملَؤها بما قُدِّم له من موضوعات؛ أما المعلوماتُ الناقِصَةُ التي لا تُذكَر عادةً في الكلام - على افتِراض معرِفةِ السامِعِ بها - فإنه يستَكمِلها بالاستنتاج التلقائيِّ من الإطار الأُنموذَجيِّ الجاهِز.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النظام الإطاري ","nonDiacriticsLemma":"النظام الإطاري","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النِّظَامُ الإطَارِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

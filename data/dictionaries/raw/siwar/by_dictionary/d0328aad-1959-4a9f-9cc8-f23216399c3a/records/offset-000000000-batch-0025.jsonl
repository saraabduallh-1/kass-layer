{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/896a0ee6-34f3-4b98-b0e8-075ab34e380b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"896a0ee6-34f3-4b98-b0e8-075ab34e380b","word":"المَهَارَاتُ الأَسَاسُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ab3","lexicalEntryId":"896a0ee6-34f3-4b98-b0e8-075ab34e380b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَهَارَاتُ الأَسَاسُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ تعليميٌّ عامٌّ، يُطلَق على المهارات التي تُعَدُّ أساسا في تعلُّم علومٍ أخرى في التعليم خاصَّة، وتُقَدَّم في المرحَلة الابتدائية، وأهمُّ هذه المهاراتِ: القراءةُ والكتابةُ والحِساب. بيدَ أن المهاراتِ الأساسِ لم تَعُد الآنَ مقصورَةً على هذه الجوانبِ الثلاثةِ، حتى إنَّ ما كان يُعَدّ هامِشِيًّا من المهارات والمعارِف تحوَّل الآن إلى مهاراتٍ أساسٍ لدى الأطفال؛ كاستِعمال الحاسوبِ والبرامِجِ الاجتماعيةِ المرتَبطةِ به، وأنواعٍ من أنظِمَة الاتصالاتِ الهاتفية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المهارات الأساس ","nonDiacriticsLemma":"المهارات الأساس","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَهَارَاتُ الأَسَاسُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ff2a8b09-b498-4873-933c-4eb604930d55/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ff2a8b09-b498-4873-933c-4eb604930d55","word":"التَّرْتِيبُ الأَسَاسُ للكَلِماتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ab4","lexicalEntryId":"ff2a8b09-b498-4873-933c-4eb604930d55","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّرْتِيبُ الأَسَاسُ للكَلِماتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَرتيبُ الكلماتِ أو العباراتِ في بناء الجُملة، حيث يُزعَم أنه التَّرتيبُ الأصليُّ في لغةٍ معيَّنَة، أو أنه التَّرتيبُ الشائعُ في معظَم اللغاتِ في ضَوء نظريةِ القواعدِ الكُلِّيَّة، أي إنه أصلٌ لغيره من التراكيب المختَلِفةِ عنه في التَّرتيب. ويُوصَف هذا التَّرتيبُ (الأساسُ) بأنه غيرُ مَوسومٍ unmarked وغيرُه مَوسومٌ marked، سواءٌ أكان ذلك في لغةٍ واحدَةٍ أم في جميع اللغات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الترتيب الأساس للكلمات ","nonDiacriticsLemma":"الترتيب الأساس للكلمات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّرْتِيبُ الأَسَاسُ للكَلِماتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ae5186ba-8b62-4309-9e2d-f23e03aa4f35/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ae5186ba-8b62-4309-9e2d-f23e03aa4f35","word":"الاخْتِبَارَاتُ السُّلُوكِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ab5","lexicalEntryId":"ae5186ba-8b62-4309-9e2d-f23e03aa4f35","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الاخْتِبَارَاتُ السُّلُوكِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُشير إلى أحَد الأساليبِ التي لَجأ إليها علماءُ الأعصابِ للتوصُّل إلى تحديد مناطِقِ اللغةِ ومَراكِزِها في جانِبَيْ الدِّماغ، وذلك بتَحديد المناطِقِ التي تَقوم بوَظائفَ لغوية، من سَمْعٍ وفَهْمٍ وكلامٍ وقراءةٍ وكتابةٍ. وذلك بوَضع مُثيراتٍ سَمعيةٍ على أذُنَيْ المفحُوصِ، مَربوطةٍ بأجهزَة رَصدٍ إلكترونيةٍ تُسجِّل مساراتِ الأصواتِ ووِجهَتَها إما إلى الجانِب الأيسَرِ من الدِّماغِ أو إلى الجانِب الأيمَن منه. أما الأساليبُ الأخرى فهي: مُلاحَظَةُ سُلوكِ المرضَى، والتَّشريحُ، واستِعمالُ المقايِيسِ الفِسيُولوجية، ودراساتُ جِراحاتِ الدِّماغ، إضافةً إلى مقايِيس أخرى تُجرَى باستِعمال أجهِزَةٍ ذاتِ تَقنِيةٍ حاسوبيةٍ عاليَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الاختبارات السلوكية ","nonDiacriticsLemma":"الاختبارات السلوكية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الاخْتِبَار
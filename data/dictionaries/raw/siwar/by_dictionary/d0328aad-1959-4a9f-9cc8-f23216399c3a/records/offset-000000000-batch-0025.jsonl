{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c4ee0cee-3d9d-4aad-bd57-3f8871ddbfff/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c4ee0cee-3d9d-4aad-bd57-3f8871ddbfff","word":"وَضْعُ الجِسْمِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ac6","lexicalEntryId":"c4ee0cee-3d9d-4aad-bd57-3f8871ddbfff","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَضْعُ الجِسْمِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الوَضعُ الذي يَتَّخِذه الجِسمُ في أثناء الكلامِ أو أثناءِ الإشاراتِ غيرِ اللغوية. وهذا الوَضعُ قد يكون مُكمِّلا لمعنى لغويٍّ ما، أو دالًّا على معنى مستَقِلٍّ. وتختَلِف المجتَمَعاتُ والثقافاتُ في أوضاع الجِسمِ في أثناءَ الكلامِ، والمعاني التي تُعَبِّر عنها هذه الأوضاع. وما يكون مَقبولا أو مَرغوبا فيه من أوضاع الجسمِ أثناءَ الكلامِ في مجتَمَعٍ ما قد يكون عَيبا في مجتَمَعٍ آخَر، كالقُرب من المخاطَب أو البُعدِ عنه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وضع الجسم ","nonDiacriticsLemma":"وضع الجسم","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَضْعُ الجِسْمِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/efad5394-bb62-45fb-9f6e-4778281a32f8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"efad5394-bb62-45fb-9f6e-4778281a32f8","word":"الرَّبْطُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ac3","lexicalEntryId":"efad5394-bb62-45fb-9f6e-4778281a32f8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الرَّبْطُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الرَّبطُ بين الجُمَلِ والوَحداتِ المعجَميةِ والدَّلالية، وهو مما تختَلِف فيه اللغاتُ؛ فالعربيةُ مثلا تعتَمِد - إلا في حالات خاصَّةٍ كالإسناد، مثلاً - على أدوات الرَّبطِ الظاهِرَة، كحُروف العَطف، والأسماءِ الموصولَة، وألفاظِ الاستِدراك، ونحوِ ذلك؛ في حين يجوز في الإنجليزية الاستغناءُ عن بعض هذه الرَّوابِط. تظهَر هذه الفُروقُ في الترجَمة، وربما تُصبِح مشكلَةً تتطلَّب من المترجِم حِذقا في نَقلها؛ فاستِعمال الواوِ في بدايَة الجُملةِ العربيةِ مثلا أمر مَقبولٌ في كثير من الأساليب، لكن هذا لا يَعني نَقلَها إلى الإنجليزية؛ لأنها ليسَت عاطِفَةً في كثير من الحالات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"الربط ","nonDiacriticsLemma":"الربط","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الرَّبْطُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ca626e09-eb3e-48ba-bd4a-2909e069c71d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ca626e09-eb3e-48ba-bd4a-2909e069c71d","word":"إنجِلِيزِيَّةُ السُّودِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ac4","lexicalEntryId":"ca626e09-eb3e-48ba-bd4a-2909e069c71d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إنجِلِيزِيَّةُ السُّودِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إنجليزيةُ الزُّنوجِ الأمريكيين، وهي لَهجَةٌ أو مجموعةٌ من اللَّهَجات الإنجليزيةِ التي يَتحدَّثها سُكانُ الولاياتِ المتحدةِ الأمريكيةِ السودُ المنحَدِرون من أُصول إفريقية، خاصةً من يَعيشون منهم في وَسَط المدُنِ الرئيسةِ، مثلُ نيويورك وشيكاغو وديترويت. وتتمَيَّز هذه اللَّهجَةُ أو اللَّهَجاتُ بسِماتٍ خاصةٍ في الأصوات والصرفِ والنحو. ويرى بعضُ اللغويين أنها - في الأصل - لغةُ البيضِ في الولايات الأمريكيةِ الجنوبية، وانتَشَرت بانتِشار السُّودِ في الولايات والمدُنِ الأخرى. ويرى غيرُهم أنها لغةٌ مولّدة creole من لغاتٍ هَجِين pidgin، في حين يرى آخَرون أنها لغةٌ مستَقِلَّة. ويُعاني أبناءُ السُّودِ وبناتُهم من مشكلاتٍ لغويةٍ تربويةٍ في المدارس الأمريكيةِ التي تغلب عليها لَهجةُ البِيضِ المنحَدرِين من أصولٍ أورُوبِّيَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إنجليزية السود ","nonDiacriticsLemma":"إنجليزية السود","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إنجِلِيزِيَّةُ السُّودِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

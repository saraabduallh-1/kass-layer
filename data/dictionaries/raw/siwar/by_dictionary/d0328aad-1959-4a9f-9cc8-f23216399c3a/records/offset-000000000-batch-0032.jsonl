{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/31d9e98e-8dc8-4837-9676-440c15f80b23/get-public-entry"},"browse_index_record":{"lexicalEntryId":"31d9e98e-8dc8-4837-9676-440c15f80b23","word":"صِيغَةُ اسْتِشْهَادٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b75","lexicalEntryId":"31d9e98e-8dc8-4837-9676-440c15f80b23","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صِيغَةُ اسْتِشْهَادٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلَحٌ في صناعَة المعجَم، يُشير إلى المادَة أو الكلمةِ المدخَلِ في المعجَم واختِلافِ اللغاتِ في شَكل هذه الكلمة؛ ففي المعجَمِ العربيِّ المبنيِّ على الكلماتِ أو الجُذوعِ stems مثلا، تُجَرَّد الكلمةُ من أل التعريف، وفي الفرنسية تُورَد الصيغَةُ المصدَريةُ للفِعل كما في: savoir، وفي لغاتٍ أخرى تحذَف السوابِقُ، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ اجتماعي، يُشير إلى طريقَة الاستِشهادِ في الكلام؛ حيث يُميَّز في النُّطق بين نُطقِ الكلمةِ مَعزولَةً عن سِياقها، ونُطقِها في كلامٍ متَّصَل. ففي الكلامِ المتَّصَلِ تَبرُز ظَواهِرُ صَوتيةٌ، كالمماثَلَةِ، مثلا، التي لا تظهَر في النُّطقِ المعزولِ عادَةً.    ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صيغة استشهاد ","nonDiacriticsLemma":"صيغة استشهاد","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صِيغَةُ اسْتِشْهَادٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dd9da0f3-4a3f-42dd-ba9a-828aaef814d8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dd9da0f3-4a3f-42dd-ba9a-828aaef814d8","word":"بِنْيَةُ الدِّمَاغِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b76","lexicalEntryId":"dd9da0f3-4a3f-42dd-ba9a-828aaef814d8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"بِنْيَةُ الدِّمَاغِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الأجزاءُ التي يتكَوَّن منها الدِّماغُ، وهي الأجزاءُ العُليا التي على شَكل طَبَقات، كالجُمجُمَة، واللِّحاءِ أو قِشرَةِ الدِّماغ، والمادَّةِ البَيضاءِ التي كُسِيَت خلاياها بمادَّة الغِمد، والأوعِيَةِ الدَّمَوِيَّة. وكذلك الأجزاءُ الرأسيةُ التي منها: النّخاعُ الشَّوكِيُّ، والمُخَيْخُ، والنّخاعُ المستَطِيلُ، وقَنطَرَةُ فارول، وكذلك التَّقسيمُ النِّصفِيُّ للدِّماغ الذي يُقَسِّمه إلى: جانبٍ أيمَنَ، وجانِبٍ أيسَرَ، وما يحوِيه كلُّ جانِبٍ من مناطِق اللغةِ ووَظائفِها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"بنية الدماغ ","nonDiacriticsLemma":"بنية الدماغ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"بِنْيَةُ الدِّمَاغِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

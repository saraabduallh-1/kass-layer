{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/07b90320-9f5c-46bb-b605-242b2ef61296/get-public-entry"},"browse_index_record":{"lexicalEntryId":"07b90320-9f5c-46bb-b605-242b2ef61296","word":"الطُّفُولَةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b6a","lexicalEntryId":"07b90320-9f5c-46bb-b605-242b2ef61296","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الطُّفُولَةُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"المرحَلَةُ الأولى من مَراحِل عُمرِ الإنسان، وتُقَسَّم إلى مرحَلَتَين فَرعيَّتَين: الأولى الطفولةُ المبكِّرةُ التي هي أُولى مراحِلِ التَّنشِئةِ الاجتماعية؛ وتَبدأ أواخِرَ السنةِ الثانيةِ، وتَنتَهي في السنة السادسة، وفيها يتميَّز الطفلُ بالاستقلال في الحرَكة، وتَطوُّرِ سُلوكِه الاجتماعيِّ ووَعْيِه بذاته. والثانيةُ الطفولةُ المتأخِّرَة؛ تَبدأ مع بدايَة دُخولِ الطفلِ المدرسة، أي في السنة السادسةِ أو السابعة، وتَنتهي في السنة الثالثة عشرة، وتتميَّز بالنُّمُوِّ الجِسميِّ وظُهُورِ القُدراتِ العَقليةِ واتِّساعِ مجالِ النَّشاطِ الاجتماعي. والطفولةُ بنوعَيها أهمُّ مراحلِ النُّمُوِّ اللغوي؛ فهي المرحلةُ التي يكتَسِب فيها الطفلُ لغتَه الأم، ويكتَسِب فيها أيَّ لغةٍ أخرى بشَكل طبَعيٍّ فِطرِي، ونهايَتُها هي حَدُّ الفَترَةِ الحَرِجَةِ critical period في اكتساب اللغةِ لدى كثيرٍ من اللغويين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"الطفولة ","nonDiacriticsLemma":"الطفولة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الطُّفُولَةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/39e256c0-efab-4d56-9809-9d775bfdb654/get-public-entry"},"browse_index_record":{"lexicalEntryId":"39e256c0-efab-4d56-9809-9d775bfdb654","word":"لُيُونَةُ الدِّمَاغِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b67","lexicalEntryId":"39e256c0-efab-4d56-9809-9d775bfdb654","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُيُونَةُ الدِّمَاغِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصبيٌّ، يُقصَد به ليُونةُ أعصابِ الدِّماغِ في مرحلة الطُّفولةِ، في مُقابِل تَصلُّبِها بعد ذلك. وتُعرَف هذه اللُّيونةُ بأنها الحالَةُ أو المرحلةُ التي لا تكون فيها المناطقُ القِشريةُ النوعيةُ قد اكتَمَلت، لعدَم نُضجِ الدِّماغ. ويكون الدِّماغُ في أقصى درَجاتِ مُرُونَتِه خلالَ المراحلِ الأسرَعِ في نموِّه، حتى إنَّ تعَرُّضَ النِّصفِ الأيسَرِ من الدِّماغِ لإصابَةٍ أو مرَضٍ قبلَ نهايَةِ السنةِ الأولى من عُمُر الطفلِ يمكن تَعويضُه بانتِقال مناطِقِ اللغةِ إلى النِّصف الأيمَن، وإعادَة التَّنظيمِ الوَظيفيِّ للدِّماغ أقلُّ احتِمالا بعد هذه المرحلَةِ العُمرية. ويُعتَقَد أن قدرَةَ الطفلِ على اكتساب أيِّ لغةٍ تكون قبلَ بُلوغِه الثانيةَ عشرةَ بشَكلٍ طبيعيٍّ، وتنخفض هذه القُدرَةِ بعد ذلك، وهذا يَرجِع إلى ليُونَة الأعصابِ في هذه المرحلَةِ المبكِّرَة، وتَصَلُّبِها أو بدايَةِ تَصَلُّبِها بعد ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ليونة الدماغ ","nonDiacriticsLemma":"ليونة الدماغ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُيُونَةُ الدِّمَاغِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

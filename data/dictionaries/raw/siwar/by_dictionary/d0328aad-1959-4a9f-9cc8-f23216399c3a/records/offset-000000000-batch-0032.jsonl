{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/611aa88e-c345-4c58-861c-e71f86674d3c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"611aa88e-c345-4c58-861c-e71f86674d3c","word":"أُسْلُوبٌ مُتَأَنٍّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b64","lexicalEntryId":"611aa88e-c345-4c58-861c-e71f86674d3c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُسْلُوبٌ مُتَأَنٍّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ استَعمَله وِلْيام لابوف William Labov ، إشارةً إلى الصِّيَغ اللغويةِ التي يَستَعمِلها المتعلِّمُ في كلامه بطريقةٍ واعِيَةٍ وبمُراقَبَةٍ نَحويةٍ دَقيقَة. ويَرَى لابوف أن هذه الصِّيَغَ غالِبا ما تظهَر في كلام المتعلِّمِ حين يكون المَوقِفُ غيرَ عَفوِي؛ كأن يكون الكلامُ رَسميا، مع مخاطَبٍ أعلى رُتبَةً من المتكلِّم، وتظهَر أيضا في الكتابة، وفي اختِبار القواعد. ويقابُله الأسلوبُ العَفوِيُّ غيرُ المتكلَّفِ casual style، أو الأسلوبُ الرسميُّ formal style","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أسلوب متأن ","nonDiacriticsLemma":"أسلوب متأن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُسْلُوبٌ مُتَأَنٍّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

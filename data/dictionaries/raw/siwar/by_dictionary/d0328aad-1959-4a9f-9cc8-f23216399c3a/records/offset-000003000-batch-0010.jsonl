{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fd001608-7465-4128-89b3-22c978f7d7a3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fd001608-7465-4128-89b3-22c978f7d7a3","word":"إدْرَاكُ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b951c","lexicalEntryId":"fd001608-7465-4128-89b3-22c978f7d7a3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إدْرَاكُ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُقصَد به تَميِيزُ الصوتِ اللغويِّ أو الكلامِ المسموعِ من حيث خَوَاصُّه النُّطقيّةُ والفيزيائيّةُ والسَّمعِيّةُ، بعد استِقبالِه عبر أعصاب السَّمعِ وقَبلَ فَهمِه. فإدراكُ الكلامِ إذَن مرحَلَةٌ تَتِمُّ على مستوى أعصاب الدِّماغ؛ بعد تَسَلُّمِ الكلامِ من الأعصاب السَّمعيّةِ في الأذُن الدَّاخليّةِ، وقبلَ مُعالَجَتِه في مَراكز فَهمِ اللغةِ في الدِّماغ؛ فهو مرحلَةٌ تَلِي مرحلَةَ السَّماع، وتَسبِق مرحلَة الفَهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إدراك الكلام ","nonDiacriticsLemma":"إدراك الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إدْرَاكُ الكَلامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/55c10495-6cef-445c-9210-7b0c0f2e5e78/get-public-entry"},"browse_index_record":{"lexicalEntryId":"55c10495-6cef-445c-9210-7b0c0f2e5e78","word":"قَانُونُ الجهْدِ الأَدْنَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b951d","lexicalEntryId":"55c10495-6cef-445c-9210-7b0c0f2e5e78","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَانُونُ الجهْدِ الأَدْنَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قانونٌ صَوتيٌّ يَنُصُّ على أن في اللغات نزعَةً عامَّةً إلى اختصار الجهدِ العَضَليِّ عند النُّطق. مثالُ ذلك نُطقُ تاءَيْن متتَاليَتَيْن في جُملة: قامَت تَفتَح البابَ، حيث لا يَنطِق المتكلِّمُ التاءَ الأولى كامِلةً بغَلقٍ مَتبوعٍ بانفِجار؛ لأن هذا يَقتَضي جهدا غيرَ ضروريٍّ لإيقاع الفَتحِ الأوَّلِ لممَرِّ الهواء ثم غَلقه ثانيةً من أجل التاءِ الثانية، بل يَحتَفظ بالغَلق الأوّلِ مُطَوَّلًا. وقد اعتَرَض بعضُ اللغويين على هذا القانونِ بحجة أن صحَّتَه تقود إلى انقِراض كثيرٍ من الأصوات التي تتطلَّب جهدًا عاليًا من اللغات البَشَرية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قانون الجهد الأدنى ","nonDiacriticsLemma":"قانون الجهد الأدنى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَانُونُ الجهْدِ الأَدْنَى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

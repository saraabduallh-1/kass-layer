{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f5640f92-3ff9-440b-857a-7341ff3f0cb1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f5640f92-3ff9-440b-857a-7341ff3f0cb1","word":"جَمْعِيَّاتٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9514","lexicalEntryId":"f5640f92-3ff9-440b-857a-7341ff3f0cb1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جَمْعِيَّاتٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جَمعيّاتٌ أو مؤسّساتُ تُعنَى باللغة، غالبا ما تكون مستَقِلَّة، تهتَمّ بالدراسات اللغويةِ عامَّةً، أو دراساتِ لغةٍ خاصَّة، وتُطالِب بحُقوق اللغةِ واللغَوِيِّين وتَنشُر أعمَالَهم، وتُعنَى بالتَّقيِيس اللغوي، ونَشْرِ الكتُبِ اللغويةِ المعتَمَدَةِ، ولاسيَّما المعاجِمُ وكتُبُ القواعِد، ونحوُ ذلك. عُرِفت هذه الجَمعياتُ في بعض الدوِل الغَربيةِ منذُ القَرنِ التاسِع عشَر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جمعيات لغوية ","nonDiacriticsLemma":"جمعيات لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جَمْعِيَّاتٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

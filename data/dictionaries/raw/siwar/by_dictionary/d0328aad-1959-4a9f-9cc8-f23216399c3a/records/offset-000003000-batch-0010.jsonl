{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2b4049b9-f6c0-4274-8b82-81509778858d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2b4049b9-f6c0-4274-8b82-81509778858d","word":"أَدَاءٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9518","lexicalEntryId":"2b4049b9-f6c0-4274-8b82-81509778858d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أَدَاءٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ، يُقصَد به الأداءُ اللغويُّ language performance، وهو الاستعمالُ الفِعليُّ للُّغة فَهمًا وإنتاجًا في المهارات الشَّفهيَّةِ والكتابيَّة، ويَقصره كثيرٌ من اللغويين على التَّعبير بجانبَيْه الشَّفهيِّ والكِتابيِّ، مُستَبعِدِين الفَهَمَ بجانبَيْه المسموعِ والمقروء. وعادةً ما يُفَرَّق بين الأداءِ اللغويِّ هذا والكِفايَةِ اللغويَّةِ language competence التي تَعني المعرِفةَ الضِّمنيَّةَ بقواعد اللغةِ وقوانينِها. يرى تشومسكي، أبرَزُ من دعا إلى التَّفريق بين هذين المفهومَين، أن الأداءَ يَنبغي أن يَعكِس الكفايةَ لدى أيّ ناطِقٍ بلُغَةٍ معيَّنة، على الرّغم من أنه يَنحرِف عنها أحيانًا، لأسبابٍ عارِضَةٍ، كالمرَضِ والتَّعبِ وزَلَّةِ اللسانِ والقَلمِ. لكن بعضَ اللغويين الاجتماعيين يَرَون أن هذا المفهومَ للكِفايَة لدى تشومسكي قاصِرٌ لا يَتَعدَّى الكِفايَةَ النحويةَ إلى الكِفايَة الاجتماعيةِ وكِفايَةِ الاتصالِ والكفايَةِ الإستراتيجية. راجع:  @(performance factors) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات","اللغات"],"translations":[]},{"definition":"مصطلحٌ سَرْدِيٌّ مُستَعارٌ من نظرية أفعالِ الكلامِ لدى جون أوستن John L. Austin للدّلالَة على الملفوظات غيرِ الخَبريةِ التي تحتَمِل الصّدقَ والكَذِبَ.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أداء لغوي ","nonDiacriticsLemma":"أداء لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أَدَاءٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b25dac2-0898-4a1e-999c-161097e6e705/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b25dac2-0898-4a1e-999c-161097e6e705","word":"تَخَلُّفٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9519","lexicalEntryId":"9b25dac2-0898-4a1e-999c-161097e6e705","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَخَلُّفٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عَصَبيٌّ، يُصنَّف ضِمنَ المشكلاتِ اللغويةِ العامَّةِ التي ليسَت ناتجةً عن إصابات مناطِقِ اللغةِ في الدِّماغ، ويُقصَد به تخلُّفُ لغةِ الطفلِ عن النُّموِّ قياسًا على لغة أترابِه؛ لأسبابٍ عَقليةٍ ذهنيةٍ، أو لأسبابٍ اجتماعيةٍ أُسَرِيَّة. فالتخَلُّفُ الناتِجُ عن تخَلُّفٍ عَقلِيٍّ يَشمَل فئات منها ضِعافُ العُقولِ والبُلْهَ والمعتوهِين، ونادرا ما تصِل لغتُهم إلى مستوى طبيعي. أما التخَلُّفُ الناتِجُ عن أسبابٍ اجتماعيةٍ أُسَرِيَّةٍ فيحدُث لدى الأطفالِ الذين حُرِموا من عَطف الوالدَين أو أحدِهما، وتظهَر هذه المشكلةُ في عَدَد المفرَدات، والخَجَلِ من الكلام أمامَ الآخَرين، والتَلَعْثُمِ في الكلام، والأخطاءِ في بعض الأصوات، واستعمالِ الإشارات. ولأن هؤلاء لا يُعانون من تخَلُّفٍ عَقليٍّ، فإن لغَتَهم يمكن أن تتحَسَّن، وتَعود طبيعيةً، بالتدريب والعِلاجِ والاندِماجِ بالمجتَمَع. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تخلف لغوي ","nonDiacriticsLemma":"تخلف لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَخَلُّفٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c59fcf2e-f2d3-4142-ae0b-c7ccf451f0a5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c59fcf2e-f2d3-4142-ae0b-c7ccf451f0a5","word":"صَدْمَةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b951a","lexicalEntryId":"c59fcf2e-f2d3-4142-ae0b-c7ccf451f0a5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَدْمَةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ظاهرةٌ لغويةٌ نفسيةٌ اجتماعيةٌ، تحدُث لمتعلِّم اللغةِ الثانيةِ حين يَجِد نفسَه في بيئة اللغةِ الهَدَفِ فَجأةً، وتتطلَّب الحياةُ فيها استعمالَ اللغةِ الهَدَفِ وفَهمَها مع الناطقين بها، وهو - في الوَقت نفسِه - غيرُ قادِرٍ على ذلك، أو غيرُ واثِقٍ من نفسه. وقد صَنَّفها جون شومان John Schumann، في نظرية المثاقَفَةِ أو التَّطبُّعِ الثقافيِّ Acculturation Theory، ضِمن أبرَزِ العوامِلِ النفسيةِ الاجتماعيةِ التي تُؤثِّر سَلبًا في التَكيُّف الثقافيِّ لمتعلِّم اللغةِ الثانيةِ، ومن ثم يصعُب اكتِسابُ المتعلِّمِ اللغةَ الهَدَف. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صدمة لغوية ","nonDiacriticsLemma":"صدمة لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَدْمَةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

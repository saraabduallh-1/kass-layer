{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2ec624c5-c716-4781-9821-e060496ad07e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2ec624c5-c716-4781-9821-e060496ad07e","word":"مَجْمُوعَةٌ أَقَلِّيٌّةٌ لُغَوِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9505","lexicalEntryId":"2ec624c5-c716-4781-9821-e060496ad07e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَجْمُوعَةٌ أَقَلِّيٌّةٌ لُغَوِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلَحٌ لغويٌّ اجتماعيٌّ، يُطلَق على جَماعَةٍ من الناس، محدودَةِ العَدَد، تتحَدَّث لغةً خاصةً بها، تختَلِف عن اللغة أو اللغاتِ العامَّةِ المهَيمِنَةِ في البَلَد أو المجتَمعِ الذي تَعيش فيه، أي تختَلِف عن لغة الأغلَبِيَّة. وقد يُطلَق هذا الوَصفُ على الأقَلِّيَّة اللَّهَجِية، كالزُّنوج والكاريبيِّين واللاتينيِّين في الولايات المتحدةِ الأمريكيةِ، باعتبار أن لهَجاتِهم مختَلِفةٌ عن الإنجليزية الأمريكيةِ العامَّة. راجع:  @(community language) و  @(majority language) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مجموعة أقلية لغوية ","nonDiacriticsLemma":"مجموعة أقلية لغوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَجْمُوعَةٌ أَقَلِّيٌّةٌ لُغَوِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

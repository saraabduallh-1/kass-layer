{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7b2a486d-349e-4b5b-9271-837c7d305741/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7b2a486d-349e-4b5b-9271-837c7d305741","word":"تَجْرِيدُ الكَلِمَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9516","lexicalEntryId":"7b2a486d-349e-4b5b-9271-837c7d305741","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَجْرِيدُ الكَلِمَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إعادَةُ الكلمةِ إلى أصلها lexeme، بحَذف زَوائدِها، ورَدِّ المتصرِّفِ منها إلى صورَته الأساسِ في صناعَة المدوَّناتِ اللغوية؛ كتَحويل الكلماتِ العربية: (يَكتُبان) و(يَكتُبون) و(اكتُبْ) إلى الفعل (كَتَبَ)، وتحوِيلِ الاسمِ في صيغَتَيْ المثَنّى والجَمعِ إلى المفرَد، وتحويلِ الكلماتِ الإنجليزيةِ: kicks, kicked, kicking، إلى أصلها: kick. ويسمح هذا التَّجريدُ للباحِث باستِخلاص جميعِ أشكالِ الوحدَةِ المعجَميةِ وفحْصِها دونَ حاجَةٍ إلى إدخال كلِّ شَكلٍ على حِدَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تجريد الكلمة ","nonDiacriticsLemma":"تجريد الكلمة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَجْرِيدُ الكَلِمَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

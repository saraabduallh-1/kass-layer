{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/69a6e875-933c-426e-a76d-aa54e2def9e6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"69a6e875-933c-426e-a76d-aa54e2def9e6","word":"غَيرُ لُغَوِيٍّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b896d","lexicalEntryId":"69a6e875-933c-426e-a76d-aa54e2def9e6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"غَيرُ لُغَوِيٍّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتِماعيٌّ، يُشير إلى أيِّ لغةٍ خاصَّةٍ، أو شَكلٍ من أشكال اللغةِ، أو رَطانَةٍ خاصَّة، تَستَعمِلها مجموعةٌ من الأفراد حين يَتكلَّمون في مقامٍ ما، ويَرغَبون في عَدَم فَهمِ الآخَرِين لما يَتَحدَّثون به لأيِّ سَبَبٍ من الأسباب، وغالبا ما تُطلَق على اللغات السِّرِّيَّةِ التي يَستَعمِلها اللُّصوص وقُطَّاعُ الطُّرُقِ والسُّجناءُ. أصبحَت هذه اللغةُ شائعةً بين الشبابِ والمراهقِين العرَبِ الذين لا يتقيَّدون بالقُيود اللغويةِ الاجتماعية، فيَختَرِعون كلماتٍ وأسماءً مرتَبِطَةً بهواياتهم ورَغَباتِهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"غير لغوي ","nonDiacriticsLemma":"غير لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"غَيرُ لُغَوِيٍّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

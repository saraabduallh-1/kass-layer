{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0c74a2b3-5b66-4ce8-b0bb-7d7cfe72c156/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0c74a2b3-5b66-4ce8-b0bb-7d7cfe72c156","word":"مُمَاثَلَةٌ رَجْعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9b3a","lexicalEntryId":"0c74a2b3-5b66-4ce8-b0bb-7d7cfe72c156","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُمَاثَلَةٌ رَجْعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في الأصوات، يُشير إلى أحَد أنواعِ الممَاثَلَةِ assimilation، يُسمّى أيضا تَقريبًا تَوَقُّعِيًّا، وهو أن يَتَغَيَّر صَوتٌ (مُتَقَدِّمٌ) ليُماثِل صَوتًا آخَرَ بعدَه؛ كتَغَيُّر صَوتِ النون إلى الدّال أو الفاءِ أو الباءِ، أو قَريبٍ منها، في الكلمات: (يَندُرُ) و(يَنفَعُ) و(يَنبُعُ)، وتَغَيُّرِ: [n] إلى: [m] لتُماثِل: [p] في الكلمة الإنجليزيةِ: impossible التي أصلُها: in + possible. ويُقابِل هذه المماثَلَةَ المماثَلَةُ التَّقَدُّمِيَّةُ progressive assimilation. راجع:  @(assimilation) و  @(progressive assimilation) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مماثلة رجعية ","nonDiacriticsLemma":"مماثلة رجعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُمَاثَلَةٌ رَجْعِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d2941bb2-0c26-4877-9363-0ae04da2e7cf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d2941bb2-0c26-4877-9363-0ae04da2e7cf","word":"مِقْيَاسُ التَّقْدِيرِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9b3b","lexicalEntryId":"d2941bb2-0c26-4877-9363-0ae04da2e7cf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مِقْيَاسُ التَّقْدِيرِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ إحصائيٌّ يُستَعمَل في اختبارات اللغة لقِياس الكِفايَةِ اللغويةِ لدى شَخصٍ ما يَحكُم عليه مَجموعَةٌ من المحَكَّمِين باستِعمال مِيزانٍ يَبدأ من الأدنى ويَنتَهي بالأعلى في كل جانِبٍ من جَوانِب اللغة. وفي كلِّ مُكوِّنٍ من مُكوِّنات المهارَةِ الواحدة يُعطِي المستَمِعون المتكلِّمَ الدَّرَجَةَ التي يَستِحقُّها في هذه المهارةِ، ويَبدأ مقياسُ التقديرِ من: 1-5، أي من الأسوإ إلى الأحسَن؛ فالواحدُ هو الأسوأ، والخامسُ هو الأحسَن. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مقياس التقدير ","nonDiacriticsLemma":"مقياس التقدير","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مِقْيَاسُ التَّقْدِيرِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/48708d13-6295-4646-aef7-a50e8470d6fc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"48708d13-6295-4646-aef7-a50e8470d6fc","word":"قَابِلِيَّةُ القِرَاءَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9b3c","lexicalEntryId":"48708d13-6295-4646-aef7-a50e8470d6fc","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَابِلِيَّةُ القِرَاءَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"درَجةُ سُهُولَةِ نَصٍّ لغويٍّ أو صُعُوبتُه من حيث قُدرَةُ طلابٍ في مُستَوى معيَّنٍ على قِراءته وفَهمِه، سواء أكان نصًّا أصليًّا أم مُتَرجَمًا. تُعرَّف المقروئيةُ علميًّا بعدة تعريفاتٍ أهمها: التطابُقُ بين المادَّةِ التعليميةِ المكتوبةِ والقُدرَةِ القرائيةِ للطلَبة الذين أُعِدِّت لهم. ومَقروئيَّةُ النَّصِّ تَتَأثَّر بعَدَدٍ من العوامِل، منها: متوسِّطُ طُولِ جُمَلِه، ودَرَجَةُ تَعقيدِها، وعَدَدُ الكلماتِ الجَديدَةِ فيه، ودرَجةُ وُضوحِ طباعَةِ النَّصِّ، مقارَنةً بمستوى الطلبَةِ المُعَدِّ لهم، ودرَجَةُ حَفزِ النَّصِّ للقارئ، إضافةً إلى قُدرَة الكاتِبِ على رَبط المعلوماتِ في النَّصِّ المقروءِ بخبرات القارئ. تَحديدُ المقروئيَّةِ مُهمٌّ في كل مَرحَلَةٍ من مَراحِل التَّعليم؛ للتَّأكُّد من مُناسَبَة الموادِّ التَّعليميَّةِ للطلاب في كل مَرحَلَةٍ أو صَفٍّ. وتُقاس باستِعمال مُعادلاتِ المقروئيَّةِ readability formulae، أو باختِبار التَّتِمَّة cloze test. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قابلية القراءة ","nonDiacriticsLemma":"قابلية القراءة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَابِلِيَّةُ القِرَاءَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cfc16b45-9790-4ab8-b0cf-edad864fd23c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cfc16b45-9790-4ab8-b0cf-edad864fd23c","word":"فَهْمُ المَقْرُوءِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b3d","lexicalEntryId":"cfc16b45-9790-4ab8-b0cf-edad864fd23c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَهْمُ المَقْرُوءِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَهمُ المادَّةِ اللغويةِ المقروءةِ، وهو الهَدَفُ الأسمَى من القراءة، بل هو المقصُودُ بمَهَارَة القراءةِ في تَعليم اللغات، التي هي إحدى المهاراتِ اللغويةِ الأربَع، وهي: فَهمُ المسمُوعِ (الاستِماعُ)، والكلامُ (المحادَثَةُ)، وفَهمُ المقروءِ (القراءةُ)، والكتابة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فهم المقروء ","nonDiacriticsLemma":"فهم المقروء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَهْمُ المَقْرُوءِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5d6b4d95-0b82-4bf9-b5f9-4293e608a532/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5d6b4d95-0b82-4bf9-b5f9-4293e608a532","word":"القِرَاءَةُ في المُحْتَوَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b3e","lexicalEntryId":"5d6b4d95-0b82-4bf9-b5f9-4293e608a532","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"القِرَاءَةُ في المُحْتَوَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَوعٌ من أنواع القراءة، أو أُسلوبٌ من أساليب تَعليمِها، يُعنى بالقراءة من أجل الفَهمِ والتعلُّم. يَهتَمُّ بمُحتَوَى الموادِّ التَّعليميَّةِ الأكاديميَّةِ في الموادِّ المقرَّرَة؛ فتُبنى بناءً لغويًّا نَفسِيًّا تَربويًّا يَرقى بمُستوى الطالبِ في اللغة الهَدَف، ويُوَجِّهُه نحو مَهاراتِ القراءة، ويُيَسِّر له فَهمَ المحتوَى العلميِّ لهذه الموَادّ. هذا النُّوعُ من القراءة يُحَمِّل معلِّمَ المقَرَّرِ الأكاديميِّ، كالعُلوم الطَّبيعيَّةِ والرياضياتِ مثلا، مَسؤوليَّةَ تَدريسِ طُلابِه مَهاراتِ القراءةِ بالدَّرَجة التي يَهتَمُّ فيها بالمحتَوَى العلميِّ لمادَّته. ويُطلَق على هذا النوعِ من القراءة أيضا: content area reading.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"القراءة في المحتوى ","nonDiacriticsLemma":"القراءة في المحتوى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"القِرَاءَةُ في المُحْتَوَى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c78305da-ec38-4ab5-8048-0227466db40c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c78305da-ec38-4ab5-8048-0227466db40c","word":"تَقَبُّلٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9b3f","lexicalEntryId":"c78305da-ec38-4ab5-8048-0227466db40c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَقَبُّلٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ اجتماعيٌّ، يُشير إلى حالَةٍ لدى بعضِ متعلِّمي اللغةِ الثانيةِ تتمثَّل في قُدرَته على تقبُّل ثقافةِ اللغةِ الهدَفِ والاندِماجِ مع الناطقين بها والتعاطُفِ معهم، وهذا مما يُساعِد المتعلِّمين على فَهم المدخَلاتِ اللغويةِ التي تَقود إلى اكتسابِ اللغةِ اكتسابًا حقيقيًّا. يُقابِل ذلك الإحجامُ أو عَدَمُ التَّقبُّل، الذي يحول دونَ تلَقِّي المدخَلاتِ اللغويةِ السليمة، ومن ثم يُعيق اكتسابَ اللغة. لوحِظ أن لِكلا النَّوعَين علاقَةً بالخَلفيَّة اللغويةِ والثقافيةِ لمتعلِّم اللغةِ الثانية؛ فالذي يتقَبَّل بسُهولَةٍ غالبا ما يكون مجتَمَعُه الأصليُّ ثُنائيَّ اللغةِ أو متعَدِّدَ اللغات، أما الذي يجد صعوبةً في تقَبُّل ثقافةِ اللغةِ الهدَفِ فغالبًا ما يكون بلَدُه أُحادِيَّ اللغةِ أو أُحادِيَّ الثقافة. راجع:  @(Acculturation Theory) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"تقبل ","nonDiacriticsLemma":"تقبل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَقَبُّلٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

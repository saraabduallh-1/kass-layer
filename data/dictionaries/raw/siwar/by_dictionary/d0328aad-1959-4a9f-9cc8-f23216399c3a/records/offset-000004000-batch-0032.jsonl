{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/803cca98-0951-47c7-92e1-61857ecc2e78/get-public-entry"},"browse_index_record":{"lexicalEntryId":"803cca98-0951-47c7-92e1-61857ecc2e78","word":"اللُّغَةُ الأَصْلُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9b2f","lexicalEntryId":"803cca98-0951-47c7-92e1-61857ecc2e78","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ الأَصْلُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لغةٌ يَفتَرِض عالِمُ اللغة، أو يُثبِت من خلال البَحثِ، أنها أصْلُ لغةٍ أو أصْلُ مَجموعةٍ من اللغات، وذلك لتَفسير الظواهرِ المشتَرَكَةِ بين مجموعةٍ من اللغات المتَقَارِبَة؛ كاللغة السَّاميَّةِ الأمِّ proto-Semitic بالنِّسبة إلى اللُّغات السَّاميَّة، واللغةِ العربيةِ الأمِّ Proto-Arabic بالنِّسبة إلى العربية، واللغةِ الهنديَّةِ-الأوروبيةِ الأمِّ Proto-Indo-European بالنِّسبة إلى اللُّغات الرُّومانسِيَّة Romance Languages، وكذلك اللغاتُ الجِرمانيةُ الأمُّ Proto-Germanic languages التي هي أصلُ الإنجليزيةِ وغيرِها من اللغات الجِرمانِيَّة. راجع:  @(protolanguage hypothesis) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة الأصل ","nonDiacriticsLemma":"اللغة الأصل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ الأَصْلُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

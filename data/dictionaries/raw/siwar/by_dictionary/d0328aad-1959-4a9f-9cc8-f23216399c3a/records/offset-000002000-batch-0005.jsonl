{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/75db1ae0-410d-4e1b-ae98-8259d3cfe786/get-public-entry"},"browse_index_record":{"lexicalEntryId":"75db1ae0-410d-4e1b-ae98-8259d3cfe786","word":"اللِّسَانِيَّاتُ النِّسْوِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b909e","lexicalEntryId":"75db1ae0-410d-4e1b-ae98-8259d3cfe786","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللِّسَانِيَّاتُ النِّسْوِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اتِّجاهٌ لغويٌّ يُعنَى بدراسَة الاستِعمالاتِ اللغويَّةِ في مخاطَبَة كلٍّ من الجِنسَين، الذَّكَرِ والأُنثى، والمشكلاتِ اللغويةِ الاجتماعيةِ المرتبطَةِ بها؛ لهذا يُسمى النَّقَدَ النّسوِيَّ feminist criticism. يَشمل هذا الاتجاهُ دراسَةَ الفُروقِ بين الجِنسَين في الاستِعمال اللغوي؛ كوَسْم المرأةِ بوَسمٍ أو علامَةٍ تميِّزها عن الرَّجل؛ كعلامَة التأنيثِ مثلا، بالنَّظَر إلى الرَّجُل بأنه الأَصلُ والمرأةُ فَرعٌ، واستِعمالِ ضمائرِ المذكَّر لكلٍّ من الجِنسَين، وكذلك أسماءُ الإشارَةِ والموصولاتُ والإسنادُ، ونحوُ ذلك مما يوحِي بأن الرَّجُلَ أصلُ البَشَر. بيدَ أن اللغاتِ تختَلِف في هذا التَّميِيزِ أو التَّحيُّزِ اللغويِّ للرَّجُل، وما إذا كان مَقبولا أو مَرفوضا في ثقافَة اللغة، ودرَجات القَبولِ أو الرَّفض.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللسانيات النسوية ","nonDiacriticsLemma":"اللسانيات النسوية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللِّسَانِيَّاتُ النِّسْوِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

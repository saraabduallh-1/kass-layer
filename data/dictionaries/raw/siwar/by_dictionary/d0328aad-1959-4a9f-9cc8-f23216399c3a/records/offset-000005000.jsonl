{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/773c0858-c70c-4d8a-8f57-29eba648da08/get-public-entry"},"browse_index_record":{"lexicalEntryId":"773c0858-c70c-4d8a-8f57-29eba648da08","word":"لُغَةٌ تَابِعَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9c11","lexicalEntryId":"773c0858-c70c-4d8a-8f57-29eba648da08","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ تَابِعَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُطلَق على اللغة الأهلِيَّةِ في بَلَدٍ أو مجتَمَعٍ ما، حين تَغزوه لغةُ دَولةٍ عُظمَى، كلُغة المحتَلِّ مثلا، فتَتَعَرَّض اللغةُ الأهليَّةُ لكلِّ أنواعِ التَّأثيرِ من اللغة السَّائدَةِ، فتَقتَرِض منها كلماتٍ وعباراتٍ وتراكيبَ مع احتفاظِها باستقلالها ومركَزِها لُغةً مستَقلَّةً. هذا الغزوُ يُحدِث ظاهرَةً تُعرَف بمنطقة النُّفوذِ اللغويِّ linguistic sphere of influence، حيث يكون لِسانُ المجموعَةِ الغالِبَةِ مستعمَلًا ومَفهُومًا بشَكلٍ واسِعٍ في مَجموعَة اللغاتِ التَّابِعَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة تابعة ","nonDiacriticsLemma":"لغة تابعة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ تَابِعَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

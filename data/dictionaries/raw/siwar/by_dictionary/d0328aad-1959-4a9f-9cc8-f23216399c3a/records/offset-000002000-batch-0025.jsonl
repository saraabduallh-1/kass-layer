{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2da0bc3a-b8ce-4704-a240-40209d0aadc5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2da0bc3a-b8ce-4704-a240-40209d0aadc5","word":"فَجْوَةُ المَعْلُومَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92a5","lexicalEntryId":"2da0bc3a-b8ce-4704-a240-40209d0aadc5","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَجْوَةُ المَعْلُومَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"حالَةٌ في التواصُل بين شخصَين، تكون المعلوماتُ التي لدى أحَدِهما غيرَ مَوجودَةٍ لدى الآخَر. والفَجوَةُ المعلوماتيةُ إستراتيجيةٌ مُهمَّةٌ في تعليم اللغةِ في ضَوء المذهَبِ التواصُليِّ؛ إذ يُفضَّل وُجودُ فَجوَةٍ في المعلومات بين المعلِّمِ والطلابِ أو بين الطلابِ أنفسِهم؛ ليكون التواصُلُ حَقيقيًّا غيرَ مصطَنَع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مجموعةٌ من الأنشِطَة الصَّفِّيَّةِ في تعليم اللغات، تتَمَثَّل في تبادُل المعلوماتِ والآراءِ بين الطلاب، وتَقود إلى استِمالَتِهم إلى استعمال اللغةِ الهَدَفِ وحَفزِهم للتواصُل بها داخِلَ غُرفَةِ الصَّف. من أمثلتها أن يُوزَّع الطلابُ المشاركون في النشاط على مجموعاتٍ صغيرةٍ، يحتَفِظ كلُّ فَردٍ منها بمعلوماتٍ لا يَملِكها زَميلُه، ويكون لدى زَميله - في الوَقت نفسِه - مَعلوماتٌ ليسَت لدى الأول، ثم تُجرَى المحادَثةُ بحيث يُكمِل كُلُّ طالبٍ الفَجوَةَ المعلوماتيةَ التي لديه، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فجوة المعلومات ","nonDiacriticsLemma":"فجوة المعلومات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَجْوَةُ المَعْلُومَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/26246473-464d-496d-a989-c6fc1dde937e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"26246473-464d-496d-a989-c6fc1dde937e","word":"نَظَرِيَّةُ المَعْلُومَاتِ (التَّوَاصُلِيَّةِ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92a6","lexicalEntryId":"26246473-464d-496d-a989-c6fc1dde937e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ المَعْلُومَاتِ (التَّوَاصُلِيَّةِ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النظريةُ التي تَصِف عمَليةَ نظامِ الاتصالِ والإبلاغِ وتَبادُلِ المعلومات؛ أي تَصِف كيفيةَ إصدارِ الرِّسالة، وانتِقالِها من المرسِل إلى المتَلَقِّي، واستقبالِ المتَلَقِّي لها، والأدواتِ والخِياراتِ المتاحةِ في هذه العَمَلية. وتحَدِّد ما يَرتَبط بذلك من جوانبَ لغويةٍ ونفسيةٍ واجتماعيةٍ، كما تحَدِّد الوَسائلَ التي يُقاس بها محتوى الرِّسالةِ كمًّا وكيفًا؛ كالوحدة المعلوماتية، والأنموذَجِ الرياضيِّ للتواصُل، ونحوِ ذلك. وتختَلِف المقايِيسُ باختلاف أساليبِ الاتصالِ ووَسائلِه. راجع:  @(communication theory) و  @(information science) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية المعلومات (التواصلية) ","nonDiacriticsLemma":"نظرية المعلومات (التواصلية)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ المَعْلُومَاتِ (التَّوَاصُلِيَّةِ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/20666362-569b-4044-85bd-3a0503f8b49b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"20666362-569b-4044-85bd-3a0503f8b49b","word":"عَوَامِلُ المُدْخَلاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92a7","lexicalEntryId":"20666362-569b-4044-85bd-3a0503f8b49b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَوَامِلُ المُدْخَلاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ استَعمَله بعضُ اللغويين التطبيقيين للدّلالة على وُجود بعضِ العوامِلِ التي تُميِّز المدخَلاتِ اللغويةِ وتتحَكَّم في نوع الحديثِ الدّائرِ بين الأفراد. قَسَّم لونج Long هذه العواملَ إلى مجموعَتَين أو قِسمَين رئيسَين، هما: المُدخَل، والمُخرَج، ووَضَع تحتَ كلِّ قسمٍ مجموعةً من العوامِل الفَرعية. فجَعَل تحتَ المُدخَلِ عوامِلَ منها: متوسِّطُ طُولِ الوحدات، وعَدَدُ تَفريعاتِ الجُمَل، ونسبةُ مِقيَاسِ النَّمَط، والتَّرَدُّدُ المعجَميُّ للأسماء والأفعال، ونِسبَةُ الروابِطِ في الجُمَل الفعلية. وجَعل تحتَ المُخرَجِ عوامِلَ فرعية منها: علاماتُ زمَن الفعل، وتوزيعُ أساليبِ الاستفهامِ والتقريرِ والأمر، وأُطُرُ المحادَثات، وطلباتُ الإيضاحِ والتأكُّدِ، وتَكرارُ النَّفَسِ، وتَوسيع الدّلالةِ...","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عوامل المدخلات ","nonDiacriticsLemma":"عوامل المدخلات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَوَامِلُ المُدْخَلاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/030d3c55-ba5e-4a93-9bd1-f583fd223299/get-public-entry"},"browse_index_record":{"lexicalEntryId":"030d3c55-ba5e-4a93-9bd1-f583fd223299","word":"ثُنَائِيَّةٌ لُغَوِيَّةٌ رَسْمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92a8","lexicalEntryId":"030d3c55-ba5e-4a93-9bd1-f583fd223299","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ثُنَائِيَّةٌ لُغَوِيَّةٌ رَسْمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ثنائيةٌ لغويةٌ مؤسَّسِيَّةٌ، أي رَسميّةٌ مُلزِمَةٌ لجميع أفرادِ المجتَمَعِ في بلَدٍ ما في مجالات التعليمِ والإعلامِ وكِتابَةِ الوَثائقِ الرَّسمية. تَغلِب هذه الثُّنائيةُ في الدوَلِ والمجتَمَعاتِ متعدِّدَةِ الأعراقِ واللغاتِ، وفي الدوَل التي تكون لغتُها الرَّسميةُ غيرَ اللغةِ الأمِّ للمواطِنين أو لغالبِيَّتهم، حيث يُفرَض على كلِّ فَردٍ تعلُّمَ لغةٍ غيرِ لغتِه الأمّ، وغالبا ما تكون اللغةَ الرسميةَ للدولَة أو اللغةَ العامَّةَ أو العلميةَ لمعظَم أفرادِ المجتَمَع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ثنائية لغوية رسمية ","nonDiacriticsLemma":"ثنائية لغوية رسمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ثُنَائِيَّةٌ لُغَوِيَّةٌ رَسْمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0f2b70e2-7514-4297-b882-c08c9ffeb39a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0f2b70e2-7514-4297-b882-c08c9ffeb39a","word":"عِلْمُ اللُّغَةِ المُؤَسَّسِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b92a9","lexicalEntryId":"0f2b70e2-7514-4297-b882-c08c9ffeb39a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ المُؤَسَّسِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من فروع علمِ اللغة، حديثُ النَّشأةِ نِسبيًّا، يُصنَّف ضِمنَ علمِ الأسلوبِ stylistics، ويُسمّى أيضا علمَ لُغةِ المؤسَّسات. يهتَم هذا العلمُ باللغة المستَعمَلة في السياقات والجوانبِ التَّخَصُّصيَّة؛ كالقانون، والطبِّ، والتربية، والتجارَة، ونحوِ ذلك، ويُعنَى بدراسة اختلافِ استعمالِ اللغةِ من مجالٍ عامٍّ إلى مجالٍ خاصٍّ، ومن علمٍ إلى آخَر، والبحثِ في أسباب هذا الاختلاف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة المؤسسي ","nonDiacriticsLemma":"علم اللغة المؤسسي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ المُؤَسَّسِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cdc9ba3d-7b7c-4710-a114-ded8746c8a5b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cdc9ba3d-7b7c-4710-a114-ded8746c8a5b","word":"تَعَلُّمٌ اسْتِقْلالِيٌّ ذَاتِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8aae","lexicalEntryId":"cdc9ba3d-7b7c-4710-a114-ded8746c8a5b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعَلُّمٌ اسْتِقْلالِيٌّ ذَاتِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نمطٌ من أنماط تعلُّمِ اللغاتِ وتعليمِها، يَنطَلِق من مبدأ يرى أن على متعلِّمي اللغاتِ الأجنبيةِ أن يستَقِلُّوا بأنفسهم، ويكونوا مسؤولين عن استراتيجياتهم وأساليبِهم في التعلُّم، وأن يتحَكَّموا في مراحِل تعلُّمِهم، خارِجَ تقاليدِ حُجرَةِ الدرسِ وسَيطرَةِ المعلِّم. وثمةَ طرائق وأساليب يَقود تَطبيقُها إلى استِقلال المتعلِّم، أهمُّها تعلُّمُ اللغة وتعليمُها بالمهمّات Task-Based Learning/Teaching (TBLT).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعلم استقلالي ذاتي ","nonDiacriticsLemma":"تعلم استقلالي ذاتي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعَلُّمٌ اسْتِقْلالِيٌّ ذَاتِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bac66dfb-7f45-4eed-8966-8032d0fdf764/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bac66dfb-7f45-4eed-8966-8032d0fdf764","word":"آلِيَّةُ الرَّبْطِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8aa2","lexicalEntryId":"bac66dfb-7f45-4eed-8966-8032d0fdf764","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"آلِيَّةُ الرَّبْطِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، استعمَله ستيفن بنكر Steven Pinker في الثمانينيات من القرن العشرين؛ لوَصف العمَلياتِ الإدراكيةِ التي يبدأ فيها الطفلُ اكتسابَ لُغتِه الأم. يرى بنكر أن هذه الآليةَ تفسِّر التّفاعُلَ بين المدخَلاتِ اللغويةِ language input وعمَليةِ اكتسابِ اللغة، وأنها تقوم بفَحص المدخَلاتِ اللغويةِ لتتَّفَق مع العمَليات الإدراكية. هذه الآليةُ لا تقتَصِر على اكتساب التراكيب، وإنما تشمل اكتسابَ الأصواتِ والدّلالةِ أيضا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"آلية الربط ","nonDiacriticsLemma":"آلية الربط","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"آلِيَّةُ الرَّبْطِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7d4f6278-4872-4fcc-8c36-3b7ee016c410/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7d4f6278-4872-4fcc-8c36-3b7ee016c410","word":"التَّحْلِيلُ التَّصَاعُدِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8aa3","lexicalEntryId":"7d4f6278-4872-4fcc-8c36-3b7ee016c410","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"التَّحْلِيلُ التَّصَاعُدِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لُغويٌّ حاسوبيٌّ، يُشير إلى إحدى الطَّريقَتَين الرئيسَتَين للإعراب الآلِي. وتتلَخَّص هذه الطريقةُ في البَدء بكلمات الجُملَةِ المعيَّنَة، وتَصنيفِها إلى أنواعها (الاسم والفعل والحرف)، ثم تحديدِ علاقاتِ المفرَداتِ المتجاوِرَةِ لتَجميع الكلماتِ في عبارات، ثم تَصنيفِ هذه العباراتِ إلى أنواعها (العبارة الفعلية، والعبارة الاسمية، وعبارة الجار والمجرور) ووَظائفِها (الفاعل والمفعول)، ثم تجميعِ هذه العباراتِ تحت نَوعٍ واحدٍ عامٍّ تندَرِج جَميعُها تحتَه، وهو الجُملة. وبذلك يَثبُت أن سِلسِلَةَ الكلماتِ جُملةٌ صحيحةٌ في اللغة فيَتِم تعرُّفُها، أو يَثبُت أنها غيرُ صحيحة، أو غيرُ مَوجودَةٍ في اللغة. وهذه الطريقةُ اختِزالِية؛ لأنها تَصِل من الفُروع إلى أصل واحد. ويُقارَن التحليلُ التصاعُدِيُّ هذا بالتحليل التَّنازُلِيِّ top-down analysis","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"التحليل التصاعدي ","nonDiacriticsLemma":"التحليل التصاعدي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"التَّحْلِيلُ التَّصَاعُدِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

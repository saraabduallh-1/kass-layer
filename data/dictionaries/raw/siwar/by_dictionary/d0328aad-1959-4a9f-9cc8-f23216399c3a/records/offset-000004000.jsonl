{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fba4af9e-442f-4d80-b129-5693c1e2b766/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fba4af9e-442f-4d80-b129-5693c1e2b766","word":"دِرَاسَةُ العَلاقَاتِ الدَّلالِيَّةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9812","lexicalEntryId":"fba4af9e-442f-4d80-b129-5693c1e2b766","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دِرَاسَةُ العَلاقَاتِ الدَّلالِيَّةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ دِلاليٌّ، يُشير إلى علمٍ يُعنَى بدراسة العلاقات بين المعاني، أي دراسةِ مجموعَةٍ من المفاهيم المترابِطَةِ بالنسبة إلى الصِّيَغ والمباني اللغويةِ التي تدُلّ عليها أو تُشير إليها، ومنه تَنظيمُ الوحداتِ المعجَميةِ في مُدوَّناتٍ أو مَكانِزَ لغويةٍ على أساسٍ من المعاني. يُقابِله علمُ المعاني اللَّفظِيُّ أو علمُ الدَّلالَةِ أو تطوُّرُ الدّلالاتِ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دراسة العلاقات الدلالية ","nonDiacriticsLemma":"دراسة العلاقات الدلالية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دِرَاسَةُ العَلاقَاتِ الدَّلالِيَّةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/42061800-9654-49e2-9e00-d60ef62a4088/get-public-entry"},"browse_index_record":{"lexicalEntryId":"42061800-9654-49e2-9e00-d60ef62a4088","word":"اخْتِبَارُ الكِتَابِ المَفْتُوحِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9813","lexicalEntryId":"42061800-9654-49e2-9e00-d60ef62a4088","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِبَارُ الكِتَابِ المَفْتُوحِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اختبارٌ يُسمَح فيه للطالب المختَبَرِ باستعمال كتابٍ أو مجموعةٍ من الكتُب في أثناء أداءِ الاختبار، يُستفاد منه في اختبار المهاراتِ اللغويةِ واختبارِ السُّرعةِ لدى متعلِّمِ اللغة. ولهذا النوعِ من الاختبار طبيعةٌ خاصَّةٌ تَختَلِف عن طبيعة الاختباراتِ الأخرى؛ إذ يَتطلَّب مهاراتٍ خاصّةً، ويَغلِب عليه الطابعُ البَحثيُّ الاستِنتاجِيُّ، وإبداءُ الرأيِ المبنيِّ على أدلَّةٍ علميةٍ واستنتاجاتٍ منطِقِية، ومن النادِر أن تكون الإجابَةُ عن أسئلته قصيرةً أو ميَسَّرَةً أو مباشِرَةً.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار الكتاب المفتوح ","nonDiacriticsLemma":"اختبار الكتاب المفتوح","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِبَارُ الكِتَابِ المَفْتُوحِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d96071d5-3920-4b4e-9ac0-009695777fe6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d96071d5-3920-4b4e-9ac0-009695777fe6","word":"سُؤالٌ مَفْتُوحُ النِّهَايَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9814","lexicalEntryId":"d96071d5-3920-4b4e-9ac0-009695777fe6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"سُؤالٌ مَفْتُوحُ النِّهَايَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سؤالٌ في الاختبار غيرُ مُحدَّدَةٍ إجابتُه، يَسمَح للفَرد المختَبَرِ أن يُجيب عنه بأسلوبه، وغالبًا ما يَكون إجابةً عن كلماتٍ استِفهاميةٍ مثل: (كيف) و(لماذا) و(ما هذا)، ويسمّى أيضا استجابةً مفتوحةَ النهايَة open-ended response. يُقابِله السؤالُ المغلَقُ الذي لا يَحتَمِل إلا إجابةً واحدةً محدَّدَة؛ كما في اختبار الاختيارِ من متَعَدِّد، واختبارِ الصّواب والخَطأ، واختبارِ المزاوَجَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"سؤال مفتوح النهاية ","nonDiacriticsLemma":"سؤال مفتوح النهاية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"سُؤالٌ مَفْتُوحُ النِّهَايَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

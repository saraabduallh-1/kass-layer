{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/34e8674c-75fe-4b3c-827c-bce1512aa231/get-public-entry"},"browse_index_record":{"lexicalEntryId":"34e8674c-75fe-4b3c-827c-bce1512aa231","word":"النُّوفِيَالُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9810","lexicalEntryId":"34e8674c-75fe-4b3c-827c-bce1512aa231","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النُّوفِيَالُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"لغةٌ مَصنوعةٌ، وَضَعها اللغويُّ الدانمركيُّ أوتو يسبرسن Otto Jespersen عام 1928م، واعتَمَد في وَضعَ مفرَداتِها على لغة الأيْدو Ido، واستَمَدَّ معظمَ قواعدِها من لغة الأوكسيدينتال Occidental، وأصبحَت واحدةً من ستِّ لغاتٍ عالَميةٍ مُصطَنَعةٍ artificial languages.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"النوفيال ","nonDiacriticsLemma":"النوفيال","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النُّوفِيَالُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9d028a7d-1fad-4bf5-b8e5-81e9a0c0fb81/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9d028a7d-1fad-4bf5-b8e5-81e9a0c0fb81","word":"الإنْجلِيزِيَّةُ الرَّسْمِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9811","lexicalEntryId":"9d028a7d-1fad-4bf5-b8e5-81e9a0c0fb81","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإنْجلِيزِيَّةُ الرَّسْمِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"حَرَكةٌ ظهَرَت في الولايات المتحدةِ الأمريكيةِ، هَدَفُها جَعلَ اللغةِ الإنجليزيةِ هي اللغةَ الرَّسميةَ الوحيدةَ في الدولة. وتُسانِد هذه الحرَكةَ حَرَكتان هما: (إنجليزيةُ الولاياتِ المتحدة)، و(الإنجليزيةُ أوّلًا)، تَدَّعِيان أن الإنجليزيةَ تتَعَرَّض للضَّياع بسبَب برامج التربيةِ ثُنائيةِ اللغةِ والهِجرَةِ المتزايدَة. يُقابِل ذلك كلَّه حرَكةٌ أخرى تُسمى: (إنجليزية مُضافَة)، وهي حرَكةٌ مُعاكِسَة يرى أصحابُها أن من مصلَحَة الولاياتِ المتحدةِ الأمريكيةِ أن يُتقِن مُواطِنوها لغةً أخرى غيرَ الإنجليزية؛ بسبَب العَولَمَةِ المتزايدَةِ للمجتَمَع، والمهاراتِ اللازِمَةِ للعَيش في مجتَمَع متعَدِّدِ الثقافات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإنجليزية الرسمية ","nonDiacriticsLemma":"الإنجليزية الرسمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإنْجلِيزِيَّةُ الرَّسْمِيَّةُ"}],"lemmaLanguage":{"code"
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7526c36e-77bd-4691-a5fb-8012ca07c736/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7526c36e-77bd-4691-a5fb-8012ca07c736","word":"صَوْتٌ غَيرُ لُغَوِيٍّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b980e","lexicalEntryId":"7526c36e-77bd-4691-a5fb-8012ca07c736","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"صَوْتٌ غَيرُ لُغَوِيٍّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُطلَق وَصفًا على كل ما تَستَقبِله الأُذُن من أصواتٍ غيرِ لغوية؛ كصَوت الرَّعد، وصَوتِ الرِّيح، وأصواتِ الآلاتِ والسيارات، ونحوِ ذلك مما لا يدخُل ضِمنَ الصوتِ اللغوي. هذا النوعُ من الأصوات تَستَقبِله الأُذُن البَشَريةُ فيَذهَب إلى الجانِب الأيمَن من الدِّماغ، خلافا للصوت اللغويِّ الذي يذهب مُعظَمُه إلى الجانب الأيسَر منه. تُلحَق بهذا الصوتِ غيرِ اللغويِّ، من الناحية النفسيةِ العَصَبية، الأصواتُ اللغويةُ حين تكون بلُغَةٍ لا يَعرِفها السّامِع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"صوت غير لغوي ","nonDiacriticsLemma":"صوت غير لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"صَوْتٌ غَيرُ لُغَوِيٍّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c1f06553-89f7-470e-a52a-366c367e9f14/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c1f06553-89f7-470e-a52a-366c367e9f14","word":"مَفْهُومُ الذَّاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9cbb","lexicalEntryId":"c1f06553-89f7-470e-a52a-366c367e9f14","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَفْهُومُ الذَّاتِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ نَفسِيٌّ، يَعني فِكرَةَ المرءِ عن ذاته أو نظرَتَه إلى ذاته، وهي الصُّورَةُ الذِّهنِيَّةِ التي يُكَوِّنها الفَردُ عن نفسه أو ذاتِه. ومَفهومُ الذَّاتِ هو الذي يُحدِّد إنجازَ المرءِ الفِعلِيَّ، ويَظهر جُزئيًّا من خِبراته بالواقِع واحتِكاكِه به، ويَتَأثَّر بالأحكام التي يَتَلقَّاها من الأشخاص المهمِّين في حياته، وبتَفسيره لاستِجاباتِهم نحوَه. قد يتغَيَّر مَفهومُ الذاتِ لدى المرءِ حين يتعلَّم لغةً ثانيةً، حيث يتَلقّاها في بيئتها، ويتَثاقَف بثَقافَة الناطقين بها. هذا المفهومُ يمكن دراسَتُه ضِمنَ دراسَةِ المتَغَيِّراتِ الوِجدانِيَّةِ في تَعلُّم اللغة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مفهوم الذات ","nonDiacriticsLemma":"مفهوم الذات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَفْهُومُ الذَّاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

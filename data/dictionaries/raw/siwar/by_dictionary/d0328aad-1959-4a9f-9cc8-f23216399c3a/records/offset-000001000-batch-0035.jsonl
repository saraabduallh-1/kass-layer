{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f4a981c1-d202-42ef-882c-95150da4e06d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f4a981c1-d202-42ef-882c-95150da4e06d","word":"إقْحَامُ الصَّوْتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8fa7","lexicalEntryId":"f4a981c1-d202-42ef-882c-95150da4e06d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إقْحَامُ الصَّوْتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إقحامُ صَوتٍ خارِجيٍّ بين صَوتَين للتَّمَكُّن من نُطقهما، مثلُ حَرَكةِ التَّخَلُّصِ من التِقاء الساكِنَين في العربية. من ذلك إقحامُ الكَسرَةِ في مكانِ السُّكونِ في فعل الأَمرِ، نحو: كُلِ الطعامَ، وقُلِ الحَقَّ؛ ومنه نونُ الوِقايَةِ التي تُقحَم قبلَ ياءِ المتكلِّمِ في نحو: أطعَمَنِي رَبِي. ومنه إقحامُ صائتٍ أو صامِتٍ في وسط الكلمةِ تَسهيلا للَفظِها أو لإخضاعِها - إذا كانت دَخيلَةً - لصِيَغ اللغةِ المقتَرِضَة. ومن ذلك إضافَةُ متعلِّمِ اللغةِ الأجنَبيةِ صائتا بين صامِتَين في الكلمة خَطأً، ويحدُث هذا غالباً إذا لم يتعوَّد المتعلِّمُ على تجمُّع الصوامتِ في لغته الأمِّ؛ فتتحَوَّل الكلمةُ الإنجليزيةُ: speak إلى: espeak أو sepeak، وكذلك الكلمةُ الإنجليزيةُ: film حين تتحَوَّل إلى: filem.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إقحام الصوت ","nonDiacriticsLemma":"إقحام الصوت","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إقْحَامُ الصَّوْتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

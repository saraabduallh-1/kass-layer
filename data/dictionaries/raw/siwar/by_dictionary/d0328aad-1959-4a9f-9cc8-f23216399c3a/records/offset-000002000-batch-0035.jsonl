{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7f65108e-dafe-4d29-98cf-f612a6bbdb9b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7f65108e-dafe-4d29-98cf-f612a6bbdb9b","word":"تَنَوُّعٌ تَبَادُليٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b93a0","lexicalEntryId":"7f65108e-dafe-4d29-98cf-f612a6bbdb9b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَنَوُّعٌ تَبَادُليٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ظاهِرةٌ لغويةٌ اجتماعيةٌ وعامِلٌ مؤثِّرٌ في اكتساب اللغةِ الثانية، تُشير إلى تعَرُّضِ متعَلِّمِ اللغةِ إلى أكثَر من مستوًى لَهَجيٍّ للُّغَة الهَدَف، وتنَوُّعِ أدائه فيها بناء على ذلك، في مُقابِل أن يتَعَرَّض متعلِّمٌ ما للَهجَةٍ واحدة، ويتَعَرَّض غيرُه للَهجَةٍ أخرى غيرِ لهجَةِ الأول، ويتَعَرَّض ثالثٌ إلى لَهجَةٍ ثالثةٍ غيرِ لَهجَتَيْ سابِقَيْه، وهكذا. ويُقابِل التنَوُّعَ التبادُليَّ هذا التنوُّعُ داخِلَ اللَّهجَةِ أو المستوى اللَّهَجِيِّ الواحدِ للُّغة الهَدَفِ intra-speaker variation.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تنوع تبادلي ","nonDiacriticsLemma":"تنوع تبادلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَنَوُّعٌ تَبَادُليٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

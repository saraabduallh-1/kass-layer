{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/91e910fb-a1f0-4b35-8812-8d93ca64dcb3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"91e910fb-a1f0-4b35-8812-8d93ca64dcb3","word":"اخْتِيَارُ الشّفْرَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8bac","lexicalEntryId":"91e910fb-a1f0-4b35-8812-8d93ca64dcb3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِيَارُ الشّفْرَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يَعني اختِيارَ المتحَدِّثِ لغةً ما أو مستوى من اللغة في مقامٍ معيَّن، وذلك في مجتَمَعٍ ثُّنائيِّ اللغةِ أو ثُّنائيِّ اللَّهجَةِ أو متعَدِّدِ اللغاتِ أو اللَّهَجات، فيختار ثُنائيُّ اللغةِ أو متعدِّدُ اللغاتِ لغةً معيَّنةً لشَخصٍ معيَّنٍ في مقام معيَّن. فالصينيون في سنغافورة مثلا يستَعمِلون الصينيةَ في المنزِل، والإنجليزيةَ السنغافورِيةَ في العَمَل، والملايَوِيَّةَ التجاريةَ مع التُّجّار من الملاوِيِّين والهنود. وقد يكون العُمُرُ أو الجِنسُ أو مستَوَى التعليمِ هو الذي يحَدِّد نَوعَ الشّفرَةِ المختارَة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختيار الشفرة ","nonDiacriticsLemma":"اختيار الشفرة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِيَارُ الشّفْرَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

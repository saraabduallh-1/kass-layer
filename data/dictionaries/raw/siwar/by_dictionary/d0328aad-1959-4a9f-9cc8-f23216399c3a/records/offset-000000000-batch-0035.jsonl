{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/872833c9-5f69-4d29-9beb-90b99f89d635/get-public-entry"},"browse_index_record":{"lexicalEntryId":"872833c9-5f69-4d29-9beb-90b99f89d635","word":"عِلْمُ اللُّغَةِ المَقَارَنُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8bb9","lexicalEntryId":"872833c9-5f69-4d29-9beb-90b99f89d635","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ المَقَارَنُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من فروع علمِ اللغة، يَدرُس لغَتَين أو أكثَر، ولاسيّما اللغاتُ التي تَنتَمي إلى عائلَةٍ لغويةٍ واحدة؛ لمقارَنَة أنظِمَتِها الصوتيةِ والصرفيةِ والنحويةِ والدّلالية، وتحديدِ مواضِعِ التَّشابُهِ والاختلافِ بينها. وقد يُطلَق على دراسة اللغةِ الواحدة في مرحَلَتَين مختَلِفَتَين. وعلمُ اللغةِ المقارَنِ مُهِمٌّ في تَصنيف اللغاتِ إلى أُسَرٍ لغوية، وفي تَعليمها لغاتٍ ثانيةً أو أجنَبيةً؛ لأن معرِفةَ مواضِعِ الاختلافِ والاتِّفاقِ بين اللغتَين، الأمِّ والهَدَفِ، قد يساعِد في إعداد موادَّ تعليميةٍ مناسِبةٍ لمجموعَةٍ من المتعلِّمين الناطقين بلُغَةٍ معيَّنة. راجع:  @(Contrastive Analysis (CA)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة المقارن ","nonDiacriticsLemma":"علم اللغة المقارن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ المَقَارَنُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e426e26b-59b0-4fb1-93e7-d7bfc63cf219/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e426e26b-59b0-4fb1-93e7-d7bfc63cf219","word":"فَرضِيَّةُ التَّوَازُنِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8aca","lexicalEntryId":"e426e26b-59b0-4fb1-93e7-d7bfc63cf219","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرضِيَّةُ التَّوَازُنِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فَرضيةٌ لغويةٌ تطبيقيةٌ تعليميةٌ، ظهَرَت في الستينيات من القرن العشرين، يرَى أصحابُها، وعلى رأسهم التربويُّ الأمريكيُّ جون ماكنمارا John Macnamara، أن للثّنائية اللغويةِ أثَرا سلبيًّا في مَهارات الفَردِ بلغَته الأمِّ. ويرَى هؤلاء أن قدراتِ الإنسانِ اللغويةَ العصَبيةَ محدودَة، وأن تعلَّمَ الفَردِ لغةً ثانيةً أو أجنبيةً يزاحِم لغَتَه الأمَّ، ويجعله أقَلَّ قُدرَةً فيها من أحادِيِّ اللغة. يَستَدلِّون على ذلك بحالات الأطفالِ الأمريكيِّين الذين يتعلَّمون الإسبانيةَ في مدارس الولاياتِ الأمريكيةِ الجنوبية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية التوازن ","nonDiacriticsLemma":"فرضية التوازن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرضِيَّةُ التَّوَازُنِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

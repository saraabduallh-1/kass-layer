{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8b294d39-fb62-448c-a61c-25949b013ec7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8b294d39-fb62-448c-a61c-25949b013ec7","word":"المَذْهَبُ المُتَكَامِلُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b936c","lexicalEntryId":"8b294d39-fb62-448c-a61c-25949b013ec7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَذْهَبُ المُتَكَامِلُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ أو مَدخَلٌ في تعليم اللغة، تُقدَّم فيه المهاراتُ اللغويةُ الأربعُ (الاستماع والمحادثة والقراءة والكتابة) بطريقَةٍ تَكامُلية. فكُلُّ مهارَةٍ تخدِم المهاراتِ الأخرى، وكلُّ نَشاطٍ في مهارَةٍ يخدِم أنشِطةَ المهاراتِ الأخرى ويُكمّلها. تُقدَّم المهاراتُ في الكتاب الأساس، وقد تُمارَس كلُّها في حِصَّة واحدة، خِلافا لتدريس كلِّ مهارَةٍ منفَصِلةً عن المهارات الأخرى، سواء قدِّمَت في مرحَلةٍ واحدةٍ أو في مراحِلَ مختَلِفة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المذهب المتكامل ","nonDiacriticsLemma":"المذهب المتكامل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَذْهَبُ المُتَكَامِلُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

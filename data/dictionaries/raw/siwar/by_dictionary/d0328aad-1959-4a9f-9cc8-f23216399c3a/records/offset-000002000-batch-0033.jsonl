{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/127d3c23-29cc-4b30-b695-8e26aedcf516/get-public-entry"},"browse_index_record":{"lexicalEntryId":"127d3c23-29cc-4b30-b695-8e26aedcf516","word":"تَحْلِيلُ التَّفَاعُلِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b936e","lexicalEntryId":"127d3c23-29cc-4b30-b695-8e26aedcf516","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ التَّفَاعُلِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَحليلُ ما يجرِي في حُجرَة الصَّفِّ من تفاعُلٍ وتواصُلٍ ونشاطٍ بين المعلِّم والطلاب، وبين الطلابِ أنفسِهم. ويُستَفاد من هذا التحليلِ في جوانِب عديدة، منها: وَصفُ طبيعةِ التفاعُلِ الصَّفِّيِّ، وتَقويمُه، وتحديدُ العلاقةِ بين عمَلِيَّتَيْ التعليمِ والتعلُّم، وتقويمُ أداءِ المعلِّمين والطلاب، وتَحسينُ العَمَليةِ التعليمية، ومساعَدةُ المعلِّمين المتَدَرِّبين pre-service teachers على فَهم العمَليةِ التعليمية، وإثراءُ البحثِ العلميِّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل التفاعل ","nonDiacriticsLemma":"تحليل التفاعل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ التَّفَاعُلِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

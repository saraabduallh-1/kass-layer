{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9c070e91-f7b6-44be-a6e0-6912cbb06d44/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9c070e91-f7b6-44be-a6e0-6912cbb06d44","word":"انْطِوَائيٌّ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9369","lexicalEntryId":"9c070e91-f7b6-44be-a6e0-6912cbb06d44","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"انْطِوَائيٌّ ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"صِفةٌ للشَّخص المنطَوِي على نفسه، الذي يتَجَنَّب الاختِلاطَ بالناس، ويَهتَمُّ بذاته وشُعُورِه وخِبراتِه، خلافا للشَّخص المنبَسِطِ الشَّخصية extrovert، الذي يَستَمتِع بالاختِلاط بالناس والتفاعُلِ معهم. وعلى الرَّغم من صُعُوبَة التَّفريقِ بين الشَّخصِيَّتَين، وظُهورِ كلا النَّمَطَين في سُلوكِ شَخصٍ واحدٍ أحيانا كثيرة، فإن بعض اللغويين التطبيقيين يرَون أن الشخصَ المنبَسِطَ أقدَرُ على تعلُّم اللغةِ من الشخص المنطوِي. والانطوائيةُ من العوامِل النفسيةِ الاجتماعيةِ التي تُعَدُّ من أهم الفُروقِ الفَردِيةِ والعوامِلِ المؤثِّرَةِ في اكتساب اللغةِ الثانية. راجع:  @(extravert/extrovert) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"AR","root":null,"wordForms":[],"relatedSenses":[],"search":"انطوائي  ","nonDiacriticsLemma":"انطوائي ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"انْطِوَائيٌّ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

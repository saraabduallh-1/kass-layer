{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dcded74c-c3a2-4990-a548-f9bb72133271/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dcded74c-c3a2-4990-a548-f9bb72133271","word":"تَعْلِيمُ اللُّغَةِ بالمُحْتَوَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b940a","lexicalEntryId":"dcded74c-c3a2-4990-a548-f9bb72133271","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْلِيمُ اللُّغَةِ بالمُحْتَوَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهجٌ أو طريقةٌ في تعليم اللغاتِ الأجنبيةِ والثانية، تُقَدَّم فيه اللغةُ الهَدَفُ للأجانب في مرحَلةٍ مبكّرةٍ، أي قبلَ تَمَكُّنهم من مهاراتها، من خلال محتوى نصوصٍ طبيعيةٍ غيرِ مَصنوعَة. يهتَمُّ هذا المنهجُ بتَنميَة مهاراتِ الطلابِ في المقرَّرات الأساسيةِ في المدرسة أو الجامعةِ أكثَرَ من اهتِمامه باللغة نفسِها. ولهذا المنهجِ عدَّةُ تطبيقات، أبرَزُها برنامجُ الدَّمجِ أو الانغِماسِ immersion program، وهو إدماجُ الناطقِ بغير لغةِ التدريسِ في برامجَ تعليميةٍ أعِدِّت مقرَّراتُها للناطقين بها في مراحِل التعليمِ الأساسِ أو في الجامعة، من غير شَرحٍ مباشِرٍ للغة بطَريقَةٍ منفَصِلةٍ عن المحتوَى المقَدَّم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم اللغة بالمحتوى ","nonDiacriticsLemma":"تعليم اللغة بالمحتوى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْلِيمُ اللُّغَةِ بالمُحْتَوَى"}],"lemmaLanguage":{
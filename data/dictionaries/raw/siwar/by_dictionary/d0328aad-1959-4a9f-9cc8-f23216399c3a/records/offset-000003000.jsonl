{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8c8cfc75-184f-4487-b038-88ca24a4ae10/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8c8cfc75-184f-4487-b038-88ca24a4ae10","word":"مَعْمَلُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b940e","lexicalEntryId":"8c8cfc75-184f-4487-b038-88ca24a4ae10","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَعْمَلُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في تعليم اللغات، يُطلَق على غُرفَةٍ مُخَصَّصةٍ لتعليم اللغةِ الثانيةِ أو الأجنَبيةِ بالوَسائل السَّمعيةِ أو السَّمعيةِ البَصَرِية، مُجَهَّزَةٍ بأجهِزةِ تَسجيلٍ سَمعيٍّ وبَصَريٍّ، ومكَوَّنةٍ من مَقصوراتٍ للطلاب مَوصُولةٍ بمَقصورَةٍ للمعلِّم. وكان مَعمَلُ اللغةِ في السابق مُعَدًّا لفَهم المسموعِ والمحادَثَةِ أحيانا؛ لاقتِصاره على أجهِزَة التَّسجيلِ الصوتيِّ، أما الآنَ فقد أصبَح مكانا لممارَسة جميعِ المهاراتِ اللغويةِ بطريقَةٍ تفاعُلية؛ بسبَب تطَوُّرِ الأنظِمةِ الحاسوبيةِ وتوفُّرِ الشَّبكاتِ الإلكترونية. وكثيرا ما يُستَعمَل هذا المصطلحُ مختَصَرا فيُقال: language lab.. راجع:  @(audio booth) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معمل اللغة ","nonDiacriticsLemma":"معمل اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَعْمَلُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}
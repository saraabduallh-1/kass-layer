{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c3aef134-57c0-400c-af98-eac5d6dd8c8f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c3aef134-57c0-400c-af98-eac5d6dd8c8f","word":"أُنْمْوذَجُ كرَاشِنْ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b940f","lexicalEntryId":"c3aef134-57c0-400c-af98-eac5d6dd8c8f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمْوذَجُ كرَاشِنْ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أنموذجٌ أو نظريةٌ وَضَعَها عالم النفس الأمريكي ستِيفن كراشِن Steven Krashen لتَفسير اكتسابِ اللغةِ الثانية، أطلَق عليها نظريةَ المراقِبِ The Monitor Theory. بنى كراشن نظريتَه هذه على خَمس فَرضِيات، هي: الفَصلُ التامُّ بين عمَليَّتَيْ اكتسابِ اللغةِ وتعلُّمِها، والتدرُّج الطبيعيُّ في اكتساب اللغة، ومُراقَبَةُ المتعلِّمِ حديثَه، والمدخَلُ اللغويُّ، والمصَفِّي الانفعاليُّ. بيدَ أن الفَرضيةَ الأولى هي أبرَزُ هذه الفَرضيات؛ إذ أكَّد فيها أن اكتسابَ اللغةِ الثانيةِ أو الأجنبيةِ يختَلِف اختِلافًا كُلِّيًّا عن تعلُّمِها، وأن هذا الاكتسابَ لا يحدُث نتيجَةَ التعلُّم، ما لم تتحَوَّل بيئةُ التعلُّمِ إلى جَوٍّ طبيعيٍّ شَبيهٍ بالجوِّ العامِّ للُّغة الهَدَف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج كراشن ","nonDiacriticsLemma":"أنموذج كراشن","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمْوذَجُ كرَاشِنْ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d45b6f11-ac2f-47cc-aecb-f603d8ad5a7c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d45b6f11-ac2f-47cc-aecb-f603d8ad5a7c","word":"جِهَازُ اكْتِسَابِ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9410","lexicalEntryId":"d45b6f11-ac2f-47cc-aecb-f603d8ad5a7c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جِهَازُ اكْتِسَابِ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلَحٌ استَعمَله تشومسكي في وَصفه لاكتِساب اللغة، يُطلِقه وَصفًا لجِهازٍ وَهمِيٍّ مَغروسٍ في دِماغ كلِّ طفلٍ منذُ ولادَتِه، يُوَجِّه اكتسابَه للُّغة، ويرمز له بالرمز: LAD. يَستَعمِل الطفلُ هذا الجهازَ في فَهم الكلامِ الذي يَسمَعه، وفَرضِ الفُروضِ حَولَ القواعدِ التي تُنظِّمه، واختبارِ الفُروض من المُدخَلات اللغويةِ، وغيرِ ذلك من العَمَليات التي تخضَع للقواعد الكُلِّيَّةِ للغة الإنسانية. ويرى تشومسكي أن هذا الجِهازَ هو الحَلُّ لما أُطلِق عليه: المسألَةُ المنطِقِيَّةُ في اكتساب اللغةِ The logical problem of language acquisition.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جهاز اكتساب اللغة ","nonDiacriticsLemma":"جهاز اكتساب اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جِهَازُ اكْتِسَابِ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/99a66729-5a1b-4425-9049-16b60297dad6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"99a66729-5a1b-4425-9049-16b60297dad6","word":"اللُّغَةُ والأيْديُولُوجِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9411","lexicalEntryId":"99a66729-5a1b-4425-9049-16b60297dad6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ والأيْديُولُوجِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يَعني استعمالَ اللغةِ سِلاحًا سياسيًّا أو اجتماعيًّا أو دِينيًّا. وغالبا ما يحدُث هذا الأمرُ في الدوَل المتعدِّدَةِ الأعراقِ أو اللغاتِ أو الدِّياناتِ أو الطَّوائفِ أو الاتجاهاتِ السياسية. فتَجِد الدولةُ أن من واجِبها توحيدَ اللغةِ القَوميَّة لفَرض أيديولوجيةٍ معيَّنَةٍ أو مَنعًا لتَدَخُّل الأيديولوجياتِ من خِلال لُغاتِها، كما حَصَل في فرنسا بُعَيدَ الثورَةِ الفرنسية، حيث فُرِضَت الفرنسيةُ الباريسيةُ Parisian French في جميع مجالات الحياة، وأُقِرَّت القوانينُ التي تَمنَع استعمالَ غيرِها من اللغات. وحَدَث مثلُ ذلك في إسبانيا بعد الحَربِ الأهلية، حين فُرِضَت اللغةُ الإسبانيةُ التي كانت تُسمّى لغةَ المسيحيين، ومُنِعَ استعمالُ لغاتٍ أخرى، مثلُ: الباسْك Basque والكَتَلانِية Catalan. وقد يحدُث العَكسُ، وذلك حين تُطالِب الإثنِياتُ العِرقيةُ بالاعتِراف بلغاتها كإحدى اللغاتِ الوَطَنية، واللغة الأولى في مناطِقِهم داخِلَ الدولةِ في التعليم والمعامَلات الحكومية والتجارية؛ كما حَصَل للُغة الباسك واللغةِ الكَتَلانية في إسبانيا، واللغَتَين الإيرلَندِية والوِيلزِية في بريطانيا. ولم يتوَقَّف الأمرُ على ذلك، فالأجيالُ التي لا تَعرِف تلك اللغاتِ العِرقيةِ بدَأت تتعَلَّمها من جَديد، وتُدافِع عنها. وقد تتَمَسَّك الإثنياتُ العِرقيةُ بلغاتها لأسبابٍ أيديولوجيةٍ حين تحدُث تَغَيُّراتٌ سياسيةٌ في الدولَة أو المجتَمَع؛ لتَحصيل أكبَر قَدرٍ من الحُقوق السياسيةِ أو الاجتماعيةِ أو الدِّينِية؛ كما حَدَث في العراق وتركيا والسودانِ والمغرِبِ والجزائرِ في السنوات الأخيرة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة والأيديولوجية ","nonDiacriticsLemma":"اللغة والأيديولوجية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ والأيْديُولُوجِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/aeb1cc8e-5d89-468d-836a-8123f3fdd3f7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"aeb1cc8e-5d89-468d-836a-8123f3fdd3f7","word":"فَهْمُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9412","lexicalEntryId":"aeb1cc8e-5d89-468d-836a-8123f3fdd3f7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَهْمُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"العَمَلياتُ الذِّهنِيةُ التي تَقود المرءَ إلى فَهمِ المعنى في نَصٍّ مَنطوقٍ أو مَكتوب، وتُدرَس ضِمنَ نظرياتِ علمِ اللغةِ النفسيِّ، وعلمِ النفسِ المعرِفيِّ، واكتسابِ اللغةِ الثانية. ومن هذه العمَلياتِ الملاحَظةُ والإدراكُ والتحليلُ والتركيبُ والتصوُّرُ والتَّجريدُ ونحوُ ذلك، إضافةً إلى المعرِفة اللغويةِ باللغة الهَدَفِ وما تتطَلَّبه هذه المعرِفةُ من عواملَ داخليةٍ وخارجية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فهم اللغة ","nonDiacriticsLemma":"فهم اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَهْمُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

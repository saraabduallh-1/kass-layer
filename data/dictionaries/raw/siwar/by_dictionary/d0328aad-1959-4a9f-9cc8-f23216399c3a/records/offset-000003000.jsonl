{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8cd27e56-3fa7-4519-8786-65c8e504665a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8cd27e56-3fa7-4519-8786-65c8e504665a","word":"تَوْثِيقٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9415","lexicalEntryId":"8cd27e56-3fa7-4519-8786-65c8e504665a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوْثِيقٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ عامٌّ، يُقصَد به التَّسجيلُ المنظَّمُ لعَيِّناتٍ من اللغة المنطوقَةِ والمكتوبَة، لأغراضٍ مختَلِفَة؛ كدراسَة حاضِرِ اللغةِ ومُقارَنَتِها بماضيها، ورَصدِ نُمُوِّها وتَطَوُّرِها، أو لحِفظ اللغاتِ أو اللهَجاتِ المهدَّدَةِ بالانقِراض.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ تَطبيقيٌّ، يُقصَد به تَسجيلُ النُّمُوِّ اللغويِّ المرحَليِّ لعيِّناتٍ من متعلِّمي لغةٍ معيَّنة، أو تَسجيل النُّمُوِّ اللغويِّ لمجموعَةٍ من الأطفال؛ لأغراض البَحثِ العِلميِّ في النُمُوِّ اللغويِّ واكتِسابِ اللغةِ الأمِّ أو اللغةِ الثانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"توثيق لغوي ","nonDiacriticsLemma":"توثيق لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَوْثِيقٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGenera
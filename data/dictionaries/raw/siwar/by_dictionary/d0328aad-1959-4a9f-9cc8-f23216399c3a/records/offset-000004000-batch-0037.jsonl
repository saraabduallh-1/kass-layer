{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/217e4252-59fa-4c12-8ba7-bc39e31fb317/get-public-entry"},"browse_index_record":{"lexicalEntryId":"217e4252-59fa-4c12-8ba7-bc39e31fb317","word":"أُسْلُوبُ المَقَامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9bbb","lexicalEntryId":"217e4252-59fa-4c12-8ba7-bc39e31fb317","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُسْلُوبُ المَقَامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مُستَوَى التَّعبيرِ بنوعَيه المنطوقِ والمكتُوب، ويَتَمَثَّل في اختِلاف طَريقَةِ كَلامِ المتكلِّمِ؛ بحسب المقامِ، أو مَوضوعِ الكلامِ: (عِلميّ، أدَبيّ، صَحَفيّ)، أو نَوعِه: (محادَثة، خَطابَة، كتابَة)، أو نَوعِ المخاطَبِين ومُستَوَاهم: (كِبار، صِغار، رُؤساء، مَرؤوسون). وكلُّ مَقامٍ يَتَطَلَّب مُفرَداتٍ أو صِيَغا أو تَراكيبَ مُعيَّنةً، أو طَريقَةَ نُطقٍ مُعيَّنَةً تُناسِب طَبيعَةَ المخاطَبِين. وقد يُطلَق على الأُسلوب الذي يُمَيِّز شَخصا في الكلام أو في الكتابة ويُعرَف به. راجع:  @(style) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أسلوب المقام ","nonDiacriticsLemma":"أسلوب المقام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُسْلُوبُ المَقَامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

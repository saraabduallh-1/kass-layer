{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0e32bc31-e047-490c-af4c-dcdcda1cec3e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0e32bc31-e047-490c-af4c-dcdcda1cec3e","word":"رَبْطُ المَقْرُوءِ بالمَسْمُوعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9bbf","lexicalEntryId":"0e32bc31-e047-490c-af4c-dcdcda1cec3e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"رَبْطُ المَقْرُوءِ بالمَسْمُوعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم النفسِ القرائي، استَعمله رونالد كارفر Ronal Carver، في أنموذَجه الحرفيِّ التَّصاعُدي، ضِمنَ نظريَّتِه التي سمّاها نظريةَ فَهمِ المسموعِ والمقروءِ Theory of Reading and Rauding، ويَقصد بذلك أن فَهمَ المسموعِ وفَهمَ المقروءِ عمَليةٌ واحدةٌ مترابِطَةٌ في ذِهن القارئ. اعتَمَد كارفر في تفسيره هذا على أن الكلامَ يُفهَم فَهمًا حَرفيًّا كما يُقدِّمه المتكلِّمُ للسامِعين، بصَرف النَّظَرِ عما إذا كان متَّفِقًا مع قَصد المتكلِّم أو لا، وأن القارئَ يَقرأ النَّصَّ في ذهنه قراءةً شِبهَ مَسموعَة؛ فيَفهَم وفقَ ما يَسمَع من نفسه كما لو كان يَسمَع كلامَ غيرِه، بل يرَى أن النُّطقَ السَّليمَ للكلمات يُساعِد القارِئَ في الفَهم، وقد سمَّى هذه العَمَليةَ بالنُّطق الداخِليِّ internal articulation. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ربط المقروء بالمسموع ","nonDiacriticsLemma":"ربط المقروء بالمسموع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"رَبْطُ المَقْرُوءِ بالمَسْمُوعِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

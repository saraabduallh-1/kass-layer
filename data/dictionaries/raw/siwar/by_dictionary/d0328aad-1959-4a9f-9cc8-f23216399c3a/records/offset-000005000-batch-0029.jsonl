{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/68c9130d-bc17-4a26-bfe6-9785e982797a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"68c9130d-bc17-4a26-bfe6-9785e982797a","word":"مَهَارَاتٌ دِرَاسِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9eed","lexicalEntryId":"68c9130d-bc17-4a26-bfe6-9785e982797a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَهَارَاتٌ دِرَاسِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"القُدراتُ والأنشِطةُ والإجراءاتُ والأساليبُ التي يَستَعملها الطالبُ في الاستِماع والقراءةِ والكتابةِ لأهدافٍ دراسيّةٍ تَعليمِيّة؛ كمهارات الاستِماعِ إلى المحاضَرات الأكاديمية، وتَدوِين الملحوظاتِ في أثناء الدرسِ، والتَّلخِيص، ومهاراتِ القراءةِ السَّريعَة، ومهاراتِ القراءةِ المكثَّفَة، وتَخمين معاني الكلماتِ من السِّياق، واستِعمالِ المعاجِم، وفَهمِ الجَداوِلِ التَّوضِيحِيّة والرُّسومِ البَيانِيَّة، واستِعمالِ تَقنِياتِ التَّعليم، والتّعامُلِ مع الحاسوب، والدُّخولِ على قواعد المعلومات، والاستِفادةِ من المدَوَّنات اللغوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مهارات دراسية ","nonDiacriticsLemma":"مهارات دراسية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَهَارَاتٌ دِرَاسِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

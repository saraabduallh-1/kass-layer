{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4ac690a8-5e8f-42bc-b0ad-8b7b1482e191/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4ac690a8-5e8f-42bc-b0ad-8b7b1482e191","word":"تُعَلُّمٌ مُمَرْكَزٌ حَوْلَ الطَّالِبِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ee2","lexicalEntryId":"4ac690a8-5e8f-42bc-b0ad-8b7b1482e191","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تُعَلُّمٌ مُمَرْكَزٌ حَوْلَ الطَّالِبِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التعلُّم الذي يَتَميَّز بمُشارَكة الطلابِ في تَحديد الأهدافِ التعليمية، ويُركِّز على خِبراتهم، ويَقودُهم نحوَ التفاعُلِ والاستِقلال، على أن تَتَوفر فيه شروطٌ، منها: مُشارَكةُ الطلابِ في وَضع الأهدافِ التعليمية، ومُراعاةُ شُعورِ الطلابِ وقِيَمِهم ورَغَباتِهم واتِّجاهاتِهم ومُيُولِهم، وتَمَيُّز وَظيفةِ المعلِّمِ في الدرس عن الوَظيفة التَّقليديةِ العادِيَّة؛ فيكون مُساعدًا لطلابه، ومُستَشارًا لهم ومُرشِدًا يسهّل عليهم عمَليةَ التعلُّم. طُبِّق هذا المبدأُ في بعض طرائقِ تَدريسِ اللغات؛ كطريقة تعلُّمِ لُغةِ الجَماعَةِ Community Language Learning، والطريقةِ الصَّامِتَةِ Silent Way، اللَّتَيْن منَحَتا الطلابَ مهمّاتٍ رئيسةً وقَلَّلَتا من هَيمَنة المعلِّمِ على أنشِطة الدرس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعلم ممركز حول الطالب ","nonDiacriticsLemma":"تعلم ممركز حول الطالب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تُعَلُّمٌ مُمَرْكَزٌ حَوْلَ الطَّالِبِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cb864811-4e8e-423e-80e8-60524fa609ee/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cb864811-4e8e-423e-80e8-60524fa609ee","word":"لُغَةٌ إسْنَادِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ee3","lexicalEntryId":"cb864811-4e8e-423e-80e8-60524fa609ee","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ إسْنَادِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ للُغةٍ يكون فيها المسنَدُ والمسنَدُ إليه والعَلاقَةُ بينهما أساسَ بناءِ الجُملة، ويَغلب أن تتكَوَّن من مسنَدٍ إليه فمُسنَدٍ أو مبتَدأٍ فخَبَر، ومُعظَمُ لغاتِ العالَمِ من هذا النَّوع، خلافا للُّغات الموضوعية التي يُسيطِر فيها الموضوعُ topic-prominent languages؛ كالصِّينِية واليابانية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة إسنادية ","nonDiacriticsLemma":"لغة إسنادية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ إسْنَادِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a8cd223a-ec24-4319-9b28-13c086c9ee7b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a8cd223a-ec24-4319-9b28-13c086c9ee7b","word":"تَعْلِيمٌ غَمْرِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ee4","lexicalEntryId":"a8cd223a-ec24-4319-9b28-13c086c9ee7b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَعْلِيمٌ غَمْرِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصْفٌ لحالَةٍ تعليميّةٍ يُدمَج فيها طُلابٌ من ضَعيفِي الكِفايَةِ في لُغة التَّدريسِ مع طلابٍ ناطِقين بها في فُصولٍ عادِيَّة، أي يُغمَسون فيها، دونَ أن يُقدَّم لهم برنامجٌ خاصّ بهم. والتعليمُ الغَمْريُّ أحَدُ برامجِ منهَجِ المحتَوَى في تعليم اللغةِ language content-based instruction، الذي نشأ في المدارس الكَنَديةِ لتَدريس الإنجليزيّةِ للكنَديِّين الناطقين بالفَرنسيّة، وتَدريسِ الفَرنسيّةِ للكَنَديِّين الناطقين بالإنجليزيّة، ثم طُبّق على الطلاب الأجانِبِ الناطقين بغير هاتَين اللُّغَتَين، وطُبِّق أيضا على الطلاب الأجانِبِ الناطقين بغير الإنجليزيةِ في بعض المدارسِ الأمريكيةِ والبريطانية. راجع:  @(Content-Based Instruction (CBI)) و  @(Content-Based Instruction (CBI)) و  @(immersion program) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تعليم غمري ","nonDiacriticsLemma":"تعليم غمري","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَعْلِيمٌ غَمْرِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/01f6e6da-c679-4606-adb6-d14533c58bce/get-public-entry"},"browse_index_record":{"lexicalEntryId":"01f6e6da-c679-4606-adb6-d14533c58bce","word":"مُستَوًى لُغَوِيٌّ أَدْنَى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ee5","lexicalEntryId":"01f6e6da-c679-4606-adb6-d14533c58bce","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُستَوًى لُغَوِيٌّ أَدْنَى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لُغويٌّ اجتِماعيٌّ يُطلَق على أيِّ لَهجَةٍ أو مُستَوًى من اللغة المنطوقَةِ أو المكتوبَة يكون أقَلَّ منزِلَةً من المستَوَى المعيارِيِّ للُّغة، ويَحمِل معنًى سَلبِيًّا تجاهَ تلك اللَّهجَة؛ لأنه يَرتَبط بطَبَقَةٍ اجتِماعيّةٍ منْزلتُها أدنَى من منزِلَة الطَّبَقَةِ العُليا أو الوُسطَى. مثال ذلك النَّفيُ المزدَوَجُ في لُغة الأمريكيِّين الأفارِقَةِ، كقولهم: You don't know nothing؛ لمخالَفَته المستَوَى المِعيارِيَّ في الإنجليزية. ويُسمّيه بعضُ اللغويِّين غيرَ المِعيارِيِّ nonstandard ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مستوى لغوي أدنى ","nonDiacriticsLemma":"مستوى لغوي أدنى","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُستَوًى لُغَوِيٌّ أَدْنَى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/11a95ae3-95ed-4e6d-8233-7bca890eace8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"11a95ae3-95ed-4e6d-8233-7bca890eace8","word":"نَظَرِيَّةُ اللُّغَاتِ المَغْلُوبَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ee6","lexicalEntryId":"11a95ae3-95ed-4e6d-8233-7bca890eace8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ اللُّغَاتِ المَغْلُوبَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةٌ لغويّةٌ اجتماعيّةٌ، يرَى أصحابها أنّ سَبَبَ التَّغيُّراتِ الصوتيةِ واللغويةِ هو تَنَحِّي لغةٍ ما أمامَ لغةٍ حلَّت محلَّها، وأنّ للُّغة المغلوبَةِ بعضَ الأَثَرِ في اللغة الغالِبة. فالقَومُ المغلوبون سيَنطِقون اللغةَ الجَديدةَ المفروضَةَ عليهم بلُكنَةٍ متأثِّرةٍ بلُغتهم الأمّ، ويَستَعملون كلماتٍ من لُغتهم الأمّ، أو يَستَعملونها بدَلالات من لُغتهم الأمّ، كما في إنجليزية الهنودِ مثلا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية اللغات المغلوبة ","nonDiacriticsLemma":"نظرية اللغات المغلوبة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ اللُّغَاتِ المَغْلُوبَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e1ebbc4f-c666-4c66-b987-7453405acb1b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e1ebbc4f-c666-4c66-b987-7453405acb1b","word":"وَسْمُ ازدِراءٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ee7","lexicalEntryId":"e1ebbc4f-c666-4c66-b987-7453405acb1b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"وَسْمُ ازدِراءٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتِماعيٌّ، يُشير إلى نظرَة المجتَمَعِ إلى لُكْنةٍ أو نَمَطٍ أو استِعمالٍ لغويٍّ مُعيَّنٍ بأنه معيبٌ أو غَيرُ مُقبولٍ في المجتَمَع؛ لارتِباطه بطَبَقَةٍ اجتِماعيّةٍ معيَّنة، وإن كان مَقبولا في مجتَمَعٍ آخَر. مثالُ ذلك هَمْزُ نَوعٍ من الصوامِت في الإنجليزية بقوَّة، كما في: /bo?l/ في إنجليزية غلاسكو التي تُعَدّ لهجَةً دُنيا، على الرّغم من أن هذا النُّطقَ مَقبولٌ في الإنجليزية عامَّةً. ويُعَدُّ استعمالُ اللغاتِ الهَجينِ pidgin languages واللغاتِ المولَّدَةِ creoles في بيئات تتحدَّث اللغةَ المعيارِيَةَ وَسْمَ ازدِراءٍ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"وسم ازدراء ","nonDiacriticsLemma":"وسم ازدراء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"وَسْمُ ازدِراءٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5f0cfa9c-974f-4871-9910-4703812b8f61/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5f0cfa9c-974f-4871-9910-4703812b8f61","word":"نَظَرِيَّةُ المُثِيرِ والاسْتِجَابَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ee8","lexicalEntryId":"5f0cfa9c-974f-4871-9910-4703812b8f61","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ المُثِيرِ والاسْتِجَابَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نَظَريةٌ نفسيّةٌ تعليميّةٌ، تَبَنّاها عالمُ النفسِ السُّلوكيُّ سكِنَر Skinner، تَصِف التعلُّمَ بأنه ارتِباطٌ بين المثيرِ stimulus والاستِجابَةِ response، ويَثبُت بالتَّعزِيز reinforcement. طُبِّقَت هذه النظريةُ في تعلُّم اللغاتِ الأمِّ والثانيةِ والأجنبيةِ، حين اتَفَقَت آراءُ سكِنِر مع آراء اللغويِّ البِنيَوِيِّ ليونارد بلُومفيلد Leonard Bloomfield في النظرَة إلى طبيعة اللغةِ وأسلوبِ تعلُّمِها وتَعليمِها، حتى أصبَحَت نظريةً لُغويةً نَفسيةً تَعليميةً، يرى أصحابها أن اكتسابَ اللغةِ هو نتيجة عمَلياتٍ آليَّةٍ تَنحَصِر في المثير والاستِجابةِ، ويَثبُت بالتعزيز. ثم انتَقَدها تشومسكي انتقادا عنيفا في أواخر الخمسينياتِ من القرن العشرين، ولم تَعُد لها بعد ذلك تلك الأهميةُ التي كانت لها من قبلُ في تَفسير اكتِسابِ اللغاتِ وتعلُّمِها. راجع:  @(reinforcement) و  @(response) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية المثير والاستجابة ","nonDiacriticsLemma":"نظرية المثير والاستجابة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ المُثِيرِ والاسْتِجَابَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3578eea0-4a8f-41cf-af28-e800cb6f66d6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3578eea0-4a8f-41cf-af28-e800cb6f66d6","word":"قائمَةُ التَّوَقُّفِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ee9","lexicalEntryId":"3578eea0-4a8f-41cf-af28-e800cb6f66d6","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قائمَةُ التَّوَقُّفِ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلحٌ في اللغويات الحاسوبيّةِ، يُشير إلى قائمَةٍ تَحوِي مفرَداتٍ خاصةً أو شاذَّةً أو مَحدودَةَ العَدَد، كحُروف العَطفِ وحُروفِ الجَرِّ وأسماءِ الأعلام، التي قد تُشَابِه كلماتٍ أخرَى في اللغة، وهي كلماتٌ لا حاجَةَ لتَحديد شُيُوعِها؛ لأنها مَعلُومَةُ الشُّيُوعِ سَلَفًا. وحين يُصادِف برنامَجُ الحاسوبِ كلمةً من هذا النَّوعِ يَتَوَقَّف عندها، ولا يدخلها في العمليّات الإحصائية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قائمة التوقف ","nonDiacriticsLemma":"قائمة التوقف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قائمَةُ التَّوَقُّفِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/737d41d4-3613-4b05-b7f4-481858ab4977/get-public-entry"},"browse_index_record":{"lexicalEntryId":"737d41d4-3613-4b05-b7f4-481858ab4977","word":"عَيِّنَةٌ عَشْوائيَّةٌ طَبَقِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9eea","lexicalEntryId":"737d41d4-3613-4b05-b7f4-481858ab4977","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَيِّنَةٌ عَشْوائيَّةٌ طَبَقِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أسلوبٌ في اختِيارِ عيِّنةِ الدراسةِ من مجتَمَع إحصائيٍّ، يعتَمِد على التَّقسيمات الطَّبَقيَّةِ للمجتَمَع الأصليِّ الذي تُختار منه العيِّنةُ، ويُفضَّل استِخدامُه أحيانا للحُصول على عيِّنةٍ أكثَرَ تَمثيلا للمجتَمَع الذي أُخِذت منه. وعند استِخدام هذه الطريقةِ، يُقسَّم المجتَمَعُ الأصليُّ إلى فئاتٍ أو طَبَقاتٍ رئيسَة بناء على خاصِّيَّة معيَّنة، كطريقة تعلُّمِ اللغةِ مثلا أو مكانِها أو خَلفيّاتِ المتعلِّمين اللغويةِ والثقافية، ثم يُختار من هذه الطَّبَقاتِ العَدَدُ المطلوبُ من الأفراد بطريقَةٍ عَشوائيةٍ، بما يتَناسَب مع حَجمها الحقيقيِّ في المجتَمَع الأصليِّ كلِّه. وتؤدِّي تلك الطريقةُ التَناسُبِيةُ إلى زيادة تَمثيلِ العيِّنة، وتُمكِّن الباحِثَ من استخدام عيِّناتٍ أصغَر، مما يُقلِّل من التَّكاليف الخاصَّةِ بالبَحث.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عينة عشوائية طبقية ","nonDiacriticsLemma":"عينة عشوائية طبقية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَيِّنَةٌ عَشْوائيَّةٌ طَبَقِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

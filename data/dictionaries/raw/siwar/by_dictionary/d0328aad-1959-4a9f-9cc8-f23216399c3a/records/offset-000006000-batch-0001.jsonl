{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/198c3b74-dcec-4b8e-82e3-b3d7283e822d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"198c3b74-dcec-4b8e-82e3-b3d7283e822d","word":"أُنْمُوذَجٌ مَرْجِعِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba02c","lexicalEntryId":"198c3b74-dcec-4b8e-82e3-b3d7283e822d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"أُنْمُوذَجٌ مَرْجِعِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ حاسوبيّ، يُقصَد به الأنموذَجُ الأصليُّ الذي يُستَخدم مثالا لقِياس غيرِه عليه، أو لإنشاء أشياء على شاكِلَته. ففي التعرُّف الآلِيِّ على الكلمات، يُقصَد بهذا الأنموذجِ أيُّ نَمَطٍ رياضيٍّ يُنشأ بأخذ عيِّناتٍ من الأصوات المنطوقةِ وتحويلِها إلى أرقامٍ لتَسجيل الخصائصِ السَّمعيةِ لأصوات الكلام. ويُخزَّن أنموذجٌ لكلِّ كلمةٍ في ذاكِرَة الحاسوبِ مُسبقا، وحين تدخُل إلى الجهاز كلمةٌ جديدةٌ يُنشِئ الجهازُ لها أنموذَجا ليُضاهِيَه بأنموذَج الكلمةِ المخزونَة فيه إن وُجِد، فيتَعرَّف عليها الجهازُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"أنموذج مرجعي ","nonDiacriticsLemma":"أنموذج مرجعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"أُنْمُوذَجٌ مَرْجِعِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

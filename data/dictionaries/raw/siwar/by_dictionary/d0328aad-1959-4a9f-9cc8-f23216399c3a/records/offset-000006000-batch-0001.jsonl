{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/720f273b-aec7-4ab8-baeb-d6c3a3dbebf7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"720f273b-aec7-4ab8-baeb-d6c3a3dbebf7","word":"عِلْمُ صِنَاعَةِ المُصْطَلَحِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba016","lexicalEntryId":"720f273b-aec7-4ab8-baeb-d6c3a3dbebf7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ صِنَاعَةِ المُصْطَلَحِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرعٌ من فروع صناعَةِ المعجَمِ lexicography، يُعنى بصناعَة المصطلَحاتِ العِلميةِ التِّقنِيَّةِ terminology في علمٍ أو مجموعَةٍ من العُلوم، ويَنهَض به مُعجَميون ومتخصِّصون في هذه العلوم. استُحدِث هذا المصطلَحُ في السبعينيات من القرن العشرين ليَحلَّ محلَّ مصطلَحِ Terminological lexicography؛ وهذا لتأكيدِ الفُروقِ بين صناعَةِ المعجَمِ lexicography وهو العلمُ الذي يُعنى بالمفردات اللغويةِ العامَّة، وصناعَةِ المصطلَحِ الذي يُعنى بصناعَة المصطلَحاتِ الخاصَّةِ بعلمٍ من العُلوم. ولأنَّ لكلٍّ منهما مناهجَ وإجراءاتٍ ومصادِرَ وأهدافا خاصةً به؛ يرى بعضُ الباحثين ضَرورَةَ الفَصلِ بينهما، وأن أحدَهما ليس فَرعا من الآخَر. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم صناعة المصطلح ","nonDiacriticsLemma":"علم صناعة المصطلح","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ صِنَاعَةِ المُصْطَلَحِ"}],"lemmaLanguage":{"
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7673e3f4-da32-4560-b722-48db73395fee/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7673e3f4-da32-4560-b722-48db73395fee","word":"لِسَانٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba028","lexicalEntryId":"7673e3f4-da32-4560-b722-48db73395fee","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لِسَانٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"عضوُ النُّطقِ المتحرِّك، الذي هو أكثَرُ أعضاءِ النُّطقِ مشارَكةً في إحداث الأصواتِ الكلامية؛ إذ يُشارك في إحداث جميعِ الصوائتِ ومُعظمِ الصوامت؛ فيُسهِم في إيقاف تَيَّارِ النَّفَس، أو إعاقتِه، أو تَشكيلِ التَّجويفِ الفَمِيّ. يُقسَّم اللِّسانُ إلى أجزاء، هي: طَرَفُ اللِّسان، ومُقدَّمُ اللِّسان، ووَسَطُ اللِّسان، ومُؤخَّرُ اللِّسان، وجِذْرُ اللِّسانِ أو أصلُ اللِّسان.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"اسم يُطلَق على اللغة، التي تَعني اللِّسانَ في الاستعمال العربيِّ القديم، لا اللغة بمعنى اللَّهْجَةِ الشائعِ في الاستعمال الحديث، وغالبا ما يُطلَق المصطلحُ على اللغة الأم؛ فيُقال mother tongue، في مُقابِل كلٍّ من اللغةِ الثانيةِ second language، واللغةِ الأجنبيةِ foreign language. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"لسان ","nonDiacriticsLemma":"لسان","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e80e1b69-773a-4b85-a263-6d60e4664a26/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e80e1b69-773a-4b85-a263-6d60e4664a26","word":"قَوَائِمُ ثُورْنْدَايْك","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba025","lexicalEntryId":"e80e1b69-773a-4b85-a263-6d60e4664a26","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"قَوَائِمُ ثُورْنْدَايْك","lemmaType":"wasf","pattern":" ","senses":[{"definition":"قوائمُ للمُفرَدات الشّائعةِ في اللغة الإنجليزية، تَوَصَّل إليها الأمريكيُّ أدوارد لي ثورندايك Edward Lee Thorndike، وهي ثلاثُ قوائم: الأولى لأَشيَع عشرَة آلافِ كلمة، والثانيةُ لأَشيَع عشرين ألف كلمة، والثالثةُ لأشيَع ثلاثين ألف كلمة. وقوائمُ الشُّيُوعِ مهمَّةٌ في إعداد الموادِّ التعليميةِ لمتعلِّمي اللغاتِ الأجنبيةِ خاصة؛ حيث يُبدأ بالأكثَر شُيوعا، فالشّائع، فالأَقَلّ شيوعا. غيرَ أن ثمةَ شُيوعًا خاصًّا بكل حَقلٍ من حُقول العلمِ والمعرِفةِ يجب أن يُعتَمَد عليه في إعداد الموادِّ التعليميةِ لأغراضٍ خاصَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"قوائم ثورندايك ","nonDiacriticsLemma":"قوائم ثورندايك","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"قَوَائِمُ ثُورْنْدَايْك"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0d33be07-4cb2-46c4-8a92-9aaea65c3e5f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0d33be07-4cb2-46c4-8a92-9aaea65c3e5f","word":"خَطٌّ زَمَنِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49ba026","lexicalEntryId":"0d33be07-4cb2-46c4-8a92-9aaea65c3e5f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"خَطٌّ زَمَنِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في لغة الإشارَةِ عند الصُّمِّ، يُشير إلى خَطٍّ وَهمِيٍّ أُفُقِيٍّ مُنحَنٍ طَرَفاه إلى الأَعلَى قليلا. يُصوِّر حَرَكةَ يَدِ المؤشِّرِ (المتَكَلِّمِ) بلُغة الإشارَة؛ يمتَدُّ من أمام الفَمِ إلى ما وراء الرأسِ مُرورًا بالذِّقن والخَدِّ والأُذُن، ويُعَبَّر به عن الزَّمَن أو العلاقاتِ الزَّمَنِيَّة، وكلُّ منطقةٍ فيه تُشِير إلى زَمَن. فالمنطقةُ البَعيدةُ عن الفَم تُشِير إلى المستَقبَل، والقَرِيبَةُ منه تُشِير إلى المستَقبَل القَريب، والتي على الذّقن تُشِير إلى الحاضِر، والتي على الأُذُن تُشِير إلى الماضي القَريب، والتي بعدَ الأُذُنِ إلى الخَلْف تُشِير إلى الماضي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"خط زمني ","nonDiacriticsLemma":"خط زمني","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"خَطٌّ زَمَنِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

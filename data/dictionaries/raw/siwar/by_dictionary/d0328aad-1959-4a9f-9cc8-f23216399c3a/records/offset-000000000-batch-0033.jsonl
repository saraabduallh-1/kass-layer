{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a5861363-af35-40e5-ad48-d1b4cffd635e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a5861363-af35-40e5-ad48-d1b4cffd635e","word":"الإِطَارُ الأُورُوبِّيُّ المَرْجِعِيُّ لِلُّغَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b81","lexicalEntryId":"a5861363-af35-40e5-ad48-d1b4cffd635e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الإِطَارُ الأُورُوبِّيُّ المَرْجِعِيُّ لِلُّغَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مِعْيارٌ لغويٌّ تَعليميٌّ وَضَعه المجلسُ الأورُوبيُّ The Council of Europe بين عامَيْ 1989م-1996م، ضِمنَ مَشروعِ (تعَلُّم اللغاتِ من أَجْل المواطَنَةِ الأوروبية)، هدَفُه توفيرُ وَسيلةٍ للتعلُّم والتَّدريسِ والتَّقْيِيمِ تَنطَبِق على جميع اللغاتِ في أوروبا، وقياسُ كِفاياتِ مُتَعلِّمي اللغاتِ الأجنَبيةِ فيها. يتَضمَّن هذا الإطارُ ثلاثةَ مستويات لغوية رئيسة، مبتدئ ومتوسط ومتقدم، وكل مستوى رئيس مقسم إلى مستويين فرعيين. أصبحت هذه المستَويات مَقبولَةً ومُعتَمَدَةً لتَصنيف كِفايَةِ متعلِّمي اللغاتِ الأجنَبية، لا في اللغات الأوروبِّيَّةِ داخِلَ أوروبا وحَسب، وإنما في لغاتٍ أخرى داخِلَ أوروبا وخارِجَها، بما في ذلك اللغةُ العربيةُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الإطار الأوروبي المرجعي للغات ","nonDiacriticsLemma":"الإطار الأوروبي المرجعي للغات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الإِطَارُ الأُورُوبِّيُّ المَرْجِعِيُّ لِلُّغَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1b204b08-38f5-40e8-b252-8ef0332852c9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1b204b08-38f5-40e8-b252-8ef0332852c9","word":"تَغَيُّرٌ جَارٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b82","lexicalEntryId":"1b204b08-38f5-40e8-b252-8ef0332852c9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَغَيُّرٌ جَارٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُشير إلى التغيُّر اللغويِّ في مجتمَعٍ ما، أو حَقلٍ عِلمِيِّ أو مَعرِفيٍّ، لكنه ما يزال في مراحِل نموِّه التي لم تكتَمِل. يرى وليام لابوف أن هذا التغيُّرَ الجارِي يتِمّ بالتدريج؛ فقد يَبدأ في طبَقةٍ اجتماعيةٍ معيَّنة، أو في مستوَى من الاستعمال دونَ غيرِه من المستويات الأخرى، أو في حَقل عِلمِيٍّ دونَ غيره.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تغير جار ","nonDiacriticsLemma":"تغير جار","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَغَيُّرٌ جَارٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

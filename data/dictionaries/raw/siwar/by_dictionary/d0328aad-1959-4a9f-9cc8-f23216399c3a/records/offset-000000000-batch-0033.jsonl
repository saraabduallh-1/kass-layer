{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ee9011b3-6599-4f68-ac28-2d1fdfe5931d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ee9011b3-6599-4f68-ac28-2d1fdfe5931d","word":"إِدارَةُ الصَّفِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8b88","lexicalEntryId":"ee9011b3-6599-4f68-ac28-2d1fdfe5931d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إِدارَةُ الصَّفِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إدارةُ المعلِّمِ للطلاب وتَوجِيهُه الأنشِطَةَ التي يُمارِسونها في قاعَة الدَّرس. وفي فُصول تعليمِ اللغة، تَعني إدارَةُ الصَّفِّ: الأساليبَ التي يُنَظِّم بها المعلِّمُ طُلابَه أو يَرغَبون هم في تَنظِيمها داخِلَ قاعَةِ الدَّرس، والأنشِطَةَ التي يمارِسونها؛ كالتحرُّك داخِلَ القاعَة، وتَنوِيعِ الأنشِطَة، وتَقسِيمِ الطلابِ إلى مجموعات، وتَوزيعِ الأدوارِ والمهمّاتِ بينَهم، والتَّفاعُلِ معَهم، وتَنويعِ أساليبِ التعلُّم، واستِعمالِ وَسائلِ الإيضاحِ وتَقنياتِ التعليم، وتأكيدِ العلاقاتِ بين المعلِّمِ وطلابِه وبين الطلابِ أنفسِهم، وغيرِ ذلك من الأنشِطَة التي تُشَجِّع الطلابَ على فَهم اللغةِ الهَدَفِ واستِعمالِها بشَكل وَظِيفِيٍّ شَبِيهٍ بالجَوِّ الطبيعيِّ في الحياة العامَّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إدارة الصف ","nonDiacriticsLemma":"إدارة الصف","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إِدارَةُ الصَّفِّ"}],"lemmaLang
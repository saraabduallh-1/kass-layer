{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2db075ed-9fe6-4aa5-91cd-b0643830751e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2db075ed-9fe6-4aa5-91cd-b0643830751e","word":"جُمْلَةٌ إخْبَارِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9ab3","lexicalEntryId":"2db075ed-9fe6-4aa5-91cd-b0643830751e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"جُمْلَةٌ إخْبَارِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ فَلسَفيٌّ لغويٌّ دلاليٌّ، يُطلق على المعنى الأساسِ الذي تُعبِّر عنه الجُملةُ، ويمثِّل أحَدَ القسمَيْن الرئيسَيْن للجُملة في تركيبها العَميقِ بحسَب نحوِ الحالات، يؤدِّي فيه الفعلُ الوَظيفةَ الأساسَ بحيث تَرتَبِط به سائرُ المكوِّناتِ في اكتِساب دلالتِها. والقَضيةُ أو الجُملةُ الإخباريةُ مكوَّنة من: الحُجَّة argument، والخَبَرِprediction ، وقد تتألَّف الجُملةُ من أكثَر من قَضِيَّة. وفي نظرية الحَدَثِ الكَلاميِّ، يُمَيَّز بين معنى الجُملةِ الإخبارِيِّ propositional meaning وقُوَّتِه الحقيقيةِ في الاستِعمال. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"جملة إخبارية ","nonDiacriticsLemma":"جملة إخبارية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"جُمْلَةٌ إخْبَارِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

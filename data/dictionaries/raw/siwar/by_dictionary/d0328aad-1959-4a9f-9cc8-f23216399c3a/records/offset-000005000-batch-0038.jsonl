{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/096b75ec-9641-416e-8ea6-6446efbbbaab/get-public-entry"},"browse_index_record":{"lexicalEntryId":"096b75ec-9641-416e-8ea6-6446efbbbaab","word":"مَرْحَلَةُ الثَّلاثِ كَلِمَاتٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fdf","lexicalEntryId":"096b75ec-9641-416e-8ea6-6446efbbbaab","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَرْحَلَةُ الثَّلاثِ كَلِمَاتٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مرحلةٌ من مراحِل اكتسابِ التراكيبِ في لغة الطفلِ تَقتَرِب من مرحلة الكَمال؛ تَبدأ في منتَصَف السنةِ الثالثةِ حين تَنتَهي مرحَلةُ الكَلِمتَين، وتَستَمرُّ حتى السنةِ الرابعةِ حين يتَمكَّن الطفلُ من نُطق الجُملةِ الكامِلَة. يَستَعمِل الطفلُ في هذه المرحَلةِ ثلاثَ كلماتٍ تُعَبِّر عن معنى جُملة، ويَستَعمِل فيها كلماتٍ وأدَواتٍ وَظيفِيَّةً إلى جانب كلماتِ المحتَوَى، لكنه يُواجِه صُعوباتٍ في تَصريف الأفعال، واستِعمالِ علاماتِ الجَمعِ والتذكيرِ والتأنيثِ وأدَواتِ التَّعريفِ والتَّنكِير، ولا يَستَعمِل الأسماءَ الموصولَةَ والضمائرَ المتَّصِلةَ إلا نادِرًا. تتميَّز هذه المرحَلةُ بنُمُوِّ الوَظائفِ الأساسيةِ للجُملة بطريقَةٍ متدَرِّجَة، ولاسيَّما الاستفهامُ والنَّفيُ والرَّفضُ والتَّعجُّبُ والإنكار. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مرحلة الثلاث كلمات ","nonDiacriticsLemma":"مرحلة الثلاث كلمات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَرْحَلَةُ الثَّلاثِ كَلِمَاتٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f549d59a-882c-4693-9ee5-0bce98b6647c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f549d59a-882c-4693-9ee5-0bce98b6647c","word":"عَتَبَةُ السَّمْعِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fe0","lexicalEntryId":"f549d59a-882c-4693-9ee5-0bce98b6647c","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عَتَبَةُ السَّمْعِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُقصَد به القَدْرُ من تَرَدُّد الصوتِ الذي يُمكن أن تتحمَّله الأذنُ البَشَرية، وهو قَدْرٌ يَقَع بين الحَدِّ الأدنَى والحَدِّ الأقصَى من الشِّدَّة التي تُقاس بالدِّيسِيبِل. فإذا قَلَّ عن الحَدِّ الأدنَى، فإن الأذنَ لن تَسمَعه، وإذا تجاوَز الحَدَّ الأعلَى أصبَح مُؤذِيًا لا تتحمَّله الأذُن. قد تختَلِف هذه الحُدودُ من شَخصٍ لآخَر؛ فالشخصُ الذي اعتاد سَماعَ الأصواتِ الشَّديدة، كمن يَعمَل في المصانِع التي يَكثُر فيها الضَّجيجُ مثلا، يَزداد عنده المدى بين الحَدَّين الأدنَى والأعلَى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"عتبة السمع ","nonDiacriticsLemma":"عتبة السمع","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عَتَبَةُ السَّمْعِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

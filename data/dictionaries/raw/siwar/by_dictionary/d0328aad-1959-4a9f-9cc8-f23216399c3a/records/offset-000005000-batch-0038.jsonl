{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bff45d87-5998-425c-9c83-65e858f16c83/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bff45d87-5998-425c-9c83-65e858f16c83","word":"نَصٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fce","lexicalEntryId":"bff45d87-5998-425c-9c83-65e858f16c83","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَصٌّ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"عيِّنَةٌ من اللغة المنطوقةِ أو المكتوبة، تُكوِّن وَحدَةً مترابِطةً ذاتَ معنى أو وَظيفة؛ كالنَّثر بأنواعه، والحِوار، والشِّعر، والقِصَّة، والرِّواية، والخُطبَة، والموعِظة. والنَّصُّ وَحدَةٌ دَلاليةٌ وليس وَحدَةً نحويةً كالجُملة، لكنه يَنطبِق على الكلمة الواحدة، والجُملة، والفقرَة، والفَصلِ من الكتاب، والكتابِ بأكمله. تَحليلُ النَّصِّ يمكن أن يَنطَلِق من البِنيَة أو من الوَظيفة، لكن يَصعُب فَهمُ النَّصِّ وتَحليلُه دونَ عَودَةٍ إلى السِّياق الذي وَرَد فيه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ حاسوبيٌّ، يُشير إلى كلمةٍ أو أكثَرَ باللغة الطبيعية، تُختَزَن وتُعالَج أو تُطبَع على شاشَة العَرضِ أو على الوَرَق، في مقابِل تعليماتِ الحاسوبِ أو الصُّوَرِ graphs.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ في الترجَمة الوَظيفية، يُطلَق على المعلومات المقدَّمَةِ إلى المتلَقِّي مُترجَمةً من مصدَرٍ أصليٍّ بلُغَةٍ أخرى؛ ليَختار من هذه المعلوماتِ ما يجده مُهمًّا أو مُفيدًا في مجاله.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"نص ","nonDiacriticsLemma":"نص","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَصٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

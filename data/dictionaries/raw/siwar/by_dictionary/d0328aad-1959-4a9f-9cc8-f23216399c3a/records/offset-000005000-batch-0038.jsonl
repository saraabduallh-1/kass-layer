{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/890a28e0-6b92-4440-9229-93a70e296116/get-public-entry"},"browse_index_record":{"lexicalEntryId":"890a28e0-6b92-4440-9229-93a70e296116","word":"اللُّغَويَّاتُ النَّصِّيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9fd1","lexicalEntryId":"890a28e0-6b92-4440-9229-93a70e296116","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَويَّاتُ النَّصِّيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علمُ اللغةِ النَّصِّيِّ أو اللسانياتُ النصية، وهو فَرعٌ من فروع علمِ اللغة، شاعَ استِعمالُه في أوروبا وفي ألمانيا خاصَّةً، يُعنَى بدراسة العَلاقةِ بين جوانبِ اللغةِ المختَلِفةِ واستِعمالاتِها في النُّصوص المنطوقةِ والمكتوبَة، ويهتَم بدراسة بناءِ النَّصِّ وتماسُكِه ومُحتَواه التواصُليّ، ولاسيَّما كَيفيةُ دُخولِ الجانبَين النحويِّ والمعجَميِّ في بِنيَة النَّص. يُسمى أيضا علمَ اللغةِ النَّصِّيَّ أو لغوياتِ النَّصِّ أو لِسانياتِ النَّصِّ، وُيفضِّل بعضُ اللغويين استعمالَ تَحليلِ الخِطابِ discourse analysis، بدَلًا من اللغويات النَّصِّيَّةِ أو علمِ اللغةِ النَّصِّيِّ، باعتباره أصلَ هذا الفَرع، خاصَّةً إذا كان الخطابُ مَنطوقا وتَعدَّى التحليلُ نطاقَ الجُملة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغويات النصية ","nonDiacriticsLemma":"اللغويات النصية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَويَّا
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/452c8829-b241-4799-b945-70b834e86202/get-public-entry"},"browse_index_record":{"lexicalEntryId":"452c8829-b241-4799-b945-70b834e86202","word":"النَّصُّ المصْدَرُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dfb","lexicalEntryId":"452c8829-b241-4799-b945-70b834e86202","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّصُّ المصْدَرُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم الترجَمة، يُطلَق على النَّصِّ الأصليِّ المترجَمِ أو المرادِ ترجَمَتُه من اللغة المصدَر. وفي الترجَمة الوَظيفيّةِ يختَلِف الالتزامُ بالنَّصِّ المصدَرِ بحسب الهدَفِ من الترجَمة، وقد يتطلَّب الأمرُ الرجوعَ إلى مصادِرَ مختَلِفةٍ لاستِقاء المعلوماتِ المطلوبة؛ فيكون النَّصُّ الأصليُّ حينئذٍ واحدًا منها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النص المصدر ","nonDiacriticsLemma":"النص المصدر","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّصُّ المصْدَرُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e0feab87-3c62-42ff-a31e-04533092a9b0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e0feab87-3c62-42ff-a31e-04533092a9b0","word":"ذَخِيرَةُ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dfc","lexicalEntryId":"e0feab87-3c62-42ff-a31e-04533092a9b0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ذَخِيرَةُ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللغاتُ أو التَّنَوُّعاتُ اللَّهَجيّةُ التي يَعرِفها الفَردُ أو يَستَعمِلها في الحديث ضِمنَ بيئتِه الاجتِماعيّةِ في التواصُل اليَومي. فالناطقون بلُغةٍ ما لا يتكلَّمون بمستَوًى لغويٍّ واحدٍ في جميع الأحوال، وإنما يتكلَّمون مستَوَياتٍ مختَلِفةً من اللغة بحسَب مناطِقِهم الجغرافية، وطبَقاتِهم الاجتِماعية، ونَوعِ الأنشِطة، وطَبيعةِ الموضوعِ الذي يتحدَّثون فيه. فالناطقون بالعربية في أيِّ إقليمٍ عربيٍّ لا يتكلَّمون بلَهجَتهم المحلِّيَّةِ ولا بالعربية الفُصحَى في جميع الأحوال، وإنما يُنَوِّعون كلامَهم بين الفُصحَى والفُصحَى المعاصِرَةِ واللَّهجَةِ المحلِّيَّةِ واللَّهجَةِ الاجتِماعيةِ الطَّبَقِيَّة؛ بحسَب المقامِ، وطَبيعَةِ الموضوعِ، ونَوعِ المخاطَبين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"ذخيرة الكلام ","nonDiacriticsLemma":"ذخيرة الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ذَخِيرَةُ الكَلامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e44cc5b1-e3ea-4e45-b821-8cacc67bef01/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e44cc5b1-e3ea-4e45-b821-8cacc67bef01","word":"تَحْوِيلُ المَنْطُوقِ إلى مَكْتُوبٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dfd","lexicalEntryId":"e44cc5b1-e3ea-4e45-b821-8cacc67bef01","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْوِيلُ المَنْطُوقِ إلى مَكْتُوبٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ تَطبيقِيٌّ في تحليل الأخطاء، يُقصَد به ترجَمةُ الكلامِ المنطوقِ لمتعَلِّمي اللغةِ إلى نَصٍّ مَكتوبٍ لأغراض التَّحليلِ والتَّفسير، والاستفادَة من ذلك في إعداد الموادِّ التعليميّة. شاع استِعمالُه بالمعنى نفسِه في السنوات الأخيرَةِ في لسانيّات المدوّناتِ اللغوية، سواء كان التحويلُ بالطريقَة الكتابيّةِ اليدَويّةِ عبْرَ لوحَةِ المفاتيح أو بمساعدَة تَطبيقاتٍ صَوتِيّةٍ آلِيَّة، أو بتَطبيقاتٍ تحوِّل النَّصَّ اليَدَوِيَّ إلى مادَّةٍ رَقمِيَّةٍ مَطبوعَة. ويشير  المصطلح كذلك إلى الإملاء الآليّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحويل المنطوق إلى مكتوب ","nonDiacriticsLemma":"تحويل المنطوق إلى مكتوب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْوِيلُ المَنْطُوقِ إلى مَكْتُوبٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8d0c4e31-1602-4616-8d5e-70c6326b95c2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8d0c4e31-1602-4616-8d5e-70c6326b95c2","word":"إنْتَاجُ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e0c","lexicalEntryId":"8d0c4e31-1602-4616-8d5e-70c6326b95c2","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إنْتَاجُ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يُطلَق على مجموع العَمَلياتِ النَّفسيةِ والعُضوِيةِ التي تنتَهي بإحداث الصوتِ الكلاميِّ، في مُقابِل استِقبالِ الكلامِ speech reception وفَهمِ الكلامِ أو إدراكِه speech perception. وثَمةَ جدَلٌ حولَ العلاقَةِ بين إنتاجِ الكلامِ وفَهمِه من حيث تساوي الجهدِ الذي يَبذُله المتكلِّمُ مع الجهد الذي يتَطلَّبه فَهمُ المخاطَبِ لهذا الكلام تركيبًا ودلالةً، ولاسيَّما حين يحاول المتكلِّمُ إنتاجَ كلامٍ يُناسِب المخاطَبَ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إنتاج الكلام ","nonDiacriticsLemma":"إنتاج الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إنْتَاجُ الكَلامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

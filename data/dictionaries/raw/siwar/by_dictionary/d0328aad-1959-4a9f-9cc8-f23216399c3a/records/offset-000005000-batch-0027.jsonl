{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7be63a8d-08a0-4dd8-8846-252754086a57/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7be63a8d-08a0-4dd8-8846-252754086a57","word":"حَالَةُ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ec3","lexicalEntryId":"7be63a8d-08a0-4dd8-8846-252754086a57","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَالَةُ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ لغويٌّ شامِلٌ للجوانب النظريةِ والتطبيقيةِ لحالَة اللغةِ في بلدٍ ما في مرحلةٍ زمنيةٍ محدَّدة، من حيث كَونُها لغةً أمًّا أو لغةً أولى أو رسميةً، أو لغةً ثانيةً أو أجنبية، وكذلك حالُ تَعلُّمِها وتَعليمِها من حيث المذاهبُ والمناهجُ والأساليبُ، وما إذا كانت لغةً علميةً فقط أو تواصُليةً فقط، ونحو ذلك. حالَةُ اللغةِ في بلَدٍ غالبا ما تكون مجالا للبحث اللغويِّ العامِّ أو المقارَنِ، والبحثِ اللغويِّ الاجتماعيِّ، والبحثِ اللغويِّ التطبيقيِّ التعليميِّ، والبحث في علمِ اللغةِ السياسيِّ والتخطيطِ اللغويِّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حالة اللغة ","nonDiacriticsLemma":"حالة اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حَالَةُ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/00bd2cfd-6d2c-46c4-969c-7d23888b05d0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"00bd2cfd-6d2c-46c4-969c-7d23888b05d0","word":"ازْدِرَاءٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9ec4","lexicalEntryId":"00bd2cfd-6d2c-46c4-969c-7d23888b05d0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"ازْدِرَاءٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتِماعيٌّ، يُشير إلى نظرَة المجتَمَعِ إلى لُكْنةٍ أو نَمَطٍ أو استِعمالٍ لغويٍّ مُعيَّنٍ بأنه معيبٌ أو غَيرُ مُقبولٍ في المجتَمَع؛ لارتِباطه بطَبَقَةٍ اجتِماعيّةٍ معيَّنة، وإن كان مَقبولا في مجتَمَعٍ آخَر. مثالُ ذلك هَمْزُ نَوعٍ من الصوامِت في الإنجليزية بقوَّة، كما في: /bo?l/ في إنجليزية غلاسكو التي تُعَدّ لهجَةً دُنيا، على الرّغم من أن هذا النُّطقَ مَقبولٌ في الإنجليزية عامَّةً. ويُعَدُّ استعمالُ اللغاتِ الهَجينِ pidgin languages واللغاتِ المولَّدَةِ creoles في بيئات تتحدَّث اللغةَ المعيارِيَةَ وَسْمَ ازدِراءٍ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"N","root":null,"wordForms":[],"relatedSenses":[],"search":"ازدراء ","nonDiacriticsLemma":"ازدراء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"ازْدِرَاءٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

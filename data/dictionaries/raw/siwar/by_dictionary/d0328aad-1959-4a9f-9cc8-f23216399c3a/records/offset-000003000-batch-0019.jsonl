{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/242ef170-b9d2-4a4f-b916-cf13573fe0e7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"242ef170-b9d2-4a4f-b916-cf13573fe0e7","word":"اسْتَثَارَةٌ مُعْجَمِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b95ea","lexicalEntryId":"242ef170-b9d2-4a4f-b916-cf13573fe0e7","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْتَثَارَةٌ مُعْجَمِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُشير إلى أنموذَجٍ من نماذِج المعالَجةِ الموزَّعَةِ المتوَازِنةِ Parallel Distribution Processing (PDP)، وتطبيقِها في معالَجَة المفرَداتِ المعجَميةِ وحِفظِها في الذّاكرة. يتلَخَّص الأنموذَجُ في أن المرءَ حين يَسمَع كلمةً مألوفةً لدَيه أو يقرؤها في نَصٍّ ما فإنه يُثير أجهِزَةَ الاستِشعارِ المعجَميِّ لهذه الكلمةِ من عدَّة زوايا عَصَبيَّةٍ؛ فيتَذَكَّرها بسُرعة، خلافا للكلمة غيرِ المألوفةِ التي لا تتحَرَّك مُثيراتُها إلّا ببُطءٍ شديد. راجع:  @(Parallel Distributed Processing (PDP)) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"استثارة معجمية ","nonDiacriticsLemma":"استثارة معجمية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْتَثَارَةٌ مُعْجَمِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

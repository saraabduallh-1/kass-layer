{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7be92450-4cb2-4f27-aed9-2dffe1938395/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7be92450-4cb2-4f27-aed9-2dffe1938395","word":"حَاسُوبٌ مَرْكَزيٌّ رَئيسٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9600","lexicalEntryId":"7be92450-4cb2-4f27-aed9-2dffe1938395","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"حَاسُوبٌ مَرْكَزيٌّ رَئيسٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جهازٌ حاسوبيٌّ مركَزيٌّ من أكبَر أنواعِ الحاسباتِ الآليَّةِ من حيث السُّرعةُ، وسَعَةُ التَّخزينِ، وعَدَدُ المستَخدِمين له في آنٍ واحد. يرتَبِط بهذا الجهازِ مجموعةٌ من الطَّرَفِيَّات الحاسوبيةِ بخطوط هاتفيةٍ أو شَبَكةٍ داخِلية، يَستَطيع مستَعمِلوها الدُّخولَ على البرامِج والمعلوماتِ الموجودةِ في الحاسوب المركَزِيّ، وتَبادُلَها بين الشَّبَكةِ المركَزيةِ والمستَخدِم. يَشيع استعمالُ هذا النوعِ في الجامعات، ومراكزِ البحوث، ومراكزِ المعلومات، والمكتَباتِ المركَزية. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"حاسوب مركزي رئيس ","nonDiacriticsLemma":"حاسوب مركزي رئيس","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"حَاسُوبٌ مَرْكَزيٌّ رَئيسٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0b519a1a-3555-486c-8643-0e279e28127b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0b519a1a-3555-486c-8643-0e279e28127b","word":"تَدْرِيسٌ فَعَّالٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8ef1","lexicalEntryId":"0b519a1a-3555-486c-8643-0e279e28127b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَدْرِيسٌ فَعَّالٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تدريسٌ يؤدِّي إلى التعلُّم المنشُود، ويُحدِثُ أثَرًا إيجابيًّا مَلحوظًا في سُلوك الطالبِ وطَريقَتِه في التفكير، ويكون قابِلا للقِياس، مع اقتصادٍ في الوَقت والجهدِ والتكلُفَة. يَتمَثَّل هذا التدريسُ في مجموعةٍ من الأساليب التي تؤدِّي إلى تحَقُّق أهدافِ الدرسِ وفقَ أفضَلِ المعايِيرِ المستَنبَطَةِ من نتائج الدراساتِ العلمية. والتدريسُ الفعَّالُ في تعليم اللغاتِ هو ما يَقود إلى الكِفايَة اللغويةِ المنشودَةِ language proficiency التي تَقيسُها اختباراتُ الكِفايةِ اللغويةِ proficiency tests. راجع:  @(effective schooling) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تدريس فعال ","nonDiacriticsLemma":"تدريس فعال","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَدْرِيسٌ فَعَّالٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

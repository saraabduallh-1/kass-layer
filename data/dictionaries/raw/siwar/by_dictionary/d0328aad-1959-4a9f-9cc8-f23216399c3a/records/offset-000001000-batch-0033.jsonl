{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eb4ce2d2-97ac-4b0d-a1c0-ff0c163d0a1a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eb4ce2d2-97ac-4b0d-a1c0-ff0c163d0a1a","word":"مَذْهَبٌ تَجْرِيبِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f7a","lexicalEntryId":"eb4ce2d2-97ac-4b0d-a1c0-ff0c163d0a1a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَذْهَبٌ تَجْرِيبِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَذهبٌ أو مَدخَلٌ لدراسة الكلام، استَعمَله اللغويُّ الاجتماعيُّ الأمريكيُّ وليام لابوف William Labov، حيث يتحَكَّم الباحثُ اللغويُّ عَمدا في كلام المتكلِّمِ الذي يُجرِى عليه الدراسةَ. ويَتِم ذلك بإعداد خطَّةٍ دقيقَةٍ مُحكَمَة ومُعقَّدَة، تَقود المتكلِّمَ إلى أن يتكَلَّمَ بكلامٍ مُوَجَّهٍ، ويُقدِّم فيه معلوماتٍ لغويةً يتطلَّبها البَحثُ، دونَ أن يَشعُر بذلك. ويرى أصحابُ هذا المذهبِ أن الفائدَةَ المرجوَّةَ من هذا الكلامِ الموَجَّهِ أفضَلُ من الكلام الذي يُسَجِّله الباحثُ من كلامٍ طبيعيٍّ في مَوقِفٍ عَفوِيٍّ ثم يُحَلِّلُه، في حين يرى آخَرون خِلافَ ذلك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مذهب تجريبي ","nonDiacriticsLemma":"مذهب تجريبي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَذْهَبٌ تَجْرِيبِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ac39082a-6c91-48a2-a9c4-dd8bb8840e8b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ac39082a-6c91-48a2-a9c4-dd8bb8840e8b","word":"مُمَثِّلٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f7b","lexicalEntryId":"ac39082a-6c91-48a2-a9c4-dd8bb8840e8b","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُمَثِّلٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"صِيغَةٌ تُعبِّر حِسِّيًّا عن وَحدة لغويةٍ مجرَّدَة، أي تمثِّل العلاقةَ بين الوحدةِ اللغويةِ وإدراكِها في الكلام. فيُقال مثلا: إنَّ (يَكتُبُ) مُحَقِّقٌ للفعل أو مُمَثِّل له، وإنَّ (هو) مُحَقِّقٌ للضمير أو مُمَثِّلٌ له، وإنَّ (هذا) مُحَقِّقٌ للإشارَة أو مُمَثِّل لها، وهكذا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"العُنصُرُ أو مجموعةُ العناصِرِ اللغويةِ الممَثِّلةِ لوَظيفةٍ أو مجموعةٍ من الوَظائف في المنهَج الوَظيفِيِّ function syllabus في حَقل تعليمِ اللغاتِ الأجنَبية. فكلمةُ (مُتحَف)، وجُملةُ (أين المتحَف؟) عُنصران مُحَقِّقان لوَظيفةٍ واحدةٍ هي السؤالُ عن المكان، أي مُمثِّلان لها. ويُستَعمَل هذا المصطلَحُ أيضا في مقرَّر الفِكرَةِ notional syllabus، وهو أسلوبٌ أو منهَجٌ لبِناءِ مُقرَّراتِ تعليمِ اللغاتِ الأجنَبِية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"AS","root":null,"wordForms":[],"relatedSenses":[],"search":"ممثل ","nonDiacriticsLemma":"ممثل","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T0
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f5bd6968-c376-4c88-8312-6c120b5ee838/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f5bd6968-c376-4c88-8312-6c120b5ee838","word":"تَوَاصُلٌ دَاخِلِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8f74","lexicalEntryId":"f5bd6968-c376-4c88-8312-6c120b5ee838","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَوَاصُلٌ دَاخِلِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُشير إلى مُمَارَسةِ جماعَةٍ لغويةٍ أو أقلِّيَّةٍ عِرقِيَّةٍ أو دِينِيَّة لغةً خاصَّةً تتواصَل بها فيما بينها، في حين تَستَعمِل اللغةَ السائدَةَ في التواصُل خارِجَ جماعَتِها. فشَعبُ الآمِش Amish People في كندا وبعضِ الولاياتِ الأمريكيةِ يتواصَلون فيما بينهم بمستوى من اللغة الألمانيةِ يُسمى: Pennsylvania Dutch أو Deitsch، ويتواصَلون مع غيرهم بالإنجليزية. ويُقابَل هذا المصطلَحَ بمصطلَح التواصُلِ الخارِجِيِّ  exogenous communication.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تواصل داخلي ","nonDiacriticsLemma":"تواصل داخلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَوَاصُلٌ دَاخِلِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

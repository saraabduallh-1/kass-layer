{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2af50992-7ef2-46fb-9112-043c2690fc45/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2af50992-7ef2-46fb-9112-043c2690fc45","word":"مُعَالَجَةُ الجُمْلَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d6f","lexicalEntryId":"2af50992-7ef2-46fb-9112-043c2690fc45","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُعَالَجَةُ الجُمْلَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ عصَبيٌّ، يُطلَق على العَمَلية أو العَمَلياتِ المعرِفيةِ الإدراكيةِ التي تَتِمُّ في مراكز اللغةِ في الدِّماغ؛ لفَهم جُملةٍ مَسموعَةٍ أو مَقروءة، أو إصدارِها مفرَدَةً أو ضِمنَ سياق. ففَهمُ الجُملةِ المسموعَةِ أو المقروءةِ يتطلَّب وجودَ كلماتِها ودلالاتِ تلك الكلماتِ في المعجَم الذِّهنيِّ للمستَمِع أو القارئِ مع القدرَة على التحليل النَّحوي. وإصدارُ الجُملةِ يتضَمَّن اختِيارَ الكلمات، وترتيبَها، ونُطقَها. وتختَلِف النظرياتُ اللغويةُ النفسيةُ في تفسير هذه المعالَجاتِ؛ سواء في الفَهم أو في الإنتاج، في الكلام الشَّفَهيِّ أو في النَّص المكتوب. وفي اللسانياتِ الحاسوبية، يُطلَق المصطلَحُ أيضا على معالَجَة الجُملةِ في البرامج الحاسوبية.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معالجة الجملة ","nonDiacriticsLemma":"معالجة الجملة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُعَالَجَةُ الجُمْلَةِ"}],"lem
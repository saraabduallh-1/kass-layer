{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4e165818-dc7f-4c16-8cdf-f26645c06b97/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4e165818-dc7f-4c16-8cdf-f26645c06b97","word":"مَعْنَى الجُمْلَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9d6d","lexicalEntryId":"4e165818-dc7f-4c16-8cdf-f26645c06b97","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَعْنَى الجُمْلَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَعنى الكلامِ الذي يَرغَب المتكلِّمُ إيصالَه إلى السّامع باستِعمال جُملةٍ معيَّنةٍ في سِياقٍ معيَّن، وقد يَختَلِف عن المعنى الظاهرِ لتِلك الجُملة. فقولُ المتكلِّمِ: \"إن ساعَتي تَوَقَّفَت مَرَّةً أخرى\" قد يحمل معانيَ مختَلِفةً بحسب السِّياقِ التَّداوُلي؛ فقد يَقصد به المتكلمُ: \"لا أعرِف الوَقتَ الآنَ\"، أو: \"تَوَقُّفُ ساعَتي هو سَبَبُ تَأخُّري\"، أو: \"يجب عليَّ إصلاحُ ساعَتي\". وقد يَعني عَدَمَ الرِّضا عن الساعَة حين يكون الكلامُ موَّجّهًا إلى وَكيل البَيعِ أو محَلِّ إصلاح الساعات. راجع:  @(utterance meaning) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معنى الجملة ","nonDiacriticsLemma":"معنى الجملة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَعْنَى الجُمْلَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

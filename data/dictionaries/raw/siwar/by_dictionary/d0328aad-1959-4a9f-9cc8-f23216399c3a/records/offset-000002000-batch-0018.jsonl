{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7862200a-447e-4cb4-b57e-5f1bd8304fa4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7862200a-447e-4cb4-b57e-5f1bd8304fa4","word":"تَضَادٌّ نِسْبيٌّ مُتَدَرِّجٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91ed","lexicalEntryId":"7862200a-447e-4cb4-b57e-5f1bd8304fa4","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَضَادٌّ نِسْبيٌّ مُتَدَرِّجٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التَّضادُّ النِّسبِيُّ بين كلمَتَين من حيث المعنى؛ كالتَّضادِّ بين كلمتَيْ: (كبير وصغير)، إذ الفَرقُ بينهما نِسبِيٌّ على الرَّغم من تَضادِّهما. فالشيءُ قد يُنعت بأنه كبير بمعيارٍ معيَّنٍ لكنه صَغيرٌ بمعيارٍ آخَر، أو يكون الشيءُ أكبَرَ من شيءٍ معيَّنٍ لكنه أصغَرُ من شيءٍ آخَر. وفي بعض اللغات، كالإنجليزية مثلا، تكون بعضُ الألفاظِ معيارِيةً أو غيرَ مَوسومَةٍ unmarked، فلَفظُ: large مثلا مِعيارِيٌّ غيرُ مَوسوم، خِلافًا للَفَظ: small الموسوم؛ فغالِبًا ما يُقال للشيء: How large it is ، بدَلًا من: How small it is ، ويُقال: How old are you?، لكن لا يُقال: How young are you?، ما لم يكن الحديثُ عن الصِّغَر ذاتِه. راجع:  @(gradable opposite) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تضاد نسبي متدرج ","nonDiacriticsLemma":"تضاد نسبي متدرج","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَضَادٌّ نِسْبيٌّ مُتَدَرِّجٌ"
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/709c868b-97f9-4fe2-b8c6-2009ac48504d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"709c868b-97f9-4fe2-b8c6-2009ac48504d","word":"تَصْنِيفٌ سُلاليٌّ وِرَاثِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b91f4","lexicalEntryId":"709c868b-97f9-4fe2-b8c6-2009ac48504d","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَصْنِيفٌ سُلاليٌّ وِرَاثِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحَدُ أساليبِ تَصنيفِ اللغات، يُقصَد به تَصنيفُ اللغاتِ على أساسٍ من العائلات اللغويةِ التي تَنتَمي إليها، أي على أساس القَرابَةِ بينها، ثم تَقسيمُ العائلةِ الواحدةِ إلى مجموعات، وتَقسيمُ المجموعةِ الواحدةِ إلى فُروع، وتقسيمُ الفرعِ الواحدِ إلى لغاتٍ فَردِية. فالفرنسيةُ والإسبانيةُ مثلا تنتَميان إلى اللغات الرومانسية، واللغاتُ الرومانسيةُ سُلالةٌ تَشمَل كلَّ اللغاتِ التي تَرجِع إلى أصلٍ لاتينيٍّ، واللغةُ اللاتِينيةُ عَينُها عُضوٌ في عائلَةٍ أكبرَ منها هي عائلةُ اللغاتِ الهنديةِ الأوروبيةِ. ومن أبرَز العائلاتِ اللغوية: العائلةُ الهنديّةُ الأوربيةُ، والعائلةُ الساميّةُ الحاميّةُ، والعائلةُ الصينيّةُ التِّبتِيّةُ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تصنيف سلالي وراثي ","nonDiacriticsLemma":"تصنيف سلالي وراثي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَصْنِيفٌ سُلاليٌّ وِرَاثِيٌّ"}],"lemmaLanguage
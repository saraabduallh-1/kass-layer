{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/47a07162-3f97-4154-a9ef-5ec3ca24ac90/get-public-entry"},"browse_index_record":{"lexicalEntryId":"47a07162-3f97-4154-a9ef-5ec3ca24ac90","word":"انْحِطَاطُ الدَّلالَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e04","lexicalEntryId":"47a07162-3f97-4154-a9ef-5ec3ca24ac90","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"انْحِطَاطُ الدَّلالَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوعٌ من أنواع تَغيُّرِ الدّلالة، يَعني أن يَنحَدِر اللَّفظُ إلى معنى أدنى من معناه الأصليِّ، مثلُ كلمةِ: silly في الإنجليزية، التي تَعني في الأصل: soulful (عَمِيق العاطِفَة)، ثم صارَت بالتدريج تَعني: foolish (أحمَق). يقابِل ذلك ارتقاء الدّلالةِ enhancement أو: amelioration، كما حَدَث لكلمة: nice التي كانت تَعني في الأصل: (جاهِل) أو (أحمَق) ثم اكتَسَبَت معنى رَفيعا. يُستَعمَل المصطلحُ أيضا بمعنى الذَّمِّ في مقابِل المدح، ويُسمّى المعنى المذموم: pejorative.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"انحطاط الدلالة ","nonDiacriticsLemma":"انحطاط الدلالة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"انْحِطَاطُ الدَّلالَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0fc452b0-6403-4374-a94a-3995201aa3f1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0fc452b0-6403-4374-a94a-3995201aa3f1","word":"لُغَةٌ اشْتِقَاقِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e08","lexicalEntryId":"0fc452b0-6403-4374-a94a-3995201aa3f1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ اشْتِقَاقِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سِمَةٌ أو وَصفٌ للغة تعتَمِد على الاشتِقاق لتَوليد كلماتِها. والاشتقاقُ هو أحَدُ التصنيفاتِ التي تُصنَّف على أساسها اللغاتُ؛ فيُقال: لغةٌ اشتقاقية، ولغةٌ لَصقِية، ونحوُ ذلك، وقد تُصنَّف اللغةُ في أكثَر من صِنفٍ أو مجموعةٍ، كالعربية مثلا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة اشتقاقية ","nonDiacriticsLemma":"لغة اشتقاقية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ اشْتِقَاقِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/62649997-02a2-43fe-9da5-d4bc9e7d294f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"62649997-02a2-43fe-9da5-d4bc9e7d294f","word":"دِرَاسَاتٌ عَبْرَ اللُّغَاتِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e09","lexicalEntryId":"62649997-02a2-43fe-9da5-d4bc9e7d294f","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"دِرَاسَاتٌ عَبْرَ اللُّغَاتِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نمطٌ من الدراسات اللغويةِ التطبيقية، يُعنَى باكتساب اللغةِ الثانية، من خلال دراسةِ ظاهرَةٍ لغويةٍ واحدةٍ في عَدَد من اللغات، أو من خلال دراسةِ ظاهرَةٍ لغويةٍ واحدةٍ لدَى عَدَدٍ من الناطقين بلغاتٍ مختَلِفةٍ يدرسون لغةً ثانيةً أو أجنبيةً بعينها. فالنوعُ الأولُ يحَدِّد صُعُوبةَ الظاهرَةِ أو سُهولَتَها بوَجهٍ عامٍّ حين تُدرَس في اللغة الثانية، والنوعُ الثاني يحَدِّد علاقةَ اللغاتِ الأمِّ باكتساب الظاهرَةِ المدروسةِ في اللغة الثانية. ويَدخُل في هذا النوعِ من الدراسات البَحثُ في تأثير اللغةِ الثانيةِ في تعلُّم اللغاتِ الثالثةِ والرابعةِ...، والبَحثُ في تأثِير اللغاتِ الثانيةِ والثالثةِ والرابعةِ ... في اللغة الأم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"دراسات عبر اللغات ","nonDiacriticsLemma":"دراسات عبر اللغات","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"دِرَاسَاتٌ عَبْرَ اللُّغَاتِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a6b937f4-da87-4717-9474-3ae4902d3002/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a6b937f4-da87-4717-9474-3ae4902d3002","word":"خَلْفِيَّةٌ ثَقَافِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e0a","lexicalEntryId":"a6b937f4-da87-4717-9474-3ae4902d3002","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"خَلْفِيَّةٌ ثَقَافِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الموْروثاتُ الثقافيةُ التي يَحمِلها متعلِّمُ اللغةِ الثانيةِ وترتَبِط بلُغَته الأمِّ، وأثَرُ هذه الموروثاتِ في تعلُّمِه لغةً ثانية أو أجنبيةً، وتَقَبُّلِه ثقافةَ الناطقين بها، ودَرَجَةِ اندِماجِه بهم، ونحوِ ذلك مما يؤثِّر إيجابا أو سَلبا في اكتسابه اللغةَ الهَدَف.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"خلفية ثقافية ","nonDiacriticsLemma":"خلفية ثقافية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"خَلْفِيَّةٌ ثَقَافِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/31d4c5d1-3397-48c3-951d-d2e24e6080c8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"31d4c5d1-3397-48c3-951d-d2e24e6080c8","word":"هَيْمَنَةٌ ثَقَافِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8e0b","lexicalEntryId":"31d4c5d1-3397-48c3-951d-d2e24e6080c8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"هَيْمَنَةٌ ثَقَافِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تَسَلُّطُ دولَةٍ قويةٍ على دولَة ضَعيفةٍ، وفَرضُ ثقافَتِها عليها. ويَشمَل هذا التسلط عدَّةَ جوانبَ، أهمها: اللغةُ، ومناهجُ التعليم، والقِيَمُ والمواقِفُ الاتجاهات، والآراءُ السياسية. بَيدَ أن اللغةَ هي أخَطَرُ هذه الجوانبِ حيث تُفَسَّر القِيَمُ والاتجاهاتُ والمفاهيمُ والآراءُ وفقَ المفاهيمِ اللغويةِ التي فَرَضَها المحتَلُّ أو المهَيمِنُ، وقد تكون جزءا من الدّلالات اللغويةِ التي يَصعُب تَغيِيرُها فيما بعد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"هيمنة ثقافية ","nonDiacriticsLemma":"هيمنة ثقافية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"هَيْمَنَةٌ ثَقَافِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

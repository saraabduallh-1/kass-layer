{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/42b421a4-c759-49a2-8531-05e594fde3d0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"42b421a4-c759-49a2-8531-05e594fde3d0","word":"مَجْمُوعَةٌ ضَابِطَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d62","lexicalEntryId":"42b421a4-c759-49a2-8531-05e594fde3d0","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَجْمُوعَةٌ ضَابِطَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":" إحدى المجموعَتَين في البحث التَّجريبيِّ التي تُقابِل المجموعةَ التجريبيةَ موضوعَ الدراسة. فإذا أراد الباحِثُ التأكُّدَ من فائدَة طريقةِ تدريسٍ جديدة، فإنه يُقسم طلابَه المتَشابِهِين في جميع الجوانبِ إلى مجموعَتَين بطريقَةٍ عَشوائية: إحداهما ضابِطَةٌ تُدَرَّس بالطريقة التقليدية، والأخرى تَجريبِيةٌ تُدَرَّس بالطريقة الجَديدة. وبمقارَنَة نتيجَتَيْ المجموعَتَين في التحصيل أو في الكفايَةِ، تتَّضِح فائدَةُ الطريقةِ الجَديدةِ من عَدِمها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مجموعة ضابطة ","nonDiacriticsLemma":"مجموعة ضابطة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَجْمُوعَةٌ ضَابِطَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

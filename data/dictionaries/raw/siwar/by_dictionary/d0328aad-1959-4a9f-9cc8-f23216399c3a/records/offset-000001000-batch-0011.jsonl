{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9885e7bd-304d-4622-a301-f524885650ad/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9885e7bd-304d-4622-a301-f524885650ad","word":"لُغَةٌ مَضْبُوطَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d4c","lexicalEntryId":"9885e7bd-304d-4622-a301-f524885650ad","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مَضْبُوطَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في علم الترجَمة، يُشير إلى مستوى من اللغة محدودَةِ المفرداتِ والتراكيب، غالبا ما تكون مُوجَّهَةً للناطقين بغير لغَةِ النَّصِّ، أو للناطقين بها من غير المتخَصِّصين في موضوع النَّص. ويَشيع هذا النَّمَط من اللغة في نُصوص الوَثائقِ التِّقنيَّة، وأدلِّةِ الأجهِزَة الكهربائيةِ والميكانيكية، وشَرحِ استِعمالِ الأدوية؛ لتَيسير فَهمها، وكذلك في اللغة المعَدَّةِ للترجَمة الآليَّةِ في الحاسب الآليِّ. راجعالمعنى التالي.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ حاسوبيٌّ، يُشير إلى صِيغَةٍ لغويةٍ للنَّصِّ المرادِ إدخالُه في الحاسوب لأغراض التَّرجَمةِ الآلِيَّة، وتُعَدُّ هذه الصِّيغَةُ في مرحَلة التحريرِ المسبَق، بإزالَة ما في النَّصِّ من مواضِع اللَّبْسِ المحتَمَلة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مصطلحٌ لغويٌّ تطبيقيٌّ، يُشير إلى حالَةِ المتعلِّمِ الأجنَبيِّ حين يتحدَّث باللغة الهَدَفِ تحت ظروفٍ مَضبُوطَةٍ مُراقَبَة؛ إذ يَشتَدُّ انتِباهُه، وتَنشَغِل ذاكرَتُه القَصيرةُ الأمَدِ؛ فيَقَع في أخطاء لم يكن يَقَع فيها عندما كان يتحدَّث بطريقَةٍ تِلقائيةٍ غيرِ مُراقَبَة. وهذا أحد الأسبابِ التي تُفَسِّر تَغيُّرَ أداءِ المتعلِّم في استعمال اللغةِ الهَدَفِ بحسب المقاماتِ والمواقِف، وهو نوعٌ من الأداء أو التَّغَيُّر غيرِ المنتَظِمِ. راجع:  @(automatic processing) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة مضبوطة ","nonDiacriticsLemma":"لغة مضبوطة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مَضْبُوطَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1220387f-7be4-422a-9247-f50ac580be0a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1220387f-7be4-422a-9247-f50ac580be0a","word":"الوَعْيُ النّاقِدُ باللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d53","lexicalEntryId":"1220387f-7be4-422a-9247-f50ac580be0a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"الوَعْيُ النّاقِدُ باللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ اجتماعيٌّ، يُشير إلى مذهَبٍ في النَّظَر إلى اللغة، مُتَأَثِّرٍ بالنَّقد الأدَبيِّ والتَّحليلِ النَّقدِي للخِطاب، يُنادي أصحابُه بتعليم الطلابِ مَعلوماتٍ حَولَ اللغةَ teaching about language ، لا في الجوانب التركيبِيَّةِ للغة، بل في الجوانب الاجتماعيِة والثقافيةِ للُّغة، وبيانِ أهميَّةِ هذه اللغةِ في المجتَمَع. طُبِّقَت هذه النظريةُ في التعليمِ العامِّ والبحثِ اللغويِّ العِلميِّ في دولة جَنوبِ أفريقيا؛ لتَحَدِّي التَّمْيِيزِ العُنصُريِّ السّائدِ فيها آنذاك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"الوعي الناقد باللغة ","nonDiacriticsLemma":"الوعي الناقد باللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"الوَعْيُ النّاقِدُ باللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

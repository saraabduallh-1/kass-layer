{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/feb42c9f-d7b7-4b59-ab5d-d0f6b164d777/get-public-entry"},"browse_index_record":{"lexicalEntryId":"feb42c9f-d7b7-4b59-ab5d-d0f6b164d777","word":"نَقِيضٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d55","lexicalEntryId":"feb42c9f-d7b7-4b59-ab5d-d0f6b164d777","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَقِيضٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"قَضِيَّتان أو مسألَتان مرتَبِطَتان ببعضهما بطريقةٍ ما، بحيث تكون إحداهما صَحيحَةً والأخرى خاطِئة، ويَستَحيل أن تكونا صَحيحَيتَين معًا أو خاطئَتَين معًا، مثالُ ذلك الجُملتان التاليِتان: محمدٌ متزوِّجٌ، ومحمدٌ أعزَب، فالزواجُ والعزوبيةُ هنا مصطَلَحان متَناقِضان. ويُطلق المصطلَحُ أيضا صفةً للكلمة التي تُناقِض كلمةً أخرى في المعنى ولا تَقبَل التَّدريج، مثل: (رَجُل وامرأة) و(حَيّ ومَيِّت) و(صُلب وسائل)، في مقابِل الصفةِ التي تُطلَق على الكلمة التي تُناقِض كلمةً أخرى وتَقبَل التَّدريجَ، مثلُ: (بارِد وساخِن) و(طوِيل وقَصِير).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"نقيض ","nonDiacriticsLemma":"نقيض","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَقِيضٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

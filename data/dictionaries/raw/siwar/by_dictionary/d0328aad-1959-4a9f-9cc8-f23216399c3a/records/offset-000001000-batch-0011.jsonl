{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/95d07cbd-b014-42ea-a131-49638cac8ab8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"95d07cbd-b014-42ea-a131-49638cac8ab8","word":"مُحَادَثَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d57","lexicalEntryId":"95d07cbd-b014-42ea-a131-49638cac8ab8","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُحَادَثَةٌ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تَبادُلٌ حِوارِيٌّ فِعليٌّ، يَجرِي بين شَخصَين أو بين شَخصٍ ومجموعةٍ من الأشخاص؛ سواء أكان ذلك أمامَ مجموعةٍ من المستَمِعين، أم كان في مكانٍ بعيدٍ عن الناس.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"pos":"NA","root":null,"wordForms":[],"relatedSenses":[],"search":"محادثة ","nonDiacriticsLemma":"محادثة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُحَادَثَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e1f86e4b-c902-45d8-9132-bd88dca60e67/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e1f86e4b-c902-45d8-9132-bd88dca60e67","word":"تَحْلِيلُ التَّحَادُثِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d58","lexicalEntryId":"e1f86e4b-c902-45d8-9132-bd88dca60e67","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"تَحْلِيلُ التَّحَادُثِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تحليلُ الحِوارِ الطبيعيِّ الذي يتِمُّ بين شخصَين؛ لتَحديد السِّماتِ اللغوية، ومعرِفةِ كَيفِيةِ إجراءِ الحِوارِ في الحياة العادِيَّة. ويتضمَّن التَّحليلُ تَوقيتَ بدءِ الحديثِ وإنهائِه لدى كلٍّ من المتحاوِرَيْن، وعلاقةَ حَديثِ كلٍّ منهما بحَديث الآخَر، ونوعَ الوَظائفِ والأساليبِ التي يستَعمِلها كلُّ واحدٍ منهما، ونحوَ ذلك. وهو مذهبٌ أو أسلوبٌ في دراسة بِنيَةِ الخِطاب، بَرَز بشَكلٍ واضِحٍ في السبعينيات من القرن العشرين، واستُعمِل في معنَيَين، أحدُهما عامٌّ يَشمل جَميعَ أساليبِ تحليلِ الحِوار ومناهِجِه، والآخَرُ خاصٌّ بموضوع الحِوارِ يَرفُض الأساليبَ التي لا عَلاقَة لها بالحِوار. وقد اشتُهِر بهذا المعنى الخاصِّ عالِمُ الاجتماعِ الأمريكيُّ هارفي ساكس Harvey Sacks، وارتَبَط هذا المفهومُ الخاصُّ بالمذهَب الاجتماعيِّ العامِّ المعروفِ بتَحلِيلِيَّة التَّحَاوُرِ ethnomethodology، أو نَشأ منه. وتحليلُ التَّحاوُرِ بهذا المفهومِ الخاصِّ يُقابِل مصطَلَحَ تَحليلِ الخِطابِ discourse analysis.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"تحليل التحادث ","nonDiacriticsLemma":"تحليل التحادث","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"تَحْلِيلُ التَّحَادُثِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d44d7f3a-cb8b-4b28-8151-3dc7eededbf3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d44d7f3a-cb8b-4b28-8151-3dc7eededbf3","word":"النَّحْوُ اللُّبُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d59","lexicalEntryId":"d44d7f3a-cb8b-4b28-8151-3dc7eededbf3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"النَّحْوُ اللُّبُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ في النظرية التوليديةِ التحويلية، يُشير إلى مجموعَةٍ من المبادئ اللغويةِ الكُلِّيَّةِ التي تميِّز القواعدَ غيرَ الموسُومةِ في اللغة unmarked rules عن القواعد الموسُومةِ marked rules. وقد استَعمله تشومسكي في نظريته التوليديةِ التحويليةِ للدّلالة على القواعد الأساسِ التي تَشتَرِك فيها جميعُ اللغات، وتُكتَسَب بطريقَةٍ فِطرِيةٍ عَفوِية من غير حاجَةٍ إلى تعلُّم، في مقابِل القواعدِ التي سمّاها القواعدَ الهامِشِيةَ peripheral grammar","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"النحو اللب ","nonDiacriticsLemma":"النحو اللب","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"النَّحْوُ اللُّبُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1974cf06-7135-436f-b6f4-545acb17d6b3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1974cf06-7135-436f-b6f4-545acb17d6b3","word":"مُدَوَّنةٌ (لُغَوِيَّةٌ)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d5a","lexicalEntryId":"1974cf06-7135-436f-b6f4-545acb17d6b3","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مُدَوَّنةٌ (لُغَوِيَّةٌ)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعةٌ من الموادِّ اللغويةِ الموَثَّقَةِ، المنطوقَةِ أو المكتوبَة المدَوَّنَةِ؛ لأغراض الدراسةِ والتحليل، أو للخروجِ بنظريةٍ لغوية، أو للبحث في صحَّة كلمةٍ أو تركيبٍ أو أسلوب. تجمع على corpora، ويُطلَق عليها في العربية تَسمِياتٍ مختَلِفَة؛ كالذَّخيرَة اللغويةِ، والذَّخيرَةِ النَّصِّيَّة، والمكْنَز، والمتُون، إضافَةً إلى المدوَّنَةِ أو المدوَّناتِ اللغوية. وغالِبا ما تكون المدوَّنَةُ كَمًّا كبيرا من النّصوص يُختَزَن في ذاكِرَة الحاسوبِ بطريقَةٍ تُسَهِّل استِخراجَ المعلوماتِ والرَّدَّ على الاستِفسارات ونحو ذلك، وتكون المدوَّنَةُ عامَّةً أو خاصَّةً بمجالٍ معيَّن. ظهرَت أولى المدوَّناتِ الإلكترونيةِ المحوسَبَةِ electronic corpus linguistics في بدايَة النِّصفِ الثاني من القَرن العِشرين، حتى أصبَح هذا الاسمُ عَلَمًا عليها، ثم زاد الاهتِمامُ بها في السنوات الأخيرَةِ؛ نتيجَةَ تَقَدُّمِ تقنيةِ المعلوماتِ والبرامِجِ الحاسوبية، واستِقلالِ علمِ اللغةِ الحاسوبيِّ؛ فتنوَّعَت فوائدُها، وتعَدَّدَت استِخداماتُها وأنواعُها؛ فأصبَحَت مادَّةً لصناعَة المعاجِم، ووَسيلَةً لإعداد الموادِّ التعليمية، والتَّرجمةِ الآليَّة، ومصدَرا للبحوث العلميةِ في وَصف اللغاتِ وتحديدِ مراحلِ اكتِسابِها وتعلُّمِها وتعليمِها. والدراساتُ اللغويةُ التي تعتَمِد على المدوَّنات تُسمّى لسانيّات المدوَّنات. والمدوَّناتُ اللغويةُ أنواعٌ تختَلِف بحسب طبيعَتِها وحَجمِها وأهدافِها وزَمَنِها ولُغَتِها؛ كالمدوّنات العامّة، والمدوّناتِ الخاصَّة، والمدوّناتِ المقارنَةِ أو المتَشابِهَة، والمدوّناتِ المتوازِيَة، ومدوّنةِ المتعلِّمين، والمدوّنةِ التعليمية، والمدوّنةِ التاريخية، ومدوّنةِ المتابَعَة، والمدوّنةِ المنطوقَة، والمدوّنةِ المكتوبَة، والمدوّنةِ الخام، والمدوّنةِ الموسومَة. راجع:  @(corpus linguistics) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"مدونة (لغوية) ","nonDiacriticsLemma":"مدونة (لغوية)","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مُدَوَّنةٌ (لُغَوِيَّةٌ)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

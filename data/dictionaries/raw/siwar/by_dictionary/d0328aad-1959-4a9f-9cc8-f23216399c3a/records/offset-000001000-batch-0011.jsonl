{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fd2911fb-9b6a-4d2c-a54f-5023e29fcfd1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fd2911fb-9b6a-4d2c-a54f-5023e29fcfd1","word":"فَرضِيَّةُ البِنَاءِ الإبْدَاعِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d5e","lexicalEntryId":"fd2911fb-9b6a-4d2c-a54f-5023e29fcfd1","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"فَرضِيَّةُ البِنَاءِ الإبْدَاعِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فرضيةٌ أو نظريةٌ في اكتساب اللغة، تُفسِّر اكتشافَ متعلِّمِ اللغةِ الثانيةِ القاعدةَ التي تحْكُم النَّمَطَ اللغويَّ تفسيرا إبداعيا، بدَلا من التفسير التقليديِّ الذي يعتَمِد على دراسة القواعدِ أو حِفظِ الأنماطِ اللغويةِ وتقليدِها. ويرى أصحابُ هذه الفَرضيةِ أو النظرية، دولي و برت و كراشن Dulay, Burt and Krashen، أن المتعلِّمَ يَكتَشِف القاعدةَ في اللغة الهَدَفِ بالاستعانَة بالعَمَليات العقليةِ الطبيعيةِ كالتحليل والاستِنتاجِ والتَّعميم، وبالعَمَليات العقليةِ التي كان يستَعمِلها في لغته الأمِّ، مع عَدَم الاعتِمادِ كثيرا على قواعد لغتِه الأمِّ، وربما يَلجَأ إلى أساليبَ منطِقِيةٍ قد تَقودُه إلى استِنتاج قواعدَ غيرِ صحيحةٍ في اللغة الهَدَف؛ كالتَّعميم الخاطِئِ مثلا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"فرضية البناء الإبداعي ","nonDiacriticsLemma":"فرضية البناء الإبداعي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"فَرضِيَّةُ البِنَاءِ الإبْدَاعِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6e5c5d98-2469-4608-8a95-a005bee0e7ec/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6e5c5d98-2469-4608-8a95-a005bee0e7ec","word":"اللُّغَةُ الإبْدَاعِيَّةُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8d5f","lexicalEntryId":"6e5c5d98-2469-4608-8a95-a005bee0e7ec","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اللُّغَةُ الإبْدَاعِيَّةُ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ استَعمَله اللغويون المعرفيون المؤيِّدون للاتِّجاه الفِطرِيِّ في اكتساب اللغة، ويَقصدون به إبداعيةَ اللغةِ لدى الإنسان، أي قُدرَةَ الإنسانِ الناطِق بلغةٍ معيَّنةٍ على فَهمِ ما لا يُحصَى من العناصِرِ والتراكيبِ في لغته، وإنتاجِها والحُكمِ على ما يَسمَعه منها من حيث الصحةُ والخطأ، ولو لم يَسمَعها أو يتدرَّب على استعمالها من قبل، خلافا لما يراه السلوكيون من أن اللغةَ عادَةٌ سُلوكيةٌ تُكتَسَب بالمحاكاة والتَّقليدِ والتَّكرار. انتَقَلت هذه النظرةُ الإبداعيةُ للُّغة إلى بعض الطرائقِ الحديثَةِ في تدريس اللغاتِ الأجنَبية>","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اللغة الإبداعية ","nonDiacriticsLemma":"اللغة الإبداعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اللُّغَةُ الإبْدَاعِيَّةُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2a0d69b3-f861-43b4-89a5-ee4e6dd66546/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2a0d69b3-f861-43b4-89a5-ee4e6dd66546","word":" تَوْحِيدٌ لُغَوِيٌّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dd4","lexicalEntryId":"2a0d69b3-f861-43b4-89a5-ee4e6dd66546","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":" تَوْحِيدٌ لُغَوِيٌّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اعتماد لغةٍ ما لتكون هي اللغةَ المِعياريّةَ في المجتَمَع، أو اعتمادُ لَهجَةٍ من لَهَجاتها لتكون قِياسِيةً أو مِعيارِيّةً أو نموذَجيّةً في الكلام والكتابة، أي تَنْزيلُها مَنزلَةَ المستَوَى الأعلى أو اللَّهجَةِ المِعيارِيةِ للُّغة. يَتم ذلك بفَرض لغةٍ أو مستَوًى من مستَوَياتها، أو نظامٍ للكتابة أو الإملاء، ليَكون لغةَ الدَّوائرِ الحُكوميةِ والمكاتَباتِ الرَّسمِيةِ في الدَّولة، كما حَدَث لعددٍ من لُغات الشُّعوبِ الإسلاميّةِ في القَرن العشرين، التي منها التركيّةُ والإندونيسيّةُ والماليزيّةُ والصوماليّةُ والسَّواحِيلِيّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":" توحيد لغوي ","nonDiacriticsLemma":" توحيد لغوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":" تَوْحِيدٌ لُغَوِيٌّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/51f79824-ef49-487e-bc40-89c9949770ef/get-public-entry"},"browse_index_record":{"lexicalEntryId":"51f79824-ef49-487e-bc40-89c9949770ef","word":"اسْتِقْبَالُ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dc9","lexicalEntryId":"51f79824-ef49-487e-bc40-89c9949770ef","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اسْتِقْبَالُ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحٌ لغويٌّ نفسيٌّ، يَعني تَلقِّيَ السَّامِعِ الكلامَ من المخاطَب، وهو أحَدُ جوانبِ العمَليةِ التواصُلية، في مُقابِل إلقاءِ الكلامِ أو إرسالِه إلى المخاطَب. وتبدأ عمَليةُ استِقبالِ الكلامِ من وُصول الصوتِ إلى الأذُن الخارجيةِ للسامع، وتَنتَقِل عبرَ الأذُنِ الوُسطى والأذُنِ الداخليةِ إلى مراكز اللغةِ في الدِّماغ حيث تُدرَك وتُفهَم إذا كانت بلُغة السَّامعِ أو كانت بلُغةٍ يُتْقِنها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"استقبال الكلام ","nonDiacriticsLemma":"استقبال الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اسْتِقْبَالُ الكَلامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5f7b8104-a937-48dd-81ca-f0f40e27c19a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5f7b8104-a937-48dd-81ca-f0f40e27c19a","word":"إيقَاعُ الكَلامِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9dca","lexicalEntryId":"5f7b8104-a937-48dd-81ca-f0f40e27c19a","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"إيقَاعُ الكَلامِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إيقاعُ الكلامِ الممَيِّزِ للُغةٍ ما، ويحدُث نتيجةَ تَقليصِ عَضَلاتِ الصَّدرِ وإرخائِها بطريقَةٍ معيَّنةٍ؛ لتَغيير ضَغطِ هواءِ التَّنَفُّس، وإحداثِ الإيقاعِ المؤقَّتِ النَّبرِيِّ أو المؤقَّتِ المقطَعِيّ. وثَمَّة نوعان من تَقليص عَضَلاتِ الصَّدر التي تُحدِث هذا الإيقاعَ، أحدُهما: تقَلُّصٌ عادِيٌّ يَنتُج عن ضَغطٍ طبيعيٍّ في نَبضَات الصَّدر، والآخَرُ ذو ترَدُّدٍ محدودٍ لكنه قويٌّ ومُفَاجِئٌ يمثِّل نبَضَاتِ الضَّغط. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"إيقاع الكلام ","nonDiacriticsLemma":"إيقاع الكلام","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"إيقَاعُ الكَلامِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

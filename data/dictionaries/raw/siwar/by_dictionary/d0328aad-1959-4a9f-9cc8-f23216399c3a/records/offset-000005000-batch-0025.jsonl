{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a4d8ad4b-74be-4d7d-96f9-35086ab818bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a4d8ad4b-74be-4d7d-96f9-35086ab818bf","word":"عِلْمُ اللُّغَةِ البِنيَوِيُّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739475ce0c04dea49b9e8c","lexicalEntryId":"a4d8ad4b-74be-4d7d-96f9-35086ab818bf","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"عِلْمُ اللُّغَةِ البِنيَوِيُّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منهجٌ في علم اللغة، يُعنَى بدراسة اللغةِ وتَحليلِها من خلال بِنيَتِها أو نظامِ عناصِرِها في كل مستوًى من مستويات التحليل، ويؤكِّد أن العلاقةَ القائمةَ بين العناصِرِ اللغويةِ المختَلِفةِ في كلِّ نظامٍ هي جَوهرُ ذلك النظام، وأنه لا يمكن تحليلُ أيِّ عنصُرٍ بمعزِلٍ عن العناصِر الأخرى. هذا هو المنهَجُ السائدُ في علم اللغةِ الحديثِ منذ نَشأته في نهايَة القرنِ التاسع عشر حتى أواخِرِ الخمسينياتِ من القرن العشرين، حين أعلَن تشومسكي ثورَتَه على علم اللغةِ البِنيَوي أو اللِّسانياتِ البِنيَوِيَّة، لكنه ما زال منهَجًا متَّبَعًا في كثيرٍ من الدراسات اللغوية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]},{"definition":"مَفهومٌ خاصٌّ يُطلَق على مَنهج البِنيَويِّ الأمريكيِّ ليُونارد بلومفيلد Leonard Bloomfield الذي سادَ في منتَصَف القرنِ العشرين، وكان يُركِّز على دراسة البِنيَةِ الشَّكليَّةِ الظاهرَةِ للُّغة، تلك البِنيَةُ التي سمّاها تشومسكي البِنيَةَ السَّطحيّةَ surface structure، ورَفَض الاعتِمادَ عليها في دراسة اللغة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"علم اللغة البنيوي ","nonDiacriticsLemma":"علم اللغة البنيوي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"عِلْمُ اللُّغَةِ البِنيَوِيُّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

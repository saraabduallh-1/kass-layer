{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/89f69409-53f2-420d-85d9-9871e34fdda9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"89f69409-53f2-420d-85d9-9871e34fdda9","word":"المَذْهَبُ التَّكَامُلِيُّ ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9351","lexicalEntryId":"89f69409-53f2-420d-85d9-9871e34fdda9","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَذْهَبُ التَّكَامُلِيُّ ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذهبٌ أو مَدخَلٌ في تعليم اللغة، تُقدَّم فيه المهاراتُ اللغويةُ الأربعُ (الاستماع والمحادثة والقراءة والكتابة) بطريقَةٍ تَكامُلية. فكُلُّ مهارَةٍ تخدِم المهاراتِ الأخرى، وكلُّ نَشاطٍ في مهارَةٍ يخدِم أنشِطةَ المهاراتِ الأخرى ويُكمّلها. تُقدَّم المهاراتُ في الكتاب الأساس، وقد تُمارَس كلُّها في حِصَّة واحدة، خِلافا لتدريس كلِّ مهارَةٍ منفَصِلةً عن المهارات الأخرى، سواء قدِّمَت في مرحَلةٍ واحدةٍ أو في مراحِلَ مختَلِفة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المذهب التكاملي  ","nonDiacriticsLemma":"المذهب التكاملي ","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَذْهَبُ التَّكَامُلِيُّ "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/02fc87e0-2916-4616-a7ed-92eece66bdfe/get-public-entry"},"browse_index_record":{"lexicalEntryId":"02fc87e0-2916-4616-a7ed-92eece66bdfe","word":"المَذْهَبُ المُتَكَامِلُ في تَعلِيمِ اللُّغَةِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9352","lexicalEntryId":"02fc87e0-2916-4616-a7ed-92eece66bdfe","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"المَذْهَبُ المُتَكَامِلُ في تَعلِيمِ اللُّغَةِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مَذهبٌ في تعليم اللغات الأمِّ والثانيةِ، يَعكِس المبادئَ التي تُكتَسَب بها اللغةُ الأمُّ واللغةُ الثانيةُ. ينطَلِق من أربعة مبادئ، الأول: تقديمُ اللغةِ الهَدَفِ متكامِلةً في سياقاتٍ طبيعيةٍ ومَواقفَ حقيقية، لا في أجزاء منفَصِلة. والثاني: انتقالُ الأنشِطَةِ التعليميةِ من الكُلِّ إلى الجُزء، لا العَكس؛ فيَقرأ الطلابُ النَّصَّ كامِلا من غير تَعديلٍ ولا اقتِطاعٍ لأجزاء منه. والثالث: ممارسةُ الطلابِ المهاراتِ اللغويةَ الأربعَ في الدرس الواحد؛ فلا يُقتَصَر فيه على مهارَةٍ واحدةٍ أو مهاراتٍ معيَّنة. والرابعُ: ممارسةُ الطلابِ اللغةَ في الفَصل بطريقَةٍ تفاعُليةٍ كما يمارِسونها في الحياة اليومية؛ فيتَعلَّمون في مجموعاتٍ تعاوُنيةٍ، بدَلًا من التعلُّم بطريقةٍ فَردِية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"المذهب المتكامل في تعليم اللغة ","nonDiacriticsLemma":"المذهب المتكامل في تعليم اللغة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"المَذْهَبُ المُتَكَامِلُ في تَعلِيمِ اللُّغَةِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

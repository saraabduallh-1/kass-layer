{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9f342351-5389-432f-8dde-443735b78c71/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9f342351-5389-432f-8dde-443735b78c71","word":"لُغَةٌ مُتَعَلَّمَةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9342","lexicalEntryId":"9f342351-5389-432f-8dde-443735b78c71","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"لُغَةٌ مُتَعَلَّمَةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على نوعٍ من اللغات، أو مستوًى من مستوَيات بعضِ اللغات، أو شَكلٍ من أشكالها؛ لا يُكتَسَب اكتِسابًا طبعيًّا، وإنما يُتَعَلَّم من خلال الموادِّ التعليميةِ المقدَّمَةِ بشَكلٍ منهَجيٍّ منظَّم. فاللاتينيةُ لغةٌ متعَلَّمَةٌ في أوروبا منذُ العُصورِ الوسطى، وبعضُ الكلماتِ في الإنجليزيةِ الحديثةِ ذاتِ الأصولِ اللاتينيةِ لا تُكتَسَب دونَ تعلُّم، وغالبا ما يَستَعمِلها المثَقَّفون وعِلْيَةُ القَوم. واللغةُ العربيةُ الفُصحَى في عَصرنا الحاضِرِ لغةٌ متعَلَّمَةٌ لا يَكتَسِبها العربيُّ، فضلا عن غيره، بطريقَةٍ طبيعيةٍ دونَ تعلُّم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات","اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"لغة متعلمة ","nonDiacriticsLemma":"لغة متعلمة","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"لُغَةٌ مُتَعَلَّمَةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a56b9921-9c6a-4e7f-af15-564d7b2c443e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a56b9921-9c6a-4e7f-af15-564d7b2c443e","word":"اخْتِبَارُ الذَّكَاءِ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9343","lexicalEntryId":"a56b9921-9c6a-4e7f-af15-564d7b2c443e","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"اخْتِبَارُ الذَّكَاءِ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوعٌ من الاختبارات المقَنَّنَة، يَقيس القُدرَةَ الذِّهنِيةَ العامَّةَ للفَرد واستِعدادَه الدِّراسيَّ وقدرَته على النجاح الأكاديميِّ، ويُبَيِّن مدَى قُدرَتِه على التعَلُّم والتَجريدِ وحَلِّ المشكلات، قِياسًا على أداء مجموعَةٍ مِعيَارِيةٍ في مثل عُمرِه. يَشمَل اختبارُ الذَّكاءِ قياسَ المهاراتِ اللَّفظِيَّةِ والرِّياضيةِ والإدراكِيةِ، وتُحسَب درَجةُ الفَردِ في الذَّكاء بقِسمَة عُمرِه العَقليِّ على عُمره الزَّمنيِّ وضَربِ النَّاتِجِ في مئة. يرَى كثيرٌ من اللغويين التطبيقيِّين أن تعلَّمَ المرءِ لغةً أجنَبيةً لا يتطلَّب درَجةً عاليَةً من الذَّكاء بقَدرِ ما يتطلَّب حَدًّا أدنى منه مع مُدخَلاتٍ لغويةٍ كافيةٍ وفُرَصٍ لاستعمال اللغة. راجع:  @(intelligence) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"اختبار الذكاء ","nonDiacriticsLemma":"اختبار الذكاء","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"اخْتِبَارُ الذَّكَاءِ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a6ab1038-5fed-4a6f-b932-57dc07a31198/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a6ab1038-5fed-4a6f-b932-57dc07a31198","word":"نَظَرِيَّةُ التَّعَلُّمِ التَّفَاعُلِيِّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b9344","lexicalEntryId":"a6ab1038-5fed-4a6f-b932-57dc07a31198","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"نَظَرِيَّةُ التَّعَلُّمِ التَّفَاعُلِيِّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظريةُ التفاعُلِ في التعلُّم؛ تُفَسِّر اكتسابَ اللغة، وترى أن الاكتسابَ مساهَمةٌ مشتَرَكةٌ وتفاعُلٌ بين البيئةِ اللغويةِ والعوامِلِ الذِّهنيةِ الداخِليةِ للإنسان، أي إن الاكتسابَ يحدُث نتيجةَ التفاعُلِ المشتَرَكِ بين القُدراتِ المعرِفيةِ (العوَامِل الداخِلية) للإنسان والمُدخَلِ اللغويِّ الذي يتلَقّاه من بيئته (العوَامِل الخارِجية). ويمكن تطبيقُ هذه النظريةِ في اكتساب اللغةِ الثانيةِ، حيث إن تواصُلَ المتعلِّمِ مع الناس باللغة الهَدَفِ يمنحه اكتسابَها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"نظرية التعلم التفاعلي ","nonDiacriticsLemma":"نظرية التعلم التفاعلي","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"نَظَرِيَّةُ التَّعَلُّمِ التَّفَاعُلِيِّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

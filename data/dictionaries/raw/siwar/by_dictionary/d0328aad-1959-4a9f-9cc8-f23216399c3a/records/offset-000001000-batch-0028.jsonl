{"source":{"platform":"SIWAR","dictionary_id":"d0328aad-1959-4a9f-9cc8-f23216399c3a","dictionary_name":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/d0328aad-1959-4a9f-9cc8-f23216399c3a","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/860cff2e-9fd6-40ab-b496-3910c9146649/get-public-entry"},"browse_index_record":{"lexicalEntryId":"860cff2e-9fd6-40ab-b496-3910c9146649","word":"مَعْرِفَةٌ مَوْسُوعِيَّةٌ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"67739474ce0c04dea49b8eff","lexicalEntryId":"860cff2e-9fd6-40ab-b496-3910c9146649","lexiconId":"d0328aad-1959-4a9f-9cc8-f23216399c3a","lexiconName":"المعجم الموسوعي لمصطلحات اللسانيات التطبيقية","lemma":"مَعْرِفَةٌ مَوْسُوعِيَّةٌ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وَصفٌ يُطلَق على مَعرِفة المرءِ للعالَم تَميِيزًا لمعرفَتِه للنظام اللغويِّ. فكلمةُ: (قِطّ) مثلا لها سِماتٌ دلالِيَّة، وهي كَونُها تُطلَق اسما لحيوانٍ، من فَصيلَةِ الثَّدِييّات، وأنه وَلُودٌ (غيرُ بيّاض). ولكَي يعرِف المرءُ هذه السِّماتِ الأساسيةَ التي تُميِّز هذه الكلمةَ من غيرها من الكلمات أو الوحداتِ اللغويةِ الأخرى، يجب أن يَعرِف أولا معنى الكلمةِ في اللغة. أما الخصائصُ والصفاتُ الأخرى لهذا الحيوانِ (القِط)، مثل أن يكون أعمى عند الوِلادَة، وأن مُدَّةَ حَملِه في بَطن أمِّهِ خمسةٌ وستون يوما، ونحوِ ذلك، فتلك معرفةٌ مَوسوعيةٌ تَقَع خارِجَ المعرفةِ اللغويةِ للكلمة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":["اللغات"],"translations":[]}],"root":null,"wordForms":[],"relatedSenses":[],"search":"معرفة موسوعية ","nonDiacriticsLemma":"معرفة موسوعية","metaData":{"longitude":null,"latitude":null,"periodDateFrom":"1970-01-01T00:00:00.000Z","periodDateTo":"1970-01-01T00:00:00.000Z","city":null},"lammaDetails":[{"form":"مَعْرِفَةٌ مَوْسُوعِيَّةٌ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

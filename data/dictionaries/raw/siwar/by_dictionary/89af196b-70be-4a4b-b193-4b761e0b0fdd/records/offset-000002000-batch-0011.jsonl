{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dc03e858-5689-4835-8566-27357fa2103e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dc03e858-5689-4835-8566-27357fa2103e","word":"Shipment","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bb3f","lexicalEntryId":"dc03e858-5689-4835-8566-27357fa2103e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"شحنة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تعني أعمال الشحن ملكية السفن أو تشغيلها وأي أنشطة داخل صناعات ملكية السفن والشحن وجميع الأعمال التجارية التي تكون مكملة أو عرضية أو مرتبطة أو ملحقة بأي من هذه الأنشطة والصناعات والأعمال، بما في ذلك امتلاك المراكب وجميع أنواع السفن العائمة أو لكلمة \"شحنة\" معنيان: (1) فعل شحن البضائع، أي نقلها فعليًا و (2) كمية معينة من البضائع (تُعرف أيضًا في السياق باسم \"الشحن\" أو \"الشحن\") -شحنة. على الرغم من أن المصطلح مشتق من النقل عن طريق البحر، إلا أنه يُستخدم الآن للتطبيق على حركة البضائع عبر أي وضع: البحر أو الجو أو الطريق أو السكك الحديدية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Shipment","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"شحنة  Shipment","nonDiacriticsLemma":"شحنة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"شحنة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

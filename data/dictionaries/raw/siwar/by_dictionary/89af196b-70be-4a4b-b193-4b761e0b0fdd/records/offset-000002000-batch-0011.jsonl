{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/618603f7-3c6f-4d52-ad06-5debc0026988/get-public-entry"},"browse_index_record":{"lexicalEntryId":"618603f7-3c6f-4d52-ad06-5debc0026988","word":"Value Networks","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bb3c","lexicalEntryId":"618603f7-3c6f-4d52-ad06-5debc0026988","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"شبكات القيمة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ما هي شبكة القيمة؟ شبكة القيمة هي مجموعة من الاتصالات بين المنظمات و / أو الأفراد الذين يتفاعلون مع بعضهم البعض لإفادة المجموعة بأكملها. تسمح شبكة القيمة للأعضاء بشراء وبيع المنتجات بالإضافة إلى مشاركة المعلومات.  فهي مجموعات أو منظمات تتفاعل لصالح بعضها البعض. في الأعمال التجارية يعتمد أعضاء المجموعات على بعضهم البعض للنمو والقيمة المضافة. يمكن أن يكون الأعضاء عملاء خارجيين أو أقسام داخلية. أي ضعف في مجموعة واحدة سيؤثر على الآخرين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Value Networks ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"شبكات القيمة  Value Networks ","nonDiacriticsLemma":"شبكات القيمة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"شبكات القيمة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

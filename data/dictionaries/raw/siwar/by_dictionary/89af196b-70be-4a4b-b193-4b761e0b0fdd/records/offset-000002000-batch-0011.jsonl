{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/24a14673-19a6-4b5f-89f7-8dedf126bb34/get-public-entry"},"browse_index_record":{"lexicalEntryId":"24a14673-19a6-4b5f-89f7-8dedf126bb34","word":"Bullish","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bb39","lexicalEntryId":"24a14673-19a6-4b5f-89f7-8dedf126bb34","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"صاعد","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"حيث يعتقد المستثمرون أن سعر السهم سيرتفع بمرور الوقت، يعتقد المستثمر أن سعر ورقة مالية واحدة أو أكثر سيرتفع. ويمكن أن ينطبق هذا على أي مقياس للسوق. يعتقد المستثمر الصاعد أحيانًا أن السوق ككل من المقرر أن يرتفع، متوقعًا المكاسب العامة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Bullish","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"صاعد  Bullish","nonDiacriticsLemma":"صاعد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"صاعد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5dbca8cd-9b6a-4e8e-95a6-a320c753b85c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5dbca8cd-9b6a-4e8e-95a6-a320c753b85c","word":"Purchase To Pay  (P2P)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bb3a","lexicalEntryId":"5dbca8cd-9b6a-4e8e-95a6-a320c753b85c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"شراء للدفع","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الشراء للدفع هو نظام شراء كامل للشركات من شراء البضائع إلى دفع البائع. يُطلق على الشراء مقابل الدفع أيضًا اسم P2P أو الشراء حتى الدفع أو الشراء الإلكتروني أو طلب الفحص. عملية الشراء للدفع آلية وتوفر التكاليف وتقلل من المخاطر.  أي انه تسلسل عمليات الشراء من شراء منتج أو خدمة إلى إتمام المعاملة المالية لدفع ثمنها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Purchase To Pay  (P2P)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"شراء للدفع  Purchase To Pay  (P2P)","nonDiacriticsLemma":"شراء للدفع","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"شراء للدفع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c14c0247-576b-48b5-80c0-e4da488f6940/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c14c0247-576b-48b5-80c0-e4da488f6940","word":"Circular Economy","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6bc","lexicalEntryId":"c14c0247-576b-48b5-80c0-e4da488f6940","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الإقتصاد التداولي (الدائري)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو مبدأ تعظيم إعادة الاستخدام واستخراج القيمة من المواد والمنتجات بدلاً من التخلص منها دون مراعاة النتيجة. وهو نهج منهجي للتنمية الاقتصادية مصمم لإفادة الشركات والمجتمع والبيئة. على عكس النموذج الخطي، فإن الاقتصاد الدائري متجدد بالتصميم ويهدف إلى فصل النمو تدريجيًا عن استهلاك الموارد المحدودة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Circular Economy","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الإقتصاد التداولي (الدائري)  Circular Economy","nonDiacriticsLemma":"الإقتصاد التداولي الدائري","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الإقتصاد التداولي (الدائري)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a021de51-659d-4ce5-a54f-bb35641fb314/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a021de51-659d-4ce5-a54f-bb35641fb314","word":"Informal Economies","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6bd","lexicalEntryId":"a021de51-659d-4ce5-a54f-bb35641fb314","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الإقتصادات غير الرسمية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الاقتصاد غير الرسمي (القطاع غير الرسمي أو الاقتصاد الرمادي) هو جزء من أي اقتصاد لا يخضع للضرائب ولا يخضع للمراقبة من قبل أي شكل من أشكال الحكومة. أي انه أنظمة التجارة التي يعمل فيها العمال لحسابهم الخاص إلى حد كبير، ويعملون بدون عقد، وساعات عمل غير منتظمة. إنهم يعملون على وعود شفهية بالأجر، لكنهم قد لا يتقاضون رواتبهم بسرعة أو بانتظام أو على الإطلاق. لا يحصلون على مزايا مثل أجر المرض أو أجر الإجازة بمعنى آخر هو جزء من الاقتصاد لا يخضع للضرائب أو يخضع للمراقبة من قبل أي شكل من أشكال الحكومة (يُعرف أيضًا باسم الاقتصاد الرمادي أو القطاع غير الرسمي). لا يتم تضمينه في الناتج القومي الإجمالي لبلد (GNP) أو الناتج المحلي الإجمالي (GDP) لبلد ما","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Informal Economies","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الإقتصادات غير الرسمية  Informal Economies","nonDiacriticsLemma":"الإقتصادات غير الرسمية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الإقتصادات غير الرسمية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e9732579-682c-451d-a535-bac719afd18f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e9732579-682c-451d-a535-bac719afd18f","word":"Relevance","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6be","lexicalEntryId":"e9732579-682c-451d-a535-bac719afd18f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الاحتكار ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الملاءمة هي التجربة الكاملة لمنتج أو علامة تجارية أو قضية يمكننا الارتباط بها؛ إنها تجـــــــربة لا تغير العقول فقط، ولكن الأهم من ذلك أنها تغير السلوك وتحافظ على هذا التغيير. أي احتمالية ما إذا كان العنصر سيكون مفيدًا أم لا في حالة ما","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Relevance ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"الاحتكار   Relevance ","nonDiacriticsLemma":"الاحتكار ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الاحتكار "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0f3a6104-7a70-4fc3-ab4b-29cb5aa6d69e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0f3a6104-7a70-4fc3-ab4b-29cb5aa6d69e","word":"Co-Production","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6bf","lexicalEntryId":"0f3a6104-7a70-4fc3-ab4b-29cb5aa6d69e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الإنتاج المشترك","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يحدث عندما يلعب العملاء دورًا في إنتاج منتج ما فمثلاً، عندما يصف أحد العملاء تصميمًا بمواصفات معينة للخياطة، فسيتم صنع الفستان وفقًا لمواصفات العميل. في هذه الحالة يكون العميل قد شارك في إنتاج الفستان من خلال توفير متطلبات ومواصفات خاصة تختلف عن خط الإنتاج الخاص بالشركة. فالإنتاج المشترك يعرف أيضاً على أنه مشروع مشترك بين شركتين أو أكثر من شركات الإنتاج المختلفة بغرض إنتاج الأفلام، والإنتاج التلفزيوني، وتطوير ألعاب الفيديو، وما إلى ذلك. في حالة الإنتاج المشترك الدولي، تعمل شركات الإنتاج من دول مختلفة (عادة من دولتين إلى ثلاثة) معًا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Co-Production","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الإنتاج المشترك  Co-Production","nonDiacriticsLemma":"الإنتاج المشترك","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الإنتاج المشترك"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

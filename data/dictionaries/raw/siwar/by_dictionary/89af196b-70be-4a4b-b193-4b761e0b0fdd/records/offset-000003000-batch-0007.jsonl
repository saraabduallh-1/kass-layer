{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/58bd9f6f-9836-4f75-842f-4608d3e6611d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"58bd9f6f-9836-4f75-842f-4608d3e6611d","word":"Principle Of Humanity","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bccd","lexicalEntryId":"58bd9f6f-9836-4f75-842f-4608d3e6611d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مبدأ الإنسانية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تستند هذه الحقوق الأساسية إلى قيم مشتركة مثل الكرامة والإنصاف والمساواة والاحترام والاستقلال. يحدد القانون هذه القيم ويحميها هذا يعني أن البشرية جمعاء يجب أن تعامل على قدم المساواة وإنسانية في جميع الظروف من خلال إنقاذ الأرواح والحفاظ عليها وإنهاء المعاناة، مع الحفاظ على احترام الفرد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Principle Of Humanity","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مبدأ الإنسانية  Principle Of Humanity","nonDiacriticsLemma":"مبدأ الإنسانية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مبدأ الإنسانية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2088d26f-6a2a-426d-94ce-a1526f1bd834/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2088d26f-6a2a-426d-94ce-a1526f1bd834","word":"Neighbor Principle","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bcce","lexicalEntryId":"2088d26f-6a2a-426d-94ce-a1526f1bd834","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مبدأ الجار","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تم ذكر ما يسمى بمبدأ الجار ليكون العامل المشترك في الحالات التي يوجد فيها واجب الرعاية. يجب على المرء أن يحرص على عدم إيذاء الجار. الجار هو أي شخص يتأثر بشكل وثيق ومباشر بفعل ما يجب عليك التفكير فيه عندما تتصرف.  الأشخاص المتأثرون بشكل وثيق ومباشر بأفعال الآخرين بحيث يجب أن يفكروا بها عند توجيه أذهانهم إلى الأفعال ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Neighbor Principle","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مبدأ الجار  Neighbor Principle","nonDiacriticsLemma":"مبدأ الجار","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مبدأ الجار"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/528002e7-718f-4e5b-8531-32bed3a82669/get-public-entry"},"browse_index_record":{"lexicalEntryId":"528002e7-718f-4e5b-8531-32bed3a82669","word":"Principle Of Precedent","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bccf","lexicalEntryId":"528002e7-718f-4e5b-8531-32bed3a82669","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مبدأ السابقة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في سياق القضايا المعروضة على المحاكم: تؤثر القرارات السابقة على القرارات الحالية والمستقبلية. تحدد الأنظمة القانونية المختلفة القرارات الملزمة (التي يجب اتباعها)، والتي هي فقط مؤثرة (يجب أخذها في الاعتبار ولكن ليس بالضرورة اتباعها) والتي لا تشكل سابقة (يمكن تجاهلها). القاعدة العامة في معظم الأنظمة هي أن قرارات المحاكم الأعلى ملزمة للمحاكم الأدنى. لفهم سابقة في بلد معين، لذلك، تحتاج إلى فهم هيكل المحكمة في ذلك البلد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Principle Of Precedent","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مبدأ السابقة  Principle Of Precedent","nonDiacriticsLemma":"مبدأ السابقة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مبدأ السابقة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/95d45e8f-d758-4e91-9541-9c5efe612456/get-public-entry"},"browse_index_record":{"lexicalEntryId":"95d45e8f-d758-4e91-9541-9c5efe612456","word":"Last Shot Principle","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bcd0","lexicalEntryId":"95d45e8f-d758-4e91-9541-9c5efe612456","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مبدأ اللقطة الأخيرة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في قانون العقود، بموجب قاعدة اللقطة الأخيرة، وافق الطرف ضمنيًا على العرض المضاد وبالتالي قبله من خلال سلوك يشير إلى عدم وجود اعتراض عليه.  حيث تكون آخر وثيقة تم إرسالها في التفاوض على العقد قبل الأداء هي الوثيقة النظامية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Last Shot Principle","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مبدأ اللقطة الأخيرة  Last Shot Principle","nonDiacriticsLemma":"مبدأ اللقطة الأخيرة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مبدأ اللقطة الأخيرة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0c22b7ae-a951-43b9-b914-691e39f0abf6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0c22b7ae-a951-43b9-b914-691e39f0abf6","word":"Pollyanna Principle","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bcd1","lexicalEntryId":"0c22b7ae-a951-43b9-b914-691e39f0abf6","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مبدأ بوليانا","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مبدأ بوليانا (يسمى أيضًا Pollyannaism أو التحيز الإيجابي) هو ميل الناس لتذكر العناصر الممتعة بشكل أكثر دقة من العناصر غير السارة.  أي تحيز نفسي، حيث يوجد ميل إلى المبالغة في تقييم الذكريات الإيجابية واستبعاد الذكريات السلبية. هذا هو السبب في أن الناس يمكن أن يتحدثوا عن أنفسهم في صفقات مبالغ فيها مع التقييمات السخيفة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Pollyanna Principle  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مبدأ بوليانا  Pollyanna Principle  ","nonDiacriticsLemma":"مبدأ بوليانا","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مبدأ بوليانا"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6394c333-6581-45ac-9746-c22b82f7a0cd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6394c333-6581-45ac-9746-c22b82f7a0cd","word":"The Ricardo Principle","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bcd2","lexicalEntryId":"6394c333-6581-45ac-9746-c22b82f7a0cd","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مبدأ ريكاردو","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في نظرية ريكاردو، التي كانت مبنية على نظرية العمل للقيمة (في الواقع، جعل العمل العامل الوحيد للإنتاج)، لم تكن حقيقة أن بلدًا ما يمكن أن ينتج كل شيء بشكل أكثر كفاءة من بلد آخر حجة ضد التجارة الدولية.  فهي تُعرف أيضًا باسم نظرية الميزة النسبية. نظرية التجارة الدولية، التي تنص على أن البلدان ستشتري سلعًا من بلد يمكنه إنتاجها اقتصاديًا أكثر مما يستطيع المنتجون المحليون، مما يقلل أو يلغي إنتاجه الخاص لتلك السلع وتحرير الموارد لاستخدامها في الإنتاج الذي يمكنه فعل المزيد بكفاءة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"The Ricardo Principle ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مبدأ ريكاردو  The Ricardo Principle ","nonDiacriticsLemma":"مبدأ ريكاردو","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مبدأ ريكاردو"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

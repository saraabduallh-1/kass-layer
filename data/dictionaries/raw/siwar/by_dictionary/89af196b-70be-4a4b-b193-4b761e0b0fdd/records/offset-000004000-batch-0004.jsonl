{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1f1a06f7-758a-4fd6-bbff-abf4dc699ab7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1f1a06f7-758a-4fd6-bbff-abf4dc699ab7","word":"Supplier Rating System","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be7a","lexicalEntryId":"1f1a06f7-758a-4fd6-bbff-abf4dc699ab7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نظام تصنيف الموردين","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يسلط النظام الضوء على نقاط القوة والضعف لكل مورد عبر مجالات متعددة، ويحدد مدى ملاءمة المورد لكل طلب محدد، مما يمكّن موظفيك من أن يصبحوا مشترين أكثر استراتيجية. يمكّنك نظام تصنيف الموردين من استخدام مؤشرات الأداء الرئيسية المكونة مسبقًا لتحليل أداء الموردين.  أي نظام التقارير الكمية و / أو النوعية أو المقاييس الأخرى المستخدمة لتحديد وقياس أداء المورد مقابل التدابير المتفق عليها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Supplier Rating System","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نظام تصنيف الموردين  Supplier Rating System","nonDiacriticsLemma":"نظام تصنيف الموردين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نظام تصنيف الموردين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

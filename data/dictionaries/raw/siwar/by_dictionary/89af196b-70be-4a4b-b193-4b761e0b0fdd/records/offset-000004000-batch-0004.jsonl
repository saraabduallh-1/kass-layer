{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b070d2b5-fc87-4ed4-a148-bac39cb5306a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b070d2b5-fc87-4ed4-a148-bac39cb5306a","word":"Quality Management System  (QMS)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be73","lexicalEntryId":"b070d2b5-fc87-4ed4-a148-bac39cb5306a","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نظام إدارة الجودة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظام إدارة الجودة (QMS) عبارة عن مجموعة من العمليات التجارية التي تركز على تلبية متطلبات العملاء باستمرار وتعزيز رضاهم. يتماشى مع هدف المنظمة والتوجه الاستراتيجي (ISO 9001: 2015).  أي انه نظام يتتبع ويسجل مستويات الجودة والقضايا. هذا من خلال إدخال العمليات أو الإجراءات أو الأنظمة (بما في ذلك أنظمة تكنولوجيا المعلومات)","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Quality Management System  (QMS)     ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نظام إدارة الجودة  Quality Management System  (QMS)     ","nonDiacriticsLemma":"نظام إدارة الجودة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نظام إدارة الجودة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6395e2e5-6266-49bd-a864-02222de49a9d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6395e2e5-6266-49bd-a864-02222de49a9d","word":"Transportation Management System","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be74","lexicalEntryId":"6395e2e5-6266-49bd-a864-02222de49a9d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نظام إدارة النقل ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نظام إدارة النقل (TMS) هو عبارة عن منصة لوجستية تستخدم التكنولوجيا لمساعدة الشركات على تخطيط وتنفيذ وتحسين الحركة المادية للبضائع، سواء الواردة والصادرة، والتأكد من توافق الشحنة، وتوفر الوثائق المناسبة.  وهذا ينسق جميع البضائع الواردة والصادرة. يهدف إلى نقل البضائع من المنشأ إلى الوجهة بدقة وفعالية من حيث التكلفة من خلال مرونة التخطيط والتنفيذ والمتابعة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Transportation Management System ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نظام إدارة النقل   Transportation Management System ","nonDiacriticsLemma":"نظام إدارة النقل ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نظام إدارة النقل "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/10b13320-af69-4d7c-a4dd-9691e5b5c5db/get-public-entry"},"browse_index_record":{"lexicalEntryId":"10b13320-af69-4d7c-a4dd-9691e5b5c5db","word":"Variance","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b83f","lexicalEntryId":"10b13320-af69-4d7c-a4dd-9691e5b5c5db","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تباين","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"هو الفرق بين النتيجة الفعلية المقاسة والأساس، مثل المبلغ المدرج في الميزانية. في العديد من التطبيقات المحاسبية، يعتبر التباين هو الفرق بين التكلفة الفعلية والتكلفة القياسية. ويتم استخدام تقارير الفروق للحفاظ على مستوى محكم من الرقابة على الأعمال التجارية، فهي الفرق بين المبلغ المدرج في الموازنة والإنفاق الفعلي","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Variance","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تباين  Variance","nonDiacriticsLemma":"تباين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تباين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

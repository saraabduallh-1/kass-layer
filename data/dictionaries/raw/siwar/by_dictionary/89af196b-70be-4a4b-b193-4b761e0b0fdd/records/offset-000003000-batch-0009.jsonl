{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c1f89f2f-03e8-47cf-acb7-7f7e4465c6d1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c1f89f2f-03e8-47cf-acb7-7f7e4465c6d1","word":"Limited (Ltd)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bcf7","lexicalEntryId":"c1f89f2f-03e8-47cf-acb7-7f7e4465c6d1","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"محدودة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يظهر المصطلح كلاحقة تتبع اسم الشركة، في إشارة إلى أنها شركة خاصة محدودة. في شركة محدودة المسؤولية، تقتصر مسؤولية المساهمين على رأس المال الذي استثمروه في الأصل. إذا أصبحت هذه الشركة معسرة، تظل الأصول الشخصية للمساهمين محمية. فالشركات المحدودة هي كيانات قانونية ويمكن أن يمتلكها عدة أشخاص؛ لا يتحمل المالكون المسؤولية الشخصية عن الخسائر المالية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Limited (Ltd)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"محدودة  Limited (Ltd)","nonDiacriticsLemma":"محدودة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"محدودة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

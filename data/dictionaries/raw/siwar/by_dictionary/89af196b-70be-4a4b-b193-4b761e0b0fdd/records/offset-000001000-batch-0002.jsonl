{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bd8e014f-d3c9-4b47-8ab0-5219aa956816/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bd8e014f-d3c9-4b47-8ab0-5219aa956816","word":"Pugh Analysis","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b87d","lexicalEntryId":"bd8e014f-d3c9-4b47-8ab0-5219aa956816","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تحليل بوغ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصفوفة تحليل Pugh هي أداة تحليل ينتج عنها مفهوم مثالي. يمكنك تحسين قائمة الأفكار باستخدام عملية قائمة على المصفوفة لوزن ومقارنة التصاميم المفاهيمية. على غرار الموالية مقابل السلبيات. تقييم خيارات متعددة مقابل خط الأساس. استخدم مصفوفة لمعالجة عدة عوامل.  أي انها أداة لتسهيل نهج قائم على الفريق يحول توقعات العملاء إلى عدد من الحلول المحتملة ثم يقيمها لاختيار الأفضل منها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Pugh Analysis  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تحليل بوغ  Pugh Analysis  ","nonDiacriticsLemma":"تحليل بوغ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تحليل بوغ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/13f03bc0-e682-4571-9956-957afe5f68fb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"13f03bc0-e682-4571-9956-957afe5f68fb","word":"Person Specification","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be47","lexicalEntryId":"13f03bc0-e682-4571-9956-957afe5f68fb","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مواصفات الشخص","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مواصفات الشخص هي وصف للمؤهلات والمهارات والخبرة والمعرفة والسمات الأخرى (معايير الاختيار) التي يجب أن يمتلكها المرشح لأداء واجبات الوظيفة. يجب أن تستمد المواصفات من الوصف الوظيفي وتشكل الأساس لعملية التوظيف.  أي وصف للمعرفة والمهارات والخبرة والمؤهلات التي يجب أن يمتلكها الفرد لأداء واجبات دور وظيفي معين بفعالية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":" Person Specification ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مواصفات الشخص   Person Specification ","nonDiacriticsLemma":"مواصفات الشخص","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مواصفات الشخص"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/db9521ae-06d5-4f10-87b4-895e36ca2bb0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"db9521ae-06d5-4f10-87b4-895e36ca2bb0","word":"Resources","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be48","lexicalEntryId":"db9521ae-06d5-4f10-87b4-895e36ca2bb0","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"موارد","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"في سياق الأعمال والاقتصاد، فإن المورد هو أي عامل ضروري لتحقيق هدف أو تنفيذ نشاط. باختصار، هي المكونات التي يحتاجها العمل من أجل القيام بأعمال تجارية. غالبًا ما تتضمن الموارد الموظفين أو مساحة العمل أو المعدات أو رأس المال.  أي انه مزيج من الموارد المالية والمواد والأصول ومهارات الموظفين أو الخبرة التي يمكن لأي شخص أو منظمة الاستفادة منها لإجراء العمليات أو إنجاز العمل","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Resources ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"موارد  Resources ","nonDiacriticsLemma":"موارد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"موارد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8525ef73-063d-43d8-a05c-3eddd811b8f4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8525ef73-063d-43d8-a05c-3eddd811b8f4","word":"Zero-Based Budget","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be49","lexicalEntryId":"8525ef73-063d-43d8-a05c-3eddd811b8f4","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"ميزانية صفرية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تعني الموازنة الصفرية إعداد الميزانية من خلال تبرير جميع النفقات والموافقة عليها لكل فترة محاسبية، بدلاً من الاعتماد على إنفاقك السابق. بالبدء من \"القاعدة الصفرية\" في بداية كل ميزانية، يمكنك إنشاء عملية فعالة حقًا لتحليل وتحديد مكان تخصيص أموالك. أي طريقة لوضع الميزانية يجب فيها تبرير كل حساب بدءًا من قاعدة الصفر","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Zero-Based Budget  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"ميزانية صفرية  Zero-Based Budget  ","nonDiacriticsLemma":"ميزانية صفرية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ميزانية صفرية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

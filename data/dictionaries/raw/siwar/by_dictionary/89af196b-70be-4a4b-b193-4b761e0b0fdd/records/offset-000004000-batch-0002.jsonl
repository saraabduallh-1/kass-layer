{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8343caf8-3038-4cef-b633-55eaf2858e8d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8343caf8-3038-4cef-b633-55eaf2858e8d","word":"Whole System Perspective","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be45","lexicalEntryId":"8343caf8-3038-4cef-b633-55eaf2858e8d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منظور تعددي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نهج الأنظمة هو منظور إداري يدعو إلى أن أي مشكلة عمل يجب أن ينظر إليها على أنها نظام ككل يتكون من تسلسل هرمي للأنظمة الفرعية. لذا فبدلاً من رؤية المشكلة في أجزاء يجب النظر إليها ككل. أي انه منظور يأخذ بعين الاعتبار السياق التنظيمي ككل","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Whole System Perspective ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منظور تعددي  Whole System Perspective ","nonDiacriticsLemma":"منظور تعددي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منظور تعددي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

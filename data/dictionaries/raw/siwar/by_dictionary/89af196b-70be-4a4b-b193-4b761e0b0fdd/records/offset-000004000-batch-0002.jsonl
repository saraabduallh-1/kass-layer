{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c4bb5616-4170-4025-a35f-0d326c6b60c7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c4bb5616-4170-4025-a35f-0d326c6b60c7","word":"Mintzberg’s Five Ps","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be4c","lexicalEntryId":"c4bb5616-4170-4025-a35f-0d326c6b60c7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مينتزبيرج الخمسة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ما هي العناصر الخمسة للاستراتيجية؟ في عام 1987، ميز عالم الإدارة الكندي هنري مينتزبيرج خمس رؤى لاستراتيجية المنظمات. يسميهم 5 للاستراتيجية. إنها تمثل الخطة والنمط والموقف والمنظور والحيلة. إن العناصر الخمسة لتطوير الاستراتيجية هي المبادئ التي طورها هنري مينتزبرج لشرح عملية تطوير الاستراتيجية. هم خطة، حيلة، نمط، موقف ومنظور","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Mintzberg’s Five Ps","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مينتزبيرج الخمسة  Mintzberg’s Five Ps","nonDiacriticsLemma":"مينتزبيرج الخمسة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مينتزبيرج الخمسة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

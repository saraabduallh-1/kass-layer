{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/02c306ec-1ba7-4872-bb09-2ac5b41110e1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"02c306ec-1ba7-4872-bb09-2ac5b41110e1","word":"Preferred Suppliers","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be3e","lexicalEntryId":"02c306ec-1ba7-4872-bb09-2ac5b41110e1","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"موردين مفضلين ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قائمة الموردين أو الموردين المفضلين هي سجل للموردين الذين تم تقييمهم مسبقًا والمتفق عليهم والذين سيستخدمهم عملك لشراء السلع والخدمات منهم. ستضمن عملية التقييم دعم الموردين المفضلين لديك لأهداف مؤسستك وأهدافها للنمو والنجاح.   وتعرف ايضاً المتعاقدون أو البائعون الذين يقدمون شروط تداول مواتية أو عناصر مرغوبة بشدة للأعمال التجارية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Preferred Suppliers","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"موردين مفضلين   Preferred Suppliers","nonDiacriticsLemma":"موردين مفضلين ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"موردين مفضلين "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/84f7ec6d-80ae-4404-9810-0c4a1d58d4f7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"84f7ec6d-80ae-4404-9810-0c4a1d58d4f7","word":"Mission","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be3f","lexicalEntryId":"84f7ec6d-80ae-4404-9810-0c4a1d58d4f7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مهمة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"المهمة هي الغرض الأساسي لمنظمة أو شركة. إنه ملخص للأهداف والقيم الأساسية. تخبرك المهمة بوضوح ما تفعله كمؤسسة للعملاء. المهمة شاملة ولكنها أيضًا محددة جدًا لتمييزك عن المنظمات الأخرى. يمكن اعتبار المهمة أداة رائعة لتطوير أهداف وغايات العمل باستخدامها. يجب أن تتناسب المهمة مع هويتك. إذا لم يكن الأمر كذلك، فمن الصعب جدًا تنفيذ مهمتك الغرض او الهدف من المنظمة. هذا يحدد ما تفعله المنظمة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Mission","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"مهمة  Mission","nonDiacriticsLemma":"مهمة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مهمة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

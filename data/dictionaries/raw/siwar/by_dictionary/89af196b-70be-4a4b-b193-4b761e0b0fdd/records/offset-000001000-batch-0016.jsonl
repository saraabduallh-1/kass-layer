{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/269a0ff9-5e72-463c-b4d0-c2ae56040b4d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"269a0ff9-5e72-463c-b4d0-c2ae56040b4d","word":"Organizational Culture","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b9cb","lexicalEntryId":"269a0ff9-5e72-463c-b4d0-c2ae56040b4d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"ثقافة تنظيمية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تحدد ثقافة المنظمة الطريقة الصحيحة للتصرف داخل المنظمة. تتكون هذه الثقافة من معتقدات وقيم مشتركة أنشأها القادة ثم يتم توصيلها وتعزيزها من خلال طرق مختلفة، مما يؤدي في النهاية إلى تشكيل تصورات الموظف وسلوكياته وفهمه.  أي القيم والسلوكيات، التي تنشأ مع مرور الوقت، تشكل البيئة الاجتماعية والنفسية للمؤسسة. لخصت بشكل غير رسمي على أنها \"الطريقة التي نؤدي بها الأشياء هنا\".","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Organizational Culture ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"ثقافة تنظيمية  Organizational Culture ","nonDiacriticsLemma":"ثقافة تنظيمية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ثقافة تنظيمية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

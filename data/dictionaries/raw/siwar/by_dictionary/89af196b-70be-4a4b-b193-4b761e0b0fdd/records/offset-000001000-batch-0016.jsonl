{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/159160ec-c080-49f3-a113-9c3b43087bc4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"159160ec-c080-49f3-a113-9c3b43087bc4","word":"Medium-Context Culture","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b9c8","lexicalEntryId":"159160ec-c080-49f3-a113-9c3b43087bc4","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"ثقافة السياق المتوسط","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تبحث الثقافات ذات السياق العالي عن معنى من الإشارات والإشارات غير المعلنة في سياق الاتصال. ويعتمد التواصل على لغة \"مشفرة\" مشتركة مفهومة من قبل المجموعة، مع الاعتماد على التواصل غير اللفظي، مثل تعبيرات الوجه والإيماءات، لنقل المعنى.  فهي الثقافات التي لم يتم تصنيفها على أنها ذات سياق منخفض أو مرتفع ولكن بدلاً من ذلك لديها مزيج من المفاهيم المتداخلة بين ثقافتي السياق","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Medium-Context Culture","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"ثقافة السياق المتوسط  Medium-Context Culture","nonDiacriticsLemma":"ثقافة السياق المتوسط","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ثقافة السياق المتوسط"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

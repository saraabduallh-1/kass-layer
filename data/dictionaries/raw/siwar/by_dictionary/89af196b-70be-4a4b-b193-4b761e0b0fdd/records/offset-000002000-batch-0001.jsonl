{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/09010f87-14d5-439f-9768-3570fe915689/get-public-entry"},"browse_index_record":{"lexicalEntryId":"09010f87-14d5-439f-9768-3570fe915689","word":"Privatization","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba3d","lexicalEntryId":"09010f87-14d5-439f-9768-3570fe915689","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خصخصة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الخصخصة هي عملية نقل مؤسسة أو صناعة من القطاع العام إلى القطاع الخاص. القطاع العام هو جزء من النظام الاقتصادي الذي تديره الوكالات الحكومية.  أي نقل ملكية والتحكم في عمل أو خدمة من هيئة عامة إلى شركة خاصها الاستيلاء عليها من قبل مستثمر خاص وتشغيلها كشركة محدودة أو عامة محدودة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Privatization   ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"خصخصة  Privatization   ","nonDiacriticsLemma":"خصخصة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خصخصة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

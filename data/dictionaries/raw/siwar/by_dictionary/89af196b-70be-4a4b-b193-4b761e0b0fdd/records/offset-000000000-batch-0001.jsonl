{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/077f7edc-642f-4969-96fa-d7df9e0eb8a3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"077f7edc-642f-4969-96fa-d7df9e0eb8a3","word":"(NDA) Non-Disclosure Agreement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b65f","lexicalEntryId":"077f7edc-642f-4969-96fa-d7df9e0eb8a3","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"اتفاقية عدم الإفشاء ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عقد ملزم قانونًا يؤسس علاقة سرية. يوافق الطرف أو الأطراف الموقعة على الاتفاقية على أن المعلومات الحساسة التي قد يحصلون عليها لن تكون متاحة لأي شخص آخر. يمكن أيضًا الإشارة إلى اتفاقية عدم الإفشاء باسم اتفاقية السرية. أي انه اتفاق بين طرفين أو أكثر للاتفاق على عدم الكشف عن أي معلومات تتعلق بمشروع أو عقد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"(NDA) Non-Disclosure Agreement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"اتفاقية عدم الإفشاء   (NDA) Non-Disclosure Agreement","nonDiacriticsLemma":"اتفاقية عدم الإفشاء ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اتفاقية عدم الإفشاء "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

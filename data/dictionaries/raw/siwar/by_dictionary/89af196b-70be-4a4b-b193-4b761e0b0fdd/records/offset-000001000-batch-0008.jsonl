{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8d959f0f-0e7e-48ef-89bb-0a840b1ad208/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8d959f0f-0e7e-48ef-89bb-0a840b1ad208","word":"تعاون","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"68f89df11c18772c6cf4b906","lexicalEntryId":"8d959f0f-0e7e-48ef-89bb-0a840b1ad208","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تعاون","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الابتكار في الأعمال هو عملية المنظمة لتقديم أفكار جديدة، أو تدفقات العمل، أو المنهجيات، أو الخدمات أو المنتجات.  حيث تمتلك الشركات المبتكرة أفكارًا جديدة ومثيرة من المرجح أن تجتذب استثمار رأس المال الاستثماري. يشير ابتكار المنتج إلى منتجات جديدة أو محسّنة بشكل ملحوظ. يمكن أن يشمل الابتكار صنع نفس المنتج بمكونات أفضل أو منتج جديد أكثر سهولة في الاستخدام فهو التحديد والتطورات المطلوبة لتأمين تحسينات الأعمال أو الميزة التنافسية باستخدام أفكار جديدة أو طرق عمل جديدة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Innovation","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تعاون  Innovation","nonDiacriticsLemma":"تعاون","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تعاون"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/01152d8e-55ff-4347-80a7-cabe96085182/get-public-entry"},"browse_index_record":{"lexicalEntryId":"01152d8e-55ff-4347-80a7-cabe96085182","word":"Collaboration","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b907","lexicalEntryId":"01152d8e-55ff-4347-80a7-cabe96085182","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تعاوني","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"العمل مع طرف آخر (أو أطراف متعددة) من أجل المنفعة المتبادلة، أي أن كلا الطرفين قادر على تحقيق أهداف كل منهما والتعاون يعرف أيضا بأنه ممارسة عمل حيث يعمل الأفراد معًا لغرض مشترك لتحقيق فائدة الأعمال. يتيح التعاون للأفراد العمل معًا لتحقيق غرض عمل محدد ومشترك.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":" Collaboration","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تعاوني   Collaboration","nonDiacriticsLemma":"تعاوني","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تعاوني"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4edc84cd-293c-49ba-830a-2b1e924075e7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4edc84cd-293c-49ba-830a-2b1e924075e7","word":"Cross-Functional Collaboration","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b908","lexicalEntryId":"4edc84cd-293c-49ba-830a-2b1e924075e7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تعاون متعدد الوظائف","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التعاون متعدد الوظائف هو العملية التي يجتمع فيها أفراد من أقسام مختلفة في مؤسسة ذات مجالات خبرة مختلفة لتحقيق هدف مشترك. يمكن أن يكون هذا التعاون عضويًا أو قائمًا على المشروع. او هو مجموعة من الأشخاص ذوي المهارات والتخصصات المختلفة يجتمعون معًا لتحقيق هدف مشترك","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Cross-Functional Collaboration","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"التعاون متعدد الوظائف هو عندما يتحد أفراد من فرق أو وظائف مختلفة (التسويق، المبيعات، الهندسة، الموارد البشرية) داخل الشركة للعمل على هدف أو مشروع أو مسؤولية مشتركة. ويعرف كذلك بالاستفادة من خبرة المجموعات والأفراد من الوظائف التنظيمية الداخلية بالشركة ذات الصلة وشركاء التوريد الخارجيين لمن جانب آخر لتقديم تطوير منتج / خدمة جديدة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Cross-Functional Involvement  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تعاون متعدد الوظائف  Cross-Functional Collaboration Cross-Functional Involvement  ","nonDiacriticsLemma":"تعاون متعدد الوظائف","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تعاون متعدد الوظائف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

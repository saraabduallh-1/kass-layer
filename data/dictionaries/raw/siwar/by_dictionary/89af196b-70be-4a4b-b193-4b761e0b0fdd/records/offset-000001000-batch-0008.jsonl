{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/26aeea46-20da-4290-8566-a0a72fc6a472/get-public-entry"},"browse_index_record":{"lexicalEntryId":"26aeea46-20da-4290-8566-a0a72fc6a472","word":"Delegation Evolution","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8fe","lexicalEntryId":"26aeea46-20da-4290-8566-a0a72fc6a472","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تطور التفويض","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تتطلع الشركات إلى تطوير استراتيجيات مختلفة لرفع مستوى مشاركة الموظفين. فالتفويض في حد ذاته هو استراتيجية مؤثرة لتحديد معظم المربعات المناسبة للأداء العالي. وغالبًا ما تتداول بشأن الصيغ العملية لزيادة إنتاجية فريقك. فهي تعبر عن المرحلة الثالثة من نمو المؤسسة وتتميز بوجود مدراء من المستوى الأدنى يتحملون مسؤولية متزايدة وكبار المديرين التنفيذيين اللذين يديرون عن طريق الاستثناء","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Delegation Evolution","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تطور التفويض  Delegation Evolution","nonDiacriticsLemma":"تطور التفويض","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تطور التفويض"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

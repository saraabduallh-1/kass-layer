{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/904899f2-cb9e-484d-aa46-c1acd454b5a2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"904899f2-cb9e-484d-aa46-c1acd454b5a2","word":"Risk Exposure","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b90a","lexicalEntryId":"904899f2-cb9e-484d-aa46-c1acd454b5a2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تعرض للخطر","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التعرض للمخاطر هو الخسارة المحتملة المقدرة من الأنشطة التجارية الجارية حاليًا أو المخطط لها. عادة ما يتم حساب مستوى التعرض بضرب احتمال وقوع حادث خطر بمقدار خسائره المحتملة.  أي انه مقياس الخسارة المستقبلية المحتملة الناشئة من المخاطر","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Risk Exposure ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تعرض للخطر  Risk Exposure ","nonDiacriticsLemma":"تعرض للخطر","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تعرض للخطر"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/59a7eb28-92c8-4f7c-a856-ebeaca39aaa5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"59a7eb28-92c8-4f7c-a856-ebeaca39aaa5","word":"IDEF (Integrated Definition Or Integrated Program)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b90b","lexicalEntryId":"59a7eb28-92c8-4f7c-a856-ebeaca39aaa5","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تعريف متكامل أو برنامج متكامل","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشير إلى عائلة من لغات النمذجة في مجال الأنظمة وهندسة البرمجيات. وهي تغطي مجموعة واسعة من الاستخدامات، من النمذجة الوظيفية إلى البيانات والمحاكاة والتحليل / التصميم الموجه للكائنات واكتساب المعرفة. تم تطوير لغات التعريف هذه بتمويل من القوات الجوية الأمريكية وتستخدم بشكل كبير من قبلهم، بالإضافة إلى الوكالات العسكرية ووزارة الدفاع الأمريكية (Dod) الأخرى، كما يتم استخدامها من قبل العديد من الشركات لالتقاط وتحسين العمليات التجارية.   فهو برنامج يستخدم للحصول على معرفة الموردين عبر سلسلة التوريد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"IDEF (Integrated Definition Or Integrated Program)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تعريف متكامل أو برنامج متكامل  IDEF (Integrated Definition Or Integrated Program)","nonDiacriticsLemma":"تعريف متكامل أو برنامج متكامل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تعريف متكامل أو برنامج متكامل"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

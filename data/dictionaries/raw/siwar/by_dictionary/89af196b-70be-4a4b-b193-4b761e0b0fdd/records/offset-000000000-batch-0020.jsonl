{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/33e78818-1d23-4a9f-8039-ad8680504278/get-public-entry"},"browse_index_record":{"lexicalEntryId":"33e78818-1d23-4a9f-8039-ad8680504278","word":"Spillover Effect","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b831","lexicalEntryId":"33e78818-1d23-4a9f-8039-ad8680504278","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تأثير غير مباشر","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو عندما يكون لحدث ما في بلد ما تأثير مضاعف على اقتصاد بلد آخر، عادة ما يكون أكثر اعتمادًا. يمكن أن تنتج الآثار غير المباشرة عن تراجع سوق الأسهم مثل الركود العظيم في عام 2008، أو الأحداث الكلية مثل كارثة فوكوشيما في عام 2011. أي تأثير على مكونات أو أحداث تبدو غير ذات صلة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Spillover Effect","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تأثير غير مباشر  Spillover Effect","nonDiacriticsLemma":"تأثير غير مباشر","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تأثير غير مباشر"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/08ad5472-bb1f-48a3-928b-8234929b849f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"08ad5472-bb1f-48a3-928b-8234929b849f","word":"Institutional Investors","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd50","lexicalEntryId":"08ad5472-bb1f-48a3-928b-8234929b849f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مستثمرين مؤسسيين","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المستثمر المؤسسي هو شركة أو منظمة تستثمر الأموال نيابة عن العملاء أو الأعضاء. صناديق التحوط وصناديق الاستثمار المشتركة والأوقاف هي أمثلة على المستثمرين المؤسسيين. يُعتبر المستثمرون المؤسسون أكثر ذكاءً من المستثمر العادي وغالبًا ما يخضعون لرقابة تنظيمية أقل.  وتعرف بأنها البنوك وشركات التأمين وصناديق التحوط ومستشارو الاستثمار الذين يهدفون إلى تجميع الأموال لشراء الأوراق المالية أو الأصول الاستثمارية أو الممتلكات العقارية أو إنشاء قروض","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Institutional Investors","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مستثمرين مؤسسيين  Institutional Investors","nonDiacriticsLemma":"مستثمرين مؤسسيين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مستثمرين مؤسسيين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9b43571e-197d-4a8b-97ae-ad5841e156ea/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9b43571e-197d-4a8b-97ae-ad5841e156ea","word":"Warehouse","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd51","lexicalEntryId":"9b43571e-197d-4a8b-97ae-ad5841e156ea","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مستودع","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"التخزين هو عملية تخزين البضائع التي سيتم بيعها أو توزيعها لاحقًا. في حين أن الأعمال التجارية الصغيرة التي تعتمد على المنزل قد تقوم بتخزين المنتجات في غرفة احتياطية أو قبو أو مرآب، فإن الشركات الكبيرة عادة ما تمتلك أو تستأجر مساحة في مبنى مصمم خصيصًا للتخزين.  أي منشأة تخزين كبيرة الحجم -يمكن أن تكون \"قائمة بذاتها\" (على سبيل المثال، غير مرتبطة بالتصنيع أو التجميع أو البيع بالتجزئة) أو \"متكاملة\" (على سبيل المثال، يتم استخدام المنتجات أو بيعها بالتجزئة في نفس الموقع)","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Warehouse ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"مستودع  Warehouse ","nonDiacriticsLemma":"مستودع","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مستودع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

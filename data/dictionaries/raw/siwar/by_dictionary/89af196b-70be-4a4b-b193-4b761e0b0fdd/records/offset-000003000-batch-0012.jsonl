{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0f580d95-02be-4119-b31f-f7bb0bb9e502/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0f580d95-02be-4119-b31f-f7bb0bb9e502","word":"Memorandum Of Understanding (MOU)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd44","lexicalEntryId":"0f580d95-02be-4119-b31f-f7bb0bb9e502","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مذكرة تفاهم","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مذكرة التفاهم هي اتفاق بين طرفين أو أكثر موضحة في وثيقة رسمية. إنه ليس ملزمًا قانونًا ولكنه يشير إلى استعداد الأطراف للمضي قدمًا في العقد. يمكن النظر إلى مذكرة التفاهم على أنها نقطة انطلاق للمفاوضات لأنها تحدد نطاق وهدف المحادثات. أي انها وثيقة تحدد الاتفاق الذي توصل إليه طرفان أو أكثر","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Memorandum Of Understanding (MOU)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مذكرة تفاهم  Memorandum Of Understanding (MOU)","nonDiacriticsLemma":"مذكرة تفاهم","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مذكرة تفاهم"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5431651d-9be4-4f18-982a-62d6ee6fc5a1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5431651d-9be4-4f18-982a-62d6ee6fc5a1","word":"Code Of Practice (CoP)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd45","lexicalEntryId":"5431651d-9be4-4f18-982a-62d6ee6fc5a1","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مدونة الممارسات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي مجموعة من القواعد المقيدة تشرح كيفية التصرف من قبل الأشخاص الذين يعملون في مهنة معينة. وترتبط أحيانًا بمهن معينة، وتحدد مدونة ممارسات (COP) المسئولية الأخلاقية وحقوق الإنسان والممارسات الاجتماعية والبيئية التي يجب على جميع العاملين بالشركة أو المنظمة الالتزام بها. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Code Of Practice (CoP)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مدونة الممارسات  Code Of Practice (CoP)","nonDiacriticsLemma":"مدونة الممارسات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مدونة الممارسات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f26b69c4-8935-4ed2-b260-49a6407bfda7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f26b69c4-8935-4ed2-b260-49a6407bfda7","word":"Lucrative","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd46","lexicalEntryId":"f26b69c4-8935-4ed2-b260-49a6407bfda7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مربح","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الربح، ويمكن استخدامه لوصف أي مشروع أو نشاط لديه القدرة على كسب المال. وبالتالي، يعتبر الاستثمار أو المشروع التجاري مربحًا إذا كان ينتج ثروة كبيرة.  مربح جدا","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Lucrative","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"مربح  Lucrative","nonDiacriticsLemma":"مربح","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مربح"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4d12b004-8024-4556-989f-f53822861de4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4d12b004-8024-4556-989f-f53822861de4","word":"Gate Review","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd47","lexicalEntryId":"4d12b004-8024-4556-989f-f53822861de4","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مراجعة البوابة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تعطي مراجعات البوابة رؤية الإدارة لتقدم المشروع حتى الآن، والتغييرات منذ البوابة الأخيرة، وخطة مدير المشروع على المدى القريب. في هذه المرحلة، قد تسمح الإدارة للمشروع بالمضي قدمًا أو تأخير أو تغيير أو إلغاء المشروع قبل تنفيذ المزيد من العمل.  فهي تقنية تقسيم المشروع إلى مراحل تفصل بينها \"بوابات\". تنتقل المشاريع إلى المرحلة التالية إذا تم استيفاء المعايير المتفق عليها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Gate Review","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مراجعة البوابة  Gate Review","nonDiacriticsLemma":"مراجعة البوابة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مراجعة البوابة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6b2feba5-c93e-486c-bce0-f6ce26519e60/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6b2feba5-c93e-486c-bce0-f6ce26519e60","word":"Control","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd48","lexicalEntryId":"6b2feba5-c93e-486c-bce0-f6ce26519e60","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مراقبة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"هي كافة الأنشطة الرقابية والإجراءات التي تتخذها المنظمات لإعادة خطة العمل إلى مسارها الصحيح حيث يمكن أن تتمثل في شكل مدخلات، مثل تعيين موظفين إضافيين، وإدخال تقنيات جديدة بالشركة، والاستعانة بمصادر خارجية، وتدريب الموظفين، وتوفير العمل الإضافي، وما إلى ذلك. وتتضمن التحكم في إعداد الأعمال، أو التحكم التنظيمي، العمليات والإجراءات التي تنظم وتوجه وتحمي المؤسسة. إنها واحدة من أربع وظائف إدارية أساسية، جنبًا إلى جنب مع التخطيط والتنظيم والقيادة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Control ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"المراقبة هي عملية منهجية لجمع المعلومات وتحليلها واستخدامها لتتبع تقدم البرنامج نحو تحقيق أهدافه وتوجيه قرارات الإدارة.  أي مجموعة من الأنشطة التي تتم بهدف مقارنة الأداء الحالي بالمعيار","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Monitoring","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"rela
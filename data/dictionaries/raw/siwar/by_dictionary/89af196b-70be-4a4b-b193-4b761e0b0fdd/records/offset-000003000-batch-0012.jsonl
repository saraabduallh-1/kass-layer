{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a1664322-e77e-4f69-86df-a2a2e6f00896/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a1664322-e77e-4f69-86df-a2a2e6f00896","word":"Operating Supplies","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd53","lexicalEntryId":"a1664322-e77e-4f69-86df-a2a2e6f00896","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مستلزمات التشغيل","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مستلزمات التشغيل تعني المواد الاستهلاكية التي يستخدمها مدير الممتلكات أو موظفوه في تشغيل الممتلكات، بما في ذلك المصابيح الكهربائية ولوازم التنظيف والبطاريات ومرشحات الأفران والمواد الكيميائية الخاصة بأحواض السباحة والعناصر الأخرى ذات الطبيعة المماثلة.  أي العناصر المطلوبة لتشغيل المعدات بشكل روتيني. سيشمل هذا عادةً زيت التشحيم ومنتجات التنظيف ولكنه لن يكون مخزونًا تقليديًا من نوع المواد والذي يشكل جزءًا من المنتج النهائي. غالبًا ما يتم تضمينها ضمن مصطلح \"مستلزمات إصلاح الصيانة والتشغيل\" (MRO)","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Operating Supplies","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مستلزمات التشغيل  Operating Supplies","nonDiacriticsLemma":"مستلزمات التشغيل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مستلزمات التشغيل"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e73f533b-b6e9-4dae-92ae-7f298ccd7562/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e73f533b-b6e9-4dae-92ae-7f298ccd7562","word":"Warehouse","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd54","lexicalEntryId":"e73f533b-b6e9-4dae-92ae-7f298ccd7562","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مستودع البيانات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مستودع البيانات هو نوع من أنظمة إدارة البيانات مصمم لتمكين ودعم أنشطة ذكاء الأعمال تحليل الأعمال (BI)Business Intellegence، وخاصة التحليلات. حيث تهدف مستودعات البيانات فقط إلى إجراء الاستعلامات والتحليل وغالبًا ما تحتوي على كميات كبيرة من البيانات التاريخية.  وتُعرف أيضًا باسم مستودع بيانات المؤسسة، وهي قاعدة بيانات ضخمة تحتوي على بيانات مخزنة من مجموعة واسعة من المصادر وهي مصممة لاتخاذ القرارات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Warehouse","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مستودع البيانات  Warehouse","nonDiacriticsLemma":"مستودع البيانات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مستودع البيانات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

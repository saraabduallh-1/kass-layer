{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5f2643e1-0415-408b-a97d-7a1338fef5f0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5f2643e1-0415-408b-a97d-7a1338fef5f0","word":"Touchpoints","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be93","lexicalEntryId":"5f2643e1-0415-408b-a97d-7a1338fef5f0","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نقاط التواصل ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"(نقطة اتصال أو نقطة اتصال أو نقطة اتصال) هي المصطلحات التجارية لأي لقاء يشترك فيه العملاء والشركات لتبادل المعلومات أو تقديم الخدمة أو التعامل مع المعاملات.  أي نقطة الاتصال هي أي وقت يتصل فيه عميل أو عميل محتمل بعلامتك التجارية قبل أو أثناء أو بعد شراء شيء منك. ويعرف ايضاً بأنه نقاط على طول سلسلة التوريد حيث يحدث شيء له تأثير على التكلفة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Touchpoints ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نقاط التواصل   Touchpoints ","nonDiacriticsLemma":"نقاط التواصل ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نقاط التواصل "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/462ce476-f2c5-4848-980a-6e9f6e26298e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"462ce476-f2c5-4848-980a-6e9f6e26298e","word":"Trade Unions","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be94","lexicalEntryId":"462ce476-f2c5-4848-980a-6e9f6e26298e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نقابات عمالية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النقابة العمالية هي منظمة تتكون من أعضاء (منظمة قائمة على العضوية) ويجب أن تتكون عضويتها بشكل أساسي من العمال. يتمثل أحد الأهداف الرئيسية للنقابة في حماية وتعزيز مصالح أعضائها في مكان العمل. معظم النقابات العمالية مستقلة عن أي صاحب عمل.  أي المنظمات القائمة على العضوية المكونة من العاملين في أماكن العمل. النقابات العمالية مستقلة عن أصحاب العمل وهدف النقابات العمالية هو حماية وتعزيز مصالح أعضائها في مكان العمل","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Trade Unions ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نقابات عمالية  Trade Unions ","nonDiacriticsLemma":"نقابات عمالية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نقابات عمالية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

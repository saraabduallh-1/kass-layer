{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3f6669d1-ce64-4da1-a458-f2a35267bdb0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3f6669d1-ce64-4da1-a458-f2a35267bdb0","word":"Reorder Point","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be98","lexicalEntryId":"3f6669d1-ce64-4da1-a458-f2a35267bdb0","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نقطة إعادة الترتيب","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نقطة إعادة الطلب (ROP) هي مستوى محدد يحتاج فيه مخزونك إلى التجديد. بمعنى آخر، يخبرك بموعد تقديم طلب حتى لا ينفد المخزون.  أي انها النقطة إما في الوقت المناسب أو في العملية التي يجب فيها تقديم الطلب التالي","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Reorder Point","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نقطة إعادة الترتيب  Reorder Point","nonDiacriticsLemma":"نقطة إعادة الترتيب","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نقطة إعادة الترتيب"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0691e81e-bde6-4c19-b232-5a9ec9a701b2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0691e81e-bde6-4c19-b232-5a9ec9a701b2","word":"Capital Expenditure (CAPEX)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be99","lexicalEntryId":"0691e81e-bde6-4c19-b232-5a9ec9a701b2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نفقات رأسمالية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي الأموال التي يتم إنفاقها للحصول على الأصول الثابتة التي تم شراؤها من قبل المنظمة والمحافظة عليها والتي يتم استخدامها داخل المنظمة بدلاً من شراؤها لإعادة البيع. (عادةً ما تكون هذه الأصول هي الأراضي والمباني والمعدات)، وتعرف أيضا بالنفقات الرأسمالية (Capex) عبارة عن دفعة مقابل سلع أو خدمات مسجلة في الميزانية العمومية بدلاً من إنفاقها على بيان الدخل. والإنفاق الرأسمالي مهم للشركات للحفاظ على الممتلكات والمعدات الحالية، والاستثمار في التكنولوجيا الجديدة والأصول الأخرى من أجل النمو. وهي الأموال المستخدمة في شراء الممتلكات أو تحديثها أو إصلاحها. كما يشمل اقتناء معدات للممتلكات المذكورة. وتعتبر النفقات نفقات رأسمالية إذا كانت عملية شراء جديدة أو تطيل من عمر العقار او المنشأة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Capital Expenditure (CAPEX)  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نفقات رأسمالية  Capital Expenditure (CAPEX)  ","nonDiacriticsLemma":"نفقات رأسمالية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نفقات رأسمالية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

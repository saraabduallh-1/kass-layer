nguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/acc2094e-1ed2-4a37-9ed5-337af9421713/get-public-entry"},"browse_index_record":{"lexicalEntryId":"acc2094e-1ed2-4a37-9ed5-337af9421713","word":"Operating Expenditure (OPEX)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be8a","lexicalEntryId":"acc2094e-1ed2-4a37-9ed5-337af9421713","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نفقات تشغيلية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"النفقات التشغيلية (OPEX) هي الأموال التي تنفقها الشركة على أساس يومي مستمر من أجل إدارة عمل أو نظام. اعتمادًا على الصناعة، يمكن أن تتراوح هذه النفقات من الحبر المستخدم لطباعة المستندات إلى الأجور المدفوعة للموظفين. أي انها تكاليف التشغيل الجارية، مثل الرواتب والإيجارات في أماكن العمل. أيضا نفقات التشغيل هي مصروفات تتكبدها الشركة من خلال عملياتها التجارية العادية. غالبًا ما يتم اختصارها على أنها OPEX، تشمل مصاريف التشغيل الإيجار والمعدات وتكاليف المخزون والتسويق وكشوف المرتبات والتأمين وتكاليف الخطوة والأموال المخصصة للبحث والتطوير.  أي تكاليف إدارة الأعمال التشغيلية، بما في ذلك الإيجارات والأسعار والمرافق والتأمينات والعمالة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":" Operating Expenditure (OPEX) ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نفقات تشغيلية   Operating Expenditure (OPEX) ","nonDiacriticsLemma":"نفقات تشغيلية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نفقات تشغيلية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

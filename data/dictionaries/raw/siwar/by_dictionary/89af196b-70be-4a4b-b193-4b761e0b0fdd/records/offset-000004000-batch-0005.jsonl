{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/277cb499-5c6d-4d80-9157-0248c558a106/get-public-entry"},"browse_index_record":{"lexicalEntryId":"277cb499-5c6d-4d80-9157-0248c558a106","word":"Backhaul","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be9e","lexicalEntryId":"277cb499-5c6d-4d80-9157-0248c558a106","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نقل بالمواصلات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي الحمولة التي تحصل عليها شركة النقل أو مؤسسة النقل (مثل الشاحنة والسفينة) من السوق في رحلة العودة ومن ثم جني الأموال من وجهتها وإليها. وتبرز مشكلة التوصيل عندما يكون هناك عدم توازن في تدفقات النقل بين المواقع. بشكل عام، ينخفض ما يسمى بسعر التوصيل إلى الصفر عندما يكون الخلل كبيرًا بما يكفي وتعود الشاحنة أو السفينة إلى منشئها فارغًا","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Backhaul","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نقل بالمواصلات  Backhaul","nonDiacriticsLemma":"نقل بالمواصلات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نقل بالمواصلات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/477f2250-6bc6-4db8-befe-2f04d2614729/get-public-entry"},"browse_index_record":{"lexicalEntryId":"477f2250-6bc6-4db8-befe-2f04d2614729","word":"Saturation Point","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be9f","lexicalEntryId":"477f2250-6bc6-4db8-befe-2f04d2614729","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نقطة تشبع السوق","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ما هو تشبع السوق؟ ينشأ تشبع السوق عندما يتم تكبير حجم منتج أو خدمة في السوق. عند نقطة التشبع، لا يمكن للشركة تحقيق مزيد من النمو إلا من خلال تحسينات المنتج الجديدة عن طريق أخذ حصة السوق الحالية من المنافسين أو زيادة الطلب الإجمالي للمستهلكين.  أي النقطة التي لا يمكن عندها للموردين الجدد الانضمام أو زيادة وجودهم في السوق دون تقليل أنشطة قائمة الموردين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Saturation Point  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نقطة تشبع السوق  Saturation Point  ","nonDiacriticsLemma":"نقطة تشبع السوق","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نقطة تشبع السوق"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

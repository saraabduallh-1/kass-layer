{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1e3b225a-c5bf-4365-8687-e061725e8f17/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1e3b225a-c5bf-4365-8687-e061725e8f17","word":"Benchmarking","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bdbd","lexicalEntryId":"1e3b225a-c5bf-4365-8687-e061725e8f17","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مقارنة معيارية تنافسية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي طريقة مقارنة مجموعة من المعايير مع عدد من الشركات المنافسة، تستخدم لقياس الأداء، مقاييس المقارنة المعيارية التنافسية أين وكيف تقف مؤسستك ضد منافسيك. باستخدام مجموعة من المقاييس المحددة مسبقًا، تتيح لك المقارنة المعيارية مقارنة أداء شركتك مقابل منافسيك والعلامات التجارية الأخرى الأفضل في فئتها. فمقاييس المقارنة المعيارية التنافسية تدرس أين وكيف تقف مؤسستك ضد منافسيك. باستخدام مجموعة من المقاييس المحددة مسبقًا، تتيح لك المقارنة المعيارية مقارنة أداء شركتك مقابل منافسيك والعلامات التجارية الأخرى الأفضل في فئتها.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Benchmarking","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مقارنة معيارية تنافسية  Benchmarking","nonDiacriticsLemma":"مقارنة معيارية تنافسية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مقارنة معيارية تنافسية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/79ef8d15-a47e-44f2-9da7-dd3254d3e4b1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"79ef8d15-a47e-44f2-9da7-dd3254d3e4b1","word":"Penetration Pricing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8c9","lexicalEntryId":"79ef8d15-a47e-44f2-9da7-dd3254d3e4b1","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تسعير الاختراق","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تسعير الاختراق هو استراتيجية تسويقية تستخدمها الشركات لجذب العملاء إلى منتج أو خدمة جديدة من خلال تقديم سعر أقل خلال عرضها الأولي. يساعد السعر المنخفض منتجًا أو خدمة جديدة على اختراق السوق وجذب العملاء بعيدًا عن المنافسين.  في البداية، تم تعيين السعر المنخفض لجذب نسبة كبيرة من السوق. عندما يتم تحديد الحصة السوقية، يمكن بعد ذلك زيادة السعر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Penetration Pricing ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تسعير الاختراق  Penetration Pricing ","nonDiacriticsLemma":"تسعير الاختراق","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تسعير الاختراق"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

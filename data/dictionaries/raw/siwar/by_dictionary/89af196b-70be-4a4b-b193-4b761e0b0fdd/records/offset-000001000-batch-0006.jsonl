{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/83d31c2e-eeca-4eef-9bf4-0d9e1ae88c7c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"83d31c2e-eeca-4eef-9bf4-0d9e1ae88c7c","word":"Secondary Legislation","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8dc","lexicalEntryId":"83d31c2e-eeca-4eef-9bf4-0d9e1ae88c7c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تشريع ثانوي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التشريع الثانوي هو قانون أنشأه الوزراء (أو هيئات أخرى) بموجب الصلاحيات الممنوحة لهم بموجب قانون صادر عن البرلمان. يتم استخدامه لملء تفاصيل الأعمال (التشريع الأساسي). توفر هذه التفاصيل إجراءات عملية تمكن من تطبيق القانون والعمل به في الحياة اليومية.  في المملكة المتحدة، فالتشريع الثانوي هو قانون أنشأه وزراء الحكومة أو هيئات أخرى بموجب الصلاحيات الممنوحة لهم بموجب قانون صادر عن البرلمان (وهو التشريع الأساسي). ويُعرف التشريع الثانوي أيضًا بالتشريع المفوض أو الثانوي. يأخذ أحيانًا شكل صك قانوني (مع البرلمان. المملكة المتحدة / الموقع -المعلومات / المسرد / المفوض -أو -التشريع الثانوي /)","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Secondary Legislation","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تشريع ثانوي  Secondary Legislation","nonDiacriticsLemma":"تشريع ثانوي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تشريع ثانوي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/97c68dca-a23a-42e5-b470-12889251a800/get-public-entry"},"browse_index_record":{"lexicalEntryId":"97c68dca-a23a-42e5-b470-12889251a800","word":"Value For Money (VFM)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc8d","lexicalEntryId":"97c68dca-a23a-42e5-b470-12889251a800","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"قيمة مقابل المال","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تُعرَّف أفضل قيمة مقابل المال بأنها المجموعة الأكثر فائدة من حيث التكلفة والجودة والاستدامة لتلبية متطلبات العملاء. في هذا السياق: التكلفة تعني النظر في تكلفة الحياة بأكملها. الجودة تعني تلبية المواصفات المناسبة للغرض والكافية لتلبية متطلبات العميل.  أي أنها التركيبة الأكثر فائدة من السعر والجودة التي تجعل المنتج أو الخدمة مناسبة للغرض وتحقق النتائج المطلوبة للمشتري. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Value For Money (VFM)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"قيمة مقابل المال  Value For Money (VFM)","nonDiacriticsLemma":"قيمة مقابل المال","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قيمة مقابل المال"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8b2e9cd7-a07d-4a6c-97bc-939a7be0ff5a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8b2e9cd7-a07d-4a6c-97bc-939a7be0ff5a","word":"Time Value Of Money","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc90","lexicalEntryId":"8b2e9cd7-a07d-4a6c-97bc-939a7be0ff5a","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"قيمة زمنية للنقود","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي المفهوم القائل بأن مبلغًا من المال يساوي الآن أكثر من نفس المبلغ سيكون في تاريخ مستقبلي بسبب إمكانات أرباحه في هذه الأثناء. هذا هو المبدأ الأساسي للتمويل.  أي فكرة أن قيمة النقود تساوي اليوم أكثر من نفس المبلغ ستكون في المستقبل بسبب قدرتها على الكسب خلال الفترة وعوامل أخرى (على سبيل المثال، التضخم)","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Time Value Of Money  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"قيمة زمنية للنقود  Time Value Of Money  ","nonDiacriticsLemma":"قيمة زمنية للنقود","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قيمة زمنية للنقود"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ca74bd1e-21f5-482e-97e3-5ed6414be3c8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ca74bd1e-21f5-482e-97e3-5ed6414be3c8","word":"Value At Risk (VAT)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc91","lexicalEntryId":"ca74bd1e-21f5-482e-97e3-5ed6414be3c8","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"قيمة معرضة للخطر","lemmaType":"MWE","pattern":" ","senses":[{"definition":" هي مقياس إحصائي لمدى خطورة الكيانات المالية أو محافظ الأصول. يتم تعريفه على أنه الحد الأقصى للمبلغ بالدولار المتوقع ضياعه خلال فترة زمنية معينة، بمستوى ثقة محدد مسبقًا. أي أنها مقياس إحصائي يحدد مستويات المخاطر المالية داخل منظمة أو محفظة منتجات أو مركز في سلسلة التوريد خلال إطار زمني معين. مقياس لمخاطر الخسارة في سلسلة التوريد، بالنظر إلى احتمال معين. القيمة المعرضة للمخاطر هي الاحتمال المشترك لأحداث المخاطر مضروبًا في التأثير النقدي لأي أحداث يمكن أن تؤثر على وظائف سلسلة التوريد الأساسية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Value At Risk (VAT)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"قيمة معرضة للخطر  Value At Risk (VAT)","nonDiacriticsLemma":"قيمة معرضة للخطر","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قيمة معرضة للخطر"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

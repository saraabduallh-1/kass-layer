{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/376c71b8-bf9b-471f-9ac7-125fa9c2e59f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"376c71b8-bf9b-471f-9ac7-125fa9c2e59f","word":"Eutrophication","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b885","lexicalEntryId":"376c71b8-bf9b-471f-9ac7-125fa9c2e59f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تخثث","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"ينجم التخثث عن مدخلات المغذيات الزائدة، ولا سيما النيتروجين والفوسفور، مما يتسبب في زيادة مستويات الكتلة الحيوية في النظم الإيكولوجية المائية. يمكن أن يؤدي هذا إلى اضطراب كبير في النظم الإيكولوجية المائية وقد يؤثر أيضًا على السلع والخدمات المرتبطة بها والأنشطة الاقتصادية وصحة الإنسان.  أي إطلاق المغذيات الزائدة في نهر أو بحيرة أو بحر، مما قد يؤدي إلى فقدان الأكسجين المذاب، وخنق الحياة البرية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Eutrophication ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تخثث  Eutrophication ","nonDiacriticsLemma":"تخثث","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تخثث"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

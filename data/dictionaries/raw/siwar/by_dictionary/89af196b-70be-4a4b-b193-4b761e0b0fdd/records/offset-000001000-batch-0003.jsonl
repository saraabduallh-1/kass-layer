{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/08b51e26-bb15-4606-82a2-f19b1e674303/get-public-entry"},"browse_index_record":{"lexicalEntryId":"08b51e26-bb15-4606-82a2-f19b1e674303","word":"Pareto Analysis","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b892","lexicalEntryId":"08b51e26-bb15-4606-82a2-f19b1e674303","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تحليل باريتو","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يقوم تحليل باريتو على فكرة أن 80٪ من فائدة المشروع يمكن تحقيقها عن طريق القيام بـ 20٪ من العمل -أو، على العكس من ذلك، 80٪ من المشاكل يمكن تتبعها إلى 20٪ من الأسباب. تحليل باريتو هو أداة قوية للجودة واتخاذ القرار.     ويُعرف مبدأ باريتو أيضًا بقاعدة 80/20. تنص على أن ما يقرب من 80٪ من تأثيرات شيء ما تأتي من 20٪ من الأسباب. من المقبول عمومًا في إدارة الأعمال أن 80٪ من قيمة الإنفاق تأتي من أعلى 20٪ من العقود أو الموردين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Pareto Analysis  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تحليل باريتو  Pareto Analysis  ","nonDiacriticsLemma":"تحليل باريتو","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تحليل باريتو"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

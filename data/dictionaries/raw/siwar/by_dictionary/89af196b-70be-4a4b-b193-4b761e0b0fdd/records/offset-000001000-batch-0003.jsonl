{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/31f300df-4b26-4dd6-92a9-06d995f1fec2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"31f300df-4b26-4dd6-92a9-06d995f1fec2","word":"Inventory Velocity","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b883","lexicalEntryId":"31f300df-4b26-4dd6-92a9-06d995f1fec2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تحول المخزون أو دوران","lemmaType":"MWE","pattern":" ","senses":[{"definition":"معدل دوران المخزون هو نسبة مالية توضح عدد المرات التي باعت فيها الشركة المخزون واستبدلت به خلال فترة معينة. يمكن للشركة بعد ذلك تقسيم الأيام في الفترة بواسطة صيغة دوران المخزون لحساب الأيام التي يستغرقها بيع المخزون في متناول اليد. وهو مقياس لعدد المرات التي يتم فيها بيع المخزون أو استخدامه في فترة زمنية معينة، على سبيل المثال، سنة. يتم حسابه لمعرفة ما إذا كان هناك مخزون زائد مقارنة بمستوى المبيعات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Inventory Velocity","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تحول المخزون أو دوران  Inventory Velocity","nonDiacriticsLemma":"تحول المخزون أو دوران","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تحول المخزون أو دوران"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d328831f-3d10-45fc-85a9-c59be4eb1ede/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d328831f-3d10-45fc-85a9-c59be4eb1ede","word":"Customer Portfolio Analysis","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b880","lexicalEntryId":"d328831f-3d10-45fc-85a9-c59be4eb1ede","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تحليل محفظة العملاء","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي تقييم للمجموعات التي يتعامل معها الفرد وتشمل التركيبة السكانية، والرسوم السيكو رافية، والأنماط السلوكية، ومراجعات التسويق، وحالات ربحية العميل. حيث يكشف كل جزء من هذه الأجزاء وما يمكن القيام به لمساعدة الأعمال التجارية على إنشاء استراتيجيات وعلاقات مع العملاء. وبناءاً عليه فالمراجعات الاستراتيجية هي التي توفر مجموعة من خيارات العلاقات لإدارة العملاء.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Customer Portfolio Analysis","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تحليل محفظة العملاء  Customer Portfolio Analysis","nonDiacriticsLemma":"تحليل محفظة العملاء","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تحليل محفظة العملاء"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

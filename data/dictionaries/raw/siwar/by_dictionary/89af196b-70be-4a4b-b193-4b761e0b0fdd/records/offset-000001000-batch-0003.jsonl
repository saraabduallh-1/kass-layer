{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/66d0af49-556a-48ed-9148-b8d3ac1c76e3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"66d0af49-556a-48ed-9148-b8d3ac1c76e3","word":"Business Continuity Planning (BCP)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b88b","lexicalEntryId":"66d0af49-556a-48ed-9148-b8d3ac1c76e3","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تخطيط استمرارية الأعمال","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي عملية تستخدمها الشركة لتطوير خطة لتمكينها من التعافي من الاضطراب في أقصر وقت ممكن. وتخطيط استمرارية الأعمال (BCP) هي العملية التي تخضع لها الشركة لإنشاء نظام للوقاية والتعافي من التهديدات المحتملة مثل الكوارث الطبيعية أو الهجمات الإلكترونية. تم تصميم BCP لحماية الأفراد والأصول والتأكد من قدرتها على العمل بسرعة عند وقوع الكوارث.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Business Continuity Planning (BCP)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تخطيط استمرارية الأعمال  Business Continuity Planning (BCP)","nonDiacriticsLemma":"تخطيط استمرارية الأعمال","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تخطيط استمرارية الأعمال"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/19e3df2c-ed48-4834-a858-1a47753d6395/get-public-entry"},"browse_index_record":{"lexicalEntryId":"19e3df2c-ed48-4834-a858-1a47753d6395","word":"Planning","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b88d","lexicalEntryId":"19e3df2c-ed48-4834-a858-1a47753d6395","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تخطيط","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"خطة العمل هي وثيقة تحدد بالتفصيل أهداف الشركة وكيف تخطط لتحقيق أهدافها. تضع خطة العمل خارطة طريق مكتوبة للشركة من وجهات النظر التسويقية والمالية والتشغيلية. تستخدم كل من الشركات الناشئة والشركات القائمة خطط الأعمال، أي تطوير تسلسل الأنشطة التي يجب إنجازها خلال فترة زمنية معينة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Planning","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تخطيط  Planning","nonDiacriticsLemma":"تخطيط","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تخطيط"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

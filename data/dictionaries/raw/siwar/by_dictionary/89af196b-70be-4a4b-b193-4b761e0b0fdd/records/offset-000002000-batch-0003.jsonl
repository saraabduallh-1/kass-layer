{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4c452d5b-177c-4227-815b-768a6fe31ca6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4c452d5b-177c-4227-815b-768a6fe31ca6","word":"Receivables","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba82","lexicalEntryId":"4c452d5b-177c-4227-815b-768a6fe31ca6","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"ذمم مدينة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الذمم المدينة، يشار إليها أيضًا باسم حسابات القبض، هي ديون مستحقة لشركة من قبل عملائها مقابل سلع أو خدمات تم تسليمها أو استخدامها، ولكن لم يتم سداد ثمنها بعد.  وتُعرف أيضًا باسم حسابات القبض، وهي ديون مستحقة لشركة ما على عملائها مقابل خدمات أو سلع تم تسليمها أو استخدامها ولكن لم يتم دفع ثمنها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Receivables","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"هي مجموع الأموال المستحقة للمؤسسة او المنظمة مقابل سلع وخدمات تم تسليمها للعملاء ولكن لم يقم بتسديدها العملاء بعد. (ويطلق عليه حساب مدين أو حساب المديون وهو الحساب الذي على المشتري سداده إلى البائع (الدائن) عن خدمات أو بضائع اشتراها).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Accounts Receivable","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"ذمم مدينة  Receivables Accounts Receivable","nonDiacriticsLemma":"ذمم مدينة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ذمم مدينة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

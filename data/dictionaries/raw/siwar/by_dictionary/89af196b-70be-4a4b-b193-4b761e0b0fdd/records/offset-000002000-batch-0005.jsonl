{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4479ac15-6dbe-4aa3-866d-6a2a620ec274/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4479ac15-6dbe-4aa3-866d-6a2a620ec274","word":"(GIS)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4baa2","lexicalEntryId":"4479ac15-6dbe-4aa3-866d-6a2a620ec274","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"رسم خرائط نظام المعلومات الجغرافية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو نظام يقوم بإنشاء وإدارة وتحليل وتخطيط جميع أنواع البيانات. يربط نظام المعلومات الجغرافية البيانات بالخريطة، ويدمج بيانات الموقع (حيث توجد الأشياء) مع جميع أنواع المعلومات الوصفية. أو هي وسيلة لتخزين واسترجاع وإدارة وعرض وتحليل البيانات فيما يتعلق بسياقها الجغرافي أو المكاني. يمكن استخدامه لأي نوع من البيانات (النوعية أو الكمية) المعينة في طبقات يمكن أن تتراوح من العالمية / الدولية نزولاً إلى المواقع الدقيقة داخل المباني، اعتمادًا على مجموعة المعلمات واحتياجات مستخدمي البيانات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"(GIS)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"رسم خرائط نظام المعلومات الجغرافية  (GIS)","nonDiacriticsLemma":"رسم خرائط نظام المعلومات الجغرافية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"رسم خرائط نظام المعلومات الجغرافية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/090927a8-b430-4af4-82b3-f557aa9a9355/get-public-entry"},"browse_index_record":{"lexicalEntryId":"090927a8-b430-4af4-82b3-f557aa9a9355","word":"Business","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b73f","lexicalEntryId":"090927a8-b430-4af4-82b3-f557aa9a9355","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إجراءات عملية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أي مجموعة من الأنشطة التي يؤديها نشاط تجاري بدأ بحدث، وتحول المعلومات أو المواد أو التزامات العمل لتنتج مخرجات. وتنتج سلاسل القيمة والعمليات التجارية واسعة النطاق مخرجات يقدّرها العملاء. ويشير مصطلح العملية التجارية إلى مجموعة من الأنشطة المطلوبة لتحقيق نتيجة تجارية. سيكون لكل عملية تجارية مدخلات وطرق ومخرجات. فالمدخلات هي ما يجب وضعها قبل أن يتم تطبيق الطريقة. وعندما يتم تطبيق الطريقة على المدخلات، يتم إنشاء المخرجات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Business  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إجراءات عملية  Business  ","nonDiacriticsLemma":"إجراءات عملية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إجراءات عملية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

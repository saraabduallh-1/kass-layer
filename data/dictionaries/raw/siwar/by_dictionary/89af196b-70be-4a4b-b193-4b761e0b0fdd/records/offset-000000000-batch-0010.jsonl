{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6fb81916-2f74-4579-984d-b1ce88c6cc6f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6fb81916-2f74-4579-984d-b1ce88c6cc6f","word":"Reverse Merger","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b736","lexicalEntryId":"6fb81916-2f74-4579-984d-b1ce88c6cc6f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"اندماج عكسي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يحدث الاندماج العكسي عندما تصبح شركة خاصة شركة عامة عن طريق شراء السيطرة على الشركة العامة. عندما تخطط شركة للاكتتاب العام من خلال الاكتتاب العام، يمكن أن تستغرق العملية عامًا أو أكثر حتى تكتمل، ولكن مع الاندماج العكسي، يمكن لشركة خاصة طرح أسهم عامة في أقل من 30 يومًا.  ويُعرف أيضًا باسم الاستحواذ العكسي -استحواذ شركة أصغر على شركة أكبر. غالبًا ما تحصل الشركة الأصغر على حق الوصول إلى سوق الأوراق المالية ومجموعة أوسع من المساهمين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Reverse Merger","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"اندماج عكسي  Reverse Merger","nonDiacriticsLemma":"اندماج عكسي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اندماج عكسي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3ee0dbc7-f813-430d-9892-9811840bdb24/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3ee0dbc7-f813-430d-9892-9811840bdb24","word":"Procedure","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b737","lexicalEntryId":"3ee0dbc7-f813-430d-9892-9811840bdb24","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إجراء","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"العملية عبارة عن تدفق لأنشطة الأعمال المرتبطة بتحقيق نتيجة الأعمال، في حين أن الإجراء هو طريقة محددة لإجراء عملية أو جزء من العملية. بينما العملية عبارة عن مجموعة من الإجراءات المحددة، فإن الإجراء عبارة عن مجموعة من الإرشادات التي تم تفصيلها بطبيعتها.  وتعرف بأنها طريقة يمكن من خلالها تنفيذ المهمة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Procedure","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"إجراء  Procedure","nonDiacriticsLemma":"إجراء","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إجراء"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fee92225-f3b2-4373-bde8-daa67a65653b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fee92225-f3b2-4373-bde8-daa67a65653b","word":"Restitution Measures","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b738","lexicalEntryId":"fee92225-f3b2-4373-bde8-daa67a65653b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إجراءات الاسترداد ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في حالة الاسترداد، يتم حساب التعويضات بناءً على مقدار ما اكتسبه المدعى عليه من هذه العملية. في معظم الحالات، يتم استخدام هذا المبلغ لاستعادة ما فقد في دعوى مدنية. من حيث التعويض، يتم احتساب الأضرار على أساس مقدار خسارة المدعي. هذا غالبا ما يدفع لضحية الجريمة.  وتعرف كذلك بأنها جائزة تسعى إلى إعادة قيمة ميزة يُنظر إليها على أنها تم استلامها بشكل غير عادل في ظل الظروف المعنية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Restitution Measures","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إجراءات الاسترداد   Restitution Measures","nonDiacriticsLemma":"إجراءات الاسترداد ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إجراءات الاسترداد "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dc8b899d-94c4-4019-b2f1-4927ff2d0e35/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dc8b899d-94c4-4019-b2f1-4927ff2d0e35","word":"Mitigating Actions","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b739","lexicalEntryId":"dc8b899d-94c4-4019-b2f1-4927ff2d0e35","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إجراءات التخفيف","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التخفيف يعني تقليل مخاطر الخسارة من وقوع أي حدث غير مرغوب فيه. هذا عنصر مهم لأي عمل تأمين لتجنب الخسائر غير الضرورية. الوصف: بشكل عام، يعني التخفيف تقليل درجة أي خسارة أو ضرر.  أي انها الإجراءات المتخذة لتقليل تأثير المخاطر على الأشخاص أو المنظمات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Mitigating Actions","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إجراءات التخفيف  Mitigating Actions","nonDiacriticsLemma":"إجراءات التخفيف","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إجراءات التخفيف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d00bdc48-3ce6-4c5c-b0ec-45efe08e36d2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d00bdc48-3ce6-4c5c-b0ec-45efe08e36d2","word":"Procurement Procedures","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b73a","lexicalEntryId":"d00bdc48-3ce6-4c5c-b0ec-45efe08e36d2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إجراءات الشراء","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تتضمن عملية الشراء إعداد الطلب ومعالجته بالإضافة إلى الاستلام النهائي والموافقة على الدفع. بشكل شامل، يمكن أن يشمل ذلك تخطيط الشراء، والمعايير، وتحديد المواصفات، والبحث عن الموردين، والاختيار، والتمويل، والتفاوض على الأسعار، ومراقبة المخزون.  تم تطوير طرق لشرح كيفية تنفيذ مهام الشراء لتنفيذ سياسة الشراء.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Procurement Procedures","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إجراءات الشراء  Procurement Procedures","nonDiacriticsLemma":"إجراءات الشراء","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إجراءات الشراء"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

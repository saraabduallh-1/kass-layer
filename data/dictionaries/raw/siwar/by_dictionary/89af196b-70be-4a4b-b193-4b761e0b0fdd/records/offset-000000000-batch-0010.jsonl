{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8f8940fb-a59f-4505-92ab-fd4d2272ff02/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8f8940fb-a59f-4505-92ab-fd4d2272ff02","word":"Reflection-On-Action","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b734","lexicalEntryId":"8f8940fb-a59f-4505-92ab-fd4d2272ff02","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"انعكاس في النشاط","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عملية تتعلق بالتفكير في قضية مثيرة للقلق واستكشافها، والتي يتم تشغيلها من خلال تجربة ما\". هذا يعني ببساطة أنه لكي يكون هناك انعكاس، يجب أن تكون هناك تجربة، بغض النظر عن كونها إيجابية أو سلبية.  ويعرف بالتفكير في العمل هو التأمل بأثر رجعي للممارسة من أجل الكشف عن المعرفة المستخدمة في حالة معينة، من خلال تحليل وتفسير المعلومات التي تم استدعاؤها.  وكذلك يعرف بعملية بأثر رجعي تختبر التجارب الحالية أو المشاكل أو المواقف مقابل الخبرة السابقة والفهم","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Reflection-On-Action ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"انعكاس في النشاط  Reflection-On-Action ","nonDiacriticsLemma":"انعكاس في النشاط","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"انعكاس في النشاط"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f85fab85-0776-428b-90f1-ccad910ab25b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f85fab85-0776-428b-90f1-ccad910ab25b","word":"Fairtrade","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc32","lexicalEntryId":"f85fab85-0776-428b-90f1-ccad910ab25b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"فيرتريد","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"Fairtrade هي علامة الاستدامة الأكثر شهرة وثقة في العالم. فهي منظمة عالمية يشترك في ملكيتها أكثر من 1.8 مليون مزارع وعامل يكسبون أسعارًا أكثر عدلاً ويبنون مجتمعات أقوى ويتحكمون في مستقبلهم.  فعند كتابته ككلمة واحدة، يشير هذا إلى المنظمات والمنتجات التي تم اعتمادها وفقًا لمعايير Fairtrade International. وهذا ما يميزها عن شهادات ومعايير التجارة العادلة التي تنتجها المنظمات الأخرى، حيث تتم كتابتها في كلمتين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Fairtrade","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"فيرتريد  Fairtrade","nonDiacriticsLemma":"فيرتريد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"فيرتريد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9877a651-bea0-43d1-a138-aea55fecadd0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9877a651-bea0-43d1-a138-aea55fecadd0","word":"Supranational","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc33","lexicalEntryId":"9877a651-bea0-43d1-a138-aea55fecadd0","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"فوق الوطنية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المنظمة فوق الوطنية هي اتحاد أو جمعية متعددة الجنسيات تتنازل فيها الدول الأعضاء عن السلطة والسيادة في بعض الأمور الداخلية على الأقل للمجموعة، والتي تكون قراراتها ملزمة لأعضائها. باختصار، تشارك الدول الأعضاء في صنع القرار بشأن الأمور التي ستؤثر على مواطني كل دولة. و\"فوق الوطني\"، بمعنى هيئة تنظم أنشطة مجموعة من الشركات بطريقة مشتركة باتفاق مسبق على المبادئ. الأمثلة هي الاتحاد الأوروبي، SEAN؛ ولكن ليس منظمة التجارة العالمية أو الأمم المتحدة، وهما منظمات دولية، والتي يجب أن تسعى للحصول على اتفاق بشأن كل قضية على حدة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Supranational  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"فوق الوطنية  Supranational  ","nonDiacriticsLemma":"فوق الوطنية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"فوق الوطنية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/329447d9-b5d1-4fbc-80a0-dc88b8947b3b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"329447d9-b5d1-4fbc-80a0-dc88b8947b3b","word":"Fourth Industrial Revolution","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b702","lexicalEntryId":"329447d9-b5d1-4fbc-80a0-dc88b8947b3b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الثورة الصناعية الرابعة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي طريقة لوصف عدم وضوح الحدود بين العوالم المادية والرقمية والبيولوجية. إنه مزيج من التطورات في الذكاء الاصطناعي (AI)، والروبوتات، وإنترنت الأشياء (Iot)، والطباعة ثلاثية الأبعاد، والهندسة الوراثية، والحوسبة الكمومية، وتقنيات أخرى.  أي توصيف العصر الصناعي الرابع الذي يعتمد على التكنولوجيا التي تدمج العوالم المادية والرقمية والبيولوجية لتقديم أنظمة إلكترونية فيزيائية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Fourth Industrial Revolution","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"هي طريقة لوصف عدم وضوح الحدود بين العوالم المادية والرقمية والبيولوجية. إنه مزيج من التطورات في الذكاء الاصطناعي (AI)، والروبوتات، وإنترنت الأشياء (Iot)، والطباعة ثلاثية الأبعاد، والهندسة الوراثية، والحوسبة الكمومية، وتقنيات أخرى.  أي توصيف العصر الصناعي الرابع الذي يعتمد على التكنولوجيا التي تدمج العوالم المادية والرقمية والبيولوجية لتقديم أنظمة إلكترونية فيزيائية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Fourth Industrial Revolution","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الثورة الصناعية الرابعة  Fourth Industrial Revolution Fourth Industrial Revolution","nonDiacriticsLemma":"الثورة الصناعية الرابعة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الثورة الصناعية الرابعة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8973f538-f5b3-4bd7-b051-09022facf96e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8973f538-f5b3-4bd7-b051-09022facf96e","word":"Efficiency Frontier","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b703","lexicalEntryId":"8973f538-f5b3-4bd7-b051-09022facf96e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الجبهة الفعالة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي مجموعة المحافظ المثلى التي تقدم أعلى عائد متوقع لمستوى محدد من المخاطر أو أقل مخاطرة لمستوى معين من العائد المتوقع. فالمحافظ التي تقع تحت الحدود الفعالة هي دون المستوى الأمثل لأنها لا توفر عائدًا كافيًا لمستوى المخاطرة.  أي انها موجهة في المقام الأول إلى ما يمكن تحقيقه وما يمكن أن تحققه المنظمة في المدى القريب، مع تغييرات صغيرة في الموارد وسياسات التشغيل واستخدام أفضل للتكنولوجيا","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Efficiency Frontier","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الجبهة الفعالة  Efficiency Frontier","nonDiacriticsLemma":"الجبهة الفعالة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الجبهة الفعالة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

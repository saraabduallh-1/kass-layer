{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3be9d1a0-8f2d-40de-b12a-8f8a3cebe269/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3be9d1a0-8f2d-40de-b12a-8f8a3cebe269","word":"Reverse Logistics","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b709","lexicalEntryId":"3be9d1a0-8f2d-40de-b12a-8f8a3cebe269","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الخدمات اللوجستية العكسية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي مجموعة الأنشطة التي يتم إجراؤها بعد بيع المنتج لاستعادة القيمة وإنهاء دورة حياة المنتج. عادة ما يتضمن إعادة المنتج إلى الشركة المصنعة أو الموزع أو إعادة توجيهه للصيانة أو التجديد أو إعادة التدوير. أي جميع العمليات المتعلقة بإعادة استخدام المنتجات والمواد. يتضمن تخطيط وتنفيذ ومراقبة التدفق الفعال من حيث التكلفة للمواد الخام، والمخزون قيد التشغيل، والسلع التامة الصنع والمعلومات ذات الصلة من نقطة المنشأ إلى نقطة الاستهلاك لغرض التوافق مع متطلبات العملاء","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Reverse Logistics","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الخدمات اللوجستية العكسية  Reverse Logistics","nonDiacriticsLemma":"الخدمات اللوجستية العكسية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الخدمات اللوجستية العكسية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4d2e7165-7bd4-4ed8-89f5-2de2b24a9861/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4d2e7165-7bd4-4ed8-89f5-2de2b24a9861","word":"(MES) Minimum Efficient Scale","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b70a","lexicalEntryId":"4d2e7165-7bd4-4ed8-89f5-2de2b24a9861","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الحد الأدنى للمقياس الفعال","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو أدنى نقطة على منحنى التكلفة حيث يمكن للشركة أن تنتج منتجها بسعر تنافسي. في نقطة MES، يمكن للشركة تحقيق وفورات الحجم اللازمة لها للمنافسة بفعالية في صناعتها. أي أدنى نقطة على منحنى متوسط التكلفة بناءً على المخرجات المطلوبة للمؤسسة لتحقيق الكفاءة الإنتاجية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"(MES) Minimum Efficient Scale ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الحد الأدنى للمقياس الفعال  (MES) Minimum Efficient Scale ","nonDiacriticsLemma":"الحد الأدنى للمقياس الفعال","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الحد الأدنى للمقياس الفعال"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/403fb9e6-93a8-4e36-99f1-e8a3ca5e3ffa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"403fb9e6-93a8-4e36-99f1-e8a3ca5e3ffa","word":"Meta-Analysis","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6e1","lexicalEntryId":"403fb9e6-93a8-4e36-99f1-e8a3ca5e3ffa","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"التحليل البعدي / التلوي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التحليل التلوي هو التحليل الإحصائي لنتائج الدراسات المشمولة من مراجعة منهجية. يجب أن يعتمد التحليل التلوي على منهجية مراجعة منهجية، مع إضافة التحليل الإحصائي للنتائج.  ويعرف ايضاً بأنه استخدام دراسات بحثية متعددة لتحسين اليقين في الاستنتاجات وحل الخلافات وإنشاء صورة أكمل لمجال البحث","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Meta-Analysis","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"التحليل البعدي / التلوي  Meta-Analysis","nonDiacriticsLemma":"التحليل البعدي  التلوي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التحليل البعدي / التلوي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3034f4ed-4113-4454-b270-fa4e9adca093/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3034f4ed-4113-4454-b270-fa4e9adca093","word":"STEEPLED Analysis","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6e2","lexicalEntryId":"3034f4ed-4113-4454-b270-fa4e9adca093","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"التحليل المتدرج ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"STEEPLE هو تحليل متقدم لأنه يقيس العوامل الخارجية البيئية الكلية. فهو يقدم نظرة عامة مفصلة عن المجالات الخارجية المختلفة. ويشير اختصار تحليل STEEPLE إلى الاجتماعية والتكنولوجية والاقتصادية والبيئية والسياسية والقانونية والأخلاقية. ويوفر تحليل PESTLE معلومات سياقية حول اتجاه الأعمال، وتحديد موقع علامتها التجارية، وأهداف النمو، والمخاطر (مثل جائحة آخر) للإنتاجية. يمكن أن يساعد في تحديد صلاحية المنتجات والخدمات الحالية وتحديد تطوير منتج جديد. أي فحص مفصل للبيئة الكلية يغطي العوامل الاجتماعية والتكنولوجية والاقتصادية والبيئية والسياسية والقانونية والأخلاقية والديموغرافية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"STEEPLED Analysis","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"التحليل المتدرج   STEEPLED Analysis","nonDiacriticsLemma":"التحليل المتدرج ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التحليل المتدرج "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

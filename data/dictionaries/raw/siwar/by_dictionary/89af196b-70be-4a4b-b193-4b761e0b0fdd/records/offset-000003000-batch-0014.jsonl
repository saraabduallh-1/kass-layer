{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/47310888-f193-472c-899b-9336eb02782a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"47310888-f193-472c-899b-9336eb02782a","word":"Vehicle Routing Problem","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd85","lexicalEntryId":"47310888-f193-472c-899b-9336eb02782a","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مشكلة توجيه السيارة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مشكلة توجيه السيارة (VRP) هي عبارة عن تحسين اندماجي ومشكلة برمجة أعداد صحيحة تسأل \"ما هي مجموعة المسارات المثلى لأسطول من المركبات لاجتيازها من أجل التسليم إلى مجموعة معينة من العملاء؟\". يعمم مشكلة البائع المتجول المعروفة (TSP).  فهي مشكلة تصميم طرق لمركبات التوصيل. الهدف هو تقليل تكاليف النقل وإعداد خطة طريق مثالية للسيناريوهات، مثل الحاجة إلى خدمة عملاء متعددين بأسطول من المركبات من المستودعات المختلفة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Vehicle Routing Problem","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مشكلة توجيه السيارة  Vehicle Routing Problem","nonDiacriticsLemma":"مشكلة توجيه السيارة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مشكلة توجيه السيارة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

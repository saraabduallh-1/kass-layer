{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7de0f737-c8a6-4030-a188-6bc5ee6ecded/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7de0f737-c8a6-4030-a188-6bc5ee6ecded","word":"Network Sourcing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd82","lexicalEntryId":"7de0f737-c8a6-4030-a188-6bc5ee6ecded","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مصادر الشبكة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يعتمد نجاح نظام التعاقد من الباطن الياباني على ما أطلق عليه المؤلف \"مصادر الشبكة\". مصادر الشبكة هو نظام تقوم فيه الشركات بزيادة المحتوى المشتراة من منتجها النهائي إلى الحد الأقصى، بالاعتماد على المهارات والمعرفة المتخصصة للمتعاقدين من الباطن. فلدى المؤسسة مصدرين أو أكثر لكل نوع منتج، مع استخدام مورد واحد فقط لكل عنصر منتج فردي","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Network Sourcing","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مصادر الشبكة  Network Sourcing","nonDiacriticsLemma":"مصادر الشبكة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مصادر الشبكة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c743ca7d-2bfa-43b3-b3d4-b82f57a53526/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c743ca7d-2bfa-43b3-b3d4-b82f57a53526","word":"Sourcing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd83","lexicalEntryId":"c743ca7d-2bfa-43b3-b3d4-b82f57a53526","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مصادر","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تحديد المصادر هو عملية فحص واختيار وإدارة الموردين الذين يمكنهم توفير المدخلات التي تحتاجها المنظمة للتشغيل اليومي. يُكلف تحديد المصادر بإجراء البحوث، وإنشاء وتنفيذ الاستراتيجية، وتحديد مقاييس الجودة والكمية، واختيار الموردين الذين يستوفون هذه المعايير.  أي تقييم السوق لتحديد الموردين القابلين للحياة القادرين على تلبية احتياجات المنظمة (مثل الجودة والكمية وسرعة التسليم).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Sourcing","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"مصادر  Sourcing","nonDiacriticsLemma":"مصادر","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مصادر"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

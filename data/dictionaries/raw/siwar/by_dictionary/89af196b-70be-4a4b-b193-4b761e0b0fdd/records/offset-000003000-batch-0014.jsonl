{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7187482b-713a-4b25-b2c9-6bef35d926f7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7187482b-713a-4b25-b2c9-6bef35d926f7","word":"E-Procurement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd74","lexicalEntryId":"7187482b-713a-4b25-b2c9-6bef35d926f7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مشتريات إلكترونية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الشراء الإلكتروني، المعروف أيضًا باسم الشراء الإلكتروني أو تبادل الموردين، هو شراء وبيع الإمدادات والمعدات والأشغال والخدمات من خلال واجهة الويب أو أي نظام شبكي آخر. أي الأنظمة الإلكترونية التي تدعم مراحل دورة الشراء من إرساء العقد إلى إدارة الأصول.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"E-Procurement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مشتريات إلكترونية  E-Procurement","nonDiacriticsLemma":"مشتريات إلكترونية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مشتريات إلكترونية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8ed6bebb-6eb9-4a2a-84e2-71a88c64c58b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8ed6bebb-6eb9-4a2a-84e2-71a88c64c58b","word":"Collaborative Procurement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd75","lexicalEntryId":"8ed6bebb-6eb9-4a2a-84e2-71a88c64c58b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مشتريات تشاركية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الشراء التعاوني هو ممارسة تقوم بها منظمات متعددة معًا لطلب السلع والخدمات المشتركة التي يتشاركونها. فهو يجعل المشتريات لهذه الهيئات العامة مركزية وهو شائع عبر الوكالات الحكومية. حيث يمثل استراتيجية عندما يوجد تعاون بين مديري المشتريات، على أساس الثقة والأهداف المشتركة من أجل تحقيق الفوائد من خلال الاستفادة من القوة الشرائية المشتركة والكفاءات الأخرى.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Collaborative Procurement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مشتريات تشاركية  Collaborative Procurement","nonDiacriticsLemma":"مشتريات تشاركية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مشتريات تشاركية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4deeb537-ae93-43ef-9f2a-079a18aaeb1b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4deeb537-ae93-43ef-9f2a-079a18aaeb1b","word":"Ethical Procurement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd76","lexicalEntryId":"4deeb537-ae93-43ef-9f2a-079a18aaeb1b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مشتريات أخلاقية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تشير المشتريات الأخلاقية إلى مجموعة واسعة من القضايا التي يمكن أن تؤثر على الأهداف الأخلاقية والاستدامة للشركة. تشمل الأمثلة مراقبة الإجراءات والممارسات التجارية غير الأخلاقية أو غير القانونية للموردين التي يمكن أن تؤثر على كفاءة المشتريات في مؤسستك وسمعتها.  أي انه ضمان الحصول على المنتجات والخدمات بطريقة مسؤولة ومستدامة تُظهر احترام الأشخاص المشاركين في سلسلة التوريد والبيئة مثل الاحتيال والفساد والرشوة والعبودية الحديثة وحقوق الإنسان.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Ethical Procurement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مشتريات أخلاقية  Ethical Procurement","nonDiacriticsLemma":"مشتريات أخلاقية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مشتريات أخلاقية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dcd3036e-bf74-41fa-a60e-e0625762bafd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dcd3036e-bf74-41fa-a60e-e0625762bafd","word":"Co-Operative Procurement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd77","lexicalEntryId":"dcd3036e-bf74-41fa-a60e-e0625762bafd","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مشتريات تعاونية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يُقصد بالمشتريات التعاونية الشراء الذي يتم إجراؤه بواسطة أو نيابة عن وكالة أو أكثر من الوكالات المتعاقدة. تم تصميم برامج المشتريات التعاونية لتوفير قيمة للوكالات في مجالات مثل انخفاض التكاليف الإدارية، وتسريع تقديم الخدمات، وانخفاض الأسعار أو فرص زيادة التوحيد القياسي. وهي تمثل استراتيجية تتعاون فيها المنظمات المختلفة أفقياً، حيث تجمع بين متطلبات الشراء الخاصة بها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Co-Operative Procurement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مشتريات تعاونية  Co-Operative Procurement","nonDiacriticsLemma":"مشتريات تعاونية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مشتريات تعاونية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a4bc3d95-0077-49a9-a99b-12090f54d5ea/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a4bc3d95-0077-49a9-a99b-12090f54d5ea","word":"Decentralized Procurement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd78","lexicalEntryId":"a4bc3d95-0077-49a9-a99b-12090f54d5ea","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مشتريات لامركزية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تتيح المشتريات اللامركزية لأصحاب المصلحة الأفراد إجراء عمليات شراء لإداراتهم، على عكس عمليات الشراء المركزية، حيث يتم إجراء جميع عمليات الشراء بواسطة فريق مشتريات مركزي.  وهي تمثل نهج للمشتريات حيث يتم اتخاذ جميع السياسات والقرارات الاستراتيجية من قبل العناصر الفردية أو الأقسام في المنظمة، دون مشاركة المقر المركزي","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Decentralized Procurement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مشتريات لامركزية  Decentralized Procurement","nonDiacriticsLemma":"مشتريات لامركزية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مشتريات لامركزية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

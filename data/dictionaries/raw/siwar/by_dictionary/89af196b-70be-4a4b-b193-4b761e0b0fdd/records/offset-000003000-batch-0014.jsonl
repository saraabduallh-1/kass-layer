{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d6141660-ef5d-4ac3-a360-b2026586f74d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d6141660-ef5d-4ac3-a360-b2026586f74d","word":"Sustainable Procurement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd7d","lexicalEntryId":"d6141660-ef5d-4ac3-a360-b2026586f74d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مشتريات مستدامة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المشتريات المستدامة هي دمج مبادئ المسؤولية الاجتماعية للشركات (CSR) في عمليات وقرارات الشراء الخاصة بشركتك مع ضمان استمرارها في تلبية متطلبات أصحاب المصلحة.  أي المشتريات التي تدعم أهداف الاستدامة للمنظمة وتحسن الآثار البيئية والاجتماعية والاقتصادية على دورة حياة المنتج أو الخدمة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Sustainable Procurement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مشتريات مستدامة  Sustainable Procurement","nonDiacriticsLemma":"مشتريات مستدامة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مشتريات مستدامة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

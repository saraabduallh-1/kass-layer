{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d6e285d0-7633-47c2-b818-f8bc9f74d27f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d6e285d0-7633-47c2-b818-f8bc9f74d27f","word":"Centralized Procurement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd7b","lexicalEntryId":"d6e285d0-7633-47c2-b818-f8bc9f74d27f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مشتريات مركزية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو نهج تتبعه إدارة المشتريات حيث يتم اتخاذ جميع السياسات والقرارات الاستراتيجية على مستوى المقر الرئيسي، وهو نظام يدير فيه قسم واحد شراء السلع والخدمات للمؤسسة بأكملها. يقع قسم المشتريات عادة في المقر الرئيسي للمنظمة، حيث يتعامل مع المشتريات لجميع فروع الشركة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Centralized Procurement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مشتريات مركزية  Centralized Procurement","nonDiacriticsLemma":"مشتريات مركزية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مشتريات مركزية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/20852f68-8679-4626-99d2-a3212f427a32/get-public-entry"},"browse_index_record":{"lexicalEntryId":"20852f68-8679-4626-99d2-a3212f427a32","word":"Expenses","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd87","lexicalEntryId":"20852f68-8679-4626-99d2-a3212f427a32","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مصاريف","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"المصاريف هي تكلفة العمليات التي تتكبدها الشركة لتوليد الإيرادات. كما يقول المثل الشائع، \"كسب المال يكلف المال\". تشمل المصاريف المشتركة المدفوعات للموردين وأجور الموظفين وعقود إيجار المصانع واستهلاك المعدات.  فالمصاريف هي الأموال التي ينفقها الفرد في سياق عمله، مثل تكلفة السفر أو الإقامة أو القرطاسية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Expenses","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"مصاريف  Expenses","nonDiacriticsLemma":"مصاريف","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مصاريف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

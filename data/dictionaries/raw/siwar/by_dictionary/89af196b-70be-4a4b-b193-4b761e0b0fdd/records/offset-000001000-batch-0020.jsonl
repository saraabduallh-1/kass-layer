{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5f90d492-29d4-462a-a396-fdbdcdb348be/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5f90d492-29d4-462a-a396-fdbdcdb348be","word":"Title To Goods","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba15","lexicalEntryId":"5f90d492-29d4-462a-a396-fdbdcdb348be","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"حق ملكية البضائع","lemmaType":"MWE","pattern":" ","senses":[{"definition":"حق ملكية البضائع، التي تم تحديدها في عقد البيع، من البائع إلى المشتري بأي طريقة وعلى أي شروط يتفق عليها أطراف عقد البيع. القاعدة هي أن ملكية البضائع تنتقل عندما يعتزم الأطراف تمريرها. وهي ملكية معترف بها قانونًا","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Title To Goods  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"حق ملكية البضائع  Title To Goods  ","nonDiacriticsLemma":"حق ملكية البضائع","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"حق ملكية البضائع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/231a8856-0a52-43fb-b02f-2d7215486dc3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"231a8856-0a52-43fb-b02f-2d7215486dc3","word":"Human Rights","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba16","lexicalEntryId":"231a8856-0a52-43fb-b02f-2d7215486dc3","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"حقوق الإنسان","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي حقوق وحريات أساسية تحمينا جميعًا. تقوم على الكرامة والإنصاف والمساواة والاحترام. للشركات تأثير كبير على الطريقة التي نعيش بها حياتنا ونستمتع بحقوق الإنسان هذه، سواء كان ذلك كموظف أو عميل أو مجرد العيش جنبًا إلى جنب مع الشركات التي تشارك مدننا وبلداتنا. بمعنى أخر هي الحقوق أو المبادئ، بناءً على القيم المشتركة المقبولة على أنها تنتمي إلى كل شخص، بغض النظر عن خلفيته","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Human Rights","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"حقوق الإنسان  Human Rights","nonDiacriticsLemma":"حقوق الإنسان","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"حقوق الإنسان"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5ab6bd57-4a00-4a23-8d03-5d5a823b94b7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5ab6bd57-4a00-4a23-8d03-5d5a823b94b7","word":"Intellectual Property Rights (IPR)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba17","lexicalEntryId":"5ab6bd57-4a00-4a23-8d03-5d5a823b94b7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"حقوق الملكية الفكرية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي حقوق قانونية تحمي الإبداعات و / أو الاختراعات الناتجة عن النشاط الفكري في المجالات الصناعية، أو العلمية أو الأدبية أو الفنية. تشمل حقوق الملكية الفكرية الأكثر شيوعًا براءات الاختراع وحقوق النشر والعلامات والأسرار التجارية.  وحماية الأصول التي تم إنشاؤها من خلال الفكر البشري، مثل الاختراعات والمصنفات الأدبية والفنية والتصاميم والرموز والموسيقى وبرامج الكمبيوتر والصور. قد تكون هذه الأصول محمية بواسطة العلامات التجارية وحقوق التأليف والنشر وحقوق التصميم وبراءات الاختراع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Intellectual Property Rights (IPR)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"حقوق الملكية الفكرية  Intellectual Property Rights (IPR)","nonDiacriticsLemma":"حقوق الملكية الفكرية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"حقوق الملكية الفكرية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1a8282c6-4508-488c-b8b9-fed7fcf0f0c6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1a8282c6-4508-488c-b8b9-fed7fcf0f0c6","word":"Conflict Resolution","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba18","lexicalEntryId":"1a8282c6-4508-488c-b8b9-fed7fcf0f0c6","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"حل النزاعات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"حل النزاع هو العملية التي يتوصل من خلالها طرفان أو أكثر إلى حل سلمي للنزاع. في مكان العمل، يمكن أن يكون هناك مجموعة متنوعة من أنواع الصراع: قد يحدث تضارب بين زملاء العمل، أو بين المشرفين والمرؤوسين، أو بين مقدمي الخدمات وعملائهم. أي عمليات إدارة الخلاف أو الاختلاف في الآراء أو المبادئ بين طرفين أو أكثر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Conflict Resolution","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"هي عملية إدارة الخلاف أو الاختلاف في الآراء أو المبادئ بين طرفين أو أكثر. وحل النزاع هو العملية التي يتوصل من خلالها طرفان أو أكثر إلى حل سلمي للنزاع في مكان العمل، يمكن أن يكون هناك مجموعة متنوعة من أنواع الصراع: قد يحدث الصراع بين زملاء العمل، أو بين المشرفين والمرؤوسين، أو بين مقدمي الخدمات وعملائهم أو عملائهم.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Adjudication","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"حل النزاعات  Conflict Resolution Adjudication","nonDiacriticsLemma":"حل النزاعات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"حل النزاعات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

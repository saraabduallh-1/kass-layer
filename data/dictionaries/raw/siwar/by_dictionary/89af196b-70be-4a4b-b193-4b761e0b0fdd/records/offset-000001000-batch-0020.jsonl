{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f8b516e2-7023-4bee-80b9-28be497a704a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f8b516e2-7023-4bee-80b9-28be497a704a","word":"Competitive Dialogue","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba20","lexicalEntryId":"f8b516e2-7023-4bee-80b9-28be497a704a","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"حوار تنافسي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي عملية الشراء حيث تدخل منظمة الشراء في حوار مع عدد من الموردين من أجل تحسين المتطلبات والحلول -تتطلب عادةً استثمارات كبيرة من جميع الأطراف المعنية، فهو عملية ضمن مناقصة المشتريات تسهل الحوار مع الموردين لمساعدتهم على فهم المتطلبات المحددة للعقد بشكل أفضل. يساعد الحوار المورد على تقديم حل مصمم خصيصًا لمتطلبات العمل","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Competitive Dialogue","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"حوار تنافسي  Competitive Dialogue","nonDiacriticsLemma":"حوار تنافسي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"حوار تنافسي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

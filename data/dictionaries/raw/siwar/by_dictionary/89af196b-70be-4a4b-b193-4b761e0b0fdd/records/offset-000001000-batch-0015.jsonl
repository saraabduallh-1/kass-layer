{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/263f52fb-d1b9-43fd-82e3-c9bf054842c2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"263f52fb-d1b9-43fd-82e3-c9bf054842c2","word":"Indirect Supplies","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b9ae","lexicalEntryId":"263f52fb-d1b9-43fd-82e3-c9bf054842c2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"توريدات غير المباشرة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أي المواد غير المباشرة فهي سلع، رغم أنها جزء من عملية التصنيع الشاملة، لا يتم دمجها في المنتج النهائي. على سبيل المثال، قد تكون القفازات التي تستخدم لمرة واحدة، ومعدات الحماية الشخصية، والشريط، وما إلى ذلك، ضرورية لخط الإنتاج، ولكنها ليست جزءًا من المنتج الفعلي الذي تم إنشاؤه على هذا الخط.  فالإمدادات غير المدرجة في المنتج النهائي ولكنها تحافظ على عمل الشركة والمصنع","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Indirect Supplies","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"توريدات غير المباشرة  Indirect Supplies","nonDiacriticsLemma":"توريدات غير المباشرة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"توريدات غير المباشرة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/09f68e4d-ffc6-4050-b906-7a991e02d367/get-public-entry"},"browse_index_record":{"lexicalEntryId":"09f68e4d-ffc6-4050-b906-7a991e02d367","word":"Ethical Sourcing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b9ac","lexicalEntryId":"09f68e4d-ffc6-4050-b906-7a991e02d367","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"توريد أخلاقي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو نهج لتحديد المصادر وسلاسل التوريد. يعني تحديد المصادر بشكل أخلاقي أنه عندما تشتري الشركات المنتجات من الموردين، فإنها تأخذ في الاعتبار تأثيرات هذه المنتجات على الأشخاص والمجتمعات التي تنشئها. أي انها ضمان الحصول على المنتجات بطريقة مسؤولة ومستدامة تظهر الاحترام للأشخاص الذين ينتجونها وللبيئة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Ethical Sourcing","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"توريد أخلاقي  Ethical Sourcing","nonDiacriticsLemma":"توريد أخلاقي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"توريد أخلاقي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/97c15ceb-b965-461e-8bb8-f0bd05c4f955/get-public-entry"},"browse_index_record":{"lexicalEntryId":"97c15ceb-b965-461e-8bb8-f0bd05c4f955","word":"Speculating","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8a3","lexicalEntryId":"97c15ceb-b965-461e-8bb8-f0bd05c4f955","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تخمين","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"في عالم المال، تشير المضاربة أو التداول المضارب إلى فعل إجراء معاملة مالية تنطوي على مخاطر كبيرة بفقدان القيمة ولكنها تحمل أيضًا توقعًا بمكاسب كبيرة أو قيمة رئيسية أخرى.  أي إجراء معاملة مالية تنطوي على مخاطر فقدان قيمة عالية، ولكن يتم ذلك لمحاولة تأمين ربح مرتفع","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Speculating","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تخمين  Speculating","nonDiacriticsLemma":"تخمين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تخمين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/029eeb94-b946-46ce-beae-865a83f31990/get-public-entry"},"browse_index_record":{"lexicalEntryId":"029eeb94-b946-46ce-beae-865a83f31990","word":"Mitigate","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8a4","lexicalEntryId":"029eeb94-b946-46ce-beae-865a83f31990","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تخفيف","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"التخفيف يعني تقليل مخاطر الخسارة من وقوع أي حدث غير مرغوب فيه. هذا عنصر مهم لأي عمل تأمين لتجنب الخسائر غير الضرورية.  أي اتخاذ إجراء لتقليل احتمالية و / أو تأثير حدث الخطر. على سبيل المثال، الاحتفاظ بمخزون آمن / احتياطي يخفف من تأثير تأخر تسليم الموردين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Mitigate","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"يحدث التخفيف عندما تصدر الشركة أسهمًا جديدة تؤدي إلى انخفاض نسبة ملكية المساهمين الحاليين لتلك الشركة. يمكن أن يحدث تخفيف المخزون أيضًا عندما يمارس أصحاب خيارات الأسهم، مثل موظفي الشركة، أو حاملي الأوراق المالية الأخرى القابلة للخيار خياراتهم. حيث تؤدي معاملة الاستحواذ إلى انخفاض أرباح الشركة المقتناة للسهم (EPS) بعد الاستحواذ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Dilutive","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تخفيف  Mitigate Dilutive","nonDiacriticsLemma":"تخفيف","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تخفيف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

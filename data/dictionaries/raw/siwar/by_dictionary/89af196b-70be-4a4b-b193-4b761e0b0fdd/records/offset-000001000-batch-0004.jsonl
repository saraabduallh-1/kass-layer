{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a83f32da-b767-4883-bb99-58cf515d29e1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a83f32da-b767-4883-bb99-58cf515d29e1","word":"Lag Measures","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8ab","lexicalEntryId":"a83f32da-b767-4883-bb99-58cf515d29e1","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تدابير متأخرة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي تقارير النتائج السابقة أو الأحداث التي حدثت بالفعل والنتيجة النهائية. على سبيل المثال، إجمالي مبيعات الشهر، إجمالي صافي أو إجمالي ربح الشهر. لقد تجاوزت هذه النتائج، وليس هناك ما يمكنك فعله لتغييرها.  فهي شكل من أشكال القياس يتتبع نجاح الأداء الذي حدث بالفعل","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Lag Measures","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تدابير متأخرة  Lag Measures","nonDiacriticsLemma":"تدابير متأخرة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تدابير متأخرة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/31caaeeb-5f39-4bd0-b944-f2ce61c4f935/get-public-entry"},"browse_index_record":{"lexicalEntryId":"31caaeeb-5f39-4bd0-b944-f2ce61c4f935","word":"Indirect Procurement","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8ac","lexicalEntryId":"31caaeeb-5f39-4bd0-b944-f2ce61c4f935","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تدبير غير مباشر","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تتضمن المشتريات غير المباشرة، والمعروفة أيضًا باسم الإنفاق غير المباشر، شراء السلع والخدمات والإمدادات والمواد بما في ذلك أجهزة الكمبيوتر والأجهزة والبرامج والصيانة والمرافق والسفر المطلوبة للتشغيل اليومي للأعمال.  أي شراء السلع أو الخدمات التي لا تشكل بشكل مباشر جزءًا من المنتج أو الخدمة النهائية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Indirect Procurement","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تدبير غير مباشر  Indirect Procurement","nonDiacriticsLemma":"تدبير غير مباشر","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تدبير غير مباشر"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0ed0f00b-fd66-4ffa-b5dd-920055768022/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0ed0f00b-fd66-4ffa-b5dd-920055768022","word":"Insider Trading","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8ad","lexicalEntryId":"0ed0f00b-fd66-4ffa-b5dd-920055768022","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تداول من الداخل","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التداول من الداخل هو التداول بناءً على معلومات داخلية هو تداول أسهم الشركة أو غيرها من الأوراق المالية من قبل أفراد لديهم إمكانية الوصول إلى معلومات سرية أو غير عامة حول الشركة. يعتبر الاستفادة من هذا الوصول المميز خرقًا لواجب الفرد الائتماني.  ويعرف ايضاً التداول في البورصة من قبل أشخاص لديهم إمكانية الوصول إلى معلومات غير متاحة للجمهور حول شركة ما، وبالتالي يتمتعون بميزة على المتداولين الآخرين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Insider Trading","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تداول من الداخل  Insider Trading","nonDiacriticsLemma":"تداول من الداخل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تداول من الداخل"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

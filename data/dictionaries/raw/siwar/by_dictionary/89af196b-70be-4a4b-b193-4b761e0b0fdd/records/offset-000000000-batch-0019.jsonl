{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9634e355-c509-4e09-b922-0e163d945e0f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9634e355-c509-4e09-b922-0e163d945e0f","word":"Central Banks","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b80f","lexicalEntryId":"9634e355-c509-4e09-b922-0e163d945e0f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"بنوك مركزية ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي السلطة النقدية العليا لدولة ما وهي بنوك للحكومة والمؤسسات المالية. البنوك المركزية لا تتعامل مع عامة الناس، وهي مؤسسة مالية تُمنح سيطرة مميزة على إنتاج وتوزيع الأموال والائتمان لأمة أو مجموعة من الدول. في الاقتصادات الحديثة، يكون البنك المركزي عادة مسؤولاً عن صياغة السياسة النقدية وتنظيم البنوك الأعضاء.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Central Banks","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"بنوك مركزية   Central Banks","nonDiacriticsLemma":"بنوك مركزية ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"بنوك مركزية "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

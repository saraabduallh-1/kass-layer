{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0c9f81b1-050d-4d73-90be-a6e9cef80f36/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0c9f81b1-050d-4d73-90be-a6e9cef80f36","word":"Statement Of Needs","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b818","lexicalEntryId":"0c9f81b1-050d-4d73-90be-a6e9cef80f36","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"بيان الاحتياجات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يحدد بيان الاحتياجات المشكلة ويصف الظروف في المجتمع التي ستعالجها مؤسستك. بيان الاحتياجات هو فرصة لإثبات فهمك لقضية المجتمع وقدرة مؤسستك على تلبية الحاجة.  فهو يحدد بيان احتياجات العمل فكرة مشروع قد تتحول إلى استثمار / مشروع مقترح (I / P). يتضمن وصفًا موجزًا لغرض المشروع المقترح وأهدافه ونطاقه بالإضافة إلى الترتيب التقريبي لحجم التكلفة والجدول الزمني والمهارات التجارية والتقنية الأساسية.  أي تعريف مشكلة أو فرصة عمل مع المعايير التي تحددها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Statement Of Needs","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"بيان الاحتياجات  Statement Of Needs","nonDiacriticsLemma":"بيان الاحتياجات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"بيان الاحتياجات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

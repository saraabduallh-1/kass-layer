{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6d198796-2afb-4c3d-a337-26a22eb96db2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6d198796-2afb-4c3d-a337-26a22eb96db2","word":"Closed System","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bf0d","lexicalEntryId":"6d198796-2afb-4c3d-a337-26a22eb96db2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نظام مغلق","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو نظام أو عملية، بمجرد بدئها، لا تسمح للوافدين الجدد. قد تحتوي الاتفاقية الإطارية على مشترين متعددين وموردين متعددين، ولكن بمجرد إنشائها، لا يمكن إضافة مشترين أو موردين إضافيين إليها، ويتفاعل النشاط التجاري الذي يدير نظامًا مفتوحًا مع بيئته من خلال تقديم المعلومات وتلقيها. في نظام مغلق، تحدث التفاعلات فقط داخل نظام معين، مما يعني أن الأنظمة المغلقة مغلقة عن البيئة الخارجية، ويتم نقل كل تفاعل داخل هذا النظام المغلق.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Closed System","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نظام مغلق  Closed System","nonDiacriticsLemma":"نظام مغلق","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نظام مغلق"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fd0f70f2-c339-47bd-92ab-02676885b958/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fd0f70f2-c339-47bd-92ab-02676885b958","word":"Sustainability Policy","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4baf1","lexicalEntryId":"fd0f70f2-c339-47bd-92ab-02676885b958","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"سياسة الاستدامة ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سياسة الاستدامة هي بيان يحدد التزام عملك واستراتيجيتك تجاه جميع مجالات الاستدامة. تتعرض الشركات والوكالات لضغوط أكبر من أي وقت مضى للوفاء بالمسؤوليات البيئية، فهي أي وثيقة بشأن طرق تقليل الأثر البيئي مع حماية الأجيال الحالية والمستقبلية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Sustainability Policy  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"سياسة الاستدامة   Sustainability Policy  ","nonDiacriticsLemma":"سياسة الاستدامة ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"سياسة الاستدامة "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

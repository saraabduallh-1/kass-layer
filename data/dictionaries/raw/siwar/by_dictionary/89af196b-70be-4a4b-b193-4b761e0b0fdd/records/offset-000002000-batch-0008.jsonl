{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/176f6b06-1a67-4d8b-b4c1-334a5e661f1f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"176f6b06-1a67-4d8b-b4c1-334a5e661f1f","word":"Bull Market","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4baef","lexicalEntryId":"176f6b06-1a67-4d8b-b4c1-334a5e661f1f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"سوق صاعدة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عندما ترتفع أسعار الأسهم وتظهر توقعات الأحجام أنها ستزداد، السوق الصاعد وهو يمثل حالة السوق المالية لمجموعة الأوراق المالية التي ترتفع فيها الأسعار أو من المتوقع أن ترتفع. ويستخدم مصطلح \"السوق الصاعد\" بشكل شائع للإشارة إلى سوق الأسهم، ولكن يمكن استخدامه مع أي شيء يمكن تداوله، مثل العقارات والسندات والعملات والسلع. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Bull Market","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"سوق صاعدة  Bull Market","nonDiacriticsLemma":"سوق صاعدة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"سوق صاعدة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

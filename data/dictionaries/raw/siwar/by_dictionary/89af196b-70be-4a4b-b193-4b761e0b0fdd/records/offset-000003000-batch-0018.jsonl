{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7f3a46d9-3f43-4480-986a-c3d907656ab0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7f3a46d9-3f43-4480-986a-c3d907656ab0","word":"Intellectual Property (IP)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bdda","lexicalEntryId":"7f3a46d9-3f43-4480-986a-c3d907656ab0","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"ملكية فكرية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الملكية الفكرية مملوكة ومحمية قانونًا من قبل شخص أو شركة من الاستخدام الخارجي أو التنفيذ دون موافقة. يمكن أن تتكون الملكية الفكرية من العديد من أنواع الأصول، بما في ذلك العلامات التجارية وبراءات الاختراع وحقوق التأليف والنشر.  فهي أصل غير ملموس، مثل العملية، التي تم إنشاؤها من خلال العقل البشري؛ قد تكون هذه الأصول محمية بواسطة العلامات التجارية وحقوق التأليف والنشر أو براءات الاختراع. على سبيل المثال، الاختراعات والمصنفات الأدبية والفنية والتصميمات والرموز والصور","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Intellectual Property (IP) ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"ملكية فكرية  Intellectual Property (IP) ","nonDiacriticsLemma":"ملكية فكرية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ملكية فكرية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

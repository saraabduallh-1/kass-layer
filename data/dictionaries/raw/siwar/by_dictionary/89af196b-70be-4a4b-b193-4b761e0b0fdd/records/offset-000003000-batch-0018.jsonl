{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/467d2e46-6989-4114-bb53-9b03341f49eb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"467d2e46-6989-4114-bb53-9b03341f49eb","word":"Procure To Pay (P2P)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bddd","lexicalEntryId":"467d2e46-6989-4114-bb53-9b03341f49eb","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"من الشراء للدفع","lemmaType":"MWE","pattern":" ","senses":[{"definition":"من الشراء إلى الدفع هي عملية دمج أنظمة الشراء والحسابات الدائنة لخلق كفاءات أكبر. وهي موجودة ضمن عملية إدارة المشتريات الأكبر وتتضمن أربع مراحل رئيسية: اختيار السلع والخدمات؛ فرض الامتثال والنظام؛ الاستلام والمصالحة؛ الفواتير والدفع.  حيث تدفق العملية من الطلب والشراء إلى الدفع والمحاسبة عن المشتريات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Procure To Pay (P2P)   ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"من الشراء للدفع  Procure To Pay (P2P)   ","nonDiacriticsLemma":"من الشراء للدفع","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"من الشراء للدفع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4db564ba-11e8-4997-b33e-fbe3cb8410f7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4db564ba-11e8-4997-b33e-fbe3cb8410f7","word":"Tangible","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bdde","lexicalEntryId":"4db564ba-11e8-4997-b33e-fbe3cb8410f7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"ملموس","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" شيء يمكنك رؤيته أو لمسه جسديًا فالأصول هي كل ما تمتلكه الشركة. الأصول الملموسة مادية؛ وهي تشمل النقد والمخزون والمركبات والمعدات والمباني والاستثمارات. لا توجد الأصول غير الملموسة في شكل مادي وتشمل أشياء مثل الذمم المدينة والمصروفات المدفوعة مسبقًا وبراءات الاختراع والشهرة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Tangible ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"ملموس  Tangible ","nonDiacriticsLemma":"ملموس","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ملموس"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/67e5cac2-718b-4642-92e9-50a32bf375f2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"67e5cac2-718b-4642-92e9-50a32bf375f2","word":"Monopolistic Competition","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bddf","lexicalEntryId":"67e5cac2-718b-4642-92e9-50a32bf375f2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منافسة احتكارية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تميز المنافسة الاحتكارية الصناعة التي تقدم فيها العديد من الشركات منتجات أو خدمات متشابهة (ولكنها ليست مثالية) بدائل. حواجز الدخول والخروج في صناعة تنافسية احتكارية منخفضة، وقرارات أي شركة لا تؤثر بشكل مباشر على قرارات منافسيها.  أي انها نوع من هيكل السوق حيث توجد منافسة غير كاملة. يتمتع السوق بحرية الدخول والخروج ولكن يمكن للشركات أن تميز منتجاتها. المنتجات ليست بدائل مثالية، وهذا يمكن أن يسمح للشركات بالتحكم في الأسعار","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Monopolistic Competition","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منافسة احتكارية  Monopolistic Competition","nonDiacriticsLemma":"منافسة احتكارية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منافسة احتكارية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

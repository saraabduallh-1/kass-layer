{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/948f6655-55df-48b2-8bf3-d6ef94e5cb6a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"948f6655-55df-48b2-8bf3-d6ef94e5cb6a","word":"Variable Costs","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b7c2","lexicalEntryId":"948f6655-55df-48b2-8bf3-d6ef94e5cb6a","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"أسعار متغيرة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التكلفة المتغيرة هي مصروف يرتفع أو ينخفض بشكل مباشر مع حجم الإنتاج. تختلف التكاليف المتغيرة عن التكاليف الثابتة، والتي تظل كما هي حتى مع تغير حجم الإنتاج والمبيعات. تشمل التكاليف المتغيرة الشائعة ما يلي: المواد الخام. عمولات المبيعات.  أي انها التكاليف التي تتغير بما يتناسب مع ناتج العمل. تزداد مع زيادة حجم المنتج أو الخدمة المنتجة. مع زيادة المبيعات، تزداد التكاليف المتغيرة. مع انخفاض المبيعات، تنخفض التكاليف المتغيرة. على سبيل المثال، كمية المواد المستخدمة أو تكلفة ساعات العمل","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Variable Costs","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"أسعار متغيرة  Variable Costs","nonDiacriticsLemma":"أسعار متغيرة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"أسعار متغيرة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

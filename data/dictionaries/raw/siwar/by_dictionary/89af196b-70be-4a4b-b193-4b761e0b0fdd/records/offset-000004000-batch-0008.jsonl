{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a4ea4fb8-680d-45b9-9d2a-95b67ef1a1f0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a4ea4fb8-680d-45b9-9d2a-95b67ef1a1f0","word":"Simultaneous (Concurrent) Engineering","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bed5","lexicalEntryId":"a4ea4fb8-680d-45b9-9d2a-95b67ef1a1f0","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"هندسة متزامنة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الهندسة المتزامنة، والمعروفة أيضًا باسم الهندسة المتزامنة، هي طريقة لتصميم المنتجات وتطويرها، حيث يتم تشغيل المراحل المختلفة في وقت واحد، وليس بشكل متتالي. إنه يقلل وقت تطوير المنتج وكذلك الوقت اللازم للتسويق، مما يؤدي إلى تحسين الإنتاجية وتقليل التكاليف.  أي عملية تصميم / تطوير منتج يتم فيها تنفيذ بعض المراحل في نفس الوقت مما يقلل من الوقت اللازم للتسويق","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Simultaneous (Concurrent) Engineering ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"هندسة متزامنة  Simultaneous (Concurrent) Engineering ","nonDiacriticsLemma":"هندسة متزامنة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"هندسة متزامنة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/022f9888-d16a-463f-8728-85dc6a34faf7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"022f9888-d16a-463f-8728-85dc6a34faf7","word":"Vertical Structure","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bed6","lexicalEntryId":"022f9888-d16a-463f-8728-85dc6a34faf7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"هيكل عمودي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الهيكل التنظيمي العمودي هو هيكل إداري يشبه الهرم من أعلى إلى أسفل. حددت هذه المنظمات أدوارًا محددة بوضوح مع أعلى مستوى من القيادة في القمة، تليها الإدارة الوسطى ثم الموظفون العاديون.  فهي منظمة تنقسم إلى أقسام حسب وظائفها. في الهيكل الرأسي، سيقدم المرؤوسون تقاريرهم إلى مدير واحد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Vertical Structure ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"هيكل عمودي  Vertical Structure ","nonDiacriticsLemma":"هيكل عمودي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"هيكل عمودي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bfcc7144-233f-400e-a5cc-33e5a589c76c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bfcc7144-233f-400e-a5cc-33e5a589c76c","word":"Centralized Structure","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bed7","lexicalEntryId":"bfcc7144-233f-400e-a5cc-33e5a589c76c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"هيكل مركزي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الهيكل المركزي هو المكان الذي يتم فيه اتخاذ قرارات العمل في الجزء العلوي من العمل أو في المكتب الرئيسي وتوزيعها أسفل سلسلة القيادة. غالبًا ما يستخدم في سلاسل البيع بالتجزئة حيث يتم تنفيذ الأنشطة في موقع مركزي واحد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Centralized Structure","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"هو المكان الذي يتم فيه اتخاذ قرارات العمل في الجزء العلوي من العمل أو في المكتب الرئيسي وتوزيعها أسفل سلسلة القيادة. غالبًا ما يستخدم في سلاسل البيع بالتجزئة. وهيكل مشتريات يتم فيه إجراء جميع الطلبات من نقطة مركزية واحدة -تتدفق جميع الطلبات إلى مكتب واحد، والذي يمكن أن يكون في مدينة أو منطقة أو بلد مختلف عن المولد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Centralized","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"هيكل مركزي  Centralized Structure Centralized","nonDiacriticsLemma":"هيكل مركزي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"هيكل مركزي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

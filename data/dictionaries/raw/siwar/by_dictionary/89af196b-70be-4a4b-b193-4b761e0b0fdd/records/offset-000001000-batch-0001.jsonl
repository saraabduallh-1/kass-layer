{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f2fca43f-ac47-4cdf-b6da-080d22b7b5b8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f2fca43f-ac47-4cdf-b6da-080d22b7b5b8","word":"E-Sourcing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b852","lexicalEntryId":"f2fca43f-ac47-4cdf-b6da-080d22b7b5b8","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تحديد المصادر الإلكترونية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو عملية تجارية للبحث عن الموردين الحاليين والمحتملين وتقييمهم واختيارهم والتعاون معهم. يضيف E-Sourcing ببساطة بعدًا إلكترونيًا للأعمال التي يتم إجراؤها عبر الإنترنت في نظام أساسي قائم على الويب، وهو المعيار في عالم اليوم للرقمة.  أي انها الأنظمة الإلكترونية التي تدعم مراحل دورة الشراء من تحديد الحاجة إلى اختيار المورد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"E-Sourcing","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تحديد المصادر الإلكترونية  E-Sourcing","nonDiacriticsLemma":"تحديد المصادر الإلكترونية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تحديد المصادر الإلكترونية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

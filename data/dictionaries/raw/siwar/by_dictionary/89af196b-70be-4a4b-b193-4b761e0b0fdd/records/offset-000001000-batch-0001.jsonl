eriodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تحديد تردد الراديو "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

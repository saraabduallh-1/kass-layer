{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cc96eb50-78b0-4498-8559-19b00c2558aa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cc96eb50-78b0-4498-8559-19b00c2558aa","word":"Cost Avoidance","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b84c","lexicalEntryId":"cc96eb50-78b0-4498-8559-19b00c2558aa","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تجنب التكلفة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تجنب التكلفة هو الحفاظ على الإنفاق الحالي لمنع ارتفاع الأسعار بسبب التضخم أو الاقتصاد أو ارتفاع تكاليف المنتجات أو الخدمات. مثال على تجنب التكلفة هو عندما تشتري الشركة ضمانًا موسعًا للمعدات للحد من تكاليف الصيانة أو المصاريف النثرية.  وكذلك الحد من الزيادات المحتملة في التكلفة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Cost Avoidance","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تجنب التكلفة  Cost Avoidance","nonDiacriticsLemma":"تجنب التكلفة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تجنب التكلفة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4b561f0b-8c1e-43b0-9feb-c17034749f56/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4b561f0b-8c1e-43b0-9feb-c17034749f56","word":"Kitting","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b84d","lexicalEntryId":"4b561f0b-8c1e-43b0-9feb-c17034749f56","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تجهيز","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"التجهيز في اللوجستيات هو عملية تجميع منتجات متعددة في \"مجموعة\" واحدة يتم شحنها إلى العميل. يمكن للشركات والشركات اللوجستية تبسيط عمليات الشحن، وخفض تكاليف الشحن، وتنفيذ الطلبات بسرعة أكبر باستخدام التجهيز.  وتعرف ايضاً بانها نشاط في مستودع أو مخزن لتجميع مجموعات العناصر التي سيتم استخدامها معًا -يتم إنشاء \"مجموعة من العناصر\" لمهمة محددة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Kitting","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تجهيز  Kitting","nonDiacriticsLemma":"تجهيز","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تجهيز"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/28066188-c613-4b24-b28d-74a5c1ada15f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"28066188-c613-4b24-b28d-74a5c1ada15f","word":"Fragmentation","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b84e","lexicalEntryId":"28066188-c613-4b24-b28d-74a5c1ada15f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تجزئة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تحدث التجزئة عندما لا يكون هناك قائد واضح داخل الصناعة. هذا يعني أنه في حين أن العديد من الشركات قد تعمل في صناعة معينة، لا يمتلك أي منها حصة كافية في السوق للتأثير على الأسعار والإنتاج والاستثمار والمنافسة.  وتعرف أيضا بأنها عملية أو حالة الانكسار أو الانقسام إلى أجزاء","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Fragmentation","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"التجزئة هو عملية تقسيم السوق المستهدف للشركة إلى مجموعات من العملاء المحتملين ذوي الاحتياجات والسلوكيات المتشابهة. يساعد القيام بذلك الشركة على البيع لكل مجموعة عملاء باستخدام استراتيجيات مميزة مصممة خصيصًا لاحتياجاتهم.  أي يفحص التقسيم مجموعة من العملاء أو الموردين ويقسم المجموعة إلى مجموعة فرعية أصغر بناءً على الخصائص المحددة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Segmentation","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تجزئة  Fragmentation Segmentation","nonDiacriticsLemma":"تجزئة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تجزئة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bf71ffaf-6bd7-4306-84d9-cd44f40e4026/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bf71ffaf-6bd7-4306-84d9-cd44f40e4026","word":"Kanban","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc97","lexicalEntryId":"bf71ffaf-6bd7-4306-84d9-cd44f40e4026","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"كانبان","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"Kanban (اليابانية للتوقيع) هو نظام مراقبة المخزون المستخدم في التصنيع في الوقت المناسب (JIT) لتتبع الإنتاج وطلب شحنات جديدة من الأجزاء والمواد. تم تطوير Kanban بواسطة Taiichi Ohno، وهو مهندس صناعي في Toyota، ويستخدم إشارات مرئية لتحفيز الإجراء اللازم للحفاظ على تدفق العملية.  أي انه نظام جدولة يدعم عمليات التصنيع \"Lean\" و \"في الوقت المناسب\"، ويستخدم للإشارة عندما يكون المخزون منخفضًا ويؤدي إلى إعادة ترتيب المواد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Kanban","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"كانبان  Kanban","nonDiacriticsLemma":"كانبان","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"كانبان"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5acf8dde-1057-4907-aa37-bd4810c4fae7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5acf8dde-1057-4907-aa37-bd4810c4fae7","word":"Kaizen","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc98","lexicalEntryId":"5acf8dde-1057-4907-aa37-bd4810c4fae7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"كايزن","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"كايزن هي فلسفة عمل يابانية تركز على تحسين الإنتاجية تدريجيًا من خلال إشراك جميع الموظفين ومن خلال جعل بيئة العمل أكثر كفاءة. تترجم كايزن إلى \"التغيير للأفضل\" أو \"التحسين المستمر\".  فهي كلمة يابانية للتحسين؛ المنهجية المستخدمة للإشارة إلى التحسينات الصغيرة المستمرة في جميع جوانب المنظمة مثل التكنولوجيا والعمليات والجودة والثقافة التنظيمية والسلامة والقيادة والإنتاجية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Kaizen","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"كايزن  Kaizen","nonDiacriticsLemma":"كايزن","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"كايزن"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/92a0baec-52de-4cac-9ea5-b9728dedbdaa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"92a0baec-52de-4cac-9ea5-b9728dedbdaa","word":"Trade Bloc","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc99","lexicalEntryId":"92a0baec-52de-4cac-9ea5-b9728dedbdaa","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"كتلة تجارية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الكتلة التجارية هي عائق آخر محتمل للتجارة الدولية. الكتلة التجارية هي مجموعة من البلدان التي تعمل معًا لتقديم صفقات خاصة للتداول. هذا يعزز التجارة بين دول محددة داخل الكتلة. يعتبر الاتحاد الأوروبي (EU) مثالاً على الكتلة التجارية.  أي انها مجموعة اقتصادية، تتكون من دول مختلفة في منطقة جغرافية، لخلق ظروف تجارية تفضيلية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Trade Bloc  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"كتلة تجارية  Trade Bloc  ","nonDiacriticsLemma":"كتلة تجارية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"كتلة تجارية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

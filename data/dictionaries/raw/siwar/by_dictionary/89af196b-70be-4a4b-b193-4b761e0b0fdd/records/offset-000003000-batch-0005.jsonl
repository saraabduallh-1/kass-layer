{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/78e69594-0266-40a7-ae71-d59619ba2e2c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"78e69594-0266-40a7-ae71-d59619ba2e2c","word":"Whistleblowing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc93","lexicalEntryId":"78e69594-0266-40a7-ae71-d59619ba2e2c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"كاشف الفساد","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المُبلغ عن المخالفات، وهو فرد يكشف، بدون تصريح، عن معلومات خاصة أو سرية حول منظمة، وعادة ما تكون مرتبطة بارتكاب مخالفات أو سوء سلوك. يذكر المخبرون عمومًا أن مثل هذه الإجراءات مدفوعة بالالتزام بالصالح العام.  أي الإبلاغ عن المعلومات المتعلقة بالمخالفات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Whistleblowing ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"كاشف الفساد  Whistleblowing ","nonDiacriticsLemma":"كاشف الفساد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"كاشف الفساد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5ea8c9f3-6f8c-4019-bb84-2d42e0964f8b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5ea8c9f3-6f8c-4019-bb84-2d42e0964f8b","word":"Market Testing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b664","lexicalEntryId":"5ea8c9f3-6f8c-4019-bb84-2d42e0964f8b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"اختبار السوق","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وفقًا لتعريف موسوعة رواد الأعمال، يُعرَّف اختبار السوق بأنه طريقة \"لاختبار سيناريوهات تسويق متعددة واختيار أكثر السيناريوهات الواعدة للتوسع\". من منظور الشخص العادي، يعد اختبار السوق طريقة لاختبار المياه لمعرفة مدى جودة أداء المنتج أو الخدمة أو العرض أو لا.  وتقييم مستوى المنافسة وقدرات الموردين ضمن مجال اختصاص محدد أو قطاع صناعي أو منطقة جغرافية.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Market Testing","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"اختبار السوق  Market Testing","nonDiacriticsLemma":"اختبار السوق","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اختبار السوق"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

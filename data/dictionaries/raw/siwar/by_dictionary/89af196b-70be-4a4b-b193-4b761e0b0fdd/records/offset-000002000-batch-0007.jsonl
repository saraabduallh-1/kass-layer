{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/604e2a27-0d7f-4ebe-8ca7-a913b36a58a9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"604e2a27-0d7f-4ebe-8ca7-a913b36a58a9","word":"Value Chain","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bae2","lexicalEntryId":"604e2a27-0d7f-4ebe-8ca7-a913b36a58a9","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"سلسلة القيم","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشير مصطلح سلسلة القيمة إلى الأنشطة والعمليات التجارية المختلفة التي ينطوي عليها إنشاء منتج أو أداء خدمة. يمكن أن تتكون سلسلة القيمة من مراحل متعددة من دورة حياة المنتج أو الخدمة، بما في ذلك البحث والتطوير والمبيعات وكل شيء بينهما.  وهو نموذج عمل أنشأه مايكل بوتر يحدد الأنشطة المتسلسلة المطلوبة لإنشاء منتج أو خدمة تقدم قيمة للعملاء.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Value Chain","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"سلسلة القيم  Value Chain","nonDiacriticsLemma":"سلسلة القيم","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"سلسلة القيم"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

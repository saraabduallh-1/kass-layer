{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4fab1ca1-67f5-4536-9922-69cba62d6619/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4fab1ca1-67f5-4536-9922-69cba62d6619","word":"Major Breach","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba6b","lexicalEntryId":"4fab1ca1-67f5-4536-9922-69cba62d6619","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خرق كبير","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يعد خرق العقد انتهاكًا لأي من البنود والشروط المتفق عليها لعقد ملزم. يمكن أن يكون الخرق أي شيء من تأخر السداد إلى انتهاك أكثر خطورة مثل عدم تسليم الأصل الموعود.  ويُعرف أحيانًا باسم الانتهاك الجوهري أو الانتهاك الكامل، وهذا هو المكان الذي يكون فيه لعدم اتخاذ إجراء من قبل الطرف المتخلف تأثير كبير على العقد، لدرجة أنه لا يمكن الوفاء بالغرض من العقد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Major Breach","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"خرق كبير  Major Breach","nonDiacriticsLemma":"خرق كبير","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خرق كبير"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5385e41d-c4b4-4b37-897a-53fb913099fa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5385e41d-c4b4-4b37-897a-53fb913099fa","word":"Minor Breach","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba69","lexicalEntryId":"5385e41d-c4b4-4b37-897a-53fb913099fa","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خرق بسيط","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشار إليه أيضًا باسم الانتهاك الجزئي، وهو خرق للعقد يكون أقل خطورة من الانتهاك الجوهري ويمنح الطرف المتضرر الحق في رفع دعوى للحصول على تعويضات ولكنه لا يعفيه عادةً من مزيد من الأداء. يؤدي الخرق الفعلي للعقد دائمًا إلى حدوث أضرار.  أي عدم تنفيذ شرط من العقد لا يؤثر على الأداء النهائي للعقد بأي طريقة مهمة، ما لم ينص صراحة على ذلك","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Minor Breach","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"خرق بسيط  Minor Breach","nonDiacriticsLemma":"خرق بسيط","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خرق بسيط"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4ccacba8-5408-4ada-be02-ed56257ff817/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4ccacba8-5408-4ada-be02-ed56257ff817","word":"Life Cycle","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba60","lexicalEntryId":"4ccacba8-5408-4ada-be02-ed56257ff817","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"دورة الحياة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في مجال الأعمال، تعد دورة الحياة طريقة لوصف الولادة والنمو والنضج والانحدار النهائي لمنتج أو خدمة. من خلال فهم تسلسل الأحداث في دورة الحياة، يمكن للشركات اتخاذ قرارات مالية أفضل.  أي انها المراحل التي يمر بها المنتج، من المفهوم الأولي إلى التراجع والإزالة من السوق","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Life Cycle","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"دورة الحياة  Life Cycle","nonDiacriticsLemma":"دورة الحياة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"دورة الحياة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

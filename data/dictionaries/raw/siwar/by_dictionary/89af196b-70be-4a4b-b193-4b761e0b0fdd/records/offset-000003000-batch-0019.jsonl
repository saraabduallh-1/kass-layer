{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eb981b7b-b8a9-4f15-a474-954eace0ce93/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eb981b7b-b8a9-4f15-a474-954eace0ce93","word":"Inter-Governmental Organizations (IGOs)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bdfc","lexicalEntryId":"eb981b7b-b8a9-4f15-a474-954eace0ce93","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منظمات الحكومية الدولية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشير مصطلح منظمة حكومية دولية (IGO) إلى كيان تم إنشاؤه بموجب معاهدة، تضم دولتين أو أكثر، للعمل بحسن نية، بشأن القضايا ذات الاهتمام المشترك. في حالة عدم وجود معاهدة لا يوجد IGO بالمعنى القانوني. يشير هذا إلى المنظمات المكونة من حكومتين أو أكثر، والتي تشمل جميع وكالات الأمم المتحدة والمنظمات الإقليمية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Inter-Governmental Organizations (IGOs)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منظمات الحكومية الدولية  Inter-Governmental Organizations (IGOs)","nonDiacriticsLemma":"منظمات الحكومية الدولية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منظمات الحكومية الدولية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bd4766a3-6d53-4432-ac3a-581e19c0f29e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bd4766a3-6d53-4432-ac3a-581e19c0f29e","word":"International Organization For Standardization","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be03","lexicalEntryId":"bd4766a3-6d53-4432-ac3a-581e19c0f29e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منظمة دولية للمقاييس","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المنظمة الدولية للتوحيد القياسي (ISO) هي منظمة دولية غير حكومية تتكون من هيئات المعايير الوطنية؛ تقوم بتطوير ونشر مجموعة واسعة من معايير الملكية والصناعية والتجارية وتتألف من ممثلين من مختلف منظمات المعايير الوطنية. أي أنها هيئة دولية تهدف إلى إنشاء مجموعة من المعايير الموحدة التي يمكن للشركات التجارية المختلفة العمل عليها دون سوء فهم","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"International Organization For Standardization","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منظمة دولية للمقاييس  International Organization For Standardization","nonDiacriticsLemma":"منظمة دولية للمقاييس","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منظمة دولية للمقاييس"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f1d66679-2b98-4fdc-ae4d-6e198d312770/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f1d66679-2b98-4fdc-ae4d-6e198d312770","word":"Non-Governmental Organization  (NGO)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be04","lexicalEntryId":"f1d66679-2b98-4fdc-ae4d-6e198d312770","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منظمة غير حكومية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المنظمة غير الحكومية (NGO) هي مجموعة غير ربحية تعمل بشكل مستقل عن أي حكومة. المنظمات غير الحكومية، التي تسمى أحيانًا المجتمعات المدنية، يتم تنظيمها على المستويات المجتمعية والوطنية والدولية لخدمة هدف اجتماعي أو سياسي مثل القضايا الإنسانية أو البيئة. وعادة ما تكون غير ربحية. لها دور مهم في التنمية الاقتصادية للبلدان النامية. يقدمون المساعدة عند حدوث كوارث وطنية، ويقدمون خدمات الرفاهية لتنمية المجتمع. ومن الأمثلة على ذلك الصليب الأحمر وأوكسفام وغرينبيس والصندوق العالمي للحياة البرية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Non-Governmental Organization  (NGO)  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منظمة غير حكومية  Non-Governmental Organization  (NGO)  ","nonDiacriticsLemma":"منظمة غير حكومية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منظمة غير حكومية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

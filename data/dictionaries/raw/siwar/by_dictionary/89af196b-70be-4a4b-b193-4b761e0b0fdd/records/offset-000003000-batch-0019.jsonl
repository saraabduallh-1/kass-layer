{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4723a9a4-ef41-4a23-8ae6-1d9d2cdca6e7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4723a9a4-ef41-4a23-8ae6-1d9d2cdca6e7","word":"International Procurement Organizations (Ipos)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bdfe","lexicalEntryId":"4723a9a4-ef41-4a23-8ae6-1d9d2cdca6e7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منظمات مشتريات دولية ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي منظمة تسعى إلى تحديد مصنعي المنتجات الأكثر فعالية من حيث التكلفة في جميع أنحاء العالم. ستقوم منظمة المشتريات الدولية بعد ذلك بنقل هذه المعلومات إلى الشركات المصنعة التي تتطلع إلى خفض تكاليف الإنتاج. المنظمات التي تتطلع إلى تحديد الشركات المصنعة للمنتجات الأكثر فعالية من حيث التكلفة في جميع أنحاء العالم. ثم يرسلون هذه المعلومات إلى الشركات المصنعة التي تتطلع إلى تقليل تكاليف الإنتاج","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":" International Procurement Organizations (Ipos)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منظمات مشتريات دولية    International Procurement Organizations (Ipos)","nonDiacriticsLemma":"منظمات مشتريات دولية ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منظمات مشتريات دولية "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/12128f34-014f-4a9c-8cec-17ca47cc6ed2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"12128f34-014f-4a9c-8cec-17ca47cc6ed2","word":"WTO","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bdff","lexicalEntryId":"12128f34-014f-4a9c-8cec-17ca47cc6ed2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منظمة التجارة العالمية ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منظمة التجارة العالمية (WTO) هي المنظمة الدولية العالمية الوحيدة التي تتعامل مع قواعد التجارة بين الدول. في جوهرها تكمن اتفاقيات منظمة التجارة العالمية، التي تم التفاوض عليها وتوقيعها من قبل غالبية الدول التجارية في العالم وصدقت عليها في برلماناتها.  أي المنظمة الدولية العالمية الوحيدة التي تتعامل مع قواعد التجارة بين الدول","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"WTO","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منظمة التجارة العالمية   WTO","nonDiacriticsLemma":"منظمة التجارة العالمية ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منظمة التجارة العالمية "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d8ca9249-ba85-4ffa-835d-fa5feca7b119/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d8ca9249-ba85-4ffa-835d-fa5feca7b119","word":"Organization For Economic Co-Operation And Development (OECD)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be00","lexicalEntryId":"d8ca9249-ba85-4ffa-835d-fa5feca7b119","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منظمة التعاون الاقتصادي والتنمية ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"منظمة التعاون الاقتصادي والتنمية (OECD) هي منظمة دولية تعمل على بناء سياسات أفضل من أجل حياة أفضل. هدفنا هو تشكيل السياسات التي تعزز الرخاء والمساواة والفرص والرفاهية للجميع.  أي انه منظمة حكومية دولية تهدف إلى تعزيز المصالح الاقتصادية والتقدم من خلال مقارنة السياسات والعمل كمنتدى للدول الأعضاء","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Organization For Economic Co-Operation And Development (OECD)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منظمة التعاون الاقتصادي والتنمية   Organization For Economic Co-Operation And Development (OECD)","nonDiacriticsLemma":"منظمة التعاون الاقتصادي والتنمية ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منظمة التعاون الاقتصادي والتنمية "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/af2282ce-699b-4fce-b5c6-707b5ec46601/get-public-entry"},"browse_index_record":{"lexicalEntryId":"af2282ce-699b-4fce-b5c6-707b5ec46601","word":"Quarantine Area","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bdf5","lexicalEntryId":"af2282ce-699b-4fce-b5c6-707b5ec46601","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منطقة الحجر الصحي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي فترة عزل أو حبس، خاصة. الأشخاص أو الحيوانات القادمة من الخارج لمنع انتشار المرض، وتتكون عادةً من:1- فترة الحضانة القصوى المعروفة للمرض المشتبه به. 2 -المكان أو المنطقة التي ينفذ فيها هذا الحجز. 3 -أي فترة أو حالة عزلة قسرية.  وتعرف ايضاً بأنها المساحة المخصصة للعناصر التي تنتظر الفحص أو الاختبار. قد تكون هناك أيضًا عناصر أو عناصر معيبة تنتظر إعادتها إلى المورد. الفكرة هي أن هذه العناصر يجب ألا تدخل التخزين أو يتم إتاحتها حتى يتم ترخيصها للاستخدام","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Quarantine Area  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منطقة الحجر الصحي  Quarantine Area  ","nonDiacriticsLemma":"منطقة الحجر الصحي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منطقة الحجر الصحي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/836558b5-c9fa-4028-afdd-4f05495b857d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"836558b5-c9fa-4028-afdd-4f05495b857d","word":"Fair Trade Organizations","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bdf6","lexicalEntryId":"836558b5-c9fa-4028-afdd-4f05495b857d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"منظمات التجارة العادلة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التجارة العادلة هي شراكة تجارية، تقوم على الحوار والشفافية والاحترام، وتسعى إلى مزيد من العدالة في التجارة الدولية. وهي تساهم في التنمية المستدامة من خلال توفير ظروف تجارية أفضل وتأمين حقوق المنتجين والعمال المهمشين -لا سيما في الجنوب.  فهي المنظمات التي تشارك بشكل مباشر في التجارة العادلة. يمكن أن يكونوا منتجين وبائعي سلع أو منظمات تشتري سلعًا يتم تداولها بشكل عادل. يجب أن يأتي ما لا يقل عن 50٪ من حجم مبيعاتها من المبيعات من أجل التأهل كمنظمة تجارة عادلة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Fair Trade Organizations","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"منظمات التجارة العادلة  Fair Trade Organizations","nonDiacriticsLemma":"منظمات التجارة العادلة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"منظمات التجارة العادلة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

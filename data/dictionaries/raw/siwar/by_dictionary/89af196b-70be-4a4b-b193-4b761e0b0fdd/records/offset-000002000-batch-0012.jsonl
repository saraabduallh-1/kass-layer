{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9a4f1f16-9b8d-425d-8466-fcdc9768e291/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9a4f1f16-9b8d-425d-8466-fcdc9768e291","word":"Condition-Based Maintenance (CBM)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bb5f","lexicalEntryId":"9a4f1f16-9b8d-425d-8466-fcdc9768e291","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"صيانة حسب الحالة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الصيانة التي تتم جدولتها فقط عندما تطلبها حالة النظام، وتستخدم الصيانة القائمة على الحالة (CBM) أجهزة استشعار لجمع القياسات في الوقت الفعلي (مثل الضغط أو درجة الحرارة أو الاهتزاز) على قطعة من المعدات. وتسمح بيانات تدابير بناء الثقة لموظفي الصيانة بإجراء الصيانة في اللحظة المطلوبة بالضبط، قبل حدوث العطل.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Condition-Based Maintenance (CBM)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"صيانة حسب الحالة  Condition-Based Maintenance (CBM)","nonDiacriticsLemma":"صيانة حسب الحالة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"صيانة حسب الحالة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

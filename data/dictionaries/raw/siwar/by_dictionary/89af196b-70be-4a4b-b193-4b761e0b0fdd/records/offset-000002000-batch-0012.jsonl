{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bcf6c09e-7195-4c2c-be8b-1bd4a550aaa6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bcf6c09e-7195-4c2c-be8b-1bd4a550aaa6","word":"Fair Trade","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bb50","lexicalEntryId":"bcf6c09e-7195-4c2c-be8b-1bd4a550aaa6","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"صفقة عادلة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو نظام شهادات يهدف إلى ضمان تلبية مجموعة من المعايير في إنتاج وتوريد منتج أو مكون. بالنسبة للمزارعين والعمال، تعني التجارة العادلة حقوق العمال وظروف العمل الأكثر أمانًا والأجور الأكثر عدلاً. بالنسبة للمتسوقين، فهذا يعني منتجات عالية الجودة منتجة بشكل أخلاقي.  وهي تعرف بالتجارة بين المنتجين عادة في البلدان النامية، والمصنعين، عادة في البلدان المتقدمة، مما يضمن حصول المنتجين على سعر عادل والوفاء بمعايير معينة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Fair Trade","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"صفقة عادلة  Fair Trade","nonDiacriticsLemma":"صفقة عادلة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"صفقة عادلة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

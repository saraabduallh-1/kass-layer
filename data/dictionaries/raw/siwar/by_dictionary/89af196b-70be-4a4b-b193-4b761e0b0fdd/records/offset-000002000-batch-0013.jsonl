{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/63ba31d6-d3ab-4570-815b-f44a5efd36e2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"63ba31d6-d3ab-4570-815b-f44a5efd36e2","word":"Demand Uncertainty","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bb81","lexicalEntryId":"63ba31d6-d3ab-4570-815b-f44a5efd36e2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"طلب عدم اليقين","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشير عدم اليقين في الطلب إلى العوامل الخارجية التي تتسبب في زيادة الطلب أو انخفاضه بشكل غير متوقع. يمكن أن يكون سبب هذا الموقف أزمة صحية عامة أو حتى تحول مفاجئ في أذواق العملاء. وتساعد العديد من البرامج الشركات على التنبؤ بالطلب وتطوير استراتيجيات الإنتاج وسلسلة التوريد ذات الصلة. وهي حالة تكون فيها المنظمة غير قادرة على التأكد من الطلب المستقبلي على منتجها بسبب تقلب الطلب الذي يؤثر على دقة الإنتاج","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Demand Uncertainty","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"طلب عدم اليقين  Demand Uncertainty","nonDiacriticsLemma":"طلب عدم اليقين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"طلب عدم اليقين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

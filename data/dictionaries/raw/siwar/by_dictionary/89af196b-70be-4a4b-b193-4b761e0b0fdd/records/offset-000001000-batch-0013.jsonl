{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ff659679-a01e-48d0-a2a8-e3eb6e5e1d2d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ff659679-a01e-48d0-a2a8-e3eb6e5e1d2d","word":"Desired Or Target Cost","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b97f","lexicalEntryId":"ff659679-a01e-48d0-a2a8-e3eb6e5e1d2d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة المرغوبة أو المستهدفة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"لتكلفة المستهدفة هي نهج لتحديد تكلفة دورة حياة المنتج والتي يجب أن تكون كافية لتطوير وظائف وجودة محددة، مع ضمان الربح المطلوب. يتضمن تحديد التكلفة المستهدفة عن طريق طرح هامش الربح المطلوب من سعر السوق التنافسي. ويتم الاتفاق على سعر المورد (وربحه) ويضمن المورد بعد ذلك إمكانية احتواء تكاليفه لتحقيق الهدف المقصود -قد يحفز المشتري المورد لاستكشاف طرق لخفض تكاليفه","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Desired Or Target Cost","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكلفة المرغوبة أو المستهدفة  Desired Or Target Cost","nonDiacriticsLemma":"تكلفة المرغوبة أو المستهدفة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة المرغوبة أو المستهدفة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/92914d53-4e5a-4d23-9c64-99fecec20079/get-public-entry"},"browse_index_record":{"lexicalEntryId":"92914d53-4e5a-4d23-9c64-99fecec20079","word":"Closed-Book Costing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b980","lexicalEntryId":"92914d53-4e5a-4d23-9c64-99fecec20079","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة الدفترية (الختامية) المغلقة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"حيث لا يشارك المورد تكاليفه أو هوامش الربح مع عملائه، ويوفر هذا اليقين المالي، وستستند الفواتير على التكاليف \"الفعلية\" المتكبدة (بالإضافة إلى هامش متفق عليه)، مما يعني أنها الأنسب للمشاريع التي يُتوقع أن يتغير فيها مستوى الخدمة قليلاً للغاية على مدار مدة العقد.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Closed-Book Costing","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكلفة الدفترية (الختامية) المغلقة  Closed-Book Costing","nonDiacriticsLemma":"تكلفة الدفترية الختامية المغلقة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة الدفترية (الختامية) المغلقة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d9ffb9a4-1d4d-4b2e-998d-86cec8e4958b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d9ffb9a4-1d4d-4b2e-998d-86cec8e4958b","word":"Open Book Costing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b981","lexicalEntryId":"d9ffb9a4-1d4d-4b2e-998d-86cec8e4958b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة الكتاب المفتوح","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي عملية يكون فيها المشتري والمورد على دراية بكافة التكاليف والأرباح المطلوبة لبعضهما البعض","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Open Book Costing ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"يتفق المشتري وبائع العمل / الخدمات على التكاليف التي يمكن تعويضها والربح المالي الذي يمكن للمورد إضافته إلى هذه التكاليف. حيث يتم بعد ذلك إصدار فاتورة بالمشروع إلى العميل بناءً على التكاليف الفعلية المتكبدة بالإضافة إلى هامش الربح المتفق عليه","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Open-Book Costing","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكلفة الكتاب المفتوح  Open Book Costing  Open-Book Costing","nonDiacriticsLemma":"تكلفة الكتاب المفتوح","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة الكتاب المفتوح"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/679b6aca-a12f-48f8-a5d5-8b3f3f0110dc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"679b6aca-a12f-48f8-a5d5-8b3f3f0110dc","word":"Cost Of Sales (COS)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b982","lexicalEntryId":"679b6aca-a12f-48f8-a5d5-8b3f3f0110dc","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة المبيعات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تشير تكلفة المبيعات (COS) إلى مقدار ما تنفقه تجارة التجزئة أو البيع بالجملة على المنتجات التي تشتريها من الموردين لإعادة بيعها. تظهر تكلفة المبيعات كتكلفة مباشرة في بيان الدخل. يتم استخدامه فقط من قبل الشركات التي لا تصنع منتجاتها للبيع.  فهي المواد والعمالة والتكاليف الأخرى المرتبطة مباشرة بالسلع أو الخدمات المقدمة. في منظمة غير صناعية، يكون الفرق بين المخزون الافتتاحي والمشتريات ناقصًا أي مخزون مغلق","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Cost Of Sales (COS)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكلفة المبيعات  Cost Of Sales (COS)","nonDiacriticsLemma":"تكلفة المبيعات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة المبيعات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/18cc65d0-5705-4c0c-bec4-8a21c55ed446/get-public-entry"},"browse_index_record":{"lexicalEntryId":"18cc65d0-5705-4c0c-bec4-8a21c55ed446","word":"(TCA) Total Cost Of Acquisition","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b983","lexicalEntryId":"18cc65d0-5705-4c0c-bec4-8a21c55ed446","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة إجمالية للاكتساب","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي مفهوم محاسبة إدارية يشمل جميع التكاليف المرتبطة بشراء السلع أو الخدمات أو الأصول.\r\nبشكل عام، هو السعر الصافي بالإضافة إلى التكاليف الأخرى اللازمة لشراء العنصر وإيصاله إلى نقطة الاستخدام. أي التكلفة الإجمالية المتكبدة في الحصول على منتج من المصادر إلى الاستلام والتركيب","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"(TCA) Total Cost Of Acquisition  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكلفة إجمالية للاكتساب  (TCA) Total Cost Of Acquisition  ","nonDiacriticsLemma":"تكلفة إجمالية للاكتساب","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة إجمالية للاكتساب"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a8b3e477-2c08-46ed-b2ad-b7f50cf04bd3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a8b3e477-2c08-46ed-b2ad-b7f50cf04bd3","word":"(CPFF)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b984","lexicalEntryId":"a8b3e477-2c08-46ed-b2ad-b7f50cf04bd3","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة بالإضافة إلى الرسوم الثابتة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"عقد التكلفة بالإضافة إلى الرسوم الثابتة هو نوع محدد من العقود حيث يتم دفع المتعاقد \r\nالمصروفات العادية لمشروع ما، بالإضافة إلى رسوم ثابتة إضافية مقابل خدماتهم. ويسمح ذلك للمتعهد بتحصيل ربح من المشروع، ويشجع الإنتاج الاقتصادي في مختلف الصناعات، أي انه نوع من العقود يتم فيه دفع رسوم ثابتة متفق عليها للمتعهد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":" (CPFF)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكلفة بالإضافة إلى الرسوم الثابتة   (CPFF)","nonDiacriticsLemma":"تكلفة بالإضافة إلى الرسوم الثابتة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة بالإضافة إلى الرسوم الثابتة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

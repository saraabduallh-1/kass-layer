{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0870ab3a-cbe4-4213-ae6e-811ef60168d1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0870ab3a-cbe4-4213-ae6e-811ef60168d1","word":"Activity-Based Costing(ABC)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b988","lexicalEntryId":"0870ab3a-cbe4-4213-ae6e-811ef60168d1","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة على أساس النشاط","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وهي طريقة محاسبية تحمل التكاليف لجميع الأنشطة العامة (غير المباشرة) على تكلفة المنتجات (المباشرة). أي تخصيص أو تحميل التكلفة اعتماداً على الأنشطة التي تسببت في حدوثها، بدلاً من تحميلها بشكل مباشر على المنتجات أو الخدمات، وغيرها.  وتتميز هذه الطريقة المحاسبية أنه لا يتم فقد لأي تكاليف ويمكن رؤية التوازن بين أنشطة التكلفة المباشرة وغير المباشرة بوضوح. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Activity-Based Costing(ABC)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكلفة على أساس النشاط  Activity-Based Costing(ABC)","nonDiacriticsLemma":"تكلفة على أساس النشاط","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة على أساس النشاط"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

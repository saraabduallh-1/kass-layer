{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7b3e817f-b19d-4693-a868-4c126a0fa69c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7b3e817f-b19d-4693-a868-4c126a0fa69c","word":"Work Tactics","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b978","lexicalEntryId":"7b3e817f-b19d-4693-a868-4c126a0fa69c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكتيكات العمل","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تكتيكات العمل هي خطط قصيرة المدى لا تنحرف عن الاستراتيجية الشاملة. هذه هي الإجراءات التي تؤثر على نجاح أو فشل استراتيجية العمل. نظرًا لأنها تحدد إجراءً ما، فإنها غالبًا ما تكون محدودة زمنياً ويمكن أن تكون سلسة للغاية.  أي الأنشطة والإجراءات التشغيلية الأساسية التي تجعل الاستراتيجية حقيقة واقعة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Work Tactics","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكتيكات العمل  Work Tactics","nonDiacriticsLemma":"تكتيكات العمل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكتيكات العمل"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/146ebaf2-b49f-4c3c-8d06-ec51ca3fba31/get-public-entry"},"browse_index_record":{"lexicalEntryId":"146ebaf2-b49f-4c3c-8d06-ec51ca3fba31","word":"Cost","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b979","lexicalEntryId":"146ebaf2-b49f-4c3c-8d06-ec51ca3fba31","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" التكلفة في شركة تجارية هي المصاريف التي تتحملها الشركة في محاولة لبيع منتج أو خدمة. تشمل هذه التكاليف أشياء مثل إيجار مساحة للبيع بالتجزئة، والاستثمارات في تجديد المخزون، والأجور المدفوعة للموظفين. فهو مبلغ المال المستخدم في صنع منتج أو تقديم خدمة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Cost","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"هي مصطلح يستخدم بشكل أساسي في محاسبة التكاليف لوصف شيء يتم تخصيص التكاليف له. الأمثلة الشائعة لكائنات التكلفة فهي خطوط الإنتاج أو المناطق الجغرافية أو العملاء أو الأقسام أو أي شيء آخر ترغب الإدارة في تحديد التكلفة له","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Cost Object","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تكلفة  Cost Cost Object","nonDiacriticsLemma":"تكلفة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8fef3562-8b6f-45e5-8c10-feb8480ef422/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8fef3562-8b6f-45e5-8c10-feb8480ef422","word":"Systems Integration","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b97a","lexicalEntryId":"8fef3562-8b6f-45e5-8c10-feb8480ef422","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكامل النظم","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تكامل أنظمة الأعمال هو عملية دمج المعلومات والبيانات من جميع أنحاء الشركة في موقع واحد يسهل الوصول إليه. الهدف من تكامل أنظمة الأعمال هو ربط الأنظمة الداخلية، مثل تتبع عدد العملاء الجدد، بأجهزة جمع البيانات الخاصة بالشركة. أي عملية تجميع عدد من الأنظمة الفرعية في نظام واحد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Systems Integration  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكامل النظم  Systems Integration  ","nonDiacriticsLemma":"تكامل النظم","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكامل النظم"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/11abb049-d222-4d28-8444-a52b180fc245/get-public-entry"},"browse_index_record":{"lexicalEntryId":"11abb049-d222-4d28-8444-a52b180fc245","word":"Total Cost","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b97b","lexicalEntryId":"11abb049-d222-4d28-8444-a52b180fc245","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكلفة الإجمالية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التكلفة الإجمالية (TC) بأبسط العبارات هي جميع التكاليف المتكبدة في إنتاج شيء ما أو الانخراط في نشاط. في علم الاقتصاد، تتكون التكلفة الإجمالية من التكاليف المتغيرة + التكاليف الثابتة. التكاليف المتغيرة (VC) هي التكاليف التي تتغير بناءً على عدد السلع التي تنتجها أو مقدار الخدمة التي تستخدمها.  وهي التكلفة الحقيقية للمنتج، ليس فقط على أساس سعره ولكن على جميع تكاليف شراء المنتج وصيانته طوال الوقت الذي تمتلكه فيه الشركة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Total Cost","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكلفة الإجمالية  Total Cost","nonDiacriticsLemma":"تكلفة الإجمالية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكلفة الإجمالية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ca4584da-edc2-4760-a42d-5227a7ef8754/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ca4584da-edc2-4760-a42d-5227a7ef8754","word":"Vertical Integration Of Diversity","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b97c","lexicalEntryId":"ca4584da-edc2-4760-a42d-5227a7ef8754","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكامل رأسي للتنوع","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التنويع العمودي هو أحد أهم استراتيجيات التنويع والتوسع. في هذا، تتوسع الشركة إما في الاتجاه الأمامي أو الخلفي. في الأساس، في ظل هذا التنويع، تحاول الشركة جعل وجودها في سلسلة التوريد، إما عن طريق الاستحواذ على مورد أو عميل، أو كليهما.  ويعرف ايضاً بأنه الدرجة التي تساهم بها ممارسة التنوع والعمليات الإدارية المرتبطة بها في المنظمة في الأهداف الاستراتيجية المحددة في استراتيجية العمل. هذا يشير إلى فعالية استراتيجية التنوع","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Vertical Integration Of Diversity ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكامل رأسي للتنوع  Vertical Integration Of Diversity ","nonDiacriticsLemma":"تكامل رأسي للتنوع","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكامل رأسي للتنوع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ef5f5b47-ab40-422e-96e0-8536f6a812b5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ef5f5b47-ab40-422e-96e0-8536f6a812b5","word":"Vertical Integration","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b97d","lexicalEntryId":"ef5f5b47-ab40-422e-96e0-8536f6a812b5","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكامل رأسي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"التكامل رأسي هو استراتيجية تسمح للشركة بتبسيط عملياتها من خلال تولي الملكية المباشرة لمختلف مراحل عملية الإنتاج الخاصة بها بدلاً من الاعتماد على المتعاقدين أو الموردين الخارجيين. أي عندما يمتلك المشتري شركات ضمن سلسلة التوريد الخاصة به. يمكن أن يكون هناك تكامل رأسي أمامي حيث يمتلك المشتري موزعًا، أو تكاملًا رأسيًا متخلفًا حيث يمتلك المشتري أحد مورديه للمواد الخام أي عندما تمتلك مؤسسة في سلسلة التوريد موردًا آخر واحدًا على الأقل، مما يزيد من سيطرة المنظمة على عمليات التصنيع أو التوزيع","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Vertical Integration  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكامل رأسي  Vertical Integration  ","nonDiacriticsLemma":"تكامل رأسي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكامل رأسي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5661eb4f-9dbe-443d-bff7-d69d0e35ea0e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5661eb4f-9dbe-443d-bff7-d69d0e35ea0e","word":"Supplier Appraisal","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b95d","lexicalEntryId":"5661eb4f-9dbe-443d-bff7-d69d0e35ea0e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تقييم المورد","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تقييم قدرة المورد المحتمل على التحكم في الجودة والتسليم والكمية والسعر وجميع العوامل الأخرى التي يجب تضمينها في العقد. موافقة المورد وضع مؤسسة على قائمة الموردين المعتمدة بعد عملية تقييم المورد.  أي تقييم قدرة المورد المحتمل على التحكم في الجودة والتسليم والكمية والسعر وجميع العوامل الأخرى التي يجب تضمينها في العقد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Supplier Appraisal","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"تقييم المورد هو عملية تقييم الموردين المحتملين والموافقة عليهم من خلال التقييمات الكمية والنوعية. والغرض من ذلك هو تجميع قائمة بأفضل الموردين المتاحين.  أي العمليات المستخدمة لتقييم استجابات الموردين مقابل مجموعة محددة من المعايير التي يمكن ترجيحها للإشارة إلى الأهمية النسبية لمعايير معينة. عادةً ما تتضمن هذه العملية مجموعة من أصحاب المصلحة الداخليين الذين يقدمون تقييمات فردية يتم إضافتها معًا لتوفير قائمة مرتبة بالموردين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Supplier Evaluation","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تقييم المورد  Supplier Appraisal Supplier Evaluation","nonDiacriticsLemma":"تقييم المورد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تقييم المورد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

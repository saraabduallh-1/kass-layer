{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5bf4a239-b59a-4b7d-9c68-0146c4bf1352/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5bf4a239-b59a-4b7d-9c68-0146c4bf1352","word":"Employer Brand","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbd4","lexicalEntryId":"5bf4a239-b59a-4b7d-9c68-0146c4bf1352","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"علامة تجارية لصاحب العمل\t","lemmaType":"MWE","pattern":" ","senses":[{"definition":"العلامة التجارية لصاحب العمل هي استراتيجية اتصال تركز على موظفي الشركة والموظفين المحتملين. فهو يجمع بين جميع عناصر العلامات التجارية والاتصالات التي تهدف إلى تعزيز قيمة الانتماء إلى شركة، مع الهدف النهائي المتمثل في الاحتفاظ بالموهبة وجذبها. سمعة المنظمة كمكان جيد للعمل، بما في ذلك عرض قيمة الموظف المرتبط بقيم المنظمة، مما يمكنها من التنافس على أفضل المواهب","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Employer Brand","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"علامة تجارية لصاحب العمل\t  Employer Brand","nonDiacriticsLemma":"علامة تجارية لصاحب العمل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"علامة تجارية لصاحب العمل\t"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/47b19dd5-93da-409c-9ce4-9ad6b4ebdcdd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"47b19dd5-93da-409c-9ce4-9ad6b4ebdcdd","word":"Partnership Relationship","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbd5","lexicalEntryId":"47b19dd5-93da-409c-9ce4-9ad6b4ebdcdd","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"علاقة الشراكة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الشراكة هي ترتيب بين شخصين أو أكثر للإشراف على العمليات التجارية ومشاركة أرباحها والتزاماتها. في شركة الشراكة العامة، يتشارك جميع الأعضاء في الأرباح والالتزامات. غالبًا ما يشكل المحترفون مثل الأطباء والمحامين شراكة ذات مسؤولية محدودة.  أي التزام بين منظمة شراء ومورد يدخل في علاقة تعاونية طويلة الأمد مبنية على الثقة والأهداف المتفق عليها بشكل متبادل لصالح الطرفين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Partnership Relationship  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"علاقة الشراكة  Partnership Relationship  ","nonDiacriticsLemma":"علاقة الشراكة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"علاقة الشراكة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

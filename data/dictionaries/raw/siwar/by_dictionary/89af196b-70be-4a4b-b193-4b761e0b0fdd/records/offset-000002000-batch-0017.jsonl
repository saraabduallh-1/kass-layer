{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/aba33c5c-3e5a-4ec6-9c84-418af89696bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"aba33c5c-3e5a-4ec6-9c84-418af89696bf","word":"Rapport","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbcd","lexicalEntryId":"aba33c5c-3e5a-4ec6-9c84-418af89696bf","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"علاقة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يعني اتخاذ إجراء لإنشاء اتصال متناغم أو متعاطف مع شخص آخر. هذه العلاقات لا تحدث خاصة إذا كنت تبني علاقة في المبيعات. يعد التواصل مع الآخرين مهارة عمل استراتيجية، ويتطلب بناءها عملاً.  أي علاقة وثيقة ومتناغمة يفهم فيها الأشخاص في المجموعات المعنية مشاعر أو أفكار بعضهم البعض ويتواصلون بشكل جيد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Rapport  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"علاقة  Rapport  ","nonDiacriticsLemma":"علاقة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"علاقة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/352e648f-2938-4b22-bb62-e9a141630937/get-public-entry"},"browse_index_record":{"lexicalEntryId":"352e648f-2938-4b22-bb62-e9a141630937","word":"Arm’s-Length Relationship","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbce","lexicalEntryId":"352e648f-2938-4b22-bb62-e9a141630937","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"علاقة الاستقلالية ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي علاقة تجارية بين المشتري والمورد بشكل مستقل أو تتميز بالاستقلالية. وتكون محور العلاقة هو تبادل أوامر الشراء والفواتير وهذا النوع من العلاقات هو عكس العلاقة التعاونية أو الشراكة. أي تشير إلى المعاملة التي تتم على أساس تجاري بحت أو صفقة تجارية يتصرف فيها المشترون والبائعون بشكل مستقل دون أن يؤثر أحد الطرفين على الآخر.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Arm’s-Length Relationship","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"علاقة الاستقلالية   Arm’s-Length Relationship","nonDiacriticsLemma":"علاقة الاستقلالية ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"علاقة الاستقلالية "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fc37953c-10fe-49cf-a0d3-7e8a4f983f25/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fc37953c-10fe-49cf-a0d3-7e8a4f983f25","word":"Exclusive Relationship","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbcf","lexicalEntryId":"fc37953c-10fe-49cf-a0d3-7e8a4f983f25","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"علاقة حصرية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اتفاقيات الشركاء الحصرية. تمنح الاتفاقيات الحصرية البائعين وشركائهم فرصة للعمل مع بعضهم البعض لفترة زمنية معينة دون تدخل المنافس. عندما توقع اتفاقية حصرية، يعمل كلاكما معًا في سوق معين لبيع منتج أو خدمة.  أي عندما تلتزم المؤسسة المشترية تعاقديًا بشراء الخدمات المعنية فقط من المورد المحدد، أو عندما يلتزم المورد ببيع الخدمات المحددة فقط إلى المؤسسة المشترية الواحدة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Exclusive Relationship","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"علاقة حصرية  Exclusive Relationship","nonDiacriticsLemma":"علاقة حصرية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"علاقة حصرية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fe0c01ec-9666-49c5-94ad-2329d15fa59b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fe0c01ec-9666-49c5-94ad-2329d15fa59b","word":"Strategic Supplier Relationship","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbd0","lexicalEntryId":"fe0c01ec-9666-49c5-94ad-2329d15fa59b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"علاقة المورد الاستراتيجي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الموردين الاستراتيجيين، وبالتالي من خلال التعريف علاقات الموردين الاستراتيجية، هم أولئك الذين يلبون مجموعة من. المعايير التي تجمع بين مستوى الإنفاق والمخاطر والنطاق والمواءمة والمدة وإمكانية العلاقة. تقديم المزيد من القيمة.  أي نوع من العلاقة التي تنطوي على شبكة متماسكة من الموردين الذين يتعلمون باستمرار ويتطورون ويزدهرون جنبًا إلى جنب مع المشتري","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Strategic Supplier Relationship","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"علاقة المورد الاستراتيجي  Strategic Supplier Relationship","nonDiacriticsLemma":"علاقة المورد الاستراتيجي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"علاقة المورد الاستراتيجي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f47d044a-37bd-451e-81cc-b0cc93e996e9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f47d044a-37bd-451e-81cc-b0cc93e996e9","word":"Legal Relationship","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbd1","lexicalEntryId":"f47d044a-37bd-451e-81cc-b0cc93e996e9","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"علاقة قانونية ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"علاقة العمل تعني اتصالاً بين طرفين أو أكثر بناءً على النشاط التجاري لأحد الطرفين.  أي علاقة مهنية ينظمها القانون، على سبيل المثال، بين العميل والمحامي","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Legal Relationship","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"علاقة قانونية   Legal Relationship","nonDiacriticsLemma":"علاقة قانونية ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"علاقة قانونية "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/356c837d-6162-4465-9faf-c47d5544f573/get-public-entry"},"browse_index_record":{"lexicalEntryId":"356c837d-6162-4465-9faf-c47d5544f573","word":"Remedies","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbd2","lexicalEntryId":"356c837d-6162-4465-9faf-c47d5544f573","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"علاجات","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"التعويضات هي (الأموال المدفوعة لتعويض الطرف غير المخالف عن الخسائر الناجمة عن الانتهاك)، والتي تشمل أيضًا الفئات الفرعية للأضرار العرضية والاسمية؛ يُسمح أحيانًا بدفع تعويضات تأديبية (لمعاقبة الطرف المخالف) عندما يكون الانتهاك فاضحًا ومتعمدًا.  ويعرف كذلك بالانتصاف هو شكل من أشكال إنفاذ المحكمة لحق قانوني ناتج عن دعوى مدنية ناجحة.  ويعرف ايضاً بالعلاجات التعاقدية هي أحكام العقد التي تمكن الطرف المتضرر من اتخاذ إجراء عندما لا يلتزم الطرف الآخر بشروط العقد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Remedies","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"علاجات  Remedies","nonDiacriticsLemma":"علاجات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"علاجات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

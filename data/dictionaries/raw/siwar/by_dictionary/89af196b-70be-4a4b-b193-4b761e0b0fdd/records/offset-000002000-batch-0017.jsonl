{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/95abdbe3-47d1-4112-855e-3862330b92ee/get-public-entry"},"browse_index_record":{"lexicalEntryId":"95abdbe3-47d1-4112-855e-3862330b92ee","word":"Operations","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbe0","lexicalEntryId":"95abdbe3-47d1-4112-855e-3862330b92ee","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"عمليات تجارية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"العمليات التجارية هو مصطلح يستخدم لتحديد مجموعة واسعة من الأنشطة. في جوهرها، يشير إلى كل ما تفعله الشركة يوميًا للاستمرار في العمل وكسب المال. لذلك، يمكن أن تختلف هذه الأنشطة بشكل كبير من شركة إلى أخرى. خذ متجرًا على الإنترنت، على سبيل المثال.  أي انها وظيفة الأعمال المسؤولة عن الإشراف على العمليات التي يتم إجراؤها لإنتاج السلع والخدمات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Operations","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"عمليات تجارية  Operations","nonDiacriticsLemma":"عمليات تجارية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"عمليات تجارية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

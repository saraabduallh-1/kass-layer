{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4214d98a-136d-4298-bba7-331510d25b6b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4214d98a-136d-4298-bba7-331510d25b6b","word":"(WIP)    Work In Progress","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbd7","lexicalEntryId":"4214d98a-136d-4298-bba7-331510d25b6b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"عمل قيد الإنجاز","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلح العمل قيد التنفيذ (WIP) هو مصطلح إدارة سلسلة الإنتاج والإمداد يصف البضائع الجاهزة جزئيًا التي تنتظر الانتهاء. يشير العمل قيد التقدم إلى المواد الخام والعمالة والتكاليف العامة المتكبدة للمنتجات التي توجد في مراحل مختلفة من عملية الإنتاج.  في إدارة المخزون، يتعلق التعبير بالمخزون جزئياً من خلال عملية التصنيع؛ في قطاعات الخدمات، يستخدم المصطلح أيضًا لأي شيء بين الطلب والتسليم","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"(WIP)    Work In Progress ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"عمل قيد الإنجاز  (WIP)    Work In Progress ","nonDiacriticsLemma":"عمل قيد الإنجاز","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"عمل قيد الإنجاز"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

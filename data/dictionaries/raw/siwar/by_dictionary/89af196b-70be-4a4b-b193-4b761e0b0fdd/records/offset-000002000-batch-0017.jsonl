{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e102e4fc-b1c7-430c-b6f3-529f1b0b728d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e102e4fc-b1c7-430c-b6f3-529f1b0b728d","word":"Lean Processes","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbdd","lexicalEntryId":"e102e4fc-b1c7-430c-b6f3-529f1b0b728d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"عمليات العجاف","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تُحسِّن الإدارة اللينة العمليات من خلال تقليل الوقت المستغرق في المهام غير ذات القيمة المضافة (العمليات أو النقل غير الضرورية، والانتظار، والإفراط في الإنتاج، وما إلى ذلك)، وأسباب الجودة الرديئة والمضاعفات فهي عمليات عالية الكفاءة حيث يتم القضاء على الهدر. قد تحدث الهدر في عمليات النقل والجرد والحركة والانتظار وكذلك الإفراط في المعالجة والإفراط في الإنتاج والعيوب","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Lean Processes","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"عمليات العجاف  Lean Processes","nonDiacriticsLemma":"عمليات العجاف","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"عمليات العجاف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7b89b9da-2e37-44a7-a425-33904976f5e3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7b89b9da-2e37-44a7-a425-33904976f5e3","word":"Financial Performance Indicators","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be36","lexicalEntryId":"7b89b9da-2e37-44a7-a425-33904976f5e3","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مؤشرات الأداء المالي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يعد مؤشر الأداء المالي (KPI) مقياسًا رائدًا عالي المستوى للإيرادات أو النفقات أو الأرباح أو النتائج المالية الأخرى، وهو مبسط للتجميع والمراجعة على أساس أسبوعي أو شهري أو ربع سنوي. الأمثلة النموذجية هي إجمالي الإيرادات لكل موظف وهامش الربح الإجمالي والتدفقات النقدية التشغيلية.  فهذه هي الأدوات التي يتم تطبيقها لقياس الوضع المالي أو أداء المنظمة. وتتنوع هذه المؤشرات عبر المؤسسات وقد تشمل: هامش الربح الإجمالي وصافي الربح وهامش صافي الربح والنسبة الحالية والحسابات المدينة والحسابات الدائنة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Financial Performance Indicators","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مؤشرات الأداء المالي  Financial Performance Indicators","nonDiacriticsLemma":"مؤشرات الأداء المالي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مؤشرات الأداء المالي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

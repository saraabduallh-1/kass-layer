{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3d153b8a-9114-4cc9-9499-1d74456e925d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3d153b8a-9114-4cc9-9499-1d74456e925d","word":"Inventory Strategy","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b762","lexicalEntryId":"3d153b8a-9114-4cc9-9499-1d74456e925d","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إدارة المخزون ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"استراتيجية المخزون هي منهجية يومية يجب اتباعها لطلب العناصر وصيانتها ومعالجتها في المستودع الخاص بك. بالنسبة لعملية صغيرة، تعد إدارة المخزون مهمة مباشرة إلى حد ما للتعامل معها، ولكن مع زيادة حجمك، فإنك تحتاج إلى خطة أكثر رسوخًا. أي أنها عملية ضمان توافر المنتجات والمواد الخام والمكونات والتجمعات الفرعية وما إلى ذلك من خلال إدارة المخزون.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Inventory Strategy","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إدارة المخزون   Inventory Strategy","nonDiacriticsLemma":"إدارة المخزون ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إدارة المخزون "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

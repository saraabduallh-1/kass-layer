{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c5007f69-b78e-4f52-9293-25741ded880e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c5007f69-b78e-4f52-9293-25741ded880e","word":"Price Elasticity","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd2b","lexicalEntryId":"c5007f69-b78e-4f52-9293-25741ded880e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مرونة السعر ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في الأعمال والاقتصاد، تشير مرونة السعر إلى الدرجة التي يغير بها الأفراد أو المستهلكون أو المنتجون طلبهم أو الكمية المعروضة استجابة لتغيرات السعر أو الدخل. يتم استخدامه في الغالب لتقييم التغيير في طلب المستهلك نتيجة للتغيير في سعر السلعة أو الخدمة. أي انه مقياس للتغيير في الطلب على منتج أو خدمة فيما يتعلق بالتغيرات في سعرها. إذا كان المنتج مرنًا من حيث السعر، فكلما انخفض السعر، زاد الطلب عليه. بشكل عام، لكي يكون المنتج مرنًا في السعر، يجب أن يكون هناك عدد من المنتجات البديلة. مرونة الطلب السعرية (PED) هي مقياس لمدى استجابة الطلب على المنتج فيما يتعلق بسعره","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Price Elasticity","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مرونة السعر   Price Elasticity","nonDiacriticsLemma":"مرونة السعر ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مرونة السعر "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

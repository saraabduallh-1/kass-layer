{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7eb6f7a8-a785-4c12-83dd-1c0200346066/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7eb6f7a8-a785-4c12-83dd-1c0200346066","word":"Centers Of Excellence","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd26","lexicalEntryId":"7eb6f7a8-a785-4c12-83dd-1c0200346066","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"مراكز الامتياز","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو مكان أو مجموعة يتم فيها الحفاظ على أعلى المعايير. فريق أو منشأة أو كيان مشترك يوفر القيادة و / أو أفضل الممارسات والبحث والدعم و / أو التدريب لمجال معين. أي أنها هيئة في منظمة تعمل عبر وحدات الأعمال (Bus) أو خطوط الإنتاج داخل Bus ولديها معرفة وكفاءة رائدة في هذا المجال. وهي تتألف من أفراد وخبراء من ذوي المهارات العالية، ينشرون المعرفة في منظمة ويشاركون أفضل الممارسات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Centers Of Excellence","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"مراكز الامتياز  Centers Of Excellence","nonDiacriticsLemma":"مراكز الامتياز","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مراكز الامتياز"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

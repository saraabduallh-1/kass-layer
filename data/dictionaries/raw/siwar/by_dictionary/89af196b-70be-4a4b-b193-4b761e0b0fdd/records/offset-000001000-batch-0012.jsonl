{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f90fcf89-f6b9-46eb-a79c-fab2deb994f2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f90fcf89-f6b9-46eb-a79c-fab2deb994f2","word":"Customer Switching Costs","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b972","lexicalEntryId":"f90fcf89-f6b9-46eb-a79c-fab2deb994f2","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تكاليف تبديل العملاء","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تكاليف التبديل هي التكاليف التي يتكبدها المستهلك نتيجة لتغيير العلامات التجارية أو الموردين أو المنتجات. على الرغم من أن معظم تكاليف التبديل السائدة ذات طبيعة نقدية، إلا أن هناك أيضًا تكاليف تبديل نفسية وقائمة على الجهد ومستندة إلى الوقت. والتكاليف التي سيتكبدها المستهلك (النقدية والوقت والجهد والنفسية) عندما ينتقل من علامة تجارية إلى أخرى أو من منتج إلى آخر. عندما تكون تكاليف التبديل منخفضة، غالبًا لأنه يمكن تكرار المنتجات بسهولة، تفقد الشركات ميزة تنافسية حيث يمكن للعملاء بسهولة اختيار منتجات أحد المنافسين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Customer Switching Costs","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تكاليف تبديل العملاء  Customer Switching Costs","nonDiacriticsLemma":"تكاليف تبديل العملاء","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تكاليف تبديل العملاء"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

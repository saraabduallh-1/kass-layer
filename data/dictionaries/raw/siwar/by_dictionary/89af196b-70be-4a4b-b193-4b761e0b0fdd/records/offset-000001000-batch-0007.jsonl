{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2c54f3ba-e520-47e7-80c7-2146e1a6d67e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2c54f3ba-e520-47e7-80c7-2146e1a6d67e","word":"Supply Chain Network Design","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8e7","lexicalEntryId":"2c54f3ba-e520-47e7-80c7-2146e1a6d67e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تصميم شبكة سلسلة التوريد","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تصميم شبكة سلسلة التوريد (SNDC) المعروف أيضًا باسم \"التخطيط الاستراتيجي لسلسلة التوريد\" هو عملية بناء ونمذجة سلسلة التوريد لفهم التكاليف والوقت لجلب السلع والخدمات إلى السوق ضمن الموارد المتاحة للمؤسسات.  أي العملية المعنية بتحديد البنية التحتية اللوجستية على مدى أفق تخطيط ممتد لتقديم الحل الاستراتيجي الأكثر فعالية من حيث التكلفة و / أو الخدمة كما يعرف بأنه العملية المعنية بتحديد البنية التحتية اللوجستية على مدى أفق تخطيط ممتد لتوفير الحل الاستراتيجي الأكثر فعالية من حيث التكلفة و / أو الخدمة.  أي تخصيص جميع المنظمات في إطار منظم من أجل تحقيق أهداف استراتيجية طويلة الأجل","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Supply Chain Network Design","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تصميم شبكة سلسلة التوريد  Supply Chain Network Design","nonDiacriticsLemma":"تصميم شبكة سلسلة التوريد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تصميم شبكة سلسلة التوريد"}],"lemmaL
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b21cd8f7-9602-49ed-aec7-c0f1e20e5e3c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b21cd8f7-9602-49ed-aec7-c0f1e20e5e3c","word":"Quality Auditing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8b8","lexicalEntryId":"b21cd8f7-9602-49ed-aec7-c0f1e20e5e3c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تدقيق الجودة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تدقيق الجودة هو مراجعة وتقييم منهجية ومستقلة وموثقة لنظام إدارة الجودة في المنظمة (QMS) لتحديد ما إذا كانت أنشطة الجودة والنتائج تتوافق مع ترتيب استراتيجي يتم تنفيذه بشكل فعال ومناسب لتحقيق الأهداف.  فهو التفتيش المنهجي على عملية أو منتج أو خدمة لتقييم الامتثال للمعايير أو المواصفات أو اللوائح.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Quality Auditing  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تدقيق الجودة  Quality Auditing  ","nonDiacriticsLemma":"تدقيق الجودة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تدقيق الجودة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

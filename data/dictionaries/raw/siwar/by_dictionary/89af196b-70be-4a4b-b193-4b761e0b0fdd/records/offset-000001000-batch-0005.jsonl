{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/68928e39-d67c-4a6a-a285-d10c27fb9c98/get-public-entry"},"browse_index_record":{"lexicalEntryId":"68928e39-d67c-4a6a-a285-d10c27fb9c98","word":"Line Flow","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8b0","lexicalEntryId":"68928e39-d67c-4a6a-a285-d10c27fb9c98","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تدفق الخط","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يتم تعريفه بالحركة المستمرة للعناصر من خلال عملية الإنتاج. ويتم إنتاج أعداد كبيرة من نفس البضائع بشكل مستمر في عملية الإنتاج هذه. غالبًا ما تكون هناك فرصة لمستوى عالٍ من الأتمتة على خط تجميع إنتاج التدفق. بعض الأمثلة: مصنع تجميع السيارات.  أي يتم ترتيب موارد الإنتاج أو المعدات في تسلسل، متبوعة ببعضها البعض. على سبيل المثال، في مصنع للخبز سيكون هناك آلة خلط، ثم فرن، ثم رف تبريد، ثم معدات تغليف","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Line Flow","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"تدفق الخط  Line Flow","nonDiacriticsLemma":"تدفق الخط","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تدفق الخط"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

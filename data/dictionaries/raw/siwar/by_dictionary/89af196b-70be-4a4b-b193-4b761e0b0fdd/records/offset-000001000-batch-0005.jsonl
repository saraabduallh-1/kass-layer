{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0a31e7e3-6ef4-45e9-a31f-2c864bfe7508/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0a31e7e3-6ef4-45e9-a31f-2c864bfe7508","word":"Payback","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b8c8","lexicalEntryId":"0a31e7e3-6ef4-45e9-a31f-2c864bfe7508","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"تسديد","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يشير مصطلح فترة الاسترداد إلى مقدار الوقت المستغرق لاسترداد تكلفة الاستثمار. ببساطة، هو طول الوقت الذي يصل فيه الاستثمار إلى نقطة التعادل. يستثمر الأشخاص والشركات أموالهم بشكل أساسي لاسترداد الأموال، وهذا هو سبب أهمية فترة الاسترداد.  أي الفترة الزمنية اللازمة لاسترداد تكلفة الاستثمار","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Payback ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"تسديد  Payback ","nonDiacriticsLemma":"تسديد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تسديد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8f95314d-34a5-4137-afa3-d9970bc31b4f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8f95314d-34a5-4137-afa3-d9970bc31b4f","word":"On-Boarding","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b793","lexicalEntryId":"8f95314d-34a5-4137-afa3-d9970bc31b4f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إعداد","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يشير \"الإعداد\" إلى العمليات التي يتم فيها دمج الموظفين الجدد في المنظمة. يتضمن الأنشطة التي تسمح للموظفين الجدد بإكمال عملية التوجيه الأولية للتوظيف الجديد، وكذلك التعرف على المنظمة وهيكلها، وثقافتها، ورؤيتها، ورسالتها وقيمها.  العمليات والإجراءات الخاصة بإعداد عضو جديد في المنظمة -يمكن أن تشمل فرز تسجيل الدخول وعنوان البريد الإلكتروني وتنسيق الوصول إلى أنظمة تكنولوجيا المعلومات ذات الصلة والترتيب للحصول على شارات التعريف المناسبة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"On-Boarding","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"إعداد  On-Boarding","nonDiacriticsLemma":"إعداد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إعداد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/92e80a6e-8b25-44ee-9acf-18a2a8044a53/get-public-entry"},"browse_index_record":{"lexicalEntryId":"92e80a6e-8b25-44ee-9acf-18a2a8044a53","word":"Insolvency","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b794","lexicalEntryId":"92e80a6e-8b25-44ee-9acf-18a2a8044a53","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إعسار","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يشير الإعسار إلى المواقف التي لا يستطيع فيها المدين سداد الديون التي يدين بها. على سبيل المثال، قد تصبح الشركة المتعثرة معسرة عندما تكون غير قادرة على سداد أموال دائنيها المستحقة في الوقت المحدد، مما يؤدي في كثير من الأحيان إلى رفع دعوى الإفلاس.  وعندما لا تستطيع المنظمة جمع نقود كافية للوفاء بالتزاماتها أو سداد الديون عندما تصبح مستحقة السداد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Insolvency","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"إعسار  Insolvency","nonDiacriticsLemma":"إعسار","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إعسار"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6f7d03fa-e07a-4eb6-90ae-b0be01faddef/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6f7d03fa-e07a-4eb6-90ae-b0be01faddef","word":"Economies Of Scope","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b795","lexicalEntryId":"6f7d03fa-e07a-4eb6-90ae-b0be01faddef","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إقتصاديات النطاق","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يعني اقتصاد النطاق أن إنتاج سلعة واحدة يقلل من تكلفة إنتاج سلعة أخرى ذات صلة. تحدث اقتصاديات النطاق عندما يكون إنتاج مجموعة متنوعة من السلع أو الخدمات جنبًا إلى جنب أكثر فعالية من حيث التكلفة بالنسبة للشركة من إنتاج مجموعة أقل أو إنتاج كل سلعة بشكل مستقل.  وتعرف أيضاً بأنها الفوائد التي يمكن أن تجنيها المنظمة من الكفاءة التي تحققها عندما يتم استخدام مواردها وقدراتها على النحو الأمثل","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Economies Of Scope","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إقتصاديات النطاق  Economies Of Scope","nonDiacriticsLemma":"إقتصاديات النطاق","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إقتصاديات النطاق"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/10882937-8424-4b10-b7a4-6e8b7aa9bd26/get-public-entry"},"browse_index_record":{"lexicalEntryId":"10882937-8424-4b10-b7a4-6e8b7aa9bd26","word":"Transitional Economy","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b796","lexicalEntryId":"10882937-8424-4b10-b7a4-6e8b7aa9bd26","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إقتصاد انتقالي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الاقتصاد الانتقالي هو اقتصاد يتغير من اقتصاد مخطط مركزيًا إلى اقتصاد السوق. تمر الاقتصادات التي تمر بمرحلة انتقالية بمجموعة من التحولات الهيكلية التي تهدف إلى تطوير مؤسسات قائمة على السوق.  أي الإقتصاد الوطني الذي ينتقل من كونه اقتصادًا تسيطر عليه الدولة إلى اقتصاد السوق الكامل (على سبيل المثال، دول الاتحاد السوفيتي السابق)","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Transitional Economy","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إقتصاد انتقالي  Transitional Economy","nonDiacriticsLemma":"إقتصاد انتقالي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إقتصاد انتقالي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6135bb77-97ce-4553-b3f6-deceedcc357f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6135bb77-97ce-4553-b3f6-deceedcc357f","word":"Promissory Estoppel","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b797","lexicalEntryId":"6135bb77-97ce-4553-b3f6-deceedcc357f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إغلاق تعهدي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ضمن قانون العقود، يشير الإغلاق الأدنى إلى المبدأ القائل بأنه يجوز للطرف استرداده على أساس الوعد الذي تم التعهد به عندما كان اعتماد الطرف على هذا الوعد معقولًا، وكان الطرف الذي يحاول الاسترداد بشكل ضار يعتمد على الوعد. هو مبدأ قانوني يفيد بأن الوعد قابل للتنفيذ بموجب القانون، حتى لو تم تقديمه دون اعتبار رسمي، عندما يكون الوعد قد قدم وعدًا إلى الوعد الذي يعتمد بعد ذلك على هذا الوعد على حسابه.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Promissory Estoppel","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إغلاق تعهدي  Promissory Estoppel","nonDiacriticsLemma":"إغلاق تعهدي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إغلاق تعهدي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/99e0bb5d-d645-4f1e-a174-08e86913a35b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"99e0bb5d-d645-4f1e-a174-08e86913a35b","word":"Remanufacturing","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b78e","lexicalEntryId":"99e0bb5d-d645-4f1e-a174-08e86913a35b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إعادة التصنيع","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إعادة التصنيع هي عملية يتم تطبيقها على جزء أو منتج انتهى عمره الافتراضي والذي يعيده إلى أمر العمل \"كجديد\" أو إلى مستويات أداء أفضل من المنتج الأصلي. تشمل المنتجات المناسبة لإعادة التصنيع تلك التي: تتضمن تقنية ستستمر لفترة طويلة.  أي إعادة بناء المنتج وفقًا لمواصفات المنتج الأصلي المصنوع باستخدام مجموعة من الأجزاء المعاد استخدامها والإصلاح والتجديد","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Remanufacturing","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إعادة التصنيع  Remanufacturing","nonDiacriticsLemma":"إعادة التصنيع","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إعادة التصنيع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0e8fecdd-e1f6-46a8-ab48-cfae7fd26ad5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0e8fecdd-e1f6-46a8-ab48-cfae7fd26ad5","word":"Business Process Re-Engineering (BPR)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b78f","lexicalEntryId":"0e8fecdd-e1f6-46a8-ab48-cfae7fd26ad5","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إعادة هندسة العمليات التجارية ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي نهج يتضمن إعادة التفكير وإعادة تصميم العمليات في المنظمة لتعزيز قدرتها على دعم استراتيجية الشركة للمنظمة وتقليل التكاليف، وهي تعني إعادة هندسة عمليات الأعمال. فإن تعريف إعادة هندسة العمليات التجارية (BPR) هو نهج منظم ومنضبط لتقليل التكاليف التنظيمية والعمليات التجارية الزائدة عن الحاجة التي تنطوي على تحليل مهام سير العمل البشرية والآلية الموجودة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Business Process Re-Engineering (BPR)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"إعادة هندسة العمليات التجارية   Business Process Re-Engineering (BPR)","nonDiacriticsLemma":"إعادة هندسة العمليات التجارية ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إعادة هندسة العمليات التجارية "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6d1552bf-a101-4fef-8bcf-310329f946e9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6d1552bf-a101-4fef-8bcf-310329f946e9","word":"Lease","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b7aa","lexicalEntryId":"6d1552bf-a101-4fef-8bcf-310329f946e9","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"إيجار","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"عقد الإيجار هو عقد يحدد الشروط التي يوافق بموجبها أحد الطرفين على تأجير أصل -في هذه الحالة، عقار -مملوك لطرف آخر. يضمن للمستأجر، المعروف أيضًا باسم المستأجر، استخدام العقار ويضمن للمؤجر (مالك العقار أو المالك) مدفوعات منتظمة لفترة محددة في المقابل.  أي انه عقد بين طرفين -المستأجر والمؤجر -حيث يوافق أحد الطرفين على دفع مبلغ من المال مقابل استخدام أصل مثل سيارة أو آلة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Lease","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"إيجار  Lease","nonDiacriticsLemma":"إيجار","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إيجار"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/38a20642-4fc2-4d38-9462-6525dd147835/get-public-entry"},"browse_index_record":{"lexicalEntryId":"38a20642-4fc2-4d38-9462-6525dd147835","word":"Special Causes","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b7bd","lexicalEntryId":"38a20642-4fc2-4d38-9462-6525dd147835","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"أسباب خاصة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشير اختلاف السبب الخاص إلى الأحداث غير المتوقعة والقابلة للتخصيص والتي يمكن أن تؤثر على العملية. هذه هي الاختلافات التي لم يتم ملاحظتها من قبل وهي اختلافات غير عادية وغير قابلة للقياس الكمي. قد يكون اختلاف السبب الخاص متقطعًا. لا يعد ذلك عادةً جزءًا من عمليتك العادية ويبدو أنه يحدث بشكل غير متوقع. أي التباين الناجم عن مصادر قابلة للتخصيص، وعادة ما يكون متقطعًا ولا يمكن التنبؤ به","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Special Causes","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"أسباب خاصة  Special Causes","nonDiacriticsLemma":"أسباب خاصة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"أسباب خاصة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

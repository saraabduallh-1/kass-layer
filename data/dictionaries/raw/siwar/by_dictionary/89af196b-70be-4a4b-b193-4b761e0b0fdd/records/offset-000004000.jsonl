{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/21cdbcae-c7c9-4c24-b5cf-10652d9c7774/get-public-entry"},"browse_index_record":{"lexicalEntryId":"21cdbcae-c7c9-4c24-b5cf-10652d9c7774","word":"Strategic Suppliers","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be20","lexicalEntryId":"21cdbcae-c7c9-4c24-b5cf-10652d9c7774","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"موردين استراتيجيين","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يعتبر المورد اســـتراتيجيًا إذا كانــت أكبر مخاطرة على التوريد والربحية هـــي تعطيل قدرته على تلبية الطلبات. عادةً ما يشكل الموردون الاستراتيجيون نسبة منخفضة من قاعدة التوريد الإجمالية لديك، لذا فإن مخاطر التكلفة والوفاء من خلال إعادة التوريد أعلى مقارنة بالمورد المتوسط.  فهم أولئك الذين يلعبون دورًا أساسيًا في سلسلة القيمة للمؤسسة بالإضافة إلى توفير منتج أو خدمة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Strategic Suppliers","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"موردين استراتيجيين  Strategic Suppliers","nonDiacriticsLemma":"موردين استراتيجيين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"موردين استراتيجيين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e04ae5bc-6d25-426f-9727-1a79b0687346/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e04ae5bc-6d25-426f-9727-1a79b0687346","word":"Key Suppliers","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4be22","lexicalEntryId":"e04ae5bc-6d25-426f-9727-1a79b0687346","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"موردين رئيسيين","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يُصنف المورد الرئيسي على أنه مهم بدرجة كافية للمؤسسة لضمان مراقبة منتظمة ومستمرة للتحقق من أداء تقديم الخدمة عبر: العقود الرئيسية. جدواها الشاملة، بما في ذلك المالية. طبيعة بيان المخاطر الخاص بها في ظل ظروف العمل المتغيرة.  أي انهم الموردون الموجودون في الخارج -سواء كانوا أفرادًا أم مؤسسات -والذين يعتبرون ضروريين لتحقيق أهداف الشركة بنجاح","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Key Suppliers","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"موردين رئيسيين  Key Suppliers","nonDiacriticsLemma":"موردين رئيسيين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"موردين رئيسيين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

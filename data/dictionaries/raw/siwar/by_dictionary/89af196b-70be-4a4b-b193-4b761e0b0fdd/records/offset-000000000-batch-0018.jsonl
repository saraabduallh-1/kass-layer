{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/771a0486-9faf-4625-aa53-ae391cb3fad9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"771a0486-9faf-4625-aa53-ae391cb3fad9","word":"Substitutes","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b7f0","lexicalEntryId":"771a0486-9faf-4625-aa53-ae391cb3fad9","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"بدائل","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"البديل هو منتج أو خدمة يمكن للمستهلكين استبدالها بسهولة بأخرى. في علم الاقتصاد، غالبًا ما تكون المنتجات بدائل إذا زاد الطلب على منتج واحد عندما يرتفع سعر المنتج الآخر.  أي منتجات (أو خدمات) من نوع مختلف تلبي حاجة مماثلة أو تقدم مزايا مماثلة، على سبيل المثال، الشاي والقهوة، أو الغاز والكهرباء","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Substitutes","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"بدائل  Substitutes","nonDiacriticsLemma":"بدائل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"بدائل"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/389e92a1-799c-485f-bf0f-1edde33273bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"389e92a1-799c-485f-bf0f-1edde33273bf","word":"Employment And Support Allowance (ESA)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b7f1","lexicalEntryId":"389e92a1-799c-485f-bf0f-1edde33273bf","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"بدل التوظيف والدعم","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو المال للأشخاص الذين لديهم قدرة محدودة على العمل بسبب مرضهم أو إعاقتهم ولكنهم لا يحصلون على أجر المرض القانوني. هناك نوعان: بدل العمل والدعم المرتبط بالدخل. بدل مساهم / نمط جديد للعمالة والدعم. في المملكة المتحدة، وهي دفعة يتلقاها الأشخاص الذين لا يستطيعون العمل بسبب المرض أو الإعاقة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Employment And Support Allowance (ESA)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"بدل التوظيف والدعم  Employment And Support Allowance (ESA)","nonDiacriticsLemma":"بدل التوظيف والدعم","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"بدل التوظيف والدعم"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0cc3d77e-5326-4fc8-b7fc-4d2695460da7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0cc3d77e-5326-4fc8-b7fc-4d2695460da7","word":"ISO 9000","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b7f2","lexicalEntryId":"0cc3d77e-5326-4fc8-b7fc-4d2695460da7","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"آيزو","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"ISO 9000 عبارة عن مجموعة من المعايير لإدارة الجودة ، تم تطويرها كخط أساس مقبول دوليًا للأداء من قبل الشركات والمؤسسات الأخرى. تم إنشاؤه من قبل المنظمة الدولية للتوحيد القياسي (ISO) مع مدخلات من المتخصصين في المعايير من العديد من الدول. أي مجموعة من معايير إدارة الجودة الدولية وضمان الجودة التي تساعد الشركات بشكل فعال على توثيق نظام جودة فعال والحفاظ عليه. فهي ليست خاصة بأي صناعة واحدة ويمكن تطبيقها على المؤسسات من أي حجم","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"ISO 9000","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]},{"definition":"تعريف مسرد الجودة: ISO 9001. يتم تعريف ISO 9001 على أنه المعيار الدولي الذي يحدد متطلبات نظام إدارة الجودة (QMS). وتستخدم المؤسسات المعيار لإثبات القدرة على توفير المنتجات والخدمات التي تلبي متطلبات العملاء والمتطلبات التنظيمية باستمرار. فهي معيار دولي لإدارة الجودة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"ISO 9001","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"آيزو  ISO 9000 ISO 9001","nonDiacriticsLemma":"آيزو","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"آيزو"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

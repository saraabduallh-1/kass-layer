{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5e8dcad6-31dc-4c38-b212-62072f807f4e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5e8dcad6-31dc-4c38-b212-62072f807f4e","word":"Purchasing Card (Procurement Card)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b804","lexicalEntryId":"5e8dcad6-31dc-4c38-b212-62072f807f4e","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"بطاقة الشراء (بطاقة المشتريات)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي نوع من بطاقات الدفع الخاصة بالشركة وتُستخدم لعمليات الشراء الصغيرة لتحقيق قدر أكبر من الفعالية من حيث التكلفة والتحكم والراحة. تُعرف بطاقات الشراء أيضًا باسم بطاقات الشراء أو P-Cards أو Pcards. ويمكن ربط بطاقات الشراء إما ببطاقة ائتمان أو حساب مصرفي. بشكل أساسي وهي بطاقة ائتمان مملوكة للشركة تمكن الضابط من إجراء عمليات شراء منخفضة القيمة دون الحاجة إلى طلبات رسمية وطلبات الشراء","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Purchasing Card (Procurement Card)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"بطاقة الشراء (بطاقة المشتريات)  Purchasing Card (Procurement Card)","nonDiacriticsLemma":"بطاقة الشراء بطاقة المشتريات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"بطاقة الشراء (بطاقة المشتريات)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

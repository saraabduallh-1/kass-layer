{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/60e5357a-1c8e-4c75-b187-c8ae6b70ef6f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"60e5357a-1c8e-4c75-b187-c8ae6b70ef6f","word":"Mixed-Integer Programming (MIP)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b7f9","lexicalEntryId":"60e5357a-1c8e-4c75-b187-c8ae6b70ef6f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"برمجة الأعداد الصحيحة المختلطة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تُعرف نماذج التحسين التي يجب أن تكون فيها بعض المتغيرات أو جميعها عددًا صحيحًا باسم برمجة الأعداد الصحيحة المختلطة (MIP). هناك سببان رئيسيان لاستخدام MIP. متغيرات القرار هي الكميات التي يجب أن تكون عددًا صحيحًا، على سبيل المثال، عدد الموظفين المراد تعيينهم أو عدد السيارات التي يجب صنعها. وهي تعرف بمشكلة البرمجة ذات الأعداد الصحيحة المختلطة هي مشكلة يتم فيها تقييد بعض متغيرات القرار لتكون قيمًا صحيحة (أي الأعداد الصحيحة، مثل −1، 0، 1، 2، إلخ) في الحل الأمثل. يزيد استخدام متغيرات عدد صحيح من نطاق مشاكل التحسين المفيدة التي يمكن تعريفها وحلها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Mixed-Integer Programming (MIP)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"برمجة الأعداد الصحيحة المختلطة  Mixed-Integer Programming (MIP)","nonDiacriticsLemma":"برمجة الأعداد الصحيحة المختلطة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"برمجة الأعداد الصحيحة المختلطة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

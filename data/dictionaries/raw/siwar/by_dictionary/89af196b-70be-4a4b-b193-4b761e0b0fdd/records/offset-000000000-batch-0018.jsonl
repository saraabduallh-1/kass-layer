{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3ce1480a-52b9-4a11-af27-8dc5eabddc1c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3ce1480a-52b9-4a11-af27-8dc5eabddc1c","word":"Block Chain","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b808","lexicalEntryId":"3ce1480a-52b9-4a11-af27-8dc5eabddc1c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"بلوك تشين","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي تقنية تسمح برقمة البيانات، وهي قائمة من السجلات يطلق عليها مجاميع، والتي يتم ربطها باستخدام التشفير. ويتضمن التشفير المجاميع السابقة والطابع الزمني وبيانات المعاملة المطلوبة. ويكون تصميمه مقاومًا للتعديل وبالتالي فهو آمن للغاية. وتُستخدم التكنولوجيا لتسجيل المعاملات بين الأطراف بكفاءة وبطريقة دائمة وقابلة للتحقق، مثل مدفوعات الفواتير وبمعنى آخر هو عبارة عن دفتر أستاذ مشترك وغير قابل للتغيير يسهل عملية تسجيل المعاملات وتتبع الأصول في شبكة الأعمال.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Block Chain","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"بلوك تشين  Block Chain","nonDiacriticsLemma":"بلوك تشين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"بلوك تشين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

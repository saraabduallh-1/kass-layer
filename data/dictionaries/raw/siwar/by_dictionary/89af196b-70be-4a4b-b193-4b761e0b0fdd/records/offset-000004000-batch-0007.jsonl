{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3066bfb0-4c2e-4cff-af17-8dbc101f6c60/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3066bfb0-4c2e-4cff-af17-8dbc101f6c60","word":"User-Based Approach","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bebc","lexicalEntryId":"3066bfb0-4c2e-4cff-af17-8dbc101f6c60","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نهج قائم على المستخدم","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يركز النهج القائم على المستخدم حصريًا على العميل في تحديد الجودة. تكمن قوة هذا النهج في أنه يتيح للعميل أن يكون له رأي في تحديد الجودة. ومع ذلك، قد يُنظر إلى هذه القوة أيضًا على أنها نقطة ضعف، أي صنع منتج مناسب للغرض والاستخدام","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"User-Based Approach  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نهج قائم على المستخدم  User-Based Approach  ","nonDiacriticsLemma":"نهج قائم على المستخدم","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نهج قائم على المستخدم"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/793704f5-c960-4219-86aa-9e015c8c9929/get-public-entry"},"browse_index_record":{"lexicalEntryId":"793704f5-c960-4219-86aa-9e015c8c9929","word":"Gifts And Hospitality","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bec6","lexicalEntryId":"793704f5-c960-4219-86aa-9e015c8c9929","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"هدايا وكرم الضيافة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الهدايا والضيافة، بما في ذلك السفر والترفيه، هي نفقات مشروعة وممارسات تجارية شائعة لبناء العلاقات أو التعبير عن التقدير. يشار أيضًا إلى مصاريف الهدايا والضيافة على أنها هدايا وترفيه أو نفقات.  فهي السلع المادية أو الأموال أو الترفيه التي قد يتم تقديمها من طرف إلى آخر. في سياق الأعمال التجارية، قد يُنظر إلى تقديم الهدايا وتلقيها من منظمة أو فرد إلى آخر على أنه تقديم رشوة وتلقيها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Gifts And Hospitality","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"هدايا وكرم الضيافة  Gifts And Hospitality","nonDiacriticsLemma":"هدايا وكرم الضيافة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"هدايا وكرم الضيافة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

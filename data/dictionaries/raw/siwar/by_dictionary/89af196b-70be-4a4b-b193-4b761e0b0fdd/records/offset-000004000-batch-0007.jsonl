{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f4c51b54-250c-427a-80c7-a21effa0971f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f4c51b54-250c-427a-80c7-a21effa0971f","word":"Parental Fit","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bec2","lexicalEntryId":"f4c51b54-250c-427a-80c7-a21effa0971f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نوبة الوالدين","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تخلق الشركات متعددة الأعمال قيمة من خلال التأثير -أو الأبوة -على الشركات التي تمتلكها. تخلق أفضل الشركات الأم قيمة أكبر من أي من الشركات المنافسة لها إذا كانت تمتلك نفس الأعمال. هذه الشركات لديها ما نسميه ميزة الأبوة والأمومة.  فهي درجة قدرة الشركة الأم على إفادة وحدات أعمالها من حيث الموارد والقدرات","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Parental Fit ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نوبة الوالدين  Parental Fit ","nonDiacriticsLemma":"نوبة الوالدين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نوبة الوالدين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7bd1db62-3c83-4a55-8981-ceba5b69d4ab/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7bd1db62-3c83-4a55-8981-ceba5b69d4ab","word":"Collaborative Approach","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bec3","lexicalEntryId":"7bd1db62-3c83-4a55-8981-ceba5b69d4ab","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"نهج تعاوني","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يحدث عندما يقرر الموظف مساعدة زميل آخر أو مشاركة النتائج الحاسمة مع بقية الفريق دون التزام حقيقي. تمكن الثقافة التعاونية الشركات من الابتكار وتحسين العديد من جوانب عملياتها بشكل كبير. أو أنه يعرف بأنه نهج للمفاوضات حيث يتطلع الطرفان إلى حل النزاع من خلال العمل معًا لإيجاد حل يخدم مصلحة العقد. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Collaborative Approach","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"نهج تعاوني  Collaborative Approach","nonDiacriticsLemma":"نهج تعاوني","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نهج تعاوني"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b98d7ca4-118f-455a-a333-e8d4e9b10851/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b98d7ca4-118f-455a-a333-e8d4e9b10851","word":"Maslow’s Hierarchy Of Needs","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bece","lexicalEntryId":"b98d7ca4-118f-455a-a333-e8d4e9b10851","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"هرم ماسلو للاحتياجات ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو نظرية التحفيز التي طورها أبراهام ماسلو؛ يرى أن البشر لديهم خمسة مستويات من الاحتياجات ويعملون على تلبية احتياجاتهم غير الملباه. في قاعدة التسلسل الهرمي توجد احتياجات فسيولوجية أساسية، متبوعة بالترتيب باحتياجات السلامة والاجتماعية والاحترام وتحقيق الذات.  فهو نظرية التحفيز التي تصنف مصادر التحفيز وفقًا لتأثيرها على العمال (الاحتياجات الفسيولوجية، واحتياجات السلامة، والحب والانتماء، والاحترام وتحقيق الذات)","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Maslow’s Hierarchy Of Needs","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"هرم ماسلو للاحتياجات   Maslow’s Hierarchy Of Needs","nonDiacriticsLemma":"هرم ماسلو للاحتياجات ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"هرم ماسلو للاحتياجات "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e33460a8-213a-456c-901e-6d406f73bedd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e33460a8-213a-456c-901e-6d406f73bedd","word":"Reverse Engineering","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4becf","lexicalEntryId":"e33460a8-213a-456c-901e-6d406f73bedd","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"هندسة عكسية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الهندسة العكسية هي عملية يتم فيها تحليل منتج أو نظام لمعرفة كيفية عمله، بحيث يمكن إنتاج نسخة مماثلة من المنتج أو النظام بسعر أرخص. عمل لم تكتسب المجموعة مهارات الهندسة العكسية في هذه العملية فحسب، بل اكتسبت أيضًا دخولًا إلى السوق العالمية.  أي تفكيك وتحليل كائن لفهم كيفية تجميعه وكيفية عمله. تُستخدم هذه العملية أحيانًا بطريقة غير أخلاقية للحصول على الملكية الفكرية المضمنة في منتج مبتكر","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Reverse Engineering ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"هندسة عكسية  Reverse Engineering ","nonDiacriticsLemma":"هندسة عكسية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"هندسة عكسية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

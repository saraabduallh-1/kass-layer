{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3d1144b1-d0e1-4f46-8267-56b7df486179/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3d1144b1-d0e1-4f46-8267-56b7df486179","word":"Fight Or Flight Reaction","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc48","lexicalEntryId":"3d1144b1-d0e1-4f46-8267-56b7df486179","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"قتال أو هروب","lemmaType":"MWE","pattern":" ","senses":[{"definition":"القتال أو رد فعل الطيران. مجموعة العمليات التي تحدث في الجسم عندما يواجه شكلاً من أشكال الإجهاد البدني أو العقلي. على سبيل المثال، إذا كان الشخص يواجه خطرًا (مثل من حيوان شرير على وشك الهجوم)، فإن الجهاز العصبي يشير إلى إفراز الأدرينالين والهرمونات الأخرى في الدم.  أي تمثل الاستجابة هي رد فعل فسيولوجي يحدث استجابة لحدث ضار أو تهديد للبقاء على قيد الحياة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Fight Or Flight Reaction","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"قتال أو هروب  Fight Or Flight Reaction","nonDiacriticsLemma":"قتال أو هروب","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قتال أو هروب"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/37f63de6-3047-4833-808d-57becbd19ba6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"37f63de6-3047-4833-808d-57becbd19ba6","word":"Dynamic Capabilities","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc49","lexicalEntryId":"37f63de6-3047-4833-808d-57becbd19ba6","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"قدرات ديناميكية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"القدرة الديناميكية هي نظرية للميزة التنافسية في البيئات سريعة التغير. نقوم بالتوفيق بين هذا التفسير والنظريات السابقة للميزة التنافسية، موضحًا كيف يُعلم ويكمل التفسيرات بناءً على أوضاع السوق، وموارد الشركة، بمعنى أخر هو بناء وإعادة تشكيل الكفاءات الداخلية والخارجية داخل الأنظمة اللوجستية للاستجابة للبيئات المتغيرة بسرعة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Dynamic Capabilities","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"قدرات ديناميكية  Dynamic Capabilities","nonDiacriticsLemma":"قدرات ديناميكية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قدرات ديناميكية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2f7f8908-7bc9-4612-8e39-5253143f272a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2f7f8908-7bc9-4612-8e39-5253143f272a","word":"Supply Chain Capabilities","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc4a","lexicalEntryId":"2f7f8908-7bc9-4612-8e39-5253143f272a","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"قدرات سلسلة التوريد","lemmaType":"MWE","pattern":" ","senses":[{"definition":"من ناحية أخرى، تعكس قدرة سلسلة التوريد مدى قوة سلسلة التوريد الخاصة بك وسرعتها في مواجهة الاضطرابات. في أي وقت، سيكون قياس الحد الأقصى لسعة سلسلة التوريد رقمًا ثابتًا، يمكن التعبير عنه كنسبة مئوية من إجمالي السعة.  أي تجزئة سلسلة التوريد والقدرات الوظيفية ضمن عمليات إدارة التوريد الشاملة المطلوبة لدعم استراتيجية العمل الشاملة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Supply Chain Capabilities","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"قدرات سلسلة التوريد  Supply Chain Capabilities","nonDiacriticsLemma":"قدرات سلسلة التوريد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قدرات سلسلة التوريد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

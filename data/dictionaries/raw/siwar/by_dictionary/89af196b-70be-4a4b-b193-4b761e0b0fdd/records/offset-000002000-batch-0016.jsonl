{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6d69621e-cf27-476d-80e9-8d952bace0c4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6d69621e-cf27-476d-80e9-8d952bace0c4","word":"Subcontract","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bbc7","lexicalEntryId":"6d69621e-cf27-476d-80e9-8d952bace0c4","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"عقد من الباطن","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشير التعاقد من الباطن إلى ممارســــــــة إحضار شركة أو فرد خارجي لأداء أجزاء محددة من العقد أو \r\nالمشروع. في معظم الحالات، تتعاقد الشركة من الباطن مع شركة أخرى لتنفيذ مهمة لا يمكن التعامل معها داخليًا.  فالعقد الوارد أدناه، يرتبط ارتباطًا مباشرًا بعقد أعلى ويحكمه جزئيًا لتقديم جزء من متطلبات ذلك العقد الأعلى. يمكن أن يكون هناك عدة طبقات من العقود من الباطن ومن الباطن","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Subcontract","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"عقد من الباطن  Subcontract","nonDiacriticsLemma":"عقد من الباطن","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"عقد من الباطن"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

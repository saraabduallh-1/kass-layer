{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/667c2f39-07ad-463a-9189-1e2bfd67868b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"667c2f39-07ad-463a-9189-1e2bfd67868b","word":"Rebate","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b70f","lexicalEntryId":"667c2f39-07ad-463a-9189-1e2bfd67868b","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الخصم\t","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الخصم هو شكل من أشكال شراء الخصم وهو مبلغ يتم دفعه عن طريق التخفيض أو الإرجاع أو الاسترداد الذي يتم دفعه بأثر رجعي. إنه نوع من ترويج المبيعات يستخدمه المسوقون بشكل أساسي كحوافز أو مكملات لمبيعات المنتجات.  فهو آلية مالية يحصل بموجبها المشتري على مدفوعات من المورد مقابل تقديم طلبات أعلى من حدود الحجم المتفق عليها مسبقًا","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Rebate","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"الخصم\t  Rebate","nonDiacriticsLemma":"الخصم","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الخصم\t"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f18d84c7-7df8-42d0-888c-7ed4b8617d62/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f18d84c7-7df8-42d0-888c-7ed4b8617d62","word":"Demurrage","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc03","lexicalEntryId":"f18d84c7-7df8-42d0-888c-7ed4b8617d62","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"غرامة التأخير","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في سياق العملات والسلع، تشير غرامات التأخير إلى التكاليف المختلفة لامتلاك العملة أو السلعة المعنية. على سبيل المثال، قد يحتاج حاملو العملات إلى دفع رسوم الحساب، بينما قد يحتاج حاملوا السلع مثل الذهب والفضة إلى دفع رسوم التأمين والتخزين أيضًا. فهي أجرة تُدفع لمالك السفينة المستأجرة عند عدم تحميل السفينة أو تفريغها خلال الوقت المتفق عليه","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Demurrage","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"غرامة التأخير  Demurrage","nonDiacriticsLemma":"غرامة التأخير","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"غرامة التأخير"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

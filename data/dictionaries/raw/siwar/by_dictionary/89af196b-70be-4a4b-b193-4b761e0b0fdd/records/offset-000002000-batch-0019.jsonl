{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3dd239ea-5e1a-4e5b-86ee-2c4f9309af97/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3dd239ea-5e1a-4e5b-86ee-2c4f9309af97","word":"Interest Rate Differential (IRD)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc14","lexicalEntryId":"3dd239ea-5e1a-4e5b-86ee-2c4f9309af97","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"فرق سعر الفائدة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فروق أسعار الفائدة (Irds) تقيس ببساطة الفرق بين أسعار الفائدة لأداتين مختلفتين. غالبًا ما يتم استخدام IRD في أسواق الدخل الثابت، والعملات الأجنبية، والإقراض. تلعب IRD أيضًا دورًا رئيسيًا في حساب تجارة المناقلة بالعملات.  أي حساب الفرق بين أسعار الفائدة على عملتين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Interest Rate Differential (IRD)","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"فرق سعر الفائدة  Interest Rate Differential (IRD)","nonDiacriticsLemma":"فرق سعر الفائدة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"فرق سعر الفائدة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e61bf53c-d0c3-4816-87af-980f9116333f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e61bf53c-d0c3-4816-87af-980f9116333f","word":"Procurement Team","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bc15","lexicalEntryId":"e61bf53c-d0c3-4816-87af-980f9116333f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"فريق المشتريات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فريق المشتريات عبارة عن مجموعة من الخبراء الذين يقدمون مجموعة واسعة من الخدمات لجميع المشاركين في المشروع المعنيين أو المهتمين بالأنشطة المتعلقة بشراء المواد والإمدادات اللازمة لتنفيذ المشروع.  أي انه فريق المشتريات مسؤول عن الإشراف على خطوات دورة المشتريات، والتي تغطي أنشطة الإدارة الأساسية مثل تحليل السوق، وتحديد المصادر، والتفاوض، والتعاقد، وإدارة علاقات الموردين. يضيف الشراء قيمة ويقلل من المخاطر عبر سلسلة التوريد من خلال إقامة علاقات عمل صحيحة مع الموردين \".","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Procurement Team ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"فريق المشتريات  Procurement Team ","nonDiacriticsLemma":"فريق المشتريات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"فريق المشتريات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

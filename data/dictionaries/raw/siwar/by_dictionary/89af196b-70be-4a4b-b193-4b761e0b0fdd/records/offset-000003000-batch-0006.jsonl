{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/faf2fe4f-65a0-4bd3-aac7-8e0f0b3580c0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"faf2fe4f-65a0-4bd3-aac7-8e0f0b3580c0","word":"Statistics","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bcb8","lexicalEntryId":"faf2fe4f-65a0-4bd3-aac7-8e0f0b3580c0","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"لإحصائيات","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يتضمن جمع البيانات وتصنيفها وتلخيصها وتنظيمها وتحليلها وتفسيرها. يتمثل الهدف الرئيسي لإحصاءات الأعمال في تقديم استنتاجات حول خصائص معينة لمجتمع ما في مجال الأعمال، سواء كان السكان أشخاصًا أو كائنات أو مجموعات من المعلومات.  فإحصائيات الأعمال هي علم البيانات الذي يساعد على اتخاذ قرارات العمل في ظل حالات عدم اليقين بناءً على بعض المقاييس الرقمية والقابلة للقياس. يتضمن جمع البيانات وتصنيفها وتلخيصها وتنظيمها وتحليلها وتفسيرها. أي فرع من فروع العلوم أو الرياضيات يهتم بجمع وتصنيف وتحليل وتفسير الحقائق أو البيانات العددية ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Statistics","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"لإحصائيات  Statistics","nonDiacriticsLemma":"لإحصائيات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"لإحصائيات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

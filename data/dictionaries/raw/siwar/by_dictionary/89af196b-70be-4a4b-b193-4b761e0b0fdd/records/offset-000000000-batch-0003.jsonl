{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5cced982-b61f-4615-90d5-0022903b10c3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5cced982-b61f-4615-90d5-0022903b10c3","word":"Realized Strategy","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b681","lexicalEntryId":"5cced982-b61f-4615-90d5-0022903b10c3","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"استراتيجية محققة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي نتاج استراتيجية الشركة المقصودة (أي ما خططت الشركة للقيام به)، والاستراتيجية المتعمدة للشركة (أي أجزاء الاستراتيجية المقصودة التي تواصل الشركة اتباعها بمرور الوقت)، واستراتيجيتها الناشئة (أي. ما فعلته الشركة ردًا على الفرص غير المتوقعة أي انها استراتيجية تستخدمها المنظمة في الممارسة ، سواء تم تطويرها من استراتيجيات ناشئة أو مقصودة أو كليهما","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Realized Strategy","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"استراتيجية محققة  Realized Strategy","nonDiacriticsLemma":"استراتيجية محققة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"استراتيجية محققة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ceabc593-c79c-499c-ab37-ff284150810c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ceabc593-c79c-499c-ab37-ff284150810c","word":"Intended Strategy","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b682","lexicalEntryId":"ceabc593-c79c-499c-ab37-ff284150810c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"استراتيجية مقصودة ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الإستراتيجية المقصودة هي الاستراتيجية التي تأمل المنظمة في تنفيذها. عادة ما يتم وصف الاستراتيجيات المقصودة بالتفصيل في الخطة الاستراتيجية للمنظمة. عندما يتم إنشاء خطة استراتيجية لمشروع جديد، فإنها تسمى خطة عمل.  أي هي استراتيجية مخططة لمنظمة ما، تم تشكيلها كنتيجة لعملية رسمية تحلل البيئة، وتأخذ في الاعتبار الموارد المتاحة، وتضع استراتيجية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Intended Strategy","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"استراتيجية مقصودة   Intended Strategy","nonDiacriticsLemma":"استراتيجية مقصودة ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"استراتيجية مقصودة "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

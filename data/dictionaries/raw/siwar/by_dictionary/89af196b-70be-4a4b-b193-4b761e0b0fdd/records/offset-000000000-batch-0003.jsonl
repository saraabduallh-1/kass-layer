{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/09210704-97c3-4687-bb69-13b1f67f1217/get-public-entry"},"browse_index_record":{"lexicalEntryId":"09210704-97c3-4687-bb69-13b1f67f1217","word":"Supplier Conditioning","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b68c","lexicalEntryId":"09210704-97c3-4687-bb69-13b1f67f1217","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"اشتراطات المورد","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو رحلة وليست حدثًا. إذا كنت تعمل باستمرار مع أحد الموردين للشراكة معك بشأن حلول خفض التكلفة والقيمة المضافة، فستكون ردودهم على طلباتك ومقترحات الأسعار الخاصة بهم أكثر واقعية.  أي عملية التأثير على الموردين للتصرف بطريقة معينة، وقبول ظروف أو معلومات معينة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Supplier Conditioning","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"اشتراطات المورد  Supplier Conditioning","nonDiacriticsLemma":"اشتراطات المورد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اشتراطات المورد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0811755a-4033-4917-b0a5-8083943cc6cc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0811755a-4033-4917-b0a5-8083943cc6cc","word":"Current Assets","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b68d","lexicalEntryId":"0811755a-4033-4917-b0a5-8083943cc6cc","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"اصول المتداولة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الأصول الحالية (تسمى أيضًا الأصول قصيرة الأجل) هي الأصول التي يستخدمها النشاط التجاري ويستبدلها و / أو يحولها إلى نقد خلال دورة تشغيل عادية (عادةً ما تكون أقل من 12 شهرًا). إنه يميزها عن الأصول طويلة الأجل، تلك التي يستخدمها النشاط التجاري لأكثر من عام. فهي أصول نقدية وأصول أخرى مملوكة لشركة ويمكن تحويلها بسهولة إلى نقد (من المتوقع أن يتغير الأصل الحالي في غضون أقل من اثني عشر شهرًا)","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Current Assets","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"اصول المتداولة  Current Assets","nonDiacriticsLemma":"اصول المتداولة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اصول المتداولة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/afa5df63-3735-4df7-8e2f-ea194c563218/get-public-entry"},"browse_index_record":{"lexicalEntryId":"afa5df63-3735-4df7-8e2f-ea194c563218","word":"Management Accounts","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba04","lexicalEntryId":"afa5df63-3735-4df7-8e2f-ea194c563218","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"حسابات الإدارة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"حسابات الإدارة هي تقارير مالية يتم إنتاجها لأصحاب الأعمال والمديرين، بشكل عام شهريًا أو ربع سنويًا، وعادةً ما تكون تقرير الربح والخسارة والميزانية العمومية. وهي من حيث المبدأ تشبه حسابات نهاية العام ولكنها أقل رسمية ويتم تخصيصها وفقًا لمتطلبات المستخدم. أي المعلومات المحاسبية التي يتم إعدادها على أساس منتظم، على سبيل المثال، شهريًا، للمساعدة في اتخاذ القرارات التجارية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Management Accounts","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"حسابات الإدارة  Management Accounts","nonDiacriticsLemma":"حسابات الإدارة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"حسابات الإدارة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dd7f8672-51f4-403d-9dc8-25a32f8e186c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dd7f8672-51f4-403d-9dc8-25a32f8e186c","word":"Material Breach","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba39","lexicalEntryId":"dd7f8672-51f4-403d-9dc8-25a32f8e186c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خرق مادي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في قانون العقود، يعتبر الخرق \"المادي\" للعقد خرقًا (فشلًا في تنفيذ العقد) يؤثر بعمق في قلب العقد لدرجة أنه يجعل الاتفاقية \"مخالفة بشكل لا يمكن إصلاحه\" ويفسد الغرض من إبرام العقد. المكان الأول.  فالإخلال الجوهري بالعقد هو إخفاق في الأداء. يمكن أن يكون هذا من جانب المشتري أو المورد. ويعتبر هذا الإخفاق كبيرًا لدرجة أنه يمنح الطرف الآخر الحق لإنهاء العقد و / أو رفع دعوى للحصول على تعويضات حسب الحالة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Material Breach","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"خرق مادي  Material Breach","nonDiacriticsLemma":"خرق مادي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خرق مادي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

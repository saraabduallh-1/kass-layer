{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4d383d69-5df3-4ab5-a921-fa499bdf38d4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4d383d69-5df3-4ab5-a921-fa499bdf38d4","word":"Services","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba31","lexicalEntryId":"4d383d69-5df3-4ab5-a921-fa499bdf38d4","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خدمات","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"من وجهة نظر الأعمال، فإن الشركات الخدمية هي تلك التي توفر نشاطًا أو أداء مهمة ذات غرض تجاري. يتم توجيه هذه المهمة لمساعدة شركة أو فرد في مواضيع مثل الاستشارات، والمحاسبة، والنقل، والتنظيف، والضيافة، والسفر أو الصيانة، من بين أمور أخرى.  أي العروض غير الملموسة من المؤسسات التي يختبرها العملاء أو يشاركون فيها لتلبية حاجة أو رغبة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Services","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"خدمات  Services","nonDiacriticsLemma":"خدمات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خدمات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5ba1d309-db35-49de-84e0-d317fc5f0d87/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5ba1d309-db35-49de-84e0-d317fc5f0d87","word":"Customer Service","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba32","lexicalEntryId":"5ba1d309-db35-49de-84e0-d317fc5f0d87","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خدمة العملاء","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي التفاعل المباشر الفردي بين المستهلك الذي يقوم بعملية الشراء وممثل الشركة التي تبيعها. يرى معظم تجار التجزئة هذا التفاعل المباشر كعامل حاسم في ضمان رضا المشتري وتشجيع تكرار الأعمال. عملية ضمان رضا العملاء عن منتج أو خدمة. هو تقديم خدمة للعميل قبل الخدمة وأثناءها وبعدها، مثل إجراء عملية بيع أو إرجاع عنصر. يمكن إجراء خدمة العملاء شخصيًا أو عن طريق مكالمة هاتفية أو عبر الإنترنت أو نظام الخدمة الذاتية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Customer Service","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"خدمة العملاء  Customer Service","nonDiacriticsLemma":"خدمة العملاء","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خدمة العملاء"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f39694f6-06c0-4c20-939b-56625633a090/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f39694f6-06c0-4c20-939b-56625633a090","word":"Global Logistics","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba33","lexicalEntryId":"f39694f6-06c0-4c20-939b-56625633a090","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خدمات لوجستية عالمية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تعد Global Logistics من الناحية الفنية عملية إدارة \"تدفق\" البضائع من خلال ما يسمى بسلسلة التوريد، من مكان إنتاجها إلى أجزاء أخرى من العالم. غالبًا ما يتطلب ذلك نظام نقل متعدد الوسائط، والنقل عبر المحيط والجو والسكك الحديدية والشاحنات.  فهي عملية إدارة تدفق البضائع من خلال سلسلة التوريد التي تشمل الموردين في مناطق جغرافية مختلفة وإلى المستهلك النهائي","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Global Logistics","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"خدمات لوجستية عالمية  Global Logistics","nonDiacriticsLemma":"خدمات لوجستية عالمية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خدمات لوجستية عالمية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/baee2d1b-3285-41b2-ba4b-666c94234bb3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"baee2d1b-3285-41b2-ba4b-666c94234bb3","word":"Integrated Logistics","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba34","lexicalEntryId":"baee2d1b-3285-41b2-ba4b-666c94234bb3","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خدمات لوجستية متكاملة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللوجستيات المتكاملة هي نموذج إدارة أعمال يستخدم بشكل متزايد لتسريع تسليم المنتج وتحسين خدمة العملاء. في هذا النموذج، يتم محاذاة جميع الأقسام والعمليات والموارد للعمل بمزامنة مثالية وتعمل كوحدة واحدة متماسكة.  حيث يتم إدارة جميع الوظائف التي تشكل سلسلة التوريد كعملية متكاملة واحدة بدلاً من وظائف فردية منفصلة. إنها نظرة شاملة على مستوى النظام لسلسلة التوريد بأكملها بدءًا من المواد الخام وحتى توزيع البضائع النهائية وحتى إدارة خدمة العملاء","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Integrated Logistics","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"خدمات لوجستية متكاملة  Integrated Logistics","nonDiacriticsLemma":"خدمات لوجستية متكاملة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خدمات لوجستية متكاملة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2090b6c6-a2fc-4c20-a967-9e45484f15e5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2090b6c6-a2fc-4c20-a967-9e45484f15e5","word":"Advisory، Conciliation And Arbitration Service (ACAS)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba35","lexicalEntryId":"2090b6c6-a2fc-4c20-a967-9e45484f15e5","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خدمة الاستشارات والتوفيق والتحكيم","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي وكالة غير حكومية تابعة لحكومة المملكة المتحدة وتعمل على تعزيز العلاقات الصناعية القوية وتقدم خدمة مصالحة محايدة لحل النزاعات بين أصحاب العمل والموظفين. وتهدف ACAS إلى مساعدة طرفي النزاع على الوصول إلى حل مقبول للطرفين على أمل تجنب التكلفة والوقت والضغوط المحتملة للمحكمة. وبهذا تهدف إلى تحسين المنظمات والحياة العملية من خلال علاقات عمل أفضل، والعمل مع أصحاب العمل والموظفين لحل المشكلات وتحسين الأداء.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Advisory، Conciliation And Arbitration Service (ACAS)                                                                                                                  ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"خدمة الاستشارات والتوفيق والتحكيم  Advisory، Conciliation And Arbitration Service (ACAS)                                                                                                                  ","nonDiacriticsLemma":"خدمة الاستشارات والتوفيق والتحكيم","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خدمة الاستشارات والتوفيق والتحكيم"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

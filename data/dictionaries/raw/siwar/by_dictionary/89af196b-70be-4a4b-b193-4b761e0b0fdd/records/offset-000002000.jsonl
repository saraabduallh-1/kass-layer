{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/303bdb71-0e0d-4a47-98e6-12e81fe8660f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"303bdb71-0e0d-4a47-98e6-12e81fe8660f","word":"Liabilities","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4ba3b","lexicalEntryId":"303bdb71-0e0d-4a47-98e6-12e81fe8660f","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"خصوم","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الخصوم هي الديون القانونية التي تدين بها الشركة لدائني الطرف الثالث. يمكن أن تشمل الحسابات الدائنة وأوراق الدفع والديون المصرفية. يجب على جميع الشركات تحمل المسؤوليات من أجل العمل والنمو. يوفر التوازن المناسب للمطلوبات وحقوق الملكية أساسًا ثابتًا للشركة.  فالديون أو الالتزامات المالية القانونية للشركة، والتي تنشأ أثناء سير عملياتها التجارية، بما في ذلك القروض والحسابات الدائنة والرهون العقارية والإيرادات المؤجلة والمصروفات المستحقة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Liabilities","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"خصوم  Liabilities","nonDiacriticsLemma":"خصوم","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خصوم"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

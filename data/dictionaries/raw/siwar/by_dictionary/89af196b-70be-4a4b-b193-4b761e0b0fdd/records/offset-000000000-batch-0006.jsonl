{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8326f4fd-9db1-4202-9bae-1f9c78ee6f01/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8326f4fd-9db1-4202-9bae-1f9c78ee6f01","word":"Optimization","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6d1","lexicalEntryId":"8326f4fd-9db1-4202-9bae-1f9c78ee6f01","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الأقوى","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"السعر الأمثل هو نقطة السعر التي يتم فيها تعظيم إجمالي ربح البائع. عندما يكون السعر منخفضًا جدًا، يقوم البائع بنقل عدد كبير من الوحدات ولكنه لا يحقق أعلى ربح إجمالي ممكن. أي أنه قرار يلزم فيه مراعاة عوامل متغيرة متعددة لتحديد أفضل مسار عمل أو نتيجة متاحة نظرًا للقيود. على سبيل المثال، يمكن التخطيط لإمكانية التوصيل كل ساعتين، ولكن يمكن أن تكون إمكانية التسليم اليومية هي الحل الأمثل، مما يقلل من استخدام السيارة، ويقلل التكاليف ويعزز الأداء البيئي","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Optimization ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"الأقوى  Optimization ","nonDiacriticsLemma":"الأقوى","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الأقوى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cc3baf3f-58ba-4be7-a3c1-89eb333d6fd4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cc3baf3f-58ba-4be7-a3c1-89eb333d6fd4","word":"Unliquidated Damages","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6d2","lexicalEntryId":"cc3baf3f-58ba-4be7-a3c1-89eb333d6fd4","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الأضرار غير المصفاة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو مقدار التعويضات التي قررتها المحكمة لأن طرفي العقد لم يتفقوا مقدمًا على مقدار الأضرار التي ستدفع لخرق شروط العقد. لم يكن من الممكن توقع الأضرار غير المصفاة لذلك تم البت فيها من قبل المحكمة.  وهو مصطلح في العقد يسمح لأحد الطرفين بالمطالبة بتعويضات من طرف آخر في حالة حدوث خرق، لكنه لا يحدد مسبقًا المبلغ الذي يمكن المطالبة به","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Unliquidated Damages","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الأضرار غير المصفاة  Unliquidated Damages","nonDiacriticsLemma":"الأضرار غير المصفاة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الأضرار غير المصفاة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/58070f88-811b-4bc5-a1ce-e04f5072ab5c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"58070f88-811b-4bc5-a1ce-e04f5072ab5c","word":"De Facto","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6d3","lexicalEntryId":"58070f88-811b-4bc5-a1ce-e04f5072ab5c","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الأمر الواقع","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو الشركة التي لم تكمل عملية التأسيس ولكنها تمارس الأعمال التجارية كما لو كانت شركة قانونية. يمكن لشركات الأمر الواقع أن تكون أيضًا شركات تم تعليقها أو حلها ولكنها لم تتوقف عن العمل.  وتُستخدم في السياقات القانونية لتعني أن شيئًا ما يحدث أو يوجد في الواقع.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"De Facto","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الأمر الواقع  De Facto","nonDiacriticsLemma":"الأمر الواقع","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الأمر الواقع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5288ed48-524b-406b-b891-b546a2a8ad17/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5288ed48-524b-406b-b891-b546a2a8ad17","word":"Injunctions","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6d4","lexicalEntryId":"5288ed48-524b-406b-b891-b546a2a8ad17","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الأمر الزجري التجاري","lemmaType":"MWE","pattern":" ","senses":[{"definition":"الأمر الزجري التجاري هو أمر قانوني لاتخاذ إجراء معين أو الامتناع عنه. يحاول الأمر الزجري جعل الوضع غير العادل أكثر إنصافًا، إما من خلال التمسك بالسياسة القائمة أو إنشاء سياسة جديدة. يمكن لشركة ما أن تطلب أمر قضائي ضد شركة أخرى.  فهي أوامر قضائية تمنع أي شخص من بدء أو استمرار عمل يهدد أو ينتهك الحق القانوني للآخر، أو يجبر شخصًا على القيام بعمل معين","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Injunctions","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"الأمر الزجري التجاري  Injunctions","nonDiacriticsLemma":"الأمر الزجري التجاري","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الأمر الزجري التجاري"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

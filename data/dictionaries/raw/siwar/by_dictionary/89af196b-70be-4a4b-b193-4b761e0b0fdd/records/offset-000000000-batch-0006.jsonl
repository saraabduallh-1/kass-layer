{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f3c08d80-c5c4-4645-b8c2-c065de076455/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f3c08d80-c5c4-4645-b8c2-c065de076455","word":"Lean","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6d9","lexicalEntryId":"f3c08d80-c5c4-4645-b8c2-c065de076455","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"البساطة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"الأعمال التجارية الخالية هي شركة تعمل على زيادة القيمة إلى أقصى حد مع تقليل الهدر. يركز نموذج الأعمال الخالي من الهدر على تحسين العمليات عبر تدفق القيمة من أجل القضاء على الهدر وتقديم قيمة محسّنة للعميل.  فنتيجة أنشطة تقليل النفايات بما في ذلك إزالة عناصر عمليات الإنتاج التي لا تضيف قيمة للمنتج النهائي","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Lean","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"البساطة  Lean","nonDiacriticsLemma":"البساطة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"البساطة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

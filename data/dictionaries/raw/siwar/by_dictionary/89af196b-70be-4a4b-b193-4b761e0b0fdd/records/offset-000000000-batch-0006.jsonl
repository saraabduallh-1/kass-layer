{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ab2d4ffb-b1a0-4a36-a8a4-14f8d32612ec/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ab2d4ffb-b1a0-4a36-a8a4-14f8d32612ec","word":"Introversion","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4b6c4","lexicalEntryId":"ab2d4ffb-b1a0-4a36-a8a4-14f8d32612ec","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"الإنطوائية","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"\"الانطوائية هي مجموعة من نقاط القوة والضعف، والانبساطية أيضًا؛ لذلك ستحتاج إلى مزيج من الاثنين إذا كنت تريد أن يحقق عملك أفضل أداء \"، كما كتب أحد الخبراء في Entrepreneur. أي عمل يحتاج إلى توازن جيد بين المهارات ووجهات النظر والمواهب فالانطوائية هي إحدى السمات الرئيسية للشخصية. يميل الفرد الانطوائي إلى التفكير الداخلي، ويركز على الأفكار والمشاعر والحالات المزاجية الداخلية بدلاً من السعي وراء التحفيز الخارجي. غالبًا ما يُساء تفسير الأفراد الانطوائيين على أنهم خجولون ولكن الكثيرين يتواصلون اجتماعيًا بسهولة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Introversion","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"الإنطوائية  Introversion","nonDiacriticsLemma":"الإنطوائية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الإنطوائية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

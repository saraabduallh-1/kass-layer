{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/45854b4d-ab9c-4fb2-8e22-736bfeab7a77/get-public-entry"},"browse_index_record":{"lexicalEntryId":"45854b4d-ab9c-4fb2-8e22-736bfeab7a77","word":"Internal Rate Of Return (IRR)","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bda2","lexicalEntryId":"45854b4d-ab9c-4fb2-8e22-736bfeab7a77","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"معدل العائد الداخلي","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو مقياس يستخدم في التحليل المالي لتقدير ربحية الاستثمارات المحتملة. IRR هو معدل خصم يجعل صافي القيمة الحالية (NPV) لجميع التدفقات النقدية مساوياً للصفر في تحليل التدفق النقدي المخصوم. تعتمد حسابات IRR على نفس الصيغة مثل NPV. فهي طريقة تقييم الاستثمار التي تبحث عن عائد أو عائد برنامج باستخدام التدفقات النقدية المخصومة","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Internal Rate Of Return (IRR) ","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"معدل العائد الداخلي  Internal Rate Of Return (IRR) ","nonDiacriticsLemma":"معدل العائد الداخلي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"معدل العائد الداخلي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

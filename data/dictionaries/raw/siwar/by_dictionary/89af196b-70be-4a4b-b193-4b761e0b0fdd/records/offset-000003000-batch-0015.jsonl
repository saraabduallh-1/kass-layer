{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8d9ee423-ad4a-4347-86a6-202c8ba8bb75/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8d9ee423-ad4a-4347-86a6-202c8ba8bb75","word":"Handling","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df21c18772c6cf4bd96","lexicalEntryId":"8d9ee423-ad4a-4347-86a6-202c8ba8bb75","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"معالجة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يتطلب توظيف عادات العقل مزيجًا من العديد من المهارات والمواقف والإشارات والتجارب السابقة والميول. هذا يعني أننا نقدر نمطًا واحدًا من التفكير على الآخر، وبالتالي فهو يعني ضمناً اتخاذ القرار بشأن النمط الذي ينبغي استخدامه في أي وقت.  تنسيق وتكامل العمليات اللازمة لنقل البضائع، بما في ذلك التعبئة والتجميع والتحميل والتفريغ والفصل والشحن. قد يتم سرد الرسوم لـ \"الشحن والمناولة\"، حيث يكون الشحن هو تكلفة النقل المادية والمناولة هي كل ما يرتبط بها","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Handling","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"معالجة  Handling","nonDiacriticsLemma":"معالجة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"معالجة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

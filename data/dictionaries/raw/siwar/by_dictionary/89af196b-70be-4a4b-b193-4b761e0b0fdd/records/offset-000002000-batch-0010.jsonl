{"source":{"platform":"SIWAR","dictionary_id":"89af196b-70be-4a4b-b193-4b761e0b0fdd","dictionary_name":"قاموس العقود والمشتريات وسلاسل الإمداد","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/89af196b-70be-4a4b-b193-4b761e0b0fdd","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/59c99e41-2fdf-45e3-b8b6-f16dca81db68/get-public-entry"},"browse_index_record":{"lexicalEntryId":"59c99e41-2fdf-45e3-b8b6-f16dca81db68","word":"Incoterms","languageCode":"en","belongsTo":"translation"},"entry":{"_id":"68f89df11c18772c6cf4bb2e","lexicalEntryId":"59c99e41-2fdf-45e3-b8b6-f16dca81db68","lexiconId":"89af196b-70be-4a4b-b193-4b761e0b0fdd","lexiconName":"قاموس العقود والمشتريات وسلاسل الإمداد","lemma":"شروط البيع الواسطة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي شروط البيع المستخدمة على نطاق واسع، هي مجموعة من 11 قاعدة معترف بها دوليًا تحدد مسؤوليات البائعين والمشترين. تحدد مصطلحات التجارة الدولية من هو المسؤول عن دفع تكاليف الشحن وإدارتها والتأمين والتوثيق والتخليص الجمركي والأنشطة اللوجستية الأخرى.  ويطلق عليها الشروط التجارية الدولية -سلسلة من المصطلحات العامة، تم تطويرها من خلال غرفة التجارة الدولية، والتي تحدد خيارات مختلفة للتكاليف والمخاطر المرتبطة بنقل البضائع عبر الحدود الدولية","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"tags":[],"dynamicProps":null,"domains":[],"translations":[{"word":"Incoterms","language":"en","languageLabel":"الإنجليزية"}],"imageGallery":[]}],"wordForms":[],"relatedSenses":[],"search":"شروط البيع الواسطة  Incoterms","nonDiacriticsLemma":"شروط البيع الواسطة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"شروط البيع الواسطة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[],"__v":0}}

ى  range extender   A fuel-based auxiliary power unit that extends the range of a battery-electric vehicle by generating electricity to charge the battery, either integrated with or separate from the electric motor and generator.","nonDiacriticsLemma":"موسع المدى","metaData":{"periodDateFrom":null,"periodDateTo":null},"lammaDetails":[{"form":"موسع المدى"}],"autoGeneratedRoot":null,"entryRelations":[],"dynamicProps":[]}}

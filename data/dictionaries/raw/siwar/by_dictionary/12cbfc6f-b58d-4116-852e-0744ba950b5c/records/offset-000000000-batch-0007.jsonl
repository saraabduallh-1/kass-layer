{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8d5773c5-ffaa-4bc8-8592-e5ad1522e689/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8d5773c5-ffaa-4bc8-8592-e5ad1522e689","word":"دور الحُلّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba4eb","lexicalEntryId":"8d5773c5-ffaa-4bc8-8592-e5ad1522e689","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"دور الحُلّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":" ارتبط هذا الدور باللّباس* الذي كان يرتديه الخدَم في القرنين السابع عشر والثامن عشر، والذي كان يميّزهم اجتماعيًا. واقترن في المسرح بفئة من الخدَم واكتسى طابعاً هزْليا نظراً لما عُرفت به هذه الفئة من خبث ودهاء ومقالب.  ويُقال في اللغة المسرحية الخاصة «لبس الحُلّة» أي تقمّص الأدوار الهزلية الأولى دون أن تكون هذه الأدوار مرتبطة بالحلّة ذاتها. لذلك كان هذا الدور محلّ منافسة شديدة بين الممثِلين الهزليين. وقد برع في تأدية هذه الأدوار في القرن الثامن عشر كل من الممثلتين دوغازون Dugazon ودازنكور d’Azincourt. وقد كان التنافس بينهما على أشدّه.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":" Livery role","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Rôle à livrée","language":"fr","languageLabel":"الفرنسية"}]}],"wordForms":[],"relatedSenses":[],"search":"دور الحلة   Livery role Rôle à livrée","nonDiacriticsLemma":"دور الحلة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"دور الحُلّة"}],"lemmaLanguage":{"code":"ar","label":"
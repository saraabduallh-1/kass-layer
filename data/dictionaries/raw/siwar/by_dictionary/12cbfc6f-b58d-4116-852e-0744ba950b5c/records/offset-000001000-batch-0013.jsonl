{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4c666c63-12b9-4bf1-b919-572ea9ec1f1f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4c666c63-12b9-4bf1-b919-572ea9ec1f1f","word":"الرّثَّاثُ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba6d1","lexicalEntryId":"4c666c63-12b9-4bf1-b919-572ea9ec1f1f","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"الرّثَّاثُ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" عامل في الفرقة المسرحيّة يُكلّف بشراء بعض الملابس القديمة الملائمة للدور والمرتبطة إمّا بحقبة تاريخية أو بوَسَط اجتماعي أو بمظهر خارجي الخ.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":" Clothers dealer","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Fripier","language":"fr","languageLabel":"الفرنسية"}]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"الرثاث   Clothers dealer Fripier","nonDiacriticsLemma":"الرثاث","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الرّثَّاثُ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/552d49c6-f16d-4f2a-9b0a-e016d32bed4d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"552d49c6-f16d-4f2a-9b0a-e016d32bed4d","word":"السّاذجَة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba6d2","lexicalEntryId":"552d49c6-f16d-4f2a-9b0a-e016d32bed4d","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"السّاذجَة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" هو دور محكوم بمعيار الصفة راجع:  @(الأدوار المتشابهة)  يحيل على فتاة طاهرة، ساذجة دون أن تصل السذاجة عندها إلى درجة الحمق أو التصنّع.  ينفتح قلب هذه الفتاة للحبّ ولإيقاع العشق لأول مرّة، فتتعامل مع من يحيط بها بتلقائيّة وبراءة. وتتطلّب تأديةُ هذا الدور حِرَفِية كبيرة على عكس ما يُعتقد؛ لذلك لم يكن سنّ المُمثلة المعيارَ الأساسي في المسرح الكلاسيكي* وإنّما طريقة التأدية. وهذا ما يفسّر تقمّصَ بعض الممثّلات الشهيرات لهذا الدور رغم تقدّمهن في السنّ.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Ingenue","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Ingénue","language":"fr","languageLabel":"الفرنسية"}]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"الساذجة  Ingenue Ingénue","nonDiacriticsLemma":"الساذجة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"السّاذجَة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ec7f0af2-d0d4-4ccb-8881-46c7e5028c4a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ec7f0af2-d0d4-4ccb-8881-46c7e5028c4a","word":"السّجال","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba6d3","lexicalEntryId":"ec7f0af2-d0d4-4ccb-8881-46c7e5028c4a","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"السّجال","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" هو مفهوم متعدّد المعاني، حفَل تاريخه بشروح كثيرة. فقد كان في البدْء دالاًّ على الصّراع في المعارك، ثم تطوّر المعنى ليُفيد المقارعة في المناظرات الفنّية والرياضية التي كانت تُقام على هامش الاحتفالات الدينية. ومن أشهر السجالات يمكن أن نذكر الألعاب الأولمبية والنّيميّة وغيرها. وقد كانت تقام دوْرِيًا متضمّنةً مبارياتٍ رياضيةً وفروسية وموسيقية.  لاحقا، تطور المعنى وارتحل اللفظ إلى سجل البلاغة ليفيد المحاجّة بالاستدلال كما هوالشأن في الافتتاح* بالإضافة إلى ذلك، اتصل المفهوم بالحقل المسرحي ليفيد المنافسة في المناظرات الدرامية التي كان يشارك فيها كبار الكتّاب الدراميين الإغريق، كل بمسرحيات ثلاث تنتهي بتتويج الفائز.  في ذات السياق، اكتسب اللفظ معنى جماليا مسرحيا مخصوصاً موصولاً بالفنّية الدرامية، إذ أصبح يفيد جزءًا من الملهاة الإغريقية القديمة، يتّسم بالجدل بين شخصيتين تدافع كل منهما عن طرح مختلف. مثال ذلك جدل العادل وغير العادل في مسرحية السّحب الجَشّاء لأرسطوفان Aristophane, Les nuées. بخصوص طبيعة المسرح هنالك من النقاد من يرى أنه سِجاليٌ أو لا يكون. ويظهر ذلك عبر عناصر كثيرة ومتنوّعة منها الرّدود والرّدود المضادّة، والرّدود السّجالية* والمساجلة الهوميرية* ونحوها من هذا المنطلق، تُبَوّب الشخصيات حسب درجة انخراطها في الصراع. راجع:  @(الشخصية السجالية الأولى)  و  @(الشخصية السجالية الثانية)  و  @(الشخصية السجالية الثالثة) .   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Agon","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Agon","language":"fr","languageLabel":"الفرنسية"}]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"السجال  Agon Agon","nonDiacriticsLemma":"السجال","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"السّجال"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/adc1b43f-2220-4e9c-bb31-f1268abfdb6d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"adc1b43f-2220-4e9c-bb31-f1268abfdb6d","word":"السّتارة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba6d4","lexicalEntryId":"adc1b43f-2220-4e9c-bb31-f1268abfdb6d","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"السّتارة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" خلافاً لما يَعتقِد عامّة الناس، لا توجد بالمسرح ستارة واحدة فحسب وإنما ستائر عديدة، تختلف باختلاف وظائفها، منها ما ارتبط ظهورُه باعتبارات لا تمتُّ إلى الفنّ بأيّة صلة كالستارة الحديدية التي تفصل القاعة عن الركح* والفضاءات الملحَقة به، لتأمين سلامة المتفرجين عند نشوب الحرائق.  وإذا كانت بعض المسارح تفتقر إلى مثل هذه الستائر، فإن المسارح في العالم الغربي تكاد تكون كلُّها مُجَهّزة بها بموجب قانون صدر في بداية القرن العشرين، إثر تعرُّض أحدها إلى حريق نجمتْ عنه خسائرُ ماديةٌ وبشرية هائلة. أمُا القسم الثاني من الستائر فيضُمّ، علاوة على الستارة الخلفية، ستارة َصدرِ المسرح. وقد ظهرت هذه الستارة الأمامية في القرن السادس عشر بإيطاليا. وأصبحت، مع مرور الزمن، وسيلة من الوسائل العديدة المتوفّرة للمخرج لتقطيع العرض راجع:  @(التّقطيــــــــــــــع) .  وفي ما يخصّ رفع السّتارة وإنزالها يتّبع الآلاتيون إحدى الطرق التالية حسب ما يتوفّر في قاعات العروض:  - الطريقة الألمانية: تُرفَع الستارة وتُنزَل عموديّاً - الطريقة الإيطالية: عند فتح الستارة يقع جذب الجزء الأوّل نحو اليسار والجزء الثاني نحو اليمين.  - الطريقة الفرنسية: وهي تأليفية أو مزدوجة، إذ تأخذ من الأولى الرّفعَ العمودي ومن الثانية تقسيم الستارة إلى جزئين.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Curtain","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Rideau","language":"fr","languageLabel":"الفرنسية"}]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"الستارة  Curtain Rideau","nonDiacriticsLemma":"الستارة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"السّتارة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/01c2ef77-9186-4c8d-921b-903dca60af4b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"01c2ef77-9186-4c8d-921b-903dca60af4b","word":"السّردية","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba6d5","lexicalEntryId":"01c2ef77-9186-4c8d-921b-903dca60af4b","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"السّردية","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" يُميّز اللسانيون الغربيون تمييزاً قاطعاً، بين نظامي السرد والخطاب، إذ لكل منهما مرتكزاته الخاصة (الضمائر، أزمنة الأفعال الخ).  بالتّوازي مع هذا التّبويب أو التّمييز، ظهرت مفاهيم أو مصطلحات يمكن اعتبارها عابرة للأجناس وخاصّة النظاميين آنِفَيْ الذّكر كالشّعرية والسّردية. فكما أن الشّعرية لا يرتبط وُجودها حصريا بالقصائد الشعرية العمودية والحرة وإنما يتعداها ليشمل النصوص النثرية (المقامات مثلاً)، فإنّ السردية ليست أيضاً حكرا على النصوص المبوبة تحت نظام السرد (القصة، والخرافة ونحوه)؛ ففي النص المسرحي - وهو الذي ينتمي إلى نظام الخطاب - توجد «بقايا سردية» كثيرة كما يقول جيرار جونات Gérard Genette، فعلاوة على الأُحدوثة التي تسند النص وما يتفرع عنها من حبك وأشكال تحاورية ذات مضامين سردية بينة كالقصص التحاوري* مثلاً، تؤكد الدراسات التطبيقية ذات المنحى البنيوي على وجود عناصر سردية أخرى تنتظم في النّص وتتوزّع داخله على مستويين اثنين وجب التمييز بينهما:  المكوّن الأول هو الوحدة السردية الصغرى وهي، كما يصفها رولان بارط Roland Barthes مجرّد «حشو ضروري»، بما أنّ الحدث الذي تتشكل منه أو تحيل عليه لا يستمدّ قيمته من ذاته وإنّما من دوره كمُمهّد للحدث الرئيسي الذي يُفضي إليه. ورغم أن مفهوم المصطلح ارتبط عند بلورته بالنص السردي، فإنه سُحب أيضاً في الدراسات الأكاديمية المعمّقة، على النص المسرحي، حيث تقوم بعض المُمسرحيات مثلاً مقام الوحدات السردية الصغرى.  أمّا المكوِّن الثاني، فيُعرف بالنواة السردية أي الحدث البارز، فِعْليًا كان أوقوليا، والذي يُتوج سلسلة الأحداث الصغرى في المقطع ككل. فلو أخذنا على سبيل المثال، وضعية درامية يتأهب فيها المحب للبوح إلى حبيبته بسرٍّ يؤرّقه لتبيّنا أن المُسارّة في هذا المقطع هي النواة السردية وأنّ الأحداث التي تسبق لحظة البوح هذه، ليست إلاّ وحدات صغرى.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Narrativity","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Narrativité","language":"fr","languageLabel":"الفرنسية"}]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"السردية  Narrativity Narrativité","nonDiacriticsLemma":"السردية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"السّردية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b654e3b8-4311-4ae4-9071-cdf5e84d833e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b654e3b8-4311-4ae4-9071-cdf5e84d833e","word":"طاليا","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba6d6","lexicalEntryId":"b654e3b8-4311-4ae4-9071-cdf5e84d833e","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"طاليا","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" تختصّ طاليا، بوصفها واحدة من آلهة الإلهام التسعة اللائي يحرُصن الآداب والفنون والعلوم، برعاية الملهاة* وذلك بالتوسّط بين الهزلياتيين والقُوى الملهمة للهزل.  تُصوّر الأساطير اليونانية طاليا في شكل فتاة ضحوك تُمسك بيدها قناعا زاهيا وتضع على رأسها تاجا من ورق اللّبلاب.  نشير - خلافاً لأغلب القراءات التي ترى في هذه الإلاهة ملهمة للملهاة* بكل تفرّعاتها الأجناسيّة (المحاكاة السّاخرة، ملهاة الطبائع*، ملهاة السلوك* الخ) كما تدل على ذلك رمزيةُ مظهرها الخارجيّ - إلى أنّ ثمة من يرى أنّ رعايتها مقتصرة على الملهاة الرّعوية* دون سواها، وما وجود تاج نباتي على رأسها إلاّ تأكيد على ذلك.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Thalia","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Thalie","language":"fr","languageLabel":"الفرنسية"}]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"طاليا  Thalia Thalie","nonDiacriticsLemma":"طاليا","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"طاليا"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f87a5552-2f18-442c-83e5-585289bed832/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f87a5552-2f18-442c-83e5-585289bed832","word":"الشّحن","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba6d7","lexicalEntryId":"f87a5552-2f18-442c-83e5-585289bed832","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"الشّحن","lemmaType":"singleWord","pattern":" ","senses":[{"definition":" هو لفظٌ متعدّد الدّلالة يفيد الحِمْل الإضافي، و الثِّقلَ والعبءَ والتضخيم والمبالغة. وكلّها مدلولات تشي بالإفراط وتجاوز الحدود المعقولة.  أمّا في حقل الأدب والمسرح تحديداً، فيرتبط المصطلح بالنموذج الأوفى* لأنه قائم على المبالغة. يتّصل الشحن أيضاً بالهَزْل كمقولة درامية ثابتة، وتظهر المبالغة في النفسِ التحريفي الهزلي والهزْليّ الوضيعِ وفي التصوير التحريفي.  على مستوى العرض، يتجلّى الشّحْنُ في الإكثار من الحركات، وفي الحماسة الفيّاضة وغيرها من الصيّغ التي يُستخلص منها إمّا ضحالة أداء الممثل*، أو نخر النفس* المسرحي من الداخل عن طريق السخرية وتحريف البطولي والمأساوي على حد السواء.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Caricature","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Charge","language":"fr","languageLabel":"الفرنسية"}]}],"pos":"N","wordForms":[],"relatedSenses":[],"search":"الشحن  Caricature Charge","nonDiacriticsLemma":"الشحن","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الشّحن"}],"lemmaLanguage":{
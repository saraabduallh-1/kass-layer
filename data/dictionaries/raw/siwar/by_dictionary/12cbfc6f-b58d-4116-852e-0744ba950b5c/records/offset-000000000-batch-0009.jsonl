{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7729b369-ffec-4a90-a6cd-f04823ff4768/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7729b369-ffec-4a90-a6cd-f04823ff4768","word":"الضّجيج المُصطنع","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba519","lexicalEntryId":"7729b369-ffec-4a90-a6cd-f04823ff4768","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"الضّجيج المُصطنع","lemmaType":"MWE","pattern":" ","senses":[{"definition":" أثار مفهوم الضجيج المصطنع لدى أصحاب الاختصاص نقاشا واسعا قدمت فيه الأطراف المتجادلة تحاليل وحججا ذات بال.  فإذا كان الجميع لا ينازع في ما يُنسب إلى الضجيج من وظائف في العالم السمعي البصري (عرض غنائي، سينما، مسرح، مسرح إذاعي الخ)، فإن الخلاف قائم في تعريف هذا المصطلح بين من يرى أنه يشمل كلّ الأصوات التي ترافق العرض سواء أُنتجت أثناءه أو جُهّزت قبل انطلاقه، وبين شق آخر يشدّد على ضرورة استثناء الصنف الثاني من الأصوات (أي المجهزة مسبقاً) وربطها بمصطلح آخر، يتقاطع معه، ولكنّه مختلف عنه بعض الشيء وهو التركيب الصوتي.  هذا الاستثناء أو هذا الرأي الذي يميّز بين الأصوات حسب زمن وطريقة إنتاجها له استتباعات كثيرة أهمها التسليم بوجود صنفين من قيِّمي الضجيج المصطنع: يضمّ القسم الأول فنّيين يتمتعون بقدرة وبراعة يدوية وصوتية تُوَظّفُ لإنتاج الأصوات (تقليد حوافر الخيل، محاكاة بعاق الخنازير...) مستعينين عند الحاجة ببعض الحيل التقنية البسيطة عادة (بعثرة حبات الأرز على الممطرية لإيهام المتفرج أو المستمع بنزول المطر، مثلاً).  أما القسم الثاني، فيتكون من تقنيين سامين لا تتجاوز مهامّهم تسجيل وتحميل الأصوات المطلوبة من الحواسيب ونحوها، وهي متوفرة بكثرة، وبثها أثناء العرض في الأوقات المخصصة لها.  وأيّا كان الأمر، يُعتبر الضجيج المصطنع، في كلّ الحالات من قبيل الزخارف السمعية الضرورية، لا في الإخراج الإذاعي* فحسب، حيث يَتْرك النصّ فراغات يجب ملؤها، وإنما أيضاً في السينما والمسرح حيث تساهم هذه الزخارف بفضل وظائفها الإخبارية والمرجعية والسردية المتداخلة، في خلق الأجواء الخارجية (الضجيج المنبعث من المطارات أو المناطق الصناعية) والداخلية (أصوات الآلات الكهرومنزلية) وفي تأطير الأحداث في الزمان والمكان (قرع أجراس الكنائس أو المعامل وارتفاع أصوات المآذن) وهكذا تتحول الأصوات إلى صور وهذا ما يفسّر تحديداً وصفها بالزخارف.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Sound effects","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Bruitage","language":"fr","languageLabel":"الفرنسية"}]}],"wordForms":[],"relatedSenses":[],"search":"الضجيج المصطنع  Sound effects Bruitage","nonDiacriticsLemma":"الضجيج المصطنع","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الضّجيج المُصطنع"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

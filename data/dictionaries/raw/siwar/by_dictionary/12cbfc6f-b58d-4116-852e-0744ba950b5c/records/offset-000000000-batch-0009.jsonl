{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1e5eff45-acfa-4b57-9f9a-b62ac2a62d3d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1e5eff45-acfa-4b57-9f9a-b62ac2a62d3d","word":"الشّخصية المُحفِّزة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba51c","lexicalEntryId":"1e5eff45-acfa-4b57-9f9a-b62ac2a62d3d","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"الشّخصية المُحفِّزة","lemmaType":"MWE","pattern":" ","senses":[{"definition":" تتموقع هذه الشخصية على تخوم نماذج من الشخصيات الأخرى القريبة منها كالبطل والشخصية الواصلة*. وهذا ما فتح الباب على مصراعيْه أمام تدفّق التعابير الضبابية والتعريفات المُمطَّطة، المعتمدة في شأنها.  لكن، بالرجوع إلى اللفظ اللاتيني المرادف لكلمة محفّزة، واعتمادا على المعنى الكيميائي الذي يحيل عليه في حقله المعرفي الأصلي - قبل أن يهاجر إلى السّرديات واللّسانيات، وَجد أصحاب الاختصاص أرضية انطلاق صلبة لتعريف هذه الشخصية فأجمع جلّهم تقريباً على ميزتها الأساسية والمتمثلة في قدرتها على التفاعل في محيطها إما بمجرّد تواجدها أو بالفعل فيه.  ومع هذا، لا ينهي هذا التعريفُ الجدلَ والغموض إذا ما نزّلناه على أرض الواقع، فالنماذج والأمثلة التي تستجيب لهذا الوصف وتدخل في هذا القالب تختلف عن بعضها بعضاً اختلافاً جذريا وجوهريا كالشخصية المنفلتة* التي لا يختلف اثنان في قدرتها على التأثير أو دور المجنون في السينما كما في شريط الجزائري لخضر حمينة «وقائع سنوات الجمر» أو في المسرح كما في مسرحية هوغو الملك يتلهّى Hugo, Le roi s’amuse مثلاً.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Catalytic character","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Personnage catalyseur","language":"fr","languageLabel":"الفرنسية"}]}],"wordForms":[],"relatedSenses":[],"search":"الشخصية المحفزة  Catalytic character Personnage catalyseur","nonDiacriticsLemma":"الشخصية المحفزة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الشّخصية المُحفِّزة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

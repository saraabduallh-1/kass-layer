{"source":{"platform":"SIWAR","dictionary_id":"12cbfc6f-b58d-4116-852e-0744ba950b5c","dictionary_name":"معجم اللغة المسرحية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/12cbfc6f-b58d-4116-852e-0744ba950b5c","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7f772191-b280-4542-ac36-883dfeed0b15/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7f772191-b280-4542-ac36-883dfeed0b15","word":"السّطيح المتحرّك","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f034488fbbda6dfaba513","lexicalEntryId":"7f772191-b280-4542-ac36-883dfeed0b15","lexiconId":"12cbfc6f-b58d-4116-852e-0744ba950b5c","lexiconName":"معجم اللغة المسرحية","lemma":"السّطيح المتحرّك","lemmaType":"MWE","pattern":" ","senses":[{"definition":" عنصر من عناصر الزّخرف*، وهو عبارة عن هيكل خفيف يُركّب تركيبا، ويُفكَّك بيسر. ويتمثل في قِطَع معدنية مختلفة الأشكال والأحجام تُشدّ إلى بعضها بعضا. ويقوم السطيح على أعمدة يمكن التحكّم في طولها وقصرها، حسب مقتضيات التصميم الركحي*. وهو قابل للتعديل والتكييف والتغيير، إذ يزيد حجمه أو ينقص حسب مساحة فضاء اللعب*. ويمكن أن يكون متحرّكا في بعض الأحيان، إذ يستند إلى أرجل أو قوائم تنتهي بعجلات، فيُجَرُّ جرا أو يتزحلق وفوقه الممثلون، على سِكّة بين المشاهدين في القاعة إذا ما كانت جمالية الإخراج* تروم مشاركةَ الجمهور.  ويُوظَّفُ السّطيح لغايات مختلفة ويتخذ أشكالاً عدة: يُستعمل في الزخرف المبني* كمِنصّة أو مسطبة مستطيلة أو مسلك يمرّ منه الممثلون من فضاء الركح* إلى خارجه (ولذلك سمي بالزخرف المَسْلَك)، فيعطي انطباعاً بأن الفضاء مفتوح. كما يحدث أن يُصَمم على شكل بناء مُدرّج، ذي طوابق يصعد إليها الممثلون حسب ما يفرضه الدور والوضعية.  لكل هذه الخصائص والوظائف، وغيرُها كثير، يحتلّ السطيح الزخرفي مكانة هامّة في المسرح، ويمثّل دعامة من دعامات التشكّل الركحي*.   ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Rostrum","language":"en","languageLabel":"الإنجليزية"}]},{"definition":" ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Praticable","language":"fr","languageLabel":"الفرنسية"}]}],"wordForms":[],"relatedSenses":[],"search":"السطيح المتحرك  Rostrum Praticable","nonDiacriticsLemma":"السطيح المتحرك","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"السّطيح المتحرّك"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/265e3f66-e4a5-4918-add5-20bd2df06b57/get-public-entry"},"browse_index_record":{"lexicalEntryId":"265e3f66-e4a5-4918-add5-20bd2df06b57","word":"الأبجديّة الصّوتيّة العالميّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface596","lexicalEntryId":"265e3f66-e4a5-4918-add5-20bd2df06b57","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الأبجديّة الصّوتيّة العالميّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو نظام صوتيّ عالميّ يُستخدم في الكتابة الصّوتيّة، حيث تُستعمل رموز معيّنة لتمثيل الأصوات. ويُعتمد لهذه الغاية جدولٌ خاصٌّ، يشتمل على كافة الرّموز الصّوتيّة المستخدمة لهذا الغرض، تصدره الرّابطة العالميّة للصّوتيّات International Phonetic Association. انظر علم الأصوات @(علم الصّوتيّات) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"International Phonetic Alphabet (IPA)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الأبجدية الصوتية العالمية  International Phonetic Alphabet (IPA)","nonDiacriticsLemma":"الأبجدية الصوتية العالمية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الأبجديّة الصّوتيّة العالميّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6a8a067d-8ffb-4fd3-a143-ba5d70020792/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6a8a067d-8ffb-4fd3-a143-ba5d70020792","word":"الاجتماعيّة الثّقافيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface597","lexicalEntryId":"6a8a067d-8ffb-4fd3-a143-ba5d70020792","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الاجتماعيّة الثّقافيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تُستخدم للإشارة بشكل عامّ إلى الطّرق الّتي تكون فيها اللُّغة والاتّصال ظواهر اجتماعيّة وثقافيّة. كما أنّها تُستخدم بطريقة أكثر تحديدًا للإشارة إلى نهج معيّن في علم النّفس الاجتماعيّ Social Psychology الّذي يركّز على الصّلة بين اللُّغة والفكر، والتّعلّم والتّدريس. وقد تطوّر الكثير من العمل في هذا المجال من خلال كتابات Lev Vygotsky، الّذي أكّد على أهميّة العلاقة بين اللُّغة والتّفاعل الاجتماعيّ والتّعلّم. انظر التّلمذة @(التّلمذة) ، ومنطقة التّطوير التّقريبيّ @(منطقة التّطوير التّقريبيّ) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Sociocultural","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الاجتماعية الثقافية  Sociocultural","nonDiacriticsLemma":"الاجتماعية الثقافية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الاجتماعيّة الثّقافيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2bef4783-9556-438d-b36e-b688478237f7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2bef4783-9556-438d-b36e-b688478237f7","word":"أخْذ الأدوار في الحديث","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface598","lexicalEntryId":"2bef4783-9556-438d-b36e-b688478237f7","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"أخْذ الأدوار في الحديث","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو الوسيلة الّتي يتمكّن من خلالها المتحدّثون من تنسيق وتحديد الأدوار التّحادثيّة Speaking Turns للأشخاص المشاركين في المحادثة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Turn-Taking","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"أخذ الأدوار في الحديث  Turn-Taking","nonDiacriticsLemma":"أخذ الأدوار في الحديث","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"أخْذ الأدوار في الحديث"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/10ba7e25-1a5e-4bd7-8d04-0066d1eec227/get-public-entry"},"browse_index_record":{"lexicalEntryId":"10ba7e25-1a5e-4bd7-8d04-0066d1eec227","word":"الاستقلاليّة، التّبعيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface599","lexicalEntryId":"10ba7e25-1a5e-4bd7-8d04-0066d1eec227","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الاستقلاليّة، التّبعيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلحان استخدمهما Peter Trudgill and J. K. Chambers (1980)  لتوصيف علاقات التّبعيّة Hetronomy/ الاستقلاليّة Autonomy بين الأصناف الّتي ترتبط لغويًّا وتاريخيًّا، وخاصّة في سياق سلسلة اللّهجات. ويشير مصطلح الاستقلاليّة إلى علاقة الاستقلاليّة، على سبيل المثال: اللُّغة الهولنديّة القياسيّة والألمانيّة القياسيّة، هما مستقلّتان فيما يتعلّق بعلاقة بعضهما ببعض؛ لأنّ لديهما وضعًا وهويّة منفصلتين، ومعايير لغويّة وتقاليد إملائيّة مختلفة. ومع ذلك، على المستوى المنطوق، هناك سلسلة متّصلة بين اللّهجات الهولنديّة واللّهجات الألمانيّة، كلّما اتّجه المرء من السّاحل الهولندي إلى الدّاخل الألماني. وعلى أساس لغويّ، لا يمكن تحديد أين تتوقّف اللُّغة الهولنديّة؟ ومَن يتحدّث بها؟ وأين يبدأ التّحدُّث بالألمانيّة؟ أمّا حدود اللّهجات ففيها كثير من السّمات المشتركة مع بعضها البعض أكثر من الخصائص المشتركة مع لهجات تقع في أطراف السّلسلة. ويحدّد المتكلّمون أنفسهم لهجاتهم على أنّها \"الهولنديّة\" أو \"الألمانيّة\" على أساس الحدود السّياسيّة واللُّغة القياسيّة لكلّ بلد، وليس بناء على الخصائص اللُّغويّة الفعليّة لخطابهم. Trudgill and Chambers يصفان هذا الوضع بأنّه واحدٌ من أوضاع التّبعيّة، أو عدم الاستقلاليّة، فقد وصف علم اللّهجات الهولنديّة على أنّها  تابعة (أي تعتمد على) اللُّغة الهولنديّة القياسيّة، واللّهجات المسمّاه باللّهجات الألمانيّة هي تابعة، وتعتمد على الألمانيّة القياسيّة.  إنّ تمييز الاستقلاليّة / التّبعيّة في علم اللّهجات البريطانيّة يشبه التمّييز بين لغاتAbstand  و Ausbau في تقليد تخطيط اللُّغة الألمانيّة، كما أنّ المصطلح  Uberdachung ينشأ أيضًا في العلاقة غير المتجانسة بين اللُّغة القياسيّة واللّهجة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Autonomy, Heteronomy","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الاستقلالية، التبعية  Autonomy, Heteronomy","nonDiacriticsLemma":"الاستقلالية التبعية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الاستقلاليّة، التّبعيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ca736112-3c20-444e-8777-015772ac6ec1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ca736112-3c20-444e-8777-015772ac6ec1","word":"الاختيار اللُّغويّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface59a","lexicalEntryId":"ca736112-3c20-444e-8777-015772ac6ec1","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الاختيار اللُّغويّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشير إلى اختيار المتحدِّثين بين اللُّغات أو الأنواع اللُّغويّة، على وجه الخصوص السّياقات اللُّغويّة Contexts أو مجالات الاستخدام Domains. معظم البحث المتعلّق بالاختيار اللُّغويّ أُجري على مجتمعات ثنائيّة اللُّغة Bilingual، ومتعدّدة اللُّغات Multilingual، حيث ارتبطت اللُّغات بنشاطات متعدّدة. على سبيل المثال، اللُّغة العالميّة International Language كاللُّغة الإنجليزيّة قد تُستخدم في التّفاعلات العامّة والرّسميّة في أماكن مختلفة؛ كالمؤسّسات التّعليميّة، وأماكن العمل المهنيّة. وتُستخدم اللُّغة المحليّة في تفاعل رسميّ أقلّ، أو في أماكن مختلفة؛ كالبيت. ولهذا ارتبطت اللُّغات بأماكن معيّنة، نشاطات... إلخ. ولا يتضمّن مصطلح الاختيار أن يحظى المتحدّثون للّغة بخيار غير مقيّد وكامل لما تتبنّاه اللُّغة. انظر @(التّناوب اللُّغويّ) و @(الازدواجيّة اللُّغويّة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Language Choice ","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الاختيار اللغوي  Language Choice ","nonDiacriticsLemma":"الاختيار اللغوي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الاختيار اللُّغويّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/347655ed-97ac-46e2-8759-68cd037f5be4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"347655ed-97ac-46e2-8759-68cd037f5be4","word":"إخراج النّفَس","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface59b","lexicalEntryId":"347655ed-97ac-46e2-8759-68cd037f5be4","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"إخراج النّفَس","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يُستخدم هذا المصطلح في الصّوتيّات للإشارة إلى نفخة من الهواء المصاحبة للتّعبير عن بعض الأصوات، وتتمثّل في الكتابة الصّوتيّة للرّمز (h) الّذي يُنطق في بعض اللُّغات أو في بعض تنوّعاتها بنفخ الهواء، وفي بيئات لغويّة معيّنة قد يكون من الواضح أنَّ الأشخاص الّذين ينتمون إلى هذه الخاصيّة في النّطق يتطلّعون إلى لغة معيّنة أو لغة متنوّعة، وفي بيئات لغويّة معيّنة. على سبيل المثال: في العديد من أنواع الإنجليزيّة/p/  تُلفظ [ph] في بدايّة الكلمات، مثل (pin) دبّوس، ولكن ليس عندما يسبقها /s/ كما هي الحال في كلمة يغزل  (spin).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Aspiration","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"إخراج النفس  Aspiration","nonDiacriticsLemma":"إخراج النفس","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إخراج النّفَس"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

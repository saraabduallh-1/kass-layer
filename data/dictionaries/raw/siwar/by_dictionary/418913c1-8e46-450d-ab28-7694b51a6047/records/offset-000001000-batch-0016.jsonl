{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/ed720f3c-7a39-42b3-ad90-a805f01fabae/get-public-entry"},"browse_index_record":{"lexicalEntryId":"ed720f3c-7a39-42b3-ad90-a805f01fabae","word":"التّحفُّظ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface916","lexicalEntryId":"ed720f3c-7a39-42b3-ad90-a805f01fabae","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التّحفُّظ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"في مناقشة إصلاح اللُّغة Language Maintenance وتغيّرها Language Change، فإنّ المتّحدّثين المحافظين هم أوّلئك الّذين يحافظون على سمات تنوُّع اللُّغة الحاليّة في مجتمع الكلام Speech Community خاصّتهم بدلًا من اعتماد سمات جديدة أو واردة (المبتكر المختلف Contrast Innovator). وقد حدّدت الدّراسات مجموعات معيّنة من المتكلّمين الرّجال، وكبار السّن، والمتّحدّثين في المناطق الرّيفيّة، والّذين يميلون إلى أن يكونوا أكثر تحفّظًا. ومع ذلك، فمن المرجّح أن تكون هناك جوانب من أنماط المتكلّمين عن الحياة وشبكات التّواصل الاجتماعيّة Social Networks الّتي تشكّل جزءًا منهم، بدلًا من مجرّد مجموعتهم الاجتماعيّة Social Group، الّتي تقودهم ليكونوا لغويّين محافظين أو مبتكرين.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Conservative","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"التحفظ  Conservative","nonDiacriticsLemma":"التحفظ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التّحفُّظ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

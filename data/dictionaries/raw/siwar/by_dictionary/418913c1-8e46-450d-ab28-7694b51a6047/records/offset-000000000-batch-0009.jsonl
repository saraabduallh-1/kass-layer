{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cd710c4a-b131-4869-ab47-b114965fbcc8/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cd710c4a-b131-4869-ab47-b114965fbcc8","word":"تعابير خاصّة بمجموعة اجتماعيّة معيّنة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface658","lexicalEntryId":"cd710c4a-b131-4869-ab47-b114965fbcc8","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"تعابير خاصّة بمجموعة اجتماعيّة معيّنة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعة من الكلمات والعبارات الخاصّة المرتبطة بمجموعة اجتماعيّة معيّنة، عادة ما تكون مجموعة ثقافيّة فرعيّة، بحاجة إلى المحافظة على السّريّة من الغرباء، وهذا يختلف عن المعنى اليوميّ البديل للّغة \"غير الصّادقة\". انظر: @(الثّقافة الفرعيّة) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Cant","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"تعابير خاصة بمجموعة اجتماعية معينة  Cant","nonDiacriticsLemma":"تعابير خاصة بمجموعة اجتماعية معينة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تعابير خاصّة بمجموعة اجتماعيّة معيّنة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1949fafe-d5d4-4092-bfd1-4d629c160510/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1949fafe-d5d4-4092-bfd1-4d629c160510","word":"التّعداد السّكانيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface659","lexicalEntryId":"1949fafe-d5d4-4092-bfd1-4d629c160510","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التّعداد السّكانيّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو مصطلح مُستخدَم في الإحصاءات للإشارة إلى التّعداد السّكانيّ لمجتمع ما، من خلال بعض الحالات أو البنود؛ كإحصائيّات العدد لظاهرة معيّنة في المجتمع. ومثال ذلك: يمكن للمرء أن يقرّر دراسة استعمال لغة للأطفال في المناطق الرّيفيّة في كينيا. وفي هذه الحالة، فإنَّ جميع الأطفال في جميع المدارس الابتدائيّة في كينيا يشكِّلون السّكان، وسيحتاج الباحث إلى اتّخاذ قرار بشأن حجم العيّنة Sample Size والتّصميم المناسبين للتّحقيق في لغة الأطفال. بدلًا من ذلك، يمكن للمرء أن يقرِّر دراسة الإعلانات التّلفزيونيّة في إسبانيا، ففي مثل هذه الحالة، فإنّ جميع الإعلانات الّتي تظهر على التّلفزيون الإسبانيّ بين 1990 و1999 ستكون لإظهار العيّنة الدّراسيّة المقصودة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Population","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"التعداد السكاني  Population","nonDiacriticsLemma":"التعداد السكاني","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التّعداد السّكانيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

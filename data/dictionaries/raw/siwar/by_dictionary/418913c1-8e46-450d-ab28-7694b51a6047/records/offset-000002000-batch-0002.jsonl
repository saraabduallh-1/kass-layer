{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/913646f5-717d-4d6d-80d0-5c089c56f5aa/get-public-entry"},"browse_index_record":{"lexicalEntryId":"913646f5-717d-4d6d-80d0-5c089c56f5aa","word":"قيود","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9af","lexicalEntryId":"913646f5-717d-4d6d-80d0-5c089c56f5aa","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"قيود","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يُستخدم هذا المصطلح بمعنى القيود أو (التّحديدات Limitations) على التّنوّع اللُّغويّ Language Variation، والتّغيّر اللُّغويّ Language Change. وتهدف دراسة القيود إلى تحديد المبادئ العامّة الّتي توجّه التّطوُّر التّاريخي للّغات، على سبيل المثال: طبيعة القناة الصّوتيّة الّتي تحدِّد أنواع الأصوات الّتي يمكن أن نصدرها، أو بنيتنا الإدراكيّة والحسّيّة الّتي قد تقوم بدعم عمليات تغيير لغة معيّنة، مثل المماثلة أو التّشابه الجزئي Analogy (وهي عمليّة المقارنة بين شيئين عادة على أسس بنيتيهما لغرض التّفسير والتّوضيح).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Constraints","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"قيود  Constraints","nonDiacriticsLemma":"قيود","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قيود"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

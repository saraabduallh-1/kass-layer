{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8e534559-ea61-45a3-85db-52fa568cd294/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8e534559-ea61-45a3-85db-52fa568cd294","word":"قواعديّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a1","lexicalEntryId":"8e534559-ea61-45a3-85db-52fa568cd294","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"قواعديّ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"تعبير كلمة مشتقّة من كلمة القواعد Grammar كصفة في مسميّات (أشباه الجمل)، مثل: اختلاف تباين قواعديّ، وكذلك يُستخدم للإشارة إلى كلٍّ من التّراكيب الممكنة في قواعد لغة ما، وفي هذا السّياق بوسع المرء أن يتحدّث عن التّراكيب بوصفها قواعديّة Grammaticality، أو ليست قواعديّة Ungrammatical في لغة ما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Grammatical (-ity)","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"AR","wordForms":[],"relatedSenses":[],"search":"قواعدي  Grammatical (-ity)","nonDiacriticsLemma":"قواعدي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قواعديّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5c57d682-664f-43d1-8c88-c99731f31869/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5c57d682-664f-43d1-8c88-c99731f31869","word":"الفعل","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a2","lexicalEntryId":"5c57d682-664f-43d1-8c88-c99731f31869","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الفعل","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يمكن أن يُستخدم كوحدّة وظيفيَّة للتَّحليل، مشيرًا إلى الفعل الّذي ينتج عن الكلام، على سبيل المثال: طلب معلومات، تحذير أو تهديد. انظر @(نظريّة الأفعال الخطابيّة) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Act","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"الفعل  Act","nonDiacriticsLemma":"الفعل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الفعل"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/427fceb9-c398-454b-b40e-f46b1aa96b57/get-public-entry"},"browse_index_record":{"lexicalEntryId":"427fceb9-c398-454b-b40e-f46b1aa96b57","word":"قواعد","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a3","lexicalEntryId":"427fceb9-c398-454b-b40e-f46b1aa96b57","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"قواعد","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يشير علم القواعد إلى كلٍّ من تركيب اللُّغة، والمحاولات لوصف ذلك التّركيب. ولربّما يشير هذا المصطلح إلى السّمات النّحويّة والقواعديّة للُغة البشر بشكل عامّ، وغالبًا ما تسمَّى (القواعد النّظريّة Theoritical Grammar)، أو (القواعد الوصفيّة Discriptive Grammar)، كما يشير هذا المصطلح بشكل كبير إلى مجالات عديدة في تركيب اللُّغة، بما في ذلك الصّوتيّات Phonology، وعلم الدّلالة / المعاني Semantics، وعلم النّحو Syntax وبالتّحديد علم الصّرف Morphology.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Grammar","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"قواعد  Grammar","nonDiacriticsLemma":"قواعد","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قواعد"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/73f36001-98d3-4d1e-9f19-3e98a4f7cae4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"73f36001-98d3-4d1e-9f19-3e98a4f7cae4","word":"اللُّغويّات","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a4","lexicalEntryId":"73f36001-98d3-4d1e-9f19-3e98a4f7cae4","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اللُّغويّات","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"هي دراسة اللُّغةLanguage، مع الانتباه إلى هيكلها، واكتسابها واستخدامها وتاريخها. قام علماء اللُّغة بدراسة اللُّغة كظاهرة عامّة، كهبة خاصّة في الجنس البشريّ. وقد وضع Noam Chomsky (1957, 1965) أهداف اللُّغويّات كمحاسبة لقدرة الطّفل على اكتساب اللُّغة Language Acquisition، أو اللُّغة في الاستخدام المشترك في البيئة. وبما أنّ الطّفل يستطيع، من النّاحية النّظريّة، التقاط أيّ لغة يتعرّض لها بشكل كافٍ (انظر @(مدخل) )، يرىChomsky  أنّ اللُّغات تشترك في قاعدة مشتركة (عالميّة). نموذجChomsky  البحثيّ هو المهيمن في علم اللُّغة، ويسعى إلى التّأكّد من الخصائص العامّة الموجودة في اللُّغة، وما هي الجوانب الّتي تخصُّ اللُّغات الفرديّة. ويتمّيز نهج Chomsky بأنّه يوصف بالتّعميم؛ لأنّه يهدف إلى صياغة نواة صغيرة من القواعد أو المبادئ الّتي تكمن وراء (أو \"تولّد\") الجمل الممكنة في اللُّغة. وهو أيضًا \"جزئيّ\"؛ لأنّه يحلّل اللُّغة على أنّها تتألّف من مكوّنات واضحة ولكنّها متشابكة: بناء الجملة، وعلم الدّلالات، وعلم الأصوات والمعجم (أو مكوّن المفردات). وتنطوي أهداف Chomsky  على نظرة تجريديّة ضروريّة للّغة. وهنالك فروعٌ أخرى في اللُّغويّات تعدُّ أقلّ اهتمامًا بالعموميّات التّجريديّة. فاللُّغويّات التّاريخيّة تهتمُّ عمومًا بتاريخ اللُّغات الفرديّة والأسر اللُّغويّة (انظر @(العائلة اللُّغويّة) )، وبتغيير اللُّغة على مستوى أقلّ تجريدًا. ولا تزال اللُّغويّات الوصفيّة مهتمّة ببنية اللُّغات الفرديّة، مرة أخرى على مستوى أقلّ تجريدًا. ويتمّ التّشديد على استخدام اللُّغة في مجالات، مثل البراغماتيّة. في حين أنّ أهداف البحث Chomsky  تتطلّب تبسيط افتراض مجتمع موحّد، حيث يَستخدم الجميع اللُّغة بالطّريقة نفسها، وتؤكّد اللُّغويّات الاجتماعيّة أوجه القصور في هذا النهج (انظر @(الكفاءة التّواصليّة) ). يأخذ William Labov  هذا الرأي القائل بأنّه لا يمكن لعلم اللغة أن يقتصر فقط على المجال الإجتماعي . وبشكل عامّ، فإنّ اللُّغويّات الاجتماعيّة كانت أقلّ اهتمامًا\r\nباللُّغة \"التّوحيديّة\"، وتركّز على العلاقة المتبادلة بين اللُّغة والحياة العامّة، بدلًا من التّركيز بشكل ضيّق على الهيكل اللُّغويّ. انظر أيضًا @(الأداء) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Linguistics","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"اللغويات  Linguistics","nonDiacriticsLemma":"اللغويات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اللُّغويّات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/57f4ec4e-e45e-45a8-a21d-b26e3359fded/get-public-entry"},"browse_index_record":{"lexicalEntryId":"57f4ec4e-e45e-45a8-a21d-b26e3359fded","word":"فيرث","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a5","lexicalEntryId":"57f4ec4e-e45e-45a8-a21d-b26e3359fded","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"فيرث","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"هو أوّل بريطانيّ يتولّى منصب رئيس اللُّغويّات  Linguisticsفي جامعة لندن للدّراسات الشّرقيّة والإفريقيّة The University of London’s School of Oriental and African Studies، واستمرّ فيه حتى عام 1960. كانت بداية عمله في الأساس في مجال علم النّظام الصّوتي Phonology. اشتهر Firth بأعماله في اللُّغويّات الاجتماعيّة في موضوع سياق الأحداث Context of Situation، وهو موضوع يرتكز جزئيًّا على أفكار عالِم الأنثروبولوجي Malinowski. كان Firth يرى سياق الظّرف بطريقة مجرّدة وأكثر عموميّة، وكان مهتمًّا بتحليل نمط معيّن لوصف طريقة استخدام خصائص محدّدة في اللُّغة، وبهذا أثّر على جيل لاحق من العلماء، من ضمنهم M. A. K. Halliday & Braj Kachru. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Firth, J. R. (1890-1960)","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NC","wordForms":[],"relatedSenses":[],"search":"فيرث  Firth, J. R. (1890-1960)","nonDiacriticsLemma":"فيرث","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"فيرث"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/60c14c08-60b1-4dd7-b954-25c171d6573b/get-public-entry"},"browse_index_record":{"lexicalEntryId":"60c14c08-60b1-4dd7-b954-25c171d6573b","word":"اللّكنة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a6","lexicalEntryId":"60c14c08-60b1-4dd7-b954-25c171d6573b","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اللّكنة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"مجموعة متنوّعة من الكلام تختلف عن الأصناف الأخرى من حيث النّطق (بما في ذلك النّغمة)، والّذي يُحدِّد المتكلّم من حيث الأصل الإقليمي، والمكانة الاجتماعيّة، وربَّما الإثنيّة أو الأصل العرقيّ Ethnicity، وبالتّالي فاللّكنة الشّماليّة Northern Accent \"لكنة واسعة\"، وكذلك \"اللّكنة الإسكتلنديّة Scottish Accent\"، وما إلى ذلك. وبهذا المعنى اللُّغويّ الاجتماعيّ، فإنّ جميع المتكلّمين لديهم لكنة، والمصطلح لا يقتصر على الأصناف ذات المستوى الاجتماعيّ المنخفض، بل يشمل أصنافًا راقية مثل (في اللُّغة الإنجليزيّة البريطانيّة) ذات الهيبة Recived Pronunciatin (RP)   هناك لفظ قياسي، ولمعرفة الجدل حيال ذلك انظر، على سبيل المثال،(Esling, 1998). فاللّكنة كمصطلح يُستخدم بمعنى أوسع ليس للإشارة فقط إلى سمات النّطق والقواعد، واختلافات علامة تنوُّع المفردات.\t","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Accent","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"يتمّ استخدام اللّكنة في عمل ‘Bakhtin’ بمعنى أوسع، للإشارة ليس فقط إلى أصوات اللُّغة، ولكن إلى الطّرق الّتي تحمل فيها جميع العبارات معها \"لكنات\"، أي معاني ووجهات نظر المتكلّمين السّابقين.\r\nفي هذا المعنى، انظر أيضًا @(التّخاطبيّة) و @(الحواريّة) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"اللكنة  Accent","nonDiacriticsLemma":"اللكنة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اللّكنة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d8f53a01-b5ec-4ffe-b5c4-3389dd521de9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d8f53a01-b5ec-4ffe-b5c4-3389dd521de9","word":"مبتكر","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a7","lexicalEntryId":"d8f53a01-b5ec-4ffe-b5c4-3389dd521de9","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"مبتكر","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"هم المتحدّثون الّذين يبتكرون أشكالًا لغويّة جديدة، حيث يضيفونها إلى المخزون Repertoire اللُّغويّ للمجتمع Speech Community. كما يُعتبرون أنّهم هم الّذين يتولّون السّبق في إدخال مصطلحات لغويّة جديدة إلى اللُّغة، وغالبًا ما يكونون أفرادًا مهمّشين في المجتمع، ولا يتعاملون مع بقية أفراده إلّا نادرًا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Innovator","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"AS","wordForms":[],"relatedSenses":[],"search":"مبتكر  Innovator","nonDiacriticsLemma":"مبتكر","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مبتكر"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/530e270c-60fd-4d9b-91d7-9f6112adb646/get-public-entry"},"browse_index_record":{"lexicalEntryId":"530e270c-60fd-4d9b-91d7-9f6112adb646","word":"كثافة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a8","lexicalEntryId":"530e270c-60fd-4d9b-91d7-9f6112adb646","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"كثافة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وتعود كلمة الكثافة إلى عدد العلاقات والرّوابط الاجتماعيّة في شبكات تواصل اجتماعيّة Social Networks محدّدة، فإذا كان الفرد يتواصل مع كافّة الأشخاص المشتركين في الشّبكة الاجتماعيّة بشكل إيجابيّ فحينئذ تُسمَّى تلك الشّبكة بشبكة ذات كثافة عالية High-Density Network، لكن إذا كان الأشخاص الّذي يعرفهم الفرد قليلي التّواصل فيما بينهم في تلك الشّبكة، ففي هذه الحالة تُسمَّى شبكة التّواصل الاجتماعيّ @(تعدّديّة التّشابك) و @(الرّوابط القويّة) و @(الرّوابط الضّعيفة) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Density","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"انظر @(الكثافة المعجميّة) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"كثافة  Density","nonDiacriticsLemma":"كثافة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"كثافة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d086781f-40e7-4e97-b606-b3b77696c42f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d086781f-40e7-4e97-b606-b3b77696c42f","word":"اللّهجة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9a9","lexicalEntryId":"d086781f-40e7-4e97-b606-b3b77696c42f","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اللّهجة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وهي كلمة إغريقيّة وتعني تكلّم، وتُستخدم من قِبل اللُّغويّين (Bailey, 1973) لتمييز وتصنيف التّنوّع اللُّغويّ، مثل اللّهجات Dialects (تنوّع اجتماعيّ أو إقليميّ)، ولهجات عِرقيّة Ethnolect (تنوّع عرقيّ أو ثقافيّ)، ولهجات الجنس البشريّ Genderlect (مرتبط إن كان المتكلّم رجلًا أو امرأة)، ولهجات اجتماعيّة Sociolect (تنوّع وتمييز اجتماعيّ)، ولهجات أيديولوجيّة Idiolect (نوع لغويّ يُستخدم من قِبل متحدّث فرديّ).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Lect ","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"هي واحدة من المعايير غير المقبولة في الخطاب الرّسميّ والكتابة. ويهدف هذا إلى تجنُّب المصطلحات الازدواجيّة دون المستوى المطلوب. وهو مصطلح استُخدم سابقًا في الدّوائر التّعليميّة منذ أن أثبتت اللُّغويّات الاجتماعيّة أنّ حكم الطّبيعة العاديّة والمنظّم للعديد من الإنشاءات غير الرّسميّة، مثل حذف الفعل الرّابط Copula Deletion؛ لأنّ معظم اللُّغويّات الاجتماعيّة تعتبر النّموذج القياسي للّغة أن تكون لهجات، أو على أن تكون قد وضعت واحدة أو أكثر من لهجات، حيث يتمّ التّمييز بين اللّهجات الرّسميّة Standard Dialect واللّهجات غير الرّسميّة Non-Standard Dialect في بعض الأحيان. فمسائل النّطق هي أقلُّ وضوحًا. يرى بعض اللُّغويّين أنّه يمكن التّحدُّث باللّهجة الرّسميّة من اللُّغة في أية لكنة مع إرتباط مستوى الرسمية للغة بالمكانة الإجتماعية للكنة المستخدمة . ويقول آخرون إنّه نادرًا ما تقترن لهجات محليّة واسعة باللّهجة الرّسميّة الّتي هي جزء من التّوحيد، ويمكن للفرد أن يشير إلى أنّها لهجات غير رسميّة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Non-Standard (Language, Variety)","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"اللهجة  Lect  Non-Standard (Language, Variety)","nonDiacriticsLemma":"اللهجة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اللّهجة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eaf50a06-3e33-4792-8c92-e2a412fe3ef3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eaf50a06-3e33-4792-8c92-e2a412fe3ef3","word":"قاعدة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9aa","lexicalEntryId":"eaf50a06-3e33-4792-8c92-e2a412fe3ef3","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"قاعدة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"هو تحديد رسميّ لعمل اللُّغة أو العمليّات اللُّغويّة، مثلًا: في اللُّغة الإنجليزيّة المعتادة، فإنّ أفعال المضارع لا تحتوي على نهايات انعطاف، باستثناء الشّخص الثّالث المفرد، حيث إنّها تحتوي على نهاية الانعطاف(I, you, we and they speak, he / she speaks)، وهذا ما يُسمَّى بالقاعدة. إنّ هذه القواعد في اللُّغويّات تُستخدم لوصف وبيان الاستعمال الفعليّ وليس الوصفيّ. (انظر @(مذهب الوصف) ) والظّريف هنا في اللُّغويّات الاجتماعيّة، هو أنّ بعض القواعد ممكن تطبيقها بأشكال مختلفة (في بيئات لغويّة مختلفة، ومن خلال متحدّثين مختلفين، وفي نصوص اجتماعيّة مختلفة). انظر @(قاعدة المتغيّر) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Rule","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"قاعدة  Rule","nonDiacriticsLemma":"قاعدة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"قاعدة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

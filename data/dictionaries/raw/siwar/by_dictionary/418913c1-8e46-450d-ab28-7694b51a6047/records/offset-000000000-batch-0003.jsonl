{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/61967a53-d1f3-4b83-894b-1f8f52755f85/get-public-entry"},"browse_index_record":{"lexicalEntryId":"61967a53-d1f3-4b83-894b-1f8f52755f85","word":"إعادة الكرولة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface5cb","lexicalEntryId":"61967a53-d1f3-4b83-894b-1f8f52755f85","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"إعادة الكرولة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو عمليّة يتمّ من خلالها استخدام أصناف من سلسلة كريولCreoele Continuum  لتصبح أكثر منها أقل Creole-Like. قد يؤدّي التّغيّر في الظّروف الاجتماعيّة للمتحدّثين إلى التّأكيد على هويّة كريول القائمة Creole-Based  بدلًا من واحد الّذي يدلّ على الانفتاح، لغة الطّبقة العليا المسيطرة Superstrate. وما يقال إنّ المتحدّثين الأصغر سنًّا للغة كريول الكاريبيّةCaribben Creole  في بريطانيا يظهرون درجة من إعادة الكرولة Recreolisation ردًّا على الضّغط الاجتماعيّ. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Recreolisation","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"إعادة الكرولة  Recreolisation","nonDiacriticsLemma":"إعادة الكرولة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"إعادة الكرولة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b2ac5fe7-f469-482e-a0c5-2805a97cc80f/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b2ac5fe7-f469-482e-a0c5-2805a97cc80f","word":"اكتساب اللُّغة الثّانية","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface5cd","lexicalEntryId":"b2ac5fe7-f469-482e-a0c5-2805a97cc80f","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اكتساب اللُّغة الثّانية","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اللُّغة الثّانية (تُختَصر L2 في كثير من الأحيان) هي لغة الفرد أو المجتمع الّتي لم تُكتَسب بعد الولادة، ولكن لاحقًا بعد اكتساب اللُّغة الأولى أو الأصليّة. وغالبًا ما يُشير هذا المصطلح إلى السّياقات الّتي تكون فيها اللُّغة الثّانية متاحة كوسيلة للتّواصل، (كتعلُّم اللُّغة الإنجليزيّة في المملكة المتّحدة للمتحدّثين باللُّغة البنجابيّة Panjabi، أو تعلُّم لغة الزّولو Zulu في دولة جنوب إفريقيا للمتحدّثين بغيرها من اللُّغات)، وتُعتبر مقابلًا ومضادًّا للّغة الأجنبيّة Foreign Language. ويشير اكتساب اللُّغة الثّانية Second Language Acquisition إلى تعلُّم لغة تحت ظروف مشابهة. حيث يؤثِّر عُمر متعلّم اللُّغة الثّانية جزئيًّا على مدى تمكّنه من اكتسابها والتّحدث بها كأهلها (انظر العُمر الحَرِج Critical Age). قد يُستخدم مصطلح اكتساب اللُّغة الثّانية Second Language Acquisition كمصطلح يشمل تعلُّم أيّ لغة بعد اكتساب اللُّغة الأولى، حيث إنّه تمّت مناقشة مبادئ تعلّم لغة ثانية أو ثالثة أو أكثر، وكونها تُعتبر متشابهة. في حين أنّ الّذين يرغبون في التّأكيد على التّمييز بين الأنماط المختلفة لاكتساب اللُّغة Language Acquisition يميلون لاستخدام مصطلحات مغايرة. انظر اكتساب اللُّغة الثّالثة @(اكتساب اللُّغة الثّالثة) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Second Language Acquisition (SLA)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"اكتساب اللغة الثانية  Second Language Acquisition (SLA)","nonDiacriticsLemma":"اكتساب اللغة الثانية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اكتساب اللُّغة الثّانية"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

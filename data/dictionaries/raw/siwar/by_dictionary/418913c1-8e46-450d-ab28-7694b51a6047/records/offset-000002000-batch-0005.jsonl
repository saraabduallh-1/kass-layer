{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/92d05f66-828c-453e-b960-b0b8b46d56d3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"92d05f66-828c-453e-b960-b0b8b46d56d3","word":"نموذجيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9e8","lexicalEntryId":"92d05f66-828c-453e-b960-b0b8b46d56d3","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"نموذجيّ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"علاقة بين عناصر لغويّة من الممكن أن تُستبدل من بعضها البعض في تسلسل معيّن معطى في الجملة. مثال: \"البقرة تمشي على الجسر\" فكلمة البقرة ممكن أن تُستبدل بكلب، قطّة، فتاة،... إلخ. وهكذا يقال إنّ هناك علاقة نموذجيّة لكلّ من هذه العناصر. وبالمثل، في اللُّغة الإنجليزيّة، الصّوت /P/ و/t/ لهما علاقة نقل نموذجيّة؛ لأنّه من الممكن استبدالهما، مثل: p_i_n  & t_i_n.  انظر @(سياقيّ) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Paradigmatic","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"AR","wordForms":[],"relatedSenses":[],"search":"نموذجي  Paradigmatic","nonDiacriticsLemma":"نموذجي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نموذجيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/00181e81-b551-44c9-84e9-6698e8161c63/get-public-entry"},"browse_index_record":{"lexicalEntryId":"00181e81-b551-44c9-84e9-6698e8161c63","word":"نصّيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9e9","lexicalEntryId":"00181e81-b551-44c9-84e9-6698e8161c63","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"نصّيّ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"وهي صفة النّصّ. في مصطلحات اللُّغويّات الوظيفيّة النّظاميّة Systemic Functional Linguistics. يشير هذا المصطلح بشكل أكثر تحديدًا إلى واحد من ثلاثة محاور رئيسة للّغة: طريقة تنظيم اللُّغة في نصوص مفيدة. انظر @(التّرابط (على مستوى الجملة)) و @(بلاغيّ) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Textual","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"AR","wordForms":[],"relatedSenses":[],"search":"نصي  Textual","nonDiacriticsLemma":"نصي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نصّيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/41037789-51fd-4c1d-b72b-efe5d8f051e3/get-public-entry"},"browse_index_record":{"lexicalEntryId":"41037789-51fd-4c1d-b72b-efe5d8f051e3","word":"ألمانيّة العمّال الضّيوف","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9ea","lexicalEntryId":"41037789-51fd-4c1d-b72b-efe5d8f051e3","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"ألمانيّة العمّال الضّيوف","lemmaType":"wasf","pattern":" ","senses":[{"definition":"لهجة من الألمانيّة يتحدّثها المهاجرون من الجيل الأوّل من تركيّا، وإيطاليا، واليونان، ويوغوسلافيا. وقد وَصف بعضهم هذه اللّهجة بأنّها لهجة هجين Pidgin (Clyne, 1968)؛ بينما يرى آخرون (Klein and Dittmar, 1979) أنّه ينبغي أن يُنظر إليها على أنّها لغة بينيّة Interlanguage؛ لأنّه تبيَّن أنّ كفاءة المتعلّمين بها تعتمد على عوامل، مثل: مدّة الإقامة، ودرجة التّفاعل مع الجاليّة الألمانيّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Gastarbeiterdeutsch","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"ألمانية العمال الضيوف  Gastarbeiterdeutsch","nonDiacriticsLemma":"ألمانية العمال الضيوف","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ألمانيّة العمّال الضّيوف"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d22a31db-c245-48b5-8e3e-5b3cb0c24a4d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d22a31db-c245-48b5-8e3e-5b3cb0c24a4d","word":"التهجين","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9eb","lexicalEntryId":"d22a31db-c245-48b5-8e3e-5b3cb0c24a4d","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التهجين","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"التّهجين مفهوم بيولوجيّ، يُستخدم في الغالب لتمييز اللُّغة الهجينة Pidginisation من أشكال أخرى لتطوُّر اللُّغة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Hybridity/Hybridisation","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"وفي تحليل الخطاب، فإنَّ التّهجين Hybrid, Hybridisation يُستخدم للإشارة إلى مزج أو دمج ما يمكن تسميته أسلوبًا Genre أو صوتًا Voice أو خطابًا Discourse مميّزًا، ويُعتبر التّهجين محلَّ اهتمام في اللُّغويّات الاجتماعيّة، بما يُسمَّى عبور الحدود Border Crossing، عبور اللُّغة  Language Crossing، التّناصيّة Intertextuality.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[]},{"definition":" يُعتبر التّهجين Hybrid مرادفًا لرموز مختلطة “Mixed Code”، هجين لغويّ، هجين إقليميّ / جغرافيّ، عمليّة تهجين أوّليّ/ أساسيّ، عمليّة تهجين ثانويّ.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"التهجين  Hybridity/Hybridisation","nonDiacriticsLemma":"التهجين","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التهجين"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5dd5aa15-613c-47b8-970d-6c196f39cbfb/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5dd5aa15-613c-47b8-970d-6c196f39cbfb","word":"نقديّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9ec","lexicalEntryId":"5dd5aa15-613c-47b8-970d-6c196f39cbfb","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"نقديّ","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"يشير هذا المصطلح إلى أحد التّوجّهات في الدّراسات اللُّغويّة، والّذي يركِّز على قضايا السّلطة Power والأيديولوجيا Ideology بأهداف تحرريّة. ومن الأمثلة على هذا التّوجُّه النّقديّ في علم اللُّغويّات الاجتماعيّة: دراسة السّلطة على المستوى التّفاعليّ، من حيث سيطرة طرف على طرف آخر في المحادثات، وكيفيّة تحقيق هذه السّيطرة Dominance التّفاعليّة. عادة ما تستند المقاربات النّقديّة على النّظريات الماركسيّة أو الماركسيّة المعاصرة Marxism، كما قد تشتمل على سمات من المقاربات النّسويّة Feminism، وما بعد البنيويّة Post-Structuralism.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Critical","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"AR","wordForms":[],"relatedSenses":[],"search":"نقدي  Critical","nonDiacriticsLemma":"نقدي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نقديّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/19605b7f-a5ba-4359-898e-c4c7e6e68c4d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"19605b7f-a5ba-4359-898e-c4c7e6e68c4d","word":"ثنائيّ اللُّغة المتوازنة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9ed","lexicalEntryId":"19605b7f-a5ba-4359-898e-c4c7e6e68c4d","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"ثنائيّ اللُّغة المتوازنة","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مفردة مرادفة لـ @(ثنائيّ اللُّغة المتوازنة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Ambilingual","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"وهو الشّخص الّذي يتحدّث لغتين بطلاقة كاملة. ومن النّاحية النّظريّة، يعمل مثل هذا المتكلّم جيّدًا في جميع مجالات النّشاط، وبدون أيّ تأثيرات من لغة على الأخرى. يفرِّق المصطلح ما بين أولئك المتحدّثين بلغتين وأولئك الّذين يُعتبرون من ثنائيي اللُّغة، ويتّضح أنّ لديهم هيمنة في لغتهم الأولى. كما أنّ مترادفات ثنائيّ اللُّغة موجودة أيضًا، انظر @(السّلسلة اللُّغويّة المتّصلة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Balanced Bilingual","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"ثنائي اللغة المتوازنة  Ambilingual Balanced Bilingual","nonDiacriticsLemma":"ثنائي اللغة المتوازنة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ثنائيّ اللُّغة المتوازنة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

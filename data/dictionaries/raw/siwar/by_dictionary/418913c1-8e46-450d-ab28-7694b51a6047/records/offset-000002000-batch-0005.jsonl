{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dfb1e9d3-b746-47f8-bf5e-24007e9a2984/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dfb1e9d3-b746-47f8-bf5e-24007e9a2984","word":"هُوِيَّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9fd","lexicalEntryId":"dfb1e9d3-b746-47f8-bf5e-24007e9a2984","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"هُوِيَّة","lemmaType":"singleWord","pattern":" ","senses":[{"definition":"هي مصطلح يشير إلى شعور الفرد أو المجموعة كما يرون أنفسهم ويراهم الآخرون، ويمكن التّعبير عن الهويّة بعدّة طرق؛ كالجنسيّة، والمنطقة الجغرافيّة والعرقيّة Ethnicity، والنّوع الاجتماعيّىّ Gender، والطّبقة الاجتماعيّة Social Class، والمهنة.\r\n","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Identity","language":"en","languageLabel":"الإنجليزية"}]}],"pos":"NA","wordForms":[],"relatedSenses":[],"search":"هوية  Identity","nonDiacriticsLemma":"هوية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"هُوِيَّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9e8b3510-c011-49a0-8038-e24e37d62895/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9e8b3510-c011-49a0-8038-e24e37d62895","word":"ثنائيّ اللُّغة غير المتفاعل","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9fe","lexicalEntryId":"9e8b3510-c011-49a0-8038-e24e37d62895","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"ثنائيّ اللُّغة غير المتفاعل","lemmaType":"wasf","pattern":" ","senses":[{"definition":"مصطلح يُستخدم لفرد ما لديه فهم كامل للّغة، ولكنّه غير قادر على التحدُّث بها بطلاقة. وهذا عادة ما يحدث في حال تحوُّل اللُّغة Language Shift، عندما يحتفظ المتكلّم الأصغر سنًّا بكفاءة تقريبيّة للّغة التّقليديّة، لكنّ استخدام اللُّغة الجديدة يتحوّل إلى اللُّغة التّقليديّة عندما يستجيبون لكبار السّن، أو يتحدثون فيما بينهم. وكمثل هذه الكفاءة، الاستقباليّة لا تمتدّ فقط إلى المحادثات المتبقّية في اللُّغة التّقليديّة للمجتمع، ولكنّ أيضًا بالضّحك على النّكات، وكلمات اللّعب، وفهم الهمسات، وحتى التّرجمة من اللُّغة التّقليديّة إلى اللُّغة الجديدة، والعكس صحيح. انظر: @(شبه المتحدِّث) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Passive Bilingual","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"ثنائي اللغة غير المتفاعل  Passive Bilingual","nonDiacriticsLemma":"ثنائي اللغة غير المتفاعل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ثنائيّ اللُّغة غير المتفاعل"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/401a7a47-bace-4c21-ac35-f9e3b5026882/get-public-entry"},"browse_index_record":{"lexicalEntryId":"401a7a47-bace-4c21-ac35-f9e3b5026882","word":"العالِم برونسلو مالينوسكي","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface9ff","lexicalEntryId":"401a7a47-bace-4c21-ac35-f9e3b5026882","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"العالِم برونسلو مالينوسكي","lemmaType":"wasf","pattern":" ","senses":[{"definition":"عالم أنثروبولوجيا كان له أثر بالغ على اللُّغويّين البريطانيّين مع مفهومه لسياق الظّرف Context of Situation، على أساس عمله الميدانيّ في جزر Trobriand. حيث إنّ له ثلاث إثنوغرافيّات عظمى عن الجزر: أرغونوتس Argonauts، والحياة الجنسيّة Sexual Life، وحدائق المرجان Coral Gardens. أنشأ تقليد العمل الميدانيّ المكثّف في الأنثروبولوجيا، وبعد ذلك في علم اللُّغة الاجتماعيّة. أصرَّ على فهم المسائل \"من وجهة نظر السّكان الأصليّين، ولا سيّما قيمة التّعلّم واستخدام اللُّغات الأصليّة\"، وشدّد \"سياق الحالة\" على أنّ معنى الكلمات يكمن في استخدامها. وفي هذا الصّدد هناك مصطلح آخر للعالِم Malinowski الّذي تمّ تبنّيه في اللُّغويّات والتّواصل الفكريّ Phatic Communion، وهذا أمر هامّ، وهذا النّوع من اللُّغة الّذي يشمل القيل والقال والمجاملات، يجعل من الواضح أن اللُّغة لا تتّصل بالأفكار فقط، بل هي طريقة عمل تُستخدم لإقامة روابط شخصيّة بين النّاس، مفهوم Malinowski للسّياق أكد أن بعض المعاني لا يمكن فهمها إلا ضمن إطار ثقافي Context of Culture معيّن، وقد أثّر Malinowski على الأجيال اللّاحقة من اللُّغويّين من خلال تأثيره على J. R. Firth، وهو أوّل رئيس بريطانيّ للّغويّات. ولد Malinowski في مدينة Cracow، بولندا، وحصل على درجة الدّكتوراه. في الفيزياء والرّياضيات، وعُيِّن في جامعات لندن، وفي وقت لاحق، في جامعة Yale.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Malinowski, Bronislaw (1884-1942)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"العالم برونسلو مالينوسكي  Malinowski, Bronislaw (1884-1942)","nonDiacriticsLemma":"العالم برونسلو مالينوسكي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"العالِم برونسلو مالينوسكي"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/810c1189-b9d6-40c5-b4c1-5123f11f092d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"810c1189-b9d6-40c5-b4c1-5123f11f092d","word":"شبه التّواصل","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dfacea00","lexicalEntryId":"810c1189-b9d6-40c5-b4c1-5123f11f092d","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"شبه التّواصل","lemmaType":"wasf","pattern":" ","senses":[{"definition":"قدَّم Einar Haugen (1966a) هذا المصطلح ليصف التّواصل عبر للحدود فيما بين دول الإسكندنافيّة. إنّ نصف التّواصل الإسكندنافيّ يوضح ما أسماه Haugen  بالمرونة Elasticity في الفهم المتَبادَل Mutual Intelligibility. إنّ لغات الدول الإسكندنافيّة الوطنيّة National Scandinavian Standard Languages المعياريّة تُظهر التّشابهات اللُّغويّة فيما بينها (مثل: اللُّغة الدّنماركيّة Danish واللُّغة النّرويجيّة Norwegian تشتركان في كثير من جذور الكلمات، وكذلك اللُّغتان النّرويجيّة والسّويديّة Swedish تتشابهان في النّطق)؛ كما تُظهر الاختلافات أيضًا (مثال: يختلف النّطق في اللُّغة الدّنماركيّة بشكل كبير عن اللُّغتين السّويديّة والنّرويجيّة). لقد استغلّ التّواصل الإسكندنافيّ العابر للحدود وجود التّشابهات اللُّغويّة لكي يُمَكّن ويُسَهّل التّواصل فيما بين المتحدّثين من خلفيّات لغويّة مختلفة. وبشكل عامّ، لقد استمرّ المتحدّثون في استخدام لغتهم الأصليّة بدلًا من اللُّغة المشتركة Lingua Franca (كاستخدام اللُّغة الإنجليزيّة مثلًا)، ولكن مع القليل من التّعديل؛ وذلك لتسهيل استيعابها، جزئيًّا على الأقلّ، على المستمع (أيّ أنّهم يتحدّثون ببطء مثلًا، تجنُّب التّراكيب القواعديّة الّتي لا تكون معروفة في اللُّغات الأخرى، اختيار المفردات الّتي تكون شائعة في كلّ لغات الدول الإسكندنافيّة).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Semi-Communication","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"شبه التواصل  Semi-Communication","nonDiacriticsLemma":"شبه التواصل","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"شبه التّواصل"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/86bcfdf5-1734-46dc-91cb-bcde1a949641/get-public-entry"},"browse_index_record":{"lexicalEntryId":"86bcfdf5-1734-46dc-91cb-bcde1a949641","word":"التّنشئة الاجتماعيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface68e","lexicalEntryId":"86bcfdf5-1734-46dc-91cb-bcde1a949641","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التّنشئة الاجتماعيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"العمليّة الّتي يتعلّم النّاس من خلالها ثقافة مجتمعهم، ويتمّ هذا التّعلّم من خلال الأسرة والأقران خلال مرحلة الطّفولة، وعن طريق المدرسة ومكان العمل في وقت لاحق، وتُعتبر اللُّغة جزءًا أساسيًّا من هذه العمليّة كوسيلة لنقل الثّقافة Culture، فضلًا عن كونها جزءًا من تلك الثّقافة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Socialisation","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"التنشئة الاجتماعية  Socialisation","nonDiacriticsLemma":"التنشئة الاجتماعية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التّنشئة الاجتماعيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d4f9b644-bf8d-4928-8def-acdfe34617fc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d4f9b644-bf8d-4928-8def-acdfe34617fc","word":"الممارسات الخطابيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface86a","lexicalEntryId":"d4f9b644-bf8d-4928-8def-acdfe34617fc","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الممارسات الخطابيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يُشير هذا المصطلح إلى أشكال وأنواع متنوّعة من النّشاطات التّواصليّة والتّفاعليّة الّتي تجري في سياقات معيّنة، وترتبط بمجالات محدّدة، كما هي الحال في الممارسات الخطابيّة المتعلّقة بالتّعليم في المدارس والتّجارة والطّب. ومن الأمثلة على الممارسات الخطابيّة في التّعليم المدرسيّ في المملكة المتّحدة، عندما يتبادل الطّلاب في الصّفوف الأساسيّة الأدوار لقراءة إحدى مسرحيّات Shakespeare أثناء الجلوس على المقاعد في الغرفة الصّفيّة، ومن الأمثلة الأخرى في مجال الطّب ما يقوم به المريض في الإجابة عن أسئلة الطّبيب عند المرض. انظر أيضًا: @(التّحليل النّقدي للخطاب) ، و @(تحليل الخطاب) ، و @(الممارسات الخطابيّة السُّلطويّة) ، و @(الممارسة الاجتماعيّة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Discourse Practice(s)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الممارسات الخطابية  Discourse Practice(s)","nonDiacriticsLemma":"الممارسات الخطابية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الممارسات الخطابيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

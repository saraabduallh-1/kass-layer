{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9c4dfb2e-5059-400b-8ea0-b987f31a51dc/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9c4dfb2e-5059-400b-8ea0-b987f31a51dc","word":"(مفاهيم)  القرابة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface86c","lexicalEntryId":"9c4dfb2e-5059-400b-8ea0-b987f31a51dc","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"(مفاهيم)  القرابة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"إنَّ لمصطلحاتِ القرابةِ جذورًا ضاربةً في تاريخِ الدّراسات في علم اللُّغة، وعلم الأنثروبولوجيا (علم الإنسان). ولقد حدَّد العلماءُ أوجه الشبهِ والاختلاف بين مصطلحاتِ القرابةِ المستخدمة من قِبل مجموعاتٍ لغويّة أو ثقافيّة مختلفة. فعلى سبيل المثال: فإنَّ معظم الثّقافات تُميّز بين الأجيال والأجناس؛ ومنها ما يضع الفروق في العمر ضمن الجيل؛ وبعضها يُميّز بين المصطلحات الخاصّة بالأخوّة وتلك الخاصّة بأبناء العمّ أو الخال؛ والبعض الآخر من الثّقافات أو المجموعات اللُّغويّة يستخدم نفس المصطلحات، مثلًا: الأخت للإشارة إلى (الإناث)، بنات العمّ أو الخال، ومصطلح الأخ للإشارة إلى (الذّكور) أبناء العمّ أو الخال.    ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Kinship (Terms)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"(مفاهيم)  القرابة  Kinship (Terms)","nonDiacriticsLemma":"مفاهيم  القرابة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"(مفاهيم)  القرابة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

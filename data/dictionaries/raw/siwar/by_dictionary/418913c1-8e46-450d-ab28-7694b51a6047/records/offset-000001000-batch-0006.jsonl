{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bb4d6efc-5118-4ab4-84cd-5c873fac601a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bb4d6efc-5118-4ab4-84cd-5c873fac601a","word":"اللّهجة الرسميّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface80c","lexicalEntryId":"bb4d6efc-5118-4ab4-84cd-5c873fac601a","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اللّهجة الرسميّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تمّ استخدام مصطلح Basilect لأوّل مرة من قِبل(William Stewart, 1965)  على شكل لغة كريول الّتي تُظهر فرقًا كبيرًا عن اللُّغة الأصليّة المستمدّة منها، أو الّتي تمّ استخلاص الجزء الرئيس من مفرداتها.  انظر ( @(لغة المعجم) ). إنّ لغة الكريول Basilect- على سبيل المثال- هي  من أشكال الكريول الإنجليزي الجامايكي، حيث يُظهر هيكلًا مختلفًا تمامًا منLexifier  (الإنجليزيّة (، والمتحدِّثون بهاتين اللّهجتين لا يستطيعون فهم بعضهم البعض.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Basilect, Mesolect, Acrolect","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"اللهجة الرسمية  Basilect, Mesolect, Acrolect","nonDiacriticsLemma":"اللهجة الرسمية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اللّهجة الرسميّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

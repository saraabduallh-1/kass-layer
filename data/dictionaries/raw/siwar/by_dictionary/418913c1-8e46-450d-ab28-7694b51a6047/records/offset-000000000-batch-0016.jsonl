{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b048dd40-d148-459d-be2e-b05814371dbf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b048dd40-d148-459d-be2e-b05814371dbf","word":"الشّكل اللُّغويّ المعرفيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface70f","lexicalEntryId":"b048dd40-d148-459d-be2e-b05814371dbf","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الشّكل اللُّغويّ المعرفيّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"نوع من الأشكال اللُّغويّة Modality الّذي يحدِّد مدى ثقة المتحدِّث بالمعلومة الّتي يقدِّمها، مثل الأسئلة الّذيليّة، كما هو في دراسة اللُّغة والنّوع الاجتماعيّ Gender، والتّلطُّف اللُّغويّ Politeness  (حصلتُ على علامة 36، أليس كذلك؟). فالتّعبير (أليس كذلك؟) هو شكل لغويّ يبيّن ثقة المتحدِّث في المعلومة الّتي قدَّمها (Janet Holmes, 1995).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Epistemic (Modality)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الشكل اللغوي المعرفي  Epistemic (Modality)","nonDiacriticsLemma":"الشكل اللغوي المعرفي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الشّكل اللُّغويّ المعرفيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/848f5a89-7366-4907-9336-5cec7485286e/get-public-entry"},"browse_index_record":{"lexicalEntryId":"848f5a89-7366-4907-9336-5cec7485286e","word":"صائت عالٍ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface710","lexicalEntryId":"848f5a89-7366-4907-9336-5cec7485286e","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"صائت عالٍ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"جزء من ثلاثة تصنيفات للصّوائت Vowelsبالاعتماد على علوّ وارتفاع اللّسان أثناء اللّفظ. فالصّوائت العالية يمكن مقارنتها بالصّوائت الوسطى Mid والمنخفضة Low. انظر @(حروف العلّة القريبة / العالية) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"High (Vowel)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"صائت عال  High (Vowel)","nonDiacriticsLemma":"صائت عال","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"صائت عالٍ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3a073d40-6cec-4bb3-90b4-84f7475f480d/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3a073d40-6cec-4bb3-90b4-84f7475f480d","word":"الشّكل مقارنة بالوظيفة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface711","lexicalEntryId":"3a073d40-6cec-4bb3-90b4-84f7475f480d","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الشّكل مقارنة بالوظيفة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تتّخذ العديد من دراسات اللُّغويّات الاجتماعيّة الأشكال اللُّغويّة كنقطة بداية لها، فمثلًا: بالنّظر إلى استخدام المتكلّمين للّفظ أو الخصائص النّحويّة. ومع ذلك، ومن أجل تفسير الألفاظ ضمن الأشكال اللُّغويّة، فإنّ المحلّل يحتاج لاستنتاج معانيها أو وظائفها. عمومًا، فمن المسلَّم به عدم وضوح هذا الأمر؛ أي أنّ الوظائف لا يمكن أن تُعرف ببساطة من خلال الأشكال. ففي بعض الأحيان يكون هناك خلاف بين المحلّلين في التّفسير. على سبيل المثال: هناك العديد من الباحثين المهتمّين باللُّغة والنّوع الاجتماعيّ Language and Gender ممّن اعترضوا على ادّعاء قُدِّم في الدّراسات المبكّرة حول الاختلاف اللُّغويّ، وأنّ النّساء يمِلنَ إلى استخدام الصّيغ والخصائص اللُّغويّة المطابقة للّغة المعياريّة كمؤشّر على انعدام أمنهم اللُّغويّ. وتعطي تفسيرات بديلة أنماطًا متنوّعة في استخدام خصائص المحادثة، مثل: الأسئلة المؤكّدة Tag Questions، أو مداخلات الكلام Interruptions الواضحة. لقد نزعت الدّراسات في اللُّغويّات الاجتماعيّة التّفاعليّة Interactional Sociolinguistics أكثر إلى التّركيز المباشر على الوظائف والمعاني كإستراتيجيّات تواصل المتحدّثين بدلًا من استخدام التّوزيع المحدّد بينهم. وتعترف الدّراسات الأخيرة- بشكل خاصّ- حول هذه الإستراتيجيّات بإمكانيّة الغموض، وتعدّد المعاني.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Form (Vs Function)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الشكل مقارنة بالوظيفة  Form (Vs Function)","nonDiacriticsLemma":"الشكل مقارنة بالوظيفة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الشّكل مقارنة بالوظيفة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8933f02c-c14d-4fb7-b8da-2092fb6a5fe9/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8933f02c-c14d-4fb7-b8da-2092fb6a5fe9","word":"صحّة اللّفظ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface712","lexicalEntryId":"8933f02c-c14d-4fb7-b8da-2092fb6a5fe9","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"صحّة اللّفظ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وهو مصطلح تمّت صياغته لأوّل مرّة من قِبل Deborah Cameron (1995) لوصف المحاولات اللُّغويّة الّتي يقوم بها المتحدّثون لتحسين أدائهم اللُّغويّ. وتشمل هذه الممارسات اللُّغويّة إطلاق أحكام متعلّقة باللُّغة الجيّدة واللُّغة الرّديئة. وغالبًا ما تشمل هذه الممارسات محاولات لتحسين اللُّغة في مجال القواعد والتّقنين Standardization، والكتابة والابتعاد عن استخدام اللُّغة الجنسانيّة Sexism Language.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Verbal Hygiene","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"صحة اللفظ  Verbal Hygiene","nonDiacriticsLemma":"صحة اللفظ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"صحّة اللّفظ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/3186272a-b1fe-4efb-a6c8-b42d05d9d822/get-public-entry"},"browse_index_record":{"lexicalEntryId":"3186272a-b1fe-4efb-a6c8-b42d05d9d822","word":"الصحّة اللُّغويّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface713","lexicalEntryId":"3186272a-b1fe-4efb-a6c8-b42d05d9d822","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الصحّة اللُّغويّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"فكرة معناها أنّ بعض العناصر اللُّغويّة (الكلمات، الهياكل النّحويّة والنّطق) تكون صحيحة أو غير صحيحة. ففي كثير من الأحيان، هنالك أشكال غير قياسيّة Non-Standard من اللُّغة. على سبيل المثال:(She go)  في اللُّغة الإنجليزيّة هي غير قياسيّة وغير صحيحة، والصّحيح القياسيّ Standard هو  (she goes)، ويرتبط هذا الأمر بالأفكار الموصوفة Prescriptive حول اللُّغة. تُنتقد مثل هذه الأفكار عادة من قِبل اللُّغويّين الاجتماعيّين الّذين يفضّلون فكرة الملاءمة Appropriateness (مثال، تكون أشكال اللُّغة ملائمة، أو غير ملائمة في سياقات معيّنة). والصّحة/ السّلامة Correctness كانت ولا تزال أيضًا موضوع الدّراسة في اللُّغويّات الاجتماعيّة، فعلى سبيل المثال: وثّق كلٌّ من James Milroy and Lesely Milroy (1999) عادة الشّكوى Complaint في الإنجليزيّة مركّزين على فكرة الصّحة، وليس على بدايّة هذا التّقليد في بريطانيا في أوائل القرن الثّامن عشر، وكان ذلك متّسقًا مع تطوير قدر كبير من بيانات اللُّغة، والعمل على تدوين مدوّنة اللُّغة الإنجليزيّة في مجالي النّحو Grammars والقواميس Dictionaries. فمصطلح مذهب الصّحة Doctrine of Correctness بعد  Leonard (1929, 1962) يُستخدم في بعض الأحيان لتوصيف التّطوّر في القرن الثّامن عشر. انظر أيضًا @(الأيديولوجيّة اللُّغويّة) و @(أيديولوجيّة اللُّغة القياسيّة) و @(صحّة اللّفظ) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Correctness","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الصحة اللغوية  Correctness","nonDiacriticsLemma":"الصحة اللغوية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الصحّة اللُّغويّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1379bfc1-2ad7-4530-8094-0e93179f1569/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1379bfc1-2ad7-4530-8094-0e93179f1569","word":"شكل الاقتباس","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface714","lexicalEntryId":"1379bfc1-2ad7-4530-8094-0e93179f1569","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"شكل الاقتباس","lemmaType":"MWE","pattern":" ","senses":[{"definition":"في علم اللُّغويّات الاجتماعيّة، هو نطق كلمة أو عبارة في عزلة، وليس في \"خطاب متصل Connected Speech\". عادة ما تنتج أشكال الاقتباس نطقًا أكثر حذرًا أو أكثر رسميّة من الكلام المتّصل، والّتي خلالها تحدث العمليّات الصّوتيّة، مثل \"التّجميع Assimilation\".","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Citation Form","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"في المعجم، الشّكل هو الّذي يُستخدم عند إدخال كلمة في القاموس، ففي الفرنسيّة يُشار إلى الفعل بشكل الكلمة بصيغة المصدر   (savoir)  (يعرف). وفي قواميس Zulu فالبادئة قبل صيغة المصدر (uku-) تُحذف عادة لتجنُّب وضع جميع الأفعال تحت 'u' في قائمة أبجديّة. وبالتّالي تُدرج كلمة  (-funda)يتعلّم بدلًا من (uku-funda). ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[]}],"wordForms":[],"relatedSenses":[],"search":"شكل الاقتباس  Citation Form","nonDiacriticsLemma":"شكل الاقتباس","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"شكل الاقتباس"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/4c2c8d91-7b86-47cd-90f5-177221a5c907/get-public-entry"},"browse_index_record":{"lexicalEntryId":"4c2c8d91-7b86-47cd-90f5-177221a5c907","word":"صيغة مجاملة لطائفة معيّنة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface715","lexicalEntryId":"4c2c8d91-7b86-47cd-90f5-177221a5c907","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"صيغة مجاملة لطائفة معيّنة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"قدّم عالِم الأنثروبولوجيا Malinowski للإشارة إلى استخدام اللُّغة المصمّمة أساسًا لتعزيز أو للحفاظ على العلاقات الاجتماعيّة، بدلًا من تبادل المعلومات أو الأفكار. مثال، من اللُّغة الإنجليزيّة \"تعليقات عن الطّقس\". انظر Malinowski (1923).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Phatic (Communion)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"صيغة مجاملة لطائفة معينة  Phatic (Communion)","nonDiacriticsLemma":"صيغة مجاملة لطائفة معينة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"صيغة مجاملة لطائفة معيّنة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

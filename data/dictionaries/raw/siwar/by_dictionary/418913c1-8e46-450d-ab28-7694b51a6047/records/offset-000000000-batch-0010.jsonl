{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cc5174b1-4e6e-4d01-9d13-1064fe752415/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cc5174b1-4e6e-4d01-9d13-1064fe752415","word":"التّواصل عبر الثّقافات","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface682","lexicalEntryId":"cc5174b1-4e6e-4d01-9d13-1064fe752415","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التّواصل عبر الثّقافات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"انظر @(التّواصل عبر الثّقافات) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Cross-Cultural Communication","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"التّواصل الثّقافيّ بين أفراد من ثقافات مختلفة، والّذي ربّما يُحدث طرائق كلام Ways of Speaking مختلفة، وتوقّعات مختلفة، وفهمًا ثقافيًّا لموضوع ما، وهذا مصطلح التّواصل عبر الثّقافات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Intercultural Communication","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"التواصل عبر الثقافات  Cross-Cultural Communication Intercultural Communication","nonDiacriticsLemma":"التواصل عبر الثقافات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التّواصل عبر الثّقافات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/044fc15a-46a2-4f41-a78e-d27c01c2ba51/get-public-entry"},"browse_index_record":{"lexicalEntryId":"044fc15a-46a2-4f41-a78e-d27c01c2ba51","word":"التّنوُّع الأسلوبيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface683","lexicalEntryId":"044fc15a-46a2-4f41-a78e-d27c01c2ba51","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التّنوُّع الأسلوبيّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يشير هذا المصطلح إلى استخدام المتكلّمين لعدد من أساليب  Styles الكلام المختلفة. وقد جرت دراسة أساليب الكلام من خلال الأبحاث الّتي تخصُّ التنوّع Variationist، والّتي جُمعت في الأعمال اللّابوفيّة Labovian التّقليديّة (انظر: @(وليم لابوف) ). وفي هذه الحالة تركّزت تلك الدّراسات على طريقة توزيع الكمّي Quantitative خصائص اللُّغويّات، من خلال تنوُّع الأساليب أو السّياقات الّتي يستخدمها المتكلّم أثناء المحادثة (تدلُّ النّتائج العامّة لتلك الدّراسات على أنّ أساليب الكلام المستخدمة في المحادثة تتفاوت بتفاوت تتابع السّلسلة الأسلوبيّة Stylistic Continuum من أسلوب رسميّ إلى أسلوب أقلّ رسميّة، وهذه النّتائج مماثلة لنتائج Labov (1972a) حول تنوُّع الأسلوب في الخطاب بمدينة نيويورك). ويُستخدم مصطلح التّحوُّل الأسلوبيّ Style Shifting كذلك للتّعبير عن استخدام المتكلّمين لأساليب مختلفة خلال محادثاتهم. وهذا التّحوّل في الأسلوب يُستخدم في الدّراسات الكميّة حول كيفيّة تحوّل المتكلّمين من أسلوب إلى آخر أثناء تفاعل كلاميّ بينهم، مع التّركيز على الآثار التّواصليّة النّاتجة عن استخدام مجموعات مختلفة من الخصائص اللُّغويّة. وربّما يُنظر إلى هذا النّوع من التّحوّل الأسلوبيّ على أنّه يمكن مقارنته بالتّناوب اللُّغويّ Code-Swithcing بين اللُّغات. انظر: @(التّباين السّياقيّ) و @(التّنوُّع الدّاخلي للمتحدّث نفسه) و @(التّنوّع اللُّغويّ) و @(السّلسلة الأسلوبيّة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Stylistic Variation","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"التنوع الأسلوبي  Stylistic Variation","nonDiacriticsLemma":"التنوع الأسلوبي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التّنوُّع الأسلوبيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

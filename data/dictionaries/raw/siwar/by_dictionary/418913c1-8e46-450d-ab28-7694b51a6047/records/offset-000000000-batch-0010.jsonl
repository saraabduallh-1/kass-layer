{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/fdc54bdd-e4fa-4ba6-94cf-d7e939442ed6/get-public-entry"},"browse_index_record":{"lexicalEntryId":"fdc54bdd-e4fa-4ba6-94cf-d7e939442ed6","word":"تقنيّة المظهر المتطابق","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface66c","lexicalEntryId":"fdc54bdd-e4fa-4ba6-94cf-d7e939442ed6","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"تقنيّة المظهر المتطابق","lemmaType":"MWE","pattern":" ","senses":[{"definition":"تقنيّة تهدف إلى التّحقيق في استجابة المستمعين إلى لغات مختلفة وأصناف متنوّعة تمّ وضعها وتطويرها في أواخر الخمسينيّات. على سبيل المثال، (Lambert, et al., 1960) وزملاؤه في الستينيّات، وقد تمّ استخدامها أيضًا على نطاق واسع من قِبل علماء النّفس الاجتماعيّ خلال الفترة ما بين 1970 و1980 مثل، Giles and Powesland (1975)، حيث يقوم المتكلّم نفسه بتسجيل ما يقرأ من مقال بأصناف أو أشكال مختلفة من اللُّغة، ويتمّ تقديم هذا إلى المستمعين على أنّه قادم من متحدّثين مختلفين، وبناءً عليه يُطالَب المستمعون بتقييم هؤلاء المتحدّثين وفقًا لأبعاد معيّنة (على سبيل المثال: مدى كفاءتهم، ذكاؤهم أو الوديّة). وقد قدّمت هذه التّقنيّة أدلّة على المعاني الاجتماعيّة المنسوبة إلى أصناف اللُّغة، إلا أنّها تعرضّت لانتقادات بسبب أنّها اصطناعيّة. @(التّقييم) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Matched Guise","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"تقنية المظهر المتطابق  Matched Guise","nonDiacriticsLemma":"تقنية المظهر المتطابق","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"تقنيّة المظهر المتطابق"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a15aaba9-b592-403b-9dec-372444f50593/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a15aaba9-b592-403b-9dec-372444f50593","word":"التّلاعب اللّفظيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface66d","lexicalEntryId":"a15aaba9-b592-403b-9dec-372444f50593","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التّلاعب اللّفظيّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"انظر : @(التّلاعب اللُّغويّ) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Verbal Play","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"التلاعب اللفظي  Verbal Play","nonDiacriticsLemma":"التلاعب اللفظي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التّلاعب اللّفظيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7b8a39a9-ce26-44b2-af15-11e698e384bf/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7b8a39a9-ce26-44b2-af15-11e698e384bf","word":"التّفاعليّة الرّمزيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface66e","lexicalEntryId":"7b8a39a9-ce26-44b2-af15-11e698e384bf","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التّفاعليّة الرّمزيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وهي مدرسة الفكر في علم الاجتماع الّتي تَدرس المجتمعات من حيث لقاءات صغيرة بين الأفراد (من الأسفل إلى الأعلى Bottom-Up)، بدلًا من مفهوم النّظام الاجتماعيّ الأوسع (من الأعلى إلى الأسفل Top-Down). إنّ التّفاعل الرّمزيّ ارتبط بشكل أساسيّ بأعمال عالِم الاجتماع الأمريكيّ George H. Mead، والّذي ركّز على تطوير النّفس. وضّح Mead أنّ العلاقة بين الفرد والذّات، والذّات والمجتمع، هي نوع من تبادل الرّموز والإشارات، وأنّ التّواصل يكون على شكل رموز تُستخدم في ذلك التّفاعل، ومن خلال هذا التّفاعل الرّمزيّ مع النّفس يصل الفرد إلى الكينونة. كان هناك جدل بين خبراء التّفاعل الاجتماعيّ حول أنّ مكان الفرد في النّظام الاجتماعيّ ليس محدّدًا، ولكنّه يتطوّر ويتغيّر باستمرار بفعل التّفاعلات مع النّاس في كثير من المواقف. إنّ أهمّ الأعمال في مجال الأهميّة اللُّغويّة جاءت على يد Erving Goffman. وقد تأثّرت اللُّغويّات بهذه الدّراسة (مثال، اللُّغويّات الاجتماعيّة التّفاعليّة Interactional Sociolinguistics) حيث إنها تركّز على اللُّغة المحكيّة وجهًا لوجه، بدلًا من أن يظهر المعنى من خلال سياق واسع، وكيف أنّ اللُّغة تُستخدم بشكل إستراتيجيّ في عمليّات التّفاوض من خلال ذلك السّياق. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Symbolic Interactionism","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"التفاعلية الرمزية  Symbolic Interactionism","nonDiacriticsLemma":"التفاعلية الرمزية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التّفاعليّة الرّمزيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/dc7f3950-322b-483e-b37b-c3983e4ec1da/get-public-entry"},"browse_index_record":{"lexicalEntryId":"dc7f3950-322b-483e-b37b-c3983e4ec1da","word":"التّناوب اللُّغويّ الظّرفيّ والمجازيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface66f","lexicalEntryId":"dc7f3950-322b-483e-b37b-c3983e4ec1da","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"التّناوب اللُّغويّ الظّرفيّ والمجازيّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"بحث في معناه العالِم John Gumperz، وتبعه باحثون مهتمّون بدراسة الدّوافع الاجتماعيّة للتّناوب اللُّغويّ Code-Switching. هناك بعض الضّبابيّة في التّعريف المبكّر له، ولكن عمومًا: فإنّ التّحوّل في التّباين اللُّغويّ الظّرفيّ إلى لهجات أخرى يشير إلى تغيّر الموقف الظّرفيّ إلى واحد، تتحقّق به أعراف وتفاعلات وعلاقات مختلفة بين المتحدّثين، مثلًا: التّحوّل من سياق رسميّ إلى واحد أقلّ رسميّة. يتضمّن التّبديل اللُّغويّ الاستعاريّ استخدام مفردات غير مرتبطة عادة مع الموقف الاجتماعيّ (استخدام تعابير رسميّة أو شاعريّة في حوار بين الأصدقاء). في الواقع من الصّعب الوصول إلى اختلاف واضح وقطعيّ بينهما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Situational, Metaphorical (Code-Switching)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"التناوب اللغوي الظرفي والمجازي  Situational, Metaphorical (Code-Switching)","nonDiacriticsLemma":"التناوب اللغوي الظرفي والمجازي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"التّناوب اللُّغويّ الظّرفيّ والمجازيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

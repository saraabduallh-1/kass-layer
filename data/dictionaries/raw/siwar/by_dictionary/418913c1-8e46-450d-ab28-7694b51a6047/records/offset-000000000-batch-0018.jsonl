{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/b30a526a-b0f6-45b0-951d-d58e5c796512/get-public-entry"},"browse_index_record":{"lexicalEntryId":"b30a526a-b0f6-45b0-951d-d58e5c796512","word":"العائلة اللُّغويّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface73f","lexicalEntryId":"b30a526a-b0f6-45b0-951d-d58e5c796512","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"العائلة اللُّغويّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي مجموعة من اللُّغات الّتي ظهرت كنتيجة للاختلاف Divergence اللُّغويّ من سلف واحد. حيث تُسمَّى اللُّغات الإنجليزيّة، الألمانيّة، الهولنديّة، اليديشيّة، الفريزيّة، الأفريكانيّة...إلخ باللُّغات الابنة Daughter Languages من الألمانيّة الغربيّة الّتي بدورها هي لغة واحدة من اللُّغة الابنة للألمانيّة (شمال ألمانيا وإسكندنافيا أيضًا). تلعب الأيديولوجيّات اللُّغويّة دورًا مهمًّا في عمليّات توحيد اللُّغة وصياغة السّياسة اللُّغويّة، وقد تمّ تشكيل اللُّغة نفسها من مختلف الأيديولوجيّات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Language Family ","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"العائلة اللغوية  Language Family ","nonDiacriticsLemma":"العائلة اللغوية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"العائلة اللُّغويّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

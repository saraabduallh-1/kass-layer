{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/c65ca278-480d-4a79-b7a7-c5edbe91ce20/get-public-entry"},"browse_index_record":{"lexicalEntryId":"c65ca278-480d-4a79-b7a7-c5edbe91ce20","word":"خصائص مشتركة بين مختلف اللّهجات لنفس اللُّغة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface6c3","lexicalEntryId":"c65ca278-480d-4a79-b7a7-c5edbe91ce20","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"خصائص مشتركة بين مختلف اللّهجات لنفس اللُّغة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مصطلح يُستخدم في علم اللّهجات Dialectology للإشارة إلى ظاهرة لغويّة؛ مثل خصائص لغويّة معيّنة، وجانب من جوانب التّغيّر اللُّغويّ Language Change، والّذي يوجد في جميع اللّهجات Dialects للُغة ما.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Pandialectal","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"تصنّف طريقة للقواعد الّتي ترى اللُّغة Language كوحدة من نظام فرعيّ (اللّهجات)، والّتي من الممكن أن تُرتّب ضمنيًّا في شبكة عريضة Panlectal Grid. انظر @(المقياس التّطبيقيّ) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Panlectal","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"خصائص مشتركة بين مختلف اللهجات لنفس اللغة  Pandialectal Panlectal","nonDiacriticsLemma":"خصائص مشتركة بين مختلف اللهجات لنفس اللغة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"خصائص مشتركة بين مختلف اللّهجات لنفس اللُّغة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"auto
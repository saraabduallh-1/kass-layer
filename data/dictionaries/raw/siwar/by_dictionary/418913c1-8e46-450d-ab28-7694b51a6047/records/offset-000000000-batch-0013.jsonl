{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9e883d28-dc50-43f3-b74b-35025a257df4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9e883d28-dc50-43f3-b74b-35025a257df4","word":"الخطاب الموثوق","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface6ca","lexicalEntryId":"9e883d28-dc50-43f3-b74b-35025a257df4","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الخطاب الموثوق","lemmaType":"MWE","pattern":" ","senses":[{"definition":"  \tيستخدمه Bakhtin للإشارة إلى نوع معيَّن من العلاقة بين الفرد واللُّغة. كلمة الموثوق \"تتطلّب أن نعترف بها، وأن نجعلها خاصّتنا . وغالبًا ما يشير الخطاب الرّسمي إلى طرق المعنى واستخدام اللُّغة الّتي يعيد إنتاجها  الفرد دون شكٍّ، أو يشعر بأنّه مجبر على استخدامها. والخطابات الرّسميّة هي على النّقيض من \"الخطابات المقنّعة داخليًّا\"، وهي طرق للمعنى الّذي يتفاعل فيه الفرد بشكل حواري، أي عن طريق الاستفسار والاستكشاف والرّبط، من أجل تطوير طرق جديدة للمعنى. انظر أيضًا: @(الحواريّة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Authoritative Discourse","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الخطاب الموثوق  Authoritative Discourse","nonDiacriticsLemma":"الخطاب الموثوق","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الخطاب الموثوق"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

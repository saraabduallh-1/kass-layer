{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1949f0fc-dd51-475e-a62b-299aa30c58c2/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1949f0fc-dd51-475e-a62b-299aa30c58c2","word":"المتغيّر الاجتماعيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dfacea1c","lexicalEntryId":"1949f0fc-dd51-475e-a62b-299aa30c58c2","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"المتغيّر الاجتماعيّ","lemmaType":"wasf","pattern":" ","senses":[{"definition":"يُقصد بالمتغيّرات الاجتماعيّة أنّها جميع الجوانب المتعلّقة بهويّة المتحدّث الاجتماعيّة، مثل: (الطّبقة الاجتماعيّة  Social Class، والنّوع الاجتماعيّ Gender، والعُمر Age) وغيرها. والّتي ترتبط بسلوك اللُّغة في البحوث الاجتماعيّة اللُّغوية الكميّة Quantitative. انظر @(المتغير اللُّغويّ) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Social Variable","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"المتغير الاجتماعي  Social Variable","nonDiacriticsLemma":"المتغير الاجتماعي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"المتغيّر الاجتماعيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

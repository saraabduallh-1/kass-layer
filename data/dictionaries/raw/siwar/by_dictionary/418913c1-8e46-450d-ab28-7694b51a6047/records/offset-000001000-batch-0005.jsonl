{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/d0f40961-e653-434d-9345-0311cfd929c5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"d0f40961-e653-434d-9345-0311cfd929c5","word":"اللّهجة الإثنيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface802","lexicalEntryId":"d0f40961-e653-434d-9345-0311cfd929c5","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اللّهجة الإثنيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":" @(اللّهجة) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Ethnolect","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"اللهجة الإثنية  Ethnolect","nonDiacriticsLemma":"اللهجة الإثنية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اللّهجة الإثنيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/28db539e-1c09-4858-b441-8e199b133366/get-public-entry"},"browse_index_record":{"lexicalEntryId":"28db539e-1c09-4858-b441-8e199b133366","word":"اللّفظ المُتلقّى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface803","lexicalEntryId":"28db539e-1c09-4858-b441-8e199b133366","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اللّفظ المُتلقّى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"المعروف شعبيًّا أيضًا باسم الملَكَة الإنجليزيّة Queen’s English، إكسفورد الإنجليزيّة Oxford English أوBBC English  هو الاسم الّذي يستخدمه اللُّغويّون لهيبة اللّكنة Accent من المملكة المتّحدة، تُستخدم عادة من قِبل الطّبقة المتوسّطة المتعلّمة، أو الطّبقة الأرستقراطية، على عكس لهجات أخرى من اللُّغة الإنجليزيّة في المملكة المتّحدة، ولا يقتصر تلقّي النّطق على منطقة جغرافيّة معيّنة. وهي مؤثّرة بشكل خاصّ كلغة مرتبطة بالملوك البريطانيّين، والبرلمان، والكنيسة البريطانيّة، والمحاكم العليا والمؤسّسات الوطنيّة الأخرى، ضمن دراسة الصّوتيات الإنجليزيّة. تلقّي النّطق له أهميّة خاصّة، حيث كان يُستخدم كنموذج من قِبل Daniel Jones وغيره، من أجل وصف اللُّغة، ولا يزال نموذجًا مؤثِّرًا. وغالبًا ما يُستخدم كمعيار مقارنة في وصف لهجات أخرى. يتمّ استخدام صفة تلقّى بمعنى مقبولة وإن لم يختزن على نطاق واسع، على الرّغم من أنّها أيضًا اتّخذَت لتعني اللّهجة الوحيدة الّتي وردت في المحكمة الملكيّة. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Received Pronunciation (RP)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"اللفظ المتلقى  Received Pronunciation (RP)","nonDiacriticsLemma":"اللفظ المتلقى","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اللّفظ المُتلقّى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/5f6bca84-f62b-4b05-89e4-1ef65ced04a7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"5f6bca84-f62b-4b05-89e4-1ef65ced04a7","word":"لغويّات تاريخيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface804","lexicalEntryId":"5f6bca84-f62b-4b05-89e4-1ef65ced04a7","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"لغويّات تاريخيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يُعنى هذا الفرع من اللُّغويّات بدراسة تاريخ اللُّغات وكيفيّة تغيّرها على مرِّ السّنين. ويُعرف أيضًا بمسمّى اللُّغويّات الزّمنيّة Diachronic Linguistics.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Historical Linguistics","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"لغويات تاريخية  Historical Linguistics","nonDiacriticsLemma":"لغويات تاريخية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"لغويّات تاريخيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1206c091-06ab-40c9-a5a1-3af0b3769552/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1206c091-06ab-40c9-a5a1-3af0b3769552","word":"اللُّغويَّات التّطبيقيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface805","lexicalEntryId":"1206c091-06ab-40c9-a5a1-3af0b3769552","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اللُّغويَّات التّطبيقيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يقال إن اللُّغويّات تكون مطبّقة عندما يتمُّ استخلاص نظريّاتها وأساليبها البحثيّة ونتائج أبحاثها لتوضِّح وتساعد على حلّ القضايا والاهتمامات العمليّة المتعلّقة باللُّغة واستخدامها.  ومع ذلك، ففي الممارسة العمليّة لا تنحصر اللُّغويّات التطبيقيّة في النّظريات اللُّغويّة والمناهج اللُّغويّة، فهي عادة ما تكون متعدّدة التّخصّصات، وتستند أيضًا إلى مجالات ذات صلة، مثل: علم النّفس، والنظريّة التربويّة. وقد عُنيت اللُّغويّات التّطبيقيّة بشكل خاصّ بتعليم وتعلّم اللُّغة الإنجليزيّة، وغيرها من اللُّغات كلغات أجنبيّة أو إضافيّة، وأحيانًا يتمُّ استخدامها كمرادف لهذا المجال من الدّراسة. ومع ذلك، قد يتمُّ تطبيق اللُّغويّات في العديد من السّياقات الأخرى (على سبيل المثال فيما يتعلّق باللُّغة والقانون. ويُستخدم المصطلح في بعض الأحيان على نطاق أوسع لتغطية هذه المجموعة الواسعة من التّطبيقات. وبهذا المعنى الأوسع، غالبًا ما يكون للّغويّات التطبيقيّة مكوّنٌ حاسمٌ قويٌّ، على سبيل المثال: الاعتماد على \"تحليل الكلام الدّقيق، والوعي اللُّغويّ الدّقيق\". وتتداخل اللُّغويّات التّطبيقيّة أيضًا مع جوانب علم اللُّغة الاجتماعيّة. وقد تمَّ استخدام مصطلح اللُّغويّات الاجتماعيّة التطبيقيّة في بعض الأحيان لتطبيق النّظريَّات والأساليب الاجتماعيّة اللُّغويّة في مجال التّعليم، وعلم اللُّغة الشّرعي، وسياسة اللُّغة، والتّخطيط اللُّغويّ Language Planning، ومجالات أخرى مماثلة. \r\nانظر أيضًا @(اللُّغويّات التّعليميّة) و @(تدريس اللُّغة الإنجليزيّة للنّاطقين بغيرها) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Applied Linguistics","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"اللغويات التطبيقية  Applied Linguistics","nonDiacriticsLemma":"اللغويات التطبيقية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اللُّغويَّات التّطبيقيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/1f1b0aa7-8e1a-410f-8e89-040701b48cf4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"1f1b0aa7-8e1a-410f-8e89-040701b48cf4","word":"/r/اللّهجات الإنجليزيّة الّتي تلفظ صوت","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface806","lexicalEntryId":"1f1b0aa7-8e1a-410f-8e89-040701b48cf4","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"/r/اللّهجات الإنجليزيّة الّتي تلفظ صوت","lemmaType":"MWE","pattern":" ","senses":[{"definition":"اسم يُطلَق على اللّهجات الإنجليزيّة الّتي تلفظ  /r/في كلماتها ما بعد حرف العّلة Post-Vocalic /r/، مثل lark وcar. يطلَق على هذه اللّهجات اسم r-full أيضًا، وتُستخدم في جنوب غرب إنجلترا، وإسكتلندا، وأيرلندا، وفي أمريكا الشّماليّة. بينما اللّهجات الإنجليزيّة الّتي لا يتمّ فيها نطق /r/ كما في الكلمات السّابقة تسمّى Non-Rhotic أو r-less. وتُستخدم هذه اللّهجات في معظم إنجلترا، وويلز، وفي نصف الكرة الجنوبيّ Southern Hemisphere (أستراليا، ونيوزيلندا، وجنوب إفريقيا). كما أنّ اللّهجة الإنجليزيّة المعياريّة في المملكة المتّحدة أو ما يُسمَّى باللّفظ المتلقّى/ اللّهجة ذات الهيبة Recived Pronunciatin (RP) ، حيث تعتبر من لهجات Rhotic. اللهجتان Rhotic وNon-Rhotic تُستخدمان في الكاريبيّة.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Rhotic","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"/r/اللهجات الإنجليزية التي تلفظ صوت  Rhotic","nonDiacriticsLemma":"rاللهجات الإنجليزية التي تلفظ صوت","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"/r/اللّهجات الإنجليزيّة الّتي تلفظ صوت"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

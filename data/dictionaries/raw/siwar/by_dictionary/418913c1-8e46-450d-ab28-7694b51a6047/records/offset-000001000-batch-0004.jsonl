{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6bb7c9c9-fa70-4d53-b5eb-9bd58b6060e5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6bb7c9c9-fa70-4d53-b5eb-9bd58b6060e5","word":"لغة بينيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface7d8","lexicalEntryId":"6bb7c9c9-fa70-4d53-b5eb-9bd58b6060e5","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"لغة بينيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو شكلٌ من أشكال اللُّغة ينشأ لدى المتعلّم للّغة الإنجليزيّة كلغة أجنبيّة أو كلغة ثانية، وهو مرتبط بـ Larry Selinker (1972). يُستخدم هذا المصطلح لوصف مرحلة لغويّة معيّنة أثناء تعلُّم الفرد للّغة الإنجليزيّة كلغة ثانية أو أجنبيّة، حيث تُوصف هذه المرحلة بأنّها غير مستقرّة إلّا أنّها دائمة التّطوّر. وتتّصف لغة المتعلّم في هذه المرحلة بأنّها تتضمّن تراكيب لغويّة لا تمتّ بصلة واضحة للغته الأمّ، أو للّغة المستهدَفَة.  ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Interlanguage","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"لغة بينية  Interlanguage","nonDiacriticsLemma":"لغة بينية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"لغة بينيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e47b5e81-a97b-4f7e-9351-8da6d481c4a4/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e47b5e81-a97b-4f7e-9351-8da6d481c4a4","word":"لغة خارجيّة المفردات","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface7d9","lexicalEntryId":"e47b5e81-a97b-4f7e-9351-8da6d481c4a4","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"لغة خارجيّة المفردات","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي اللُّغة الّتي تمَّ زرعها Transplantesd في منطقة أخرى، حيث تُستخدم الآن كلغة رسميّة أو مشتركة مع الرّسميّة. مثال ذلك: الإنجليزيّة في تنزانيا أو ماليزيا، يقابلها لغة داخليّة المفردات Endo-Glossic Language.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Exoglossic Language","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"لغة خارجية المفردات  Exoglossic Language","nonDiacriticsLemma":"لغة خارجية المفردات","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"لغة خارجيّة المفردات"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

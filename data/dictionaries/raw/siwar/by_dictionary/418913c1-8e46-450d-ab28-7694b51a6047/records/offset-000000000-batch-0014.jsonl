{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/7091197e-5f52-4ed2-938c-a9b4f218fb59/get-public-entry"},"browse_index_record":{"lexicalEntryId":"7091197e-5f52-4ed2-938c-a9b4f218fb59","word":"ديل، هايمز","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface6e0","lexicalEntryId":"7091197e-5f52-4ed2-938c-a9b4f218fb59","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"ديل، هايمز","lemmaType":"MWE","pattern":" ","senses":[{"definition":"أحد مؤسِّسي اللُّغويَّات الاجتماعيّة المعاصرة، وأحد محرّري المجلّة اللُّغويّة \"اللُّغة في المجتمع Language in Society\"، وعمل الكثير لتطوير حقل من حقول اللُّغويّات الاجتماعيّة، ألا وهو عرقيّة الكلام والتّواصل. وقد عمل  Hymes أستاذًا في الأنثروبولوجيا إلى أن تقاعد في جامعة Verginia. انظر أيضًا: @(التّحدُّث) و @(الحدث الخطابيّ) و @(طرق الكلام) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Hymes, Dell H. (1927- )","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"ديل، هايمز  Hymes, Dell H. (1927- )","nonDiacriticsLemma":"ديل هايمز","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ديل، هايمز"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

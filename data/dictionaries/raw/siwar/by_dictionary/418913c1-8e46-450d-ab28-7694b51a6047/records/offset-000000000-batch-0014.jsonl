{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/2ad0cc24-6322-44e4-899c-af5d762af56c/get-public-entry"},"browse_index_record":{"lexicalEntryId":"2ad0cc24-6322-44e4-899c-af5d762af56c","word":"الحركة اللُّغويّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface6d5","lexicalEntryId":"2ad0cc24-6322-44e4-899c-af5d762af56c","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الحركة اللُّغويّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هي حركة اجتماعيّة ذات قضيّة واحدة تركِّز على مسائل اللُّغة، وتُستخدم في المجتمع. تركّز الحركات اللُّغويّة في كثير من الأحيان على الدّعوة إلى اللُّغة الوطنيّة، أو الحقوق اللُّغويّة Linguistic Rights للأقليّات (على سبيل المثال، إمكانيّة الوصول إلى الخدمات الحكوميّة ووسائل الإعلام). وتشتمل الأمثلة على هذه الحركات: حركة اللُّغة الإنجليزيّة فقط English Only Movement في الولايات المتّحدة الأمريكيّة، وحركة التّبسيط اللُّغويّ Plain Language Movement الّتي تنشط في جميع أنحاء العالَم النّاطقين باللُّغة الإنجليزيّة. انظر @(التّخطيط اللُّغويّ) و @(المجتمعات اللُّغويّة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Language Movement ","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الحركة اللغوية  Language Movement ","nonDiacriticsLemma":"الحركة اللغوية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الحركة اللُّغويّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

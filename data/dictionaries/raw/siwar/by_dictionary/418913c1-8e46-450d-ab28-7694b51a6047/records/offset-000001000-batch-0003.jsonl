{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/cafbe9e1-b355-4ec9-95aa-94ae73b65c75/get-public-entry"},"browse_index_record":{"lexicalEntryId":"cafbe9e1-b355-4ec9-95aa-94ae73b65c75","word":"اللُّغة اليوميّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface7d2","lexicalEntryId":"cafbe9e1-b355-4ec9-95aa-94ae73b65c75","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"اللُّغة اليوميّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وهي طريقة لجمع البيانات الّتي تُستخدم بكثرة في البحث عن ثنائيّة اللُّغةBilingualism  واختيار اللُّغة Language Choice. وتشمل مذكّرات اللُّغة تقارير ذاتيّة عن استخدام لغة المتحدِّثين. لا يشير المتكلّمون إلى اللُّغة الّتي يستخدمونها خلال فترة معيّنة فحسب، بل أيضًا إلى محاوريهم، والموضوعات الّتي يُتحدَّث عنها، والإعدادات الّتي يتمّ فيها استخدام اللُّغات، مثال (Gibbons, 1983). كما تُستخدم اللُّغة اليوميّة أيضًا في دراسات اكتساب اللُّغة Language Acquisition. ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Language Diary ","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"اللغة اليومية  Language Diary ","nonDiacriticsLemma":"اللغة اليومية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"اللُّغة اليوميّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

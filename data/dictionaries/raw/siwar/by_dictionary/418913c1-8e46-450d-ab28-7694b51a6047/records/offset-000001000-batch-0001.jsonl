{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/eb4358c1-8ba0-4e0a-827a-2b0c1ee67533/get-public-entry"},"browse_index_record":{"lexicalEntryId":"eb4358c1-8ba0-4e0a-827a-2b0c1ee67533","word":"الكلام غير المتناظَر","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface78e","lexicalEntryId":"eb4358c1-8ba0-4e0a-827a-2b0c1ee67533","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الكلام غير المتناظَر","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يُنظر للتّماثل أو التّفاعل في الكلام عندما يكون هناك درجة من عدم المساواة بين المتكلّمين. قد يرتبط ذلك بعوامل، مثل: السّلطة والوضع، أو النّوع الاجتماعيّ. فعلى سبيل المثال: أشارت بعض الدّراسات السّابقة إلى أنّ الحديث بين المتحدّثين من الإناث والذّكور غير متماثَل؛ ذلك أنَّ المتحدّثين الذّكور يتحدّثون أكثر من النّساء، ويقاطعون حديث النّساء أكثر ممّا تقوم به النّساء من مقاطعة لأحاديثهم، حيث يعتبرون أقلَّ تفاعلًا أثناء الحديث. ومنذ ذلك الحين اختُلف على هذا التّمييز الواضح.  انظر @(اللُّغة) و @(النّوع الاجتماعيّ) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Asymmetrical (Talk)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الكلام غير المتناظر  Asymmetrical (Talk)","nonDiacriticsLemma":"الكلام غير المتناظر","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الكلام غير المتناظَر"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

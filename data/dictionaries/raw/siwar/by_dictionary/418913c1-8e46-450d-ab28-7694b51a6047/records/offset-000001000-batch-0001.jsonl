{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/6db199ec-e4dc-4e32-bea1-a3312abfcad0/get-public-entry"},"browse_index_record":{"lexicalEntryId":"6db199ec-e4dc-4e32-bea1-a3312abfcad0","word":"الكلمة المعجميّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface793","lexicalEntryId":"6db199ec-e4dc-4e32-bea1-a3312abfcad0","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الكلمة المعجميّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وهي الكلمة الّتي تحمل معنى؛ كالأسماء، والصّفات، ونسبة كبيرة من الظّروف. وتحمل هذه الكلمات معنى معجميًّا Lexical Meaning. وقد تقارَن الكلمات المعجميّة مع الكلمات القواعديّة Grammatical Words، والّتي تحمل دلالة صرفيّة. يتمُّ عمل الفرق المتشابه من حيث العناصر المعجميّة مقابل العناصر الصّرفيّة Lexical Items. وقد يكون هناك مصطلحات أخرى (الكلمات ذات الدّلالة Content Word مقابل الكلمات الوظيفيّة الصّرفيّة Function Word).","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Lexical Word","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الكلمة المعجمية  Lexical Word","nonDiacriticsLemma":"الكلمة المعجمية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الكلمة المعجميّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

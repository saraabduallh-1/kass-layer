{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/45a46daf-8005-449a-92e4-81215ca0b825/get-public-entry"},"browse_index_record":{"lexicalEntryId":"45a46daf-8005-449a-92e4-81215ca0b825","word":"الكلمات السّريّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface789","lexicalEntryId":"45a46daf-8005-449a-92e4-81215ca0b825","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الكلمات السّريّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"مجموعة من الكلمات والعبارات المستخدمة من قِبل مجموعة اجتماعيّة معيّنة، عادة لأسباب تتعلّق بالسّريّة. وغالبًا ما ترتبط بالمجرمين وعصابات الشّوارع، أو غيرها من الجماعات الثّقافيّة الفرعيّة الّتي تحتاج إلى حماية نفسها من الغرباء. وقد تتضمّن كلمات مخترعة، أو تنطوي على تلاعبات مختلفة من أشكال الكلمات أو المعاني (على سبيل المثال: اللُّغة العاميّة المعكوسة، العاميّة المقفّاة، والاستعارات). لا تكون المفردات مفردات كاملة، ويمكن أن تخضع لـ\"تجاوزات مفرطة\" في بعض المناطق (أي تحتوي على عدد كبير من الكلمات لمفاهيم مماثلة تتعلّق بمصالح وأنشطة المجموعة، انظر @(معجميّ) فهي تميل إلى التّغيُّر بسرعة، وشأنها في ذلك شأن الأنواع الأخرى المماثلة، فقد تعمل على الحفاظ على حدود المجموعات. وتشمل المصطلحات ذات الصّلة معاداة اللُّغة\r\nAnti-Language؛ اللُّغة الخاصة بمجموعة معيّنة Cant؛ اللُّغة الاصطلاحيّة لجماعة ما Jargon؛ اللُّغة السّريّة Secret Language، والعاميّة Slang.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Argot","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الكلمات السرية  Argot","nonDiacriticsLemma":"الكلمات السرية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الكلمات السّريّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

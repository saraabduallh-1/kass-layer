{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/0d407681-4848-46d9-ac9c-6811dfd7194a/get-public-entry"},"browse_index_record":{"lexicalEntryId":"0d407681-4848-46d9-ac9c-6811dfd7194a","word":"الموضوع والتّعقيب","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface871","lexicalEntryId":"0d407681-4848-46d9-ac9c-6811dfd7194a","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الموضوع والتّعقيب","lemmaType":"MWE","pattern":" ","senses":[{"definition":"سميت الفكرة الرّئيسة في اللُّغويّات الوظيفيّة النّظاميّة Systemic Functional Linguistics وحدة دلالية تتعلق بالمعنى مباشرة . ويعرّف M. A. K. Halliday (1994) الموضوع theme على أنّه \"نقطة انطلاق الرّسالة\"، ويُشار إلى ما يتبعه باسم \"التعقيب\" \"rheme\"، أيّ ما يتّصل بالعبارات السّابقة، أو لفرض اللُّغة. وفي مجالات أخرى من علماء اللُّغة، قد تكون العلاقة بين هذه العوامل وبينها  أقلّ وضوحًا.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Theme, Rheme","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الموضوع والتعقيب  Theme, Rheme","nonDiacriticsLemma":"الموضوع والتعقيب","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الموضوع والتّعقيب"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

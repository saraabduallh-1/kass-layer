{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/9647f522-3914-4385-90c8-7b844a1e5154/get-public-entry"},"browse_index_record":{"lexicalEntryId":"9647f522-3914-4385-90c8-7b844a1e5154","word":"مقطع صرفيّ يمثّل أصغر وحدة لغويّة ذات معنى","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface880","lexicalEntryId":"9647f522-3914-4385-90c8-7b844a1e5154","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"مقطع صرفيّ يمثّل أصغر وحدة لغويّة ذات معنى","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يُستخدم هذا المصطلح في علم الصّرف Morphology والبنية القواعديّة للكلمات لوصف أصغر وحدة لغويّة ذات معنى. وقد يختلف مفهوم هذا المقطع الصّرفيّ من لهجة إلى أخرى، ويمكن دراسة هذه الظّاهرة على أنّها ضرب من ضروب التّنوّع الصّرفيّ Morphological Variation.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Morpheme","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"مقطع صرفي يمثل أصغر وحدة لغوية ذات معنى  Morpheme","nonDiacriticsLemma":"مقطع صرفي يمثل أصغر وحدة لغوية ذات معنى","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"مقطع صرفيّ يمثّل أصغر وحدة لغويّة ذات معنى"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/bfff8a3b-97f7-4502-ad0a-7168cbac58e7/get-public-entry"},"browse_index_record":{"lexicalEntryId":"bfff8a3b-97f7-4502-ad0a-7168cbac58e7","word":"لهجة عاميّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface881","lexicalEntryId":"bfff8a3b-97f7-4502-ad0a-7168cbac58e7","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"لهجة عاميّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"هو تعبير فرنسيّ، حيث يشير إلى غير الرّسميّة Non-Standard، وتعدّد اللّهجة العاميّة للّغة المحكيّة وبشكل تقليديّ، تحمُّل ارتباط سلبيّ قاسٍ أو غير مثقّف Uneducatedness ولذلك، قلما تُستخدم من قِبل اللُّغويّين، على كلّ حال في بعض المجتمعات اللُّغويّة، وجد هذا المصطلح بلا معنى سلبي، وكاسم مناسب للتّعددية مثل Jamaican Creole، حيث يشار إلى لغتهم بهذا المصطلح Patwa.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Patois","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"لهجة عامية  Patois","nonDiacriticsLemma":"لهجة عامية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"لهجة عاميّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/44c44554-3770-41cd-a6e5-7e3c275cee16/get-public-entry"},"browse_index_record":{"lexicalEntryId":"44c44554-3770-41cd-a6e5-7e3c275cee16","word":"المنهجيّة النّاقدة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface882","lexicalEntryId":"44c44554-3770-41cd-a6e5-7e3c275cee16","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"المنهجيّة النّاقدة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"\tيرتبط هذا المفهوم بشكل وثيق بعمل التّربويّ البرازيليّ Paulo Freire الّذي ميَّز بين المقاربة البنكيّة للتّدريس والتّعلّم الّتي ينقل من خلالها المدرِّس المعلومات إلى المتعلّم من جهة، والمقاربة الحواريّة الّتي يتعاون من خلالها المدرّسون والمتعلّمون لتحديد غاية التّدريس واتّجاهاته.\r\n\tانظر أيضًا: @(الوعي اللُّغويّ النّاقد) و @(المعرفة النّقديّة) . ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Critical Pedagogy","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"المنهجية الناقدة  Critical Pedagogy","nonDiacriticsLemma":"المنهجية الناقدة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"المنهجيّة النّاقدة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/a227ddb2-0c5f-4b63-b83c-ce7856a9b9c1/get-public-entry"},"browse_index_record":{"lexicalEntryId":"a227ddb2-0c5f-4b63-b83c-ce7856a9b9c1","word":"نبرة الاستفهام الأستراليّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface883","lexicalEntryId":"a227ddb2-0c5f-4b63-b83c-ce7856a9b9c1","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"نبرة الاستفهام الأستراليّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"انظر @(نبرة صاعدة عالية) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Australian Questioning Intonation (AQI)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"نبرة الاستفهام الأسترالية  Australian Questioning Intonation (AQI)","nonDiacriticsLemma":"نبرة الاستفهام الأسترالية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"نبرة الاستفهام الأستراليّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/26186c94-b1aa-4c09-9aef-b012d0f170e5/get-public-entry"},"browse_index_record":{"lexicalEntryId":"26186c94-b1aa-4c09-9aef-b012d0f170e5","word":"موت اللُّغة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface884","lexicalEntryId":"26186c94-b1aa-4c09-9aef-b012d0f170e5","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"موت اللُّغة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وهي خطوة يتمّ من خلالها إيقاف اللُّغات من الاستخدام؛ وذلك يعود إمّا لانقراض المتحدّثين السابقين بها بدون أيّ إحياء لها، أو لأنّ النّاطقين بها من السّابقين قد تحوّلوا تدريجيًّا إلى لغة مميزة، غير تاركين أيَّ متحدِّث للّغة الأصليّة. يُعتبر السّابق مثالًا على اندثار اللُّغة بدون تحوُّل لغويّ Language Shift، ويشمل الأخير كلًّا من الاندثار والتّحوُّل. يوجد أيضًا حالات للتّغير اللُّغويّ Language Change دون أن تشهد على الاندثار، عندما يتعلّق الأمر بالتّحوّلات في المجتمع إلى لغة جديدة، ولكن تحافظ اللُّغة الأقدم على بقائها في بعض الأماكن الأخرى، وبأسلوب تقنيّ. ولم تشهد اللُّغات القديمة؛ كالسّريانيّة واللّاتينيّة على اندثار لغويّ، على الرّغم من أنّها معروفة 'باللُّغات المندثرة Dead Languages'. لقد تطوَّرت تدريجيًّا بالانتقال المستمرّ من جيل إلى آخر، فضلًا عن انشطارها إلى أنواع محليّة، والّتي عُرفت أخيرًا باللُّغات المستقلّة؛ كالهنديّة، واللُّغة الكوجوراتيّة Gujarati. انظر أيضًا: @(اللُّغة المهدّدة بالانقراض) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Language Death ","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"موت اللغة  Language Death ","nonDiacriticsLemma":"موت اللغة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"موت اللُّغة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}

{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e59728dc-d7a3-4bc6-8eed-8a1b51619064/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e59728dc-d7a3-4bc6-8eed-8a1b51619064","word":"المواقف (نحو اللُّغة)","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface87a","lexicalEntryId":"e59728dc-d7a3-4bc6-8eed-8a1b51619064","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"المواقف (نحو اللُّغة)","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يمكن أن تكون  وجهات نظر النّاس وآراؤهم حول اللُّغة وتنوّعها متوجّهة إلى تقييم العلاقة بين اللُّغة القياسيّة وأنواع اللُّغة غير القياسيّة. ومع ذلك، فإنَّ مناقشة (Leonard Bloomfield’s, 1964) للآراء حيال الاستخدام  الجيد أو السّيئ للّغة في الثّقافة الشّفويّة Menomini Indians (في ولايّة Minnesota  الشّماليّة في الولايات المتّحدّة الأمريكيّة) توحي أنّ الحكم على القيمة اللُّغويّة هي ظاهرة منتشرة على نطاق واسع، ولا تتطلّب وجود لغة مكتوبة مدونة موحدّة. وقد درست المواقف تجاه اللُّغة باعتبارها جانبًا من جوانب علم النّفس الاجتماعيّ، انظر @(التّقييم) . وتحت عناوين مختلفة أخرى، انظر- على سبيل المثال- أيضًا: @(اللُّغويّات الشّعبيّة) و @(الأيديولوجيّة اللُّغويّة) و @(علم اللّهجات الإدراكيّ) و @(أيديولوجيّة اللُّغة القياسيّة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Attitudes (towards Language)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"المواقف (نحو اللغة)  Attitudes (towards Language)","nonDiacriticsLemma":"المواقف نحو اللغة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"المواقف (نحو اللُّغة)"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/324a6621-24de-4326-9fbd-9186d1b3efbd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"324a6621-24de-4326-9fbd-9186d1b3efbd","word":"ممارسات القراءة والكتابة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface87b","lexicalEntryId":"324a6621-24de-4326-9fbd-9186d1b3efbd","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"ممارسات القراءة والكتابة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"ممارسة القراءة والكتابة، أو  ممارسة القراءة والكتابة كممارسة اجتماعيّة، هي عبارات تُستخدم على نطاق واسع من قِبل أولئك الّذين يعملون في دراسات محو الأميّة الحديثة New Literacy Studies؛ للتأكيد على أنّ القراءة والكتابة هي أنشطة تجري دائما في سياقات اجتماعيّة وثقافيّة محدّدة، انظر أيضًا @(الممارسة الاجتماعيّة) . في حين أنّ هناك انزلاقًا بين المعاني، ويمكن تحديد ثلاثة استخدامات متميّزة للمصطلح:\r\n1.\tوصف مجموعة أنشطة الاتّصال الّتي يمكن ملاحظتها، والّتي يشارك فيها النّاس. وكان Scribner & Cole (1981) من بين أوّل مَنْ تحدّث عن ممارسة القراءة والكتابة كممارسة اجتماعيّة في أبحاثهما حول محو الأميّة بين شعوب في شمال إفريقيا. وحدَّدا ثلاث ممارسات لمحو الأميّة تخصّ لغات معيّنة وسياقات اجتماعيّة محدّدة، هي: الإلمام بالقراءة والكتابة باللُّغة الإنجليزيّة مرتبط بالوظائف المدرسيّة، وممارسة القراءة والكتابة باللُّغة العربيّة مع الممارسات الدّينيّة، وممارسة القراءة والكتابة في الاتّصالات الشّخصيّة .\r\n2.\tبالإضافة إلى (1)، لوصف اللُّغة ممارسة القراءة والكتابة من وجهات نظر المشاركين، من أجل استكشاف المعاني والقيم الّتي تُنسب إلى أنشطة التّواصل المختلفة.\r\n3.\tللإشارة إلى طرق نمطيّة اجتماعيًّا لاستخدام اللُّغة ومحو الأميّة، على سبيل المثال: تحليل أنواع مختلفة من أنشطة ممارسة القراءة والكتابة الّتي يشارك فيها النّاس على أساس الطّبقة الاجتماعيّة أو الجنس. انظر نقاشات.","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Literacy Practice(s)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"ممارسات القراءة والكتابة  Literacy Practice(s)","nonDiacriticsLemma":"ممارسات القراءة والكتابة","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"ممارسات القراءة والكتابة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/8359e7bf-7689-47b8-b7c2-88da481a29bd/get-public-entry"},"browse_index_record":{"lexicalEntryId":"8359e7bf-7689-47b8-b7c2-88da481a29bd","word":"المنهج الوصفيّ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface87c","lexicalEntryId":"8359e7bf-7689-47b8-b7c2-88da481a29bd","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"المنهج الوصفيّ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"وتُستخدم هذه المنهجيّة في علم اللُّغة لوصف موضوع بقواعد اللُّغة كما هي في الواقع بدون تغيير أو تعديل، بغضّ النّظر عمّا إذا كانت هذه التّراكيب مقبولة أو غير مقبولة لغويًّا. بالنّسبة إلى علماء اللُّغة الوصفيّ، فهم مهتمّون بوصف القواعد اللُّغويّة الموجودة في اللّاوعي Unconscious Norms في الكلام، وليس في الأحكام الصّادرة من المعلّمين والمحرّرين والمتخصّصين في اللُّغات الإنسانيّة.\r\nانظر أيضًا، @(الملاءمة (ملائم كصفة)) ، و @(مذهب الوصف) ، و @(الصحّة اللُّغويّة) ، و @(صحّة اللّفظ) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Descriptivism (Descriptive, Descriptivist)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"المنهج الوصفي  Descriptivism (Descriptive, Descriptivist)","nonDiacriticsLemma":"المنهج الوصفي","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"المنهج الوصفيّ"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/e0ff7949-e8ab-478e-8922-b0288ae34c08/get-public-entry"},"browse_index_record":{"lexicalEntryId":"e0ff7949-e8ab-478e-8922-b0288ae34c08","word":"(I)المنطقة ","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface87d","lexicalEntryId":"e0ff7949-e8ab-478e-8922-b0288ae34c08","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"(I)المنطقة ","lemmaType":"MWE","pattern":" ","senses":[{"definition":"بالمعنى \"الجغرافيّ\"، انظر @(الجغرافيّة اللُّغويّة) . وفيما يخصّ اللُّغويَّات الحقيقيّة، انظر @(المنطقة اللُّغويّة) ، و @(منطقة لغويّة اجتماعيّة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Area (I)","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"(I)المنطقة   Area (I)","nonDiacriticsLemma":"Iالمنطقة ","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"(I)المنطقة "}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
{"source":{"platform":"SIWAR","dictionary_id":"418913c1-8e46-450d-ab28-7694b51a6047","dictionary_name":"معجم اللغويات الاجتماعية","dictionary_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","source_url":"https://siwar.ksaa.gov.sa/public-dict-information/418913c1-8e46-450d-ab28-7694b51a6047","entry_api_url":"https://siwar.ksaa.gov.sa/api/v2/search/f86e34ba-f517-4a00-b7f2-a39f0f121a74/get-public-entry"},"browse_index_record":{"lexicalEntryId":"f86e34ba-f517-4a00-b7f2-a39f0f121a74","word":"الممارسة الاجتماعيّة","languageCode":"ar","belongsTo":"lemma"},"entry":{"_id":"674f037888fbbda6dface87e","lexicalEntryId":"f86e34ba-f517-4a00-b7f2-a39f0f121a74","lexiconId":"418913c1-8e46-450d-ab28-7694b51a6047","lexiconName":"معجم اللغويات الاجتماعية","lemma":"الممارسة الاجتماعيّة","lemmaType":"MWE","pattern":" ","senses":[{"definition":"يُشار إلى اللُّغة بأنّها ممارسة اجتماعيّة؛ وذلك لأنّ اللُّغة والتّواصل جزءٌ لا يتجزّأ من المجتمع، ولا يمكن فصله عنه؛ أي أنّها ليست مستقلّة Autonomous. بالإضافة إلى ذلك، تستخدم المناهج النّقديّة Critical Approaches كالتّحليل النّقدي للخطاب Critical Discourse Analysis (CDA) الممارسة في طرق أكثر تجريديّة. وتعدُّ الممارسة مصطلحًا نقديًّا من النّظريّة الماركسيّة الحديثة، والّتي تعني التّداخل في النّظامين الاجتماعيّ والاقتصاديّ. تحدّد اللُّغة من خلال التّراكيب والأعمال الاجتماعيّة تجاه إعادة إحياء تلك التّراكيب، ذكر Fairclough (2001) أنّ الاستخدام المتكرّر للّغة يسهم في الحفاظ على العلاقات الاجتماعيّة المنظّمة بطرق معقّدة. مثال على ذلك، مكانة اللُّغة الّتي يستخدمها أطفال الطّبقة الوسطى أعلى من اللُّغة المستخدمة من قِبل أطفال الطّبقة العاملة، وتبعًا لذلك، تكون هي اللُّغة الأكثر تقديرًا في الصّف. وهذا ما يسهم في تفاضل نجاح تعليم الأطفال من طبقات اجتماعيّة متعدّدة، ويسهم أيضًا في محاكاة وحماية الفئات من الطّبقة نفسها. انظر @(عادة) ","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Practice (Social)","language":"en","languageLabel":"الإنجليزية"}]},{"definition":"انظر @(الممارسة الاجتماعيّة) .","contexts":[],"examples":[],"relations":[],"synset":{"lexicon":null},"domains":[],"translations":[{"word":"Social Practice","language":"en","languageLabel":"الإنجليزية"}]}],"wordForms":[],"relatedSenses":[],"search":"الممارسة الاجتماعية  Practice (Social) Social Practice","nonDiacriticsLemma":"الممارسة الاجتماعية","metaData":{"periodDateTo":"1970-01-01T00:00:00.000Z"},"lammaDetails":[{"form":"الممارسة الاجتماعيّة"}],"lemmaLanguage":{"code":"ar","label":"عربي"},"autoGeneratedRoot":null,"__v":0}}
